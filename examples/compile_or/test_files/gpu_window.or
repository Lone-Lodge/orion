extern fn win_open(title: Text, w: int, h: int) -> int
extern fn win_pump() -> int
extern fn win_close(hwnd: int)
extern fn win_event_next() -> int
extern fn win_event_kind() -> int
extern fn win_event_key() -> int
extern fn win_event_x() -> int
extern fn win_event_y() -> int
extern fn og_init(hwnd: int, w: int, h: int) -> int
extern fn og_begin(r: int, g: int, b: int)
extern fn og_rect(x: int, y: int, w: int, h: int, r: int, g: int, b: int)
extern fn og_present() -> int
extern fn og_shutdown()


fn main() -> int:
    hwnd = win_open("Native Orion + D3D12 - click to place, Esc quits", 800, 600)
    if hwnd == 0:
        print_line("window failed")
        return 1
    ok = og_init(hwnd, 800, 600)
    if ok == 0:
        print_line("og_init failed")
        return 1
    print_line("gpu up - click to place blocks, move mouse, Esc to quit")

    mut running = 1
    mut mx = 400
    mut my = 300
    mut blocks_x = []
    mut blocks_y = []
    for:
        if running == 0:
            break
        keep = win_pump()
        if keep == 0:
            break
        for:
            has_event = win_event_next()
            if has_event == 0:
                break
            kind = win_event_kind()
            if kind == 3:
                mx = win_event_x()
                my = win_event_y()
            if kind == 1:
                blocks_x = push(blocks_x, win_event_x())
                blocks_y = push(blocks_y, win_event_y())
            if kind == 4:
                if win_event_key() == 27:
                    running = 0
            if kind == 6:
                running = 0

        og_begin(24, 26, 34)
        # board frame
        og_rect(40, 40, 720, 520, 40, 44, 56)
        # placed blocks (grid-snapped 40px)
        n = len(blocks_x)
        for i in 0..<n:
            bx = at(blocks_x, i)
            by = at(blocks_y, i)
            sx = (bx / 40) * 40
            sy = (by / 40) * 40
            og_rect(sx, sy, 36, 36, 231, 76, 255)
        # cursor ghost follows the mouse
        gx = (mx / 40) * 40
        gy = (my / 40) * 40
        og_rect(gx, gy, 36, 36, 80, 200, 120)
        og_present()

    og_shutdown()
    win_close(hwnd)
    print_line("bye")
    0
