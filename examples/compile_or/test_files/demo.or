use bytes
type Inst: op: Text, type_text: Text, value: int, lhs: int, rhs: int, name: Text, args: [int]
type Param: name: Text, type_text: Text
type IRFn: name: Text, return_type: Text, params: [Param], instructions: [Inst]
type IRModule: functions: [IRFn]
type PushResult: function: IRFn, id: int
pub fn ir_type_i64() -> Text: "i64"
pub fn ir_type_ptr() -> Text: "ptr"
pub fn ir_type_bool() -> Text: "bool"
pub fn ir_type_void() -> Text: "void"
pub extern fn orion_err_bump() -> int
pub extern fn orion_err_get() -> int
pub extern fn orion_text_join(parts: [Text]) -> Text
pub extern fn orion_f64_literal_hex(s: Text) -> Text
pub extern fn orion_arena_init(bytes: int) -> int
pub extern fn orion_arena_on() -> int
pub extern fn orion_arena_off() -> int
pub extern fn orion_arena_reset() -> int
pub extern fn orion_arena_used() -> int
pub fn compile_error(msg: Text):
    print_line(msg)
    orion_err_bump()
pub fn compile_errors() -> int:
    orion_err_get()
