# Demo: showcase generics + SIMD MVP features. Both work in interp + native.
# Run via lodge-orion's interpreter:
#   orbit.exe run demo_all_features.or main
#
# Lambdas/closures with captures work via the native compile path (orion-self
# orbs → LLVM); demo_closure.or has that flavour.

define id<T>(value: T) -> T:
    value

define pair_first<A, B>(left: A, right: B) -> A:
    left

define main() -> number:
    # Generics - type vars erased to int/ptr.
    a = id(20)
    b = pair_first(22, 999)

    # SIMD-style list ops.
    xs = [1, 2, 3, 4]
    ys = [10, 20, 30, 40]
    dot = vec_dot(xs, ys)
    sum = vec_add(xs, ys)

    print_line("generics a:")
    print_line(a)
    print_line("generics b:")
    print_line(b)
    print_line("simd dot:")
    print_line(dot)
    print_line("simd vec_add[0]:")
    print_line(sum[0])

    # Combine: a (20) + b (22) = 42
    a + b
