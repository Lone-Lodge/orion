type Point: x: number, y: number

type Color:
    Red
    Green
    Blue

define color_code(c: Color) -> number:
    choose c:
        Red then 0xff0000
        Green then 0x00ff00
        Blue then 0x0000ff

define dist_sq(p: Point) -> number:
    p.x * p.x + p.y * p.y

define main() -> number:
    pt = Point{x: 3, y: 4}
    d = dist_sq(pt)
    c = color_code(Color.Green)
    d + c
