type Point: x: int, y: int

type Color:
    Red
    Green
    Blue

define color_code(c: Color) -> int:
    choose c:
        Red -> 0xff0000
        Green -> 0x00ff00
        Blue -> 0x0000ff

define dist_sq(p: Point) -> int:
    p.x * p.x + p.y * p.y

define main() -> int:
    pt = Point{x: 3, y: 4}
    d = dist_sq(pt)
    c = color_code(Color.Green)
    d + c
