type Effect:
    Spawn(Map)
    SetResource(Text, int)
    Relate(int, Text, int)
    Nop

fn apply(e: Effect) -> int:
    match e:
        Spawn(comps) -> get_int(comps, "hp")
        SetResource(key, value) -> len(key) + value
        Relate(a, kind, b) -> a + len(kind) + b
        Nop -> 7

fn main() -> int:
    s = apply(Spawn({"hp": 10}))
    r = apply(SetResource("score", 100))
    l = apply(Relate(3, "owns", 4))
    n = apply(Nop)
    print_line(s)
    print_line(r)
    print_line(l)
    print_line(n)
    s + r + l + n
