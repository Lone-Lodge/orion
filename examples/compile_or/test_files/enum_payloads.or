type Effect:
    Spawn(table)
    SetResource(text, number)
    Relate(number, text, number)
    Nop

define apply(e: Effect) -> number:
    choose e:
        Spawn(comps) then get_int(comps, "hp")
        SetResource(key, value) then length(key) + value
        Relate(a, kind, b) then a + length(kind) + b
        Nop then 7

define main() -> number:
    s = apply(Spawn({"hp": 10}))
    r = apply(SetResource("score", 100))
    l = apply(Relate(3, "owns", 4))
    n = apply(Nop)
    print_line(s)
    print_line(r)
    print_line(l)
    print_line(n)
    s + r + l + n
