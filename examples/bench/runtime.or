# runtime.or - what the GENERATED code costs, per primitive.
#
# tools/compile_bench.sh answers "did that change make compilation slower?".
# This answers the other half: "did that change make the compiled program
# slower?". Same shape - one machine-readable row per case, best-of-N and a
# baseline diff live in the script.
#
# Every case is sized to run ~100ms so a 1ms scheduling hiccup is noise, and
# every loop feeds a guard value the exit code depends on, so no case can be
# optimized away as dead.
define main() -> int:
    words = ["alpha", "beta", "gamma", "delta", "epsilon"]
    small = {"alpha": 1, "beta": 2, "gamma": 3, "delta": 4, "epsilon": 5}
    a = "alpha"
    b = "beta"
    c = "gamma"
    d = "delta"

    # --- map_get: 5-entry map, key varies so the lookup cannot be hoisted ---
    map_reps = 10000000
    t0 = monotonic_ms()
    edit m_acc = 0
    loop i in 0..<map_reps:
        k = at(words, i % 5)
        m_acc = m_acc + small[k]
    t1 = monotonic_ms()

    # --- list_at + set over a pre-sized buffer ---
    edit buf = [0, 0, 0, 0, 0, 0, 0, 0]
    list_reps = 10000000
    t2 = monotonic_ms()
    edit l_acc = 0
    loop i in 0..<list_reps:
        set(buf, i % 8, i)
        l_acc = l_acc + at(buf, i % 8)
    t3 = monotonic_ms()

    # --- append into a growing list (promoted in place) ---
    push_reps = 2000000
    t4 = monotonic_ms()
    edit xs = [0]
    loop i in 0..<push_reps:
        xs = append(xs, i)
    t5 = monotonic_ms()

    # --- int -> text ---
    itt_reps = 2500000
    t6 = monotonic_ms()
    edit i_acc = 0
    loop i in 0..<itt_reps:
        i_acc = i_acc + length(to_text(i))
    t7 = monotonic_ms()

    # --- concat of two texts ---
    cat_reps = 2500000
    t8 = monotonic_ms()
    edit c_acc = 0
    loop i in 0..<cat_reps:
        c_acc = c_acc + length(at(words, i % 5) + "-x")
    t9 = monotonic_ms()

    # --- interpolation, the shape the compiler's own emitter writes ---
    interp_reps = 750000
    t10 = monotonic_ms()
    edit s_acc = 0
    loop i in 0..<interp_reps:
        line = "  {a} = call i64 @orion_x(ptr {b}, i64 {c}, i64 {d})"
        s_acc = s_acc + length(line)
    t11 = monotonic_ms()

    map_ms = t1 - t0
    list_ms = t3 - t2
    push_ms = t5 - t4
    itt_ms = t7 - t6
    cat_ms = t9 - t8
    interp_ms = t11 - t10
    print_line("BENCH map_get {map_ms} {map_reps}")
    print_line("BENCH list_at {list_ms} {list_reps}")
    print_line("BENCH append {push_ms} {push_reps}")
    print_line("BENCH int_to_text {itt_ms} {itt_reps}")
    print_line("BENCH concat {cat_ms} {cat_reps}")
    print_line("BENCH interp {interp_ms} {interp_reps}")
    guard = m_acc + l_acc + i_acc + c_acc + s_acc + length(xs)
    if guard == 0 then 1 else 0
