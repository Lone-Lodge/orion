use orion_lex
use orion_parse
use orion_ir
use orion_ast_to_ir
use orion_emit_llvm
use os
use orion_driver

# 1 when stdout is a TTY: show a live progress bar. 0 when piped (CI): plain rows.
extern fn orion_console_color() -> int

# Orion test runner — LLVM backend.
#
# Each tests/test_<EXPECTED>.or contains an Orion source program that
# should compile and run with exit code EXPECTED. The runner:
#   1. compiles every test via LLVM IR → clang → native .exe
#   2. runs the .exe
#   3. checks exit == expected
#   4. measures compile time + binary size
#   5. prints summary table + totals


fn parse_expected(filename: Text) -> int:
    b = bytes_from_text(filename)
    total = len(b)
    mut start = 0
    if total >= 5:
        start = 5
    mut value = 0
    mut done = 0
    loop index in start..<total:
        if done == 0:
            ch = at(b, index)
            if ch >= 48 and ch <= 57:
                value = value * 10 + (ch - 48)
            else:
                done = 1
    value


# Compile one source file. Returns 1 if ok, 0 if compilation failed.
# rt_obj is the runtime PRE-COMPILED once (see main) — linking that object
# is ~10x faster than re-compiling orion_rt.c (all of Windows.h) per test.
# clang_path / mangle / host_triple are host-specific (see main): the compiler
# always emits a Windows triple, so off Windows we retarget the IR here.
fn compile_one(src_path: Text, ll_path: Text, exe_path: Text, rt_obj: Text, clang_path: Text, mangle: Text, host_triple: Text) -> int:
    raw = read_file(src_path)
    # Resolve `use` the way the real driver does. The runner used to lex the file
    # as-is, so a test could only touch the compiler's own orbs: `use async` or
    # `use iter` was an "unknown function" error, and every stdlib change had to
    # be proven by hand outside the suite. Same collector as `orion.exe`, so a
    # test sees exactly what a normal build sees.
    src = drv_collect(raw, ["../../orbs/", "orbs/"], src_path)
    tokens = self_lex(src)
    ast = self_parse(tokens)
    # Reject empty/garbage AST. A Program with 0 decls means the input
    # wasn't valid Orion source — clang would happily compile an empty
    # LLVM module, the resulting exe exits 0, and any test expecting 0
    # would falsely pass. Fail fast here.
    decls = get_list(ast, "decls")
    if len(decls) == 0:
        return 0
    # A type/lowering error makes the .ll unsound; building + running it
    # anyway is how malformed tests used to silently pass. compile_errors()
    # is a process-global counter, so compare the delta for THIS file.
    errs_before = compile_errors()
    module = ast_program_to_ir(ast)
    mut llvm_text = emit_module(module)
    if compile_errors() > errs_before:
        return 0
    # Retarget the baked-in Windows triple to the host (Linux/Mac). The
    # compiler pins a Windows triple (the effect ABI needs it), so a non-
    # Windows runner rewrites the two header tokens before clang. mangle "w"
    # = Windows = leave as-is.
    # Anchor to the header context ("datalayout = / triple = ") so we patch
    # only the two module-header lines, never a same-looking byte sequence
    # inside a program string constant (that would change the constant's
    # length and desync its LLVM array-size prefix).
    #
    # The retargeted text goes to a SEPARATE file. ll_path is tracked in git —
    # it is the compiler's own output, which CI diffs against a fresh build —
    # and rewriting it in place made every one of the 151 committed .ll files
    # differ by exactly those two header lines on any non-Windows host. The
    # artifact must be what the compiler emitted, the same on every machine;
    # the host-specific copy is scratch, so it is scratch on disk too.
    write_file(ll_path, llvm_text)
    mut link_path = ll_path
    if mangle != "w":
        retargeted = str_replace(llvm_text, "datalayout = \"e-m:w", "datalayout = \"e-m:{mangle}")
        host_text = str_replace(retargeted, "triple = \"x86_64-pc-windows-msvc19.44.35209\"", "triple = \"{host_triple}\"")
        link_path = "{ll_path}.host.ll"
        write_file(link_path, host_text)
    # Link the pre-built runtime object; -O0 skips the LLVM opt pipeline
    # (tests only assert exit codes, so optimization buys nothing here).
    # -Wno-override-module: silence clang's note that our retargeted triple
    # differs from its own default (harmless; no-op on Windows).
    args = [link_path, rt_obj, "-O2", "-Wno-override-module", "-o", exe_path]
    exit_code = run_command(clang_path, args)
    if exit_code == 0 then 1 else 0


fn fmt_ms(seconds: f64) -> Text:
    ms = seconds * 1000.0
    ms_int = to_int(ms)
    "{ms_int}ms"


fn main() -> int:
    mkdir_all("dist")
    # Host-specific toolchain bits. The runner works on Windows/Linux/Mac:
    # clang location, the datalayout mangling + target triple to retarget the
    # compiler's Windows IR to, all keyed off host_os() (0=Win 1=Linux 2=Mac).
    # rt_c is relative to this project dir (examples/tests), so no absolute,
    # machine-specific path is baked in.
    os = os_kind()
    mut clang_path = "clang"
    mut mangle = "e"
    mut host_triple = "x86_64-unknown-linux-gnu"
    if os == 0:
        clang_path = "C:\\Program Files\\LLVM\\bin\\clang.exe"
        mangle = "w"
        host_triple = ""
    if os == 2:
        mangle = "o"
        host_triple = "arm64-apple-macosx"
    rt_obj = "dist/orion_rt.o"
    rt_c = "../../runtime/orion_rt.c"
    # Pre-compile the runtime ONCE to an object file. Every test then just
    # links this object instead of re-compiling orion_rt.c (all of Windows.h)
    # from scratch — the single biggest per-test cost.
    run_command(clang_path, ["-c", "-Os", rt_c, "-o", rt_obj])
    raw_files = list_dir("tests")
    raw_total = len(raw_files)
    # Only run .or files. Without this filter, non-source files like
    # KNOWN_BUGS.md get fed to the compiler, produce broken-but-not-crashing
    # .exe's, exit=0 happens to match parse_expected()=0, and we get a
    # silent false pass. Filter at the source.
    mut files = []
    loop raw_index in 0..<raw_total:
        raw_name = at(raw_files, raw_index)
        name_bytes = bytes_from_text(raw_name)
        name_len = len(name_bytes)
        mut is_or_file = false
        if name_len >= 3:
            tail_dot = at(name_bytes, name_len - 3)
            tail_o = at(name_bytes, name_len - 2)
            tail_r = at(name_bytes, name_len - 1)
            if tail_dot == 46 and tail_o == 111 and tail_r == 114:
                is_or_file = true
        if is_or_file:
            files = push(files, raw_name)
    total_tests = len(files)

    mut pass_count = 0
    mut fail_count = 0
    mut total_compile_ms = 0
    mut total_bytes = 0

    # ANSI colors (ESC = byte 27) — green PASS, red FAIL, dim detail.
    esc = bytes_to_text([27])
    c_green = "{esc}[32m"
    c_red = "{esc}[31m"
    c_cyan = "{esc}[36m"
    c_bold = "{esc}[1m"
    c_dim = "{esc}[2m"
    c_off = "{esc}[0m"

    print_line("")
    print_line("  {c_bold}{c_cyan}◆ Orion{c_off} {c_dim}test runner · LLVM backend · {total_tests} tests{c_off}")
    print_line("  {c_dim}──────────────────────────────────────────────{c_off}")
    print_line("")

    is_tty = orion_console_color() == 1
    cr = bytes_to_text([13])
    frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

    loop file_index in 0..<total_tests:
        filename = at(files, file_index)
        src_path = "tests/{filename}"
        ll_path = "dist/{filename}.ll"
        exe_path = "dist/{filename}.exe"
        expected = parse_expected(filename)

        compile_start = now()
        ok = compile_one(src_path, ll_path, exe_path, rt_obj, clang_path, mangle, host_triple)
        compile_ms = elapsed(compile_start)
        total_compile_ms = total_compile_ms + compile_ms

        size_bytes = file_size(exe_path)
        total_bytes = total_bytes + size_bytes

        actual = run_command(exe_path, [])

        passed = ok == 1 and actual == expected
        status_txt = if passed then "{c_green}PASS{c_off}" else "{c_red}FAIL{c_off}"
        if passed:
            pass_count = pass_count + 1
        else:
            fail_count = fail_count + 1

        done_n = file_index + 1
        row = "{c_dim}[{done_n}/{total_tests}]{c_off} {status_txt} {filename}  {c_dim}{compile_ms}ms  {size_bytes}b{c_off}"
        # Piped (CI): the same per-test rows as before, byte for byte. On a TTY:
        # a live progress line that rewrites itself with `\r`; failures stay as
        # permanent rows above it, and `{esc}[K` clears any leftover characters.
        if is_tty:
            if not passed:
                print_raw("{cr}{esc}[K")
                print_line(row)
            spin = at(frames, file_index - (file_index / 10) * 10)
            print_raw("{cr}  {c_cyan}{spin}{c_off} {c_dim}{done_n}/{total_tests}{c_off}  {c_green}{pass_count} ok{c_off}  {c_red}{fail_count} fail{c_off}  {c_dim}{filename}{c_off}{esc}[K")
        else:
            print_line(row)

    if is_tty:
        print_raw("{cr}{esc}[K")

    print_line("--------------------------------------------------------------------")
    print_line("")
    all_pass = fail_count == 0
    summary_color = if all_pass then c_green else c_red
    print_line("{summary_color}Pass: {pass_count} / {total_tests}{c_off}")
    if fail_count > 0:
        print_line("{c_red}Fail: {fail_count}{c_off}")
    avg_ms = total_compile_ms / total_tests
    print_line("{c_dim}Total compile: {total_compile_ms}ms   avg: {avg_ms}ms/test   binaries: {total_bytes}b{c_off}")

    fail_count
