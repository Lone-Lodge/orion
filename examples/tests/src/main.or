use orion_lex
use orion_parse
use orion_ir
use orion_ast_to_ir
use orion_emit_llvm
use os
use text
use async
use orion_driver

# 1 when stdout is a TTY: show a live progress bar. 0 when piped (CI): plain rows.
external define orion_console_color() -> int

# Orion test runner - LLVM backend, parallel.
#
# Each tests/test_<EXPECTED>.or contains an Orion source program that
# should compile and run with exit code EXPECTED. Two phases:
#   1. EMIT (serial, in-process): lex/parse/emit every test to LLVM IR.
#      The compiler's recursion needs the main stack - it does not fit a
#      task's 256 KB fiber, which is why this phase stays out of tasks.
#   2. LINK+RUN (parallel): a pool of worker tasks, one per hardware
#      thread. clang and the test exe are CHILD PROCESSES started with
#      start_command_to_file; `finished_within` parks the task, so the
#      children run OS-parallel while one scheduler coordinates. A test
#      that hangs is stopped at its deadline instead of hanging the suite.


define parse_expected(filename: text) -> int:
    b = bytes_from_text(filename)
    total = len(b)
    edit start = 0
    if total >= 5:
        start = 5
    edit value = 0
    edit done = 0
    loop index in start..<total:
        if done == 0:
            ch = at(b, index)
            if ch >= 48 and ch <= 57:
                value = value * 10 + (ch - 48)
            else:
                done = 1
    value


# Host-specific toolchain bits, callable from any task. The runner works on
# Windows/Linux/Mac: clang location, the datalayout mangling + target triple
# to retarget the compiler's Windows IR to (0=Win 1=Linux 2=Mac).
define host_clang() -> text:
    if os_kind() == 0 then "C:\\Program Files\\LLVM\\bin\\clang.exe" else "clang"

define host_mangle() -> text:
    if os_kind() == 0:
        return "w"
    if os_kind() == 2:
        return "o"
    "e"

define host_triple_of() -> text:
    if os_kind() == 0:
        return ""
    if os_kind() == 2:
        return "arm64-apple-macosx"
    "x86_64-unknown-linux-gnu"


# Only .or files. Without this filter, non-source files like KNOWN_BUGS.md
# get fed to the compiler, produce broken-but-not-crashing .exe's, exit=0
# happens to match parse_expected()=0, and we get a silent false pass.
# Workers rebuild this list themselves (same directory, same order) - a task
# can only carry one int, and the list is cheap.
define or_files() -> [text]:
    raw_files = list_dir("tests")
    edit files = []
    loop raw_index in 0..<len(raw_files):
        raw_name = at(raw_files, raw_index)
        name_bytes = bytes_from_text(raw_name)
        name_len = len(name_bytes)
        edit is_or_file = false
        if name_len >= 3:
            tail_dot = at(name_bytes, name_len - 3)
            tail_o = at(name_bytes, name_len - 2)
            tail_r = at(name_bytes, name_len - 1)
            if tail_dot == 46 and tail_o == 111 and tail_r == 114:
                is_or_file = true
        if is_or_file:
            files = append(files, raw_name)
    files


# Emit one source file to LLVM IR. Returns 1 if ok, 0 if compilation failed.
define emit_one(src_path: text, ll_path: text, mangle: text, host_triple: text) -> int:
    raw = read_file(src_path)
    # Resolve `use` the way the real driver does, so a test sees exactly what
    # a normal build sees.
    src = drv_collect(raw, ["../../orbs/", "orbs/"], src_path)
    tokens = self_lex(src)
    ast = self_parse(tokens)
    # Reject empty/garbage AST - clang would happily compile an empty LLVM
    # module, the resulting exe exits 0, and any test expecting 0 would
    # falsely pass.
    decls = get_list(ast, "decls")
    if len(decls) == 0:
        return 0
    # A type/lowering error makes the .ll unsound. compile_errors() is a
    # process-global counter, so compare the delta for THIS file.
    errs_before = compile_errors()
    module = ast_program_to_ir(ast)
    edit llvm_text = emit_module(module)
    if compile_errors() > errs_before:
        return 0
    # The compiler pins a Windows triple (the effect ABI needs it); a
    # non-Windows runner retargets the two header tokens into a SEPARATE
    # scratch file - ll_path is tracked in git and must stay byte-identical
    # to what the compiler emitted on every machine.
    write_file(ll_path, llvm_text)
    if mangle != "w":
        retargeted = replace(llvm_text, "datalayout = \"e-m:w", "datalayout = \"e-m:{mangle}")
        host_text = replace(retargeted, "triple = \"x86_64-pc-windows-msvc19.44.35209\"", "triple = \"{host_triple}\"")
        write_file("{ll_path}.host.ll", host_text)
    1


# Link one emitted test with clang and run the exe, both as child processes
# the task can park on. Records the outcome in the shared counters and
# prints the row. Runs INSIDE a worker task.
define finish_one(filename: text, clang_path: text) -> int:
    esc = bytes_to_text([27])
    c_green = "{esc}[32m"
    c_red = "{esc}[31m"
    c_cyan = "{esc}[36m"
    c_dim = "{esc}[2m"
    c_off = "{esc}[0m"
    cr = bytes_to_text([13])

    ll_path = "dist/{filename}.ll"
    exe_path = "dist/{filename}.exe"
    expected = parse_expected(filename)
    link_path = if host_mangle() == "w" then ll_path else "{ll_path}.host.ll"

    link_start = now()
    edit built = 0
    if slot_get_int("ok:{filename}") == 1:
        cj = start_command_to_file(clang_path, [link_path, "dist/orion_rt.o", "dist/orion_cli.o", "-O2", "-Wno-override-module", "-o", exe_path], "dist/.clang_{filename}.txt")
        if cj >= 0 and finished_within(cj, 120000):
            built = if command_result(cj) == 0 then 1 else 0
        else:
            stopped = stop_command(cj)
            reaped = command_result(cj)

    edit actual = 0 - 1
    if built == 1:
        rj = start_command_to_file(exe_path, [], "dist/.out_{filename}.txt")
        if rj >= 0 and finished_within(rj, 30000):
            actual = command_result(rj)
        else:
            stopped2 = stop_command(rj)
            reaped2 = command_result(rj)

    compile_ms = slot_get_int("ems:{filename}") + elapsed(link_start)
    size_bytes = file_size(exe_path)
    slot_set("tms", slot_get_int("tms") + compile_ms)
    slot_set("tbytes", slot_get_int("tbytes") + size_bytes)

    passed = built == 1 and actual == expected
    status_txt = if passed then "{c_green}PASS{c_off}" else "{c_red}FAIL{c_off}"
    if passed:
        slot_set("pass", slot_get_int("pass") + 1)
    else:
        slot_set("fail", slot_get_int("fail") + 1)

    done_n = slot_get_int("done") + 1
    slot_set("done", done_n)
    total = slot_get_int("total")
    pass_count = slot_get_int("pass")
    fail_count = slot_get_int("fail")

    row = "{c_dim}[{done_n}/{total}]{c_off} {status_txt} {filename}  {c_dim}{compile_ms}ms  {size_bytes}b{c_off}"
    # Piped (CI): one row per test as it finishes. On a TTY: a live progress
    # line that rewrites itself with `\r`; failures stay as permanent rows
    # above it. A failed test names the log its child wrote.
    if slot_get_int("tty") == 1:
        if not passed:
            print("{cr}{esc}[K")
            print_line(row)
            log_hint = if built == 1 then "dist/.out_{filename}.txt" else "dist/.clang_{filename}.txt"
            print_line("{c_dim}      output: {log_hint}{c_off}")
        frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        spin = at(frames, done_n - (done_n // 10) * 10)
        print("{cr}  {c_cyan}{spin}{c_off} {c_dim}{done_n}/{total}{c_off}  {c_green}{pass_count} ok{c_off}  {c_red}{fail_count} fail{c_off}  {c_dim}{filename}{c_off}{esc}[K")
    else:
        print_line(row)
        if not passed:
            log_hint = if built == 1 then "dist/.out_{filename}.txt" else "dist/.clang_{filename}.txt"
            print_line("{c_dim}      output: {log_hint}{c_off}")
    0


# One worker task: pull the next un-linked test, finish it, repeat. Between
# reading `next` and bumping it there is no park point, and the scheduler is
# cooperative and single-threaded - two workers can never claim the same test.
define worker(w: int) -> int:
    files = or_files()
    total = len(files)
    clang_path = host_clang()
    loop:
        i = slot_get_int("next")
        if i >= total:
            break
        slot_set("next", i + 1)
        junk = finish_one(at(files, i), clang_path)
    0


define main() -> int:
    wall_start = now()
    mkdir_all("dist")
    clang_path = host_clang()
    mangle = host_mangle()
    host_triple = host_triple_of()
    rt_obj = "dist/orion_rt.o"
    rt_c = "../../runtime/orion_rt.c"
    # Pre-compile the runtime ONCE to object files. Every test then just
    # links these objects instead of re-compiling orion_rt.c (all of
    # Windows.h) from scratch - the single biggest per-test cost. orion_cli.c
    # is what carries the `os` orb's externs (sys_run, now, fs ops), so a
    # test that says `use os` links clean.
    run_command(clang_path, ["-c", "-Os", rt_c, "-o", rt_obj])
    run_command(clang_path, ["-c", "-Os", "../../runtime/orion_cli.c", "-o", "dist/orion_cli.o"])

    files = or_files()
    total_tests = len(files)

    esc = bytes_to_text([27])
    c_green = "{esc}[32m"
    c_red = "{esc}[31m"
    c_cyan = "{esc}[36m"
    c_bold = "{esc}[1m"
    c_dim = "{esc}[2m"
    c_off = "{esc}[0m"
    cr = bytes_to_text([13])

    print_line("")
    print_line("  {c_bold}{c_cyan}◆ Orion{c_off} {c_dim}test runner · LLVM backend · {total_tests} tests{c_off}")
    print_line("  {c_dim}──────────────────────────────────────────────{c_off}")
    print_line("")

    is_tty = orion_console_color() == 1
    # Keep the in-process compiler's per-file "orbs N" chatter off the progress
    # line (it prints once per compile otherwise).
    slot_set("drv:quiet", 1)

    # Phase 1: emit every test to IR, serially, on the main stack.
    loop file_index in 0..<total_tests:
        filename = at(files, file_index)
        emit_start = now()
        ok = emit_one("tests/{filename}", "dist/{filename}.ll", mangle, host_triple)
        slot_set("ok:{filename}", ok)
        slot_set("ems:{filename}", elapsed(emit_start))
        if is_tty:
            shown = file_index + 1
            print("{cr}  {c_dim}emit {shown}/{total_tests}  {filename}{c_off}{esc}[K")
    if is_tty:
        print("{cr}{esc}[K")

    # Phase 2: link + run through a worker pool, one worker per hardware
    # thread. The children are real OS processes; the tasks only wait.
    slot_set("next", 0)
    slot_set("done", 0)
    slot_set("pass", 0)
    slot_set("fail", 0)
    slot_set("tms", 0)
    slot_set("tbytes", 0)
    slot_set("total", total_tests)
    slot_set("tty", if is_tty then 1 else 0)
    jobs = cpu_count()
    edit workers = []
    loop w in 0..<jobs:
        workers = append(workers, spawn(worker, w))
    loop t in 0..<len(workers):
        junk = await(at(workers, t))

    if is_tty:
        print("{cr}{esc}[K")

    pass_count = slot_get_int("pass")
    fail_count = slot_get_int("fail")
    total_compile_ms = slot_get_int("tms")
    total_bytes = slot_get_int("tbytes")
    wall_ms = elapsed(wall_start)

    print_line("--------------------------------------------------------------------")
    print_line("")
    all_pass = fail_count == 0
    summary_color = if all_pass then c_green else c_red
    print_line("{summary_color}Pass: {pass_count} / {total_tests}{c_off}")
    if fail_count > 0:
        print_line("{c_red}Fail: {fail_count}{c_off}")
    avg_ms = total_compile_ms // total_tests
    print_line("{c_dim}Total compile: {total_compile_ms}ms   wall: {wall_ms}ms ({jobs} workers)   avg: {avg_ms}ms/test   binaries: {total_bytes}b{c_off}")

    fail_count
