# expect: list literal mixes
# Two different POINTER kinds in one list literal. (Mixing an int with a text is
# deliberately allowed: i64 is treated as a wildcard so the dynamic-storage
# idiom - ints and handles in one list - does not false-positive.)
type Point: x: int, y: int

fn main() -> int:
    xs = [Point{x: 1, y: 2}, "not a point"]
    len(xs)
