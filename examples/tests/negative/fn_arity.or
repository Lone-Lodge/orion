# expect: expects 1 argument
# A `function(int) -> int` param called with two arguments is a compile error now,
# not a silently ignored extra arg.
define inc(n: number) -> number:
    n + 1
define apply(f: function(int) -> number, x: number) -> number:
    f(x, 99)
define main() -> number:
    apply(inc, 41)
