# A DELIBERATELY broken orb, used by negative/orb_line.or to prove that a
# diagnostic inside library code points at the LIBRARY file and line. Nothing
# else compiles this directory: it is only reachable as an extra orb root passed
# by tools/negative_test.sh.
public define helper(x: int) -> int:
    y = does_not_exist_here
    x + y
