# expect: but the parameter is declared
# Passing a [int] where a fn(Text) -> int param is declared is a compile error
# (concrete pointer kinds differ), same rule as a direct call's arg-shape check.
fn strlen(t: Text) -> int:
    byte_count(t)
fn takes(f: fn(Text) -> int, s: [int]) -> int:
    f(s)
use text
fn main() -> int:
    takes(strlen, [1, 2, 3])
