# expect: perform_arity.or:11:4 — `Math.add` is handled with 2 parameter(s), got 1
# A perform that passes fewer arguments than the handler declares used to
# compile: the extra parameter read whatever was in the register.
effect Math:
    add: fn(a: int, b: int) -> int

handle Math.add(a: int, b: int) -> int:
    resume(a + b)

define main() -> int:
    perform Math.add(40)
