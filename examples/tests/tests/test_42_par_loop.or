# `loop parallel i in ...:` - one worker thread per iteration, on top of the
# verified par_run primitive. Each iteration's closure captures ITS OWN index
# by value and writes only its own slot, so the result is deterministic.
define main() -> number:
    edit out = [0, 0, 0, 0, 0, 0, 0]
    loop parallel i in 0 until 7:
        out[i] = i * 2
    edit total = 0
    loop v in out:
        total += v          # 0+2+4+6+8+10+12 is 42
    total
