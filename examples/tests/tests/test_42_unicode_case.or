# Unicode-aware case: `upper`/`lower` decode UTF-8 and map CODE POINTS, so one
# rule covers every alphabet in the tables (Latin-1, Latin Extended-A, Greek,
# Cyrillic) instead of one byte hack per script. The honest gap the very first
# language critique named was `upper("Åsa")` in a Swedish project.
use text

define main() -> int:
    # Latin-1: the original complaint, both directions.
    a = if upper("åsa är glad") is "ÅSA ÄR GLAD" and lower("RÄKSMÖRGÅS") is "räksmörgås" then 12 else 0
    # Greek, including the accent pairs and final sigma ς -> Σ.
    b = if upper("οδός") is "ΟΔΌΣ" and lower("ΕΛΛΗΝΙΚΆ") is "ελληνικά" then 10 else 0
    # Cyrillic: the main alphabet and the Ѐ..Џ row above it.
    c = if upper("привет ѐ") is "ПРИВЕТ Ѐ" and lower("ПРИВЕТ") is "привет" then 10 else 0
    # Latin Extended-A, where capital and small alternate by parity.
    d = if upper("čeština") is "ČEŠTINA" and lower("ČEŠTINA") is "čeština" then 6 else 0
    # Unmapped scripts pass through untouched; characters() still counts points.
    e = if upper("日本語 ok") is "日本語 OK" and characters("åsa") is 3 and len("åsa") is 4 then 4 else 0
    a + b + c + d + e
