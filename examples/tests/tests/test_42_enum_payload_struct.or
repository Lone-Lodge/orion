# An enum variant whose payload is itself an enum: the binding keeps the
# payload's real (struct) type, so it can be matched on in turn.
type Res:
    Ok(int)
    Bad(Text)

type Opt:
    Some(Res)
    None

fn unwrap(r: Res) -> int:
    match r:
        Ok(n) -> n
        Bad(m) -> 0 - len(m)

fn main() -> int:
    v = Opt.Some(Res.Ok(42))
    match v:
        Some(r) -> unwrap(r)
        None -> 0
