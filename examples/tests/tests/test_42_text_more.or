fn repeat(t: Text, n: int) -> Text:
    mut result = ""
    if n > 0:
        loop _ in 0..<n:
            result = "{result}{t}"
    result

fn upper(t: Text) -> Text:
    t_bytes = bytes_from_text(t)
    n = bytes_length(t_bytes)
    mut out = bytes_zeros(0)
    loop ci in 0..<n:
        b = byte_at(t_bytes, ci)
        mut new_b = b
        if b >= 97 and b <= 122:
            new_b = b - 32
        out = bytes_concat(out, [new_b])
    bytes_to_text(out)

fn main() -> int:
    # repeat
    line = "-".repeat(7)
    line_len = line.len()

    # upper
    yelled = "hello".upper()
    yelled_check = if yelled == "HELLO" then 35 else 0

    # 7 + 35 = 42
    line_len + yelled_check
