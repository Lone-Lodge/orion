define repeat(t: text, n: int) -> text:
    edit result = ""
    if n > 0:
        loop _ in 0..<n:
            result = "{result}{t}"
    result

define upper(t: text) -> text:
    t_bytes = bytes_of(t)
    n = bytes_count(t_bytes)
    edit out = bytes_zeros(0)
    loop ci in 0..<n:
        b = byte_at(t_bytes, ci)
        edit new_b = b
        if b >= 97 and b <= 122:
            new_b = b - 32
        out = bytes_concat(out, [new_b])
    text_of(out)

define main() -> int:
    # repeat
    line = "-".repeat(7)
    line_len = line.length()

    # upper
    yelled = "hello".upper()
    yelled_check = if yelled == "HELLO" then 35 else 0

    # 7 + 35 = 42
    line_len + yelled_check
