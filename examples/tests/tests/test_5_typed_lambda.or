# Typed closure parameters: `fn(s: Text): ...`. Without the annotation a
# lambda param is int, so `len(s)` on a passed Text couldn't compile. Now
# the param carries its real type through the lambda-lift.
fn each_len(xs: [Text], f: fn) -> [int]:
    mut out = []
    loop i in 0..<len(xs):
        out = push(out, f(at(xs, i)))
    out

fn main() -> int:
    words = ["ab", "cde"]
    lens = each_len(words, fn(s: Text): len(s))   # [2, 3]
    at(lens, 0) + at(lens, 1)                      # 5
