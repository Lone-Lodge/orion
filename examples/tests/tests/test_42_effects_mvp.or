effect AskUser:
    ask: fn(prompt: Text) -> Text

# The handler resumes with a Text value; control jumps back to the caller.
# `resume` picks the text path from the argument's type.
handle AskUser.ask(prompt: Text) -> Text:
    resume("default answer")

fn main() -> int:
    answer = perform AskUser.ask("hello")
    if answer == "default answer":
        42
    else:
        0
