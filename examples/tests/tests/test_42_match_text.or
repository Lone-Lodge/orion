define main() -> number:
    kind_val = 2
    # Match with int patterns + text branches in expression position.
    # Both bugs (match-as-expr + match-int-text) now fixed.
    kind_text = choose kind_val:
        1 then "one"
        2 then "two"
        _ then "other"
    if kind_text is "two":
        42
    else:
        0
