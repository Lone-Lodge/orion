define double_it(x: number) -> number:
    x + x

define main() -> number:
    # User fn via method-call syntax
    a = 21
    a_doubled = a.double_it()

    # Builtin via method-call syntax: text.length()
    msg = "hello"
    msg_len = msg.length()

    # Builtin with arg: text.contains("world")
    has_lo = msg.contains("lo")

    # List push via method-call
    edit items = [1, 2]
    items = items.append(3)
    sum_items = items[0] + items[1] + items[2]

    # 42 + 5 + 1 + 6 - 12 = 42
    a_doubled + msg_len + has_lo + sum_items - 12
