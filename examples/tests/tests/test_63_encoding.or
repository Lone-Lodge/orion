# encoding: hex and base64 both directions, checked against RFC 4648 vectors
# and round-trips. Bytes are plain [int] lists here.
use encoding

define main() -> int:
    ok_hex = if hex_encode([255, 16, 0, 171]) == "ff1000ab" and at(hex_decode("ff10"), 0) == 255 then 1 else 0
    ok_vec = if base64_encode(bytes_of("Man")) == "TWFu" and base64_encode(bytes_of("Hi")) == "SGk=" then 1 else 0
    ok_round = if text_of(base64_decode(base64_encode(bytes_of("hello, world!")))) == "hello, world!" then 1 else 0
    ok_hexround = if text_of(hex_decode(hex_encode(bytes_of("AB")))) == "AB" then 1 else 0
    ok_hex * 20 + ok_vec * 20 + ok_round * 13 + ok_hexround * 10   # 63
