# The last two surface features:
#   light anonymous function:  (n): n + k         (no keyword)
#   block-if as an EXPRESSION: x = if c: ... else: ...
use iter

define main() -> int:
    k = 10
    add_k = (n): n + k
    doubled = each([1, 2, 3], (x): x * 2)     # [2, 4, 6]
    label = if len(doubled) is 3:
        add_k(20)                            # 30
    else:
        0
    two = (a, b): a + b
    label + two(5, 4) + sum(doubled) - 9     # 30 + 9 + 12 - 9 = 42
