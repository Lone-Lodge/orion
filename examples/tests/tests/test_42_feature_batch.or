# The readability feature batch:
#   named arguments with `:`  - greet(times: 2)
#   parameter defaults        - define f(x, loud = false)
#   `list of T`               - items: list of int
#   `given` generics clause   - define first given item (...)
define scaled(base: number, factor = 3) -> number:
    base * factor

define pick(xs: list of number, fallback = 9) -> number:
    if length(xs) > 0 then xs[0] else fallback

define first given item (items: list of item) -> item:
    items[0]

define main() -> number:
    a = scaled(5)                       # default factor 3 -> 15
    b = scaled(5, factor: 4)            # named + explicit  -> 20
    c = pick([])                        # default fallback  -> 9  wait len 0 -> 9
    d = pick([7, 8])                    # -> 7... use to keep sum 42: skip d
    e = first(["x", "yz"])
    a + b + c - length(e) - 1              # 15 + 20 + 9 - 1 - 1 = 42
