# The built-in type names accept their lowercase spelling: `text` works
# like `Text`, `map` like `Map`. Before, a lowercase `text` annotation was
# an unknown name that silently became i64 — so `len(x)` later failed with
# a confusing "untyped value" error.
define slen(x: text) -> int:
    len(x)

define main() -> int:
    slen("hello")
