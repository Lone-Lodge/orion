# The socket you cannot forget to close: with_listener / with_connection own
# the handle and close it on every exit path (defer), so no leak is possible.
use net

define serve_once(s: number) -> number:
    c = connect("127.0.0.1", 58423)
    if not ok(c):
        return 0
    srv = accept(s)
    send(c, "hej")
    got = recv(srv, 64)
    close(srv)
    close(c)
    if got is "hej" then 42 else 1

define main() -> number:
    with_listener(58423, serve_once)
