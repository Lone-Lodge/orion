fn category(n: int) -> int:
    mut result = 0
    loop i in 0..<3:
        if n < 0:
            result = 1
        else:
            if n == 0:
                result = 2
            else:
                if n < 10:
                    result = 42
                else:
                    result = 4
    result

fn main() -> int:
    category(7)
