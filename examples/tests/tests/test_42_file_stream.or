# Streaming file IO: write a file a chunk at a time, read it back a chunk at
# a time, and let the scope-owned forms close both handles.
use file
use text

define write_three(h: number) -> number:
    write_line(h, "alpha")
    write_line(h, "beta")
    write_line(h, "gamma")
    3

define count_bytes(h: number) -> number:
    edit total = 0
    loop:
        chunk = read_chunk(h, 4)          # tiny chunks on purpose
        if is_end(chunk):
            break
        total = total + length(chunk)
    total

define main() -> number:
    path = "dist/.stream_test.txt"
    wrote = with_write(path, write_three)
    streamed = with_read(path, count_bytes)
    whole = file_read(path)
    on_disk = size_of(path)
    missing = with_read("dist/.no_such_file_here", count_bytes)
    ok1 = if wrote is 3 then 10 else 0
    ok2 = if streamed is 17 then 10 else 0          # alpha\nbeta\ngamma\n
    ok3 = if streamed is on_disk then 10 else 0     # stream is size on disk
    ok4 = if length(whole) is streamed then 6 else 0   # stream is whole-file read
    ok5 = if missing is 0 - 1 then 6 else 0         # a missing file says so
    ok1 + ok2 + ok3 + ok4 + ok5
