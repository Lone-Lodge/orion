# A match arm that produces no value must not crash the compiler.
#
# `if let P(x) = e:` desugars to a two-arm match, so its body becomes an arm
# body. When that body ENDS IN A STATEMENT - a block-form `if`, a loop - the arm
# yields no value, and the lowering stored that non-value into the match's
# result slot. Storing id -1 walked the instruction list backwards and the
# compiler died with `list index -1 out of range` - an internal trap, on
# ordinary code, with no line number and nothing to act on.
#
# A diverging arm (`_ -> break`) was already handled; this is the other way an
# arm can have nothing to store, and it was not.
type Opt: Some(number), None

define from_if_let(o: Opt) -> number:
    edit score = 0
    if let Some(v) = o:
        # A nested block-form `if`: this is the shape that crashed.
        if v is 4:
            score = score + 10
    score

define from_match(o: Opt) -> number:
    edit hits = 0
    choose o:
        Some(v) then 
            if v > 0:
                hits = hits + 1
        None then hits = hits
    hits

define from_loop_arm(o: Opt) -> number:
    edit total = 0
    choose o:
        Some(n) then 
            loop i in 0 until n:
                total = total + i
        None then total = total
    total

define main() -> number:
    a = from_if_let(Opt.Some(4))      # 10
    b = from_if_let(Opt.None)         # 0
    c = from_match(Opt.Some(9))       # 1
    d = from_loop_arm(Opt.Some(5))    # 0+1+2+3+4 = 10
    print_line("if_let={a}/{b} match={c} loop={d}")
    a + b + c + d + 5                 # 10 + 0 + 1 + 10 + 5 is 26
