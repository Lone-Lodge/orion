# An effect operation gets ALL its arguments.
#
# `perform Effect.op(a, b)` used to lower to a single-argument runtime entry: the
# second argument was evaluated and then dropped, so the handler read whatever
# happened to be in the register. `perform Math.add(40, 2)` returned 248. No
# error, no warning, a wrong number - in the one mechanism the language leans on
# for control flow.
#
# Every Orion value is a 64-bit word, so arguments ride as word slots whatever
# their source type and the runtime casts the handler to the matching arity
# (0..4; more is a compile error). Mixed int/text parameters therefore work.
effect Math:
    add: fn(a: int, b: int) -> int

effect Mix:
    at: fn(name: text, n: int) -> int

effect Log:
    msg: fn(text: text) -> text

handle Math.add(a: int, b: int) -> int:
    resume(a + b)

handle Mix.at(name: text, n: int) -> int:
    resume(len(name) + n)

handle Log.msg(text: text) -> text:
    resume("ok")

define main() -> int:
    a = perform Math.add(40, 2)      # 42
    b = perform Mix.at("abc", 7)     # 3 + 7 = 10
    c = len(perform Log.msg("hi"))   # 2, the single-arg path is unchanged
    a + b + c                        # 42 + 10 + 2 == 54
