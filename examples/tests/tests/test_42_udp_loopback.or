# UDP on loopback, in-process: two bound sockets exchange datagrams. A UDP
# socket is a socket - readable_within gives the receive a deadline - and
# udp_sender() names who sent, which is what a game server keys clients by.
use net
use text

define main() -> int:
    a = udp(0)
    b = udp(0)
    if a < 0 or b < 0:
        return 1
    pa = local_port(a)
    pb = local_port(b)
    s1 = udp_send(a, "127.0.0.1", pb, "ping")
    got_b = if readable_within(b, 3000) then udp_receive(b, 512) else ""
    from_a = udp_sender()
    s2 = udp_send(b, "127.0.0.1", pa, "pong")
    got_a = if readable_within(a, 3000) then udp_receive(a, 512) else ""
    close(a)
    close(b)
    sender_ok = starts_with(from_a, "127.0.0.1:")
    print_line("b_got={got_b} a_got={got_a} from={from_a}")
    p1 = if got_b is "ping" then 16 else 0
    p2 = if got_a is "pong" then 16 else 0
    p3 = if sender_ok then 10 else 0
    p1 + p2 + p3
