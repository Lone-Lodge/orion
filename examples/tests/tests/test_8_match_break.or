# `break` (and `continue`/`return`) inside a match arm within a loop now works:
# a diverging arm is detected and the match skips its value-store + fallthrough.
type Opt<T>: Some(T) | None

define dec(n: int) -> Opt<int>:
    if n > 0 then Opt.Some(n - 1) else Opt.None

define main() -> int:
    edit count = 0
    edit cur = 8
    loop:
        choose dec(cur):
            Some(next) ->
                cur = next
                count = count + 1
            _ -> break
    count      # 8 iterations then None -> break
