# String interpolation now parses the full expression inside `{...}` -
# arithmetic and indexing, not just bare idents / calls / fields. Here
# `{a + b}` must render "14" (2 chars), not fail as an unknown identifier.
define main() -> int:
    a = 5
    b = 9
    xs = [3, 4]
    s = "{a + b}"          # "14"
    t = "{xs[0]}"          # "3"
    length(s) * 7             # 2 * 7 = 14
