define main() -> int:
    bs = bytes_of("hello world")
    head = bytes_part(bs, 0, 5)
    tail = bytes_part(bs, 6, 11)
    joined = bytes_concat(head, bytes_concat(bytes_of(" "), tail))
    out = text_of(joined)
    # "hello world" - 11 chars, but our test compares len
    n = length(out)
    n + 31
