# A `function(...)` parameter carries a real arity now: correct higher-order calls
# work, and the compiler checks the argument count (the wrong-count case is
# examples/tests/negative/fn_arity.or).
define inc(n: number) -> number:
    n + 1
define dbl(n: number) -> number:
    n * 2
define add(a: number, b: number) -> number:
    a + b

define apply(f: function(int) -> number, x: number) -> number:
    f(x)
define apply2(f: function(int, int) -> number, a: number, b: number) -> number:
    f(a, b)

define main() -> number:
    apply(inc, 10) + apply(dbl, 20) + apply2(add, 3, 11)   # 11 + 40 + 14 = 65
