# A `fn(...)` parameter carries a real arity now: correct higher-order calls
# work, and the compiler checks the argument count (the wrong-count case is
# examples/tests/negative/fn_arity.or).
fn inc(n: int) -> int:
    n + 1
fn dbl(n: int) -> int:
    n * 2
fn add(a: int, b: int) -> int:
    a + b

fn apply(f: fn(int) -> int, x: int) -> int:
    f(x)
fn apply2(f: fn(int, int) -> int, a: int, b: int) -> int:
    f(a, b)

fn main() -> int:
    apply(inc, 10) + apply(dbl, 20) + apply2(add, 3, 11)   # 11 + 40 + 14 = 65
