# A type annotation on an immutable binding DECIDES the type.
#
# A map holds anything, so a value read out of one cannot be typed by
# inspection: `get_list(m, k)` is typed list-of-map whatever it holds. Reading a
# text element out of it therefore lowered `len` to a MAP length: no error, just
# a wrong number. The annotation is how the programmer says what is in there.
#
# It only half worked: `mut ys: [Text] = …` was honoured (a mut read loads with
# the slot's annotated type) while the immutable `ys: [Text] = …` parsed the
# annotation and dropped it, which is the worse of the two - it looks like the
# fix and is a no-op. Both forms now agree.
fn text_len_of_first(m: Map) -> int:
    ys: [Text] = get_list(m, "words")
    at(ys, 0).len()

fn mut_form(m: Map) -> int:
    mut ys: [Text] = get_list(m, "words")
    len(at(ys, 1))

fn main() -> int:
    m = {"words": ["ab", "cdef"]}
    a = text_len_of_first(m)   # 2, not the map length
    b = mut_form(m)            # 4
    # An annotation that adds nothing is still fine (no slot, no change).
    n: int = 3
    a + b + n                  # 2 + 4 + 3 == 9
