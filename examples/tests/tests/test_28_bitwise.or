# Bit operations, and the literals that go with them.
#
# `syntax.md` listed `<< >> & | ^ ~` as operators. Four of them PARSED and three
# of those computed the wrong thing: with no entry in the precedence table,
# `a & b` parsed as just `a` and the rest of the expression was dropped, so
# `12 & 10` answered 12. `<<` and `>>` did not lex at all, and neither did
# `0xFF` (it came out as the number 0 followed by an identifier `xFF`).
#
# Nothing caught it because nothing used it - the one place in the tree that
# does, `atlas/orbs/atlas_ws` (a WebSocket implementation in Orion), cannot
# compile for an unrelated reason and so was never built.
#
# Bitwise binds TIGHTER than comparison here, deliberately: `flags & MASK == 0`
# reads the way it looks. C binds it the other way and that is a famous trap.
define main() -> int:
    a = 12                      # 1100
    b = 10                      # 1010
    and_ = a & b                # 1000 = 8
    or_ = a | b                 # 1110 = 14
    xor_ = a ^ b                # 0110 = 6

    shifted_up = 1 << 8         # 256
    shifted_down = 256 >> 4     # 16
    signed_shr = (0 - 16) >> 2  # -4: arithmetic shift keeps the sign

    hex_ = 0xFF                 # 255
    bin_ = 0b1010               # 10
    oct_ = 0o17                 # 15
    underscored = 0xFF_FF       # 65535

    # The real use: a WebSocket length header. 300 = 0x012C.
    plen = 300
    hi = (plen >> 8) & 0xFF     # 1
    lo = plen & 0xFF            # 44

    # Tighter than comparison: this is (a & 4) == 4, not a & (4 == 4).
    masked = if a & 4 == 4 then 1 else 0

    print_line("bits {and_} {or_} {xor_} shifts {shifted_up} {shifted_down} {signed_shr}")
    print_line("literals {hex_} {bin_} {oct_} {underscored} frame {hi} {lo} masked {masked}")

    ok_bits = if and_ == 8 and or_ == 14 and xor_ == 6 then 1 else 0
    ok_shift = if shifted_up == 256 and shifted_down == 16 and signed_shr == 0 - 4 then 1 else 0
    ok_lit = if hex_ == 255 and bin_ == 10 and oct_ == 15 and underscored == 65535 then 1 else 0
    ok_frame = if hi == 1 and lo == 44 and masked == 1 then 1 else 0
    # `~x` is `x ^ -1`. It was missing from the LEXER's single-char table, so
    # the operator vanished before the parser saw it and `~12` answered 12.
    ok_not = if ~12 == 0 - 13 and ~0 == 0 - 1 then 1 else 0
    ok_bits * 7 + ok_shift * 7 + ok_lit * 7 + ok_frame * 6 + ok_not * 1   # 28
