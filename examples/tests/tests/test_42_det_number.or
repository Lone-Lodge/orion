# Bit-exact determinism WITHOUT fixed-point: IEEE basic ops + sqrt/floor are
# exact on every target, so `number` stays the one type - the compiler just
# forbids the five libm calls whose last bits differ across platforms.
deterministic define integrate(pos: float, vel: float, dt: float) -> float:
    pos + vel * dt

deterministic define dist(x: float, y: float) -> float:
    sqrt(x * x + y * y)

define main() -> int:
    p = integrate(10.0, 4.0, 0.5)
    d = dist(3.0, 4.0)
    (p + d * 6) as int
