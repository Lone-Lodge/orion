# Inline sum form: variants on one line, `|`-separated (the Rust-ish shape).
# Same Enum node as the indented form, just compact. Works with generics.
type Result<T, E>: Ok(T) | Err(E)

define divide(a: int, b: int) -> Result<int, text>:
    if b == 0 then Result.Err("div by zero") else Result.Ok(a // b)

define main() -> int:
    choose divide(96, 2):
        Ok(v)  -> v     # 48
        Err(m) -> 0
