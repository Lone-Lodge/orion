# Traits as explicit dictionaries: a `trait` is a struct of functions, an
# instance is a struct value you pass by hand, and `o.method(args)` calls the
# fn-typed field (not a UFCS global). No implicit resolution: you can see which
# dictionary is passed. Here two Ord instances drive one `minimum`.
type Ord: lt: fn(int, int) -> int, eq: fn(int, int) -> int

define int_lt(a: int, b: int) -> int:
    if a < b then 1 else 0
define int_eq(a: int, b: int) -> int:
    if a == b then 1 else 0
define desc_lt(a: int, b: int) -> int:
    if a > b then 1 else 0

define minimum(o: Ord, xs: [int]) -> int:
    edit best = at(xs, 0)
    loop i in 1..<len(xs):
        if o.lt(at(xs, i), best) == 1:
            best = at(xs, i)
    best

define main() -> int:
    asc = Ord{lt: int_lt, eq: int_eq}
    desc = Ord{lt: desc_lt, eq: int_eq}
    xs = [30, 10, 50, 20]
    ok_min = if minimum(asc, xs) == 10 then 1 else 0
    ok_max = if minimum(desc, xs) == 50 then 1 else 0     # min by desc-lt = the largest
    ok_eq = if asc.eq(7, 7) == 1 and asc.eq(7, 8) == 0 then 1 else 0
    ok_min * 23 + ok_max * 23 + ok_eq * 22                # 68
