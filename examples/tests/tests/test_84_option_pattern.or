type Option: has: number, value: number

define Some(v: number) -> Option:
    Option{has: 1, value: v}

define None() -> Option:
    Option{has: 0, value: 0}

define find_in_list(xs: [number], target: number) -> Option:
    edit idx = 0
    edit found = None()
    loop x in xs:
        if x is target:
            found = Some(idx)
        idx = idx + 1
    found

define main() -> number:
    items = [10, 21, 30, 21]
    a = find_in_list(items, 21)
    b = find_in_list(items, 99)
    # a.value = 1 (idx of first 21)
    # b.has = 0 (not found)
    # 1 * 21 + (1 - 0) * 21 = 42
    if a.has is 1 and b.has is 0:
        a.value * 21 + 21
    else:
        0
