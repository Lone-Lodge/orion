# Tuples are anonymous structs now, so they can be HETEROGENEOUS: each slot
# keeps its own type. `(5, "hello")` gives an int and a text, and `length(s)`
# type-checks on the text slot. Multi-return uses a tuple type `(int, int)`.
define divmod(a: number, b: number) -> (number, number):
    (a // b, a % b)

define main() -> number:
    q, r = divmod(17, 5)      # q=3, r=2
    n, s = (5, "hello")       # heterogeneous: n is int, s is text
    q * 10 + r + n + length(s)   # 32 + 5 + 5 is 42
