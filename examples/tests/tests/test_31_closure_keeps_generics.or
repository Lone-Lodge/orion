# A closure anywhere must not disable generic call-site instantiation.
#
# The nested-lambda pass rebuilt every function with a block body from a MAP
# LITERAL listing six fields - name, params, ret, body, pub, orb - and silently
# dropped everything else on the declaration, including `generics_csv`. That
# field is what tells the call site which type variables a function has, so:
#
#   * a file with NO lambda: `at(keep(words, p), 0)` is a Text (correct)
#   * add ONE closure anywhere in the program, and the same line became an int
#
# The feature had a test, and the test passed, because the test had no closure
# in it. A rebuild that enumerates fields is a list that goes stale the next
# time someone adds one; it sets the changed fields on the original decl now.
use iter

define is_long(s: text) -> truth:
    len(s) > 3

define apply(f: fn, x: int) -> int:
    f(x)

define main() -> int:
    # The closure that used to break everything below it.
    k = 10
    add_k = fn(n): n + k
    bumped = apply(add_k, 5)          # 15

    words = ["aa", "bbbb", "cc"]
    kept = keep(words, is_long)     # -> ["bbbb"], and it must stay [text]
    first = at(kept, 0)
    text_len = len(first)             # 4, only typeable if T bound to Text

    # Nested in one expression, same requirement.
    inline_len = len(at(keep(words, is_long), 0))

    print_line("bumped={bumped} text_len={text_len} inline={inline_len}")
    ok = if text_len == 4 and inline_len == 4 and bumped == 15 then 1 else 0
    ok * 31
