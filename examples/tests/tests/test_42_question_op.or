enum Result: Ok(int), Err(Text)

fn safe_div(a: int, b: int) -> Result:
    if b == 0:
        Result.Err("div by zero")
    else:
        Result.Ok(a / b)

fn calc(x: int) -> Result:
    a = safe_div(100, x)?
    Result.Ok(a * 2)

fn main() -> int:
    good = calc(2)
    bad = calc(0)
    # Payload is read via match (enums have no field accessor); .tag is the
    # discriminant. `?` must unwrap good and short-circuit bad to Err.
    good_val = match good:
        Ok(v) -> v
        Err(_) -> 0
    if good.tag == 0 and bad.tag == 1:
        if good_val == 100:
            42
        else:
            0
    else:
        0
