type Inst: value: int, kind: text

define value_ref(x: int) -> text:
    "v{x}"

define main() -> int:
    inst = Inst{value: 21, kind: "iconst"}
    # This was the bug: {value_ref(inst.value)} captured `inst.value`
    # as a single Ident name, exploding ast_to_ir with "unknown identifier".
    msg = "ref={value_ref(inst.value)} kind={inst.kind}"
    if contains(msg, "ref=v21"):
        if contains(msg, "kind=iconst"):
            42
        else:
            0
    else:
        0
