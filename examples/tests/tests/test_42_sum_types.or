enum Maybe: Some(int), None(int)

fn safe_div(a: int, b: int) -> Maybe:
    if b == 0:
        Maybe.None(0)
    else:
        Maybe.Some(a / b)

fn unwrap(m: Maybe) -> int:
    match m:
        Some(v) -> v
        None(_) -> 0

fn main() -> int:
    r1 = safe_div(84, 2)
    r2 = safe_div(100, 0)
    unwrap(r1) + unwrap(r2)
