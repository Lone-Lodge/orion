# num's float layer: PI/E constants, parse_float (decimals + exponent), the
# f* min/max/abs/clamp helpers, and the language's own math builtins.
use num

fn main() -> int:
    ok_parse = if (parse_float("3.14") as int) == 3 and (parse_float("-2.5e3") as int) == 0 - 2500 then 1 else 0
    ok_clamp = if fclamp(12.0, 0.0, 10.0) == 10.0 and fabs(0.0 - 5.5) == 5.5 then 1 else 0
    ok_builtin = if (pi() as int) == 3 and (sqrt(16.0) as int) == 4 and (pow(2.0, 10.0) as int) == 1024 then 1 else 0
    ok_minmax = if fmin(1.5, 2.5) == 1.5 and fmax(1.5, 2.5) == 2.5 then 1 else 0
    ok_parse * 20 + ok_clamp * 20 + ok_builtin * 10 + ok_minmax * 10   # 60
