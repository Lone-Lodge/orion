# Match guards + binding patterns: `x if COND -> body` binds x to the scrutinee
# and matches only when COND holds; a failed guard falls through to the next arm.
fn classify(n: int) -> int:
    match n:
        x if x > 100 -> 3
        x if x > 10  -> 2
        x if x > 0   -> 1
        _            -> 0

fn main() -> int:
    classify(5) + classify(50) + classify(500) + classify(0)   # 1 + 2 + 3 + 0 == 6
