# A function(...) parameter's declared RETURN type is propagated through the call, so
# a pointer result (text/list) and an f64 result keep their type instead of
# collapsing to i64. Each storage class is exercised.
use text
define label(n: number) -> text:
    "x={n}"
define triple(n: number) -> [number]:
    [n, n, n]
define half(n: number) -> f64:
    (n as f64) / 2.0

define text_via(f: function(int) -> text, x: number) -> number:
    byte_count(f(x))
define list_of(f: function(int) -> [number], x: number) -> number:
    length(f(x))
define float_of(f: function(int) -> f64, x: number) -> number:
    (f(x) * 4.0) as int

define main() -> number:
    ok_text = if text_via(label, 7) is 3 then 1 else 0
    ok_list = if list_of(triple, 9) is 3 then 1 else 0
    ok_float = if float_of(half, 5) is 10 then 1 else 0
    ok_text * 22 + ok_list * 22 + ok_float * 22   # 66
