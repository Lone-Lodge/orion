# Functional-style programming in Orion 2026.
#
# `|x| body` lambdas ARE parsed but their lowering needs a tree-walker
# lift pass (3-5h future work). Until then, use named fns + first-class
# fn refs - same capabilities, slightly more verbose.

# ---- Building blocks (named fns) ------------------------------------

define double(x: number) -> number:
    x * 2

define inc(x: number) -> number:
    x + 1

define add(a: number, b: number) -> number:
    a + b

# ---- Higher-order helpers ------------------------------------------

define apply(f: function, x: number) -> number:
    f(x)

define compose_call(g: function, h: function, x: number) -> number:
    g(h(x))   # g(h(x))

define twice(f: function, x: number) -> number:
    f(f(x))

# ---- Main - uses fns as first-class values --------------------------

define main() -> number:
    # First-class fn binding
    op = inc

    # Indirect call
    a = op(10)              # = 11

    # Higher-order: pass fn as arg
    b = apply(double, a)    # = 22

    # Compose two fns
    c = compose_call(inc, double, b)   # inc(double(22)) = 45

    # Apply twice
    d = twice(inc, 0)       # inc(inc(0)) = 2

    # Chain with plain intermediate variables - readable, top to bottom.
    step = double(10)       # 20
    e = inc(step)           # 21

    # Total: 45 (c) - 3 = 42
    c - 3
