# safe_eval - an RPN evaluator that REPORTS errors instead of guessing.
#
# Build: orion.exe examples/demos/safe_eval.or out.ll orbs
#
# Where rpn.or substitutes 0 on a bad divide, this one models fallibility
# honestly with a sum type and propagates failures with the `?` operator:
#   - `enum Eval: Ok(int), Err(text)` - a result is a value OR a message
#   - `apply` returns Err on divide-by-zero / unknown operator
#   - `expr?` unwraps Ok to the int, or early-returns the Err up the stack
#   - stack underflow and leftover operands are errors too
#   - `choose` on the result at the top reports Ok / Err
#
# `?` is exercised in a spot the tests don't reach: inside a `for` loop, inside
# a `choose` arm - the short-circuit still returns straight out of `eval`.

type Token: Num(number), Op(text)
type Eval:  Ok(number), Err(text)

define is_digit(b: number) -> number:
    if b >= '0' and b <= '9' then 1 else 0

# ---- Tokenizer -------------------------------------------------------

define tokenize(src: text) -> [Token]:
    bs = bytes_of(src)
    n = length(bs)
    edit toks = []
    edit i = 0
    loop:
        if i >= n:
            break
        b = bs[i]
        if b is ' ':
            i = i + 1
        else:
            if is_digit(b) is 1:
                edit num = 0
                loop:
                    if i >= n:
                        break
                    d = bs[i]
                    if is_digit(d) is 0:
                        break
                    num = num * 10 + (d - '0')
                    i = i + 1
                toks = append(toks, Token.Num(num))
            else:
                toks = append(toks, Token.Op(text_of(append([], b))))
                i = i + 1
    toks

# ---- A fallible operator ---------------------------------------------

define apply(op: text, a: number, b: number) -> Eval:
    choose op:
        "+" then Eval.Ok(a + b)
        "-" then Eval.Ok(a - b)
        "*" then Eval.Ok(a * b)
        "/" then 
            if b is 0:
                Eval.Err("division by zero")
            else:
                Eval.Ok(a / b)
        _ then Eval.Err("unknown operator '{op}'")

# ---- Evaluator: errors bubble up via `?` -----------------------------

define eval(toks: [Token]) -> Eval:
    edit stack = []
    loop t in toks:
        choose t:
            Num(v) then stack = append(stack, v)
            Op(o) then 
                if length(stack) < 2:
                    return Eval.Err("stack underflow at '{o}'")
                top = length(stack)
                b = stack[top - 1]
                a = stack[top - 2]
                stack = part(stack, 0, top - 2)
                val = apply(o, a, b)?           # unwrap Ok, or return the Err
                stack = append(stack, val)
    if length(stack) is not 1:
        return Eval.Err("expected one result, stack has {length(stack)}")
    Eval.Ok(stack[0])

define run(src: text) -> number:
    choose eval(tokenize(src)):
        Ok(v) then 
            print_line("{src}   =>  {v}")
            v
        Err(m) then 
            print_line("{src}   =>  error: {m}")
            0

# ---- Main ------------------------------------------------------------

define main() -> number:
    a = run("3 4 + 5 *")        # ok:  (3 + 4) * 5 = 35
    run("10 0 /")               # err: division by zero
    run("1 +")                  # err: stack underflow
    run("2 3 4 +")              # err: leftover operands
    b = run("40 2 +")           # ok:  42
    # only the two OK runs contribute; the errors returned 0
    a + b - 35
