# stdlib tour — text + num + list + iter working together.
# Build: orion.exe examples/demos/stdlib_tour.or out.ll orbs
#
# Take a CSV-ish line of numbers, clean it up, parse it, and report.
use text
use num
use list
use iter

define main() -> int:
    raw = " 40, 75, 88, 12, 95, 60 "

    # text: normalise, then split into fields.
    fields = split(replace(trim(raw), " ", ""), ",")   # ["40","75",...]

    # num: parse each field to an int (via iter's map + a closure).
    scores = each(fields, fn(s: text): parse(s))         # [40,75,88,12,95,60]

    # list + num: aggregate.
    total  = sum(scores)                                # 370
    top    = max_of(scores)                             # 95
    bottom = min_of(scores)                             # 12
    mean   = avg(scores)                                # 61
    passed = count(scores, fn(n): if n >= 60 then 1 else 0)  # 4 (iter closure)

    print_line("n={len(scores)} total={total} top={top} low={bottom} mean={mean} passed={passed}")
    total                                               # 370 -> exit 114
