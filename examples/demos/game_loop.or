# Orion 2026 game demo - showcases the full language stack in one file.
#
# Features used:
#   * sum types (enum Tile, Action, Outcome)
#   * effects + continuations (Random.roll, Log.msg)
#   * return keyword (early-exit guards)
#   * pattern match (tile-kind dispatch)
#   * string interpolation in print_line
#
# The handlers in this file are the PRODUCTION versions. For tests you'd
# write deterministic handlers (e.g. Random.roll returns fixed sequence)
# and link those instead - the game code is unchanged.

# ---- Sum types -------------------------------------------------------

type Tile: Empty, Wall, Loot, Trap

type Outcome: Ok, Err

# ---- Effects ---------------------------------------------------------

effect Random:
    roll: fn(max: int) -> int

effect Log:
    msg: fn(text: text) -> text

# ---- Handlers (production) ------------------------------------------
# `handle Effect.op(...)` names the handler explicitly; `resume(v)` sends a
# value back to the `perform` site (int or text, inferred from `v`).

handle Random.roll(max: int) -> int:
    # Deterministic for the demo. Production would call OS random.
    resume(73)

handle Log.msg(message: text) -> text:
    print_line(message)
    resume("ok")

# ---- Game logic ------------------------------------------------------

define loot_value() -> int:
    perform Log.msg("rolling loot table")
    roll = perform Random.roll(100)
    if roll > 95:
        500
    else:
        if roll > 80:
            100
        else:
            if roll > 50:
                25
            else:
                0

define process_tile(tile_kind: int) -> int:
    if tile_kind == 0:
        return 0
    if tile_kind == 1:
        perform Log.msg("blocked by wall")
        return 0
    if tile_kind == 2:
        loot_value()
    else:
        if tile_kind == 3:
            perform Log.msg("hit a trap!")
            0 - 50
        else:
            0

define main() -> int:
    perform Log.msg("=== game starts ===")

    a = process_tile(0)   # Empty → 0
    b = process_tile(2)   # Loot → 25 (roll 73 = common)
    c = process_tile(3)   # Trap → -50
    d = process_tile(2)   # Loot → 25

    total = a + b + c + d

    perform Log.msg("=== game ends ===")

    # 0 + 25 + (-50) + 25 = 0. Add 42 as sentinel for success.
    if total == 0:
        42
    else:
        99
