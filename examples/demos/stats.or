# stats - parse a line of numbers and report basic statistics.
# Build: orion.exe examples/demos/stats.or out.ll orbs
#
# Ties the standard library together: text.split + num.parse to read the
# numbers, iter.sum and list.min_of / max_of / avg to summarize. Returns
# the integer mean.
use text
use num
use iter
use list

define main() -> int:
    raw = split("40 75 88 12 95 60", " ")

    # Parse each piece into an int.
    edit xs = []
    loop i in 0..<length(raw):
        xs = append(xs, parse(at(raw, i)))

    n = length(xs)
    total = sum(xs)
    lo = min_of(xs)
    hi = max_of(xs)
    mean = avg(xs)

    print_line("n={n}  sum={total}  min={lo}  max={hi}  mean={mean}  range={hi - lo}")
    mean                                  # (40+75+88+12+95+60)/6 = 370/6 = 61
