# csv_table - parse CSV text and print it as an aligned table.
#
# Build: orion.exe examples/demos/csv_table.or out.ll orbs
#
# A workout for the text standard library: `lines` to split rows, `split` on
# commas for cells, `trim` to clean them, `byte_count` to measure column
# widths, `pad_right` to align, `join` to glue a row back together, and
# `num.parse` to total a numeric column. Data lives in a `[[text]]` grid.


# Parse the raw CSV into a grid of trimmed cells.
define parse_grid(csv: text) -> [[text]]:
    edit grid = []
    loop row in lines(csv):
        edit cells = []
        loop cell in split(row, ","):
            cells = append(cells, trim(cell))
        grid = append(grid, cells)
    grid

# Width of each column = the widest cell in it.
define column_widths(grid: [[text]], ncols: number) -> [number]:
    edit widths = []
    loop ci in 0 until ncols:
        edit w = 0
        loop row in grid:
            cw = byte_count(row[ci])
            if cw > w:
                w = cw
        widths = append(widths, w)
    widths

define main() -> number:
    csv = "fruit, qty, price\napple, 15, 30\nbanana, 20, 10\ncherry, 7, 100"

    grid = parse_grid(csv)
    ncols = length(grid[0])
    widths = column_widths(grid, ncols)

    # Print every row with each cell padded to its column width.
    edit ri = 0
    loop row in grid:
        edit parts = []
        loop ci in 0 until ncols:
            parts = append(parts, pad_right(row[ci], widths[ci], " "))
        print_line(join(parts, " | "))
        # a rule under the header
        if ri is 0:
            edit rule = []
            loop ci in 0 until ncols:
                rule = append(rule, repeat("-", widths[ci]))
            print_line(join(rule, "-+-"))
        ri = ri + 1

    # Total the `qty` column (index 1), skipping the header row.
    edit total = 0
    loop di in 1 until length(grid):
        total = total + parse(grid[di][1])
    print_line("")
    print_line("total qty = {total}")

    # 15 + 20 + 7 = 42
    total
