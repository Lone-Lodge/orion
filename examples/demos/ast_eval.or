# ast_eval — parse arithmetic into a REAL tree, then evaluate the tree.
#
# Build: orion.exe examples/demos/ast_eval.or out.ll orbs
#
# The calculator evaluates while it parses. This one separates the phases like
# a real compiler: parse builds an AST, then a recursive pass walks it. The
# tree is an ARENA — every node lives in one `[Node]` list and refers to its
# children by index. That's the data-oriented shape (Orion's whole ethos) and
# the natural way to model a recursive structure with an `enum` whose payloads
# are plain ints:
#
#   enum Node: Num(int), Neg(int), Add(int,int), Sub(int,int), Mul(int,int), Div(int,int)
#
# Num holds a literal; Neg holds one child index; the binaries hold two child
# indices. `eval(arena, i)` matches on `arena[i]` and recurses into the kids.

type Node: Num(int), Neg(int), Add(int, int), Sub(int, int), Mul(int, int), Div(int, int)

# A parse step returns the growing arena, the index of the node it produced,
# and the next unconsumed token. Value semantics mean the arena is threaded
# through by return value rather than mutated in place.
type PR: arena: [Node], idx: int, next: int

define tok(kind: text, val: int) -> table:
    {"kind": kind, "val": val}

define is_digit(b: int) -> int:
    if b >= '0' and b <= '9' then 1 else 0

# ---- Tokenizer -------------------------------------------------------

define tokenize(src: text) -> [table]:
    bs = bytes_from_text(src)
    n = len(bs)
    edit toks = []
    edit i = 0
    loop:
        if i >= n:
            break
        b = at(bs, i)
        if b == ' ':
            i = i + 1
        else:
            if is_digit(b) == 1:
                edit num = 0
                loop:
                    if i >= n:
                        break
                    d = at(bs, i)
                    if is_digit(d) == 0:
                        break
                    num = num * 10 + (d - '0')
                    i = i + 1
                toks = append(toks, tok("num", num))
            else:
                kind = choose b:
                    '+' -> "plus"
                    '-' -> "minus"
                    '*' -> "star"
                    '/' -> "slash"
                    '(' -> "lparen"
                    ')' -> "rparen"
                    _ -> "bad"
                toks = append(toks, tok(kind, 0))
                i = i + 1
    toks

# ---- Parser: tokens -> arena of Nodes, returning the root index ------

# push a node, return its index (its position in the arena after the push)
define add_node(arena: [Node], node: Node) -> PR:
    grown = append(arena, node)
    PR{arena: grown, idx: len(grown) - 1, next: 0}

define parse_factor(toks: [table], pos: int, arena: [Node]) -> PR:
    t = at(toks, pos)
    choose get(t, "kind"):
        "lparen" ->
            inner = parse_expr(toks, pos + 1, arena)
            PR{arena: inner.arena, idx: inner.idx, next: inner.next + 1}   # skip ')'
        "minus" ->
            child = parse_factor(toks, pos + 1, arena)
            made = add_node(child.arena, Node.Neg(child.idx))
            PR{arena: made.arena, idx: made.idx, next: child.next}
        _ ->
            made = add_node(arena, Node.Num(get(t, "val")))
            PR{arena: made.arena, idx: made.idx, next: pos + 1}

define parse_term(toks: [table], pos: int, arena: [Node]) -> PR:
    left = parse_factor(toks, pos, arena)
    edit a = left.arena
    edit node_i = left.idx
    edit i = left.next
    loop:
        if i >= len(toks):
            break
        k = get(at(toks, i), "kind")
        if k != "star" and k != "slash":
            break
        right = parse_factor(toks, i + 1, a)
        combined = if k == "star" then Node.Mul(node_i, right.idx) else Node.Div(node_i, right.idx)
        made = add_node(right.arena, combined)
        a = made.arena
        node_i = made.idx
        i = right.next
    PR{arena: a, idx: node_i, next: i}

define parse_expr(toks: [table], pos: int, arena: [Node]) -> PR:
    left = parse_term(toks, pos, arena)
    edit a = left.arena
    edit node_i = left.idx
    edit i = left.next
    loop:
        if i >= len(toks):
            break
        k = get(at(toks, i), "kind")
        if k != "plus" and k != "minus":
            break
        right = parse_term(toks, i + 1, a)
        combined = if k == "plus" then Node.Add(node_i, right.idx) else Node.Sub(node_i, right.idx)
        made = add_node(right.arena, combined)
        a = made.arena
        node_i = made.idx
        i = right.next
    PR{arena: a, idx: node_i, next: i}

# ---- Evaluator: walk the arena by index ------------------------------

define eval(arena: [Node], idx: int) -> int:
    choose at(arena, idx):
        Num(v) -> v
        Neg(c) -> 0 - eval(arena, c)
        Add(l, r) -> eval(arena, l) + eval(arena, r)
        Sub(l, r) -> eval(arena, l) - eval(arena, r)
        Mul(l, r) -> eval(arena, l) * eval(arena, r)
        Div(l, r) ->
            d = eval(arena, r)
            if d == 0 then 0 else eval(arena, l) // d

define run(src: text) -> int:
    parsed = parse_expr(tokenize(src), 0, [])
    v = eval(parsed.arena, parsed.idx)
    print_line("{src}   =  {v}   ({len(parsed.arena)} nodes)")
    v

# ---- Main ------------------------------------------------------------

define main() -> int:
    a = run("2 * (3 + 4)")      # 14
    b = run("100 / (2 + 3)")    # 20
    c = run("-5 + 13")          # 8
    # 14 + 20 + 8 = 42
    a + b + c
