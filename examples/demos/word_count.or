# word_count - count how often each word appears.
# Build: orion.exe examples/demos/word_count.or out.ll orbs
#
# Ties the standard library together: text.split to tokenize, a growing
# map to tally, get_or for the running count, and full-expression string
# interpolation (`{counts["the"]}`) to report. Returns the count of "the".
use text

define main() -> int:
    words = split("the cat sat on the mat and the cat ran", " ")

    edit counts = {}
    loop i in 0..<len(words):
        w = at(words, i)
        counts[w] = get_or(counts, w, 0) + 1

    print_line("the={counts["the"]}  cat={counts["cat"]}  mat={counts["mat"]}")
    counts["the"]                       # "the" appears 3 times
