# calculator - a real arithmetic evaluator: tokenize -> parse -> evaluate.
#
# Build: orion.exe examples/demos/calculator.or out.ll orbs
#
# A capstone that ties the language together:
#   - a hand-written tokenizer over the raw bytes of the input
#   - a recursive-descent parser/evaluator with correct precedence
#     (`+ -` bind looser than `* /`), parentheses, and unary minus
#   - mutual recursion (expr -> term -> factor -> expr)
#   - `choose` to dispatch on the operator, `data` structs to thread state
#   - graceful divide-by-zero handling (the program CHOOSES to report it
#     instead of trapping)
#
# Grammar:
#   expr   := term  (('+' | '-') term)*
#   term   := factor (('*' | '/') factor)*
#   factor := number | '(' expr ')' | '-' factor
#
# main evaluates a handful of expressions and returns the last result.

use text

# A token is a map {"kind": text, "val": int}. `val` is only meaningful
# for numbers; operators carry 0.
define tok(kind: text, val: number) -> table:
    {"kind": kind, "val": val}

# The result of parsing a sub-expression: its value and the index of the
# next unconsumed token. Threading `next` is how recursive descent walks
# the token list without a mutable cursor shared across functions.
type Parsed: val: number, next: number

define is_digit(b: number) -> number:
    if b >= '0' and b <= '9' then 1 else 0

# ---- Tokenizer -------------------------------------------------------

define tokenize(src: text) -> [table]:
    bs = bytes_of(src)
    n = length(bs)
    edit toks = []
    edit i = 0
    loop:
        if i >= n:
            break
        b = bs[i]
        if b is ' ':                        # space - skip
            i = i + 1
        else:
            if is_digit(b) is 1:            # a run of digits -> one number
                edit num = 0
                loop:
                    if i >= n:
                        break
                    d = bs[i]
                    if is_digit(d) is 0:
                        break
                    num = num * 10 + (d - '0')
                    i = i + 1
                toks = append(toks, tok("num", num))
            else:
                kind = choose b:
                    '+' then "plus"
                    '-' then "minus"
                    '*' then "star"
                    '/' then "slash"
                    '(' then "lparen"
                    ')' then "rparen"
                    _ then "bad"
                toks = append(toks, tok(kind, 0))
                i = i + 1
    toks

# ---- Recursive-descent parser + evaluator ----------------------------

define parse_factor(toks: [table], pos: number) -> Parsed:
    t = toks[pos]
    k = get(t, "kind")
    if k is "lparen":
        inner = parse_expr(toks, pos + 1)
        # inner.next points at the ')' - step over it
        Parsed{val: inner.val, next: inner.next + 1}
    else:
        if k is "minus":                    # unary minus: -factor
            f = parse_factor(toks, pos + 1)
            Parsed{val: 0 - f.val, next: f.next}
        else:                               # a number
            Parsed{val: get(t, "val"), next: pos + 1}

define parse_term(toks: [table], pos: number) -> Parsed:
    left = parse_factor(toks, pos)
    edit val = left.val
    edit i = left.next
    loop:
        if i >= length(toks):
            break
        k = get(toks[i], "kind")
        if k is not "star" and k is not "slash":
            break
        r = parse_factor(toks, i + 1)
        if k is "star":
            val = val * r.val
        else:
            if r.val is 0:                  # handle it, don't trap
                print_line("  (calculator: divide by zero - using 0)")
                val = 0
            else:
                val = val // r.val
        i = r.next
    Parsed{val: val, next: i}

define parse_expr(toks: [table], pos: number) -> Parsed:
    left = parse_term(toks, pos)
    edit val = left.val
    edit i = left.next
    loop:
        if i >= length(toks):
            break
        k = get(toks[i], "kind")
        if k is not "plus" and k is not "minus":
            break
        r = parse_term(toks, i + 1)
        val = if k is "plus" then val + r.val else val - r.val
        i = r.next
    Parsed{val: val, next: i}

define eval(src: text) -> number:
    toks = tokenize(src)
    result = parse_expr(toks, 0)
    result.val

# ---- Main ------------------------------------------------------------

define main() -> number:
    a = eval("3 + 4 * 2")               # precedence:      = 11
    b = eval("(3 + 4) * 2")             # parens:          = 14
    c = eval("2 * (3 + 4) - 10 / 2")    # mixed:           = 9
    d = eval("-5 + 8")                  # unary minus:     = 3
    e = eval("100 / (2 - 2)")           # divide by zero:  = 0 (handled)

    print_line("3 + 4 * 2            = {a}")
    print_line("(3 + 4) * 2          = {b}")
    print_line("2 * (3 + 4) - 10 / 2 = {c}")
    print_line("-5 + 8               = {d}")
    print_line("100 / (2 - 2)        = {e}")

    # 11 + 14 + 9 + 3 + 0 = 37, +5 = 42
    a + b + c + d + e + 5
