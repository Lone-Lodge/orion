# interpreter — arithmetic WITH variables. Extends the calculator with an
# environment: assign with `x = 3`, then use the name in later expressions.
#
# Build: orion.exe examples/demos/interpreter.or out.ll orbs
#
# On top of the calculator's tokenize -> parse -> evaluate, this adds:
#   - identifiers in the tokenizer (a run of letters)
#   - a variable environment (a name -> int map, threaded through eval)
#   - statements: `name = expr` stores; a bare `expr` is reported
#   - char literals (`'a'`, `'0'`, `'+'`) keep the byte tests readable
#
# Grammar (per statement):
#   stmt   := ident '=' expr | expr
#   expr   := term  (('+' | '-') term)*
#   term   := factor (('*' | '/') factor)*
#   factor := number | ident | '(' expr ')' | '-' factor

use text

fn tok_num(v: int) -> Map:
    {"kind": "num", "val": v, "name": ""}

fn tok_op(k: Text) -> Map:
    {"kind": k, "val": 0, "name": ""}

fn tok_ident(nm: Text) -> Map:
    {"kind": "ident", "val": 0, "name": nm}

data Parsed: val: int, next: int

fn is_digit(b: int) -> int:
    if b >= '0' and b <= '9' then 1 else 0

fn is_alpha(b: int) -> int:
    if (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') then 1 else 0

# ---- Tokenizer -------------------------------------------------------

fn tokenize(src: Text) -> [Map]:
    bs = bytes_from_text(src)
    n = len(bs)
    mut toks = []
    mut i = 0
    loop:
        if i >= n:
            break
        b = at(bs, i)
        if b == ' ':
            i = i + 1
        else:
            if is_digit(b) == 1:                # a run of digits -> number
                mut num = 0
                loop:
                    if i >= n:
                        break
                    d = at(bs, i)
                    if is_digit(d) == 0:
                        break
                    num = num * 10 + (d - '0')
                    i = i + 1
                toks = push(toks, tok_num(num))
            else:
                if is_alpha(b) == 1:            # a run of letters -> identifier
                    mut chars = []
                    loop:
                        if i >= n:
                            break
                        c = at(bs, i)
                        if is_alpha(c) == 0:
                            break
                        chars = push(chars, c)
                        i = i + 1
                    toks = push(toks, tok_ident(bytes_to_text(chars)))
                else:
                    kind = match b:
                        '+' -> "plus"
                        '-' -> "minus"
                        '*' -> "star"
                        '/' -> "slash"
                        '(' -> "lparen"
                        ')' -> "rparen"
                        '=' -> "assign"
                        _ -> "bad"
                    toks = push(toks, tok_op(kind))
                    i = i + 1
    toks

# ---- Recursive-descent evaluator (env threaded through) --------------

fn parse_factor(toks: [Map], pos: int, env: Map) -> Parsed:
    t = at(toks, pos)
    # A flat 4-way dispatch — block arms let the `(` and unary-minus cases
    # bind an intermediate before returning, so this reads as one `match`
    # instead of a nested if/else ladder.
    match get(t, "kind"):
        "lparen" ->
            inner = parse_expr(toks, pos + 1, env)
            Parsed{val: inner.val, next: inner.next + 1}
        "minus" ->                              # unary minus
            f = parse_factor(toks, pos + 1, env)
            Parsed{val: 0 - f.val, next: f.next}
        "ident" -> Parsed{val: get_or(env, get(t, "name"), 0), next: pos + 1}
        _ -> Parsed{val: get(t, "val"), next: pos + 1}

fn parse_term(toks: [Map], pos: int, env: Map) -> Parsed:
    left = parse_factor(toks, pos, env)
    mut val = left.val
    mut i = left.next
    loop:
        if i >= len(toks):
            break
        k = get(at(toks, i), "kind")
        if k != "star" and k != "slash":
            break
        r = parse_factor(toks, i + 1, env)
        if k == "star":
            val = val * r.val
        else:
            if r.val == 0:
                print_line("  (interpreter: divide by zero — using 0)")
                val = 0
            else:
                val = val / r.val
        i = r.next
    Parsed{val: val, next: i}

fn parse_expr(toks: [Map], pos: int, env: Map) -> Parsed:
    left = parse_term(toks, pos, env)
    mut val = left.val
    mut i = left.next
    loop:
        if i >= len(toks):
            break
        k = get(at(toks, i), "kind")
        if k != "plus" and k != "minus":
            break
        r = parse_term(toks, i + 1, env)
        val = if k == "plus" then val + r.val else val - r.val
        i = r.next
    Parsed{val: val, next: i}

# ---- Main — run a little program, carrying the environment forward ---

fn is_assign(toks: [Map]) -> int:
    if len(toks) >= 2 and get(at(toks, 0), "kind") == "ident" and get(at(toks, 1), "kind") == "assign" then 1 else 0

fn main() -> int:
    program = ["x = 3", "y = x * 2 + 1", "z = (x + y) * 2", "z - x"]

    mut env = {}
    mut result = 0
    for stmt in program:
        toks = tokenize(stmt)
        if is_assign(toks) == 1:
            name = get(at(toks, 0), "name")
            r = parse_expr(toks, 2, env)        # expr after the `=`
            env[name] = r.val
            print_line("{stmt}   ->  {name} = {r.val}")
        else:
            r = parse_expr(toks, 0, env)
            result = r.val
            print_line("{stmt}   ->  {result}")

    # x=3, y=7, z=20, (z - x)=17
    result
