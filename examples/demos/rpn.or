# rpn - a reverse-Polish (postfix) calculator, modelled with a real sum type.
#
# Build: orion.exe examples/demos/rpn.or out.ll orbs
#
# Where the recursive-descent calculator threads precedence, RPN is a plain
# left-to-right stack machine - so it shows off a different set of features:
#   - an `enum` (sum type): a token is EITHER a number OR an operator
#   - `match` with variant destructuring (`Num(v)`, `Op(o)`) to pull the payload
#   - a block arm (the `Op` case pops two, applies, pushes) next to an inline arm
#   - a list used as a stack (push / peek / drop-last via slice)
#
# "3 4 + 5 *"  parses as  (3 + 4) * 5 = 35.

use text

type Token: Num(int), Op(text)

define is_digit(b: int) -> int:
    if b >= '0' and b <= '9' then 1 else 0

# ---- Tokenizer: bytes -> [Token] -------------------------------------

define tokenize(src: text) -> [Token]:
    bs = bytes_of(src)
    n = length(bs)
    edit toks = []
    edit i = 0
    loop:
        if i >= n:
            break
        b = at(bs, i)
        if b == ' ':
            i = i + 1
        else:
            if is_digit(b) == 1:                # a run of digits -> Num
                edit num = 0
                loop:
                    if i >= n:
                        break
                    d = at(bs, i)
                    if is_digit(d) == 0:
                        break
                    num = num * 10 + (d - '0')
                    i = i + 1
                toks = append(toks, Token.Num(num))
            else:                               # a single char -> Op
                toks = append(toks, Token.Op(text_of(append([], b))))
                i = i + 1
    toks

define apply(op: text, a: int, b: int) -> int:
    choose op:
        "+" -> a + b
        "-" -> a - b
        "*" -> a * b
        _ ->
            if b == 0:
                print_line("  (rpn: divide by zero - using 0)")
                0
            else:
                a // b

# ---- Evaluator: a left-to-right stack machine ------------------------

define eval(toks: [Token]) -> int:
    edit stack = []
    loop t in toks:
        choose t:
            Num(v) -> stack = append(stack, v)    # inline arm
            Op(o) ->                            # block arm: pop 2, apply, push
                top = length(stack)
                b = at(stack, top - 1)
                a = at(stack, top - 2)
                stack = part(stack, 0, top - 2)
                stack = append(stack, apply(o, a, b))
    at(stack, length(stack) - 1)

define run(src: text) -> int:
    r = eval(tokenize(src))
    print_line("{src}   =  {r}")
    r

# ---- Main ------------------------------------------------------------

define main() -> int:
    a = run("3 4 + 5 *")        # (3 + 4) * 5   = 35
    b = run("9 2 -")            # 9 - 2         = 7
    c = run("2 3 4 * +")        # 2 + (3 * 4)   = 14
    # 35 + 7 = 42  (c is just to exercise a deeper stack)
    a + b + c - c
