use orion_emit_wasm
use orion_web_shell
use io
use fs

# Build a wasm module that imports a JS-side `fill_rect(x, y, w, h, c)`
# and an exported `draw()` that calls it five times to paint a row of
# coloured squares onto a <canvas>. Engine-in-the-browser, pure Orion.

fn main() -> int:
    print_line("orion web demo — canvas drawing via wasm import")
    mkdir_all("dist")

    # Imports: env.fill_rect(x, y, w, h, colour) → void
    module = new_module()
    m1 = add_import(module, new_import("env", "fill_rect", 5, 0))

    # The draw() function: arity 0, returns 0 (void → i32 keeps the
    # encoder happy until void exports land). Calls fill_rect 5 times
    # with column index in {0,1,2,3,4}, each 60px wide, varying colour.
    f_draw = new_fn("draw", 0)
    f1 = emit_call_rect(f_draw, 0, 0)
    f2 = emit_call_rect(f1, 60, 1)
    f3 = emit_call_rect(f2, 120, 2)
    f4 = emit_call_rect(f3, 180, 3)
    f5 = emit_call_rect(f4, 240, 4)
    # End body with a placeholder return value (the engine still
    # expects an i32). Drop result of last call isn't needed since
    # fill_rect returns void.
    f6 = emit_const(f5, 0)
    f7 = emit_end(f6)

    m2 = add_fn(m1, f7)

    wasm_bytes = encode_module(m2)
    write_wasm("dist/demo.wasm", wasm_bytes)
    print_line("wrote dist/demo.wasm (1 import, 1 export)")

    write_canvas_shell("dist", "Orion → wasm → canvas", "demo.wasm")
    print_line("wrote dist/index.html + dist/main.js")
    print_line("open dist/index.html in a browser")
    0

# Helper: push args + call import 0 (fill_rect).
fn emit_call_rect(fn_value: WFn, x: int, colour_idx: int):
    a = emit_const(fn_value, x)        # x
    b = emit_const(a, 50)              # y
    c = emit_const(b, 50)              # w
    d = emit_const(c, 50)              # h
    e = emit_const(d, colour_idx)      # colour
    emit_call(e, 0)                    # fill_rect is import 0

# Override the shell to give us a canvas + a fill_rect impl.
fn write_canvas_shell(dir: Text, title: Text, wasm_path: Text):
    html = canvas_html(title, wasm_path)
    js = canvas_js(wasm_path)
    write_file(dir + "/index.html", html)
    write_file(dir + "/main.js", js)

fn canvas_html(title: Text, wasm_path: Text) -> Text:
    "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h1>" + title + "</h1><canvas id=\"c\" width=\"300\" height=\"120\" style=\"border:1px solid #ccc\"></canvas><script src=\"main.js\"></script></body></html>\n"

fn canvas_js(wasm_path: Text) -> Text:
    "const canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nconst palette = ['#ef4444','#f97316','#eab308','#22c55e','#3b82f6','#a855f7'];\n\nasync function boot() \{\n  try \{\n    const response = await fetch('" + wasm_path + "');\n    const env = \{\n      fill_rect: (x, y, w, h, colour) => \{\n        ctx.fillStyle = palette[colour % palette.length];\n        ctx.fillRect(x, y, w, h);\n      \}\n    \};\n    const \{ instance \} = await WebAssembly.instantiateStreaming(response, \{ env \});\n    instance.exports.draw();\n  \} catch (e) \{\n    document.body.append(document.createTextNode('boot error: ' + e));\n  \}\n\}\nboot();\n"
