use orion_emit_wasm
use io
use fs

# Atlas Session in the browser. Four entities, each with a Motion
# component (anchor + velocity + speed). `render(tick)` is called by
# requestAnimationFrame; the wasm computes each entity's position from
# its kinematic leg (atlas_motion-style: pos = anchor + vel * tick) and
# emits fill_rect calls to paint them.
#
# Pure Orion logic, deterministic integer math, no floats — exactly
# Atlas's wire-determinism contract from atlas_wire's rule.

# Host imports — same as veil_canvas but pared down to fill_rect only
# since the particles don't need text.
fn idx_set_fill() -> int = comptime 0
fn idx_fill_rect() -> int = comptime 1

fn main() -> int:
    print_line("atlas browser demo — ECS in wasm")
    mkdir_all("dist")

    module = new_module()
    m1 = add_import(module, new_import("env", "set_fill", 3, 0))
    m2 = add_import(m1, new_import("env", "fill_rect", 4, 0))

    render_fn = build_render_fn()
    m3 = add_fn(m2, render_fn)

    wasm_bytes = encode_module(m3)
    write_wasm("dist/atlas.wasm", wasm_bytes)
    print_line("wrote dist/atlas.wasm")

    write_file("dist/index.html", html_shell())
    write_file("dist/main.js", animation_runtime())
    print_line("wrote dist/index.html + dist/main.js")
    print_line("open dist/index.html for a live atlas world")
    0

# render(tick: int) -> int. Paints a slate background and four
# entities, each at its motion-derived position.
fn build_render_fn() -> WFn:
    f0 = new_fn("render", 1)
    # Background — slate-900 fillrect across the whole canvas.
    f1 = emit_call_3(f0, idx_set_fill(), 15, 23, 42)
    f2 = emit_call_4(f1, idx_fill_rect(), 0, 0, 480, 320)
    # Four entities, each painted at its motion position.
    f3 = paint_entity(f2, 255, 99, 132, 0, 60, 2, 0)        # x=2t,    fixed y=60
    f4 = paint_entity(f3, 99, 255, 132, 50, 120, 3, 0)      # x=50+3t, fixed y=120
    f5 = paint_entity(f4, 99, 132, 255, 100, 180, 1, 0)     # x=100+t, fixed y=180
    f6 = paint_entity(f5, 255, 200, 99, 150, 240, 4, 0)     # x=150+4t, fixed y=240
    f7 = emit_const(f6, 0)
    emit_end(f7)

# Paint one entity. Computes position = anchor + velocity * tick (mod
# canvas-width) and emits a 32×32 rect filled with the entity's RGB.
# `tick` lives in local 0 — the param the JS shell hands in.
fn paint_entity(fn_value: WFn, r: int, g: int, b: int, anchor_x: int, anchor_y: int, vx: int, _vy: int) -> WFn:
    # set_fill(r, g, b)
    f1 = emit_call_3(fn_value, idx_set_fill(), r, g, b)
    # Compute x: tick * vx + anchor_x, then mod 480 by subtracting
    # (x / 480) * 480. fill_rect args go on the stack in order.
    f2 = emit_local_get(f1, 0)              # tick
    f3 = emit_const(f2, vx)                 # vx
    f4 = emit_op(f3, op_i32_mul())          # tick * vx
    f5 = emit_const(f4, anchor_x)           # anchor_x
    f6 = emit_op(f5, op_i32_add())          # tick * vx + anchor_x
    # Apply (x mod 480) — duplicate-and-subtract trick: leave x on stack,
    # then push x / 480 * 480, subtract. We don't have local.tee, so
    # we recompute x once for the divisor.
    f7 = emit_local_get(f6, 0)
    f8 = emit_const(f7, vx)
    f9 = emit_op(f8, op_i32_mul())
    f10 = emit_const(f9, anchor_x)
    f11 = emit_op(f10, op_i32_add())
    f12 = emit_const(f11, 480)
    f13 = emit_op(f12, op_i32_div_s())
    f14 = emit_const(f13, 480)
    f15 = emit_op(f14, op_i32_mul())
    f16 = emit_op(f15, op_i32_sub())
    # y, w, h are constants.
    f17 = emit_const(f16, anchor_y)
    f18 = emit_const(f17, 32)
    f19 = emit_const(f18, 32)
    # call fill_rect — pops x, y, w, h.
    emit_call(f19, idx_fill_rect())

fn emit_call_3(fn_value: WFn, host_index: int, a: int, b: int, c: int) -> WFn:
    f1 = emit_const(fn_value, a)
    f2 = emit_const(f1, b)
    f3 = emit_const(f2, c)
    emit_call(f3, host_index)

fn emit_call_4(fn_value: WFn, host_index: int, a: int, b: int, c: int, d: int) -> WFn:
    f1 = emit_const(fn_value, a)
    f2 = emit_const(f1, b)
    f3 = emit_const(f2, c)
    f4 = emit_const(f3, d)
    emit_call(f4, host_index)

fn html_shell() -> Text:
    "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Atlas — pure Orion ECS</title>\n<style>body\{font-family:system-ui;background:#020617;color:#f1f5f9;padding:20px\}canvas\{display:block;border-radius:6px;box-shadow:0 8px 30px rgba(0,0,0,0.6)\}h1\{font-weight:600;margin-bottom:16px\}small\{color:#94a3b8;display:block;margin-top:12px\}</style></head>\n<body><h1>Atlas world — pure Orion wasm, integer-deterministic motion</h1>\n<canvas id=\"c\" width=\"480\" height=\"320\"></canvas>\n<small>Four entities, each driven by atlas_motion-style anchor + velocity. requestAnimationFrame ticks; wasm computes positions; canvas paints. No npm, no wgpu, no Rust.</small>\n<script src=\"main.js\"></script></body></html>\n"

fn animation_runtime() -> Text:
    "const canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nlet currentFill = '#000';\nconst env = \{\n  set_fill: (r,g,b) => \{ currentFill = `rgb($\{r\},$\{g\},$\{b\})`; ctx.fillStyle = currentFill; \},\n  fill_rect: (x,y,w,h) => \{ ctx.fillStyle = currentFill; ctx.fillRect(x,y,w,h); \}\n\};\n\nasync function boot() \{\n  try \{\n    const \{ instance \} = await WebAssembly.instantiateStreaming(fetch('atlas.wasm'), \{ env \});\n    const render = instance.exports.render;\n    let tick = 0;\n    function frame() \{\n      render(tick);\n      tick += 1;\n      requestAnimationFrame(frame);\n    \}\n    requestAnimationFrame(frame);\n  \} catch (e) \{\n    document.body.append(document.createTextNode('boot error: ' + e));\n  \}\n\}\nboot();\n"
