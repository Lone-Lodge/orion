# orion_build_wasm — one-call deploy: `build(name, module, runtime_js)`.
#
# Every web project ends with the same three steps:
#   1. encode_module → bytes
#   2. write to dist/<name>.wasm
#   3. write a matching index.html + main.js
# This orb folds them into one fn so a project's build script reads
# like:
#
#   use orion_build_wasm
#   ...
#   build("my_app", my_module, my_js_runtime)
#
# That's the closest Orion has to `cargo build --target wasm32` —
# but it's pure Orion, no subprocess, no cargo, no wasm-pack.

use orion_emit_wasm
use io
use fs

# Build the deliverable for a wasm web module. `name` is used for
# the .wasm filename and the <title>; `runtime_js` is the JS host
# that imports + drives the module (callers usually template it
# from a base + their own env bindings).
pub fn build(name: Text, module: WModule, runtime_js: Text):
    mkdir_all("dist")
    wasm_bytes = encode_module(module)
    wasm_path = "dist/" + name + ".wasm"
    write_wasm(wasm_path, wasm_bytes)
    print_line("wrote " + wasm_path)

    write_file("dist/index.html", default_html(name, name + ".wasm"))
    write_file("dist/main.js", runtime_js)
    print_line("wrote dist/index.html + dist/main.js")
    print_line("open dist/index.html in a browser")

# Tiny default HTML shell — `runtime_js` does the actual binding.
pub fn default_html(title: Text, wasm_filename: Text) -> Text:
    "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title>\n<style>body\{font-family:system-ui;background:#020617;color:#f1f5f9;padding:24px;margin:0\}canvas\{display:block;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.6);margin-bottom:16px\}h1\{font-weight:600;margin:0 0 6px}p\{margin:0 0 18px;color:#94a3b8}</style></head>\n<body><h1>" + title + "</h1><p>pure Orion → " + wasm_filename + "</p>\n<canvas id=\"c\" width=\"480\" height=\"320\"></canvas>\n<script src=\"main.js\"></script></body></html>\n"

# Default canvas runtime — host imports map directly to canvas2d
# ops, strings are read from linear memory (utf-8). Most apps can
# use this as-is; specialised demos extend it.
pub fn default_runtime(wasm_filename: Text) -> Text:
    "const canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nlet currentFill = '#000';\nlet currentStroke = '#000';\nlet memory;\nfunction readUtf8(p, l) \{ return new TextDecoder().decode(new Uint8Array(memory.buffer, p, l)); \}\nconst env = \{\n  set_fill: (r,g,b) => \{ currentFill = `rgb($\{r\},$\{g\},$\{b\})`; ctx.fillStyle = currentFill; \},\n  fill_rect: (x,y,w,h) => \{ ctx.fillStyle = currentFill; ctx.fillRect(x,y,w,h); \},\n  set_stroke: (r,g,b) => \{ currentStroke = `rgb($\{r\},$\{g\},$\{b\})`; ctx.strokeStyle = currentStroke; \},\n  stroke_rect: (x,y,w,h) => \{ ctx.strokeStyle = currentStroke; ctx.strokeRect(x,y,w,h); \},\n  draw_text: (x,y,p,l) => \{ ctx.fillStyle = currentFill; ctx.font = '16px system-ui'; ctx.fillText(readUtf8(p,l), x, y); \}\n\};\nasync function boot() \{\n  const \{ instance \} = await WebAssembly.instantiateStreaming(fetch('" + wasm_filename + "'), \{ env \});\n  memory = instance.exports.memory;\n  if (instance.exports.render) instance.exports.render();\n  if (instance.exports.render_frame) \{ let t=0; (function loop()\{ instance.exports.render_frame(t++); requestAnimationFrame(loop); \})(); \}\n\}\nboot();\n"
