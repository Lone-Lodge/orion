# orion_veil_to_wasm — Veil DrawCmd list → wasm render() fn.
#
# The bridge that closes the loop: take a list of draw primitives
# (the kind veil_resolver produces), emit wasm that calls the JS
# host fns in order. Each command becomes a sequence of `i32.const`
# + `call <host>` instructions.
#
# Strings come in pre-interned: the caller hands a list of (text, ptr)
# tuples (declared at module level), and a DrawText cmd just emits
# the ptr — wasm passes (ptr, len) to JS, JS reads the bytes out of
# linear memory.

use orion_emit_wasm

# A draw primitive — mirrors veil_display::DrawCmd in shape but with
# the inline strings already lowered to (ptr, len) byte refs.
pub enum WCmd:
    Background(int, int, int)              # r, g, b
    FillRect(int, int, int, int, int)      # r,g,b → set_fill; x,y,w,h
    StrokeRect(int, int, int, int, int)    # r,g,b → set_stroke; x,y,w,h
    DrawText(int, int, int, int)           # x, y, str_ptr, str_len

# Host import indices — fixed contract: callers wire these into the
# `env` module in the same order, so each WCmd knows which import to
# call without runtime tags.
pub fn import_set_fill() -> int = comptime 0
pub fn import_fill_rect() -> int = comptime 1
pub fn import_set_stroke() -> int = comptime 2
pub fn import_stroke_rect() -> int = comptime 3
pub fn import_draw_text() -> int = comptime 4

# Build the standard host-import set every Veil scene module needs.
# Call this once when building the module, then `compile_render` to
# turn a WCmd list into the exported render() fn.
pub fn add_veil_imports(module: WModule) -> WModule:
    m1 = add_import(module, new_import("env", "set_fill", 3, 0))
    m2 = add_import(m1, new_import("env", "fill_rect", 4, 0))
    m3 = add_import(m2, new_import("env", "set_stroke", 3, 0))
    m4 = add_import(m3, new_import("env", "stroke_rect", 4, 0))
    add_import(m4, new_import("env", "draw_text", 4, 0))

# Compile a list of WCmd values into a `render()` WFn that, when
# called, executes the whole scene as host calls in order.
pub fn compile_render(cmds: [WCmd]) -> WFn:
    f0 = new_fn("render", 0)
    mut f = f0
    for cmd in cmds:
        f = emit_cmd(f, cmd)
    # render() returns i32 — push 0 + end.
    f1 = emit_const(f, 0)
    emit_end(f1)

fn emit_cmd(fn_value: WFn, cmd: WCmd) -> WFn:
    match cmd:
        Background(r, g, b) -> emit_bg(fn_value, r, g, b)
        FillRect(r, g, b, _, _) -> emit_fill_rect_cmd(fn_value, cmd)
        StrokeRect(r, g, b, _, _) -> emit_stroke_rect_cmd(fn_value, cmd)
        DrawText(_, _, _, _) -> emit_draw_text_cmd(fn_value, cmd)

fn emit_bg(fn_value: WFn, r: int, g: int, b: int) -> WFn:
    f1 = emit_const(fn_value, r)
    f2 = emit_const(f1, g)
    f3 = emit_const(f2, b)
    f4 = emit_call(f3, import_set_fill())
    # Hard-coded canvas rect 480×320 (matches the standard demo size).
    f5 = emit_const(f4, 0)
    f6 = emit_const(f5, 0)
    f7 = emit_const(f6, 480)
    f8 = emit_const(f7, 320)
    emit_call(f8, import_fill_rect())

fn emit_fill_rect_cmd(fn_value: WFn, cmd: WCmd) -> WFn:
    match cmd:
        FillRect(r, g, b, x, y) -> emit_styled_rect(fn_value, r, g, b, x, y, import_set_fill(), import_fill_rect())
        _ -> fn_value

fn emit_stroke_rect_cmd(fn_value: WFn, cmd: WCmd) -> WFn:
    match cmd:
        StrokeRect(r, g, b, x, y) -> emit_styled_rect(fn_value, r, g, b, x, y, import_set_stroke(), import_stroke_rect())
        _ -> fn_value

# Width and height are fixed for the MVP — extending WCmd to carry
# them lands once the resolver outputs full layout info. For the demo
# we use 440×80 to fit canvas cards comfortably.
fn emit_styled_rect(fn_value: WFn, r: int, g: int, b: int, x: int, y: int, set_import: int, rect_import: int) -> WFn:
    f1 = emit_const(fn_value, r)
    f2 = emit_const(f1, g)
    f3 = emit_const(f2, b)
    f4 = emit_call(f3, set_import)
    f5 = emit_const(f4, x)
    f6 = emit_const(f5, y)
    f7 = emit_const(f6, 440)
    f8 = emit_const(f7, 80)
    emit_call(f8, rect_import)

fn emit_draw_text_cmd(fn_value: WFn, cmd: WCmd) -> WFn:
    match cmd:
        DrawText(x, y, str_ptr, str_len) -> emit_text(fn_value, x, y, str_ptr, str_len)
        _ -> fn_value

fn emit_text(fn_value: WFn, x: int, y: int, str_ptr: int, str_len: int) -> WFn:
    f1 = emit_const(fn_value, x)
    f2 = emit_const(f1, y)
    f3 = emit_const(f2, str_ptr)
    f4 = emit_const(f3, str_len)
    emit_call(f4, import_draw_text())
