use orion_lex
use orion_parse
use io
use fs

fn main() -> int:
    files = ["E:/lone-lodge/orion-self/orbs/orion_compile/lib.or", "E:/lone-lodge/orion-self/orbs/orion_self/lib.or", "E:/lone-lodge/orion-self/orbs/orion_build_wasm/lib.or", "E:/lone-lodge/orion-self/orbs/orion_web_shell/lib.or", "E:/lone-lodge/orion-self/orbs/orion_to_wasm/lib.or", "E:/lone-lodge/orion-self/orbs/orion_typeck/lib.or", "E:/lone-lodge/orion-self/orbs/orion_eval/lib.or"]
    for path in files:
        print_line(path)
        source = read_file(path)
        tokens = self_lex(source)
        ast = self_parse(tokens)
        decls = get(ast, "decls")
        mut count = 0
        for _decl in decls:
            count = count + 1
        print_line("  decls parsed: ok")
    0
