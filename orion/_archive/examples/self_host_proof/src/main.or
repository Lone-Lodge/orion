use orion_lex
use orion_emit_wasm
use orion_to_wasm
use orion_build_wasm
use io
use fs

# Self-host proof: take Orion source as a Text, run it through
# orion_lex, then map each declaration to a WFn via orion_to_wasm's
# IR (manually for now since parse coverage is still partial), and
# ship the resulting wasm.
#
# This is the smallest end-to-end self-compile proof: pure-Orion
# input → pure-Orion-compiled toolchain → wasm output → runs in JS.

fn main() -> int:
    print_line("self-host proof — orion compiles a tiny fn to wasm")

    # The "user program" we're compiling. In a real driver this would
    # be read from a .or file.
    source = "fn add(a: int, b: int) -> int = a + b\n"
    print_line("source: " + source)

    # Step 1: lex with orion_lex (pure-Orion lexer).
    tokens = self_lex(source)
    token_count = my_count_items(tokens)
    print_line("orion_lex produced " + show_int(token_count) + " tokens")

    # Step 2: parse via IR shortcut. The pure-Orion parser handles
    # this shape but its output schema isn't wired to the wasm
    # codegen yet — we shortcut by authoring the matching IR.
    add_decl = IRFn{name: "add", param_count: 2, body: EAdd(0, 1)}

    # Step 3: codegen via orion_to_wasm.
    add_wfn = compile_fn(add_decl)

    # Step 4: assemble module + ship.
    mut module = new_module()
    module = add_fn(module, add_wfn)
    build("self_host", module, default_runtime("self_host.wasm"))

    print_line("")
    print_line("the produced wasm is the *output* of orion-self,")
    print_line("compiled by orion-self, runnable without Rust.")
    0

fn my_count_items(items: [Text]) -> int:
    mut count = 0
    for _t in items:
        count = count + 1
    count

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits(value)

fn digits(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits(value / 10) + glyph(value % 10)

fn glyph(d: int) -> Text:
    if d == 0:
        "0"
    else:
        if d == 1:
            "1"
        else:
            if d == 2:
                "2"
            else:
                if d == 3:
                    "3"
                else:
                    if d == 4:
                        "4"
                    else:
                        if d == 5:
                            "5"
                        else:
                            if d == 6:
                                "6"
                            else:
                                if d == 7:
                                    "7"
                                else:
                                    if d == 8:
                                        "8"
                                    else:
                                        "9"
