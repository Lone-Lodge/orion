# iter — functional list operations with closures.
# Build: this is a library-using program; compile with the orbs/ root:
#   orion.exe examples/demos/iter_functional.or out.ll orbs
#
# Shows map / filter / reduce / count taking `fn(...)` closures, including
# a closure that captures a local (`bonus`).
use iter

fn main() -> int:
    scores = [40, 75, 88, 12, 95, 60]
    bonus = 5

    # A `|>` pipe chain reads top-to-bottom instead of nesting inside-out:
    # each line takes the value from the line above. The closures capture
    # `bonus` from the surrounding scope.
    #   +bonus  → [45, 80, 93, 17, 100, 65]
    #   keep    → [80, 93, 100, 65]
    #   sum     → 338
    total = scores
        |> map(fn(s): s + bonus)
        |> filter(fn(s): if s >= 65 then 1 else 0)
        |> reduce(0, fn(acc, s): acc + s)

    # count how many were perfect (100), same value with a bonus.
    perfect = scores
        |> map(fn(s): s + bonus)
        |> count(fn(s): if s == 100 then 1 else 0)   # 1

    print_line("total: {total}   perfect: {perfect}")
    total
