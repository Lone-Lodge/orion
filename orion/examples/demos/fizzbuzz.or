# fizzbuzz — the canonical "can a newcomer write it?" program.
# Build: orion.exe examples/demos/fizzbuzz.or out.ll orbs
#
# 1..20: multiples of 3 -> "Fizz", of 5 -> "Buzz", of both -> "FizzBuzz",
# otherwise the number. Returns how many were "FizzBuzz" (exit code).

fn line(n: int) -> Text:
    mut s = ""
    if n % 3 == 0:
        s = "{s}Fizz"
    if n % 5 == 0:
        s = "{s}Buzz"
    if s == "":
        s = "{n}"
    s

fn main() -> int:
    mut both = 0
    for n in 1..=20:
        print_line("{n}: {line(n)}")
        if n % 15 == 0:
            both = both + 1
    both                                      # 15 is the only FizzBuzz in 1..20 -> 1
