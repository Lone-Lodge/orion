# Kitchen-sink demo: all major language features shipped this session.
#
# Run via interp:
#   orbit.exe run demo_kitchen_sink.or main
#
# Demonstrates:
#   - Generics: fn id<T>, fn pair_first<A, B>  (HM substitution)
#   - Closures with captures: |x| body that references outer vars
#   - SIMD: vec_add / vec_dot on int lists
#   - Async timing: monotonic_ms / sleep_ms
#   - Sum types + ? operator (existing)
#   - Defer (existing)

fn id<T>(value: T) -> T:
    value

fn pair_first<A, B>(left: A, right: B) -> A:
    left

# NB: closures with captures (|x| body referencing outer vars) work in the
# native compile path (orion-self orbs → LLVM), not yet in this lodge-orion
# interp run. See test_files/demo_all_features.or for the closure-flavour
# demo when running through native.

fn main() -> int:
    t0 = monotonic_ms()

    # Generics: T pinned by HM at call site.
    a = id(20)
    b = pair_first(22, 999)

    # SIMD.
    xs = [1, 2, 3, 4]
    ys = [10, 20, 30, 40]
    dot = vec_dot(xs, ys)
    sum_vec = vec_add(xs, ys)

    # Tiny sleep to exercise async primitives.
    sleep_ms(5)

    t1 = monotonic_ms()
    elapsed = t1 - t0

    print("generics a:")
    print(a)
    print("generics b:")
    print(b)
    print("vec_dot:")
    print(dot)
    print("vec_add[0]:")
    print(at(sum_vec, 0))
    print("elapsed_ms:")
    print(elapsed)

    # Sanity check: a (20) + b (22) = 42.
    a + b
