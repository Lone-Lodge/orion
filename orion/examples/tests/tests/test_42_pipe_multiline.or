fn double(x: int) -> int:
    x * 2

fn inc(x: int) -> int:
    x + 1

fn add(x: int, n: int) -> int:
    x + n

fn main() -> int:
    # A pipe chain split across lines: each `|>` opens a continuation
    # line, so the value flows top-to-bottom instead of nesting inside-out.
    #   10 |> inc      → 11
    #      |> double   → 22
    #      |> add(20)  → 42
    result = 10
        |> inc
        |> double
        |> add(20)
    result
