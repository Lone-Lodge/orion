effect Async:
    fetch: fn(arg: int) -> int

# The handler resumes with a value; control jumps BACK to perform's caller,
# bypassing the handler's normal return.
handle Async.fetch(arg: int) -> int:
    resume(99)

fn main() -> int:
    result = perform Async.fetch(7)
    if result == 99:
        42
    else:
        0
