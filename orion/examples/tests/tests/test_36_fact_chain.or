# A `fact` may build on another `fact`: `quad` reads `dbl`, which reads the
# live `n`. Each loop turn re-evaluates the whole chain against the current
# `n`, so quad = 8, 12, 16 as n = 2, 3, 4. Sum = 36.
fn main() -> int:
    mut n = 2
    fact dbl = n + n
    fact quad = dbl + dbl
    mut sum = 0
    for i in 0..<3:
        sum = sum + quad
        n = n + 1
    sum
