fn main() -> int:
    # mut variables reassigned with compatible ptr types
    mut acc = ""
    acc = "hello"
    acc = acc + " world"
    # Then a list (also ptr — should be allowed)
    mut things = []
    things = push(things, 21)
    things = push(things, 21)
    mut total = 0
    for x in things:
        total = total + x
    total
