fn piece_cells(piece_id):
    match piece_id:
        0 -> [{dc: 0, dr: 0}, {dc: 1, dr: 0}, {dc: 0, dr: 1}, {dc: 1, dr: 1}]
        1 -> [{dc: 0, dr: 0}, {dc: 1, dr: 0}, {dc: 2, dr: 0}]
        2 -> [{dc: 0, dr: 0}, {dc: 0, dr: 1}, {dc: 0, dr: 2}]
        3 -> [{dc: 0, dr: 0}, {dc: 1, dr: 0}, {dc: 0, dr: 1}]
        4 -> [{dc: 0, dr: 0}, {dc: 1, dr: 0}, {dc: 2, dr: 0}, {dc: 0, dr: 1}]
        5 -> [{dc: 0, dr: 0}, {dc: 1, dr: 0}, {dc: 2, dr: 0}, {dc: 2, dr: 1}]
        _ -> [{dc: 0, dr: 0}]

fn piece_color(piece_id):
    match piece_id:
        0 -> "magenta"
        1 -> "red"
        2 -> "blue"
        3 -> "green"
        4 -> "orange"
        5 -> "cyan"
        _ -> "yellow"
