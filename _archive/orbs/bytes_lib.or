# bytes — raw byte arrays as `[int]` (each element 0..=255).
#
# Only two primitives stay native: the Text ↔ [int] bridge (since Text is
# opaque). Everything else is pure Orion built on `len`/`at`/`push`.
#
# `read_f32_le` also stays native — IEEE-754 bit→float conversion needs the
# runtime's float layout.

# Text ↔ [int] bridge — only the runtime knows Text's internal layout.
extern fn __os_bytes_from_text(text: Text) -> [int]
extern fn __os_bytes_to_text(byte_list: [int]) -> Text

# IEEE-754 bit pattern → f64. The runtime owns the float layout.
extern fn __os_read_f32_le(byte_list: [int], offset: int) -> f64

pub fn bytes_from_text(text: Text) -> [int]:
    __os_bytes_from_text(text)

pub fn bytes_to_text(byte_list: [int]) -> Text:
    __os_bytes_to_text(byte_list)

pub fn read_f32_le(byte_list: [int], offset: int) -> f64:
    __os_read_f32_le(byte_list, offset)

# Mask a value to a single byte (0..=255). Used when we want to clamp
# arbitrary integers into the byte range without `% 256` (the modulo on
# negative numbers differs across languages).
fn _clamp_byte(value: int) -> int:
    if value < 0:
        0
    else:
        if value > 255:
            255
        else:
            value

pub fn bytes_length(byte_list: [int]) -> int:
    len(byte_list)

pub fn byte_at(byte_list: [int], index: int) -> int:
    fetched = at(byte_list, index)
    if type_of(fetched) == "none":
        0
    else:
        fetched

pub fn bytes_slice(byte_list: [int], low: int, high: int) -> [int]:
    total = len(byte_list)
    capped_high = if high < 0 then 0 else if high > total then total else high
    capped_low = if low < 0 then 0 else if low > capped_high then capped_high else low
    mut output = []
    for index in capped_low..<capped_high:
        output = push(output, at(byte_list, index))
    output

pub fn bytes_concat(left: [int], right: [int]) -> [int]:
    mut output = []
    left_length = len(left)
    for index in 0..<left_length:
        output = push(output, at(left, index))
    right_length = len(right)
    for index in 0..<right_length:
        output = push(output, at(right, index))
    output

pub fn bytes_repeat(byte_list: [int], count: int) -> [int]:
    if count <= 0:
        []
    else:
        single_length = len(byte_list)
        mut output = []
        mut iteration = 0
        loop:
            if iteration >= count:
                break
            for index in 0..<single_length:
                output = push(output, at(byte_list, index))
            iteration += 1
        output

pub fn bytes_zeros(count: int) -> [int]:
    if count <= 0:
        []
    else:
        mut output = []
        for _unused in 0..<count:
            output = push(output, 0)
        output

# ----- little/big-endian integer readers -----
# Pure-Orion bit assembly. Out-of-range reads return 0, matching the
# native behaviour we replaced.

pub fn read_u16_le(byte_list: [int], offset: int) -> int:
    if offset < 0 or offset + 2 > len(byte_list):
        0
    else:
        low_byte = byte_at(byte_list, offset)
        high_byte = byte_at(byte_list, offset + 1)
        low_byte + high_byte * 256

pub fn read_u16_be(byte_list: [int], offset: int) -> int:
    if offset < 0 or offset + 2 > len(byte_list):
        0
    else:
        high_byte = byte_at(byte_list, offset)
        low_byte = byte_at(byte_list, offset + 1)
        high_byte * 256 + low_byte

pub fn read_u32_le(byte_list: [int], offset: int) -> int:
    if offset < 0 or offset + 4 > len(byte_list):
        0
    else:
        byte_0 = byte_at(byte_list, offset)
        byte_1 = byte_at(byte_list, offset + 1)
        byte_2 = byte_at(byte_list, offset + 2)
        byte_3 = byte_at(byte_list, offset + 3)
        byte_0 + byte_1 * 256 + byte_2 * 65536 + byte_3 * 16777216

pub fn read_u32_be(byte_list: [int], offset: int) -> int:
    if offset < 0 or offset + 4 > len(byte_list):
        0
    else:
        byte_0 = byte_at(byte_list, offset)
        byte_1 = byte_at(byte_list, offset + 1)
        byte_2 = byte_at(byte_list, offset + 2)
        byte_3 = byte_at(byte_list, offset + 3)
        byte_0 * 16777216 + byte_1 * 65536 + byte_2 * 256 + byte_3
