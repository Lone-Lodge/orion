use bytes
use io

# orion_self_codegen — Orion → C code generator. STEP 7 PROOF.
#
# Walks an AST and emits C source. A real C/LLVM compiler (gcc, clang,
# tcc) then turns it into a native binary. This is the path early
# compilers for many languages took: Rust compiled to C before LLVM,
# Haskell still has a C backend, Vala compiles only to C.
#
# Why C and not direct machine code?
#   - C is a text format we can emit with `print` and string concat.
#   - Any system has a C compiler. No Orion runtime needed.
#   - Once this works, replacing the C backend with LLVM-IR (also text)
#     or hand-rolled assembly is purely additive work on the same AST.
#
# This proof handles int-only `add(2, 3)` style functions — enough to
# demonstrate end-to-end native compilation from pure Orion. Expanding
# to the full language is more cases of the same translation pattern.

# Translate an AST type-name to its C equivalent. Only the int-track is
# implemented for the proof; expanding to Text/bool/lists is mechanical.
fn cg_type_to_c(type_name: Text) -> Text:
    if type_name == "int":
        "int"
    else:
        if type_name == "bool":
            "int"
        else:
            if type_name == "Text":
                "const char*"
            else:
                "int"

fn cg_emit_str_literal(value: Text) -> Text:
    # Wrap the value in C double quotes. Inner double quotes / backslashes
    # would need escaping for production use; demo inputs are well-formed.
    bytes_value = bytes_of(value)
    value_length = bytes_count(bytes_value)
    mut escaped = bytes_zeros(0)
    for index in 0..<value_length:
        byte = byte_at(bytes_value, index)
        if byte == 34 or byte == 92:
            escaped = push(escaped, 92)
        escaped = push(escaped, byte)
    "\"" + text_of(escaped) + "\""

fn cg_emit_expr(node) -> Text:
    kind = text_of(bytes_of(get(node, "kind")))
    mut result = "/* unknown expr */ 0"
    if kind == "Int":
        result = text_of(bytes_of(get(node, "value")))
    if kind == "Str":
        result = cg_emit_str_literal(text_of(bytes_of(get(node, "value"))))
    if kind == "Ident":
        result = text_of(bytes_of(get(node, "name")))
    if kind == "Binary":
        left_c = cg_emit_expr(get(node, "left"))
        right_c = cg_emit_expr(get(node, "right"))
        op_text = text_of(bytes_of(get(node, "op")))
        result = "(" + left_c + " " + op_text + " " + right_c + ")"
    if kind == "Call":
        result = cg_emit_call(node)
    if kind == "If":
        # Emit C's ternary so the `if` survives as an expression. Nested
        # if/else chains generate parenthesised ternaries — verbose but
        # semantically correct.
        cond_c = cg_emit_expr(get(node, "cond"))
        then_c = cg_emit_expr(get(node, "then"))
        else_c = cg_emit_expr(get(node, "else"))
        result = "((" + cond_c + ") ? (" + then_c + ") : (" + else_c + "))"
    result

# Special-case a small set of built-ins so generated code can do I/O
# without us implementing a Text runtime. `print_line(text)` → `puts`.
fn cg_emit_call(node) -> Text:
    callee = text_of(bytes_of(get(node, "callee")))
    args = get(node, "args")
    arg_count = length(args)
    mut args_c = ""
    for index in 0..<arg_count:
        if index > 0:
            args_c = args_c + ", "
        args_c = args_c + cg_emit_expr(at(args, index))
    if callee == "print_line":
        # `puts` writes the string + a newline and returns a non-negative
        # int — matches the shape Orion expects from a print fn.
        "puts(" + args_c + ")"
    else:
        if callee == "print_int":
            "printf(\"%d\\n\", " + args_c + ")"
        else:
            if callee == "print_text":
                "printf(\"%s\", " + args_c + ")"
            else:
                callee + "(" + args_c + ")"

# Best-effort type guess for `let` bindings. Looks at the value's AST
# kind: string → const char*, everything else → int. A real type
# inferencer threads through the param scope; this is enough for the
# self-host demo.
fn cg_guess_type(expr_node) -> Text:
    expr_kind = text_of(bytes_of(get(expr_node, "kind")))
    if expr_kind == "Str":
        "const char*"
    else:
        "int"

# Scope tracker — names already declared in the current C function.
# Stored in a `slot_get`/`slot_set` slot so we don't have to thread it
# through every helper. Cleared at the start of each fn.

fn cg_scope_reset():
    slot_set("cg:declared", [])

fn cg_scope_has(name: Text) -> bool:
    declared = slot_get("cg:declared")
    if type_of(declared) == "none":
        false
    else:
        total = length(declared)
        mut found = false
        for index in 0..<total:
            entry = at(declared, index)
            if text_of(bytes_of(entry)) == name:
                found = true
        found

fn cg_scope_add(name: Text):
    declared = slot_get("cg:declared")
    current = if type_of(declared) == "none" then [] else declared
    slot_set("cg:declared", push(current, name))

fn cg_indent(level: int) -> Text:
    mut spaces = ""
    for _unused in 0..<level:
        spaces = spaces + "    "
    spaces

fn cg_emit_stmt(stmt_node, is_tail: bool, level: int) -> Text:
    stmt_kind = text_of(bytes_of(get(stmt_node, "kind")))
    indent = cg_indent(level)
    mut output = ""
    if stmt_kind == "MutLet":
        let_name = text_of(bytes_of(get(stmt_node, "name")))
        let_value = get(stmt_node, "value")
        type_c = cg_guess_type(let_value)
        cg_scope_add(let_name)
        output = indent + type_c + " " + let_name + " = " + cg_emit_expr(let_value) + ";\n"
    if stmt_kind == "LetOrAssign":
        let_name = text_of(bytes_of(get(stmt_node, "name")))
        let_value = get(stmt_node, "value")
        already_declared = cg_scope_has(let_name)
        if already_declared:
            output = indent + let_name + " = " + cg_emit_expr(let_value) + ";\n"
        else:
            type_c = cg_guess_type(let_value)
            cg_scope_add(let_name)
            output = indent + type_c + " " + let_name + " = " + cg_emit_expr(let_value) + ";\n"
    if stmt_kind == "ExprStmt":
        expr_c = cg_emit_expr(get(stmt_node, "expr"))
        if is_tail:
            output = indent + "return " + expr_c + ";\n"
        else:
            output = indent + "(void)(" + expr_c + ");\n"
    if stmt_kind == "Break":
        output = indent + "break;\n"
    if stmt_kind == "Loop":
        # `while (1) { ... }`; never the tail expression of a function
        # since `loop:` doesn't yield a value.
        inner_body = cg_emit_block_at(get(stmt_node, "body"), level + 1)
        output = indent + "while (1) \{\n" + inner_body + indent + "\}\n"
    output

fn cg_emit_block_at(block_node, level: int) -> Text:
    statements = get(block_node, "stmts")
    stmt_count = length(statements)
    mut body_c = ""
    for index in 0..<stmt_count:
        stmt = at(statements, index)
        stmt_kind = text_of(bytes_of(get(stmt, "kind")))
        # ExprStmt is only the "return" of a fn if it's the last stmt
        # AND we're at level 1 (top of fn body). Loop/Break never return.
        is_tail = level == 1 and index == stmt_count - 1 and stmt_kind == "ExprStmt"
        body_c = body_c + cg_emit_stmt(stmt, is_tail, level)
    body_c

fn cg_emit_block(block_node) -> Text:
    cg_emit_block_at(block_node, 1)

fn cg_emit_fn(fn_node) -> Text:
    name = text_of(bytes_of(get(fn_node, "name")))
    ret_type = text_of(bytes_of(get(get(fn_node, "ret"), "name")))
    ret_c = cg_type_to_c(ret_type)
    params = get(fn_node, "params")
    param_count = length(params)
    # Fresh scope per fn. Params count as declared so reassignment to
    # them generates `param = …` instead of redeclaring.
    cg_scope_reset()
    mut params_c = ""
    for index in 0..<param_count:
        if index > 0:
            params_c = params_c + ", "
        param = at(params, index)
        param_type = text_of(bytes_of(get(get(param, "type"), "name")))
        param_name = text_of(bytes_of(get(param, "name")))
        cg_scope_add(param_name)
        params_c = params_c + cg_type_to_c(param_type) + " " + param_name
    if param_count == 0:
        params_c = "void"
    body_c = cg_emit_block(get(fn_node, "body"))
    ret_c + " " + name + "(" + params_c + ") \{\n" + body_c + "\}"

# Special case: the entry point. Orion's `main` returns int but C's main
# also prints + exits. We wrap with a printf so the user sees the
# computed value (matches `orbit run`'s behaviour of printing the result).
fn cg_emit_main_wrapper() -> Text:
    "int main(void) \{ printf(\"%d\\n\", orion_main()); return 0; \}"

# Rename the AST's `main` to `orion_main` so the C `main` can wrap it.
fn cg_rename_main(fn_node):
    name = text_of(bytes_of(get(fn_node, "name")))
    if name == "main":
        set(fn_node, "name", "orion_main")
    else:
        fn_node

# Minimal C runtime header bolted on top of every generated program.
# Provides `or_text_concat` so Orion's `+` on Text values can lower to
# a real C function call. Static buffer; good enough for the proof.
fn cg_runtime_header() -> Text:
    "#include <stdio.h>\n#include <string.h>\n\nstatic char or_text_buf[65536];\nstatic int or_text_pos = 0;\nstatic const char* or_text_concat(const char* a, const char* b) \{\n    int la = (int)strlen(a);\n    int lb = (int)strlen(b);\n    if (or_text_pos + la + lb + 1 > (int)sizeof(or_text_buf)) or_text_pos = 0;\n    char* dst = or_text_buf + or_text_pos;\n    memcpy(dst, a, la);\n    memcpy(dst + la, b, lb);\n    dst[la + lb] = 0;\n    or_text_pos += la + lb + 1;\n    return dst;\n\}\n\n"

pub fn self_codegen(ast) -> Text:
    decls = get(ast, "decls")
    decl_count = length(decls)
    mut output = cg_runtime_header()
    for index in 0..<decl_count:
        renamed = cg_rename_main(at(decls, index))
        output = output + cg_emit_fn(renamed) + "\n"
    output + "\n" + cg_emit_main_wrapper() + "\n"
