# orion_emit_wasm — emit a WebAssembly module (.wasm binary).
#
# Mirrors `orion_emit_pe` for the browser. Pure Orion produces a
# bytes-on-disk .wasm whose exports a JS shell calls. No external
# linker, no wasm-bindgen, no wasm-pack — Orion writes the bytes
# itself, JS imports them with `WebAssembly.instantiateStreaming`.
#
# Spec: https://webassembly.github.io/spec/core/binary/index.html
#
# Layout:
#   "\0asm" + version 1 (8 bytes magic)
#   Type   section  (id=1)  — function signatures
#   Func   section  (id=3)  — fn indices into Types
#   Memory section  (id=5)  — linear memory (1 page = 64 KiB)
#   Export section  (id=7)  — what JS can call
#   Code   section  (id=10) — fn bodies as bytecode
#
# Today's coverage: int → int functions with arithmetic,
# locals, calls, return. Strings + memory ops + import tables land
# next as the JS shell expands.

use bytes
use os

# --- LEB128 encoders ---

# Unsigned LEB128 — the variable-length integer wasm uses for sizes
# and indices. Encodes one 7-bit chunk per byte, MSB = continuation.
pub fn leb_u(value: int) -> [int]:
    mut remaining = value
    mut output = []
    mut keep = true
    loop:
        if not keep:
            break
        byte_chunk = remaining - (remaining / 128) * 128
        remaining = remaining / 128
        if remaining == 0:
            output = push(output, byte_chunk)
            keep = false
        else:
            output = push(output, byte_chunk + 128)
    output

# Signed LEB128 — i32.const operand and friends.
pub fn leb_s(value: int) -> [int]:
    mut remaining = value
    mut output = []
    mut keep = true
    loop:
        if not keep:
            break
        byte_chunk = remaining - (remaining / 128) * 128
        remaining = remaining / 128
        # bit 6 of byte_chunk = `byte_chunk >= 64`. That bit is the
        # signed-LEB sign indicator: when the last byte's bit-6 set
        # state matches the value's sign, encoding stops; otherwise
        # we emit one more byte (0x00 for positive, 0x7F for negative)
        # so the reader gets the sign right.
        sign_bit_set = byte_chunk >= 64
        done_positive = remaining == 0 and not sign_bit_set
        done_negative = remaining == -1 and sign_bit_set
        if done_positive or done_negative:
            output = push(output, byte_chunk)
            keep = false
        else:
            output = push(output, byte_chunk + 128)
    output

# --- low-level byte helpers ---

# Concatenate a list of byte lists into one. The WASM encoder needs
# this because sections are built piecewise then prefixed with their
# total byte length.
pub fn concat_all(parts: [int]) -> [int]:
    mut output = []
    loop part_byte in parts:
        output = push(output, part_byte)
    output

# Encode a UTF-8 string with a LEB128 length prefix — the WASM "name"
# vector format for imports/exports.
pub fn encode_name(name: Text) -> [int]:
    name_bytes = bytes_from_text(name)
    name_length = bytes_length(name_bytes)
    length_prefix = leb_u(name_length)
    mut output = []
    loop byte_value in length_prefix:
        output = push(output, byte_value)
    loop byte_value in name_bytes:
        output = push(output, byte_value)
    output

# A section is: id (1 byte) + size (LEB128) + contents. The encoder
# pre-builds the contents to know the size.
pub fn wrap_section(section_id: int, contents: [int]) -> [int]:
    content_length = list_length(contents)
    size_bytes = leb_u(content_length)
    mut output = push([], section_id)
    loop size_byte in size_bytes:
        output = push(output, size_byte)
    loop content_byte in contents:
        output = push(output, content_byte)
    output

fn list_length(items: [int]) -> int:
    mut count = 0
    loop _item in items:
        count = count + 1
    count

# --- WASM opcodes (subset we emit today) ---

pub fn op_end() -> int: 11          # 0x0B end
pub fn op_return() -> int: 15       # 0x0F return
pub fn op_call() -> int: 16         # 0x10 call funcidx
pub fn op_local_get() -> int: 32    # 0x20 local.get
pub fn op_local_set() -> int: 33    # 0x21 local.set
pub fn op_local_tee() -> int: 34    # 0x22 local.tee (set + leave on stack)
pub fn op_i32_const() -> int: 65    # 0x41 i32.const
pub fn op_i32_eqz() -> int: 69      # 0x45 i32.eqz
pub fn op_i32_eq() -> int: 70       # 0x46 i32.eq
pub fn op_i32_ne() -> int: 71       # 0x47 i32.ne
pub fn op_i32_lt_s() -> int: 72     # 0x48 i32.lt_s
pub fn op_i32_gt_s() -> int: 74     # 0x4A i32.gt_s
pub fn op_i32_le_s() -> int: 76     # 0x4C i32.le_s
pub fn op_i32_ge_s() -> int: 78     # 0x4E i32.ge_s
pub fn op_i32_add() -> int: 106     # 0x6A i32.add
pub fn op_i32_sub() -> int: 107     # 0x6B i32.sub
pub fn op_i32_mul() -> int: 108     # 0x6C i32.mul
pub fn op_i32_div_s() -> int: 109   # 0x6D i32.div_s
pub fn op_i32_rem_s() -> int: 111    # 0x6F i32.rem_s
pub fn op_i32_and() -> int: 113      # 0x71 i32.and
pub fn op_i32_or() -> int: 114       # 0x72 i32.or
pub fn op_i32_xor() -> int: 115      # 0x73 i32.xor
pub fn op_i32_shl() -> int: 116      # 0x74 i32.shl
pub fn op_i32_shr_s() -> int: 117    # 0x75 i32.shr_s

# Control flow.
pub fn op_block() -> int: 2         # 0x02 block (then blocktype)
pub fn op_loop() -> int: 3          # 0x03 loop
pub fn op_if() -> int: 4            # 0x04 if (then blocktype)
pub fn op_else() -> int: 5          # 0x05 else
pub fn op_br() -> int: 12           # 0x0C br
pub fn op_br_if() -> int: 13        # 0x0D br_if (branch when top of stack != 0)

# Blocktype sentinel — "no result". Used after `if`/`block`/`loop`
# when the body doesn't push anything to the stack.
pub fn blocktype_void() -> int: 64  # 0x40

# Linear memory ops — the byte-level loads/stores wasm uses to read
# and write the module's heap. Used to pass strings (and any other
# composite data) between the wasm code and the JS host.
pub fn op_i32_load() -> int: 40     # 0x28 i32.load
pub fn op_i32_load8_u() -> int: 45  # 0x2D i32.load8_u
pub fn op_i32_store() -> int: 54    # 0x36 i32.store
pub fn op_i32_store8() -> int: 58   # 0x3A i32.store8

# Type marker for i32 in function signatures.
pub fn ty_i32() -> int: 127         # 0x7F

# --- module assembly ---

# Build a minimal WASM module that exports one function `main`
# returning a constant i32. Useful for sanity-testing the encoder
# end-to-end without an AST in the loop.
pub fn build_const_module(return_value: int) -> [int]:
    # Type section: one type — () -> i32
    type_section = build_type_section()
    # Function section: one function, type index 0
    func_section = wrap_section(3, [1, 0])
    # Memory section: one memory, 1 page minimum, no max
    memory_section = wrap_section(5, [1, 0, 1])
    # Export section: export "main" as func index 0
    export_section = build_export_section("main")
    # Code section: one function body
    code_section = build_code_section_const(return_value)

    mut output = []
    # Magic: 0x00 'a' 's' 'm' + version 1
    output = push(output, 0)
    output = push(output, 97)
    output = push(output, 115)
    output = push(output, 109)
    output = push(output, 1)
    output = push(output, 0)
    output = push(output, 0)
    output = push(output, 0)

    loop section_byte in type_section:
        output = push(output, section_byte)
    loop section_byte in func_section:
        output = push(output, section_byte)
    loop section_byte in memory_section:
        output = push(output, section_byte)
    loop section_byte in export_section:
        output = push(output, section_byte)
    loop section_byte in code_section:
        output = push(output, section_byte)
    output

fn build_type_section() -> [int]:
    # 1 type, form 0x60, 0 params, 1 result (i32)
    contents = [1, 96, 0, 1, ty_i32()]
    wrap_section(1, contents)

fn build_export_section(name: Text) -> [int]:
    name_bytes = encode_name(name)
    # 1 export, then the name vec, then kind=0 (func) + index=0
    mut contents = [1]
    loop byte_value in name_bytes:
        contents = push(contents, byte_value)
    contents = push(contents, 0)
    contents = push(contents, 0)
    wrap_section(7, contents)

fn build_code_section_const(return_value: int) -> [int]:
    # 1 code entry. Function body = local count (0), then
    # i32.const + leb_s(value), then end.
    const_bytes = leb_s(return_value)
    mut fn_body = [0]
    fn_body = push(fn_body, op_i32_const())
    loop byte_value in const_bytes:
        fn_body = push(fn_body, byte_value)
    fn_body = push(fn_body, op_end())

    body_size = list_length(fn_body)
    size_prefix = leb_u(body_size)
    mut wrapped = [1]
    loop size_byte in size_prefix:
        wrapped = push(wrapped, size_byte)
    loop body_byte in fn_body:
        wrapped = push(wrapped, body_byte)
    wrap_section(10, wrapped)

# Write a .wasm file to disk. The browser fetches it as application/wasm
# and instantiates via WebAssembly.instantiateStreaming.
pub fn write_wasm(path: Text, bytes_data: [int]):
    ok = write_file(path, bytes_to_text(bytes_data))
    ok

# ============================================================
#  Higher-level builder API — assemble a module from data types
# ============================================================
#
# Instead of poking bytes by hand the user describes the module as
# data: a list of functions, each with a name + param count + body
# bytes (already-encoded instructions). The encoder walks the
# description, lays out each section, and returns the full .wasm.

# One function within a module.
pub type WFn: name: Text, param_count: int, body: [int], local_count: int

# One import from the JS host: `module.name`, taking N i32 args,
# returning either i32 or nothing. The result_count flag is 0 for
# void, 1 for i32 — same shape as fn types.
pub type WImport: module_name: Text, fn_name: Text, param_count: int, result_count: int

# One static byte block placed in linear memory at startup. The data
# section seeds the wasm heap with literal bytes — strings, tables,
# baked vertex data — without the runtime having to compute them.
pub type WDataSegment: offset: int, bytes: [int]

# Whole module — imports + locally-defined functions + data segments.
# Imports get function indices 0..N before locally-defined fns start;
# data segments populate linear memory at instantiate time.
pub type WModule: imports: [WImport], functions: [WFn], data_segments: [WDataSegment]

pub fn new_module() -> WModule:
    WModule{imports: [], functions: [], data_segments: []}

# Register a host import. JS will satisfy it via
# `{ env: { canvas_fill_rect: (x,y,w,h,c) => ... } }` at instantiate
# time.
pub fn add_import(module: WModule, import_value: WImport) -> WModule:
    WModule{imports: push(module.imports, import_value), functions: module.functions, data_segments: module.data_segments}

pub fn new_import(module_name: Text, fn_name: Text, param_count: int, result_count: int) -> WImport:
    WImport{module_name: module_name, fn_name: fn_name, param_count: param_count, result_count: result_count}

pub fn add_fn(module: WModule, fn_value: WFn) -> WModule:
    WModule{imports: module.imports, functions: push(module.functions, fn_value), data_segments: module.data_segments}

# Bake a string (or any byte sequence) into linear memory. Returns
# the new module + the offset the bytes were placed at — callers can
# use that offset as the pointer in `i32.load8_u` or hand it to a
# host import expecting (ptr, len).
pub fn add_data(module: WModule, offset: int, bytes_data: [int]) -> WModule:
    new_seg = WDataSegment{offset: offset, bytes: bytes_data}
    WModule{imports: module.imports, functions: module.functions, data_segments: push(module.data_segments, new_seg)}

pub fn add_string(module: WModule, offset: int, text: Text) -> WModule:
    add_data(module, offset, bytes_from_text(text))

pub fn new_fn(name: Text, param_count: int) -> WFn:
    WFn{name: name, param_count: param_count, body: [], local_count: 0}

# Register one more local (beyond params); emitted as an i32 in the code
# section local declarations.
pub fn add_local(fn_value: WFn) -> WFn:
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: fn_value.body, local_count: fn_value.local_count + 1}

# Emit one opcode-with-no-immediate into the function body. Returns a
# fresh WFn so the builder stays pure (no mutation).
pub fn emit_op(fn_value: WFn, opcode: int) -> WFn:
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: push(fn_value.body, opcode), local_count: fn_value.local_count}

# Append several bytes (used for opcode + immediate combos).
pub fn emit_bytes(fn_value: WFn, more: [int]) -> WFn:
    mut grown = fn_value.body
    loop byte_value in more:
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Push an i32 constant.
pub fn emit_const(fn_value: WFn, value: int) -> WFn:
    immediate = leb_s(value)
    mut grown = push(fn_value.body, op_i32_const())
    loop byte_value in immediate:
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# local.get / local.set with LEB128 index.
pub fn emit_local_get(fn_value: WFn, index: int) -> WFn:
    idx_bytes = leb_u(index)
    mut grown = push(fn_value.body, op_local_get())
    loop byte_value in idx_bytes:
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

pub fn emit_local_set(fn_value: WFn, index: int) -> WFn:
    idx_bytes = leb_u(index)
    mut grown = push(fn_value.body, op_local_set())
    loop byte_value in idx_bytes:
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# local.tee — like set but leaves the value on the stack (so an
# allocation pointer can be stashed and reused in one instruction).
pub fn emit_local_tee(fn_value: WFn, index: int) -> WFn:
    idx_bytes = leb_u(index)
    mut grown = push(fn_value.body, op_local_tee())
    loop byte_value in idx_bytes:
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# i32.load / i32.store with a memarg (alignment exponent + byte offset).
# Alignment 2 is natural for a 4-byte i32; baking the offset in lets a
# field access (ptr + 4 + i*4) fold the constant `+ 4` into the load.
pub fn emit_load(fn_value: WFn, offset: int) -> WFn:
    mut grown = push(fn_value.body, op_i32_load())
    grown = push(grown, 2)
    loop byte_value in leb_u(offset):
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

pub fn emit_store(fn_value: WFn, offset: int) -> WFn:
    mut grown = push(fn_value.body, op_i32_store())
    grown = push(grown, 2)
    loop byte_value in leb_u(offset):
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Direct call to another function by index. The caller already
# arranged the arguments on the stack.
pub fn emit_call(fn_value: WFn, function_index: int) -> WFn:
    idx_bytes = leb_u(function_index)
    mut grown = push(fn_value.body, op_call())
    loop byte_value in idx_bytes:
        grown = push(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Close out a function body with the `end` opcode (required by the
# WASM grammar at function/block end).
pub fn emit_end(fn_value: WFn) -> WFn:
    emit_op(fn_value, op_end())

# ============================================================
#  Encode a WModule to bytes
# ============================================================

pub fn encode_module(module: WModule) -> [int]:
    # Layout: types ← imports ← funcs ← memory ← exports ← code ← data.
    # Memory is exported as "memory" so JS can read strings the wasm
    # writes (or that we bake in via data segments).
    type_section = encode_type_section(module)
    import_section = encode_import_section(module)
    func_section = encode_function_section(module)
    memory_section = wrap_section(5, [1, 0, 1])
    export_section = encode_export_section(module)
    code_section = encode_code_section(module)
    data_section = encode_data_section(module)

    mut output = [0, 97, 115, 109, 1, 0, 0, 0]
    loop byte_value in type_section: output = push(output, byte_value)
    loop byte_value in import_section: output = push(output, byte_value)
    loop byte_value in func_section: output = push(output, byte_value)
    loop byte_value in memory_section: output = push(output, byte_value)
    loop byte_value in export_section: output = push(output, byte_value)
    loop byte_value in code_section: output = push(output, byte_value)
    loop byte_value in data_section: output = push(output, byte_value)
    output

# Data section (id 11) — initialises linear memory with literal bytes
# at instantiate time. Each segment: memidx (0, the only memory), an
# i32.const offset expression, then the byte vector.
fn encode_data_section(module: WModule) -> [int]:
    seg_count = data_count(module)
    if seg_count == 0:
        []
    else:
        mut contents = []
        count_bytes = leb_u(seg_count)
        loop byte_value in count_bytes:
            contents = push(contents, byte_value)
        loop segment in module.data_segments:
            # Active segment for memidx 0
            contents = push(contents, 0)
            # Offset expression: i32.const <offset>, end
            offset_bytes = leb_s(segment.offset)
            contents = push(contents, op_i32_const())
            loop byte_value in offset_bytes:
                contents = push(contents, byte_value)
            contents = push(contents, op_end())
            # The byte payload
            payload_size = list_length(segment.bytes)
            size_bytes = leb_u(payload_size)
            loop byte_value in size_bytes:
                contents = push(contents, byte_value)
            loop byte_value in segment.bytes:
                contents = push(contents, byte_value)
        wrap_section(11, contents)

fn data_count(module: WModule) -> int:
    mut count = 0
    loop _segment in module.data_segments:
        count = count + 1
    count

# Import section — id 2. Each entry is module name + fn name + kind
# (0x00 = func) + type index. The type vector already includes the
# import signatures alongside the local function ones.
fn encode_import_section(module: WModule) -> [int]:
    import_count = import_list_length(module)
    if import_count == 0:
        []
    else:
        mut contents = []
        count_bytes = leb_u(import_count)
        loop byte_value in count_bytes:
            contents = push(contents, byte_value)
        loop import_value in module.imports:
            mod_bytes = encode_name(import_value.module_name)
            loop byte_value in mod_bytes:
                contents = push(contents, byte_value)
            name_bytes = encode_name(import_value.fn_name)
            loop byte_value in name_bytes:
                contents = push(contents, byte_value)
            contents = push(contents, 0)
            type_index = type_index_for_import(module, import_value)
            idx_bytes = leb_u(type_index)
            loop byte_value in idx_bytes:
                contents = push(contents, byte_value)
        wrap_section(2, contents)

fn import_list_length(module: WModule) -> int:
    mut count = 0
    loop _value in module.imports:
        count = count + 1
    count

fn type_index_for_import(module: WModule, import_value: WImport) -> int:
    # Same logic as type_index_for_fn — distinct (param_count, result_count) pairs.
    mut signatures = collect_signatures(module)
    mut at_index = 0
    mut found = 0
    loop sig in signatures:
        if sig == encode_sig_key(import_value.param_count, import_value.result_count):
            found = at_index
        at_index = at_index + 1
    found

# Encode a (param_count, result_count) signature as one int so the
# distinct-set logic is the same as for fns alone.
fn encode_sig_key(param_count: int, result_count: int) -> int:
    param_count * 10 + result_count

fn collect_signatures(module: WModule) -> [int]:
    mut sigs = []
    loop import_value in module.imports:
        sig = encode_sig_key(import_value.param_count, import_value.result_count)
        if not contains_count(sigs, sig):
            sigs = push(sigs, sig)
    loop fn_value in module.functions:
        sig = encode_sig_key(fn_value.param_count, 1)
        if not contains_count(sigs, sig):
            sigs = push(sigs, sig)
    sigs

# Type section — one entry per distinct (param_count, result_count)
# signature across imports + functions.
fn encode_type_section(module: WModule) -> [int]:
    signatures = collect_signatures(module)
    sig_count = list_length(signatures)
    mut contents = []
    count_bytes = leb_u(sig_count)
    loop byte_value in count_bytes:
        contents = push(contents, byte_value)
    loop sig_key in signatures:
        param_count = sig_key / 10
        result_count = sig_key - param_count * 10
        contents = push(contents, 96)
        param_bytes = leb_u(param_count)
        loop byte_value in param_bytes:
            contents = push(contents, byte_value)
        mut remaining = param_count
        loop:
            if remaining == 0:
                break
            contents = push(contents, ty_i32())
            remaining = remaining - 1
        result_bytes = leb_u(result_count)
        loop byte_value in result_bytes:
            contents = push(contents, byte_value)
        mut remaining_results = result_count
        loop:
            if remaining_results == 0:
                break
            contents = push(contents, ty_i32())
            remaining_results = remaining_results - 1
    wrap_section(1, contents)

fn contains_count(items: [int], value: int) -> bool:
    mut found = false
    loop item in items:
        if item == value:
            found = true
    found

# Function section — each fn's index into the type vector.
fn encode_function_section(module: WModule) -> [int]:
    signatures = collect_signatures(module)
    fn_count = function_count(module)
    mut contents = []
    count_bytes = leb_u(fn_count)
    loop byte_value in count_bytes:
        contents = push(contents, byte_value)
    loop fn_value in module.functions:
        sig_key = encode_sig_key(fn_value.param_count, 1)
        type_index = index_of_count(signatures, sig_key)
        idx_bytes = leb_u(type_index)
        loop byte_value in idx_bytes:
            contents = push(contents, byte_value)
    wrap_section(3, contents)

fn function_count(module: WModule) -> int:
    mut count = 0
    loop _fn_value in module.functions:
        count = count + 1
    count

fn index_of_count(items: [int], target: int) -> int:
    mut found_at = 0
    mut current = 0
    loop item in items:
        if item == target:
            found_at = current
        current = current + 1
    found_at

# Export section — local fns indexed AFTER imports. We also export
# the single memory under the name "memory" so JS can `new Uint8Array(
# instance.exports.memory.buffer)` and read strings the wasm placed.
fn encode_export_section(module: WModule) -> [int]:
    fn_count = function_count(module)
    import_offset = import_list_length(module)
    total_count = fn_count + 1
    mut contents = []
    count_bytes = leb_u(total_count)
    loop byte_value in count_bytes:
        contents = push(contents, byte_value)
    mut index = 0
    loop fn_value in module.functions:
        name_bytes = encode_name(fn_value.name)
        loop byte_value in name_bytes:
            contents = push(contents, byte_value)
        contents = push(contents, 0)
        idx_bytes = leb_u(index + import_offset)
        loop byte_value in idx_bytes:
            contents = push(contents, byte_value)
        index = index + 1
    # Memory export — kind = 2 (memory), index 0 (only memory).
    mem_name = encode_name("memory")
    loop byte_value in mem_name:
        contents = push(contents, byte_value)
    contents = push(contents, 2)
    contents = push(contents, 0)
    wrap_section(7, contents)

# Code section — bundled function bodies.
fn encode_code_section(module: WModule) -> [int]:
    fn_count = function_count(module)
    mut contents = []
    count_bytes = leb_u(fn_count)
    loop byte_value in count_bytes:
        contents = push(contents, byte_value)
    loop fn_value in module.functions:
        # Function body framing: local declarations, then body bytes. Declare
        # local_count i32 locals (indices param_count..param_count+local_count-1);
        # without this a `local.get`/`local.set` past the params is invalid wasm.
        mut body_with_locals = [0]
        if fn_value.local_count != 0:
            body_with_locals = [1]
            lc_bytes = leb_u(fn_value.local_count)
            loop byte_value in lc_bytes:
                body_with_locals = push(body_with_locals, byte_value)
            body_with_locals = push(body_with_locals, 127)
        loop byte_value in fn_value.body:
            body_with_locals = push(body_with_locals, byte_value)
        body_size = list_length(body_with_locals)
        size_bytes = leb_u(body_size)
        loop byte_value in size_bytes:
            contents = push(contents, byte_value)
        loop byte_value in body_with_locals:
            contents = push(contents, byte_value)
    wrap_section(10, contents)
