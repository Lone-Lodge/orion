use orion_emit_wasm
use orion_veil_to_wasm
use io
use fs

# Full lone-lodge in the browser:
#   * Veil's display list driving canvas paints
#   * Real strings baked into wasm linear memory + drawn as text
#   * Atlas-style entity loop (per-frame position update + render)
#
# One wasm module, two exports:
#   * render_scene()     — the static UI (Veil scene)
#   * render_frame(tick) — the dynamic ECS (Atlas entities)
#
# JS picks one or the other based on which animation phase is on.

fn main() -> int:
    print_line("lone-lodge-web — full stack wasm build")
    mkdir_all("dist")

    # Strings baked at fixed offsets in linear memory. The wasm side
    # passes (ptr, len) to draw_text; JS reads bytes out of
    # instance.exports.memory.
    str_title = "lone-lodge — pure Orion in the browser"
    str_card1 = "Veil resolver → DrawCmd → wasm"
    str_card2 = "Atlas entities → integer motion"
    str_button = "Animate"

    offset_title = 0
    offset_card1 = 64
    offset_card2 = 128
    offset_button = 192

    title_len = string_byte_count(str_title)
    card1_len = string_byte_count(str_card1)
    card2_len = string_byte_count(str_card2)
    button_len = string_byte_count(str_button)

    # Build the static Veil scene as a WCmd list. Each cmd will be
    # emitted into the render_scene() body as a sequence of wasm
    # instructions.
    veil_cmds = [Background(15, 23, 42), FillRect(14, 165, 233, 0, 0), DrawText(24, 40, offset_title, title_len), FillRect(255, 255, 255, 20, 96), DrawText(36, 124, offset_card1, card1_len), FillRect(255, 255, 255, 20, 196), DrawText(36, 224, offset_card2, card2_len), FillRect(14, 165, 233, 20, 280), DrawText(40, 302, offset_button, button_len)]

    module = new_module()
    m1 = add_veil_imports(module)
    m2 = add_string(m1, offset_title, str_title)
    m3 = add_string(m2, offset_card1, str_card1)
    m4 = add_string(m3, offset_card2, str_card2)
    m5 = add_string(m4, offset_button, str_button)
    m6 = add_fn(m5, compile_render(veil_cmds))

    # Atlas entity loop — same as the atlas_browser demo but folded
    # into this single module so JS can flip between phases.
    m7 = add_fn(m6, build_atlas_render())

    wasm_bytes = encode_module(m7)
    write_wasm("dist/lone_lodge.wasm", wasm_bytes)
    print_line("wrote dist/lone_lodge.wasm")

    write_file("dist/index.html", html_shell())
    write_file("dist/main.js", page_runtime())
    print_line("wrote dist/index.html + dist/main.js")
    print_line("open dist/index.html for the full browser demo")
    0

# Pure-Orion UTF-8 byte counter. Doesn't decode characters — just
# returns bytes_length, which is the (ptr, len) JS needs.
fn string_byte_count(text: Text) -> int:
    bytes_data = bytes_of(text)
    mut count = 0
    for _byte_value in bytes_data:
        count = count + 1
    count

# Atlas render_frame(tick) — four entities moving with integer
# motion, wrap-around at canvas width. Same maths as atlas_motion's
# `position_at`, hand-rolled into wasm since we don't yet pipe the
# Orion-level IR through the codegen.
fn build_atlas_render() -> WFn:
    f0 = new_fn("render_frame", 1)
    f1 = emit_call_3(f0, import_set_fill(), 15, 23, 42)
    f2 = emit_call_4(f1, import_fill_rect(), 0, 0, 480, 320)
    f3 = paint_particle(f2, 255, 99, 132, 0, 60, 2)
    f4 = paint_particle(f3, 99, 255, 132, 50, 120, 3)
    f5 = paint_particle(f4, 99, 132, 255, 100, 180, 1)
    f6 = paint_particle(f5, 255, 200, 99, 150, 240, 4)
    f7 = emit_const(f6, 0)
    emit_end(f7)

# Same pattern as the atlas_browser demo: x = (anchor + tick*vx) mod 480.
fn paint_particle(fn_value: WFn, r: int, g: int, b: int, anchor_x: int, anchor_y: int, vx: int) -> WFn:
    f1 = emit_call_3(fn_value, import_set_fill(), r, g, b)
    f2 = emit_local_get(f1, 0)
    f3 = emit_const(f2, vx)
    f4 = emit_op(f3, op_i32_mul())
    f5 = emit_const(f4, anchor_x)
    f6 = emit_op(f5, op_i32_add())
    f7 = emit_local_get(f6, 0)
    f8 = emit_const(f7, vx)
    f9 = emit_op(f8, op_i32_mul())
    f10 = emit_const(f9, anchor_x)
    f11 = emit_op(f10, op_i32_add())
    f12 = emit_const(f11, 480)
    f13 = emit_op(f12, op_i32_div_s())
    f14 = emit_const(f13, 480)
    f15 = emit_op(f14, op_i32_mul())
    f16 = emit_op(f15, op_i32_sub())
    f17 = emit_const(f16, anchor_y)
    f18 = emit_const(f17, 32)
    f19 = emit_const(f18, 32)
    emit_call(f19, import_fill_rect())

fn emit_call_3(fn_value: WFn, host_index: int, a: int, b: int, c: int) -> WFn:
    f1 = emit_const(fn_value, a)
    f2 = emit_const(f1, b)
    f3 = emit_const(f2, c)
    emit_call(f3, host_index)

fn emit_call_4(fn_value: WFn, host_index: int, a: int, b: int, c: int, d: int) -> WFn:
    f1 = emit_const(fn_value, a)
    f2 = emit_const(f1, b)
    f3 = emit_const(f2, c)
    f4 = emit_const(f3, d)
    emit_call(f4, host_index)

fn html_shell() -> Text:
    "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>lone-lodge — pure Orion in the browser</title>\n<style>body\{font-family:system-ui;background:#020617;color:#f1f5f9;padding:24px;margin:0\}h1\{font-weight:600;margin:0 0 6px}p\{margin:0 0 18px;color:#94a3b8}canvas\{display:block;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.6);margin-bottom:16px\}button\{background:#0ea5e9;color:#fff;border:0;padding:10px 18px;font-size:14px;border-radius:6px;cursor:pointer;font-weight:600;margin-right:8px}button:hover\{background:#0284c7}</style></head>\n<body><h1>lone-lodge — pure Orion in the browser</h1>\n<p>One wasm module. Two scenes. Strings, Veil, Atlas — all running.</p>\n<canvas id=\"c\" width=\"480\" height=\"320\"></canvas>\n<div><button id=\"static\">Veil scene</button><button id=\"animate\">Atlas world</button></div>\n<script src=\"main.js\"></script></body></html>\n"

fn page_runtime() -> Text:
    "const canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nlet currentFill = '#000';\nlet currentStroke = '#000';\nlet memory;\nfunction readUtf8(ptr, len) \{\n  const bytes = new Uint8Array(memory.buffer, ptr, len);\n  return new TextDecoder('utf-8').decode(bytes);\n\}\nconst env = \{\n  set_fill: (r,g,b) => \{ currentFill = `rgb($\{r\},$\{g\},$\{b\})`; ctx.fillStyle = currentFill; \},\n  fill_rect: (x,y,w,h) => \{ ctx.fillStyle = currentFill; ctx.fillRect(x,y,w,h); \},\n  set_stroke: (r,g,b) => \{ currentStroke = `rgb($\{r\},$\{g\},$\{b\})`; ctx.strokeStyle = currentStroke; \},\n  stroke_rect: (x,y,w,h) => \{ ctx.strokeStyle = currentStroke; ctx.strokeRect(x,y,w,h); \},\n  draw_text: (x,y,ptr,len) => \{ ctx.fillStyle = '#fff'; ctx.font = '16px system-ui'; ctx.fillText(readUtf8(ptr,len), x, y); \}\n\};\n\nlet running = false;\nlet currentTick = 0;\nlet renderScene, renderFrame;\n\nfunction stop() \{ running = false; \}\nfunction startAnimation() \{ if (running) return; running = true; (function loop()\{ if(!running) return; renderFrame(currentTick++); requestAnimationFrame(loop); \})(); \}\n\nasync function boot() \{\n  try \{\n    const \{ instance \} = await WebAssembly.instantiateStreaming(fetch('lone_lodge.wasm'), \{ env \});\n    memory = instance.exports.memory;\n    renderScene = instance.exports.render;\n    renderFrame = instance.exports.render_frame;\n    document.getElementById('static').onclick = () => \{ stop(); renderScene(); \};\n    document.getElementById('animate').onclick = () => \{ stop(); requestAnimationFrame(startAnimation); \};\n    renderScene();\n  \} catch (e) \{\n    document.body.append(document.createTextNode('boot error: ' + e));\n  \}\n\}\nboot();\n"
