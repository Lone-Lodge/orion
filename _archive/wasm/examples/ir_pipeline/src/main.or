use orion_emit_wasm
use orion_to_wasm
use io
use fs

# IR → wasm pipeline demo. Author functions as IRFn values, compile
# them, ship a single .wasm with all of them exported. This is what a
# real `orion build --target wasm32` does at the next milestone.

fn main() -> int:
    print_line("ir → wasm pipeline demo")
    mkdir_all("dist")

    # add(a, b) = a + b   (params at local indices 0 and 1)
    add_fn_decl = IRFn{name: "add", param_count: 2, body: EAdd(0, 1)}
    # sub(a, b) = a - b
    sub_fn_decl = IRFn{name: "sub", param_count: 2, body: ESub(0, 1)}
    # square(x) = x * x   (local 0 used twice)
    square_decl = IRFn{name: "square", param_count: 1, body: EMul(0, 0)}
    # forty_two() = 42
    const_decl = IRFn{name: "forty_two", param_count: 0, body: EConst(42)}

    module = new_module()
    m1 = add_fn(module, compile_fn(add_fn_decl))
    m2 = add_fn(m1, compile_fn(sub_fn_decl))
    m3 = add_fn(m2, compile_fn(square_decl))
    m4 = add_fn(m3, compile_fn(const_decl))

    wasm_bytes = encode_module(m4)
    write_wasm("dist/pipeline.wasm", wasm_bytes)
    print_line("wrote dist/pipeline.wasm (4 fns from IR)")
    0
