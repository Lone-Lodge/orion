{
	"define": {
		"prefix": "def",
		"body": [
			"define ${1:name}(${2:value}: ${3:number}) -> ${4:number}:",
			"\t${0:body}"
		],
		"description": "A function with a body block."
	},
	"define-expression": {
		"prefix": "defe",
		"body": [
			"define ${1:name}(${2:value}: ${3:number}) -> ${4:number} = ${0:expression}"
		],
		"description": "A single-expression function."
	},
	"public-define": {
		"prefix": "pdef",
		"body": [
			"public define ${1:name}(${2:value}: ${3:number}) -> ${4:number}:",
			"\t${0:body}"
		],
		"description": "A public function - visible to users of this orb."
	},
	"external-define": {
		"prefix": "edef",
		"body": [
			"external define ${1:name}(${2:value}: ${3:number}) -> ${4:number}"
		],
		"description": "An external function the linked C runtime provides."
	},
	"type-record": {
		"prefix": "type",
		"body": [
			"public type ${1:Name}: ${2:field}: ${3:number}, ${4:other}: ${5:text}"
		],
		"description": "A record type (product)."
	},
	"type-choice": {
		"prefix": "enum",
		"body": [
			"public type ${1:Name}:",
			"\t${2:First}(${3:number})",
			"\t${4:Second}"
		],
		"description": "A choice type (sum) - match with choose."
	},
	"choose": {
		"prefix": "choose",
		"body": [
			"choose ${1:value}:",
			"\t${2:First}(${3:payload}) -> ${4:result}",
			"\t${5:Second} -> ${0:other}"
		],
		"description": "Pattern match over a choice type."
	},
	"loop-in": {
		"prefix": "loopin",
		"body": [
			"loop ${1:item} in ${2:items}:",
			"\t${0:body}"
		],
		"description": "Loop over a list's elements."
	},
	"loop-until": {
		"prefix": "loopu",
		"body": [
			"loop ${1:index} in 0 until ${2:count}:",
			"\t${0:body}"
		],
		"description": "Counted loop, end exclusive."
	},
	"test": {
		"prefix": "test",
		"body": [
			"define test_${1:what}():",
			"\trequire ${0:claim}"
		],
		"description": "A test - `orbit test` finds and runs every test_*."
	},
	"game": {
		"prefix": "game",
		"body": [
			"use core",
			"use ori_scene",
			"use raster",
			"use game",
			"use num",
			"",
			"define ${1:name}_seeds() -> list of Entry:",
			"\t[spawn(\"${2:thing}\", [field(\"x\", ${3:0})])]",
			"",
			"define ${1:name}_rules(world: World, intents: list of Intent) -> list of Entry:",
			"\t[${0:entries}]",
			"",
			"define ${1:name}_view(world: World) -> Scene:",
			"\tScene{camera: Camera{eye: v3(0.0, 0.0, 0.0), yaw: 0.0, pitch: 0.0, fov: 1.05}, triangles: [], sky: 0x14161A}",
			"",
			"define main():",
			"\tfinal_tick = run_game(Game{title: \"${1:name}\", width: 640, height: 360, seeds: ${1:name}_seeds(), bindings: [], rules: ${1:name}_rules, view: ${1:name}_view})"
		],
		"description": "A whole game on the shell: seeds + rules + view."
	},
	"binding": {
		"prefix": "bind",
		"body": [
			"bind(\"${1:w}\", \"${2:intent_name}\", ${3:1})"
		],
		"description": "A key binding - keys go by the name on their cap."
	}
}
