# orbit - Orion project tool, self-hosted. Compiled by orion.exe, linked
# with orion_cli.c + orion_rt.c. No lodge-orion, no interpreter.
use os
use text

# build/run/test are pure Orion (see cli_build below): they compile with
# orion.exe + clang and run the native exe. No Rust interpreter left.
external define orion_console_color() -> int
external define host_self_exe() -> text
external define host_subdirs(dir: text) -> text

# Self-locating toolchain: orbit and orion.exe ship together in <root>/dist,
# with the runtime at <root>/runtime. Derive both from orbit's OWN path so a
# project never has to hard-code the engine location - the workspace can sit
# in any folder layout. Falls back to the legacy sibling default when the
# self-path is unavailable (or a toml can still override explicitly).
define self_dist_dir() -> text:
    exe = host_self_exe()
    if len(exe) == 0 then "" else path_parent(exe)

define default_compiler() -> text:
    d = self_dist_dir()
    if len(d) > 0 and file_exists(d + "/orion.exe") then d + "/orion.exe"
    else "../orion/dist/orion.exe"

define default_runtime() -> text:
    d = self_dist_dir()
    if len(d) > 0 and is_dir(path_parent(d) + "/runtime") then path_parent(d) + "/runtime"
    else "../orion/runtime"

define default_orbs() -> text:
    d = self_dist_dir()
    if len(d) > 0 and is_dir(path_parent(d) + "/orbs") then path_parent(d) + "/orbs"
    else "../orion/orbs"

# `dir/hello.or` -> `dir/hello`. Keeps the directory, so building a file that
# is not in the working directory puts the exe beside its source rather than
# underfoot.
define path_drop_or(p: text) -> text:
    bs = bytes_from_text(p)
    n = len(bs)
    if n > 3 and at(bs, n - 3) == 46 and at(bs, n - 2) == 111 and at(bs, n - 1) == 114:
        bytes_to_text(bytes_slice(bs, 0, n - 3))
    else:
        p

# ---------- console style (ANSI, tty-gated) ----------

define sty(code: text, s: text) -> text:
    if orion_console_color() == 1:
        e = bytes_to_text(append([], 27))
        "{e}[{code}m{s}{e}[0m"
    else:
        s

define c_dim(s: text) -> text:
    sty("2", s)

define c_bold(s: text) -> text:
    sty("1", s)

define c_green(s: text) -> text:
    sty("32", s)

define c_red(s: text) -> text:
    sty("31;1", s)

# ---------- args helpers ----------

define args_after(start_index: int) -> [text]:
    total = arg_count()
    edit collected = []
    loop index in start_index..<total:
        collected = append(collected, arg(index))
    collected

# arg(0) is the executable path, arg(1) is the verb, arg(2)+ are the rest.
define verb() -> text:
    if arg_count() < 2 then "" else arg(1)

define first_param() -> text:
    if arg_count() < 3 then "" else arg(2)

define second_param() -> text:
    if arg_count() < 4 then "" else arg(3)

define nb_int(t: text, fallback: int) -> int:
    if t == "" then fallback else int_from_text(t)

# ---------- usage / die ----------

define usage():
    title = c_bold("orbit")
    subtitle = c_dim("Orion's project tool")
    eprint("{title}  {subtitle}")
    eprint("usage: orbit <command> [file.or] ...")
    eprint("")
    # The four a newcomer needs, before the fourteen they do not. This list
    # used to open with `dev`, `shot`, `soak` and `facts`, which answer
    # questions nobody has on their first day, while the single-file path was
    # not here at all -- it did not exist.
    eprint(c_bold("  getting started"))
    eprint("  run [file.or] [args...]     " + c_dim("compile and run. `orbit run hello.or` needs no project"))
    eprint("  debug [file.or] [args...]   " + c_dim("run with the call trail: crashes, traps and breakpoint() say how you got there"))
    eprint("  build [file.or]             " + c_dim("compile and link to an exe beside the source"))
    eprint("  new <name>                  " + c_dim("scaffold a project"))
    eprint("  test                        " + c_dim("run the project's tests"))
    eprint("  add <orb>                   " + c_dim("add a library to Orbit.toml"))
    eprint("  get                         " + c_dim("fetch [deps] git packages into orbs_pkg/, pinned by Orbit.lock"))
    eprint("  update [name]               " + c_dim("refetch package(s) at their ref's newest commit, move the lock"))
    eprint("  fmt                         " + c_dim("format the sources in place"))
    eprint("  package                     " + c_dim("a shippable dist/<name>/ (exe + assets, no console) and a zip of it"))
    eprint("")
    eprint(c_bold("  projects and games"))
    eprint("  dev [dev|bench|off]         " + c_dim("build fresh + reference-check + launch (the one command)"))
    eprint("  shot [out.bmp]              " + c_dim("headless one-frame render to a BMP (no window)"))
    eprint("  native [gpu|ship]           " + c_dim("compile + link a native exe into build/"))
    eprint("  play [dev|bench|off|interp] " + c_dim("build + run (interp = interpreter loop)"))
    eprint("  soak [ticks] [seed]         " + c_dim("headless chaos session with invariants"))
    eprint("  facts [filter]              " + c_dim("effect inference per rule"))
    eprint("  why <symbol>                " + c_dim("backward causal chain to a resource"))
    eprint("  affects <symbol>            " + c_dim("forward ripple a resource causes"))
    eprint("  schedule                    " + c_dim("hazard-free parallel batches"))
    eprint("  liveness                    " + c_dim("dead-write audit"))
    eprint("  doc [filter]                " + c_dim("rules' behavior, queryable, from facts"))
    eprint("  bisect <stem>               " + c_dim("replay-diff: name the rule a change forks"))
    exit_with(2)

define die(message: text):
    eprint(c_red(message))
    exit_with(1)

# ---------- list helpers (the builtin `contains` is text-only) ----------

define list_contains(haystack: [text], needle: text) -> truth:
    total = len(haystack)
    edit found = false
    loop index in 0..<total:
        if at(haystack, index) == needle:
            found = true
    found

# ---------- new ----------

# Find a template tree by name anywhere in the workspace, e.g. `app` ->
# `./../atlas/templates/app`. Orbit knows nothing about atlas: it looks
# for a `templates/<kind>` dir the same way it looks for `orbs/`, so an
# engine ships its own project shape and orion stays generic.
define scan_template_dirs(dir: text, depth: int, acc: [text]) -> [text]:
    if depth > 3:
        return acc
    subs = split(host_subdirs(dir), "\n")
    edit out = acc
    loop i in 0..<len(subs):
        name = at(subs, i)
        if len(name) > 0 and not scan_noise(name):
            child = dir + "/" + name
            if name == "templates":
                if not list_contains(out, child):
                    out = append(out, child)
            else:
                out = scan_template_dirs(child, depth + 1, out)
    out

define find_template(kind: text) -> text:
    root = find_workspace_root()
    if len(root) == 0:
        return ""
    dirs = scan_template_dirs(root, 0, [])
    loop i in 0..<len(dirs):
        candidate = at(dirs, i) + "/" + kind
        if is_dir(candidate):
            return candidate
    ""

# Copy a template tree, substituting `__NAME__` in both file CONTENTS and
# file NAMES (so `__NAME__.toml` becomes `<name>.toml`).
# Flat structure (no if/else nested in the for) dodges the same
# nested-if-in-for parser bug fmt_walk works around.
define copy_template(src_dir: text, dst_dir: text, name: text, packages: text):
    mkdir_all(dst_dir)
    # Files: list_dir. Directories: host_subdirs - the same split
    # scan_orb_dirs relies on, since list_dir does not report subdirs.
    entries = list_dir(src_dir)
    entry_count = len(entries)
    loop index in 0..<entry_count:
        entry = at(entries, index)
        src = path_join(src_dir, entry)
        dst = path_join(dst_dir, replace(entry, "__NAME__", name))
        if not is_dir(src):
            copy_template_file(src, dst, name, packages)
    subs = split(host_subdirs(src_dir), "\n")
    sub_count = len(subs)
    loop sub_index in 0..<sub_count:
        sub = at(subs, sub_index)
        if len(sub) > 0:
            copy_template(src_dir + "/" + sub, path_join(dst_dir, replace(sub, "__NAME__", name)), name, packages)

define copy_template_file(src: text, dst: text, name: text, packages: text):
    body = read_file(src)
    with_name = replace(body, "__NAME__", name)
    write_file(dst, replace(with_name, "__PACKAGES__", packages))

# How many `../` it takes to climb from the new project back to the
# workspace root, so `packages` resolves wherever the project is made.
define packages_path() -> text:
    root = find_workspace_root()
    if len(root) == 0:
        return "../atlas/packages"
    # root is ".", "./..", "./../.." … and the project sits one level
    # deeper than the cwd, so prepend one more hop. Trim the leading "./"
    # so the common case reads "../atlas/packages", not ".././atlas/…".
    if root == ".":
        "../atlas/packages"
    else:
        "../" + replace(root, "./", "") + "/atlas/packages"

define cmd_new_app(name: text):
    template = find_template("app")
    if template == "":
        die("orbit: no `templates/app` found in this workspace - is the engine present?")
    copy_template(template, name, name, packages_path())
    print_line("created `" + name + "` (atlas app)")
    print_line("  " + name + ".toml          window + config")
    print_line("  features/Fire/        one slice: state + rules + view")
    print_line("  gates/smoke/          a headless proof")
    print_line("")
    print_line("An app is all declarative - no src/, no .or. The folder layout is")
    print_line("YOURS: any .astra at any depth is a bundle and its path is its")
    print_line("identity, so features are folders, not filename prefixes. The")
    print_line("engine asks only that a bundle holds a TREE or RULES, never both.")
    print_line("Drop a .ttf in assets/fonts/ or nothing renders.")
    print_line("")
    print_line("next:  cd " + name + " && orbit dev")

define cmd_new():
    name = first_param()
    if name == "":
        die("usage: orbit new <name> [app]")
    if is_dir(name) or is_file(name):
        die("orbit: `" + name + "` already exists")
    if second_param() == "app":
        cmd_new_app(name)
    else:
        cmd_new_orb(name)

define cmd_new_orb(name: text):
    mkdir_all(name + "/src")
    toml_body = "[package]\nname = \"" + name + "\"\nversion = \"0.0.1\"\n\n[orbs]\n"
    write_file(name + "/Orbit.toml", toml_body)
    main_body = "fn add(left: int, right: int) -> int = left + right\n\n# `orbit test` runs functions named test_*.\nfn test_add():\n    require add(2, 3) == 5\n"
    write_file(name + "/src/main.or", main_body)
    print_line("created `" + name + "`")
    print_line("  " + name + "/Orbit.toml")
    print_line("  " + name + "/src/main.or")
    print_line("")
    print_line("next:  cd " + name + " && orbit test")

# ---------- add ----------

# Insert `<orb_name> = "stdlib"` under the [orbs] section. If the section
# doesn't exist we append one - matches what the old Rust impl did.
define insert_orb_line(existing: text, orb_name: text) -> text:
    new_line = orb_name + " = \"stdlib\"\n"
    if contains(existing, "[orbs]"):
        # Append after the [orbs] marker - simple text manipulation, no
        # full TOML round-trip needed for this case.
        existing + new_line
    else:
        existing + "\n[orbs]\n" + new_line

define cmd_add():
    orb_name = first_param()
    if orb_name == "":
        die("usage: orbit add <orb>")
    known = __os_orbit_stdlib_orbs()
    if not list_contains(known, orb_name):
        die("orbit: unknown orb `" + orb_name + "`")
    if not file_exists("Orbit.toml"):
        die("orbit: no Orbit.toml in this directory - run `orbit new` first")
    existing = read_file("Orbit.toml")
    # Crude "already there" check - looks for `<name> =` after a newline.
    needle = "\n" + orb_name + " ="
    if contains(existing, needle):
        print_line(orb_name + ": already an orb")
    else:
        updated = insert_orb_line(existing, orb_name)
        write_file("Orbit.toml", updated)
        print_line("added `" + orb_name + "` to Orbit.toml")

# ---------- build / run / test (delegate to the Rust runtime) ----------

define resolve_path() -> text:
    candidate = first_param()
    edit path = candidate
    if candidate == "":
        path = "src/main.or"
        # Zero-glue projects have no src/main.or - synthesize the
        # entry here too, so check/build/test match native/play.
        if not file_exists("src/main.or") and file_exists("Orbit.toml"):
            lines = nb_lines(read_file("Orbit.toml"))
            path = entry_path(nb_setting(lines, "name", "game"))
    path

define cmd_build():
    path = resolve_path()
    exe = cli_build(path)
    if exe == "":
        exit_with(1)
    else:
        # Say what was produced and where. "built with no errors" left you to
        # guess the filename, which for a single file is the one thing you
        # actually wanted to know.
        print_line(c_bold(exe) + " " + c_green("ok"))

define cmd_run():
    # `orbit run [file.or] [fn] [args...]` - file defaults to src/main.or,
    # fn defaults to main. Bare `orbit run` in a project dir Just Works.
    second = first_param()
    has_path = ends_with(second, ".or")
    path = if has_path then second else "src/main.or"
    fname_index = if has_path then 3 else 2
    fname = if arg_count() <= fname_index then "main" else arg(fname_index)
    rest = args_after(fname_index + 1)
    exit_with(__os_orbit_run(path, fname, rest))

# `orbit debug [file.or] [fn] [args...]` - exactly `orbit run`, but the build
# carries the call trail: every define's entry is recorded (last 64 kept), and
# a crash, a require/index trap, or a breakpoint() in the source prints them
# newest-first. `breakpoint()` also pauses on a terminal (Enter continues,
# q quits); piped it reports and continues, so gates never hang.
define cmd_debug():
    slot_set("orbit:trace", 1)
    cmd_run()

# ---------- package ----------
# `orbit package` - what you hand to someone else. Building gives you an exe
# that only runs where it was built: its assets are found relative to the
# working directory, and it opens a console window nobody asked for. This
# gives you a folder that runs anywhere, and a zip of it:
#
#     dist/folio/folio.exe + dist/folio/ui/…   ->   dist/folio-0.1.0-win.zip
#
# The app declares what ships beside the exe in Orbit.toml:
#
#     [package]
#     version = "0.1.0"
#     assets  = "ui"          # space-separated, project-relative
#
# and reads those files through the app orb's `asset()`, which looks beside
# the exe first. Nothing else changes between development and release.

define copy_tree(src: text, dst: text):
    mkdir_all(dst)
    entries = list_dir(src)
    loop index in 0..<len(entries):
        entry = at(entries, index)
        if len(entry) > 0:
            file_copy_or_die(path_join(src, entry), path_join(dst, entry))
    subs = split(host_subdirs(src), "\n")
    loop sub_index in 0..<len(subs):
        sub = at(subs, sub_index)
        if len(sub) > 0:
            copy_tree(src + "/" + sub, path_join(dst, sub))

define file_copy_or_die(src: text, dst: text):
    if copy_file(src, dst) != 0:
        die("orbit: could not copy `" + src + "`")

define os_tag() -> text:
    if os_kind() == 0 then "win" else if os_kind() == 2 then "macos" else "linux"

# `icon = "assets/app.ico"` becomes a linked resource. llvm-rc ships beside
# clang, so if we can compile the program we can compile this.
define build_icon(icon: text) -> text:
    if icon == "" or os_kind() != 0:
        return ""
    if not file_exists(icon):
        die("orbit: no such icon `" + icon + "`")
    rc_path = "build/icon.rc"
    res_path = "build/icon.res"
    write_file(rc_path, "1 ICON \"" + replace(icon, "\\", "/") + "\"\n")
    rc_tool = path_parent(nb_clang()) + "/llvm-rc.exe"
    if not file_exists(rc_tool):
        print_line(c_dim("(no llvm-rc beside clang - the exe keeps the default icon)"))
        return ""
    if run_command_quiet(rc_tool, ["/fo", res_path, rc_path]) != 0:
        print_line(c_dim("(llvm-rc could not compile the icon - keeping the default)"))
        return ""
    res_path

define cmd_package():
    if not file_exists("Orbit.toml"):
        die("orbit: no Orbit.toml here - `package` works on a project")
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "app")
    version = nb_setting(lines, "version", "0.0.0")
    assets = nb_setting(lines, "assets", "")
    out = "dist/" + name
    remove_tree(out)
    mkdir_all(out)
    mkdir_all("build")
    res = build_icon(nb_setting(lines, "icon", ""))
    if res != "":
        slot_set("orbit:res", res)
    # No console window for a shipped app - see cli_build.
    slot_set("orbit:windowless", 1)
    built = cli_build(resolve_path())
    if built == "":
        exit_with(1)
    shipped = out + "/" + name + (if os_kind() == 0 then ".exe" else "")
    file_copy_or_die(built, shipped)
    # The console-less build must not linger in build/ pretending to be the
    # one `orbit build` makes - running that from a terminal would print
    # nothing and look broken.
    remove_file(built)
    parts = split(assets, " ")
    loop a_index in 0..<len(parts):
        asset_path = at(parts, a_index)
        if len(asset_path) > 0:
            if is_dir(asset_path):
                copy_tree(asset_path, path_join(out, asset_path))
            else if is_file(asset_path):
                file_copy_or_die(asset_path, path_join(out, asset_path))
            else:
                die("orbit: no such asset `" + asset_path + "`")
    write_installer(name, out)
    print_line(c_bold(shipped) + " " + c_green("ok"))
    # The archive is a convenience, not the deliverable: if the system has no
    # tar the folder above is still what ships, so say so and stop there.
    zipped = pack_archive(name, version)
    if len(zipped) > 0:
        print_line(c_bold(zipped) + " " + c_green("ok"))
    else:
        print_line(c_dim("(no archive - tar not available; ship the folder)"))

# An installed app is a folder somewhere permanent plus a shortcut in the
# Start menu. That is all Windows means by "installed", so that is all this
# does - and uninstall is deleting the folder, which the script says out loud.
define write_installer(name: text, out: text):
    if os_kind() != 0:
        return
    edit s = "@echo off\r\n"
    s = s + "setlocal\r\n"
    s = s + "set \"DEST=%LOCALAPPDATA%\\Programs\\" + name + "\"\r\n"
    s = s + "echo Installing " + name + " to \"%DEST%\"\r\n"
    s = s + "robocopy \"%~dp0.\" \"%DEST%\" /e /njh /njs /ndl /nc /ns /nfl >nul\r\n"
    s = s + "del \"%DEST%\\install.cmd\" >nul 2>&1\r\n"
    s = s + "powershell -NoProfile -Command \"$s=(New-Object -ComObject WScript.Shell).CreateShortcut([Environment]::GetFolderPath('Programs')+'\\" + name + ".lnk'); $s.TargetPath='%DEST%\\" + name + ".exe'; $s.WorkingDirectory='%DEST%'; $s.Save()\"\r\n"
    s = s + "echo Done. " + name + " is in the Start menu. To uninstall, delete \"%DEST%\".\r\n"
    s = s + "pause\r\n"
    wrote = write_file(out + "/install.cmd", s)

define pack_archive(name: text, version: text) -> text:
    stem = "dist/" + name + "-" + version + "-" + os_tag()
    # Windows ships bsdtar, which writes a real zip from -a; elsewhere the
    # native format is a tar.gz. Full path on Windows: a GNU tar earlier in
    # PATH does not understand -a.
    if os_kind() == 0:
        zip_path = stem + ".zip"
        remove_file(zip_path)
        if run_command_quiet("C:/Windows/System32/tar.exe", ["-a", "-c", "-f", zip_path, "-C", "dist", name]) != 0:
            return ""
        return zip_path
    tgz = stem + ".tar.gz"
    remove_file(tgz)
    if run_command_quiet("tar", ["-c", "-z", "-f", tgz, "-C", "dist", name]) != 0:
        return ""
    tgz

define cmd_test():
    path = resolve_path()
    failures = __os_orbit_test(path)
    if failures > 0:
        exit_with(1)

# ---------- fmt ----------
#
# Conservative whitespace formatter - doesn't need a real parser.
# Operations: tabs → 4 spaces, trailing whitespace stripped, runs of
# blank lines collapsed to one, file ends with exactly one newline.
# A "real" formatter that rewrites expressions / re-indents blocks
# needs the lexer + parser (step 3-4 of self-hosting).

define fmt_expand_tabs(line_text: text) -> text:
    if contains(line_text, "\t"):
        replace(line_text, "\t", "    ")
    else:
        line_text

define fmt_trim_trailing(line_text: text) -> text:
    bytes = bytes_from_text(line_text)
    byte_count = bytes_length(bytes)
    edit end_index = byte_count
    loop:
        if end_index <= 0:
            break
        last_byte = byte_at(bytes, end_index - 1)
        if last_byte == 32 or last_byte == 9:
            end_index -= 1
        else:
            break
    if end_index == byte_count:
        line_text
    else:
        bytes_to_text(bytes_slice(bytes, 0, end_index))

# Split on "\n" (without LF), normalize each line, then rejoin.
define fmt_normalize(text: text) -> text:
    raw_lines = split(text, "\n")
    line_count = len(raw_lines)
    edit normalized_lines = []
    loop index in 0..<line_count:
        raw_line = at(raw_lines, index)
        without_tabs = fmt_expand_tabs(raw_line)
        stripped = fmt_trim_trailing(without_tabs)
        normalized_lines = append(normalized_lines, stripped)
    # Collapse 2+ consecutive blank lines.
    collapsed = []
    edit output_lines = collapsed
    edit last_was_blank = false
    loop index in 0..<line_count:
        current_line = at(normalized_lines, index)
        is_blank = current_line == ""
        keep = not (is_blank and last_was_blank)
        if keep:
            output_lines = append(output_lines, current_line)
        last_was_blank = is_blank
    # Drop the trailing blank line so join + "\n" produces one final LF.
    final_count = len(output_lines)
    if final_count > 0 and at(output_lines, final_count - 1) == "":
        edit trimmed = []
        loop index in 0..<(final_count - 1):
            trimmed = append(trimmed, at(output_lines, index))
        output_lines = trimmed
    join(output_lines, "\n") + "\n"

# Walk a directory recursively and format every .or file we find.
# Flat structure dodges the nested-if-in-for parser bug (see
# orion_nesting_bug memory).
define fmt_walk(directory: text):
    entries = list_dir(directory)
    entry_count = len(entries)
    loop index in 0..<entry_count:
        entry_name = at(entries, index)
        full_path = path_join(directory, entry_name)
        is_directory_entry = is_dir(full_path)
        # Skip target/ - generated output we don't want to rewrite.
        should_recurse = is_directory_entry and entry_name != "target"
        should_format = (not is_directory_entry) and ends_with(entry_name, ".or")
        if should_recurse:
            fmt_walk(full_path)
        if should_format:
            fmt_one_file(full_path)

define fmt_one_file(file_path: text):
    original = read_file(file_path)
    normalized = fmt_normalize(original)
    if normalized == original:
        # No-op file - don't even rewrite. Keeps mtimes stable.
        print_line("  unchanged " + file_path)
    else:
        write_file(file_path, normalized)
        print_line("  formatted " + file_path)

define cmd_fmt():
    # Optional path argument; default is the current project.
    target = first_param()
    start_dir = if target == "" then "." else target
    if is_file(start_dir):
        fmt_one_file(start_dir)
    else:
        if is_dir(start_dir):
            fmt_walk(start_dir)
        else:
            die("orbit fmt: `" + start_dir + "` not found")

# ---------- native build & play ----------
#
# `orbit native [gpu|ship]` compiles the project with the self-hosted
# orion compiler and links with clang. `orbit play [mode]` builds and
# runs it; mode `interp` routes to the interpreter loop, anything else
# (dev/bench/off) is handed to the game as its launch mode.
# Toolchain paths come from Orbit.toml's optional [native] section:
#   compiler = "../orion/dist/orion.exe"
#   runtime  = "../orion/runtime"
# Orb search dirs derive from the [orbs] path deps; each parent dir's
# orbs_native sibling goes first so native backends win name clashes.

define nb_lines(text: text) -> [text]:
    split(text, "\n")

define nb_quoted(line: text) -> text:
    pieces = split(line, "\"")
    if len(pieces) >= 2 then at(pieces, 1) else ""

define nb_setting(lines: [text], key: text, fallback: text) -> text:
    total = len(lines)
    edit found = fallback
    edit taken = false
    loop index in 0..<total:
        line = trim(at(lines, index))
        if not taken and starts_with(line, key + " ="):
            found = nb_quoted(line)
            taken = true
    found

# The `path:` orb dirs a toml names, each resolved against `base` (the dir
# of the toml being read) so nested tomls compose - a dep written relative
# to its own orb becomes relative to the project root as we descend. `base`
# "" means the current project (paths already root-relative).
define nb_dep_dirs(lines: [text], base: text) -> [text]:
    total = len(lines)
    edit out = []
    loop index in 0..<total:
        line = at(lines, index)
        if contains(line, "\"path:"):
            rel = replace(nb_quoted(line), "path:", "")
            dir = if base == "" then rel else base + "/" + rel
            if not list_contains(out, dir):
                out = append(out, dir)
        if contains(line, "\"git:"):
            # A fetched package lives in the PROJECT's orbs_pkg/, wherever
            # the toml naming it sits (transitive git deps are hoisted flat
            # by `orbit get`) - so this is cwd-relative, not base-relative.
            gdir = "orbs_pkg/" + dep_key(line)
            if not list_contains(out, gdir):
                out = append(out, gdir)
    out

# ---------- packages: git deps fetched into orbs_pkg/ ----------
#
# A dependency line can name a REMOTE orb:
#
#     [deps]
#     weblib = "git:https://github.com/x/weblib"        # default branch
#     maths  = "git:https://github.com/x/maths@v1.2"    # a tag or a branch
#
# A package repo IS one orb: lib.or at its root, plus its own Orbit.toml
# when it has dependencies of its own. `orbit get` clones each dep into
# orbs_pkg/<name>/ and pins the exact commit in Orbit.lock, so the next
# `orbit get` - on any machine - checks out the same code. `orbit update
# [name]` refetches at the ref's newest commit and rewrites the lock.
# Transitive git deps are fetched FLAT into the same orbs_pkg/ (first name
# wins), which is also how they resolve at build time. No registry, no
# version solving: a name, a repo, a ref, a pinned commit.

define dep_key(line: text) -> text:
    trim(at(split(line, "="), 0))

# "url@ref" -> [url, ref]. The separator is the LAST `@` after the last
# `/`, so ssh remotes (git@host:...) keep their `@`.
define spec_split_ref(spec: text) -> [text]:
    bs = bytes_from_text(spec)
    n = len(bs)
    edit last_slash = 0 - 1
    edit cut = 0 - 1
    loop i in 0..<n:
        if at(bs, i) == 47:
            last_slash = i
    loop j in 0..<n:
        if at(bs, j) == 64 and j > last_slash:
            cut = j
    if cut < 0:
        return [spec, ""]
    [bytes_to_text(bytes_slice(bs, 0, cut)), bytes_to_text(bytes_slice(bs, cut + 1, n))]

# Every git dep in a toml, one "name|url|ref" row each.
define nb_git_deps(lines: [text]) -> [text]:
    total = len(lines)
    edit out = []
    loop index in 0..<total:
        line = at(lines, index)
        if contains(line, "\"git:"):
            spec = replace(nb_quoted(line), "git:", "")
            parts = spec_split_ref(spec)
            out = append(out, dep_key(line) + "|" + at(parts, 0) + "|" + at(parts, 1))
    out

define lock_rows() -> [text]:
    if not file_exists("Orbit.lock"):
        return []
    all_lines = nb_lines(read_file("Orbit.lock"))
    edit out = []
    loop i in 0..<len(all_lines):
        line = trim(at(all_lines, i))
        if line != "" and not starts_with(line, "#"):
            out = append(out, line)
    out

# The pinned commit for `name`, or "" when the lock has none.
define lock_commit(name: text) -> text:
    rows = lock_rows()
    edit found = ""
    loop i in 0..<len(rows):
        parts = split(at(rows, i), " ")
        if len(parts) >= 2 and at(parts, 0) == name:
            found = at(parts, 1)
    found

define pkg_head(dir: text) -> text:
    trim(capture_stdout("git", ["-C", dir, "rev-parse", "HEAD"]))

# Fetch one package. An existing dir is left EXACTLY as it is (get never
# moves code under you - that is update's job). A locked commit gets a full
# clone + checkout (the commit may be far behind the ref); an unlocked ref
# gets a shallow clone of just that ref. Returns the checked-out commit,
# "" when git failed.
define pkg_fetch(name: text, url: text, ref: text) -> text:
    dir = "orbs_pkg/" + name
    if is_dir(dir):
        return pkg_head(dir)
    mkdir_all("orbs_pkg")
    locked = lock_commit(name)
    if locked != "":
        if run_command("git", ["clone", "--quiet", url, dir]) != 0:
            return ""
        if run_command("git", ["-C", dir, "-c", "advice.detachedHead=false", "checkout", "--quiet", locked]) != 0:
            return ""
    else:
        edit cargs = ["clone", "--quiet", "--depth", "1"]
        if ref != "":
            cargs = append(cargs, "--branch")
            cargs = append(cargs, ref)
        cargs = append(cargs, url)
        cargs = append(cargs, dir)
        if run_command("git", cargs) != 0:
            return ""
    pkg_head(dir)

define short_commit(commit: text) -> text:
    bs = bytes_from_text(commit)
    if len(bs) > 9 then bytes_to_text(bytes_slice(bs, 0, 9)) else commit

define cmd_get():
    if not file_exists("Orbit.toml"):
        die("orbit: no Orbit.toml in this directory")
    edit queue = nb_git_deps(nb_lines(read_file("Orbit.toml")))
    if len(queue) == 0:
        print_line("orbit: no git deps in Orbit.toml")
        return
    edit seen = []
    edit lock_out = ["# orbit lock - the exact commit of every fetched package."]
    lock_out = append(lock_out, "# `orbit get` reproduces these; `orbit update [name]` moves them.")
    edit failures = 0
    edit idx = 0
    loop:
        if idx >= len(queue):
            break
        parts = split(at(queue, idx), "|")
        idx = idx + 1
        name = at(parts, 0)
        url = at(parts, 1)
        ref = at(parts, 2)
        if not list_contains(seen, name):
            seen = append(seen, name)
            commit = pkg_fetch(name, url, ref)
            if commit == "":
                eprint(c_red("orbit: could not fetch `" + name + "` from " + url))
                failures = failures + 1
            else:
                shown = if ref == "" then url else url + "@" + ref
                print_line("  " + name + " @ " + short_commit(commit) + "  " + c_dim(shown))
                lock_out = append(lock_out, name + " " + commit + " " + shown)
                sub_toml = "orbs_pkg/" + name + "/Orbit.toml"
                if file_exists(sub_toml):
                    more = nb_git_deps(nb_lines(read_file(sub_toml)))
                    loop m_index in 0..<len(more):
                        queue = append(queue, at(more, m_index))
    write_file("Orbit.lock", join(lock_out, "\n") + "\n")
    if failures > 0:
        exit_with(1)

# Drop the chosen package dirs and their lock rows, then get fresh - the
# refetch lands on the ref's newest commit and the lock is rewritten.
define cmd_update():
    target = first_param()
    if not file_exists("Orbit.toml"):
        die("orbit: no Orbit.toml in this directory")
    rows = lock_rows()
    edit kept = ["# orbit lock - the exact commit of every fetched package."]
    kept = append(kept, "# `orbit get` reproduces these; `orbit update [name]` moves them.")
    loop i in 0..<len(rows):
        parts = split(at(rows, i), " ")
        name = at(parts, 0)
        if target == "" or name == target:
            fs_junk = remove_tree("orbs_pkg/" + name)
        else:
            kept = append(kept, at(rows, i))
    write_file("Orbit.lock", join(kept, "\n") + "\n")
    cmd_get()

# Collect an orb's dir plus every orb reachable through its own Orbit.toml,
# transitively. `acc` doubles as the visited set (a repeated dir short-
# circuits, guarding against dependency cycles).
define nb_expand_orb(orb_dir: text, acc: [text]) -> [text]:
    if list_contains(acc, orb_dir):
        acc
    else:
        edit out = append(acc, orb_dir)
        toml = orb_dir + "/Orbit.toml"
        if file_exists(toml):
            deps = nb_dep_dirs(nb_lines(read_file(toml)), orb_dir)
            dep_total = len(deps)
            loop d_index in 0..<dep_total:
                out = nb_expand_orb(at(deps, d_index), out)
        out

# Orb search dirs for the native compiler. It resolves `use X` by scanning
# these for X/lib.or, so a LIBRARY orb's own path deps must contribute too:
# atlas_ecs `use log` has to find the log orb via atlas_ecs's Orbit.toml,
# without the consuming executable re-declaring log. So expand the project's
# direct deps transitively, then map each orb dir to its parent (the search
# root) plus that root's orbs_native sibling (native backends win clashes).
# Walk up (relatively) from the project dir to the workspace root - the dir
# holding a `.orbit` marker. Returns the relative prefix (".", "./..",
# "./../.." …) or "" if none. This is what frees the layout: drop `.orbit`
# at the root and every project below it resolves orbs by NAME, wherever
# each one sits.
define find_workspace_root() -> text:
    edit rel = "."
    edit depth = 0
    loop:
        if depth > 8:
            break
        if file_exists(rel + "/.orbit"):
            return rel
        rel = rel + "/.."
        depth = depth + 1
    ""

define scan_noise(name: text) -> truth:
    name == "build" or name == "dist" or name == "target" or name == ".git" or name == "node_modules" or name == "assets" or name == "saves" or name == "docs" or name == "examples"

# Every `orbs` / `orbs_native` directory under `root` (depth-bounded) - the
# exact search dirs the compiler needs to resolve `use X` by name, so a
# project's [orbs] can list names with no paths.
define scan_orb_dirs(dir: text, depth: int, acc: [text]) -> [text]:
    if depth > 3:
        return acc
    subs = split(host_subdirs(dir), "\n")
    edit out = acc
    loop i in 0..<len(subs):
        name = at(subs, i)
        if len(name) > 0 and not scan_noise(name):
            child = dir + "/" + name
            if name == "orbs" or name == "orbs_native":
                if not list_contains(out, child):
                    out = append(out, child)
            else:
                out = scan_orb_dirs(child, depth + 1, out)
    out

define nb_orb_dirs(lines: [text]) -> [text]:
    direct = nb_dep_dirs(lines, "")
    direct_total = len(direct)
    edit all_orbs = []
    loop i in 0..<direct_total:
        all_orbs = nb_expand_orb(at(direct, i), all_orbs)
    edit parents = []
    orb_total = len(all_orbs)
    loop j in 0..<orb_total:
        parent = path_parent(at(all_orbs, j))
        if not list_contains(parents, parent):
            parents = append(parents, parent)
    edit dirs = []
    parent_total = len(parents)
    loop p_index in 0..<parent_total:
        parent = at(parents, p_index)
        native_sibling = path_parent(parent) + "/orbs_native"
        if is_dir(native_sibling) and not list_contains(dirs, native_sibling):
            dirs = append(dirs, native_sibling)
    loop p2_index in 0..<parent_total:
        dirs = append(dirs, at(parents, p2_index))
    # Layout-free resolution: when a `.orbit` workspace root is found, add
    # every orbs dir under it so name-only deps (`atlas_app = "*"`) resolve
    # regardless of where the project or the orbs live. Explicit path: deps
    # above still win; this only ADDS search dirs.
    root = find_workspace_root()
    if len(root) > 0:
        scanned = scan_orb_dirs(root, 0, [])
        # Native backends win name clashes (a game wants orbs_native/atlas_render,
        # not the wgpu orbs/atlas_render), so add every orbs_native search dir
        # BEFORE the plain orbs ones - mirroring the path-based order above.
        loop n_index in 0..<len(scanned):
            nd = at(scanned, n_index)
            if contains(nd, "orbs_native") and not list_contains(dirs, nd):
                dirs = append(dirs, nd)
        loop s_index in 0..<len(scanned):
            sd = at(scanned, s_index)
            if not contains(sd, "orbs_native") and not list_contains(dirs, sd):
                dirs = append(dirs, sd)
    dirs

define nb_clang() -> text:
    # POSIX: clang is on PATH. Windows: prefer PATH, else the default LLVM dir
    # (`where` is a Windows builtin - it doesn't exist on Linux/Mac, so the
    # probe must be Windows-gated or it returns the wrong fallback).
    if os_kind() != 0:
        return "clang"
    if capture_stdout("where", ["clang"]) == "":
        return "C:\\Program Files\\LLVM\\bin\\clang.exe"
    "clang"

# Everything a shipped exe must carry: the toml, every script bundle
# (scripts/ flat or features/<sub>/), the package roots the toml names
# (paths embed EXACTLY as the runtime resolves them, ../ and all),
# and the sounds/ WAVs (byte-embedded; the mixer reads them from the
# manifest when the dir is gone).
define nb_add_astra(joined: text, dir: text) -> text:
    edit out = joined
    if is_dir(dir):
        files = list_dir(dir)
        total = len(files)
        loop index in 0..<total:
            file = at(files, index)
            if ends_with(file, ".astra"):
                out = out + "," + dir + "/" + file
    out

define nb_split_spaces(joined: text) -> [text]:
    pieces = split(joined, " ")
    total = len(pieces)
    edit out = []
    loop index in 0..<total:
        piece = at(pieces, index)
        if piece != "":
            out = append(out, piece)
    out

define nb_ship_files(name: text) -> text:
    edit joined = name + ".toml"
    joined = nb_add_astra(joined, "scripts")
    if is_dir("features"):
        subs = list_dir("features")
        sub_total = len(subs)
        loop s_index in 0..<sub_total:
            sub = at(subs, s_index)
            if is_dir("features/" + sub):
                joined = nb_add_astra(joined, "features/" + sub)
    game_lines = nb_lines(read_file(name + ".toml"))
    pkgs = nb_setting(game_lines, "packages", "")
    if pkgs != "":
        roots = nb_split_spaces(pkgs)
        root_total = len(roots)
        loop r_index in 0..<root_total:
            joined = nb_add_astra(joined, at(roots, r_index))
    if is_dir("sounds"):
        wavs = list_dir("sounds")
        wav_total = len(wavs)
        loop w_index in 0..<wav_total:
            wav = at(wavs, w_index)
            if ends_with(wav, ".wav"):
                joined = joined + ",sounds/" + wav
    joined

# ZERO-GLUE: a game is scripts/ + a toml. When src/main.or is absent,
# orbit synthesizes the entry (project_run with the package name as
# config + prefix). An existing src/main.or wins - custom host glue
# is an opt-in escape hatch, not a requirement.
define entry_path(name: text) -> text:
    if file_exists("src/main.or"):
        "src/main.or"
    else:
        q = bytes_to_text(append([], 34))
        src = "use atlas_project\n\nfn main() -> int:\n    project_run(" + q + name + ".toml" + q + ", " + q + name + ":" + q + ")\n"
        mkdir_all("target")
        write_file("target/main_gen.or", src)
        "target/main_gen.or"

# Platform link config, keyed by target OS (0 = Windows, 1 = Linux, 2 =
# macOS). Windowed builds are HOST-selected: you build ON the platform you
# target (no cross-compile flag - that needs a target sysroot). Adding a
# platform = adding its row here + its *_min.c backends under runtime/. An
# empty c-file set means that platform has no GUI backend yet, and
# build_native_entry stops with a clear message instead of a link error.
define target_name(target: int) -> text:
    if target == 0 then "windows" else if target == 1 then "linux" else "macos"

define platform_c_files(runtime: text, target: int) -> [text]:
    if target == 0:
        [runtime + "/win32_min.c", runtime + "/wasapi_min.c", runtime + "/ogpu_min.c", runtime + "/gdi_min.c", runtime + "/d3d12_min.c"]
    else if target == 1:
        # Linux: X11 window + software renderer in one file (linux_min.c);
        # ogpu_min.c's d3d12 stubs stay weak no-ops so og_init picks software.
        # No audio backend yet. UNVERIFIED until built on a Linux host.
        [runtime + "/linux_min.c", runtime + "/ogpu_min.c"]
    else:
        []

define build_native(variant: text) -> text:
    build_native_entry(variant, "")

# entry_override != "" compiles a custom entry (soak harness) instead
# of the game's own main.
define build_native_entry(variant: text, entry_override: text) -> text:
    if not file_exists("Orbit.toml"):
        die("orbit: no Orbit.toml in this directory")
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    compiler = nb_setting(lines, "compiler", default_compiler())
    runtime = nb_setting(lines, "runtime", default_runtime())
    if not file_exists(compiler):
        die("orbit: native compiler not found at `" + compiler + "` - set [native] compiler in Orbit.toml")
    mkdir_all("build")
    suffix = if variant == "" then "" else "_" + variant
    exe = "build/" + name + suffix + ".exe"
    ll = "build/" + name + ".ll"
    entry = if entry_override == "" then entry_path(name) else entry_override
    edit compile_args = [entry, ll]
    dirs = nb_orb_dirs(lines)
    dir_total = len(dirs)
    loop d_index in 0..<dir_total:
        compile_args = append(compile_args, at(dirs, d_index))
    if run_command(compiler, compile_args) != 0:
        die("orbit: native compile failed")
    # Both renderers always link; ogpu_min.c dispatches at og_init from the
    # game toml's `renderer = auto|gdi|gpu` (default auto). The backend C set
    # is host-selected (platform_c_files) so a Linux/macOS host picks its own
    # once those *_min.c land - no cross-compile flag, you build on-target.
    target = os_kind()
    cfiles = platform_c_files(runtime, target)
    if len(cfiles) == 0:
        die("orbit: no GUI backend for " + target_name(target) + " yet - build on Windows, or add runtime/*_min.c backends for " + target_name(target) + " (see BUILD.md)")
    edit link_args = [ll, runtime + "/orion_rt.c", runtime + "/net_min.c"]
    loop cf_index in 0..<len(cfiles):
        link_args = append(link_args, at(cfiles, cf_index))
    if variant == "ship":
        embed_rc = run_command("powershell", ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", runtime + "/tools/embed_assets.ps1", "-Out", "build/scripts_embed.c", "-Files", nb_ship_files(name)])
        if embed_rc != 0:
            die("orbit: asset embed failed")
        link_args = append(link_args, "build/scripts_embed.c")
        # Icon + version block: a <name>.rc beside the toml compiles
        # via llvm-rc and links in; absent = plain exe, no error.
        if file_exists(name + ".rc"):
            rc_rc = run_command("C:\\Program Files\\LLVM\\bin\\llvm-rc.exe", ["/FO", "build/" + name + ".res", name + ".rc"])
            if rc_rc == 0:
                link_args = append(link_args, "build/" + name + ".res")
            else:
                print_line(c_dim("orbit: llvm-rc failed - shipping without icon"))
    link_args = append(link_args, "-Os")
    # Big stack (Windows default is 1 MB). The render path nests deep -
    # astra eval recursion, render_bundle, the glyph rasterizer, all under
    # the supervisor's setjmp frames - and overflows the 1 MB default (a
    # "writing address 0x0" fault in a function prologue). cli_build already
    # does this for the compiler; the game needs it just as much. Windows
    # only: POSIX raises the stack via ulimit at run time.
    if target == 0:
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "/STACK:67108864")
        # UTF-8 as the process code page - see runtime/orion.manifest for why.
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "-MANIFEST:EMBED")
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "-MANIFESTINPUT:" + runtime + "/orion.manifest")
    link_args = append(link_args, "-o")
    link_args = append(link_args, exe)
    if target == 0:
        # System libs + link map are Windows-specific (the crash filter's
        # module-relative offsets resolve against the .map). POSIX backends
        # add their own libs here when they land.
        link_args = append(link_args, "-luser32")
        link_args = append(link_args, "-lgdi32")
        link_args = append(link_args, "-lole32")
        link_args = append(link_args, "-Wl,/MAP:build/" + name + ".map")
        link_args = append(link_args, "-ld3d12")
        link_args = append(link_args, "-ldxgi")
    if target == 1:
        # Linux windowed build links Xlib. (POSIX raises the stack via ulimit
        # at run time, so no /STACK flag here.)
        link_args = append(link_args, "-lX11")
    if run_command(nb_clang(), link_args) != 0:
        die("orbit: link failed")
    remove_file(ll)
    if variant == "ship":
        remove_file("build/scripts_embed.c")
        # Stage under build/ship/ as <name>.exe (never clobbers the
        # dev exe) and zip it - the artifact you drag to itch.
        mkdir_all("build/ship")
        zip_rc = run_command("powershell", ["-NoProfile", "-Command", "Copy-Item build/" + name + "_ship.exe build/ship/" + name + ".exe -Force; Compress-Archive -Force -Path build/ship/" + name + ".exe -DestinationPath build/" + name + "-win64.zip"])
        if zip_rc == 0:
            print_line(c_bold("build/" + name + "-win64.zip") + " " + c_green("ready"))
    print_line(c_bold(exe) + " " + c_green("ok"))
    exe

# ---------- native build/run/test (replaces the old Rust interp path) ----------
#
# Compile `path` with orion.exe - CLI runtime only (orion_rt.c + orion_cli.c),
# no window/gpu/audio - link, and return the exe path (or "" on failure).
# The file's own `main` is the entry, so callers pass fname == "main" (test.sh,
# cubsy, the bundle smoke all do). 64MB stack: `orbit run` on the compiler
# bundle recurses deep; harmless for small programs.
define cli_build(path: text) -> text:
    # STANDALONE: one .or file, no project around it. Everything Orbit.toml
    # supplies here is derivable without it -- the name from the file, the
    # compiler and runtime and orbs from where this exe sits -- so requiring
    # the file bought nothing and cost a newcomer the whole single-file path.
    # Without this, the only way to run one program was to invoke the compiler
    # by hand, pass it an output .ll, pass it an orb root, and then write out
    # the clang line yourself. That was the first thing the guide had to show.
    #
    # Artifacts land beside the source (hello.or -> hello.exe), not in a build/
    # directory conjured in someone's working directory.
    standalone = not file_exists("Orbit.toml")
    edit name = "prog"
    edit compiler = default_compiler()
    edit runtime = default_runtime()
    edit ll = ""
    edit exe = ""
    edit dirs = []
    edit extra_link = ""
    if standalone:
        if not ends_with(path, ".or"):
            die("orbit: `" + path + "` is not a .or file, and there is no Orbit.toml here")
        if not file_exists(path):
            die("orbit: no such file `" + path + "`")
        # Keep a separator in the path. run_command hands the exe to
        # CreateProcessA, which resolves a bare relative name against the
        # CALLING exe's directory (dist/, where orbit lives) rather than the
        # working directory -- so a just-built `hello.exe` was compiled, then
        # reported as not found. `./hello` becomes `.\hello.exe`, which is
        # plainly cwd-relative. os/lib.or documents the same trap.
        bare = path_drop_or(path)
        stem = if path_parent(bare) == "." then "./" + bare else bare
        ll = stem + ".ll"
        exe = stem + if os_kind() == 0 then ".exe" else ""
        dirs = [default_orbs()]
    else:
        lines = nb_lines(read_file("Orbit.toml"))
        name = nb_setting(lines, "name", "prog")
        compiler = nb_setting(lines, "compiler", default_compiler())
        runtime = nb_setting(lines, "runtime", default_runtime())
        mkdir_all("build")
        ll = "build/" + name + "_cli.ll"
        exe = "build/" + name + "_cli.exe"
        dirs = nb_orb_dirs(lines)
        # `link = "vendor/sqlite3.c vendor/other.o"` - extra sources/objects
        # the project links, space-separated, project-relative. The door to
        # the C ecosystem: vendor a C file, declare externs, wrap an orb.
        extra_link = nb_setting(lines, "link", "")
    if not file_exists(compiler):
        die("orbit: compiler not found at `" + compiler + "` - set [native] compiler in Orbit.toml")
    edit compile_args = [path, ll]
    dir_total = len(dirs)
    loop d_index in 0..<dir_total:
        compile_args = append(compile_args, at(dirs, d_index))
    # Running one file should show the PROGRAM's output, not three lines about
    # how its compilation went. Diagnostics and failures still print.
    if standalone:
        compile_args = append(compile_args, "--quiet")
    # `orbit debug` builds with the call trail (see cmd_debug).
    if slot_has("orbit:trace") and slot_get_int("orbit:trace") == 1:
        compile_args = append(compile_args, "--trace")
    if run_command(compiler, compile_args) != 0:
        return ""
    # The compiler always emits a Windows triple (effect ABI). Off Windows,
    # retarget the .ll to the host before clang, else it won't link.
    if os_kind() != 0:
        mangle = if os_kind() == 2 then "o" else "e"
        triple = if os_kind() == 2 then "arm64-apple-macosx" else "x86_64-unknown-linux-gnu"
        edit txt = read_file(ll)
        # Anchor to the header context so we never rewrite a same-looking
        # substring inside a program string constant (that would desync the
        # constant's LLVM [N x i8] length prefix - e.g. this file itself
        # carries the Windows-triple literal to do exactly this retarget).
        txt = replace(txt, "datalayout = \"e-m:w", "datalayout = \"e-m:" + mangle)
        txt = replace(txt, "triple = \"x86_64-pc-windows-msvc19.44.35209\"", "triple = \"" + triple + "\"")
        write_file(ll, txt)
    # /STACK is a Windows PE linker flag; POSIX raises the stack via ulimit
    # (Linux) or a link-time flag (macOS - main-thread stack is capped there).
    # -Wno-override-module silences the retargeted-triple note (no-op on Win).
    edit link_args = [ll, runtime + "/orion_rt.c", runtime + "/orion_cli.c", runtime + "/net_min.c", "-O2", "-Wno-override-module"]
    if extra_link != "":
        extras = split(extra_link, " ")
        loop x_index in 0..<len(extras):
            xf = at(extras, x_index)
            if xf != "":
                link_args = append(link_args, xf)
    # `orbit package` gives the exe its icon: a compiled resource, linked in
    # like any other object.
    if slot_has("orbit:res") and os_kind() == 0:
        link_args = append(link_args, slot_get("orbit:res"))
    # `orbit package` links a shipped app without a console window. The entry
    # point stays main() - /SUBSYSTEM:WINDOWS alone would send the linker
    # looking for WinMain.
    if slot_has("orbit:windowless") and slot_get_int("orbit:windowless") == 1 and os_kind() == 0:
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "/SUBSYSTEM:WINDOWS")
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "/ENTRY:mainCRTStartup")
    if os_kind() == 0:
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "/STACK:67108864")
        # UTF-8 as the process code page - see runtime/orion.manifest for why.
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "-MANIFEST:EMBED")
        link_args = append(link_args, "-Xlinker")
        link_args = append(link_args, "-MANIFESTINPUT:" + runtime + "/orion.manifest")
    link_args = append(link_args, "-o")
    link_args = append(link_args, exe)
    if run_command(nb_clang(), link_args) != 0:
        return ""
    remove_file(ll)
    exe

# Returns the PROGRAM's exit code, not a pass/fail. Every Orion main returns an
# int, and the guide says that int becomes the process exit code -- but this
# collapsed anything non-zero to 1, so the one promise the language makes about
# main stopped being true the moment you ran it through the tool. 1 stays
# reserved for "the build itself failed".
define __os_orbit_run(path: text, fname: text, args: [text]) -> int:
    exe = cli_build(path)
    if exe == "":
        return 1
    run_command(exe, args)

define __os_orbit_test(path: text) -> int:
    exe = cli_build(path)
    if exe == "":
        return 1
    run_command(exe, [])

# The stdlib orb names - every orb under the project's declared orb dirs.
# Used only by `orbit add` to validate `<orb>`.
define __os_orbit_stdlib_orbs() -> [text]:
    edit out = []
    if file_exists("Orbit.toml"):
        lines = nb_lines(read_file("Orbit.toml"))
        dirs = nb_orb_dirs(lines)
        dir_total = len(dirs)
        loop i in 0..<dir_total:
            entries = list_dir(at(dirs, i))
            ent_total = len(entries)
            loop j in 0..<ent_total:
                nm = at(entries, j)
                if nm != "":
                    out = append(out, nm)
    out

define cmd_native():
    variant = first_param()
    if variant != "" and variant != "gpu" and variant != "ship":
        die("usage: orbit native [gpu|ship]")
    build_native(variant)

# Free a locked exe - a running instance blocks the relink. Best-effort:
# nothing running is not an error, so the result is ignored. Windows kills
# by image name, POSIX by command match.
define kill_running(name: text):
    if os_kind() == 0:
        run_command("taskkill", ["/F", "/IM", name + ".exe"])
    else:
        run_command("pkill", ["-f", name])

# orbit dev [mode] - THE build-and-run loop for a windowed app, one command
# on any host (no _gpu dance, no PowerShell): free the locked exe, build
# native under the canonical name, gate on the headless reference check,
# then launch. `.astra` edits hot-reload live, so this is only needed after
# engine/orb changes. The check gate assumes the app's main.or routes a
# `check` arg to project_check (see atlas-editor/src/main.or) - set
# `[dev] check = 0` in Orbit.toml to skip it.
define cmd_dev():
    if not file_exists("Orbit.toml"):
        die("orbit dev: no Orbit.toml in this directory")
    mode = first_param()
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    kill_running(name)
    exe = build_native("")
    if nb_setting(lines, "check", "1") != "0":
        # A broken show/bind/parent fails HERE, before a window opens.
        if run_command(exe, ["check"]) != 0:
            die("orbit dev: reference check failed - fix the above, not launched")
    edit launch = []
    if mode != "":
        launch = append(launch, mode)
    exit_with(run_command(exe, launch))

# orbit shot [out.bmp] - headless one-frame render to a BMP via the software
# backend. Builds the app, then runs its `shot` subcommand. No window opens:
# a safe screenshot (only the app's own framebuffer, never the desktop) and a
# way to eyeball layout in CI - the same OS-independent pixel path a Linux or
# e-ink present step builds on.
define cmd_shot():
    if not file_exists("Orbit.toml"):
        die("orbit shot: no Orbit.toml in this directory")
    exe = build_native("")
    out = if first_param() == "" then "build/shot.bmp" else first_param()
    exit_with(run_command(exe, ["shot", out]))

# The game as a queryable surface: every rule's reads/writes/
# emits/spawns, optionally filtered ("orbit facts score" = which
# rules touch score).
# usage: orbit facts [name]
# orbit memfacts - every slot store in THIS build whose value shape has no
# copier at the persistence boundary. Those are the sites that abort instead of
# evacuating if the value turns out to be region-born, and the compiler knows
# all of them statically. The build already prints the count next to its
# timings; this names them.
define cmd_memfacts():
    if not file_exists("Orbit.toml"):
        die("orbit memfacts: no Orbit.toml in this directory")
    lines = nb_lines(read_file("Orbit.toml"))
    compiler = nb_setting(lines, "compiler", default_compiler())
    if not file_exists(compiler):
        die("orbit memfacts: compiler not found at `" + compiler + "`")
    edit args = [resolve_path(), "memfacts"]
    dirs = nb_orb_dirs(lines)
    loop i in 0..<len(dirs):
        args = append(args, at(dirs, i))
    exit_with(run_command(compiler, args))

define cmd_facts():
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    filter = first_param()
    q = bytes_to_text(append([], 34))
    src = "use atlas_project\n\nfn main() -> int:\n    project_facts(" + q + name + ".toml" + q + ", " + q + name + ":" + q + ", " + q + filter + q + ")\n"
    mkdir_all("target")
    write_file("target/facts_gen.or", src)
    exe = build_native_entry("facts", "target/facts_gen.or")
    exit_with(run_command(exe, []))

# ---- Static analysis commands: the why-engine and scheduler surface,
# now reachable from the CLI (the project_ functions shipped but were
# only gate-tested; this wires them). All read declared facts - no
# playthrough needed. why/affects take a symbol; schedule/liveness don't.
define synth_analysis(fn_name: text, gen: text, arg: text):
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    q = bytes_to_text(append([], 34))
    call = if arg == "" then fn_name + "(" + q + name + ".toml" + q + ", " + q + name + ":" + q + ")" else fn_name + "(" + q + name + ".toml" + q + ", " + q + name + ":" + q + ", " + q + arg + q + ")"
    src = "use atlas_project\n\nfn main() -> int:\n    " + call + "\n"
    mkdir_all("target")
    write_file("target/" + gen + "_gen.or", src)
    exe = build_native_entry(gen, "target/" + gen + "_gen.or")
    exit_with(run_command(exe, []))

# usage: orbit why <symbol> - the backward causal chain to <symbol>.
define cmd_why():
    synth_analysis("project_why", "why", first_param())

# usage: orbit affects <symbol> - the forward ripple <symbol> causes.
define cmd_affects():
    synth_analysis("project_affects", "affects", first_param())

# usage: orbit schedule - hazard-free parallel batches from facts.
define cmd_schedule():
    synth_analysis("project_schedule", "schedule", "")

# usage: orbit liveness - dead-write audit.
define cmd_liveness():
    synth_analysis("project_liveness", "liveness", "")

# usage: orbit doc [filter] - rules' behavior projected from declared
# facts (reads/writes/emits). `orbit doc score` filters to one resource.
# The "*" sentinel keeps the no-filter case on synth_analysis's 3-arg path.
define cmd_doc():
    p = first_param()
    synth_analysis("project_doc", "doc", if p == "" then "*" else p)

define cmd_bisect():
    synth_analysis("project_bisect", "bisect", first_param())

# The shadow verdict: compile the candidate, replay the last real
# session under it, chaos-soak a fresh world, return the verdict.
# usage: orbit try [soak-ticks] [seed]
define cmd_try():
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    ticks = nb_int(first_param(), 8000)
    seed = nb_int(second_param(), 42)
    q = bytes_to_text(append([], 34))
    src = "use atlas_project\n\nfn main() -> int:\n    project_try(" + q + name + ".toml" + q + ", " + q + name + ":" + q + ", {ticks}, {seed})\n"
    mkdir_all("target")
    write_file("target/try_gen.or", src)
    exe = build_native_entry("try", "target/try_gen.or")
    exit_with(run_command(exe, []))

# The engine plays the game: headless seeded chaos session with
# invariants (backwards tick = FAIL, screen-change cause ledger).
# usage: orbit soak [ticks] [seed]
define cmd_soak():
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    t_param = first_param()
    s_param = second_param()
    ticks = nb_int(t_param, 20000)
    seed = nb_int(s_param, 42)
    q = bytes_to_text(append([], 34))
    src = "use atlas_project\n\nfn main() -> int:\n    project_soak(" + q + name + ".toml" + q + ", " + q + name + ":" + q + ", {ticks}, {seed})\n"
    mkdir_all("target")
    write_file("target/soak_gen.or", src)
    exe = build_native_entry("soak", "target/soak_gen.or")
    exit_with(run_command(exe, []))

# Guard-style split - an else after a nested if binds to the inner
# one (interp parser dangling-else).
define cmd_play():
    mode = first_param()
    if mode == "interp":
        play_interp()
    if mode != "interp":
        play_native(mode)

define play_interp():
    lines = nb_lines(read_file("Orbit.toml"))
    name = nb_setting(lines, "name", "game")
    if __os_orbit_run(entry_path(name), "main", []) != 0:
        exit_with(1)

define play_native(mode: text):
    exe = build_native("")
    edit game_args = []
    if mode != "":
        game_args = append(game_args, mode)
    exit_with(run_command(exe, game_args))

# ---------- entrypoint ----------

public define main():
    command = verb()
    if command == "new":
        cmd_new()
    else:
        if command == "add":
            cmd_add()
        else if command == "get":
            cmd_get()
        else if command == "update":
            cmd_update()
        else if command == "package":
            cmd_package()
        else if command == "debug":
            cmd_debug()
        else:
            if command == "build" or command == "check":
                cmd_build()
            else:
                if command == "run":
                    cmd_run()
                else:
                    if command == "test":
                        cmd_test()
                    else:
                        if command == "fmt":
                            cmd_fmt()
                        else:
                            if command == "native":
                                cmd_native()
                            else:
                                if command == "dev":
                                    cmd_dev()
                                else:
                                    if command == "shot":
                                        cmd_shot()
                                    else:
                                        if command == "play":
                                            cmd_play()
                                        else:
                                            if command == "soak":
                                                cmd_soak()
                                            else:
                                                if command == "try":
                                                    cmd_try()
                                                else:
                                                    if command == "memfacts":
                                                        cmd_memfacts()
                                                    else if command == "facts":
                                                        cmd_facts()
                                                    else:
                                                        if command == "why":
                                                            cmd_why()
                                                        else:
                                                            if command == "affects":
                                                                cmd_affects()
                                                            else:
                                                                if command == "schedule":
                                                                    cmd_schedule()
                                                                else:
                                                                    if command == "liveness":
                                                                        cmd_liveness()
                                                                    else:
                                                                        if command == "doc":
                                                                            cmd_doc()
                                                                        else:
                                                                            if command == "bisect":
                                                                                cmd_bisect()
                                                                            else:
                                                                                usage()
