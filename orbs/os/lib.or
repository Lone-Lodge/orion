# os — CLI / OS primitives for self-hosted tools (orbit), under the names
# orbit already uses. Splits into three sources:
#   - C externs (orion_cli.c): sys_run, fs ops, exit, eprint.
#   - orion-self builtins re-exposed: read_file=file_read, arg=argv, ...
#   - run_command(cmd, [args]) joins to one line and calls sys_run.
#
# With this orb, orbit_main.or compiles under orion-self with zero changes
# to its call sites — the last piece before a native, lodge-orion-free orbit.

extern fn sys_run(cmd: Text) -> int
extern fn mkdir_all(path: Text) -> int
extern fn remove_file(path: Text) -> int
extern fn file_exists(path: Text) -> int
extern fn is_dir(path: Text) -> int
extern fn is_file(path: Text) -> int
extern fn exit_with(code: int)
extern fn eprint(s: Text) -> int
extern fn now() -> int
extern fn file_size(path: Text) -> int

# Milliseconds between now() and an earlier now() — timing metric.
pub fn elapsed(start: int) -> int = now() - start

# orion-self builtins under orbit's names (file_read/argv/argc live in the
# compiler, not an orb — callable directly).
pub fn read_file(p: Text) -> Text = file_read(p)
pub fn arg(i: int) -> Text = argv(i)
pub fn arg_count() -> int = argc()

pub fn write_file(p: Text, c: Text) -> int:
    file_write(p, c)
    0

# Join a command + its args into one line. Each arg is double-quoted so
# paths with spaces (e.g. "C:/Program Files/LLVM/...") survive.
fn os_quote(a: Text) -> Text = "\"{a}\""

fn os_join(acc: Text, args: [Text], i: int) -> Text:
    if i >= len(args):
        acc
    else:
        os_join("{acc} {os_quote(at(args, i))}", args, i + 1)

# CreateProcessA resolves a forward-slash *relative* command (e.g.
# "build/app.exe") by searching the CALLER exe's directory, not the cwd — so a
# just-built exe isn't found. Backslashes make it a plain cwd-relative path
# (no search). Convert only the command; args keep their slashes (clang source
# paths and linker flags like "/STACK" must stay intact). POSIX shells use
# forward slashes, so this is a Windows-only fixup — a no-op elsewhere, or it
# would corrupt every relative path on Linux/Mac.
extern fn host_os() -> int
# Public wrapper so other orbs can branch on the host without re-declaring the
# extern (a second `declare` in the bundle is an LLVM redefinition error).
# 0 = Windows, 1 = Linux, 2 = macOS.
pub fn os_kind() -> int = host_os()
fn win_path(p: Text) -> Text = if host_os() == 0 then str_replace(p, "/", "\\") else p

pub fn run_command(cmd: Text, args: [Text]) -> int = sys_run(os_join(os_quote(win_path(cmd)), args, 0))

extern fn capture(cmd: Text) -> Text
pub fn capture_stdout(cmd: Text, args: [Text]) -> Text = capture(os_join(os_quote(cmd), args, 0))

# ---- string helpers (orion-self has no shared str lib; roll them over
# bytes, matching the driver's idioms) ----

pub fn str_starts_with(t: Text, p: Text) -> bool:
    tb = bytes_from_text(t)
    pb = bytes_from_text(p)
    pn = len(pb)
    if len(tb) < pn:
        return false
    loop i in 0..<pn:
        if at(tb, i) != at(pb, i):
            return false
    true

pub fn str_ends_with(t: Text, p: Text) -> bool:
    tb = bytes_from_text(t)
    pb = bytes_from_text(p)
    tn = len(tb)
    pn = len(pb)
    if tn < pn:
        return false
    loop i in 0..<pn:
        if at(tb, tn - pn + i) != at(pb, i):
            return false
    true

pub fn str_contains(t: Text, sub: Text) -> bool:
    tb = bytes_from_text(t)
    sb = bytes_from_text(sub)
    tn = len(tb)
    sn = len(sb)
    if sn == 0:
        return true
    if tn < sn:
        return false
    mut i = 0
    loop:
        if i > tn - sn:
            break
        mut hit = true
        loop j in 0..<sn:
            if at(tb, i + j) != at(sb, j):
                hit = false
        if hit:
            return true
        i = i + 1
    false

pub fn str_trim(t: Text) -> Text:
    bs = bytes_from_text(t)
    n = len(bs)
    mut lo = 0
    loop:
        if lo >= n:
            break
        c = at(bs, lo)
        if c == 32 or c == 9 or c == 10 or c == 13:
            lo = lo + 1
        else:
            break
    mut hi = n
    loop:
        if hi <= lo:
            break
        c2 = at(bs, hi - 1)
        if c2 == 32 or c2 == 9 or c2 == 10 or c2 == 13:
            hi = hi - 1
        else:
            break
    bytes_to_text(bytes_slice(bs, lo, hi))

pub fn str_split(t: Text, sep: Text) -> [Text]:
    tb = bytes_from_text(t)
    sb = bytes_from_text(sep)
    tn = len(tb)
    sn = len(sb)
    mut out = []
    if sn == 0:
        return push(out, t)
    mut start = 0
    mut i = 0
    loop:
        if i > tn - sn:
            break
        mut hit = true
        loop j in 0..<sn:
            if at(tb, i + j) != at(sb, j):
                hit = false
        if hit:
            out = push(out, bytes_to_text(bytes_slice(tb, start, i)))
            i = i + sn
            start = i
        else:
            i = i + 1
    out = push(out, bytes_to_text(bytes_slice(tb, start, tn)))
    out

pub fn str_join(parts: [Text], sep: Text) -> Text:
    n = len(parts)
    mut out = ""
    loop i in 0..<n:
        if i == 0:
            out = at(parts, i)
        else:
            out = "{out}{sep}{at(parts, i)}"
    out

pub fn str_replace(t: Text, pat: Text, rep: Text) -> Text = str_join(str_split(t, pat), rep)

# ---- paths ----
pub fn path_join(a: Text, b: Text) -> Text = "{a}/{b}"

pub fn path_parent(p: Text) -> Text:
    bs = bytes_from_text(p)
    n = len(bs)
    mut last_sep = 0 - 1
    loop i in 0..<n:
        c = at(bs, i)
        if c == 47 or c == 92:
            last_sep = i
    if last_sep < 0:
        "."
    else:
        bytes_to_text(bytes_slice(bs, 0, last_sep))

# ---- directory listing (orion_dir_list returns newline-joined names) ----
extern fn orion_dir_list(dir: Text) -> Text
pub fn list_dir(dir: Text) -> [Text] = str_split(orion_dir_list(dir), "\n")
