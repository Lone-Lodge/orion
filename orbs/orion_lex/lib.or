use bytes

# orion_self_lex — Orion lexer written in Orion.
#
# Tokenizes `.or` source text into a list of token Maps with the shape:
#     {"kind": Text, "value": Text, "line": int, "col": int}
#
# This is step 3 of the self-hosting plan (see [[orion-pure-orion-goal]]).
# Goal: feature-complete enough that the Rust lexer's output and this
# lexer's output agree on real Orion source files. Once that's true,
# step 4 (parser in Orion) can consume these tokens directly.
#
# Token kinds emitted:
#   ident      — names and keywords (keyword? lookup later)
#   int        — integer literal
#   float      — float literal
#   str        — string literal (escapes resolved; \{ and \} kept raw)
#   symbol     — operator or punctuation; `value` is the operator text
#   newline    — line break (one per consecutive newline run)
#   eof        — end-of-input marker
#
# `value` is always a Text — int and float tokens encode their numeric
# value as text to keep the token type uniform. Step 4 (parser) can
# str_to_int / str_to_float them.

# --- byte-class predicates ---

fn slx_is_space(byte: int) -> bool:
    byte == 32 or byte == 9 or byte == 13

fn slx_is_newline(byte: int) -> bool:
    byte == 10

fn slx_is_digit(byte: int) -> bool:
    byte >= 48 and byte <= 57

fn slx_is_lower(byte: int) -> bool:
    byte >= 97 and byte <= 122

fn slx_is_upper(byte: int) -> bool:
    byte >= 65 and byte <= 90

fn slx_is_ident_start(byte: int) -> bool:
    slx_is_lower(byte) or slx_is_upper(byte) or byte == 95

fn slx_is_ident_continue(byte: int) -> bool:
    slx_is_ident_start(byte) or slx_is_digit(byte)

# --- token construction ---

fn slx_make_token(kind: Text, value: Text, line: int, col: int) -> Map:
    # No return type — Orion typeck treats Map as Unknown when the
    # annotation is omitted, which is what we want for token records.
    {"kind": kind, "value": value, "line": line, "col": col}

# --- scanners ---
# Each scanner returns a Map: {"token": <token Map>, "next": <next byte index>}.

fn slx_scan_ident(bytes: [int], start: int, byte_count: int, line: int, col: int) -> Map:
    mut cursor = start
    for:
        if cursor >= byte_count:
            break
        if not slx_is_ident_continue(byte_at(bytes, cursor)):
            break
        cursor += 1
    text_value = bytes_to_text(bytes_slice(bytes, start, cursor))
    # Keep keywords as `ident` so the existing parser checks (which
    # compare value strings) continue to work. The keyword table is
    # still useful — `slx_keyword_kind` can be queried by the parser
    # to skip the per-statement string comparisons.
    {"token": slx_make_token("ident", text_value, line, col), "next": cursor}

# The keyword table — pairs of (word, kind). Sequential lookup keeps
# the fn flat (Orion's parser dislikes deeply-nested if/else chains).
fn slx_keyword_table() -> [Text]:
    ["fn", "kw_fn", "data", "kw_data", "enum", "kw_enum", "trait", "kw_trait", "impl", "kw_impl", "system", "kw_system", "use", "kw_use", "pub", "kw_pub", "mut", "kw_mut", "if", "kw_if", "else", "kw_else", "for", "kw_for", "in", "kw_in", "with", "kw_with", "where", "kw_where", "loop", "kw_loop", "break", "kw_break", "continue", "kw_continue", "match", "kw_match", "true", "kw_true", "false", "kw_false", "and", "kw_and", "or", "kw_or", "not", "kw_not", "extern", "kw_extern", "comptime", "kw_comptime", "deterministic", "kw_deterministic", "parallel", "kw_parallel", "spawn", "kw_spawn", "destroy", "kw_destroy", "require", "kw_require", "ensure", "kw_ensure", "scope", "kw_scope", "job", "kw_job", "raw", "kw_raw", "frame", "kw_frame", "before", "kw_before", "after", "kw_after", "as", "kw_as", "return", "kw_return", "none", "kw_none", "self", "kw_self"]

# Map a word to a token kind. `ident` means "not a keyword".
fn slx_keyword_kind(word: Text) -> Text:
    table = slx_keyword_table()
    table_length = len(table)
    mut found = "ident"
    mut index = 0
    for:
        if index >= table_length:
            break
        if at(table, index) == word:
            found = at(table, index + 1)
        index += 2
    found

fn slx_scan_number(bytes: [int], start: int, byte_count: int, line: int, col: int) -> Map:
    mut cursor = start
    mut saw_dot = false
    for:
        if cursor >= byte_count:
            break
        current = byte_at(bytes, cursor)
        if slx_is_digit(current):
            cursor += 1
        else:
            # A single `.` followed by a digit is a decimal point — anything
            # else terminates the number.
            is_dot_then_digit = current == 46 and (not saw_dot) and cursor + 1 < byte_count and slx_is_digit(byte_at(bytes, cursor + 1))
            if is_dot_then_digit:
                saw_dot = true
                cursor += 1
            else:
                break
    text_value = bytes_to_text(bytes_slice(bytes, start, cursor))
    kind = if saw_dot then "float" else "int"
    {"token": slx_make_token(kind, text_value, line, col), "next": cursor}

# Single-byte escape lookup — returns the resolved byte, or -1 to mean
# "preserve the backslash and the next byte unchanged" (used for \{ and \}).
fn slx_resolve_escape(escape_char: int) -> int:
    mut result = 0 - 1
    if escape_char == 34: result = 34
    if escape_char == 92: result = 92
    if escape_char == 110: result = 10
    if escape_char == 114: result = 13
    if escape_char == 116: result = 9
    if escape_char == 48: result = 0
    if escape_char == 39: result = 39
    result

# Decimal text for a small non-negative int (byte values 0-255). Used to
# emit a char literal as an ordinary int token — the parser then treats
# `'+'` exactly like `43`, so no new AST node or type is needed.
fn slx_int_to_text(n: int) -> Text:
    if n == 0:
        return "0"
    mut digits = bytes_zeros(0)
    mut v = n
    for:
        if v <= 0:
            break
        digits = push(digits, 48 + (v % 10))
        v = v / 10
    mut out = bytes_zeros(0)
    mut i = len(digits) - 1
    for:
        if i < 0:
            break
        out = push(out, at(digits, i))
        i = i - 1
    bytes_to_text(out)

# A character literal `'c'` (or an escape like `'\n'`) lexes to an int token
# holding the byte value. Readable notation for a byte — `match b: '+' -> …`
# instead of the magic number `43`.
fn slx_scan_char(bytes: [int], start: int, byte_count: int, line: int, col: int) -> Map:
    mut cursor = start + 1
    mut value = 0
    mut ok = false
    if cursor < byte_count:
        c = byte_at(bytes, cursor)
        if c == 92 and cursor + 1 < byte_count:
            resolved = slx_resolve_escape(byte_at(bytes, cursor + 1))
            if resolved >= 0:
                value = resolved
                cursor += 2
                ok = true
        else:
            if c != 39:
                value = c
                cursor += 1
                ok = true
    if ok and cursor < byte_count and byte_at(bytes, cursor) == 39:
        cursor += 1
        {"token": slx_make_token("int", slx_int_to_text(value), line, col), "next": cursor}
    else:
        # Malformed (empty '' or unterminated). Advance one byte so the main
        # loop can't hang; emit nothing usable — a later parse error follows.
        {"token": slx_make_token("newline", "\n", line, col), "next": start + 1}

fn slx_scan_string(bytes: [int], start: int, byte_count: int, line: int, col: int) -> Map:
    # Consume the opening quote, walk until the closing one. Returns
    # next=start when the string is unterminated — caller turns that into
    # a lex error.
    mut cursor = start + 1
    mut buffer = bytes_zeros(0)
    mut closed = false
    # Depth of unescaped `{…}` interpolation braces. A `"` inside braces
    # belongs to an interpolated expression (e.g. a map key `m["k"]`), not
    # the string terminator — so it doesn't end the literal.
    mut brace_depth = 0
    for:
        if cursor >= byte_count:
            break
        current = byte_at(bytes, cursor)
        is_close_quote = current == 34 and brace_depth == 0
        if is_close_quote:
            closed = true
            cursor += 1
            break
        if current == 10:
            # Unterminated — bail out of the loop, leave `closed = false`.
            break
        if current == 92 and cursor + 1 < byte_count:
            next_byte = byte_at(bytes, cursor + 1)
            resolved = slx_resolve_escape(next_byte)
            if resolved >= 0:
                buffer = push(buffer, resolved)
                cursor += 2
            else:
                # Brace escapes are preserved literally — `build_str` in the
                # Rust pipeline depends on `\{` / `\}` surviving lex.
                buffer = push(buffer, 92)
                buffer = push(buffer, next_byte)
                cursor += 2
        else:
            # Track interpolation depth on unescaped braces (escaped `\{` is
            # handled above and never reaches here).
            if current == 123:
                brace_depth = brace_depth + 1
            if current == 125 and brace_depth > 0:
                brace_depth = brace_depth - 1
            buffer = push(buffer, current)
            cursor += 1
    text_value = bytes_to_text(buffer)
    {"token": slx_make_token("str", text_value, line, col), "next": cursor, "closed": closed}

# --- multi-char symbol detection ---

# Returns the operator text + how many bytes to consume. Returns "" for
# unrecognized characters so the main loop can produce a useful error.
fn slx_scan_op(bytes: [int], start: int, byte_count: int) -> Text:
    first = byte_at(bytes, start)
    mut second = 0
    if start + 1 < byte_count:
        second = byte_at(bytes, start + 1)
    mut third = 0
    if start + 2 < byte_count:
        third = byte_at(bytes, start + 2)
    # Three-char tokens first so `..=` doesn't get scanned as `..` then `=`.
    mut op = ""
    if first == 46 and second == 46 and third == 60:
        op = "..<"
    if first == 46 and second == 46 and third == 61:
        op = "..="
    if op == "":
        op = slx_scan_op_short(first, second)
    op

fn slx_scan_op_short(first: int, second: int) -> Text:
    # Two-char tokens — flat sequential checks, then fall through to single.
    # (Deep nested if/else-as-expression chains trigger the native compiler's
    # nesting bug — see [[orion_nesting_bug]].)
    mut result = ""
    if first == 61 and second == 61:
        result = "=="
    if first == 33 and second == 61:
        result = "!="
    if first == 60 and second == 61:
        result = "<="
    if first == 62 and second == 61:
        result = ">="
    if first == 45 and second == 62:
        result = "->"
    if first == 43 and second == 61:
        result = "+="
    if first == 45 and second == 61:
        result = "-="
    if first == 42 and second == 61:
        result = "*="
    if first == 47 and second == 61:
        result = "/="
    if result == "":
        result = slx_scan_op_single(first)
    result

fn slx_scan_op_single(first: int) -> Text:
    # Single-char punctuation/operators. Direct table lookup with literal
    # results — avoids native compiler issues with push-to-bytes-zeros.
    mut result_text = ""
    if first == 43:
        result_text = "+"
    if first == 45:
        result_text = "-"
    if first == 42:
        result_text = "*"
    if first == 47:
        result_text = "/"
    if first == 61:
        result_text = "="
    if first == 60:
        result_text = "<"
    if first == 62:
        result_text = ">"
    if first == 33:
        result_text = "!"
    if first == 40:
        result_text = "("
    if first == 41:
        result_text = ")"
    if first == 44:
        result_text = ","
    if first == 58:
        result_text = ":"
    if first == 59:
        result_text = ";"
    if first == 46:
        result_text = "."
    if first == 91:
        result_text = "["
    if first == 93:
        result_text = "]"
    if first == 123:
        result_text = "\{"
    if first == 125:
        result_text = "\}"
    if first == 63:
        result_text = "?"
    if first == 64:
        result_text = "@"
    if first == 38:
        result_text = "&"
    if first == 124:
        result_text = "|"
    if first == 94:
        result_text = "^"
    if first == 37:
        result_text = "%"
    result_text

# --- comment skip ---

fn slx_skip_comment(bytes: [int], start: int, byte_count: int) -> int:
    mut cursor = start
    for:
        if cursor >= byte_count:
            break
        if slx_is_newline(byte_at(bytes, cursor)):
            break
        cursor += 1
    cursor

# --- main loop ---

# Push a token, but suppress a duplicate `newline` if the previous token
# was already one — matches the Rust lexer's behaviour ("never two newlines
# in a row, never first"). No type annotations on the params so Orion
# treats them as Unknown (Map isn't a writeable type name).
# Mutate the token slot in place — O(1) amortised push instead of
# the old `push(list, val)` which cloned the entire token list per
# call (~quadratic for 25k tokens). We track `last_kind` in a
# separate scalar slot so we never have to read the (now huge)
# token list back just to peek at its last element.
fn slx_push_token(tokens_in: [Map], token: Map) -> [Map]:
    last_kind = slot_get("slx:last_kind")
    is_newline = get(token, "kind") == "newline"
    last_was_newline = last_kind == "newline" or last_kind == ""
    suppress = is_newline and last_was_newline
    mut tokens = tokens_in
    if not suppress:
        # Explicit in-place push. Audited: every caller rebinds
        # `tokens = slx_push_token(tokens, t)` so the old list has no
        # live alias.
        tokens = push_mut(tokens, token)
        slot_set("slx:last_kind", get(token, "kind"))
    tokens

pub fn self_lex(source: Text) -> [Map]:
    bytes = bytes_from_text(source)
    byte_count = bytes_length(bytes)
    slot_set("slx:last_kind", "")
    mut tokens = []
    mut cursor = 0
    mut line = 1
    mut line_start = 0
    for:
        if cursor >= byte_count:
            break
        current = byte_at(bytes, cursor)
        col = cursor - line_start
        is_nl = slx_is_newline(current)
        is_ws = slx_is_space(current)
        is_comment = current == 35
        is_string = current == 34
        is_char = current == 39
        is_digit = slx_is_digit(current)
        is_ident = slx_is_ident_start(current)
        if is_nl:
            tokens = slx_push_token(tokens, slx_make_token("newline", "\n", line, col))
            line += 1
            cursor += 1
            line_start = cursor
        if is_ws and not is_nl:
            cursor += 1
        if is_comment:
            cursor = slx_skip_comment(bytes, cursor, byte_count)
        if is_string:
            scanned = slx_scan_string(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        if is_char:
            scanned = slx_scan_char(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        if is_digit:
            scanned = slx_scan_number(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        if is_ident:
            scanned = slx_scan_ident(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        is_unknown = not (is_nl or is_ws or is_comment or is_string or is_char or is_digit or is_ident)
        if is_unknown:
            op_text = slx_scan_op(bytes, cursor, byte_count)
            if op_text == "":
                cursor += 1
            else:
                op_length = bytes_length(bytes_from_text(op_text))
                tokens = slx_push_token(tokens, slx_make_token("symbol", op_text, line, col))
                cursor += op_length
    tokens = slx_push_token(tokens, slx_make_token("newline", "\n", line, byte_count - line_start))
    eof_token = slx_make_token("eof", "", line, byte_count - line_start)
    tokens = push(tokens, eof_token)
    tokens
