use bytes

# orion_self_lex - Orion lexer written in Orion.
#
# Tokenizes `.or` source text into a list of token Maps with the shape:
#     {"kind": text, "value": text, "line": int, "col": int}
#
# This is step 3 of the self-hosting plan (see [[orion-pure-orion-goal]]).
# Goal: feature-complete enough that the Rust lexer's output and this
# lexer's output agree on real Orion source files. Once that's true,
# step 4 (parser in Orion) can consume these tokens directly.
#
# Token kinds emitted:
#   ident      - names and keywords (keyword? lookup later)
#   int        - integer literal
#   float      - float literal
#   str        - string literal (escapes resolved; \{ and \} kept raw)
#   symbol     - operator or punctuation; `value` is the operator text
#   newline    - line break (one per consecutive newline run)
#   eof        - end-of-input marker
#
# `value` is always a Text - int and float tokens encode their numeric
# value as text to keep the token type uniform. Step 4 (parser) can
# str_to_int / str_to_float them.

# --- byte-class predicates ---

define slx_is_space(byte: int) -> truth:
    byte == 32 or byte == 9 or byte == 13

define slx_is_newline(byte: int) -> truth:
    byte == 10

define slx_is_digit(byte: int) -> truth:
    byte >= 48 and byte <= 57

define slx_is_lower(byte: int) -> truth:
    byte >= 97 and byte <= 122

define slx_is_upper(byte: int) -> truth:
    byte >= 65 and byte <= 90

define slx_is_ident_start(byte: int) -> truth:
    slx_is_lower(byte) or slx_is_upper(byte) or byte == 95

define slx_is_ident_continue(byte: int) -> truth:
    slx_is_ident_start(byte) or slx_is_digit(byte)

# --- token construction ---

define slx_make_token(kind: text, value: text, line: int, col: int) -> table:
    # No return type - Orion typeck treats Map as Unknown when the
    # annotation is omitted, which is what we want for token records.
    {"kind": kind, "value": value, "line": line, "col": col}

# --- scanners ---
# Each scanner returns a Map: {"token": <token Map>, "next": <next byte index>}.

define slx_scan_ident(bytes: [int], start: int, byte_count: int, line: int, col: int) -> table:
    edit cursor = start
    loop:
        if cursor >= byte_count:
            break
        if not slx_is_ident_continue(byte_at(bytes, cursor)):
            break
        cursor += 1
    text_value = bytes_to_text(bytes_slice(bytes, start, cursor))
    # Every word lexes as `ident`. The PARSER decides what is a keyword, by
    # comparing the value in the position where that keyword is meaningful,
    # which is what lets `type`, `loop` or `data` also be ordinary variable
    # names elsewhere.
    #
    # There used to be a `slx_keyword_table` / `slx_keyword_kind` pair here,
    # kept "in case the parser wants to skip its string comparisons". Nothing
    # ever called it, so it drifted into a second, WRONG answer to "what is a
    # keyword": it listed `data`/`enum`/`for` (retired), 15 words with no
    # implementation (trait, impl, system, with, spawn, destroy, scope, job,
    # raw, frame, before, after, as, none, self) and was missing 8 real ones
    # (type, const, effect, handle, perform, defer, move, let). A dead list
    # that looks authoritative is worse than no list: deleted. The parser is
    # the single source of truth, and `tools/negative_test.sh` is where a
    # reserved-but-unimplemented word gets its behaviour pinned.
    {"token": slx_make_token("ident", text_value, line, col), "next": cursor}

define slx_hex_digit(c: int) -> int:
    if c >= 48 and c <= 57:
        c - 48
    else:
        if c >= 97 and c <= 102:
            c - 87
        else:
            if c >= 65 and c <= 70:
                c - 55
            else:
                0 - 1

# `0x1F`, `0b1010`, `0o17` - a leading 0 plus a base marker. Returns the token
# and the new cursor, or next == start when this is not a based literal.
#
# These did not lex at all: `0x81` came out as the number 0 followed by an
# identifier `x81`, so a mask like `& 0xFF` was a syntax error two tokens later.
# Real in-tree code uses them (atlas_ws builds WebSocket frame headers), and the
# editor grammar highlighted them, which made the gap look like a bug in the
# file rather than in the lexer.
define slx_scan_based(bytes: [int], start: int, byte_count: int, line: int, col: int) -> table:
    if start + 2 >= byte_count:
        return {"token": slx_make_token("int", "0", line, col), "next": start}
    if byte_at(bytes, start) != 48:
        return {"token": slx_make_token("int", "0", line, col), "next": start}
    marker = byte_at(bytes, start + 1)
    edit base = 0
    if marker == 120 or marker == 88:
        base = 16
    if marker == 98 or marker == 66:
        base = 2
    if marker == 111 or marker == 79:
        base = 8
    if base == 0:
        return {"token": slx_make_token("int", "0", line, col), "next": start}
    edit cursor = start + 2
    edit value = 0
    edit digits = 0
    loop:
        if cursor >= byte_count:
            break
        c = byte_at(bytes, cursor)
        if c == 95:
            cursor = cursor + 1
            continue
        d = slx_hex_digit(c)
        if d < 0 or d >= base:
            break
        value = value * base + d
        digits = digits + 1
        cursor = cursor + 1
    if digits == 0:
        return {"token": slx_make_token("int", "0", line, col), "next": start}
    # Emitted as a decimal int token: the parser and every later stage only ever
    # see the VALUE, so no base survives past here.
    {"token": slx_make_token("int", "{value}", line, col), "next": cursor}

define slx_scan_number(bytes: [int], start: int, byte_count: int, line: int, col: int) -> table:
    based = slx_scan_based(bytes, start, byte_count, line, col)
    if get_int(based, "next") > start:
        return based
    edit cursor = start
    edit saw_dot = false
    loop:
        if cursor >= byte_count:
            break
        current = byte_at(bytes, cursor)
        if slx_is_digit(current):
            cursor += 1
        else:
            # A single `.` followed by a digit is a decimal point - anything
            # else terminates the number.
            is_dot_then_digit = current == 46 and (not saw_dot) and cursor + 1 < byte_count and slx_is_digit(byte_at(bytes, cursor + 1))
            if is_dot_then_digit:
                saw_dot = true
                cursor += 1
            else:
                break
    text_value = bytes_to_text(bytes_slice(bytes, start, cursor))
    kind = if saw_dot then "float" else "int"
    {"token": slx_make_token(kind, text_value, line, col), "next": cursor}

# Single-byte escape lookup - returns the resolved byte, or -1 to mean
# "preserve the backslash and the next byte unchanged" (used for \{ and \}).
define slx_resolve_escape(escape_char: int) -> int:
    edit result = 0 - 1
    if escape_char == 34: result = 34
    if escape_char == 92: result = 92
    if escape_char == 110: result = 10
    if escape_char == 114: result = 13
    if escape_char == 116: result = 9
    if escape_char == 48: result = 0
    if escape_char == 39: result = 39
    result

# Decimal text for a small non-negative int (byte values 0-255). Used to
# emit a char literal as an ordinary int token - the parser then treats
# `'+'` exactly like `43`, so no new AST node or type is needed.
define slx_int_to_text(n: int) -> text:
    if n == 0:
        return "0"
    edit digits = bytes_zeros(0)
    edit v = n
    loop:
        if v <= 0:
            break
        digits = append(digits, 48 + (v % 10))
        v = v // 10
    edit out = bytes_zeros(0)
    edit i = len(digits) - 1
    loop:
        if i < 0:
            break
        out = append(out, at(digits, i))
        i = i - 1
    bytes_to_text(out)

# A character literal `'c'` (or an escape like `'\n'`) lexes to an int token
# holding the byte value. Readable notation for a byte - `match b: '+' -> …`
# instead of the magic number `43`.
define slx_scan_char(bytes: [int], start: int, byte_count: int, line: int, col: int) -> table:
    edit cursor = start + 1
    edit value = 0
    edit ok = false
    if cursor < byte_count:
        c = byte_at(bytes, cursor)
        if c == 92 and cursor + 1 < byte_count:
            resolved = slx_resolve_escape(byte_at(bytes, cursor + 1))
            if resolved >= 0:
                value = resolved
                cursor += 2
                ok = true
        else:
            if c != 39:
                value = c
                cursor += 1
                ok = true
    if ok and cursor < byte_count and byte_at(bytes, cursor) == 39:
        cursor += 1
        {"token": slx_make_token("int", slx_int_to_text(value), line, col), "next": cursor}
    else:
        # Malformed (empty '' or unterminated). Advance one byte so the main
        # loop can't hang; emit nothing usable - a later parse error follows.
        {"token": slx_make_token("newline", "\n", line, col), "next": start + 1}

define slx_scan_string(bytes: [int], start: int, byte_count: int, line: int, col: int) -> table:
    # Consume the opening quote, walk until the closing one. Returns
    # next=start when the string is unterminated - caller turns that into
    # a lex error.
    edit cursor = start + 1
    edit buffer = bytes_zeros(0)
    edit closed = false
    # Depth of unescaped `{…}` interpolation braces. A `"` inside braces
    # belongs to an interpolated expression (e.g. a map key `m["k"]`), not
    # the string terminator - so it doesn't end the literal.
    edit brace_depth = 0
    loop:
        if cursor >= byte_count:
            break
        current = byte_at(bytes, cursor)
        is_close_quote = current == 34 and brace_depth == 0
        if is_close_quote:
            closed = true
            cursor += 1
            break
        if current == 10:
            # Unterminated - bail out of the loop, leave `closed = false`.
            break
        if current == 92 and cursor + 1 < byte_count:
            next_byte = byte_at(bytes, cursor + 1)
            resolved = slx_resolve_escape(next_byte)
            if resolved >= 0:
                buffer = append(buffer, resolved)
                cursor += 2
            else:
                # Brace escapes are preserved literally - `build_str` in the
                # Rust pipeline depends on `\{` / `\}` surviving lex.
                buffer = append(buffer, 92)
                buffer = append(buffer, next_byte)
                cursor += 2
        else:
            # Track interpolation depth on unescaped braces (escaped `\{` is
            # handled above and never reaches here).
            if current == 123:
                brace_depth = brace_depth + 1
            if current == 125 and brace_depth > 0:
                brace_depth = brace_depth - 1
            buffer = append(buffer, current)
            cursor += 1
    text_value = bytes_to_text(buffer)
    # `holes` = interpolation braces still open at the end of the literal. The
    # scanner already counts them; carrying the count out is what lets the
    # parser reject `"{{"` with a message. (Before, the unterminated hole was
    # handed to the expression parser as a bare `{`, which the map-literal loop
    # then spun on forever.)
    str_token = set(slx_make_token("str", text_value, line, col), "holes", brace_depth)
    {"token": str_token, "next": cursor, "closed": closed}

# --- multi-char symbol detection ---

# Returns the operator text + how many bytes to consume. Returns "" for
# unrecognized characters so the main loop can produce a useful error.
define slx_scan_op(bytes: [int], start: int, byte_count: int) -> text:
    first = byte_at(bytes, start)
    edit second = 0
    if start + 1 < byte_count:
        second = byte_at(bytes, start + 1)
    edit third = 0
    if start + 2 < byte_count:
        third = byte_at(bytes, start + 2)
    # Three-char tokens first so `..=` doesn't get scanned as `..` then `=`.
    edit op = ""
    if first == 46 and second == 46 and third == 60:
        op = "..<"
    if first == 46 and second == 46 and third == 61:
        op = "..="
    if op == "":
        op = slx_scan_op_short(first, second)
    op

define slx_scan_op_short(first: int, second: int) -> text:
    # Two-char tokens - flat sequential checks, then fall through to single.
    # (Deep nested if/else-as-expression chains trigger the native compiler's
    # nesting bug - see [[orion_nesting_bug]].)
    edit result = ""
    if first == 61 and second == 61:
        result = "=="
    if first == 33 and second == 61:
        result = "!="
    if first == 60 and second == 61:
        result = "<="
    if first == 62 and second == 61:
        result = ">="
    if first == 45 and second == 62:
        result = "->"
    if first == 43 and second == 61:
        result = "+="
    if first == 45 and second == 61:
        result = "-="
    if first == 42 and second == 61:
        result = "*="
    if first == 47 and second == 47:
        result = "//"
    if first == 47 and second == 61:
        result = "/="
    # Bit shifts. `syntax.md` listed `<<` and `>>` among the operators, and the
    # other four (`&` `|` `^` `~`) really did work - these two never lexed at
    # all, so `plen >> 8` came out as `>` `>` and died as "not valid here". Real
    # code hit it: atlas_ws builds WebSocket frame headers with shifts.
    if first == 60 and second == 60:
        result = "<<"
    if first == 62 and second == 62:
        result = ">>"
    if result == "":
        result = slx_scan_op_single(first)
    result

define slx_scan_op_single(first: int) -> text:
    # Single-char punctuation/operators. Direct table lookup with literal
    # results - avoids native compiler issues with push-to-bytes-zeros.
    edit result_text = ""
    if first == 43:
        result_text = "+"
    if first == 45:
        result_text = "-"
    if first == 42:
        result_text = "*"
    if first == 47:
        result_text = "/"
    if first == 61:
        result_text = "="
    if first == 60:
        result_text = "<"
    if first == 62:
        result_text = ">"
    if first == 33:
        result_text = "!"
    if first == 40:
        result_text = "("
    if first == 41:
        result_text = ")"
    if first == 44:
        result_text = ","
    if first == 58:
        result_text = ":"
    if first == 59:
        result_text = ";"
    if first == 46:
        result_text = "."
    if first == 91:
        result_text = "["
    if first == 93:
        result_text = "]"
    if first == 123:
        result_text = "\{"
    if first == 125:
        result_text = "\}"
    if first == 63:
        result_text = "?"
    if first == 64:
        result_text = "@"
    if first == 38:
        result_text = "&"
    if first == 124:
        result_text = "|"
    if first == 94:
        result_text = "^"
    if first == 37:
        result_text = "%"
    # `~` (126) was missing from this table entirely, so it lexed as nothing and
    # `~x` came through as a bare `x`: the operator vanished before the parser
    # ever saw it, and `~12` answered 12.
    if first == 126:
        result_text = "~"
    result_text

# --- comment skip ---

define slx_skip_comment(bytes: [int], start: int, byte_count: int) -> int:
    edit cursor = start
    loop:
        if cursor >= byte_count:
            break
        if slx_is_newline(byte_at(bytes, cursor)):
            break
        cursor += 1
    cursor

# --- main loop ---

# Push a token, but suppress a duplicate `newline` if the previous token
# was already one - matches the Rust lexer's behaviour ("never two newlines
# in a row, never first"). No type annotations on the params so Orion
# treats them as Unknown (table isn't a writeable type name).
# Mutate the token slot in place - O(1) amortised push instead of
# the old `append(list, val)` which cloned the entire token list per
# call (~quadratic for 25k tokens). We track `last_kind` in a
# separate scalar slot so we never have to read the (now huge)
# token list back just to peek at its last element.
define slx_push_token(tokens_in: [table], token: table) -> [table]:
    last_kind = slot_get("slx:last_kind")
    is_newline = get(token, "kind") == "newline"
    last_was_newline = last_kind == "newline" or last_kind == ""
    suppress = is_newline and last_was_newline
    edit tokens = tokens_in
    if not suppress:
        # Explicit in-place push (__push_inplace = the compiler-internal
        # spelling; the promotion pass cannot see across this function
        # boundary). Audited: every caller rebinds
        # `tokens = slx_push_token(tokens, t)` so the old list has no
        # live alias.
        tokens = __push_inplace(tokens, token)
        slot_set("slx:last_kind", get(token, "kind"))
    tokens

public define self_lex(source: text) -> [table]:
    bytes = bytes_from_text(source)
    byte_count = bytes_length(bytes)
    slot_set("slx:last_kind", "")
    edit tokens = []
    edit cursor = 0
    edit line = 1
    edit line_start = 0
    loop:
        if cursor >= byte_count:
            break
        current = byte_at(bytes, cursor)
        col = cursor - line_start
        is_nl = slx_is_newline(current)
        is_ws = slx_is_space(current)
        is_comment = current == 35
        is_string = current == 34
        is_char = current == 39
        is_digit = slx_is_digit(current)
        is_ident = slx_is_ident_start(current)
        if is_nl:
            tokens = slx_push_token(tokens, slx_make_token("newline", "\n", line, col))
            line += 1
            cursor += 1
            line_start = cursor
        if is_ws and not is_nl:
            cursor += 1
        if is_comment:
            cursor = slx_skip_comment(bytes, cursor, byte_count)
        if is_string:
            scanned = slx_scan_string(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        if is_char:
            scanned = slx_scan_char(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        if is_digit:
            scanned = slx_scan_number(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        if is_ident:
            scanned = slx_scan_ident(bytes, cursor, byte_count, line, col)
            tokens = slx_push_token(tokens, get(scanned, "token"))
            cursor = get_int(scanned, "next")
        is_unknown = not (is_nl or is_ws or is_comment or is_string or is_char or is_digit or is_ident)
        if is_unknown:
            op_text = slx_scan_op(bytes, cursor, byte_count)
            if op_text == "":
                cursor += 1
            else:
                op_length = bytes_length(bytes_from_text(op_text))
                tokens = slx_push_token(tokens, slx_make_token("symbol", op_text, line, col))
                cursor += op_length
    tokens = slx_push_token(tokens, slx_make_token("newline", "\n", line, byte_count - line_start))
    eof_token = slx_make_token("eof", "", line, byte_count - line_start)
    tokens = append(tokens, eof_token)
    tokens
