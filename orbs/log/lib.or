# log - leveled, categorized logging. One system, one way in.
#
#     use log
#     const ecs = channel("ecs")            a report: leveled, can be hushed
#     const out = always("out")             an answer: ORION_LOG never reaches it
#
#     error(ecs, "no tray slot {i}")        always visible, red
#     warn(ecs,  "kept old bundle")         yellow
#     info(ecs,  "scripts reloaded")        cyan, the default ceiling
#     debug(ecs, () -> text: "packed {n}")  hidden until raised
#
# A CHANNEL IS A DECLARED VALUE, not a string: `debug(esc, ...)` against a
# channel spelled `ecs` is an unknown identifier at compile time, where a free
# string was a line that silently never appeared again.
#
# AND THE CHANNEL CARRIES ITS OWN POLICY. The only thing that really separates
# a program's answer from a subsystem's report is one question - may it be
# hushed? - so that question lives on the channel and everything else is one
# system. `ORION_LOG=error` cannot accidentally kill a tool's output or an
# editor's type stream, because those channels are declared `always`.
#
# Levels: error 0, warn 1, info 2, debug 3. A line shows when its level is at
# most the channel's ceiling; the default is info(2). ORION_LOG sets ceilings
# without a code change, read once on the first line: "debug" raises
# everything, "ecs=3" one channel, and the two mix ("debug,net=1"). An explicit
# log_set_level always wins - it writes unconditionally, the environment only
# fills what nobody set.
#
# `debug` TAKES A MAKER, and there is no eager form. Orion evaluates arguments
# before the call, so an eager debug builds its text even when the line is
# dropped: measured, 300 000 suppressed calls cost 74 ms eagerly and 12 ms
# lazily. The closure is not free, but it is six times less, and a second
# spelling where one is always worse is what the one-spelling rule forbids.
# The other three levels stay eager: they show nearly always, and a closure for
# a line that will be written is pure cost.
#
# LOGGING MAY NOT COST THE DISK. The level calls declare `uses console` and
# nothing else, so a system that declares its capabilities - simulation code,
# where it matters most - can log without asking for the filesystem. Lines
# accumulate in memory and the PROGRAM layer, which already holds `uses files`,
# writes them out with `log_drain_to`.
#
# The buffer holds 128 lines. Drain more often than that; if you do not, the
# drain says how many it lost rather than quietly writing a hole.

public external define orion_console_color() -> int
public external define orion_persist_text(s: text) -> text
external define env_get(name: text) -> text

use file

# ---- Channels ----

# A logging channel. `hushable` is the whole reason both kinds are one type.
public type Channel: name: text, hushable: truth

# A report. Leveled, and ORION_LOG can quiet it.
public define channel(name: text) -> Channel:
    example channel("ecs").name is "ecs"
    Channel{name: name, hushable: true}

# An answer. A tool's result, an editor's stream - the things that must not
# vanish because someone set an environment variable.
public define always(name: text) -> Channel:
    example always("out").hushable is false
    Channel{name: name, hushable: false}

# ---- Styling ----

define lsty(code: text, s: text) -> text:
    if orion_console_color() is 1:
        e = text_of(append([], 27))
        "{e}[{code}m{s}{e}[0m"
    else:
        s

define ldim(s: text) -> text = lsty("2", s)
define lred(s: text) -> text = lsty("31;1", s)
define lyellow(s: text) -> text = lsty("33", s)
define lcyan(s: text) -> text = lsty("36", s)

# ---- Ceilings ----

define level_num(word: text) -> number:
    if word is "error" or word is "0" then 0
    else if word is "warn" or word is "1" then 1
    else if word is "info" or word is "2" then 2
    else if word is "debug" or word is "3" then 3
    else 0 - 1

define env_ceilings():
    if not slot_has("log:env:done"):
        slot_set("log:env:done", 1)
        setting = env_get("ORION_LOG")
        if setting is not "":
            loop part in split(setting, ","):
                clause = trim(part)
                eq = index_of(clause, "=")
                if eq >= 0:
                    raw = bytes_of(clause)
                    name = text_of(bytes_part(raw, 0, eq))
                    word = trim(text_of(bytes_part(raw, eq + 1, bytes_count(raw))))
                    level = level_num(word)
                    if level >= 0 and not slot_has("log:lvl:" + name):
                        slot_set("log:lvl:" + name, level)
                else:
                    level = level_num(clause)
                    if level >= 0 and not slot_has("log:lvl:*"):
                        slot_set("log:lvl:*", level)

define ceiling_of(name: text) -> number:
    env_ceilings()
    key = "log:lvl:" + name
    if slot_has(key):
        slot_get_number(key)
    else:
        if slot_has("log:lvl:*") then slot_get_number("log:lvl:*") else 2

# Would this line show? The one place the channel's policy is read.
define shows(ch: Channel, level: number) -> truth:
    if not ch.hushable then true else ceiling_of(ch.name) >= level

# Raise or lower a channel. Answers false for a channel that cannot be hushed -
# setting a level on one is meaningless, and saying so beats a silent no-op.
# no example: sets global logging state - proven by test_ceilings
public define log_set_level(ch: Channel, level: number) -> truth:
    if not ch.hushable:
        return false
    slot_set("log:lvl:" + ch.name, level)
    true

# ---- Emit ----

# no example: prints - an example would be noise in every gate run
public define error(ch: Channel, msg: text) uses console:
    if shows(ch, 0):
        emit(0, ch.name, msg)

# no example: prints - an example would be noise in every gate run
public define warn(ch: Channel, msg: text) uses console:
    if shows(ch, 1):
        emit(1, ch.name, msg)

# no example: prints - an example would be noise in every gate run
public define info(ch: Channel, msg: text) uses console:
    if shows(ch, 2):
        emit(2, ch.name, msg)

# The maker runs only if the line shows. See the header for why there is no
# eager form.
# no example: prints - an example would be noise in every gate run
public define debug(ch: Channel, make: function() -> text) uses console:
    if shows(ch, 3):
        emit(3, ch.name, make())

define emit(level: number, name: text, msg: text) uses console:
    print_line("  {level_tag(level)} {ldim(name)}  {msg}")
    keep("{level_name(level)} {name}  {msg}")

define level_tag(level: number) -> text:
    if level is 0 then lred("error")
    else if level is 1 then lyellow(" warn")
    else if level is 2 then lcyan(" info")
    else ldim("debug")

define level_name(level: number) -> text:
    if level is 0 then "error"
    else if level is 1 then " warn"
    else if level is 2 then " info"
    else "debug"

# ---- The buffer, and getting it out ----

const ring_size = 128

define keep(line: text):
    n = if slot_has("log:n") then slot_get_number("log:n") else 0
    slot_set("log:{n - (n // ring_size) * ring_size}", orion_persist_text(line))
    slot_set("log:n", n + 1)

define drained() -> number:
    if slot_has("log:out") then slot_get_number("log:out") else 0

# Write everything kept since the last drain to `path`, and answer how many
# lines were written. The program layer calls this - it already holds the
# capability, and a level call must not need it.
#
# A drain that comes too late says so IN THE FILE: the buffer holds 128 lines,
# and a hole is written as a counted line rather than as nothing.
# no example: touches the filesystem - proven by test_drain_writes_and_reports_loss
public define log_drain_to(path: text) -> number uses files:
    total = if slot_has("log:n") then slot_get_number("log:n") else 0
    out = drained()
    edit first = out
    if total - out > ring_size:
        lost = total - out - ring_size
        ignore = append_line(path, "-- {lost} line(s) lost: the buffer holds {ring_size}, drain more often --")
        first = total - ring_size
    edit written = 0
    loop i in first until total:
        ignore2 = append_line(path, slot_get("log:{i - (i // ring_size) * ring_size}"))
        written = written + 1
    slot_set("log:out", total)
    written

# ----- Tests (`orbit test` runs these) -----

define test_a_channel_is_a_value():
    ecs = channel("t_ecs")
    out = always("t_out")
    require ecs.name is "t_ecs"
    require ecs.hushable
    require not out.hushable

define test_ceilings():
    quiet = channel("t_quiet")
    loud = channel("t_loud")
    require shows(quiet, 2)
    require not shows(quiet, 3)
    require log_set_level(loud, 3)
    require shows(loud, 3)
    require not shows(quiet, 3)

define test_an_always_channel_cannot_be_hushed():
    out = always("t_answer")
    require not log_set_level(out, 0)
    # Even with everything turned off, an answer is still an answer.
    slot_set("log:lvl:*", 0 - 1)
    require shows(out, 3)
    slot_set("log:lvl:*", 2)

define test_the_maker_runs_only_when_the_line_shows() uses console:
    quiet = channel("t_lazy")
    ignore = log_set_level(quiet, 0)
    slot_set("t_made", 0)
    loop i in 0 until 50:
        debug(quiet, () -> text: probe())
    require slot_get_number("t_made") is 0
    ignore2 = log_set_level(quiet, 3)
    debug(quiet, () -> text: probe())
    require slot_get_number("t_made") is 1
    ignore3 = log_set_level(quiet, 2)

define probe() -> text:
    slot_set("t_made", slot_get_number("t_made") + 1)
    "probe"

define test_drain_writes_and_reports_loss() uses files:
    path = "build/__logdrain.txt"
    remove_file(path)
    slot_set("log:n", 0)
    slot_set("log:out", 0)
    loop i in 0 until 3:
        keep("line {i}")
    require log_drain_to(path) is 3
    back = read_file(path)
    require contains(back, "line 0")
    require contains(back, "line 2")
    # A drain that comes too late reports the hole instead of hiding it.
    loop j in 0 until ring_size + 5:
        keep("flood {j}")
    written = log_drain_to(path)
    require written is ring_size
    after = read_file(path)
    require contains(after, "5 line(s) lost")
    remove_file(path)
