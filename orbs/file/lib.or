# file - streaming file IO.
#
# Whole-file `read_file` / `write_file` (builtins) are fine until the data is
# bigger than memory, or you want to write a line at a time. These are the
# missing primitives: open a handle, move bytes a chunk at a time, close it.
#
#   h = open_read("big.log")
#   loop:
#       chunk = read_chunk(h, 4096)
#       if is_end(chunk):
#           break
#       process(chunk)
#   close(h)
#
# A read at end-of-stream returns "" - the same convention `net.recv` uses,
# so files and sockets are read the same way.
#
# LIFETIME: prefer `with_read` / `with_write` - they own the handle and close
# it on every exit path, including an early return from your body.
use text

external define file_open(path: text, mode: int) -> int
external define file_read_chunk(handle: int, maxlen: int) -> text
external define file_write_chunk(handle: int, data: text) -> int
external define file_close(handle: int) -> int
external define file_bytes(path: text) -> int

# --- opening ---
# -1 when the file cannot be opened (missing, locked, out of handles).
# no example: touches the filesystem - proven by test_42_file_stream.or
public define open_read(path: text) -> number uses files = file_open(path, 0)
# no example: touches the filesystem - proven by test_42_file_stream.or
public define open_write(path: text) -> number uses files = file_open(path, 1)
# no example: touches the filesystem - proven by test_42_file_stream.or
public define open_append(path: text) -> number uses files = file_open(path, 2)

public define ok(handle: number) -> truth:
    example ok(0 - 1) is false
    example ok(2)
    handle >= 0

# --- moving bytes ---
# Up to `maxlen` bytes. "" means end of stream.
# no example: touches the filesystem - proven by test_42_file_stream.or
public define read_chunk(handle: number, maxlen: number) -> text uses files = file_read_chunk(handle, maxlen)

# How many bytes were written (-1 on failure).
# no example: touches the filesystem - proven by test_42_file_stream.or
public define write_chunk(handle: number, data: text) -> number uses files = file_write_chunk(handle, data)

# no example: touches the filesystem - proven by test_42_file_stream.or
public define close(handle: number) -> number uses files = file_close(handle)

# Size in bytes without reading the contents. -1 if it does not exist.
# no example: touches the filesystem - proven by test_42_file_stream.or
public define size_of(path: text) -> number uses files = file_bytes(path)

# Is this chunk the end of the stream?
public define is_end(chunk: text) -> truth:
    example is_end("")
    example not is_end("x")
    length(chunk) is 0

# --- scope-owned forms: the handle you cannot forget to close ---
# The orb owns the handle, runs your body with it, and closes on the way out
# (including an early return - the close is a `defer`). -1 when the open
# failed, so a caller can tell "could not open" from a body result.
# no example: touches the filesystem - proven by test_42_file_stream.or
public define with_read(path: text, body: function) -> number uses files:
    h = open_read(path)
    if not ok(h):
        return 0 - 1
    defer close(h)
    body(h)

# no example: touches the filesystem - proven by test_42_file_stream.or
public define with_write(path: text, body: function) -> number uses files:
    h = open_write(path)
    if not ok(h):
        return 0 - 1
    defer close(h)
    body(h)

# no example: touches the filesystem - proven by test_42_file_stream.or
public define with_append(path: text, body: function) -> number uses files:
    h = open_append(path)
    if not ok(h):
        return 0 - 1
    defer close(h)
    body(h)

# --- line-oriented convenience ---
# Append one line (adds the newline). Opens and closes around the write, so
# it is safe to call in a loop but not the fastest way to write many lines -
# for that, open once with `with_append` and `write_line` into the handle.
# no example: touches the filesystem - proven by test_42_file_stream.or
public define append_line(path: text, line: text) -> number uses files:
    with_append(path, (h): write_chunk(h, "{line}\n"))

# no example: touches the filesystem - proven by test_42_file_stream.or
public define write_line(handle: number, line: text) -> number uses files:
    write_chunk(handle, "{line}\n")

# Collision-friendly alias: `close` and `ok` exist in the net orb too, and an
# orb using both (a file server) needs the selective import to stay readable.
# no example: closes a handle - proven by the app orb
public define close_file(handle: number) -> number uses files = file_close(handle)
