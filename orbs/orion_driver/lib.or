use orion_ir
use orion_lex
use orion_parse
use orion_ast_to_ir
use orion_emit_llvm
use orion_ast_to_wasm
use orion_emit_wasm

# Self-hosted driver: orion_self <input.or> [output.ll] [orb-root...]
#
# MULTI-ORB: scans the entry file for `use NAME` lines, resolves each
# name to an orb source (NAME/lib.or under a set of search roots),
# recursively discovers that orb's own uses, and compiles everything
# as one program. Replaces tools/bundle_orbs.sh — no bash, one command
# builds a whole dependency graph.
#
# Resolution roots (first hit wins): any extra argv paths, then
# <entry-dir>/orbs/, <entry-dir>/../orbs/, <entry-dir>/../../orbs/,
# orbs/, ../orbs/. Unresolved names print a note and are skipped —
# builtins (bytes/io/fs/...) live in the compiler, not in orb files.
#
# Declaration order doesn't matter: ast_program_to_ir collects all
# signatures before lowering bodies, so orbs concat in discovery order
# with the entry last. The parser already skips `use` lines.
#
# Fail-fast: any compile_error() during lowering/emit → no output,
# exit non-zero.

define drv_dirname(path: text) -> text:
    bs = bytes_from_text(path)
    n = len(bs)
    edit last_sep = 0 - 1
    loop i in 0..<n:
        c = at(bs, i)
        if c == 47 or c == 92:
            last_sep = i
    if last_sep < 0:
        "."
    else:
        bytes_to_text(bytes_slice(bs, 0, last_sep))

# "use foo" → "foo"; anything else → "".
define drv_use_name(line: text) -> text:
    bs0 = bytes_from_text(line)
    # `pub use X` (a facade RE-EXPORTING X) loads X exactly like `use X` does —
    # the visibility difference is the compiler's business, not the loader's.
    # Missing this made a facade orb stop pulling in the orbs it re-exports.
    is_pub_use = len(bs0) > 4 and at(bs0, 0) == 112 and at(bs0, 1) == 117 and at(bs0, 2) == 98 and at(bs0, 3) == 32
    bs = if is_pub_use then bytes_slice(bs0, 4, len(bs0)) else bs0
    n = len(bs)
    if n < 5:
        return ""
    is_use = at(bs, 0) == 117 and at(bs, 1) == 115 and at(bs, 2) == 101 and at(bs, 3) == 32
    if not is_use:
        return ""
    edit name = ""
    edit i = 4
    loop:
        if i >= n:
            break
        c = at(bs, i)
        # 40 = `(`: `use text (trim)` and `use text(trim)` both name the orb
        # `text` — the selective list is the parser's business, not the loader's.
        if c == 32 or c == 13 or c == 10 or c == 35 or c == 40:
            break
        single = bytes_to_text(bytes_slice(bs, i, i + 1))
        name = "{name}{single}"
        i = i + 1
    name

# All `use` names in a source, by walking its lines.
define drv_uses_of(src: text) -> [text]:
    bs = bytes_from_text(src)
    n = len(bs)
    edit names = []
    edit line_start = 0
    edit i = 0
    loop:
        if i > n:
            break
        at_end = i == n
        edit is_nl = false
        if not at_end:
            is_nl = at(bs, i) == 10
        if at_end or is_nl:
            # A `use` / `pub use` line begins with `u` (117) or `p` (112) at
            # column 0 — that is exactly what drv_use_name requires. Peek that
            # one byte straight out of `bs` and only materialise a Text (a slice
            # + a to_text, and a third byte list inside drv_use_name) for the
            # rare lines that could name an orb. Before this, EVERY line of the
            # entry allocated three times just to be told it wasn't a `use`,
            # which exhausted the heap on a multi-megabyte source and crashed
            # the compiler before it printed a single diagnostic.
            first = if line_start < i then at(bs, line_start) else -1
            if first == 117 or first == 112:
                line = bytes_to_text(bytes_slice(bs, line_start, i))
                name = drv_use_name(line)
                if name != "":
                    names = append(names, name)
            line_start = i + 1
        if at_end:
            break
        i = i + 1
    names

define drv_list_has(items: [text], needle: text) -> truth:
    n = len(items)
    edit found = false
    loop i in 0..<n:
        if at(items, i) == needle:
            found = true
    found

# Try each root for NAME/lib.or. Empty text = not found (orb sources
# are never empty).
define drv_resolve(name: text, roots: [text]) -> text:
    n = len(roots)
    edit src = ""
    loop i in 0..<n:
        if src == "":
            root = at(roots, i)
            candidate = "{root}{name}/lib.or"
            attempt = file_read(candidate)
            if attempt != "":
                src = attempt
    src

# Which PATH an orb resolved from. Same search as drv_resolve, but it answers
# where the text came from instead of what it was, which is what an error
# message needs: without it a diagnostic can only name a line in the
# concatenated program, i.e. a line in no file that exists on disk.
define drv_resolve_path(name: text, roots: [text]) -> text:
    n = len(roots)
    edit path = ""
    loop i in 0..<n:
        if path == "":
            root = at(roots, i)
            candidate = "{root}{name}/lib.or"
            if file_read(candidate) != "":
                path = candidate
    path

define drv_count_lines(s: text) -> int:
    b = bytes_from_text(s)
    n = len(b)
    edit count = 0
    loop i in 0..<n:
        if at(b, i) == 10:
            count = count + 1
    count

# Record one chunk of the concatenated program: the bundle line its `orb`
# marker sits on, and the file it came from. `otir_where` (orion_ast_to_ir)
# reads these back to turn a bundle line into `file:line:col`.
define drv_map_chunk(index: int, marker_line: int, path: text):
    slot_set("src:map:{index}:at", marker_line)
    slot_set("src:map:{index}:path", orion_persist_text(path))
    slot_set("src:map:n", index + 1)

external define orion_console_color() -> int
# Slot-stored text must outlive the transient allocation it was built in.
external define orion_persist_text(s: text) -> text
external define orion_os_private_kb() -> int

# `PERF` row on demand: any argument equal to `--perf`, or ORION_PERF=1 in the
# environment via the `perf` output-path suffix. Kept opt-in so normal builds
# print the human line only.
define drv_want_perf() -> truth:
    edit want = false
    loop ai in 1..<argc():
        if argv(ai) == "--perf":
            want = true
    want

# `--quiet` drops the progress chatter -- the orb count, the timing line and
# the written path -- and keeps everything that means something: diagnostics,
# the unbalanced-region warning, the failure summary. `orbit run` sets it, so
# running a program shows the PROGRAM's output and not three lines about how
# its compilation went.
define drv_want_quiet() -> truth:
    edit want = false
    loop ai in 1..<argc():
        if argv(ai) == "--quiet":
            want = true
    # A caller compiling in-process (the test runner) can silence the chatter
    # via this slot without touching argv.
    if slot_has("drv:quiet") and slot_get_int("drv:quiet") == 1:
        want = true
    want

# A flag is not a directory. Orb roots were taken from every argument at index
# 3 and up, so `--perf` quietly became a search path named `--perf/` that could
# never resolve. Harmless by luck, wrong by construction.
define drv_is_flag(a: text) -> truth:
    bs = bytes_from_text(a)
    len(bs) >= 2 and at(bs, 0) == 45 and at(bs, 1) == 45

define drv_total_insts(m: IRModule) -> int:
    edit total = 0
    loop fi in 0..<len(m.functions):
        f = at(m.functions, fi)
        total = total + len(f.instructions)
    total

define drv_sty(code: text, s: text) -> text:
    if orion_console_color() == 1:
        e = bytes_to_text(append([], 27))
        "{e}[{code}m{s}{e}[0m"
    else:
        s

define drv_dim(s: text) -> text:
    drv_sty("2", s)

define drv_red(s: text) -> text:
    drv_sty("31;1", s)

define drv_green(s: text) -> text:
    drv_sty("32", s)

# ---- `symbols`: the compiler's own index, for tools --------------------
#
# One row per declaration, tab-free and line-oriented so a client can read it
# without a parser:
#
#   TYPE Point|x:int,y:int
#   SUM Tile|Empty,Wall,Loot
#   FN area|p:Point|int
#   EFFECT Random|roll
#   CONST LIMIT
#
# Types are printed as WRITTEN (source form), because that is what a completion
# list or a hover has to show. The alternative — letting the editor re-derive
# this from the text — is how the previous language server ended up describing a
# language that no longer existed.

define drv_type_name(t: table) -> text:
    kind = get(t, "kind")
    if kind == "List":
        inner = drv_type_name(get_map(t, "elem"))
        "[{inner}]"
    else:
        if kind == "Named":
            base = get(t, "name")
            targs = if has(t, "args") then get_list(t, "args") else []
            if len(targs) == 0:
                base
            else:
                edit acc = ""
                loop ai in 0..<len(targs):
                    sep = if ai == 0 then "" else ","
                    acc = "{acc}{sep}{drv_type_name(at(targs, ai))}"
                "{base}<{acc}>"
        else:
            if kind == "FnType":
                "fn"
            else:
                "?"

define drv_symbols(ast: table) -> int:
    decls = get_list(ast, "decls")
    edit orb_now = ""
    loop di in 0..<len(decls):
        d = at(decls, di)
        k = get(d, "kind")
        if k == "OrbMark":
            orb_now = get(d, "name")
        if k == "Fn":
            params = get_list(d, "params")
            edit psig = ""
            loop pi in 0..<len(params):
                p = at(params, pi)
                sep = if pi == 0 then "" else ","
                pty = if has(p, "type") then drv_type_name(get_map(p, "type")) else "int"
                psig = "{psig}{sep}{get(p, \"name\")}:{pty}"
            rty = if has(d, "ret") then drv_type_name(get_map(d, "ret")) else "?"
            print_line("FN {get(d, \"name\")}|{psig}|{rty}|{orb_now}")
        if k == "Data":
            fields = get_list(d, "fields")
            edit fsig = ""
            loop fi in 0..<len(fields):
                f = at(fields, fi)
                sep2 = if fi == 0 then "" else ","
                fty = if has(f, "type") then drv_type_name(get_map(f, "type")) else "?"
                fsig = "{fsig}{sep2}{get(f, \"name\")}:{fty}"
            print_line("TYPE {get(d, \"name\")}|{fsig}|{orb_now}")
        if k == "Enum":
            variants = get_list(d, "variants")
            edit vsig = ""
            loop vi in 0..<len(variants):
                sep3 = if vi == 0 then "" else ","
                vsig = "{vsig}{sep3}{get(at(variants, vi), \"name\")}"
            print_line("SUM {get(d, \"name\")}|{vsig}|{orb_now}")
        if k == "Const":
            print_line("CONST {get(d, \"name\")}||{orb_now}")
    0

# Discover the whole use-graph from the entry source; return the
# combined program text (orbs in discovery order, entry last).
# Quiet by design: one dim summary line instead of a line per orb —
# unresolved `use` means builtin, which is the normal case, not news.
public define drv_collect(entry_src: text, roots: [text], entry_path: text) -> text:
    edit queue = drv_uses_of(entry_src)
    edit loaded_names = []
    edit chunks = []
    edit qi = 0
    edit orb_count = 0
    edit orb_bytes = 0
    # Bundle line the NEXT chunk's `orb` marker will land on (1-based, like the
    # lexer). Each chunk costs: 1 marker line + the source's lines + 1 blank.
    edit line_at = 1
    edit map_n = 0
    loop:
        if qi >= len(queue):
            break
        name = at(queue, qi)
        qi = qi + 1
        if drv_list_has(loaded_names, name):
            continue
        loaded_names = append(loaded_names, name)
        path = drv_resolve_path(name, roots)
        src = if path == "" then "" else file_read(path)
        if src == "":
            continue
        drv_map_chunk(map_n, line_at, path)
        map_n = map_n + 1
        line_at = line_at + drv_count_lines(src) + 2
        orb_count = orb_count + 1
        orb_bytes = orb_bytes + len(bytes_from_text(src))
        # Stamp each chunk with its origin. The program is ONE concatenated
        # text by the time the lexer sees it, so without this marker every
        # function in the build looks like it came from the same place - which
        # is exactly why the namespace was flat and two orbs could not both
        # have a private helper of the same name.
        q = bytes_to_text(append([], 34))
        chunks = append(chunks, "orb " + q + name + q + "\n")
        chunks = append(chunks, src)
        chunks = append(chunks, "\n")
        deps = drv_uses_of(src)
        n_deps = len(deps)
        loop di in 0..<n_deps:
            queue = append(queue, at(deps, di))
    okb = orb_bytes // 1024
    if not drv_want_quiet():
        print_line(drv_dim("  orbs {orb_count} ({okb} KB)"))
    # The entry program is its own scope: `""` owns whatever it declares
    # privately, so a game's local helper cannot collide with an orb's.
    eq = bytes_to_text(append([], 34))
    drv_map_chunk(map_n, line_at, entry_path)
    chunks = append(chunks, "orb " + eq + eq + "\n")
    chunks = append(chunks, entry_src)
    orion_text_join(chunks)

# ---- Effect inference: facts all the way down (Orion 2 / L2 v0) ----
# `orion <input> facts` prints every function's inferred effect row
# instead of emitting LLVM: slot/io/platform/audio/extern/mem/time,
# or `pure`. Direct effects classify dedicated ops and extern call
# targets; user calls close transitively. This is the substrate for
# effect signatures, parallel compiler passes and the B9
# determinism certificate.

# ---- Region scope balance: the static half of the memory-safety story ----
#
# Which region an allocation lands in is a MODE, opened and closed by explicit
# calls. A function that opens one and does not close it leaves every LATER
# allocation in the wrong region: an unclosed persist scope routes transient
# values to the immortal heap, which is the one shape that is a real leak here,
# and an unclosed pool or arena scope leaves them to die at the next reset,
# which is a dangle. Both surface far from their cause.
#
# They are also visible right here, in the IR, before anything runs: count the
# opens and the closes per mode per function.
#
# HONEST SCOPE: this counts, it does not trace paths. Unequal totals are always
# wrong. EQUAL totals on divergent paths - an early `return` between the open
# and the close - are also wrong, and this pass does NOT catch them. Said out
# loud because a checker that appears to prove more than it does is worse than
# no checker.
# EXACT names, never prefixes: `orion_persist_text` is an allocation, not a mode
# switch, and matching the prefix reported every logging helper in the tree.
#
# The ARENA is deliberately absent. It is not used as a balanced scope: the
# dispatch path opens it if it is not already open and RESETS at exit rather
# than closing ("entry only ensures the arena is ON"), so open and close counts
# are not meant to match and demanding they do produces noise, not findings.
define drv_mode_stem(callee: text) -> text:
    if callee == "orion_persist_on" or callee == "orion_persist_off":
        "persist"
    else if callee == "orion_pool_on" or callee == "orion_pool_off":
        "pool"
    else if drv_ends(callee, "state_alloc_on") or drv_ends(callee, "state_alloc_off"):
        "state_alloc"
    else if drv_ends(callee, "world_alloc_on") or drv_ends(callee, "world_alloc_off"):
        "world_alloc"
    else:
        ""

# A function whose own name ends in `_on`, `_off` or `_st` IS a scope primitive:
# opening or closing is its whole job, so it is unbalanced by definition and
# reporting it says nothing about the code that uses it.
define drv_is_scope_primitive(name: text) -> truth:
    drv_ends(name, "_on") or drv_ends(name, "_off") or drv_ends(name, "_st")

define drv_ends(t: text, suffix: text) -> truth:
    bt = bytes_from_text(t)
    bs = bytes_from_text(suffix)
    n = len(bt)
    m = len(bs)
    if m > n:
        false
    else:
        edit same = true
        loop i in 0..<m:
            if at(bt, n - m + i) != at(bs, i):
                same = false
        same

# `_off` closes, `_on` opens. orion_pool_off/orion_pool_on match the same stem,
# and orion_pool_reset/_used/_high do not (the stem check above stops at `_o`).
define drv_is_close(callee: text) -> truth:
    drv_ends(callee, "_off")

# One line per unbalanced (function, mode). Returns how many it found.
define drv_scope_check(module: IRModule, verbose: int) -> int:
    fns = module.functions
    edit bad = 0
    loop fi in 0..<len(fns):
        f = drv_fn_at(fns, fi)
        if drv_is_scope_primitive(f.name):
            continue
        edit stems = slice([""], 0, 0)
        edit opens = slice([0], 0, 0)
        edit closes = slice([0], 0, 0)
        edit depth = slice([0], 0, 0)      # running open-minus-close, in order
        loop ii in 0..<len(f.instructions):
            inst = drv_inst_at(f.instructions, ii)
            if inst.op == "call":
                stem = drv_mode_stem(inst.name)
                if stem != "":
                    edit idx = drv_name_idx(stems, stem)
                    if idx < 0:
                        stems = append(stems, stem)
                        opens = append(opens, 0)
                        closes = append(closes, 0)
                        depth = append(depth, 0)
                        idx = len(stems) - 1
                    if drv_is_close(inst.name):
                        closes = set(closes, idx, drv_int_at(closes, idx) + 1)
                        depth = set(depth, idx, drv_int_at(depth, idx) - 1)
                    else:
                        opens = set(opens, idx, drv_int_at(opens, idx) + 1)
                        depth = set(depth, idx, drv_int_at(depth, idx) + 1)
            # A return reached with a scope still open leaks it on THAT path -
            # the exact case a whole-function open==close count cannot see (an
            # early `return` between the open and the matching close). The
            # final return has depth 0 in a balanced function, so only an early
            # one trips this.
            if inst.op == "return":
                loop si in 0..<len(stems):
                    if drv_int_at(depth, si) > 0:
                        bad = bad + 1
                        if verbose == 1:
                            print_line("    {f.name}: returns with {text_at_drv(stems, si)} still open (early return between open and close)")
        loop si in 0..<len(stems):
            o = drv_int_at(opens, si)
            c = drv_int_at(closes, si)
            if o != c:
                bad = bad + 1
                if verbose == 1:
                    st = text_at_drv(stems, si)
                    print_line("    {f.name}: {st} opened {o}x, closed {c}x")
    bad

define text_at_drv(xs: [text], i: int) -> text:
    at(xs, i)

define drv_fn_at(fs: [IRFn], i: int) -> IRFn:
    at(fs, i)

define drv_inst_at(xs: [Inst], i: int) -> Inst:
    at(xs, i)

define drv_starts(t: text, p: text) -> truth:
    tb = bytes_from_text(t)
    pb = bytes_from_text(p)
    pn = len(pb)
    if len(tb) < pn:
        return false
    loop i in 0..<pn:
        if at(tb, i) != at(pb, i):
            return false
    true

define drv_flag(x: int, f: int) -> truth:
    (x // f) - (x // (f * 2)) * 2 == 1

define drv_or(a: int, b: int) -> int:
    edit out = a
    edit f = 1
    loop i in 0..<8:
        if drv_flag(b, f) and not drv_flag(out, f):
            out = out + f
        f = f * 2
    out

define drv_name_idx(names: [text], name: text) -> int:
    n = len(names)
    loop i in 0..<n:
        if at(names, i) == name:
            return i
    0 - 1

define drv_int_at(xs: [int], i: int) -> int:
    at(xs, i)

define drv_call_bits(callee: text, names: [text]) -> int:
    # Effect prefixes are checked FIRST, before the "is it a user fn?"
    # short-circuit. Externs are added to the module as body-less IRFns, so an
    # effectful extern like `__orion_monotonic_ms` is IN `names` - and the old
    # order returned 0 for it, making every time/platform/audio extern invisible
    # to the effect closure (and so to the `deterministic` check). User fns are
    # mangled `orb__name`, so they can never match these runtime prefixes; a name
    # that matches a prefix is the C symbol, whatever the module also lists.
    if drv_starts(callee, "orion_audio"):
        return 8
    if drv_starts(callee, "win_") or drv_starts(callee, "og_") or drv_starts(callee, "ogpu_"):
        return 4
    if drv_starts(callee, "orion_arena") or drv_starts(callee, "orion_persist") or drv_starts(callee, "orion_pool") or drv_starts(callee, "orion_frame") or drv_starts(callee, "orion_ledger") or drv_starts(callee, "orion_alloc") or drv_starts(callee, "orion_slot"):
        return 32
    if drv_starts(callee, "__orion_monotonic") or drv_starts(callee, "__orion_time") or drv_starts(callee, "__orion_sleep"):
        return 64
    if drv_starts(callee, "orion_console") or drv_starts(callee, "orion_dir") or drv_starts(callee, "orion_file") or drv_starts(callee, "orion_embedded"):
        return 2
    # 128: libm transcendentals — the ONE thing about `number` arithmetic that
    # is NOT bit-exact across platforms (different libms round the last bits
    # differently). Basic ops, sqrt, floor/ceil/round ARE exact per IEEE-754
    # on every target we emit for, so `number` needs no fixed-point type —
    # determinism is guaranteed by forbidding exactly this list.
    if callee == "sin" or callee == "cos" or callee == "tan" or callee == "exp" or callee == "log" or callee == "pow" or callee == "atan2":
        return 128
    # A user fn contributes its effects through the closure, not here.
    if drv_name_idx(names, callee) >= 0:
        return 0
    16

define drv_direct_bits(f: IRFn, names: [text]) -> int:
    edit bits = 0
    n = len(f.instructions)
    loop i in 0..<n:
        inst = drv_inst_at(f.instructions, i)
        op = inst.op
        if op == "slot_set" or op == "slot_get" or op == "slot_has" or op == "slot_get_int":
            bits = drv_or(bits, 1)
        if op == "print_int" or op == "print_str" or op == "print_float" or op == "file_read" or op == "file_write":
            bits = drv_or(bits, 2)
        if op == "call":
            bits = drv_or(bits, drv_call_bits(inst.name, names))
        # Transcendentals lower to their OWN op (fmath1/fmath2), not "call" —
        # they were invisible to this walk, so `deterministic` never saw them.
        if op == "fmath1" or op == "fmath2":
            bits = drv_or(bits, drv_call_bits(inst.name, names))
    bits

define drv_flags_text(bits: int) -> text:
    if bits == 0:
        return "pure"
    edit out = ""
    if drv_flag(bits, 1):
        out = out + " slot"
    if drv_flag(bits, 2):
        out = out + " io"
    if drv_flag(bits, 4):
        out = out + " platform"
    if drv_flag(bits, 8):
        out = out + " audio"
    if drv_flag(bits, 16):
        out = out + " extern"
    if drv_flag(bits, 32):
        out = out + " mem"
    if drv_flag(bits, 64):
        out = out + " time"
    if drv_flag(bits, 128):
        out = out + " libm-transcendentals (sin/cos/tan/exp/ln/pow round differently across platforms; +-*/, sqrt, floor, round ARE bit-exact and stay allowed)"
    out

# The transitive effect bits per function: each fn's own effects unioned with
# everything it (transitively) calls, to a fixpoint. Shared by `facts` and the
# `deterministic` enforcement below - one closure, two readers.
# Drop functions nothing can reach from `main`.
#
# `use text` pulls the WHOLE orb into the program, and every one of its
# functions used to be lowered and emitted — so a program that called `trim`
# still emitted `run_command`, and the linker demanded `sys_run` from a C file
# it was never given ("undefined symbol: sys_run" for a program that shells out
# to nothing). Reachability fixes the general case: what you do not call is not
# emitted, so an orb costs what you use of it.
#
# Roots: `main`, plus anything reached indirectly — effect handlers, and any
# function whose ADDRESS is taken (a closure/callback: `each(xs, f)` passes
# `fn_ref`, and par_run/call_ptr call through the pointer). Those show up as
# `fn_ref` instructions, so the walk seeds from them too. Conservative by
# construction: a name we cannot prove unreachable stays.
define drv_reachable(module: IRModule) -> [int]:
    fns = module.functions
    n = len(fns)
    edit names = []
    loop i in 0 until n:
        names = append(names, drv_fn_at(fns, i).name)
    edit live = []
    loop i in 0 until n:
        nm = at(names, i)
        # main and handlers are entry points; a handler is reached by the
        # runtime, never by a call instruction.
        root = drv_ends(nm, "main") or drv_ends(nm, "_handler") or contains(nm, "__handler_") or drv_starts(nm, "__orion_handler")
        live = append(live, if root then 1 else 0)
    edit pass = 0
    loop:
        if pass >= 32:
            break
        edit changed = 0
        loop i in 0 until n:
            if drv_int_at(live, i) is 1:
                f = drv_fn_at(fns, i)
                loop j in 0 until len(f.instructions):
                    inst = drv_inst_at(f.instructions, j)
                    # A call names its callee; fn_ref names a function whose
                    # address is taken (closures, par_run workers, call_ptr).
                    if inst.op == "call" or inst.op == "fn_ref" or inst.op == "make_closure" or inst.op == "closure_call":
                        idx = drv_name_idx(names, inst.name)
                        if idx >= 0:
                            if drv_int_at(live, idx) is 0:
                                live = set(live, idx, 1)
                                changed = 1
        if changed is 0:
            break
        pass = pass + 1
    live

# The module with unreachable functions removed.
define drv_prune(module: IRModule) -> IRModule:
    fns = module.functions
    live = drv_reachable(module)
    edit kept = []
    loop i in 0 until len(fns):
        if drv_int_at(live, i) is 1:
            kept = append(kept, drv_fn_at(fns, i))
    IRModule{functions: kept}

define drv_effect_closure(module: IRModule, names: [text]) -> [int]:
    fns = module.functions
    n = len(fns)
    edit bits = []
    loop i in 0..<n:
        bits = append(bits, drv_direct_bits(drv_fn_at(fns, i), names))
    edit pass = 0
    loop:
        if pass >= 24:
            break
        edit changed = 0
        edit next = []
        loop i in 0..<n:
            f2 = drv_fn_at(fns, i)
            cur = drv_int_at(bits, i)
            edit acc = cur
            ni = len(f2.instructions)
            loop j in 0..<ni:
                inst = drv_inst_at(f2.instructions, j)
                if inst.op == "call":
                    idx = drv_name_idx(names, inst.name)
                    if idx >= 0:
                        acc = drv_or(acc, drv_int_at(bits, idx))
            if acc != cur:
                changed = 1
            next = append(next, acc)
        bits = next
        pass = pass + 1
        if changed == 0:
            break
    bits

define drv_module_names(module: IRModule) -> [text]:
    fns = module.functions
    edit names = []
    loop i in 0..<len(fns):
        names = append(names, drv_fn_at(fns, i).name)
    names

# `deterministic fn` enforcement (the effect certificate). A fn declared
# deterministic may not transitively touch a source of non-determinism:
#   2 io | 4 platform | 8 audio | 64 time
# slot/mem/extern are allowed - many deterministic ops use them, and a seeded
# RNG is deterministic (wall-clock time, bit 64, is what breaks a replay). This
# is the compile-time guarantee a deterministic simulation, and rollback
# netcode, rests on: the compiler proves the fn is replayable.
define drv_check_deterministic(module: IRModule) -> int:
    marked = deterministic_fn_names()
    if len(marked) == 0:
        return 0
    names = drv_module_names(module)
    bits = drv_effect_closure(module, names)
    nd_mask = drv_or(drv_or(drv_or(2, 4), drv_or(8, 64)), 128)
    edit bad = 0
    loop i in 0..<len(marked):
        idx = drv_name_idx(names, at(marked, i))
        if idx >= 0:
            eff = drv_int_at(bits, idx)
            hit = drv_flag_and(eff, nd_mask)
            if hit != 0:
                bad = bad + 1
                compile_error("orion: ERROR — `deterministic fn` " + drv_deterministic_label(at(marked, i)) + " is not deterministic: it (transitively) performs " + drv_flags_text(hit))
    bad

# `orb__name` -> a readable `name` for the error; leaves already-plain names be.
define drv_deterministic_label(mangled: text) -> text:
    bs = bytes_from_text(mangled)
    n = len(bs)
    edit cut = 0 - 1
    loop i in 0..<n - 1:
        if at(bs, i) == 95 and at(bs, i + 1) == 95:
            cut = i + 2
    if cut < 0 then mangled else bytes_to_text(bytes_slice(bs, cut, n))

define drv_flag_and(a: int, b: int) -> int:
    edit r = 0
    edit bit = 1
    loop i in 0..<40:
        av = (a // bit) - ((a // bit) // 2) * 2
        bv = (b // bit) - ((b // bit) // 2) * 2
        if av == 1 and bv == 1:
            r = r + bit
        bit = bit * 2
    r

define drv_facts(module: IRModule) -> int:
    fns = module.functions
    n = len(fns)
    names = drv_module_names(module)
    bits = drv_effect_closure(module, names)
    edit pure_count = 0
    loop i in 0..<n:
        b = drv_int_at(bits, i)
        if b == 0:
            pure_count = pure_count + 1
        else:
            fl = drv_flags_text(b)
            fname = at(names, i)
            print_line("{fname}:{fl}")
    print_line("facts: {n} fn(s), {pure_count} pure")
    0

# True when the output path ends in ".wasm".
define drv_wants_wasm(p: text) -> truth:
    b = bytes_from_text(p)
    n = len(b)
    if n < 5:
        return false
    at(b, n - 5) == 46 and at(b, n - 4) == 119 and at(b, n - 3) == 97 and at(b, n - 2) == 115 and at(b, n - 1) == 109

# Compile the AST straight to a .wasm module (bump-allocated linear memory,
# i32 + f64, structs, lists, extern host imports) and write the bytes. A Text
# is length-prefixed, so binary survives file_write untouched.
define drv_emit_wasm(ast: table, out_path: text) -> int:
    errs_before = compile_errors()
    wmodule = compile_program(get_list(ast, "decls"))
    wbytes = encode_module(wmodule)
    # Refuse to write invalid wasm: unsupported constructs report a compile
    # error during compile_program, same contract as the LLVM path.
    if compile_errors() > errs_before:
        print_line(drv_red("orion: wasm compilation FAILED — no output written"))
        return 1
    file_write(out_path, bytes_to_text(wbytes))
    if not (slot_has("drv:quiet")):
        print_line(drv_green("  ok") + drv_dim("  {out_path}"))
    0

public define driver_main() -> int:
    if argc() < 2:
        print_line("usage: orion_self <input.or> [output.ll] [orb-root...]")
        0 - 1
    else:
        in_path = argv(1)
        out_path = if argc() >= 3 then argv(2) else "out.ll"
        entry_src = file_read(in_path)
        if entry_src == "":
            print_line("orion: cannot read `{in_path}`")
            return 0 - 1
        base = drv_dirname(in_path)
        edit roots = []
        loop ai in 3..<argc():
            extra = argv(ai)
            if not drv_is_flag(extra):
                roots = append(roots, "{extra}/")
        roots = append(roots, "{base}/orbs/")
        roots = append(roots, "{base}/../orbs/")
        roots = append(roots, "{base}/../../orbs/")
        roots = append(roots, "orbs/")
        roots = append(roots, "../orbs/")
        src = drv_collect(entry_src, roots, in_path)
        # Keep the collected source so error diagnostics can show the line + caret.
        slot_set("src:full", orion_persist_text(src))
        # `--trace` (orbit debug): ast_fn_to_ir prefixes every define with a
        # call-trail entry. Communicated by slot, like drv:quiet.
        loop flag_i in 1..<argc():
            if argv(flag_i) == "--trace":
                slot_set("drv:trace", 1)
        t0 = monotonic_ms()
        tokens = self_lex(src)
        t1 = monotonic_ms()
        ast = self_parse(tokens)
        # BEFORE lowering: `ast_program_to_ir` mangles function names in place
        # (`area` -> `prog__area`) and drops the const declarations once it has
        # folded them, so asking it afterwards gives a tool the compiler's
        # internal names instead of the ones the user typed.
        if out_path == "symbols":
            return drv_symbols(ast)
        # `.wasm` output: compile straight to WebAssembly (own pipeline, no LLVM).
        if drv_wants_wasm(out_path):
            return drv_emit_wasm(ast, out_path)
        t2 = monotonic_ms()
        module = ast_program_to_ir(ast)
        t3 = monotonic_ms()
        if out_path == "facts":
            return drv_facts(module)
        # Enforce `deterministic fn` before emit: a violation is a compile
        # error, so the existing "no output on error" path below refuses to
        # write a binary that lies about being replayable.
        drv_check_deterministic(module)
        # Emit only what is reachable: an orb costs what you USE of it, not
        # what it contains (and no linker error for a C symbol behind a
        # function you never call).
        llvm_text = emit_module(drv_prune(module))
        t4 = monotonic_ms()
        d_lex = t1 - t0
        d_parse = t2 - t1
        d_ir = t3 - t2
        d_emit = t4 - t3
        d_total = t4 - t0
        if not drv_want_quiet():
            print_line(drv_dim("  compiled {d_total} ms (lex {d_lex} | parse {d_parse} | ir {d_ir} | emit {d_emit})"))
        # One machine-readable line for tracking compile performance over time.
        # `tools/compile_bench.sh` parses it and diffs against a checked-in
        # baseline, so a slowdown shows up as a number instead of a feeling.
        # Off by default: the row is only useful to a tool, so it needs asking.
        if drv_want_perf():
            src_bytes = len(bytes_from_text(src))
            src_lines = drv_count_lines(src) + 1
            n_fns = len(module.functions)
            n_insts = drv_total_insts(module)
            kb = orion_os_private_kb()
            per_kloc = if src_lines > 0 then d_total * 1000 // src_lines else 0
            print_line("PERF total_ms={d_total} lex_ms={d_lex} parse_ms={d_parse} ir_ms={d_ir} emit_ms={d_emit} bytes={src_bytes} lines={src_lines} fns={n_fns} insts={n_insts} rss_kb={kb} ms_per_kloc={per_kloc}")
        # What the build knows about its own memory safety. The slot-store
        # boundary decides evacuate-or-abort from a statically derived type
        # code, so the set of sites that CAN abort is a compile-time fact -
        # worth stating next to the timings rather than meeting in a crash.
        if out_path == "memfacts":
            memfacts_list()
            print_line("  region scopes: opened and closed in the same function")
            print_line("")
            n_bad = drv_scope_check(module, 1)
            if n_bad == 0:
                print_line("    every region scope in this build is balanced")
            print_line("")
            return 0
        memfacts_report()
        # An unbalanced region scope is a real defect, not a statistic, so it
        # gets said on every build - but only when there is one.
        n_unbalanced = drv_scope_check(module, 0)
        if n_unbalanced > 0:
            print_line(drv_red("  memory: {n_unbalanced} unbalanced region scope(s) — `orbit memfacts` to name them"))
        n_errors = compile_errors()
        if n_errors > 0:
            print_line(drv_red("orion: compilation FAILED with {n_errors} error(s) — no output written"))
            0 - 1
        else:
            ok = file_write(out_path, llvm_text)
            if ok == 1:
                if not drv_want_quiet():
                    print_line(drv_green("  ok") + drv_dim("  {out_path}"))
                0
            else:
                print_line(drv_red("write failed"))
                0 - 1
