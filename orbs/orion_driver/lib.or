# orion_driver - the self-hosted driver, top of the graph:
#
#   orion_self <input.or> [output.ll] [orb-root...]
#
# It follows `use NAME` lines to NAME/lib.or under a set of search roots,
# recursively, and compiles everything as one program - which is what replaced
# tools/bundle_orbs.sh. Unresolved names are skipped: builtins live in the
# compiler, not in orb files. Declaration order does not matter, because all
# signatures are collected before any body is lowered. See README.md.

define drv_dirname(path: text) -> text:
    bs = bytes_of(path)
    n = length(bs)
    edit last_sep = 0 - 1
    loop i in 0 until n:
        c = bs[i]
        if c is 47 or c is 92:
            last_sep = i
    if last_sep < 0:
        "."
    else:
        text_of(bytes_part(bs, 0, last_sep))

# "use foo" → "foo"; anything else → "".
define drv_use_name(line: text) -> text:
    bs0 = bytes_of(line)
    # `public use X` (a facade RE-EXPORTING X) loads X exactly like `use X` does -
    # the visibility difference is the compiler's business, not the loader's.
    # Missing this made a facade orb stop pulling in the orbs it re-exports.
    is_pub_use = length(bs0) > 4 and bs0[0] is 112 and bs0[1] is 117 and bs0[2] is 98 and bs0[3] is 32
    bs = if is_pub_use then bytes_part(bs0, 4, length(bs0)) else bs0
    n = length(bs)
    if n < 5:
        return ""
    is_use = bs[0] is 117 and bs[1] is 115 and bs[2] is 101 and bs[3] is 32
    if not is_use:
        return ""
    edit name = ""
    edit i = 4
    loop:
        if i >= n:
            break
        c = bs[i]
        # 40 = `(`: `use text (trim)` and `use text(trim)` both name the orb
        # `text` - the selective list is the parser's business, not the loader's.
        if c is 32 or c is 13 or c is 10 or c is 35 or c is 40:
            break
        single = text_of(bytes_part(bs, i, i + 1))
        name = "{name}{single}"
        i = i + 1
    name

# All `use` names in a source, by walking its lines.
define drv_uses_of(src: text) -> [text]:
    bs = bytes_of(src)
    n = length(bs)
    edit names = []
    edit line_start = 0
    edit i = 0
    loop:
        if i > n:
            break
        at_end = i is n
        edit is_nl = false
        if not at_end:
            is_nl = bs[i] is 10
        if at_end or is_nl:
            # A `use` / `public use` line begins with `u` (117) or `p` (112) at
            # column 0 - that is exactly what drv_use_name requires. Peek that
            # one byte straight out of `bs` and only materialise a Text (a slice
            # + a to_text, and a third byte list inside drv_use_name) for the
            # rare lines that could name an orb. Before this, EVERY line of the
            # entry allocated three times just to be told it wasn't a `use`,
            # which exhausted the heap on a multi-megabyte source and crashed
            # the compiler before it printed a single diagnostic.
            first = if line_start < i then bs[line_start] else -1
            if first is 117 or first is 112:
                line = text_of(bytes_part(bs, line_start, i))
                name = drv_use_name(line)
                if name is not "":
                    names = append(names, name)
            line_start = i + 1
        if at_end:
            break
        i = i + 1
    names

# True when the entry file IS the orb named. Pulling an orb in on top of
# itself would define every one of its functions twice, and orbs/iter is
# exactly the file that would hit it. Both separators, because the path
# reaches here as the platform wrote it.
define drv_entry_is_orb(entry_path: text, orb: text) -> truth:
    contains(entry_path, "/{orb}/lib.or") or contains(entry_path, "{orb}" + "\\" + "lib.or")

define drv_list_has(items: [text], needle: text) -> truth:
    n = length(items)
    edit found = false
    loop i in 0 until n:
        if items[i] is needle:
            found = true
    found

# Try each root for NAME/lib.or. Empty text = not found (orb sources
# are never empty).
define drv_resolve(name: text, roots: [text]) -> text:
    n = length(roots)
    edit src = ""
    loop i in 0 until n:
        if src is "":
            root = roots[i]
            candidate = "{root}{name}/lib.or"
            attempt = file_read(candidate)
            if attempt is not "":
                src = attempt
    src

# Which PATH an orb resolved from. Same search as drv_resolve, but it answers
# where the text came from instead of what it was, which is what an error
# message needs: without it a diagnostic can only name a line in the
# concatenated program, i.e. a line in no file that exists on disk.
define drv_resolve_path(name: text, roots: [text]) -> text:
    n = length(roots)
    edit path = ""
    loop i in 0 until n:
        if path is "":
            root = roots[i]
            candidate = "{root}{name}/lib.or"
            if file_read(candidate) is not "":
                path = candidate
    path

define drv_count_lines(s: text) -> number:
    b = bytes_of(s)
    n = length(b)
    edit count = 0
    loop i in 0 until n:
        if b[i] is 10:
            count = count + 1
    count

# Record one chunk of the concatenated program: the bundle line its `orb`
# marker sits on, and the file it came from. `otir_where` (orion_ast_to_ir)
# reads these back to turn a bundle line into `file:line:col`.
define drv_map_chunk(index: number, marker_line: number, path: text):
    slot_set("src:map:{index}:at", marker_line)
    slot_set("src:map:{index}:path", orion_persist_text(path))
    slot_set("src:map:n", index + 1)

external define orion_console_color() -> int
# Slot-stored text must outlive the transient allocation it was built in.
external define orion_persist_text(s: text) -> text
external define orion_os_private_kb() -> int
external define atlas_rss_kb() -> int

# `PERF` row on demand: any argument equal to `--perf`, or ORION_PERF=1 in the
# environment via the `perf` output-path suffix. Kept opt-in so normal builds
# print the human line only.
define drv_want_perf() -> truth:
    edit want = false
    loop ai in 1 until argc():
        if argv(ai) is "--perf":
            want = true
    want

# `--quiet` drops the progress chatter -- the orb count, the timing line and
# the written path -- and keeps everything that means something: diagnostics,
# the unbalanced-region warning, the failure summary. `orbit run` sets it, so
# running a program shows the PROGRAM's output and not three lines about how
# its compilation went.
define drv_want_quiet() -> truth:
    edit want = false
    loop ai in 1 until argc():
        if argv(ai) is "--quiet":
            want = true
    # A caller compiling in-process (the test runner) can silence the chatter
    # via this slot without touching argv.
    if slot_has("drv:quiet") and slot_get_number("drv:quiet") is 1:
        want = true
    want

# A flag is not a directory. Orb roots were taken from every argument at index
# 3 and up, so `--perf` quietly became a search path named `--perf/` that could
# never resolve. Harmless by luck, wrong by construction.
define drv_is_flag(a: text) -> truth:
    bs = bytes_of(a)
    length(bs) >= 2 and bs[0] is 45 and bs[1] is 45

define drv_total_insts(m: IRModule) -> number:
    edit total = 0
    loop fi in 0 until length(m.functions):
        f = m.functions[fi]
        total = total + length(f.instructions)
    total

define drv_sty(code: text, s: text) -> text:
    if orion_console_color() is 1:
        e = text_of(append([], 27))
        "{e}[{code}m{s}{e}[0m"
    else:
        s

define drv_dim(s: text) -> text:
    drv_sty("2", s)

define drv_red(s: text) -> text:
    drv_sty("31;1", s)

define drv_green(s: text) -> text:
    drv_sty("32", s)

# ---- `symbols`: the compiler's own index, for tools --------------------
#
# One row per declaration, tab-free and line-oriented so a client can read it
# without a parser:
#
#   TYPE Point|x:int,y:int
#   SUM Tile|Empty,Wall,Loot
#   FN area|p:Point|int
#   EFFECT Random|roll
#   CONST LIMIT
#
# Types are printed as WRITTEN (source form), because that is what a completion
# list or a hover has to show. The alternative - letting the editor re-derive
# this from the text - is how the previous language server ended up describing a
# language that no longer existed.

define drv_type_name(t: table) -> text:
    kind = get(t, "kind")
    if kind is "List":
        inner = drv_type_name(get_map(t, "elem"))
        "[{inner}]"
    else:
        if kind is "Named":
            base = get(t, "name")
            targs = if has(t, "args") then get_list(t, "args") else []
            if length(targs) is 0:
                base
            else:
                edit acc = ""
                loop ai in 0 until length(targs):
                    sep = if ai is 0 then "" else ","
                    acc = "{acc}{sep}{drv_type_name(targs[ai])}"
                "{base}<{acc}>"
        else:
            if kind is "FnType":
                "fn"
            else:
                "?"

define drv_symbols(ast: table) -> number:
    decls = get_list(ast, "decls")
    edit orb_now = ""
    loop di in 0 until length(decls):
        d = decls[di]
        k = get(d, "kind")
        if k is "OrbMark":
            orb_now = get(d, "name")
        if k is "Fn":
            params = get_list(d, "params")
            edit psig = ""
            loop pi in 0 until length(params):
                p = params[pi]
                sep = if pi is 0 then "" else ","
                pty = if has(p, "type") then drv_type_name(get_map(p, "type")) else "int"
                psig = "{psig}{sep}{get(p, \"name\")}:{pty}"
            rty = if has(d, "ret") then drv_type_name(get_map(d, "ret")) else "?"
            print_line("FN {get(d, \"name\")}|{psig}|{rty}|{orb_now}")
        if k is "Data":
            fields = get_list(d, "fields")
            edit fsig = ""
            loop fi in 0 until length(fields):
                f = fields[fi]
                sep2 = if fi is 0 then "" else ","
                fty = if has(f, "type") then drv_type_name(get_map(f, "type")) else "?"
                fsig = "{fsig}{sep2}{get(f, \"name\")}:{fty}"
            print_line("TYPE {get(d, \"name\")}|{fsig}|{orb_now}")
        if k is "Enum":
            variants = get_list(d, "variants")
            edit vsig = ""
            loop vi in 0 until length(variants):
                sep3 = if vi is 0 then "" else ","
                vsig = "{vsig}{sep3}{get(variants[vi], \"name\")}"
            print_line("SUM {get(d, \"name\")}|{vsig}|{orb_now}")
        if k is "Const":
            print_line("CONST {get(d, \"name\")}||{orb_now}")
    0

# Discover the whole use-graph from the entry source; return the
# combined program text (orbs in discovery order, entry last).
# Quiet by design: one dim summary line instead of a line per orb -
# unresolved `use` means builtin, which is the normal case, not news.
# Orbs every program gets without asking. `each` / `keep` / `combine` and
# `assert` are what the syntax reference calls builtins, and a reader who has
# to be told to write `use iter` first has been handed a rule that explains
# nothing. Costs nothing: unused orb functions are already stripped, so a
# hello-world compiles to the same bytes with and without them.
#
# `core` is the two types - `maybe` and `result` - and nothing else. The
# syntax reference lists them among the types, next to `text` and `table`,
# and a type you have to import first is not one of those. Their variants
# resolve LAST (see otir_core_enum), so a program that declares a `Some` or
# an `Ok` of its own keeps it.
#
# The FUNCTIONS over those types (`unwrap_or`, `is_some`, `err_msg`) stay in
# `option` and `result` behind a `use`. Those two share the name `unwrap_or`,
# so making both visible everywhere would make that one name ambiguous in
# every program in the language.
define drv_always_used() -> [text]:
    ["core", "iter", "assert"]

# The one-level subdirectory names of `dir`, newline-joined. Same call the LSP
# uses to find orbs on a root.
external define orion_dir_subdirs(dir: text) -> text

# ---- Auto-use: the compiler already knew the answer ----
#
# `trim(s)` without a `use text` used to say "`trim` needs a `use`; it is
# exported by `text`" - a diagnostic that names the exact line it wants you to
# type. A tool that can write the answer should not make you copy it.
#
# So: a name that resolves to EXACTLY ONE orb on the search path pulls that orb
# in. Two orbs exporting it is still an error naming both, and `use` is what
# answers it - which is the job `use` was always doing, now the only one. Of
# 647 public names across the 45 orbs here, 5 are exported twice.
#
# Free at runtime: unused orb functions are already stripped, so a program
# compiles to the same bytes whether an orb was pulled in or not.
#
# The index is built once per compile and cached in slots:
#   expby:<name> -> orb, or "?" when more than one exports it.
define drv_build_export_index(roots: [text]):
    if slot_has("drv:idx"):
        return
    slot_set("drv:idx", 1)
    # EVERY root that is a directory OF orbs. The first-root-only rule read
    # well and did nothing: a project entry at `src/main.or` makes the first
    # root `src/orbs/`, which no project has, so the index came up empty and
    # every one of the thousand `use` lines in the corpus was load-bearing.
    #
    # A root that itself holds a `lib.or` is an ORB, not a root - `orbit`
    # passes both the orbs it resolved and their parents, and listing the
    # inside of one orb indexes nothing but its own files.
    #
    # Reaching wider is safe because of what it does on a clash: two orbs
    # exporting one name is an error that NAMES both, and `use` answers it.
    # The old note here worried about `atlas_ecs` arriving uninvited; what
    # stopped that was the rule that a name the program declares itself is
    # never auto-imported, not the number of roots.
    near_n = if slot_has("drv:near") then slot_get_number("drv:near") else length(roots)
    loop ri in 0 until near_n:
        root = roots[ri]
        if file_read("{root}lib.or") is "":
            drv_index_root(root, orion_dir_subdirs(root))

# One root: the newline-joined subdirectory names, walked byte by byte. No
# `split` - the driver has no `use text`, and adding one to reach a helper
# this file already has a shape for would be the wrong trade.
define drv_index_root(root: text, listing: text):
    b = bytes_of(listing)
    n = length(b)
    edit start = 0
    edit i = 0
    loop:
        if i > n:
            break
        at_end = i is n
        is_nl = if at_end then false else b[i] is 10
        if at_end or is_nl:
            if i > start:
                drv_index_orb(root, text_of(bytes_part(b, start, i)))
            start = i + 1
        if at_end:
            break
        i = i + 1

# Record every `public define NAME` in one orb. A second orb claiming a name
# marks it "?" - ambiguous, and the caller must say which.
define drv_index_orb(root: text, orb: text):
    src = file_read("{root}{orb}/lib.or")
    if src is "":
        return
    b = bytes_of(src)
    n = length(b)
    edit start = 0
    edit i = 0
    loop:
        if i > n:
            break
        at_end = i is n
        is_nl = if at_end then false else b[i] is 10
        if at_end or is_nl:
            # Only a line starting with `p` can be `public define`.
            first = if start < i then b[start] else 0 - 1
            if first is 112:
                drv_note_export(text_of(bytes_part(b, start, i)), orb)
            start = i + 1
        if at_end:
            break
        i = i + 1

# `expby:<name>` holds every orb that exports it, space-joined. The LIST and
# not a yes/no, because the one job left for `use` is answering WHICH - and an
# error that cannot name the candidates does not let you answer it.
define drv_note_export(line: text, orb: text):
    name = drv_public_name(line)
    if name is not "":
        key = "{drv_public_kind(line)}:{name}"
        seen = if slot_has(key) then slot_get(key) else ""
        if seen is "":
            slot_set(key, orb)
        if seen is not "" and not drv_word_in(seen, orb):
            slot_set(key, "{seen} {orb}")

# Is `word` one of the space-separated words in `list`?
define drv_word_in(list: text, word: text) -> truth:
    b = bytes_of(list)
    n = length(b)
    edit start = 0
    edit hit = false
    edit i = 0
    loop:
        if i > n:
            break
        at_end = i is n
        is_sp = if at_end then false else b[i] is 32
        if at_end or is_sp:
            if text_of(bytes_part(b, start, i)) is word:
                hit = true
            start = i + 1
        if at_end:
            break
        i = i + 1
    hit

# The one orb that exports `name`, or "" when none or more than one does.
define drv_sole_exporter(name: text, index: text) -> text:
    key = "{index}:{name}"
    if not slot_has(key):
        return ""
    listed = slot_get(key)
    if contains(listed, " "):
        return ""
    listed

# `expby:` for what you CALL, `expty:` for what you name as a TYPE. Two
# indexes and not one, because the two are looked up from different places in
# the source and a name can honestly be both - `point` the constructor and
# `point` the record. A call site asking the type index would import an orb
# for a name it never calls.
define drv_public_kind(line: text) -> text:
    if drv_head_is(line, "public type "):
        "expty"
    else:
        "expby"

define drv_head_is(line: text, head: text) -> truth:
    b = bytes_of(line)
    h = length(head)
    length(b) > h and text_of(bytes_part(b, 0, h)) is head

# The name in `public define NAME` or `public type NAME`. Skips "public " and
# then the keyword, so a third kind added later needs no change here.
define drv_public_name(line: text) -> text:
    b = bytes_of(line)
    n = length(b)
    if n < 15:
        return ""
    if not (drv_head_is(line, "public define ") or drv_head_is(line, "public type ")):
        return ""
    kw = if drv_head_is(line, "public type ") then 12 else 14
    edit i = kw
    edit stop = kw
    loop:
        if i >= n:
            break
        c = b[i]
        is_word = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c is 95
        if not is_word:
            break
        i = i + 1
        stop = i
    if stop <= kw:
        return ""
    text_of(bytes_part(b, kw, stop))

# Which orbs this source reaches for without importing them. Lexed, not
# pattern-matched: a name in a comment or a string is not a dependency, and
# guessing from raw bytes would pull orbs in for mentioning them.
# Every name this source DECLARES, remembered so auto-use never reaches for
# an orb over a name that is already answered here. Without it the compiler's
# own bundle pulled in a pile of orbs for mentioning `split`, `trim` and
# `ok` - names it defines itself - and its emit phase took twice as long.
define drv_note_defines(src: text, owner: text):
    b = bytes_of(src)
    n = length(b)
    edit start = 0
    edit i = 0
    loop:
        if i > n:
            break
        at_end = i is n
        is_nl = if at_end then false else b[i] is 10
        if at_end or is_nl:
            first = if start < i then b[start] else 0 - 1
            # `define f(` at column 0, or `public define f(`. Also `type T:`
            # and `public type T:` - a program that declares its own `Point`
            # must not have one fetched for it, and types are auto-imported
            # now too. Without it a test that wrote `type Point:` pulled in
            # `ori_geometry` for the word.
            if first is 100 or first is 112 or first is 116:
                nm = drv_declared_name(text_of(bytes_part(b, start, i)))
                if nm is not "":
                    slot_set("drvdef:{slot_get_number(\"drv:cnum\")}:{owner}:{nm}", 1)
            start = i + 1
        if at_end:
            break
        i = i + 1

# `define foo(` / `public define foo(` -> "foo"; anything else -> "".
define drv_declared_name(line: text) -> text:
    b = bytes_of(line)
    n = length(b)
    edit at = 0
    if n >= 14 and text_of(bytes_part(b, 0, 14)) is "public define ":
        at = 14
    if at is 0 and n >= 12 and text_of(bytes_part(b, 0, 12)) is "public type ":
        at = 12
    if at is 0 and n >= 7 and text_of(bytes_part(b, 0, 7)) is "define ":
        at = 7
    if at is 0 and n >= 5 and text_of(bytes_part(b, 0, 5)) is "type ":
        at = 5
    if at is 0:
        return ""
    edit i = at
    edit stop = at
    loop:
        if i >= n:
            break
        c = b[i]
        is_word = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c is 95
        if not is_word:
            break
        i = i + 1
        stop = i
    if stop <= at:
        return ""
    text_of(bytes_part(b, at, stop))

# The code inside a string's `{...}` holes, joined with newlines. The lexer
# hands back one `str` token for `"{min(3, 7)}"` - the holes are parsed much
# later - so a call written in a hole was invisible to auto-use. `m = min(3, 7)`
# imported `num`; `"{min(3, 7)}"` said the function did not exist.
#
# `\{` is an escaped brace and not a hole, so a backslash skips the next byte.
#
# The bytes go into a LIST and become a text once. Built with `out = out + b`
# it was quadratic, and the compiler's own bundle - a megabyte with thousands
# of holes - stopped finishing.
define drv_holes(src: text) -> text:
    b = bytes_of(src)
    n = length(b)
    edit out = []
    edit i = 0
    edit depth = 0
    edit start = 0
    loop:
        if i >= n:
            break
        c = b[i]
        if c is 92:
            i = i + 2
        else:
            if c is 123:
                if depth is 0:
                    start = i + 1
                depth = depth + 1
                i = i + 1
            else:
                if c is 125 and depth > 0:
                    depth = depth - 1
                    if depth is 0:
                        loop hj in start until i:
                            out = append(out, b[hj])
                        out = append(out, 10)
                    i = i + 1
                else:
                    i = i + 1
    text_of(out)

define drv_auto_uses(src: text, already: [text], owner: text) -> [text]:
    edit found = []
    # A hole is code the lexer never handed over as code. Lex it too, and the
    # same ident-then-`(` rule applies to both streams.
    edit toks = self_lex(src)
    loop st in self_lex(drv_holes(src)):
        toks = append(toks, st)
    n_toks = length(toks)
    # Only a name in CALL position - an ident with a `(` right after it. A
    # bare ident is usually a local: `first = xs[0]` pulled in the `list` orb
    # for the word `first`, and one test dragged five orbs in that way. What
    # gets imported has to be what gets called.
    loop ti in 0 until n_toks:
        tok = toks[ti]
        nxt = if ti + 1 < n_toks then toks[ti + 1] else tok
        is_call = ti + 1 < n_toks and get(nxt, "kind") is "symbol" and get(nxt, "value") is "("
        # A TYPE is never called, so it gets its own trigger: the ident sits
        # right after `:`, `->`, `of` or `[`. Those four are where a type name
        # can stand and a local cannot. It reads the TYPE index, so a
        # `{"key": value}` that lands here reaches for nothing.
        #
        # This was too dangerous while the index covered the whole search path:
        # a type name is a global layout key, so one wrong guess gives two
        # layouts of one name and a program that will not link - the compiler's
        # own `Param` met atlas's. The index is the NEAR roots now, which is
        # what this project declared, so the name a type resolves to is one
        # the project already depends on.
        prv = if ti > 0 then toks[ti - 1] else tok
        pv = get(prv, "value")
        is_type = ti > 0 and (not is_call) and (pv is ":" or pv is "->" or pv is "of" or pv is "[")
        if get(tok, "kind") is "ident" and (is_call or is_type):
            name = get(tok, "value")
            # A name is looked up ONCE per compile. The compiler's own bundle
            # is 200k ident tokens over a few thousand distinct names, and
            # building a key plus two linear list scans for every occurrence
            # is what made the self-compile take twice as long as it used to.
            # The four core words never reach for an orb. `ok` is a function
            # in `file` and `net`, `error` is one in `log`, and a function
            # that resolves beats the spoken constructor - so importing one of
            # those orbs on sight would quietly take `ok(v)` and `error(m)`
            # away from every program that writes them. Say `use log` and you
            # get log's; say nothing and you get the core's.
            is_core_word = name is "some" or name is "none" or name is "ok" or name is "error"
            cn = slot_get_number("drv:cnum")
            # Per OWNER, not per compile. The cache is here to stop one name
            # being resolved once per occurrence, but the caller turns each
            # answer into a VISIBILITY record for the file it came from - so a
            # compile-wide key let the first file that said `value_copy` see
            # `astra_value` and left every other file being told to write the
            # `use` the compiler had already decided on.
            seen_key = "drvseen:{cn}:{owner}:{name}"
            # Per OWNER, like the cache. "The bundle defines it" is not the
            # same question as "this file can see it": `compile_error` lives in
            # `orion_ir`, and a compile-wide guard let the parser be told to
            # import an orb that the program had already loaded. What the guard
            # is for is a file not reaching for an orb over a name of its OWN.
            if (not is_core_word) and (not slot_has(seen_key)) and (not slot_has("drvdef:{cn}:{owner}:{name}")):
                slot_set(seen_key, 1)
                orb = drv_sole_exporter(name, if is_call then "expby" else "expty")
                # Reported even when the orb is already LOADED. Loading and
                # seeing are two things: the caller queues a load only for what
                # is missing, but every file that reaches for a name needs the
                # visibility record of its own, and filtering the answer away
                # here left the second file to mention `compile_error` being
                # told to import an orb that was already in the bundle.
                if orb is not "":
                    if not drv_list_has(found, orb):
                        found = append(found, orb)
    found

# One auto-use round over everything loaded so far plus the entry. Returns the
# queue, longer by whatever was still missing. Same list back means done.
define drv_auto_round(queue: [text], loaded_names: [text], owners: [text], sources: [text], entry_src: text, entry_path: text) -> [text]:
    edit q = queue
    loop si in 0 until length(sources):
        owner = owners[si]
        loop auto_dep in drv_auto_uses(sources[si], q, owner):
            if auto_dep is not owner:
                slot_set("drv:autouse:{slot_get_number(\"drv:cnum\")}:{owner}:{auto_dep}", 1)
                if not drv_list_has(loaded_names, auto_dep):
                    q = append(q, auto_dep)
    loop auto in drv_auto_uses(entry_src, q, ""):
        if not drv_entry_is_orb(entry_path, auto):
            # Loading the source is only half of it - a name still has to be
            # VISIBLE, and visibility comes from a `use`. The driver records
            # the import it just decided on where the resolver looks. The entry
            # program's own orb name is "".
            slot_set("drv:autouse:{slot_get_number(\"drv:cnum\")}::{auto}", 1)
            if not drv_list_has(loaded_names, auto):
                q = append(q, auto)
    q

public define drv_collect(entry_src: text, roots: [text], entry_path: text) -> text:
    drv_build_export_index(roots)
    # Everything below is per COMPILE, not per process. One test runner
    # compiles two hundred files in a single process, and a `drvseen:` or
    # `drvdef:` left over from the last file silenced the next one - the
    # second program to call `trim` was told it did not exist. The export
    # index is the only thing that survives: it is read off disk and does
    # not change.
    slot_set("drv:cnum", slot_get_number("drv:cnum") + 1)
    drv_note_defines(entry_src, "")
    edit queue = drv_uses_of(entry_src)
    # An orb never implicitly uses ITSELF - that is a cycle, and orbs/iter is
    # where `each` lives, so it is exactly the file that would hit it.
    loop implicit in drv_always_used():
        already = drv_list_has(queue, implicit)
        is_self = drv_entry_is_orb(entry_path, implicit)
        if (not already) and (not is_self):
            queue = append(queue, implicit)
    edit loaded_names = []
    edit owners = []
    edit sources = []
    edit chunks = []
    edit qi = 0
    edit orb_count = 0
    edit orb_bytes = 0
    # Bundle line the NEXT chunk's `orb` marker will land on (1-based, like the
    # lexer). Each chunk costs: 1 marker line + the source's lines + 1 blank.
    edit line_at = 1
    edit map_n = 0
    loop:
        if qi >= length(queue):
            # Everything WRITTEN is loaded. Only NOW does auto-use look at what
            # is still missing - an orb you imported yourself has to be the one
            # that answers a name. Scanning the entry first pulled `raster` into
            # veil for the word `render`, which `veil_web` already exports, and
            # turned a program that built into an ambiguity about an orb nobody
            # named.
            grown = drv_auto_round(queue, loaded_names, owners, sources, entry_src, entry_path)
            if length(grown) is length(queue):
                break
            queue = grown
        if qi >= length(queue):
            break
        name = queue[qi]
        qi = qi + 1
        if drv_list_has(loaded_names, name):
            continue
        loaded_names = append(loaded_names, name)
        path = drv_resolve_path(name, roots)
        src = if path is "" then "" else file_read(path)
        if src is "":
            continue
        drv_map_chunk(map_n, line_at, path)
        map_n = map_n + 1
        line_at = line_at + drv_count_lines(src) + 2
        orb_count = orb_count + 1
        orb_bytes = orb_bytes + length(bytes_of(src))
        # Stamp each chunk with its origin. The program is ONE concatenated
        # text by the time the lexer sees it, so without this marker every
        # function in the build looks like it came from the same place - which
        # is exactly why the namespace was flat and two orbs could not both
        # have a private helper of the same name.
        q = text_of(append([], 34))
        chunks = append(chunks, "orb " + q + name + q + "\n")
        chunks = append(chunks, src)
        chunks = append(chunks, "\n")
        drv_note_defines(src, name)
        owners = append(owners, name)
        sources = append(sources, src)
        deps = drv_uses_of(src)
        n_deps = length(deps)
        loop di in 0 until n_deps:
            queue = append(queue, deps[di])
    okb = orb_bytes // 1024
    if not drv_want_quiet():
        print_line(drv_dim("  orbs {orb_count} ({okb} KB)"))
    # The entry program is its own scope: `""` owns whatever it declares
    # privately, so a game's local helper cannot collide with an orb's.
    eq = text_of(append([], 34))
    drv_map_chunk(map_n, line_at, entry_path)
    chunks = append(chunks, "orb " + eq + eq + "\n")
    chunks = append(chunks, entry_src)
    orion_text_join(chunks)

# ---- Effect inference: facts all the way down (Orion 2 / L2 v0) ----
# `orion <input> facts` prints every function's inferred effect row
# instead of emitting LLVM: slot/io/platform/audio/extern/mem/time,
# or `pure`. Direct effects classify dedicated ops and extern call
# targets; user calls close transitively. This is the substrate for
# effect signatures, parallel compiler passes and the B9
# determinism certificate.

# ---- Region scope balance: the static half of the memory-safety story ----
#
# Which region an allocation lands in is a MODE, opened and closed by explicit
# calls. A function that opens one and does not close it leaves every LATER
# allocation in the wrong region: an unclosed persist scope routes transient
# values to the immortal heap, which is the one shape that is a real leak here,
# and an unclosed pool or arena scope leaves them to die at the next reset,
# which is a dangle. Both surface far from their cause.
#
# They are also visible right here, in the IR, before anything runs: count the
# opens and the closes per mode per function.
#
# HONEST SCOPE: this counts, it does not trace paths. Unequal totals are always
# wrong. EQUAL totals on divergent paths - an early `return` between the open
# and the close - are also wrong, and this pass does NOT catch them. Said out
# loud because a checker that appears to prove more than it does is worse than
# no checker.
# EXACT names, never prefixes: `orion_persist_text` is an allocation, not a mode
# switch, and matching the prefix reported every logging helper in the tree.
#
# The ARENA is deliberately absent. It is not used as a balanced scope: the
# dispatch path opens it if it is not already open and RESETS at exit rather
# than closing ("entry only ensures the arena is ON"), so open and close counts
# are not meant to match and demanding they do produces noise, not findings.
define drv_mode_stem(callee: text) -> text:
    if callee is "orion_persist_on" or callee is "orion_persist_off":
        "persist"
    else if callee is "orion_pool_on" or callee is "orion_pool_off":
        "pool"
    else if drv_ends(callee, "state_alloc_on") or drv_ends(callee, "state_alloc_off"):
        "state_alloc"
    else if drv_ends(callee, "world_alloc_on") or drv_ends(callee, "world_alloc_off"):
        "world_alloc"
    else:
        ""

# A function whose own name ends in `_on`, `_off` or `_st` IS a scope primitive:
# opening or closing is its whole job, so it is unbalanced by definition and
# reporting it says nothing about the code that uses it.
define drv_is_scope_primitive(name: text) -> truth:
    drv_ends(name, "_on") or drv_ends(name, "_off") or drv_ends(name, "_st")

define drv_ends(t: text, suffix: text) -> truth:
    bt = bytes_of(t)
    bs = bytes_of(suffix)
    n = length(bt)
    m = length(bs)
    if m > n:
        false
    else:
        edit same = true
        loop i in 0 until m:
            if bt[n - m + i] is not bs[i]:
                same = false
        same

# `_off` closes, `_on` opens. orion_pool_off/orion_pool_on match the same stem,
# and orion_pool_reset/_used/_high do not (the stem check above stops at `_o`).
define drv_is_close(callee: text) -> truth:
    drv_ends(callee, "_off")

# One line per unbalanced (function, mode). Returns how many it found.
define drv_scope_check(module: IRModule, verbose: number) -> number:
    fns = module.functions
    edit bad = 0
    loop fi in 0 until length(fns):
        f = drv_fn_at(fns, fi)
        if drv_is_scope_primitive(f.name):
            continue
        edit stems = part([""], 0, 0)
        edit opens = part([0], 0, 0)
        edit closes = part([0], 0, 0)
        edit depth = part([0], 0, 0)      # running open-minus-close, in order
        loop ii in 0 until length(f.instructions):
            inst = drv_inst_at(f.instructions, ii)
            if inst.op is "call":
                stem = drv_mode_stem(inst.name)
                if stem is not "":
                    edit idx = drv_name_idx(stems, stem)
                    if idx < 0:
                        stems = append(stems, stem)
                        opens = append(opens, 0)
                        closes = append(closes, 0)
                        depth = append(depth, 0)
                        idx = length(stems) - 1
                    if drv_is_close(inst.name):
                        closes = set(closes, idx, drv_int_at(closes, idx) + 1)
                        depth = set(depth, idx, drv_int_at(depth, idx) - 1)
                    else:
                        opens = set(opens, idx, drv_int_at(opens, idx) + 1)
                        depth = set(depth, idx, drv_int_at(depth, idx) + 1)
            # A return reached with a scope still open leaks it on THAT path -
            # the exact case a whole-function open is close count cannot see (an
            # early `return` between the open and the matching close). The
            # final return has depth 0 in a balanced function, so only an early
            # one trips this.
            if inst.op is "return":
                loop si in 0 until length(stems):
                    if drv_int_at(depth, si) > 0:
                        bad = bad + 1
                        if verbose is 1:
                            print_line("    {f.name}: returns with {text_at_drv(stems, si)} still open (early return between open and close)")
        loop si in 0 until length(stems):
            o = drv_int_at(opens, si)
            c = drv_int_at(closes, si)
            if o is not c:
                bad = bad + 1
                if verbose is 1:
                    st = text_at_drv(stems, si)
                    print_line("    {f.name}: {st} opened {o}x, closed {c}x")
    bad

define text_at_drv(xs: [text], i: number) -> text:
    xs[i]

define drv_fn_at(fs: [IRFn], i: number) -> IRFn:
    fs[i]

define drv_inst_at(xs: [Inst], i: number) -> Inst:
    xs[i]

define drv_starts(t: text, p: text) -> truth:
    tb = bytes_of(t)
    pb = bytes_of(p)
    pn = length(pb)
    if length(tb) < pn:
        return false
    loop i in 0 until pn:
        if tb[i] is not pb[i]:
            return false
    true

define drv_flag(x: number, f: number) -> truth:
    (x // f) - (x // (f * 2)) * 2 is 1

define drv_or(a: number, b: number) -> number:
    edit out = a
    edit f = 1
    loop i in 0 until 8:
        if drv_flag(b, f) and not drv_flag(out, f):
            out = out + f
        f = f * 2
    out

define drv_name_idx(names: [text], name: text) -> number:
    n = length(names)
    loop i in 0 until n:
        if names[i] is name:
            return i
    0 - 1

define drv_int_at(xs: [number], i: number) -> number:
    xs[i]

define drv_call_bits(callee: text, names: [text]) -> number:
    # Effect prefixes are checked FIRST, before the "is it a user fn?"
    # short-circuit. Externs are added to the module as body-less IRFns, so an
    # effectful extern like `__orion_monotonic_ms` is IN `names` - and the old
    # order returned 0 for it, making every time/platform/audio extern invisible
    # to the effect closure (and so to the `deterministic` check). User fns are
    # mangled `orb__name`, so they can never match these runtime prefixes; a name
    # that matches a prefix is the C symbol, whatever the module also lists.
    if drv_starts(callee, "orion_audio"):
        return 8
    if drv_starts(callee, "win_") or drv_starts(callee, "og_") or drv_starts(callee, "ogpu_"):
        return 4
    if drv_starts(callee, "orion_arena") or drv_starts(callee, "orion_persist") or drv_starts(callee, "orion_pool") or drv_starts(callee, "orion_frame") or drv_starts(callee, "orion_ledger") or drv_starts(callee, "orion_alloc") or drv_starts(callee, "orion_slot"):
        return 32
    if drv_starts(callee, "__orion_monotonic") or drv_starts(callee, "__orion_time") or drv_starts(callee, "__orion_sleep"):
        return 64
    if drv_starts(callee, "orion_console") or drv_starts(callee, "orion_dir") or drv_starts(callee, "orion_file") or drv_starts(callee, "orion_embedded"):
        return 2
    # 128: libm transcendentals - the ONE thing about `number` arithmetic that
    # is NOT bit-exact across platforms (different libms round the last bits
    # differently). Basic ops, sqrt, floor/ceil/round ARE exact per IEEE-754
    # on every target we emit for, so `number` needs no fixed-point type -
    # determinism is guaranteed by forbidding exactly this list.
    if callee is "sin" or callee is "cos" or callee is "tan" or callee is "exp" or callee is "log" or callee is "pow" or callee is "atan2":
        return 128
    # A user fn contributes its effects through the closure, not here.
    if drv_name_idx(names, callee) >= 0:
        return 0
    16

define drv_direct_bits(f: IRFn, names: [text]) -> number:
    edit bits = 0
    n = length(f.instructions)
    loop i in 0 until n:
        inst = drv_inst_at(f.instructions, i)
        op = inst.op
        if op is "slot_set" or op is "slot_get" or op is "slot_has" or op is "slot_get_int":
            bits = drv_or(bits, 1)
        if op is "print_int" or op is "print_str" or op is "print_float" or op is "file_read" or op is "file_write":
            bits = drv_or(bits, 2)
        if op is "call":
            bits = drv_or(bits, drv_call_bits(inst.name, names))
        # Transcendentals lower to their OWN op (fmath1/fmath2), not "call" -
        # they were invisible to this walk, so `deterministic` never saw them.
        if op is "fmath1" or op is "fmath2":
            bits = drv_or(bits, drv_call_bits(inst.name, names))
    bits

define drv_flags_text(bits: number) -> text:
    if bits is 0:
        return "pure"
    edit out = ""
    if drv_flag(bits, 1):
        out = out + " slot"
    if drv_flag(bits, 2):
        out = out + " io"
    if drv_flag(bits, 4):
        out = out + " platform"
    if drv_flag(bits, 8):
        out = out + " audio"
    if drv_flag(bits, 16):
        out = out + " extern"
    if drv_flag(bits, 32):
        out = out + " mem"
    if drv_flag(bits, 64):
        out = out + " time"
    if drv_flag(bits, 128):
        out = out + " libm-transcendentals (sin/cos/tan/exp/ln/pow round differently across platforms; +-*/, sqrt, floor, round ARE bit-exact and stay allowed)"
    out

# The transitive effect bits per function: each fn's own effects unioned with
# everything it (transitively) calls, to a fixpoint. Shared by `facts` and the
# `deterministic` enforcement below - one closure, two readers.
# Drop functions nothing can reach from `main`.
#
# `use text` pulls the WHOLE orb into the program, and every one of its
# functions used to be lowered and emitted - so a program that called `trim`
# still emitted `run_command`, and the linker demanded `sys_run` from a C file
# it was never given ("undefined symbol: sys_run" for a program that shells out
# to nothing). Reachability fixes the general case: what you do not call is not
# emitted, so an orb costs what you use of it.
#
# Roots: `main`, plus anything reached indirectly - effect handlers, and any
# function whose ADDRESS is taken (a closure/callback: `each(xs, f)` passes
# `fn_ref`, and par_run/call_ptr call through the pointer). Those show up as
# `fn_ref` instructions, so the walk seeds from them too. Conservative by
# construction: a name we cannot prove unreachable stays.
define drv_reachable(module: IRModule) -> [number]:
    fns = module.functions
    n = length(fns)
    edit names = []
    loop i in 0 until n:
        names = append(names, drv_fn_at(fns, i).name)
    edit live = []
    loop i in 0 until n:
        nm = names[i]
        # main and handlers are entry points; a handler is reached by the
        # runtime, never by a call instruction.
        root = drv_ends(nm, "main") or drv_ends(nm, "_handler") or contains(nm, "__handler_") or drv_starts(nm, "__orion_handler")
        live = append(live, if root then 1 else 0)
    edit pass = 0
    loop:
        if pass >= 32:
            break
        edit changed = 0
        loop i in 0 until n:
            if drv_int_at(live, i) is 1:
                f = drv_fn_at(fns, i)
                loop j in 0 until length(f.instructions):
                    inst = drv_inst_at(f.instructions, j)
                    # A call names its callee; fn_ref names a function whose
                    # address is taken (closures, par_run workers, call_ptr).
                    if inst.op is "call" or inst.op is "fn_ref" or inst.op is "make_closure" or inst.op is "closure_call":
                        idx = drv_name_idx(names, inst.name)
                        if idx >= 0:
                            if drv_int_at(live, idx) is 0:
                                live = set(live, idx, 1)
                                changed = 1
        if changed is 0:
            break
        pass = pass + 1
    live

# The module with unreachable functions removed.
define drv_prune(module: IRModule) -> IRModule:
    fns = module.functions
    live = drv_reachable(module)
    edit kept = []
    loop i in 0 until length(fns):
        if drv_int_at(live, i) is 1:
            kept = append(kept, drv_fn_at(fns, i))
    IRModule{functions: kept}

define drv_effect_closure(module: IRModule, names: [text]) -> [number]:
    fns = module.functions
    n = length(fns)
    edit bits = []
    loop i in 0 until n:
        bits = append(bits, drv_direct_bits(drv_fn_at(fns, i), names))
    edit pass = 0
    loop:
        if pass >= 24:
            break
        edit changed = 0
        edit next = []
        loop i in 0 until n:
            f2 = drv_fn_at(fns, i)
            cur = drv_int_at(bits, i)
            edit acc = cur
            ni = length(f2.instructions)
            loop j in 0 until ni:
                inst = drv_inst_at(f2.instructions, j)
                if inst.op is "call":
                    idx = drv_name_idx(names, inst.name)
                    if idx >= 0:
                        acc = drv_or(acc, drv_int_at(bits, idx))
            if acc is not cur:
                changed = 1
            next = append(next, acc)
        bits = next
        pass = pass + 1
        if changed is 0:
            break
    bits

define drv_module_names(module: IRModule) -> [text]:
    fns = module.functions
    edit names = []
    loop i in 0 until length(fns):
        names = append(names, drv_fn_at(fns, i).name)
    names

# `deterministic fn` enforcement (the effect certificate). A fn declared
# deterministic may not transitively touch a source of non-determinism:
#   2 io | 4 platform | 8 audio | 64 time
# slot/mem/extern are allowed - many deterministic ops use them, and a seeded
# RNG is deterministic (wall-clock time, bit 64, is what breaks a replay). This
# is the compile-time guarantee a deterministic simulation, and rollback
# netcode, rests on: the compiler proves the fn is replayable.
define drv_check_deterministic(module: IRModule) -> number:
    marked = deterministic_fn_names()
    if length(marked) is 0:
        return 0
    names = drv_module_names(module)
    bits = drv_effect_closure(module, names)
    nd_mask = drv_or(drv_or(drv_or(2, 4), drv_or(8, 64)), 128)
    edit bad = 0
    loop i in 0 until length(marked):
        idx = drv_name_idx(names, marked[i])
        if idx >= 0:
            eff = drv_int_at(bits, idx)
            hit = drv_flag_and(eff, nd_mask)
            if hit is not 0:
                bad = bad + 1
                compile_error("orion: ERROR - `deterministic fn` " + drv_deterministic_label(marked[i]) + " is not deterministic: it (transitively) performs " + drv_flags_text(hit))
    bad

# `orb__name` -> a readable `name` for the error; leaves already-plain names be.
define drv_deterministic_label(mangled: text) -> text:
    bs = bytes_of(mangled)
    n = length(bs)
    edit cut = 0 - 1
    loop i in 0 until n - 1:
        if bs[i] is 95 and bs[i + 1] is 95:
            cut = i + 2
    if cut < 0 then mangled else text_of(bytes_part(bs, cut, n))

define drv_flag_and(a: number, b: number) -> number:
    edit r = 0
    edit bit = 1
    loop i in 0 until 40:
        av = (a // bit) - ((a // bit) // 2) * 2
        bv = (b // bit) - ((b // bit) // 2) * 2
        if av is 1 and bv is 1:
            r = r + bit
        bit = bit * 2
    r

define drv_facts(module: IRModule) -> number:
    fns = module.functions
    n = length(fns)
    names = drv_module_names(module)
    bits = drv_effect_closure(module, names)
    edit pure_count = 0
    loop i in 0 until n:
        b = drv_int_at(bits, i)
        if b is 0:
            pure_count = pure_count + 1
        else:
            fl = drv_flags_text(b)
            fname = names[i]
            print_line("{fname}:{fl}")
    print_line("facts: {n} function(s), {pure_count} pure")
    0

# True when the output path ends in ".wasm".
define drv_wants_wasm(p: text) -> truth:
    b = bytes_of(p)
    n = length(b)
    if n < 5:
        return false
    b[n - 5] is 46 and b[n - 4] is 119 and b[n - 3] is 97 and b[n - 2] is 115 and b[n - 1] is 109

# Compile the AST straight to a .wasm module (bump-allocated linear memory,
# i32 + f64, structs, lists, extern host imports) and write the bytes. A Text
# is length-prefixed, so binary survives file_write untouched.
define drv_emit_wasm(ast: table, out_path: text) -> number:
    errs_before = compile_errors()
    # `number` picks its representation here too. The pass lived inside the
    # LLVM lowering, so this backend saw the word raw and did not know it -
    # the whole conformance suite went to zero the moment the stdlib started
    # writing it. One decision, both backends, or the word means two things.
    wast = num_pass(ast)
    wmodule = compile_program(get_list(wast, "decls"))
    wbytes = encode_module(wmodule)
    # Refuse to write invalid wasm: unsupported constructs report a compile
    # error during compile_program, same contract as the LLVM path.
    if compile_errors() > errs_before:
        print_line(drv_red("orion: wasm compilation FAILED - no output written"))
        return 1
    file_write(out_path, text_of(wbytes))
    if not (slot_has("drv:quiet")):
        print_line(drv_green("  ok") + drv_dim("  {out_path}"))
    0

public define driver_main() -> number:
    if argc() < 2:
        print_line("usage: orion_self <input.or> [output.ll] [orb-root...]")
        0 - 1
    else:
        in_path = argv(1)
        out_path = if argc() >= 3 then argv(2) else "out.ll"
        entry_src = file_read(in_path)
        if entry_src is "":
            print_line("orion: cannot read `{in_path}`")
            return 0 - 1
        base = drv_dirname(in_path)
        # Two kinds of root. NEAR is what this project declared plus the
        # toolchain and the directories around the entry - the orbs a person
        # would say belong to this program. FAR is `orbit`'s workspace sweep,
        # after the `--scan` marker: there so a name-only dep resolves wherever
        # it lives, and there is where a sibling project's `Param` sits.
        # Both RESOLVE. Only the near ones are auto-imported.
        edit near = []
        edit far = []
        edit past_scan = false
        loop ai in 3 until argc():
            extra = argv(ai)
            if extra is "--scan":
                past_scan = true
            else:
                if not drv_is_flag(extra):
                    if past_scan:
                        far = append(far, "{extra}/")
                    else:
                        near = append(near, "{extra}/")
        near = append(near, "{base}/orbs/")
        near = append(near, "{base}/../orbs/")
        near = append(near, "{base}/../../orbs/")
        near = append(near, "orbs/")
        near = append(near, "../orbs/")
        slot_set("drv:near", length(near))
        edit roots = near
        loop fr in far:
            roots = append(roots, fr)
        src = drv_collect(entry_src, roots, in_path)
        # `--trace` (orbit debug): ast_fn_to_ir prefixes every define with a
        # call-trail entry. Communicated by slot, like drv:quiet.
        loop flag_i in 1 until argc():
            if argv(flag_i) is "--trace":
                slot_set("drv:trace", 1)
        # `types`-laget: lowering skriver TYPEHINT rad:namn:typ for varje
        # let utan typannotation - editorns spok-typer (code vision).
        if out_path is "types":
            slot_set("drv:typehints", 1)
        # `refs`-laget: lowering skriver REF plats:namn:upplost for varje
        # anrop - kompilatorbackade referenser (usages/rename-precision).
        if out_path is "refs":
            slot_set("drv:refs", 1)
        t0 = monotonic_ms()
        tokens = self_lex(src)
        t1 = monotonic_ms()
        ast = self_parse(tokens)
        # BEFORE lowering: `ast_program_to_ir` mangles function names in place
        # (`area` -> `prog__area`) and drops the const declarations once it has
        # folded them, so asking it afterwards gives a tool the compiler's
        # internal names instead of the ones the user typed.
        if out_path is "symbols":
            return drv_symbols(ast)
        # `.wasm` output: compile straight to WebAssembly (own pipeline, no LLVM).
        if drv_wants_wasm(out_path):
            return drv_emit_wasm(ast, out_path)
        t2 = monotonic_ms()
        module = ast_program_to_ir(ast)
        t3 = monotonic_ms()
        if out_path is "facts":
            return drv_facts(module)
        # Enforce `deterministic fn` before emit: a violation is a compile
        # error, so the existing "no output on error" path below refuses to
        # write a binary that lies about being replayable.
        drv_check_deterministic(module)
        # Emit only what is reachable: an orb costs what you USE of it, not
        # what it contains (and no linker error for a C symbol behind a
        # function you never call).
        llvm_text = emit_module(drv_prune(module))
        t4 = monotonic_ms()
        d_lex = t1 - t0
        d_parse = t2 - t1
        d_ir = t3 - t2
        d_emit = t4 - t3
        d_total = t4 - t0
        if not drv_want_quiet():
            print_line(drv_dim("  compiled {d_total} ms (lex {d_lex} | parse {d_parse} | ir {d_ir} | emit {d_emit})"))
        # One machine-readable line for tracking compile performance over time.
        # `tools/compile_bench.sh` parses it and diffs against a checked-in
        # baseline, so a slowdown shows up as a number instead of a feeling.
        # Off by default: the row is only useful to a tool, so it needs asking.
        if drv_want_perf():
            src_bytes = length(bytes_of(src))
            src_lines = drv_count_lines(src) + 1
            n_fns = length(module.functions)
            n_insts = drv_total_insts(module)
            # Two numbers, because they are two things and the row used to
            # call one of them by the other's name. `rss_kb` is what is in RAM;
            # `commit_kb` is what the OS had to promise, and on this compiler's
            # own corpus they are 5,6 GB and 10,0 GB - the second is what
            # decides whether a 16 GB machine can build at all.
            kb = atlas_rss_kb()
            ckb = orion_os_private_kb()
            per_kloc = if src_lines > 0 then d_total * 1000 // src_lines else 0
            print_line("PERF total_ms={d_total} lex_ms={d_lex} parse_ms={d_parse} ir_ms={d_ir} emit_ms={d_emit} bytes={src_bytes} lines={src_lines} fns={n_fns} insts={n_insts} rss_kb={kb} commit_kb={ckb} ms_per_kloc={per_kloc}")
        # What the build knows about its own memory safety. The slot-store
        # boundary decides evacuate-or-abort from a statically derived type
        # code, so the set of sites that CAN abort is a compile-time fact -
        # worth stating next to the timings rather than meeting in a crash.
        if out_path is "types" or out_path is "refs":
            return 0
        if out_path is "slowfacts":
            slowfacts_list()
            print_line("")
            return 0
        if out_path is "memfacts":
            memfacts_list()
            print_line("  region scopes: opened and closed in the same function")
            print_line("")
            n_bad = drv_scope_check(module, 1)
            if n_bad is 0:
                print_line("    every region scope in this build is balanced")
            print_line("")
            return 0
        memfacts_report()
        slowfacts_report()
        # An unbalanced region scope is a real defect, not a statistic, so it
        # gets said on every build - but only when there is one.
        n_unbalanced = drv_scope_check(module, 0)
        if n_unbalanced > 0:
            print_line(drv_red("  memory: {n_unbalanced} unbalanced region scope(s) - `orbit memfacts` to name them"))
        n_errors = compile_errors()
        if n_errors > 0:
            print_line(drv_red("orion: compilation FAILED with {n_errors} error(s) - no output written"))
            0 - 1
        else:
            ok = file_write(out_path, llvm_text)
            if ok is 1:
                if not drv_want_quiet():
                    print_line(drv_green("  ok") + drv_dim("  {out_path}"))
                0
            else:
                print_line(drv_red("write failed"))
                0 - 1
