# num - the small integer helpers every program reaches for.
#
#   abs(-3)            ->  3
#   min(4, 9)          ->  4
#   max(4, 9)          ->  9
#   clamp(12, 0, 10)   ->  10
#   sign(-5)           ->  -1
#
# Floats: the language already gives you f64 arithmetic and the math builtins
# `sqrt sin cos tan exp log log2 floor ceil round atan2 pow` directly (no import
# needed). This orb adds what those leave out: `pi`, `e` (real consts), `abs` / `min` /
# `max` / `clamp`, and `parse_float` (the int-only `parse` above cannot read a decimal).

# Absolute value.
public define abs(x: number) -> number:
    example abs(0 - 5) is 5
    if x < 0 then 0 - x else x

# The smaller of two values.
public define min(a: number, b: number) -> number:
    example min(3, 7) is 3
    if a < b then a else b

# The larger of two values.
public define max(a: number, b: number) -> number:
    example max(3, 7) is 7
    if a > b then a else b

# Constrain `x` to the range [lo, hi].
public define clamp(x: number, lo: number, hi: number) -> number:
    example clamp(15, 0, 10) is 10
    if x < lo then lo else (if x > hi then hi else x)

# -1, 0, or 1 by the sign of `x`.
public define sign(x: number) -> number:
    example sign(0 - 9) is 0 - 1
    if x > 0 then 1 else (if x < 0 then 0 - 1 else 0)

# Greatest common divisor (Euclid). gcd(0, 0) is 0.
public define gcd(a: number, b: number) -> number:
    example gcd(12, 18) is 6
    edit x = abs(a)
    edit y = abs(b)
    loop:
        if y is 0:
            break
        t = y
        y = x % y
        x = t
    x

# Parse a base-10 integer out of text. A leading '-' negates; digits are
# read left to right and any non-digit is skipped. parse("") is 0.
#   parse("42")   ->  42
#   parse("-7")   ->  -7
# Pairs with split: split("3,4,5", ",") then parse each piece.
public define parse(t: text) -> number:
    example parse("42") is 42
    b = bytes_of(t)
    total = bytes_count(b)
    edit value = 0
    edit start = 0
    edit neg = 0
    if total > 0:
        if byte_at(b, 0) is 45:
            neg = 1
            start = 1
    loop i in start until total:
        d = byte_at(b, i)
        if d >= 48 and d <= 57:
            value = value * 10 + (d - 48)
    if neg is 1 then 0 - value else value

# Integer power (ipow): base^exp for exp >= 0. Negative exp yields 0.
#   ipow(2, 10)  ->  1024
public define ipow(base: number, exp: number) -> number:
    example ipow(2, 10) is 1024
    edit result = 1
    if exp >= 0:
        loop _ in 0 until exp:
            result = result * base
    else:
        result = 0
    result

# 1 if `n` is even, else 0.
public define is_even(n: number) -> truth:
    example is_even(4)
    n % 2 is 0

# 1 if `n` is odd, else 0.
public define is_odd(n: number) -> truth:
    example is_odd(7)
    n % 2 is not 0

# --- floats ---


# Real constants - const crosses the orb boundary (a language limit that
# died when programs became one concatenated compile; `pi` is a VALUE now).
public const pi = 3.141592653589793
public const e = 2.718281828459045

# `fabs` / `fmin` / `fmax` / `fclamp` are gone. Their bodies were the same
# four lines as `abs` / `min` / `max` / `clamp` above - `if a < b then a else b`
# - and they existed only because the type words were split. `number` picks,
# so one word does both.
#
# The catch, stated once: a `number` site gets ONE answer for the whole
# program. A `min` reached by a fraction anywhere is real everywhere, and a
# whole number in a double is exact up to 2^53. That is the deal `number`
# makes; it is not new here.

# Parse a float out of text: optional '-', integer part, optional '.fraction',
# optional 'e'/'E' exponent (with optional sign). Non-numeric tails stop the
# scan. parse_float("") is 0.0.
#   parse_float("3.14")    ->  3.14
#   parse_float("-2.5e3")  ->  -2500.0
public define parse_float(t: text) -> float:
    example parse_float("1.5") is 1.5
    b = bytes_of(t)
    n = bytes_count(b)
    edit i = 0
    edit neg = false
    if n > 0 and byte_at(b, 0) is 45:
        neg = true
        i = 1
    edit val = 0.0
    loop:
        if i >= n: break
        d = byte_at(b, i)
        if d < 48 or d > 57: break
        val = val * 10.0 + to_real(d - 48)
        i = i + 1
    if i < n and byte_at(b, i) is 46:              # '.'
        i = i + 1
        edit scale = 0.1
        loop:
            if i >= n: break
            d = byte_at(b, i)
            if d < 48 or d > 57: break
            val = val + to_real(d - 48) * scale
            scale = scale * 0.1
            i = i + 1
    if i < n and (byte_at(b, i) is 101 or byte_at(b, i) is 69):   # 'e' / 'E'
        i = i + 1
        edit eneg = false
        if i < n and byte_at(b, i) is 45:
            eneg = true
            i = i + 1
        if i < n and byte_at(b, i) is 43:          # '+'
            i = i + 1
        edit exp = 0
        loop:
            if i >= n: break
            d = byte_at(b, i)
            if d < 48 or d > 57: break
            exp = exp * 10 + (d - 48)
            i = i + 1
        factor = pow(10.0, to_real(exp))
        val = if eneg then val / factor else val * factor
    if neg then 0.0 - val else val

external define fmt_float(x: float, decimals: int) -> text

# `x` as text with a fixed number of decimals - the one formatting ask
# plain to_text cannot answer.
public define with_decimals(x: float, decimals: number) -> text:
    example with_decimals(3.14159, 2) is "3.14"
    example with_decimals(2.5, 0) is "2"
    example with_decimals(1.0, 3) is "1.000"
    fmt_float(x, decimals)
