# async - tasks: real suspension, one stack each.
#
# (The deadline helpers and the timer queue that used to open this orb were
# the pre-task workaround; nothing used them once tasks landed, so they are
# gone. The runtime builtins monotonic_ms/sleep_ms remain for direct use.)
#
# Every task gets its own stack (Windows fibers, ucontext elsewhere),
# so `yield_now()` suspends and the scheduler resumes exactly where it stopped.
# Cooperative and single-threaded on purpose: `loop parallel:` is the parallel
# primitive, this is the concurrency one.
#
#     t1 = spawn(worker, 10)        # a closure + one int argument
#     t2 = spawn(worker, 20)
#     a = await(t1)                 # drives the scheduler until t1 finishes
#     b = await(t2)
#
# and inside a worker:
#
#     define worker(n: int) -> int:
#         edit total = 0
#         loop i in 0 until n:
#             total += i
#             yield_now()           # another task gets a turn here
#         total
#
# A task is awaited ONCE (awaiting it again gives 0 - its stack is gone).
# Where the platform has no stack switching, spawn runs the closure right away
# and yield_now() does nothing: a non-yielding task still gives the same answer.
external define orion_task_spawn(f: function, arg: int) -> int
external define orion_task_await(id: int) -> int
external define orion_task_yield() -> int
external define orion_task_run_all() -> int
external define orion_task_state(id: int) -> int
external define orion_task_live_count() -> int

# Start a task. Returns its id, or -1 if the task table is full (1024).
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define spawn(f: function, arg: int) -> int = orion_task_spawn(f, arg)

# Run the scheduler until this task finishes, then take its result.
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define await(id: int) -> int = orion_task_await(id)

# Give the scheduler a turn. No-op outside a task.
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define yield_now() -> int = orion_task_yield()

# Drive every ready task to completion; returns how many are finished.
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define run_all() -> int = orion_task_run_all()

# 0 = no such task, 1 = ready, 2 = running, 3 = finished (result not taken yet).
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define task_state(id: int) -> int = orion_task_state(id)

# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define task_count() -> int = orion_task_live_count()

# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define is_done(id: int) -> truth = orion_task_state(id) is 3

external define orion_task_sleep(ms: int) -> int

# Wait `ms` WITHOUT holding the scheduler. Inside a task this parks it and lets
# the others run; the scheduler makes one real OS sleep for the shortest pending
# deadline and wakes whoever is due. Outside a task it is an ordinary sleep, so
# the same call is right in both places.
#
# This is the difference between concurrency and a queue: with `sleep_ms` inside
# a task, ten tasks each waiting 100 ms took a second, because the first one
# parked the whole scheduler in the OS.
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define sleep_task(ms: int) -> int = orion_task_sleep(ms)

# ---- delimited continuations: the handler survives the resume ---------
#
# `resume(v)` in a `handle` block is a longjmp: control leaves for the perform
# site and the handler frame is GONE, so a handler can never act AFTER the
# continuation runs. Here the handler runs on its own stack (a fiber), so it
# survives and `resume_with` RETURNS the continuation result.
#
#     fn body(seed: int) -> int:
#         x = ask(decide, seed)    # the handler decides what x is
#         x * 10                   # the rest of the task: the continuation
#
#     fn decide(seed: int) -> int:
#         answer = resume_with(4)  # runs the rest of the task with x = 4
#         answer + 2               # ...and gets 40 back, so this returns 42
#
# The continuation is delimited by the TASK, which is the delimiter a top-level
# `handle` does not have.
#
# ONE resume per `ask`. A second one is refused with a message rather than a
# crash: replaying would mean restoring the task's stack to the perform point,
# and that invalidates the context the OS parked the fiber at (measured - the
# first resume returns correctly, the second faults at the switch). Real
# multi-shot needs a context switcher of our own, or per-resume stack copies
# with every frame pointer relocated. Neither is worth half-building.
#
# Windows only for now (fibers). `resumable_ok()` answers whether it is real
# here; elsewhere `ask` returns -1 rather than pretending.
external define orion_ms_perform(f: function, arg: int) -> int
external define orion_ms_resume(v: int) -> int
external define orion_ms_supported() -> int

# Inside a task: hand control to `handler`, which may resume this point once and
# then keep working. Returns the handler's value, or the resumed value.
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define ask(handler: function, arg: int) -> int = orion_ms_perform(handler, arg)

# Inside such a handler: run the rest of the task with `v`, and get its result.
# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define resume_with(v: int) -> int = orion_ms_resume(v)

# no example: needs the running task scheduler - proven by test_42_async_interleave.or
public define resumable_ok() -> truth = orion_ms_supported() is 1
