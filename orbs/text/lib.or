# text - common text helpers callable via method-call syntax.
#
# Once you `use text`, you get:
#   msg.is_empty()
#   msg.starts_with("hello")
#   msg.ends_with("!")
#   msg.byte_count()
#   split("a,b,c", ",")   ->  ["a", "b", "c"]
#   join(parts, ", ")     ->  "a, b, c"
#
# All thanks to MethodCall desugar: `msg.starts_with("x")` lowers to
# `starts_with(msg, "x")`.

public define is_empty(t: text) -> truth:
    example is_empty("")
    example not is_empty("x")
    length(t) is 0

# The text's own length header, not a walk. `bytes_count(bytes_of(t))`
# built a whole list - one i64 per byte - to count something the text
# already knew: 2000 calls on a 20 KB text was 94 ms and eight bytes of
# allocation per byte counted, against 0 ms and none.
public define byte_count(t: text) -> number:
    example byte_count("åsa") is 4
    bytes_count(t)

public define starts_with(t: text, prefix: text) -> truth:
    example starts_with("hello", "he")
    t_bytes = bytes_of(t)
    p_bytes = bytes_of(prefix)
    t_len = bytes_count(t_bytes)
    p_len = bytes_count(p_bytes)
    if p_len > t_len:
        return false
    loop ci in 0 until p_len:
        if byte_at(t_bytes, ci) is not byte_at(p_bytes, ci):
            return false
    true

public define ends_with(t: text, suffix: text) -> truth:
    example ends_with("hello", "lo")
    t_bytes = bytes_of(t)
    s_bytes = bytes_of(suffix)
    t_len = bytes_count(t_bytes)
    s_len = bytes_count(s_bytes)
    if s_len > t_len:
        return false
    offset = t_len - s_len
    loop ci in 0 until s_len:
        if byte_at(t_bytes, ci + offset) is not byte_at(s_bytes, ci):
            return false
    true

# Repeat `t` `n` times. Returns "" if n <= 0.
public define repeat(t: text, n: number) -> text:
    example repeat("ab", 3) is "ababab"
    edit result = ""
    if n > 0:
        loop _ in 0 until n:
            result = "{result}{t}"
    result

# Reverse by CHARACTER (UTF-8-aware): a multibyte sequence keeps its byte
# order, so reversing Swedish never produces invalid UTF-8.
public define reverse(t: text) -> text:
    example reverse("abc") is "cba"
    example reverse("åsa") is "aså"
    t_bytes = bytes_of(t)
    n = bytes_count(t_bytes)
    edit out = bytes_zeros(0)
    edit ci = 0
    loop:
        if ci >= n:
            break
        # A character = its lead byte + any continuation bytes (0x80-0xBF).
        edit cend = ci + 1
        loop:
            if cend >= n:
                break
            cb = byte_at(t_bytes, cend)
            if cb >= 128 and cb < 192:
                cend = cend + 1
            else:
                break
        out = bytes_concat(bytes_part(t_bytes, ci, cend), out)
        ci = cend
    text_of(out)

# ---- Unicode case ----------------------------------------------------
#
# `upper` and `lower` work on CODE POINTS, not bytes: decode UTF-8, map the
# code point, encode it back. That is what lets one rule cover every script
# instead of one byte hack per alphabet.
#
# Covered: ASCII, Latin-1 supplement, Latin Extended-A, Greek, Cyrillic.
# Everything else passes through unchanged, so no text is ever corrupted -
# a code point with no mapping is simply itself.
#
# Two honest limits, both inherent to SIMPLE (1:1) case mapping:
#   - ß stays ß in `upper`. Its real uppercase is "SS", which is two code
#     points; a 1:1 table cannot say that.
#   - `upper("i")` is "I" everywhere, including Turkish text, where the
#     locale-correct answer is "İ". Locale-tailored casing needs a locale,
#     which Orion does not have. İ and ı themselves DO map (İ->i, ı->I), so
#     Turkish text survives a round trip through the wrong direction.

# How many bytes the UTF-8 sequence with this lead byte occupies.
define cp_size(lead: number) -> number:
    if lead < 0x80:
        1
    else if lead < 0xE0:
        2
    else if lead < 0xF0:
        3
    else:
        4

# Decode the code point starting at byte `i`. A truncated or ill-formed
# sequence decodes as its lead byte, so decoding never fails.
define cp_at(b: [number], i: number) -> number:
    n = length(b)
    lead = b[i]
    size = cp_size(lead)
    if i + size > n:
        lead
    else if size is 1:
        lead
    else if size is 2:
        ((lead & 0x1F) << 6) | (b[i + 1] & 0x3F)
    else if size is 3:
        ((lead & 0x0F) << 12) | ((b[i + 1] & 0x3F) << 6) | (b[i + 2] & 0x3F)
    else:
        ((lead & 0x07) << 18) | ((b[i + 1] & 0x3F) << 12) | ((b[i + 2] & 0x3F) << 6) | (b[i + 3] & 0x3F)

# Encode a code point back to UTF-8 bytes.
define cp_bytes(cp: number) -> [number]:
    if cp < 0x80:
        [cp]
    else if cp < 0x800:
        [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
    else if cp < 0x10000:
        [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
    else:
        [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]

# Latin Extended-A (0x100..0x17F) is upper/lower PAIRS, but the parity flips
# twice: 0x100..0x137 and 0x14A..0x177 have the capital on even, 0x139..0x148
# and 0x179..0x17E have it on odd. These two answer "is this the capital of
# its pair" for the block.
define latin_a_pair_even(cp: number) -> truth:
    (cp >= 0x100 and cp <= 0x137) or (cp >= 0x14A and cp <= 0x177)

define latin_a_pair_odd(cp: number) -> truth:
    (cp >= 0x139 and cp <= 0x148) or (cp >= 0x179 and cp <= 0x17E)

# Cyrillic beyond the main alphabet (0x460..0x52F) is the same pair scheme:
# capital on even, except the 0x4C1..0x4CE run where it is on odd.
define cyrillic_pair_even(cp: number) -> truth:
    (cp >= 0x460 and cp <= 0x481) or (cp >= 0x48A and cp <= 0x4BF) or (cp >= 0x4D0 and cp <= 0x52F)

define cyrillic_pair_odd(cp: number) -> truth:
    cp >= 0x4C1 and cp <= 0x4CE

# The capital of `cp`, or `cp` itself when it has none.
define upper_cp(cp: number) -> number:
    if cp >= 0x61 and cp <= 0x7A:
        cp - 0x20
    else if cp is 0xB5:
        0x39C                                  # µ micro sign -> Greek capital Mu
    else if cp >= 0xE0 and cp <= 0xFE and cp is not 0xF7:
        cp - 0x20                              # à..þ, ÷ is not a letter
    else if cp is 0xFF:
        0x178                                  # ÿ -> Ÿ, which lives in Latin Ext-A
    else if cp is 0x131:
        0x49                                   # ı dotless i -> I
    else if cp is 0x17F:
        0x53                                   # ſ long s -> S
    else if latin_a_pair_even(cp):
        if cp % 2 is 1 then cp - 1 else cp
    else if latin_a_pair_odd(cp):
        if cp % 2 is 0 then cp - 1 else cp
    else if cp is 0x3C2:
        0x3A3                                  # ς final sigma -> Σ
    else if cp >= 0x3B1 and cp <= 0x3C1:
        cp - 0x20                              # α..ρ
    else if cp >= 0x3C3 and cp <= 0x3CB:
        cp - 0x20                              # σ..ϋ
    else if cp is 0x3AC:
        0x386                                  # ά
    else if cp >= 0x3AD and cp <= 0x3AF:
        cp - 0x25                              # έ ή ί
    else if cp is 0x3CC:
        0x38C                                  # ό
    else if cp >= 0x3CD and cp <= 0x3CE:
        cp - 0x3F                              # ύ ώ
    else if cp >= 0x430 and cp <= 0x44F:
        cp - 0x20                              # а..я
    else if cp >= 0x450 and cp <= 0x45F:
        cp - 0x50                              # ѐ..џ
    else if cyrillic_pair_even(cp):
        if cp % 2 is 1 then cp - 1 else cp
    else if cyrillic_pair_odd(cp):
        if cp % 2 is 0 then cp - 1 else cp
    else:
        cp

# The small letter of `cp`, or `cp` itself when it has none.
define lower_cp(cp: number) -> number:
    if cp >= 0x41 and cp <= 0x5A:
        cp + 0x20
    else if cp >= 0xC0 and cp <= 0xDE and cp is not 0xD7:
        cp + 0x20                              # À..Þ, × is not a letter
    else if cp is 0x130:
        0x69                                   # İ -> i (simple mapping)
    else if cp is 0x178:
        0xFF                                   # Ÿ -> ÿ
    else if latin_a_pair_even(cp):
        if cp % 2 is 0 then cp + 1 else cp
    else if latin_a_pair_odd(cp):
        if cp % 2 is 1 then cp + 1 else cp
    else if cp is 0x386:
        0x3AC
    else if cp >= 0x388 and cp <= 0x38A:
        cp + 0x25                              # Έ Ή Ί
    else if cp is 0x38C:
        0x3CC
    else if cp >= 0x38E and cp <= 0x38F:
        cp + 0x3F                              # Ύ Ώ
    else if cp >= 0x391 and cp <= 0x3A1:
        cp + 0x20                              # Α..Ρ
    else if cp >= 0x3A3 and cp <= 0x3AB:
        cp + 0x20                              # Σ..Ϋ
    else if cp >= 0x410 and cp <= 0x42F:
        cp + 0x20                              # А..Я
    else if cp >= 0x400 and cp <= 0x40F:
        cp + 0x50                              # Ѐ..Џ
    else if cyrillic_pair_even(cp):
        if cp % 2 is 0 then cp + 1 else cp
    else if cyrillic_pair_odd(cp):
        if cp % 2 is 1 then cp + 1 else cp
    else:
        cp

# Walk `t` code point by code point and rebuild it through `mapper`.
# Chunkad uppsamling + EN join: bytes_concat per tecken var KVADRATISK
# (varje concat kopierar allt dittills) - lower() pa en filkropp hangde
# processen i minuter. Chunkarna ar sma nog att deras interna concat ar
# billig, och join over chunklistan ar linjar.
define map_case(t: text, mapper: function) -> text:
    b = bytes_of(t)
    n = length(b)
    edit parts = []
    edit chunk = bytes_zeros(0)
    edit ccount = 0
    edit i = 0
    loop:
        if i >= n:
            break
        cp = cp_at(b, i)
        chunk = bytes_concat(chunk, cp_bytes(mapper(cp)))
        ccount = ccount + 1
        if ccount >= 256:
            parts = append(parts, text_of(chunk))
            chunk = bytes_zeros(0)
            ccount = 0
        i = i + cp_size(b[i])
    if ccount > 0:
        parts = append(parts, text_of(chunk))
    join(parts, "")

# Upper-case, code point by code point.
public define upper(t: text) -> text:
    example upper("hej") is "HEJ"
    example upper("åsa är glad") is "ÅSA ÄR GLAD"
    example upper("ελληνικά") is "ΕΛΛΗΝΙΚΆ"
    example upper("привет") is "ПРИВЕТ"
    map_case(t, upper_cp)

# Lower-case, code point by code point.
public define lower(t: text) -> text:
    example lower("HEJ") is "hej"
    example lower("ÅSA ÄR GLAD") is "åsa är glad"
    example lower("ΕΛΛΗΝΙΚΆ") is "ελληνικά"
    example lower("ПРИВЕТ") is "привет"
    map_case(t, lower_cp)

# Remove leading and trailing ASCII whitespace (space, tab, newline, CR).
#   trim("  hi  ")  ->  "hi"
public define trim(t: text) -> text:
    example trim("  hi  ") is "hi"
    tb = bytes_of(t)
    n = bytes_count(tb)
    edit lo = 0
    edit hi = n
    loop:
        if lo >= hi:
            break
        b = byte_at(tb, lo)
        if b is 32 or b is 9 or b is 10 or b is 13:
            lo = lo + 1
        else:
            break
    loop:
        if hi <= lo:
            break
        b = byte_at(tb, hi - 1)
        if b is 32 or b is 9 or b is 10 or b is 13:
            hi = hi - 1
        else:
            break
    text_of(bytes_part(tb, lo, hi))

# Join a list of pieces with `sep` between them.
#   join(["a", "b", "c"], "-")  ->  "a-b-c"
# Joined by halves, not one at a time. Adding a piece to the end of a
# growing text copies everything already in it, so a thousand pieces copy
# the whole result a thousand times - the cost grows with the SQUARE of
# how many there are, which is why building one big text out of many small
# ones was always the slow part of anything that serialises.
#
# Pairing them up instead means each byte is copied about log2(n) times:
# a display list of a hundred and fifty pieces went from copying a
# megabyte to copying a hundred kilobytes.
public define join(parts: [text], sep: text) -> text:
    example join(["a", "b", "c"], "-") is "a-b-c"
    example join([], "-") is ""
    example join(["only"], "-") is "only"
    if length(parts) is 0:
        return ""
    edit row = parts
    loop:
        if length(row) <= 1:
            break
        edit paired = []
        edit i = 0
        loop:
            if i >= length(row):
                break
            if i + 1 < length(row):
                paired = append(paired, "{row[i]}{sep}{row[i + 1]}")
            else:
                paired = append(paired, row[i])
            i = i + 2
        row = paired
    row[0]

# Split `t` on every occurrence of `sep`, returning the pieces.
#   split("a,b,c", ",")  ->  ["a", "b", "c"]
# An empty `sep` yields the whole string as a single piece.
public define split(t: text, sep: text) -> [text]:
    example length(split("a,b,c", ",")) is 3
    tb = bytes_of(t)
    sb = bytes_of(sep)
    tlen = bytes_count(tb)
    slen = bytes_count(sb)
    edit out = []
    if slen is 0:
        out = append(out, t)
    else:
        edit start = 0
        edit i = 0
        loop:
            if i > tlen - slen:
                break
            edit matched = true
            loop j in 0 until slen:
                if byte_at(tb, i + j) is not byte_at(sb, j):
                    matched = false
            if matched:
                out = append(out, text_of(bytes_part(tb, start, i)))
                i = i + slen
                start = i
            else:
                i = i + 1
        out = append(out, text_of(bytes_part(tb, start, tlen)))
    out

# Replace every occurrence of `from` with `to` - split on `from`, rejoin
# with `to`. An empty `from` returns `t` unchanged.
#   replace("a,b,c", ",", "; ")  ->  "a; b; c"
public define replace(t: text, from: text, to: text) -> text:
    example replace("a,b", ",", "; ") is "a; b"
    join(split(t, from), to)

# First byte index of `sub` in `t`, or -1 if absent. Empty `sub` -> 0.
# Where `sub` starts, counted in CHARACTERS, or -1. The search itself walks
# BYTES - UTF-8 is self-synchronising, so a well-formed needle can only match
# at a character boundary - and the byte offset is converted at the end.
#
# It reads the text where it lies. `bytes_of` would copy every byte into an
# eight-byte slot first, which for a megabyte of source is eight megabytes to
# find one word.
public define index_of(t: text, sub: text) -> number:
    example index_of("hello", "ll") is 2
    example index_of("hello", "zz") is 0 - 1
    example index_of("räksmörgås", "ö") is 5
    tlen = bytes_count(t)
    slen = bytes_count(sub)
    edit found = 0 - 1
    if slen is 0:
        found = 0
    else:
        edit i = 0
        loop:
            if i > tlen - slen or found >= 0:
                break
            edit matched = true
            loop j in 0 until slen:
                if byte_at(t, i + j) is not byte_at(sub, j):
                    matched = false
            if matched:
                found = i
            i = i + 1
    if found <= 0:
        return found
    edit chars = 0
    loop ci in 0 until found:
        b = byte_at(t, ci)
        if b < 128 or b >= 192:
            chars = chars + 1
    chars

# Pad `t` on the left with `pad` until it is at least `width` bytes wide.
public define pad_left(t: text, width: number, pad: text) -> text:
    example pad_left("7", 3, "0") is "007"
    edit out = t
    edit k = length(t)
    loop:
        if k >= width:
            break
        out = "{pad}{out}"
        k = k + 1
    out

# Pad `t` on the right with `pad` until it is at least `width` bytes wide.
public define pad_right(t: text, width: number, pad: text) -> text:
    example pad_right("7", 3, "0") is "700"
    edit out = t
    edit k = length(t)
    loop:
        if k >= width:
            break
        out = "{out}{pad}"
        k = k + 1
    out

# Split `t` into lines on '\n'.
public define lines(t: text) -> [text]:
    # no example: the newline in the input cannot be written inline here
    split(t, "\n")

# The integer written at the start of `t`: an optional `-`, then digits.
# Stops at the first non-digit; no digits at all is 0. For CLI arguments
# and simple protocols - not a validator.
public define int_from_text(t: text) -> number:
    example int_from_text("42") is 42
    example int_from_text("-7") is 0 - 7
    example int_from_text("12ab") is 12
    example int_from_text("x") is 0
    bs = bytes_of(t)
    n = length(bs)
    edit i = 0
    edit neg = false
    if n > 0 and bs[0] is 45:
        neg = true
        i = 1
    edit value = 0
    edit done = false
    loop k in i until n:
        if not done:
            c = bs[k]
            if c >= 48 and c <= 57:
                value = value * 10 + (c - 48)
            else:
                done = true
    if neg then 0 - value else value
