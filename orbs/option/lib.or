# option - Option<T>: a value, or nothing.
#
# A native generic sum type. Same idea as `result` without the message: you
# cannot read the payload without saying what the empty case does.
#
#   use option
#
#   define find(k: number) -> Option<number>:
#       if k > 0 then Option.Some(k * 10) else Option.None
#
#   choose find(4):
#       Some(v) then print_line("found {v}")
#       None then print_line("not found")
#
# Softer forms:
#   id = unwrap_or(find(0), 0)      # fallback value
#   if let Some(v) = find(4):       # only the present case
#       print_line("{v}")
#
# `?` propagates: `v = find(k)?` returns None out of the enclosing function
# when there is nothing, and binds `v` otherwise.
#
# No `unwrap` on purpose - Orion has no panic, so it could only lie and hand
# back a zero. Use `choose`, `if let`, `?` or `unwrap_or`.


# The payload, or `default` if this is None.
public define unwrap_or<T>(o: Option<T>, default: T) -> T:
    example unwrap_or(Option.Some(7), 0) is 7
    example unwrap_or(Option.None, 9) is 9
    choose o:
        Some(v) then v
        None then default

# 1 if a value is present, else 0.
public define is_some<T>(o: Option<T>) -> truth:
    example is_some(Option.Some(5))
    example not is_some(Option.None)
    choose o:
        Some(v) then true
        None then false

# true if this is None.
public define is_none<T>(o: Option<T>) -> truth:
    example is_none(Option.None)
    choose o:
        Some(v) then false
        None then true
