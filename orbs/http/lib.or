# http - fetch and post over HTTP(S).
#
# The INTERFACE is the commitment: request in, `reply{status, body}` out.
# Named `reply` and not `response` because `app` has a `response` of its own,
# with a `mime` field, and a type name is ONE layout for the whole build - a
# program that used both orbs did not compile and the error was about a field.
# The engine behind it is curl as a child process (present on Windows 10+,
# macOS and virtually every Linux), which buys TLS, redirects and proxies
# for free. A native client (net orb + a TLS layer) can replace the engine
# later without a caller changing a line.
#
# Blocking by design per call - run it inside a task (see the async orb)
# and the scheduler keeps everything else moving while curl works.

use text

type reply:
    status: number
    body: text

# The scratch file curl writes the body to. Per-call unique via the slot
# counter, so concurrent tasks never share a file.
define scratch_path() -> text:
    n = if slot_has("http:n") then slot_get_number("http:n") else 0
    slot_set("http:n", n + 1)
    ".http_body_{n}.txt"

# The status is read from curl's header dump (-D), not from stdout: the
# dump is a file of its own, so a stray stderr line can never corrupt it.
# With redirects (-L) the dump holds one block per hop - the LAST status
# line is the answer.
public define status_from_headers(header_dump: text) -> number:
    example status_from_headers("HTTP/1.1 200 OK") is 200
    example status_from_headers("garbage") is 0
    rows = lines(header_dump)
    edit status = 0
    loop i in 0 until length(rows):
        row = trim(rows[i])
        if starts_with(row, "HTTP/"):
            parts = split(row, " ")
            if length(parts) >= 2:
                status = int_from_text(parts[1])
    status

# Run curl with `args`, reading the body from `body_file`. Status 0 means
# the request itself failed (no network, bad host, curl missing).
define run_curl(args: [text], body_file: text) -> reply:
    hdr_file = "{body_file}.hdr"
    log_file = "{body_file}.log"
    edit all_args = ["-sS", "--max-time", "60", "-L", "-o", body_file, "-D", hdr_file]
    loop i in 0 until length(args):
        all_args = append(all_args, args[i])
    job = start_command_to_file("curl", all_args, log_file)
    if job < 0:
        return reply{status: 0, body: ""}
    if not finished_within(job, 65000):
        stopped = stop_command(job)
        reaped = command_result(job)
        return reply{status: 0, body: ""}
    rc = command_result(job)
    status = status_from_headers(read_file(hdr_file))
    body = read_file(body_file)
    err = read_file(log_file)
    cleanup1 = remove_file(body_file)
    cleanup2 = remove_file(hdr_file)
    cleanup3 = remove_file(log_file)
    # A failed request answers status 0 with curl's OWN complaint as the
    # body ("could not resolve host", proxy refusals...), so the caller can
    # show WHY instead of a blank.
    if rc is not 0 then reply{status: 0, body: trim(err)} else reply{status: status, body: body}

# Extra request headers, as "Name: value" lines.
#
# They go through a curl CONFIG FILE and not `-H` on the command line: a
# process's arguments are readable by anyone who can list processes, and a
# header is often the one part of a request that is a secret. The file is
# removed as soon as curl is done with it.
#
# QUOTED, and that is not cosmetic. An unquoted config value stops at the
# first separator, and ":" is one of them - so `header = Authorization:
# Bearer x` reached curl as the header name alone and the request went out
# without it. The server answered 401 and nothing said why. Inside quotes
# curl reads backslash escapes, so both characters that could end the
# string early are escaped first.
define cfg_quote(v: text) -> text:
    esc = replace(v, text_of([92]), text_of([92, 92]))
    text_of([34]) + replace(esc, text_of([34]), text_of([92, 34])) + text_of([34])

define write_config(path: text, headers: [text]) -> number uses files:
    edit body = ""
    loop h in headers:
        body = body + "header = " + cfg_quote(h) + text_of([10])
    write_file(path, body)

# GET `url`. `success(r)` when the request went through AND the server said 2xx.
# no example: needs the network - proven by examples/demos/httpd.or + manual runs
public define fetch(url: text) -> reply uses net, files:
    run_curl([url], scratch_path())

# GET `url` with extra headers.
# no example: needs the network - proven by rune's remote suite
public define fetch_with(url: text, headers: [text]) -> reply uses net, files:
    if length(headers) is 0:
        return fetch(url)
    body_file = scratch_path()
    cfg = "{body_file}.cfg"
    wrote = write_config(cfg, headers)
    r = run_curl(["-K", cfg, url], body_file)
    cleanup = remove_file(cfg)
    r

# POST `body` to `url` with the given Content-Type.
# no example: needs the network - proven by manual runs
public define post(url: text, content_type: text, payload: text) -> reply uses net, files:
    post_with(url, content_type, payload, [])

# POST with extra headers.
# no example: needs the network - proven by rune's remote suite
public define post_with(url: text, content_type: text, payload: text, headers: [text]) -> reply uses net, files:
    body_file = scratch_path()
    payload_file = "{body_file}.out"
    cfg = "{body_file}.cfg"
    wrote = write_file(payload_file, payload)
    edit args = ["-X", "POST", "-H", "Content-Type: {content_type}", "--data-binary", "@{payload_file}"]
    if length(headers) > 0:
        cw = write_config(cfg, headers)
        args = append(args, "-K")
        args = append(args, cfg)
    args = append(args, url)
    r = run_curl(args, body_file)
    cleanup = remove_file(payload_file)
    if length(headers) > 0:
        cc = remove_file(cfg)
    r

# Did the request reach a server that answered success?
public define success(r: reply) -> truth:
    example success(reply{status: 200, body: ""})
    example not success(reply{status: 404, body: ""})
    example not success(reply{status: 0, body: ""})
    r.status >= 200 and r.status < 300

# cfg_quote is private, and an `example` is extracted into a probe that only
# says `use http` - so it could not call this and the example gate went red.
# A private helper is proven by a test, which runs where it lives.
define test_cfg_quote_escapes_what_would_end_the_string():
    quote = text_of([34])
    slash = text_of([92])
    require cfg_quote("a" + quote + "b") is quote + "a" + slash + quote + "b" + quote
    require cfg_quote("a" + slash + "b") is quote + "a" + slash + slash + "b" + quote
