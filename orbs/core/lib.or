# core - the two types every program may assume: `maybe T`, `result T`.
#
#   define find(k: number) -> maybe number:
#       if k > 0 then some(k * 10) else none
#
# The FUNCTIONS over them are still `use option` / `use result`; only the types
# are free. Two declarations on purpose: anything added here is added to every
# program in the language. See README.md.

public type Option<T>:
    Some(T)
    None

public type Result<T>:
    Ok(T)
    Err(text)
