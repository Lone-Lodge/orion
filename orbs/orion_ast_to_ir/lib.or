                        ca_line = if has(arg_node, "line") then get_int(arg_node, "line") else (if has(node, "line") then get_int(node, "line") else 0)
                        ca_col = if has(arg_node, "col") then get_int(arg_node, "col") else 0
                        compile_error("orion: ERROR at {otir_where(ca_line, ca_col)} — argument {arg_index + 1} to `{callee}` is a `{friendly_type(arg_ty_ca)}` but the parameter is declared `{friendly_type(decl_pt_ca)}` (a {arg_ck_ca} where a {decl_ck_ca} was expected)")
                    # NB an i64-arg -> ptr-param check was TRIED here and REVERTED:
                    # erasure means a real list value can carry the type "i64" (a
                    # list that lost its element type through a dynamic getter or
                    # an untyped build), so `ints_differ(x, emptyish)` false-
                    # positived across the harness. The i64-vs-ptr bucket at call
                    # args is unreachable until dynamic getters carry honest types
                    # (the step-3 erasure work) - the concrete-kind check above is
                    # the safe ceiling for the guard pattern.
            arg_ids = push(arg_ids, arg_r.id)
        if is_local_callee:
            # The local holds a closure value ([fn_ptr, flag, caps...]); call
            # through it. Return type defaults to i64 — proper type tracking on
            # closure values is future work.
            pr = ir_fn_push(current_fn, ir_closure_call(bound_id, arg_ids, "i64"))
            result = ConvResult{function: pr.function, scope: current_scope, id: pr.id}
        else:
            erased_ret_type = scope_lookup_fn_ret_loc(scope, callee_g, node)
            # Re-type a generic result from the ACTUAL argument types. `[T]` in
            # a signature is erased to `list:i64` in the body, but at the call
            # site the argument says what T is, so the result no longer loses
            # its element type (`at(filter(words, p), 0)` is a text again).
            mut call_arg_types = slice([""], 0, 0)
            loop cat_i in 0..<len(arg_ids):
                call_arg_types = push(call_arg_types, get_value_type(current_fn, at(arg_ids, cat_i)))
            call_ret_type = otir_call_ret_generic(callee_g, call_arg_types, erased_ret_type)
            arity_key = "otir:arity:" + callee_g
            if slot_has(arity_key):
                want = slot_get_int(arity_key)
                got = len(arg_ids)
                if got != want:
                    a_line = if has(node, "line") then get_int(node, "line") else 0
                    a_col = if has(node, "col") then get_int(node, "col") else 0
                    compile_error("orion: ERROR at {otir_where(a_line, a_col)} — `{callee}` takes {want} argument(s), got {got}")
            # The CALLEE's machine signature is the erased one: `[T]` returns a
            # pointer either way (so the refined `list:text` can be stamped
            # straight on the call), but a bare `-> T` returns an i64 slot. When
            # the refinement turns that slot into a pointer type, the call must
            # keep returning i64 and the POINTER-ness is recovered right after,
            # the same way a closure capture is re-typed. Emitting the call with
            # a ptr type instead would contradict the definition and clang
            # rejects the module ("defined with type i64 but expected ptr").
            retype_needed = erased_ret_type == "i64" and is_ptr_ir_type(call_ret_type)
            call_emit_type = if retype_needed then "i64" else call_ret_type
            pr = ir_fn_push(current_fn, ir_call(callee_g, arg_ids, call_emit_type))
            if retype_needed:
                pr_rt = ir_fn_push(pr.function, ir_int_to_ptr(pr.id, call_ret_type))
                result = ConvResult{function: pr_rt.function, scope: current_scope, id: pr_rt.id}
            else:
                result = ConvResult{function: pr.function, scope: current_scope, id: pr.id}
    result

fn ast_unary_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    op = get(node, "op")
    operand_r = ast_expr_to_ir(fn_value, scope, get(node, "operand"))
    if op == "not":
        pr = ir_fn_push(operand_r.function, ir_inot(operand_r.id))
        ConvResult{function: pr.function, scope: operand_r.scope, id: pr.id}
    else if op == "bnot":
        # `~x` is `x ^ -1`: flip every bit. (`not x` is the LOGICAL one and
        # coerces to 0/1 — two different operators, and they used to give the
        # same answer because `~` had no lowering at all.)
        pr_ones = ir_fn_push(operand_r.function, ir_iconst(0 - 1))
        pr_x = ir_fn_push(pr_ones.function, ir_bit_xor(operand_r.id, pr_ones.id))
        ConvResult{function: pr_x.function, scope: operand_r.scope, id: pr_x.id}
    else:
        if op == "neg":
            # -x → 0 - x. Dispatch on the operand type: an f64 operand must
            # use a float zero + fsub, else the subtract is emitted as `sub
            # i64` over a double (a negative float literal like -7.0 miscompiled).
            if get_value_type(operand_r.function, operand_r.id) == "f64":
                pr_z = ir_fn_push(operand_r.function, ir_fconst("0.0"))
                pr_s = ir_fn_push(pr_z.function, ir_fbin("fsub", pr_z.id, operand_r.id))
                ConvResult{function: pr_s.function, scope: operand_r.scope, id: pr_s.id}
            else:
                pr_z = ir_fn_push(operand_r.function, ir_iconst(0))
                pr_s = ir_fn_push(pr_z.function, ir_isub(pr_z.id, operand_r.id))
                ConvResult{function: pr_s.function, scope: operand_r.scope, id: pr_s.id}
        else:
            operand_r

# Get the result type ("i64" / "text" / "ptr" / "void") of an SSA value.
fn get_value_type(fn_value: IRFn, value_id: int) -> Text:
    if value_id < 0:
        "void"
    else:
        inst = at(fn_value.instructions, value_id)
        inst.type_text


fn ast_str_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    text = get(node, "value")
    pr = ir_fn_push(fn_value, ir_const_str(text))
    ConvResult{function: pr.function, scope: scope, id: pr.id}


fn ast_list_lit_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    items = get_list(node, "items")
    n_items = len(items)
    mut current_fn = fn_value
    mut current_scope = scope
    mut item_ids = []
    loop index in 0..<n_items:
        item_node = at(items, index)
        item_r = ast_expr_to_ir(current_fn, current_scope, item_node)
        current_fn = item_r.function
        current_scope = item_r.scope
        item_ids = push(item_ids, item_r.id)
    # Peek first item's type to encode "list:T". Default i64 for empty lists.
    mut elem_type = "i64"
    if n_items > 0:
        first_id = at(item_ids, 0)
        elem_type = get_value_type(current_fn, first_id)
    # Homogeneity guard (container construction, same rule as struct-field
    # construction): a list literal mixing two DIFFERENT concrete pointer kinds
    # (e.g. `[textv, Point{..}]`) is a type error - a `[T]` holds one element
    # type. Anchor on the first reliably-shaped concrete element; flag any later
    # reliable element of a different concrete kind. Unreliable items (slot_get/
    # map-get) and map/fn/generic/i64 items are wildcards (skipped), so the
    # dynamic-storage idiom and int lists never false-positive.
    mut anchor_kind = ""
    mut anchor_type = ""
    loop ck_i in 0..<n_items:
        ck_id = at(item_ids, ck_i)
        if not is_unreliable_ptr(current_fn, ck_id):
            ck_ty = get_value_type(current_fn, ck_id)
            ck_kind = concrete_ptr_kind(ck_ty)
            if ck_kind != "":
                if anchor_kind == "":
                    anchor_kind = ck_kind
                    anchor_type = ck_ty
                else if ck_kind != anchor_kind:
                    ll_line = if has(node, "line") then get_int(node, "line") else 0
                    ll_col = if has(node, "col") then get_int(node, "col") else 0
                    compile_error("orion: ERROR at {otir_where(ll_line, ll_col)} — list literal mixes `{friendly_type(anchor_type)}` and `{friendly_type(ck_ty)}` elements (a list holds one element type: a {ck_kind} where a {anchor_kind} was expected)")
    pr = ir_fn_push(current_fn, ir_list_lit(item_ids, elem_type))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}


# Lower a nested sub-pattern in a payload slot (`Some(Ok(x))`). `inner_id`
# holds that slot — itself an enum struct. Test its tag against the
# sub-variant and, on a match, bind the sub-pattern's names to ITS payload
# slots (retyped from the inner variant's spec). A failed test falls through
# to `next_lbl`, the next arm's test — the same shape a guard uses.
fn otir_lower_nested_pat(fn_value: IRFn, scope: Scope, enc: Text, inner_id: int, inner_type: Text, next_lbl: Text, cont_lbl: Text) -> ConvResult:
    mut current_fn = fn_value
    mut current_scope = scope
    inner_enum = strip_struct_prefix(inner_type)
    sub_variant = nested_binding_variant(enc)
    sub_names = nested_binding_names(enc)
    v_idx = scope_lookup_enum_variant(scope, inner_enum, sub_variant)
    if v_idx < 0:
        compile_error("orion: ERROR — nested pattern `{sub_variant}(…)` — `{sub_variant}` is not a variant of `{inner_enum}`")
    sub_want = variant_payload_count(scope, inner_enum, sub_variant)
    if len(sub_names) != sub_want:
        compile_error("orion: ERROR — nested pattern `{sub_variant}` binds {len(sub_names)} value(s) but the variant carries {sub_want}")
    pr_tag = ir_fn_push(current_fn, ir_field_load(inner_id, 0, "i64"))
    current_fn = pr_tag.function
    pr_pat = ir_fn_push(current_fn, ir_iconst(v_idx))
    current_fn = pr_pat.function
    pr_eq = ir_fn_push(current_fn, ir_icmp_eq(pr_tag.id, pr_pat.id))
    current_fn = pr_eq.function
    pr_br = ir_fn_push(current_fn, ir_br_if(pr_eq.id, cont_lbl, next_lbl))
    current_fn = pr_br.function
    pr_lbl = ir_fn_push(current_fn, ir_label(cont_lbl))
    current_fn = pr_lbl.function
    sub_types = split_csv(scope_lookup_variant_payloads(scope, inner_enum, sub_variant))
    n_sub_types = len(sub_types)
    loop si in 0..<len(sub_names):
        st = if si < n_sub_types then at(sub_types, si) else "i64"
        pr_slot = ir_fn_push(current_fn, ir_field_load(inner_id, 1 + si, st))
        current_fn = pr_slot.function
        current_scope = scope_bind(current_scope, at(sub_names, si), pr_slot.id)
    ConvResult{function: current_fn, scope: current_scope, id: inner_id}


# Does this arm carry a nested sub-pattern? Such an arm matches only PART of
# its variant, so it counts toward coverage only together with its siblings.
fn arm_has_nested(arm: Map) -> bool:
    binds = if has(arm, "bindings") then get_list(arm, "bindings") else []
    mut nested = false
    loop bi in 0..<len(binds):
        if is_nested_binding(at(binds, bi)):
            nested = true
    nested


# The sub-variant an arm's single nested slot names (`Some(Ok(x))` -> "Ok").
# An arm nesting in more than one slot is a conjunction, so it covers nothing
# on its own — report "" and let it need a sibling or a wildcard.
fn otir_arm_nested_sub(arm: Map) -> Text:
    binds = if has(arm, "bindings") then get_list(arm, "bindings") else []
    mut sub = ""
    mut count = 0
    loop bi in 0..<len(binds):
        if is_nested_binding(at(binds, bi)):
            count = count + 1
            sub = nested_binding_variant(at(binds, bi))
    if count == 1 then sub else ""


fn csv_has(csv: Text, name: Text) -> bool:
    parts = split_csv(csv)
    mut found = false
    loop i in 0..<len(parts):
        if at(parts, i) == name:
            found = true
    found


# Do these nested sub-variants together cover the payload enum of `variant`?
# `Some(Ok(x))` + `Some(Bad(m))` covers `Some` because Ok|Bad IS all of Res.
# Only a single-slot payload whose type is an enum can be covered this way.
fn otir_subs_cover(scope: Scope, en: Text, variant: Text, subs_seen: Text) -> bool:
    payloads = split_csv(scope_lookup_variant_payloads(scope, en, variant))
    mut covers = false
    if len(payloads) == 1:
        inner_enum = strip_struct_prefix(at(payloads, 0))
        inner_csv = enum_variant_csv(scope, inner_enum)
        inner_names = split_csv(inner_csv)
        if len(inner_names) > 0:
            mut all_seen = true
            loop ii in 0..<len(inner_names):
                if not csv_has(subs_seen, at(inner_names, ii)):
                    all_seen = false
            covers = all_seen
    covers


# How many variants of `en` do these arms cover? A plain variant arm covers
# its variant outright; nested arms cover theirs only together (see above).
# Guarded arms cover nothing — their condition can fail at runtime.
fn otir_covered_variants(scope: Scope, arms: [Map], en: Text) -> int:
    v_names = split_csv(enum_variant_csv(scope, en))
    mut covered = 0
    loop vi in 0..<len(v_names):
        vn = at(v_names, vi)
        mut full = false
        mut subs_seen = ""
        loop ai in 0..<len(arms):
            arm = at(arms, ai)
            arm_hits = get(arm, "pat_kind") == "ident" and get(arm, "pattern") == vn and not has(arm, "guard")
            if arm_hits and arm_has_nested(arm):
                sub_here = otir_arm_nested_sub(arm)
                subs_seen = "{subs_seen},{sub_here}"
            if arm_hits and not arm_has_nested(arm):
                full = true
        if not full:
            full = otir_subs_cover(scope, en, vn, subs_seen)
        if full:
            covered = covered + 1
    covered


# `match scrutinee: <pattern> -> <body>, ..., _ -> <default>`
# Lower to a chain of if-tests storing into a result slot.
fn ast_match_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    scrutinee_node = get(node, "scrutinee")
    arms = get_list(node, "arms")
    n_arms = len(arms)
    n = len(fn_value.instructions)
    end_lbl = "match_{n}_end"

    scrut_r = ast_expr_to_ir(fn_value, scope, scrutinee_node)
    scrut_id = scrut_r.id
    scrut_type = get_value_type(scrut_r.function, scrut_id)

    # Instruction count BEFORE the result-type probe. `ir_fn_push` mutates the
    # instruction spine in place (push_mut), so lowering an arm body during the
    # probe LEAKS those instructions into the real function — they would then
    # execute for real (running a side-effecting first arm twice). After probing
    # we truncate back to this baseline, discarding every leaked emission. The
    # probe reads only the resulting TYPE, never its instructions.
    probe_base = len(scrut_r.function.instructions)

    # Result slot type: probe the WILDCARD arm's body by lowering it
    # against a scratch copy of the fn — IRFn is a value, discarding
    # the probe costs nothing, and wildcard bodies have no pattern
    # bindings so the current scope suffices. This types matches whose
    # arms return structs/enums (astra's Value) correctly instead of
    # guessing i64. Fallback: first-arm Str heuristic, then i64.
    mut result_type = "i64"
    mut probed = false
    loop pai in 0..<n_arms:
        arm_probe = at(arms, pai)
        if get(arm_probe, "pat_kind") == "ident" and get(arm_probe, "pattern") == "_" and not probed:
            wc_r = ast_expr_to_ir(scrut_r.function, scrut_r.scope, get(arm_probe, "body"))
            if wc_r.id >= 0:
                result_type = get_value_type(wc_r.function, wc_r.id)
                probed = true
    if not probed:
        if n_arms > 0:
            # No wildcard: probe the FIRST arm's body. Bind its pattern
            # variables with their DECLARED payload types (not an i64 scratch)
            # so a body that IS a payload — `TextV(s) -> s`, `Spawn(comps) ->
            # comps` — probes as text/map instead of i64. Binding to a generic
            # i64 dummy mis-typed the whole match, mis-storing the value and
            # tripping the return-type check (and, for map/list payloads,
            # segfaulting at runtime when the i64 was used as a pointer).
            # The probe fn is discarded; only the resulting type is read.
            first_arm = at(arms, 0)
            first_pat = get(first_arm, "pattern")
            first_pk = get(first_arm, "pat_kind")
            mut probe_fn = scrut_r.function
            mut probe_scope = scrut_r.scope
            first_binds = if has(first_arm, "bindings") then get_list(first_arm, "bindings") else []
            # Resolve the first arm's enum (if it is a variant pattern) so we
            # can type its payload binds like Phase 2b does.
            mut fa_enum = ""
            if first_pk == "ident" and first_pat != "_":
                n_enums_p = len(scope.en_names)
                loop ei in 0..<n_enums_p:
                    en_name_p = at(scope.en_names, ei)
                    if not contains_dollar(en_name_p):
                        if scope_lookup_enum_variant(scope, en_name_p, first_pat) >= 0 and fa_enum == "":
                            fa_enum = en_name_p
            # A tuple pattern binds fields 0..n from the scrutinee's tuple spec.
            # Typing them from the spec (not an i64 dummy) is what lets a body
            # like `(n, s) -> n + len(s)` probe at all: with the dummy, `len(s)`
            # saw an int and aborted the whole compile from inside the probe.
            fa_is_tuple = first_pk == "tuple" and len(first_binds) > 0
            if fa_is_tuple:
                tup_parts_p = parse_data_spec(scope_lookup_data_spec(scope, strip_struct_prefix(scrut_type)))
                loop tbi in 0..<len(first_binds):
                    tt_p = field_type_at(tup_parts_p, tbi)
                    pr_tf = ir_fn_push(probe_fn, ir_field_load(scrut_id, tbi, tt_p))
                    probe_fn = pr_tf.function
                    probe_scope = scope_bind(probe_scope, at(first_binds, tbi), pr_tf.id)
            if fa_enum != "" and len(first_binds) > 0 and not fa_is_tuple:
                payload_types_p = split_csv(scope_lookup_variant_payloads(scope, fa_enum, first_pat))
                n_pt_p = len(payload_types_p)
                loop bpi in 0..<len(first_binds):
                    bt_p = if bpi < n_pt_p then at(payload_types_p, bpi) else "i64"
                    pr_pl = ir_fn_push(probe_fn, ir_field_load(scrut_id, 1 + bpi, bt_p))
                    probe_fn = pr_pl.function
                    # Nested slot: bind the SUB-names (typed), not the slot —
                    # a body like `Some(Ok(x)) -> x` names `x`, never the slot.
                    # The probe's emissions (branches included) are sliced away.
                    if is_nested_binding(at(first_binds, bpi)):
                        np_r = otir_lower_nested_pat(probe_fn, probe_scope, at(first_binds, bpi), pr_pl.id, bt_p, "probe_next", "probe_cont{bpi}")
                        probe_fn = np_r.function
                        probe_scope = np_r.scope
                    else:
                        probe_scope = scope_bind(probe_scope, at(first_binds, bpi), pr_pl.id)
            if fa_enum == "" and not fa_is_tuple:
                pr_dummy = ir_fn_push(probe_fn, ir_iconst(0))
                probe_fn = pr_dummy.function
                loop bpi in 0..<len(first_binds):
                    probe_scope = scope_bind(probe_scope, at(first_binds, bpi), pr_dummy.id)
            fa_r = ast_expr_to_ir(probe_fn, probe_scope, get(first_arm, "body"))
            if fa_r.id >= 0:
                result_type = get_value_type(fa_r.function, fa_r.id)
    # Drop the probe's leaked instructions: rebuild the fn with its spine sliced
    # back to the pre-probe baseline. `slice` allocates a fresh list, so the
    # subsequent in-place pushes for the real arm bodies start clean and their
    # value-ids line up exactly as if no probe had run.
    clean_fn = IRFn{name: scrut_r.function.name, return_type: scrut_r.function.return_type, params: scrut_r.function.params, instructions: slice(scrut_r.function.instructions, 0, probe_base)}
    pr_alloca = ir_fn_push(clean_fn, ir_alloca(result_type))
    result_ptr_id = pr_alloca.id
    mut current_fn = pr_alloca.function
    mut current_scope = scrut_r.scope

    # Exhaustiveness check — pre-walk arms to detect wildcard + count
    # matched variants. If scrutinee is an enum and no wildcard arm is
    # present, ensure every variant is covered. Emit a compile-time error.
    mut has_wildcard = false
    mut matched_count = 0
    mut matched_enum = ""
    loop chk_idx in 0..<n_arms:
        chk_arm = at(arms, chk_idx)
        chk_pk = get(chk_arm, "pat_kind")
        chk_pv = get(chk_arm, "pattern")
        chk_guarded = has(chk_arm, "guard")
        if chk_pk == "ident" and chk_pv == "_" and not chk_guarded:
            has_wildcard = true
        if chk_pk == "ident" and chk_pv != "_" and not chk_guarded:
            n_enums_chk = len(scope.en_names)
            mut chk_is_variant = false
            loop ei in 0..<n_enums_chk:
                en_name_chk = at(scope.en_names, ei)
                v_idx_chk = scope_lookup_enum_variant(scope, en_name_chk, chk_pv)
                if v_idx_chk >= 0:
                    matched_count = matched_count + 1
                    matched_enum = en_name_chk
                    chk_is_variant = true
            # A non-variant bare ident is a binding pattern — covers everything.
            if not chk_is_variant:
                has_wildcard = true
    if not has_wildcard and matched_enum != "":
        # Look up total variants for this enum (CSV — comma count + 1).
        en_total = len(scope.en_names)
        mut total_variants = 0
        loop ei2 in 0..<en_total:
            if at(scope.en_names, ei2) == matched_enum:
                csv = at(scope.en_variants, ei2)
                csv_bytes = bytes_from_text(csv)
                total_variants = 1
                csv_len = len(csv_bytes)
                loop ci in 0..<csv_len:
                    if at(csv_bytes, ci) == 44:
                        total_variants = total_variants + 1
        # Real coverage, not an arm count: nested arms cover their variant only
        # together (`Some(Ok(x))` + `Some(Bad(m))` covers `Some`), and two arms
        # naming the SAME variant must not count twice.
        covered_variants = otir_covered_variants(scope, arms, matched_enum)
        if covered_variants < total_variants:
            mline = if has(node, "line") then get_int(node, "line") else 0
            mcol = if has(node, "col") then get_int(node, "col") else 0
            missing = total_variants - covered_variants
            compile_error("orion: ERROR at {otir_where(mline, mcol)} — non-exhaustive match on enum `{matched_enum}` ({missing} variant(s) not covered, no wildcard arm)")

    mut arm_index = 0
    loop arm_idx in 0..<n_arms:
        arm = at(arms, arm_idx)
        pat_kind = get(arm, "pat_kind")
        pat_value = get(arm, "pattern")
        body_node = get(arm, "body")
        is_wildcard = pat_kind == "ident" and pat_value == "_"

        body_lbl = "match_{n}_arm_{arm_index}_body"
        next_lbl = "match_{n}_arm_{arm_index}_next"
        guard_lbl = "match_{n}_arm_{arm_index}_guard"
        arm_index = arm_index + 1

        # Flat dispatch — deep nested if/else inside this for-loop
        # mis-binds (see orion_nesting_bug.md). Each phase guards on
        # is_wildcard / pat_kind via boolean flags.

        # Detect variant pattern — pat_value is a known enum variant.
        # Capture WHICH enum matched so payload bindings can retype
        # loads with the variant's declared payload types. Synthetic
        # "Enum$Variant" payload entries are skipped via the $ guard.
        bindings = if has(arm, "bindings") then get_list(arm, "bindings") else []
        mut variant_idx = 0 - 1
        mut variant_enum = ""
        if (not is_wildcard) and pat_kind == "ident":
            # Try every enum looking for this variant name.
            n_enums = len(scope.en_names)
            loop ei in 0..<n_enums:
                en_name = at(scope.en_names, ei)
                if not contains_dollar(en_name):
                    v_idx = scope_lookup_enum_variant(scope, en_name, pat_value)
                    if v_idx >= 0 and variant_idx < 0:
                        variant_idx = v_idx
                        variant_enum = en_name
        is_variant = variant_idx >= 0
        # A non-`_`, non-variant ident pattern is a BINDING pattern: it matches
        # anything (irrefutable) and binds the whole scrutinee to that name.
        # This is what makes a guard on a scalar work: `x if x > 0 -> ...`.
        is_binding_pat = (not is_wildcard) and pat_kind == "ident" and (not is_variant)
        # A tuple pattern `(a, b) -> ...` is irrefutable and binds each field.
        is_tuple_pat_arm = pat_kind == "tuple"

        # Phase 1: emit pat (skip for wildcard).
        do_int_pat = (not is_wildcard) and pat_kind == "int"
        do_str_pat = (not is_wildcard) and pat_kind == "str"
        do_variant_pat = is_variant
        mut pat_id = 0 - 1
        if do_int_pat:
            pr_pat = ir_fn_push(current_fn, ir_iconst(parse_int(pat_value)))
            current_fn = pr_pat.function
            pat_id = pr_pat.id
        if do_str_pat:
            pr_pat = ir_fn_push(current_fn, ir_const_str(pat_value))
            current_fn = pr_pat.function
            pat_id = pr_pat.id
        if do_variant_pat:
            pr_pat = ir_fn_push(current_fn, ir_iconst(variant_idx))
            current_fn = pr_pat.function
            pat_id = pr_pat.id

        # Phase 2: emit icmp + branch (skip for wildcard, binding, and tuple
        # patterns — all irrefutable).
        do_cmp = (not is_wildcard) and (not is_binding_pat) and (not is_tuple_pat_arm)
        # A PLAIN enum (no variant carries a payload) lowers to a bare integer
        # tag — `Color.Red` IS 0, there is no struct. Reading field 0 off it
        # dereferences the tag as a pointer (tag 2 -> address 0x2), which is why
        # `match` on such an enum segfaulted. Compare the value itself instead.
        # A TAGGED union really is a struct, so it keeps the tag load.
        do_tagged_variant = do_variant_pat and enum_has_payloads(scope, variant_enum)
        do_text_cmp = do_cmp and scrut_type == "text" and not do_variant_pat
        do_int_cmp = do_cmp and scrut_type != "text" and not do_tagged_variant
        # Variant: load scrut.tag (field 0) then compare.
        mut eq_id = 0 - 1
        if do_tagged_variant:
            pr_load_tag = ir_fn_push(current_fn, ir_field_load(scrut_id, 0, "i64"))
            current_fn = pr_load_tag.function
            pr_eq = ir_fn_push(current_fn, ir_icmp_eq(pr_load_tag.id, pat_id))
            current_fn = pr_eq.function
            eq_id = pr_eq.id
        if do_text_cmp:
            pr_eq = ir_fn_push(current_fn, ir_text_cmp("text_eq", scrut_id, pat_id))
            current_fn = pr_eq.function
            eq_id = pr_eq.id
        if do_int_cmp:
            pr_eq = ir_fn_push(current_fn, ir_icmp_eq(scrut_id, pat_id))
            current_fn = pr_eq.function
            eq_id = pr_eq.id
        if do_cmp:
            pr_br_if = ir_fn_push(current_fn, ir_br_if(eq_id, body_lbl, next_lbl))
            current_fn = pr_br_if.function
            pr_body_lbl = ir_fn_push(current_fn, ir_label(body_lbl))
            current_fn = pr_body_lbl.function

        # Phase 2b: variant payload bindings — binding i loads slot p{i}
        # (field index 1+i) RETYPED to the variant's declared payload
        # type at that position, so `Spawn(comps) -> do_spawn(s, comps)`
        # types comps as map, `Relate(a, kind, b)` gets i64/text/i64.
        arm_start_names = len(current_scope.names)
        mut body_scope = current_scope
        n_arm_bindings = len(bindings)
        if do_variant_pat:
            arm_want = variant_payload_count(scope, variant_enum, pat_value)
            if n_arm_bindings != arm_want:
                compile_error("orion: ERROR — match arm `{pat_value}` binds {n_arm_bindings} value(s) but the variant carries {arm_want}")
        if do_variant_pat and n_arm_bindings > 0:
            payload_csv = scope_lookup_variant_payloads(scope, variant_enum, pat_value)
            payload_types = split_csv(payload_csv)
            n_payload_types = len(payload_types)
            loop abi in 0..<n_arm_bindings:
                bind_name = at(bindings, abi)
                bind_type = if abi < n_payload_types then at(payload_types, abi) else "i64"
                pr_load_val = ir_fn_push(current_fn, ir_field_load(scrut_id, 1 + abi, bind_type))
                current_fn = pr_load_val.function
                # A nested sub-pattern tests the slot's own tag and binds its
                # names; a plain slot just binds the whole payload.
                if is_nested_binding(bind_name):
                    nest_r = otir_lower_nested_pat(current_fn, body_scope, bind_name, pr_load_val.id, bind_type, next_lbl, "{body_lbl}_nest{abi}")
                    current_fn = nest_r.function
                    body_scope = nest_r.scope
                else:
                    body_scope = scope_bind(body_scope, bind_name, pr_load_val.id)

        # A binding pattern (`x -> ...`) binds the whole scrutinee.
        if is_binding_pat:
            body_scope = scope_bind(body_scope, pat_value, scrut_id)
        # A tuple pattern (`(a, b) -> ...`) binds each field. Reuse the proven
        # field-access path: bind the scrutinee to a temp, then lower `temp._i`
        # per binding (so each field keeps its real type from the tuple spec).
        if is_tuple_pat_arm:
            body_scope = scope_bind(body_scope, "__tup_scrut", scrut_id)
            loop tpi in 0..<n_arm_bindings:
                tf_node = {"kind": "Field", "object": {"kind": "Ident", "name": "__tup_scrut"}, "field": "_{tpi}"}
                tf_r = ast_expr_to_ir(current_fn, body_scope, tf_node)
                current_fn = tf_r.function
                body_scope = scope_bind(tf_r.scope, at(bindings, tpi), tf_r.id)

        # Phase 2c: guard. `Pattern if COND -> body` matches only when COND is
        # also true (evaluated with the arm's bindings in scope). A failed guard
        # falls through to the next arm's test.
        if has(arm, "guard"):
            guard_r = ast_expr_to_ir(current_fn, body_scope, get(arm, "guard"))
            current_fn = guard_r.function
            body_scope = guard_r.scope
            pr_gbr = ir_fn_push(current_fn, ir_br_if(guard_r.id, guard_lbl, next_lbl))
            current_fn = pr_gbr.function
            pr_glbl = ir_fn_push(current_fn, ir_label(guard_lbl))
            current_fn = pr_glbl.function

        # Phase 3: body — emit for both wildcard and pattern arms.
        arm_before = len(body_scope.names)
        body_r = ast_expr_to_ir(current_fn, body_scope, body_node)
        check_branch_shadows(arm_before, body_r.scope, "match arm", node)
        current_fn = body_r.function
        # Arm-locals (payload binds included) die with the arm.
        current_scope = scope_truncate(body_r.scope, arm_start_names)
        # A diverging arm (break/continue/return) already branched away, so its
        # block is terminated and `body_r.id` is not a real value. Storing it or
        # branching to `end` after a terminator was the bug that crashed on
        # `_ -> break` inside a loop. Only store + branch for arms that fall off
        # the end normally.
        # An arm can also produce NO VALUE without diverging: a body block whose
        # last statement is a statement-form `if` (or a loop) yields id -1. That
        # is what `if let P(x) = e:` desugars to when its body is an `if` block,
        # and storing -1 walked the instruction list backwards:
        # "list index -1 out of range". Store a zero for the value the arm does
        # not have, so the match still has a defined result.
        if is_block_terminated(current_fn) == 0:
            mut arm_value_id = body_r.id
            if arm_value_id < 0:
                pr_void = ir_fn_push(current_fn, ir_iconst(0))
                current_fn = pr_void.function
                arm_value_id = pr_void.id
            pr_store = ir_fn_push(current_fn, ir_store(result_ptr_id, arm_value_id))
            current_fn = pr_store.function
            pr_br_end = ir_fn_push(current_fn, ir_br(end_lbl))
            current_fn = pr_br_end.function

        # Phase 4: next-arm-test label. Emitted for a compared arm, and also
        # for a guarded arm (a failed guard branches here) even if it's a
        # wildcard that otherwise skips the compare.
        if do_cmp or has(arm, "guard"):
            pr_next_lbl = ir_fn_push(current_fn, ir_label(next_lbl))
            current_fn = pr_next_lbl.function

    # If no wildcard, ensure the last "next" block has a terminator.
    # Store 0 as default and br end.
    if is_block_terminated(current_fn) == 0:
        pr_zero = ir_fn_push(current_fn, ir_iconst(0))
        pr_store0 = ir_fn_push(pr_zero.function, ir_store(result_ptr_id, pr_zero.id))
        pr_br_end = ir_fn_push(pr_store0.function, ir_br(end_lbl))
        current_fn = pr_br_end.function

    # End block: load result.
    pr_end_lbl = ir_fn_push(current_fn, ir_label(end_lbl))
    pr_load = ir_fn_push(pr_end_lbl.function, ir_load(result_ptr_id, result_type))
    ConvResult{function: pr_load.function, scope: scrut_r.scope, id: pr_load.id}


# `(a, b, ...)` — a tuple. Lower each element (once), then build an anonymous
# struct whose shape is derived from the element IR types. Because the fields
# carry their real per-slot types, a heterogeneous tuple like `(1, "hi")` keeps
# `_0` as int and `_1` as text (unlike the old homogeneous list lowering).
fn ast_tuple_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    items = get_list(node, "items")
    n_items = len(items)
    mut current_fn = fn_value
    mut current_scope = scope
    mut item_ids = []
    elem_types = slice([""], 0, 0)
    mut elem_type_list = elem_types
    loop ti in 0..<n_items:
        it_r = ast_expr_to_ir(current_fn, current_scope, at(items, ti))
        current_fn = it_r.function
        current_scope = it_r.scope
        item_ids = push(item_ids, it_r.id)
        elem_type_list = push(elem_type_list, get_value_type(current_fn, it_r.id))
    tup_name = otir_tuple_register(elem_type_list)
    pr = ir_fn_push(current_fn, ir_struct_cons(tup_name, n_items, item_ids))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}

fn ast_struct_cons_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    struct_name = get(node, "name")
    fields = get_list(node, "fields")
    spec = scope_lookup_data_spec(scope, struct_name)
    if spec == "":
        line = if has(node, "line") then get_int(node, "line") else 0
        col = if has(node, "col") then get_int(node, "col") else 0
        compile_error("orion: ERROR at {otir_where(line, col)} — unknown data type `{struct_name}`")
    parts = parse_data_spec(spec)
    n_fields_decl = len(parts)
    n_provided = len(fields)
    # Build value_ids in declared field order.
    mut current_fn = fn_value
    mut current_scope = scope
    mut value_ids = []
    loop di in 0..<n_fields_decl:
        decl_part = at(parts, di)
        # The field's IR type (the spec stores ast_type_to_ir output, so this is
        # "struct:X"/"text"/"list:T"/"i64" - ready for concrete_ptr_kind).
        decl_field_type = field_type_at(parts, di)
        decl_bs = bytes_from_text(decl_part)
        mut decl_name = ""
        mut found_colon = 0
        decl_bs_n = len(decl_bs)
        loop ci in 0..<decl_bs_n:
            b = at(decl_bs, ci)
            if found_colon == 0:
                if b == 58:
                    found_colon = 1
                else:
                    single = bytes_to_text([b])
                    decl_name = "{decl_name}{single}"
        # Search provided fields for decl_name.
        mut matched_id = 0 - 1
        loop pi in 0..<n_provided:
            prov = at(fields, pi)
            if get(prov, "name") == decl_name and matched_id == (0 - 1):
                val_r = ast_expr_to_ir(current_fn, current_scope, get(prov, "value"))
                current_fn = val_r.function
                current_scope = val_r.scope
                matched_id = val_r.id
                # Struct-field construction subtype guard (same rule as return/
                # rebind/call-arg): a reliably-shaped field value of one concrete
                # pointer kind (text/list/struct) where a DIFFERENT concrete kind
                # is declared is a type error. map/fn/generic fields = wildcard;
                # an unreliable value (slot_get/map-get) is skipped.
                fld_val_ty = get_value_type(current_fn, matched_id)
                fld_decl_k = concrete_ptr_kind(decl_field_type)
                fld_val_k = concrete_ptr_kind(fld_val_ty)
                if fld_decl_k != "" and fld_val_k != "" and fld_decl_k != fld_val_k and (not is_unreliable_ptr(current_fn, matched_id)):
                    fc_line = if has(prov, "line") then get_int(prov, "line") else (if has(node, "line") then get_int(node, "line") else 0)
                    fc_col = if has(prov, "col") then get_int(prov, "col") else 0
                    compile_error("orion: ERROR at {otir_where(fc_line, fc_col)} — field `{decl_name}` of `{struct_name}` is declared `{friendly_type(decl_field_type)}` but got a `{friendly_type(fld_val_ty)}` (a {fld_val_k} where a {fld_decl_k} was expected)")
        if matched_id == (0 - 1):
            # Field not written explicitly. With `{..source, ...}` read it from
            # the spread source (`source.field`); otherwise default to 0.
            if has(node, "spread"):
                sp_field_node = {"kind": "Field", "object": get(node, "spread"), "field": decl_name}
                sp_r = ast_expr_to_ir(current_fn, current_scope, sp_field_node)
                current_fn = sp_r.function
                current_scope = sp_r.scope
                matched_id = sp_r.id
            else:
                pr_default = ir_fn_push(current_fn, ir_iconst(0))
                current_fn = pr_default.function
                matched_id = pr_default.id
        value_ids = push(value_ids, matched_id)
    pr = ir_fn_push(current_fn, ir_struct_cons(struct_name, n_fields_decl, value_ids))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}


fn ast_field_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    obj_node = get(node, "object")
    field_name = get(node, "field")
    # Special-case `EnumName.Variant` — obj is an Ident matching a known enum,
    # field is the variant. Lower to iconst(variant_index).
    mut handled_enum = false
    mut enum_result = ConvResult{function: fn_value, scope: scope, id: 0 - 1}
    obj_kind = get(obj_node, "kind")
    if obj_kind == "Ident":
        obj_name = get(obj_node, "name")
        var_idx = scope_lookup_enum_variant(scope, obj_name, field_name)
        if var_idx >= 0:
            handled_enum = true
            if enum_has_payloads(scope, obj_name):
                # Tagged union: `EnumName.Variant` used as a VALUE (no `(...)`)
                # builds the full struct (tag + zeroed payload slots), typed
                # struct:Enum — exactly like the `Variant(args)` MethodCall path.
                # Emitting a bare tag int here was the bug that made `Opt.None`
                # type as `int` and clash with `Opt.Some`.
                ev_want = variant_payload_count(scope, obj_name, field_name)
                if ev_want > 0:
                    ev_line = if has(node, "line") then get_int(node, "line") else 0
                    ev_col = if has(node, "col") then get_int(node, "col") else 0
                    compile_error("orion: ERROR at {otir_where(ev_line, ev_col)} — variant `{field_name}` takes {ev_want} value(s), got 0 (add `(...)`)")
                ev_spec = scope_lookup_data_spec(scope, obj_name)
                ev_slots = count_spec_fields(ev_spec) - 1
                mut ev_fields = [{"name": "tag", "value": {"kind": "Int", "value": int_to_text_helper(var_idx)}}]
                loop evi in 0..<ev_slots:
                    ev_fields = push(ev_fields, {"name": "p{evi}", "value": {"kind": "Int", "value": "0"}})
                ev_cons = {"kind": "StructCons", "name": obj_name, "fields": ev_fields}
                enum_result = ast_struct_cons_to_ir(fn_value, scope, ev_cons)
            else:
                # Plain enumeration (all zero-payload): the variant IS its
                # integer tag, usable in arithmetic (`Color.Red + Color.Blue`).
                pr = ir_fn_push(fn_value, ir_iconst(var_idx))
                enum_result = ConvResult{function: pr.function, scope: scope, id: pr.id}
    mut result = enum_result
    if not handled_enum:
        obj_r = ast_expr_to_ir(fn_value, scope, obj_node)
        obj_type = get_value_type(obj_r.function, obj_r.id)
        mut struct_name = ""
        obj_bytes = bytes_from_text(obj_type)
        n = len(obj_bytes)
        mut past_colon = 0
        loop ci in 0..<n:
            b = at(obj_bytes, ci)
            if past_colon == 1:
                single = bytes_to_text([b])
                struct_name = "{struct_name}{single}"
            else:
                if b == 58:
                    past_colon = 1
        spec = scope_lookup_data_spec(scope, struct_name)
        parts = parse_data_spec(spec)
        field_idx = find_field_index(parts, field_name)
        field_type = field_type_at(parts, field_idx)
        if field_idx < 0:
            line = if has(node, "line") then get_int(node, "line") else 0
            col = if has(node, "col") then get_int(node, "col") else 0
            compile_error("orion: ERROR at {otir_where(line, col)} — `{struct_name}` has no field `{field_name}`")
        pr_load = ir_fn_push(obj_r.function, ir_field_load(obj_r.id, field_idx, field_type))
        result = ConvResult{function: pr_load.function, scope: obj_r.scope, id: pr_load.id}
    result


fn ast_map_lit_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    pairs = get_list(node, "pairs")
    n_pairs = len(pairs)
    mut current_fn = fn_value
    mut current_scope = scope
    mut pair_ids = []
    loop index in 0..<n_pairs:
        pair = at(pairs, index)
        key_text = get(pair, "key")
        val_node = get(pair, "value")
        # Emit const_str for key, walk value expr.
        pr_key = ir_fn_push(current_fn, ir_const_str(key_text))
        current_fn = pr_key.function
        val_r = ast_expr_to_ir(current_fn, current_scope, val_node)
        current_fn = val_r.function
        current_scope = val_r.scope
        pair_ids = push(pair_ids, pr_key.id)
        pair_ids = push(pair_ids, val_r.id)
    # Maps are homogeneous; take the value type from the first pair's value so
    # get()/[] recover it later. Empty map -> i64 (no values to mistype).
    mut map_val_type = "i64"
    if n_pairs > 0:
        map_val_type = get_value_type(current_fn, at(pair_ids, 1))
    pr = ir_fn_push(current_fn, ir_map_lit(pair_ids, map_val_type))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}


pub fn ast_expr_to_ir(fn_value: IRFn, scope: Scope, node: Map) -> ConvResult:
    kind = get(node, "kind")
    # `xs[i]` / `m[k]` is sugar for `at(xs, i)` (lists) or `get(m, k)` (maps).
    # Lower the container ONCE, then dispatch on its type and emit the accessor
    # directly — mirroring is_at / is_get's element typing. An earlier version
    # probed the container on a throwaway lowering and then re-lowered it inside
    # a synthesized Call; but ir_fn_push mutates the spine in place, so the
    # probe LEAKED (a side-effecting base ran twice) AND the probe's ident read
    # bumped the global move counter (a `move` base tripped a false use-after-
    # move). Lowering once kills both. Nested indexing (`xss[0][1]`) still falls
    # out: the inner Index lowers as this accessor's container. (The is_at
    # __env-capture special case can't arise here — captures lower as explicit
    # `at(__env, n)` calls, never `[]` syntax.)
    if kind == "Index":
        idx_obj = get(node, "object")
        idx_key = get(node, "index")
        obj_r = ast_expr_to_ir(fn_value, scope, idx_obj)
        key_r = ast_expr_to_ir(obj_r.function, obj_r.scope, idx_key)
        obj_type = get_value_type(key_r.function, obj_r.id)
        if is_map_type(obj_type):
            get_type = extract_map_val(obj_type)
            pr = ir_fn_push(key_r.function, ir_map_get(obj_r.id, key_r.id, get_type))
            return ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
        else:
            elem_type = extract_list_elem(obj_type)
            at_inst = ir_list_at(obj_r.id, key_r.id)
            at_inst_typed = Inst{op: at_inst.op, type_text: elem_type, value: at_inst.value, lhs: at_inst.lhs, rhs: at_inst.rhs, name: at_inst.name, args: at_inst.args}
            pr = ir_fn_push(key_r.function, at_inst_typed)
            return ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
    is_block = kind == "Block"
    is_int = kind == "Int"
    is_float_lit = kind == "Float"
    is_str = kind == "Str"
    is_binary = kind == "Binary"
    is_ident = kind == "Ident"
    is_call = kind == "Call"
    is_if = kind == "If"
    is_unary = kind == "Unary"
    is_list_lit = kind == "ListLit"
    is_tuple = kind == "Tuple"
    is_map_lit = kind == "MapLit"
    is_match = kind == "Match"
    is_struct_cons = kind == "StructCons"
    is_field = kind == "Field"
    is_method_call = kind == "MethodCall"
    is_question = kind == "Question"
    is_perform = kind == "Perform"
    is_make_closure = kind == "MakeClosure"
    mut result = ConvResult{function: fn_value, scope: scope, id: 0 - 1}
    if is_make_closure:
        # Lambda closure: lower each captured expr, then pack [fn_ptr, 1, caps].
        # Record each capture's type-code (0 int / 1 text / 2 list / 3 map) so
        # __lambda_N's prologue reads it back with the right type — the env list
        # itself is i64, so a text/list/map capture must be re-typed on read.
        mc_caps = get_list(node, "caps")
        # A lifted lambda is an ordinary fn decl, so it is emitted under its
        # orb's scope like any other; the closure must take the same name or it
        # points at a symbol that does not exist.
        mc_fn_name = otir_resolve(get(node, "fn"))
        mut mc_fn = fn_value
        mut mc_scope = scope
        mut mc_cap_ids = slice([0], 0, 0)
        loop mci in 0..<len(mc_caps):
            mc_cap_r = ast_expr_to_ir(mc_fn, mc_scope, at(mc_caps, mci))
            mc_fn = mc_cap_r.function
            mc_scope = mc_cap_r.scope
            mc_cap_ids = push(mc_cap_ids, mc_cap_r.id)
            slot_set("clos:{mc_fn_name}:capty:{mci}", cap_type_code(get_value_type(mc_fn, mc_cap_r.id)))
        pr_mc = ir_fn_push(mc_fn, ir_make_closure(mc_fn_name, mc_cap_ids, 1))
        result = ConvResult{function: pr_mc.function, scope: mc_scope, id: pr_mc.id}
    if is_block:
        result = ast_block_to_ir(fn_value, scope, node)
    if is_int:
        result = ast_int_to_ir(fn_value, scope, node)
    if is_float_lit:
        result = ast_float_to_ir(fn_value, scope, node)
    if is_str:
        result = ast_str_to_ir(fn_value, scope, node)
    if is_list_lit:
        result = ast_list_lit_to_ir(fn_value, scope, node)
    if is_tuple:
        result = ast_tuple_to_ir(fn_value, scope, node)
    if is_map_lit:
        result = ast_map_lit_to_ir(fn_value, scope, node)
    if is_match:
        result = ast_match_to_ir(fn_value, scope, node)
    if is_struct_cons:
        result = ast_struct_cons_to_ir(fn_value, scope, node)
    if is_field:
        result = ast_field_to_ir(fn_value, scope, node)
    if is_binary:
        result = ast_binop_to_ir(fn_value, scope, node)
    if is_ident:
        result = ast_ident_to_ir(fn_value, scope, node)
    if is_call:
        result = ast_call_to_ir(fn_value, scope, node)
    if is_if:
        result = ast_if_to_ir(fn_value, scope, node)
    if is_unary:
        result = ast_unary_to_ir(fn_value, scope, node)
    if is_method_call:
        method = get(node, "method")
        receiver = get(node, "receiver")
        m_args = get_list(node, "args")
        # Sum type constructor sugar — `EnumName.Variant(arg)` becomes
        # EnumName{tag: idx, val_int: arg, val_text: ""} (or val_text: arg).
        # Detect when receiver is an Ident matching a known enum_name.
        mut is_enum_cons = false
        mut enum_name = ""
        mut variant_idx = 0 - 1
        if get(receiver, "kind") == "Ident":
            rcv_name = get(receiver, "name")
            v_idx = scope_lookup_enum_variant(scope, rcv_name, method)
            if v_idx >= 0:
                is_enum_cons = true
                enum_name = rcv_name
                variant_idx = v_idx
        if is_enum_cons:
            # Arity check — the qualified `EnumName.Variant(...)` form used to
            # silently DROP extra args (the loop below only fills declared
            # slots), so `R.Ok(5)` on `enum R: Ok, Err` dropped the 5 and only
            # a downstream match arm complained. Point at the construction.
            # (The bare-variant path in ast_call_to_ir checks the same way.)
            ec_want = variant_payload_count(scope, enum_name, method)
            ec_got = len(m_args)
            if ec_got != ec_want:
                ec_line = if has(node, "line") then get_int(node, "line") else 0
                ec_col = if has(node, "col") then get_int(node, "col") else 0
                compile_error("orion: ERROR at {otir_where(ec_line, ec_col)} — variant `{method}` takes {ec_want} value(s), got {ec_got}")
            # A PLAIN enum (no variant carries a payload) IS its tag int — that
            # is what `Enum.Variant` lowers to in ast_field_to_ir. This path is
            # also where a BARE variant ident lands (`ORI` desugars to a
            # zero-arg `Seam.ORI` method call), and it used to build a struct
            # regardless, so the two spellings of one value had two different
            # runtime representations: a struct here, an int there. Emit the tag.
            ec_plain = not enum_has_payloads(scope, enum_name)
            if ec_plain:
                pr_tag = ir_fn_push(fn_value, ir_iconst(variant_idx))
                result = ConvResult{function: pr_tag.function, scope: scope, id: pr_tag.id}
            if not ec_plain:
                # Positional payload slots: arg i → field p{i}. Unused slots
                # up to the enum's synthesized width pad with zero (the width
                # comes from the registered ds spec's field count - 1).
                spec = scope_lookup_data_spec(scope, enum_name)
                n_slots = count_spec_fields(spec) - 1
                zero_int = {"kind": "Int", "value": "0"}
                mut cons_fields = [{"name": "tag", "value": {"kind": "Int", "value": int_to_text_helper(variant_idx)}}]
                n_cargs = len(m_args)
                loop pfi in 0..<n_slots:
                    pf_val = if pfi < n_cargs then at(m_args, pfi) else zero_int
                    cons_fields = push(cons_fields, {"name": "p{pfi}", "value": pf_val})
                cons_node = {"kind": "StructCons", "name": enum_name, "fields": cons_fields}
                result = ast_struct_cons_to_ir(fn_value, scope, cons_node)
        else:
            mut new_args_list = [receiver]
            n_m_args = len(m_args)
            loop ami in 0..<n_m_args:
                new_args_list = push(new_args_list, at(m_args, ami))
            line = if has(node, "line") then get_int(node, "line") else 0
            col = if has(node, "col") then get_int(node, "col") else 0
            call_node = {"kind": "Call", "callee": method, "args": new_args_list, "line": line, "col": col}
            result = ast_call_to_ir(fn_value, scope, call_node)
    # Catch SILENT dispatch failures: only fire if NONE of the kind checks
    # matched (handled dispatchers legitimately return id=-1 for void blocks).
    if is_question:
        # `expr?` desugars to:
        #   tmp = expr
        #   if tmp.tag != 0: return tmp
        #   tmp.val_int   ; the resulting expression value
        inner = get(node, "inner")
        inner_r = ast_expr_to_ir(fn_value, scope, inner)
        tmp_id = inner_r.id
        mut cur_fn = inner_r.function
        # Load tag
        pr_tag = ir_fn_push(cur_fn, ir_field_load(tmp_id, 0, "i64"))
        cur_fn = pr_tag.function
        # iconst 0 for compare
        pr_zero = ir_fn_push(cur_fn, ir_iconst(0))
        cur_fn = pr_zero.function
        pr_ne = ir_fn_push(cur_fn, ir_icmp_ne(pr_tag.id, pr_zero.id))
        cur_fn = pr_ne.function
        # Branch to return-tmp block or continue
        n_q = len(cur_fn.instructions)
        ret_lbl = "q_{n_q}_ret"
        cont_lbl = "q_{n_q}_cont"
        pr_br = ir_fn_push(cur_fn, ir_br_if(pr_ne.id, ret_lbl, cont_lbl))
        cur_fn = pr_br.function
        # Return-tmp block
        pr_ret_lbl = ir_fn_push(cur_fn, ir_label(ret_lbl))
        cur_fn = pr_ret_lbl.function
        pr_ret = ir_fn_push(cur_fn, ir_return(tmp_id))
        cur_fn = pr_ret.function
        # Continue block — unwrap the success payload (field 1). Type it from
        # the enum's tag-0 variant's DECLARED payload, not a bare i64: a
        # Result[Text]/[list]/[map] carries a pointer there, and reading it as
        # i64 leaked the raw pointer into downstream text/concat/field use.
        # Falls back to i64 when the operand's enum can't be resolved.
        pr_cont_lbl = ir_fn_push(cur_fn, ir_label(cont_lbl))
        cur_fn = pr_cont_lbl.function
        q_enum = strip_struct_prefix(get_value_type(cur_fn, tmp_id))
        mut q_payload_type = "i64"
        q_ok_variant = enum_first_variant(scope, q_enum)
        if q_ok_variant != "":
            q_payloads = split_csv(scope_lookup_variant_payloads(scope, q_enum, q_ok_variant))
            if len(q_payloads) > 0:
                q_payload_type = at(q_payloads, 0)
        pr_val = ir_fn_push(cur_fn, ir_field_load(tmp_id, 1, q_payload_type))
        result = ConvResult{function: pr_val.function, scope: inner_r.scope, id: pr_val.id}
    if is_perform:
        # `perform Effect.op(arg)` lowers to a setjmp-protected call so
        # the handler can `resume_int(value)` to come back here with that
        # value. The handler is a regular fn named __handler_Effect_op;
        # one-shot only (single resume per perform).
        effect_name = get(node, "effect")
        op_name = get(node, "op")
        handler_name = "__handler_{effect_name}_{op_name}"
        perf_args = get_list(node, "args")
        n_pa = len(perf_args)
        mut cur_fn = fn_value
        mut cur_scope = scope
        # EVERY argument is lowered and passed. This used to keep the first and
        # evaluate-then-drop the rest, so `perform Math.add(40, 2)` handed the
        # handler one argument and read register garbage for the other: it
        # returned 248 instead of 42, with no error.
        mut perf_arg_ids = slice([0], 0, 0)
        loop pi in 0..<n_pa:
            arg_node = at(perf_args, pi)
            arg_r = ast_expr_to_ir(cur_fn, cur_scope, arg_node)
            cur_fn = arg_r.function
            cur_scope = arg_r.scope
            perf_arg_ids = push(perf_arg_ids, arg_r.id)
        # The runtime casts the handler to one of five arities (0..4).
        if n_pa > 4:
            pf_line = if has(node, "line") then get_int(node, "line") else 0
            pf_col = if has(node, "col") then get_int(node, "col") else 0
            compile_error("orion: ERROR at {otir_where(pf_line, pf_col)} — `perform {effect_name}.{op_name}` passes {n_pa} arguments; an effect operation takes at most 4")
        # Pick perform_int vs perform_text based on handler's return type.
        # Defaults to int when the handler isn't declared (compile error
        # will surface elsewhere).
        # A handler is an ordinary fn, so it is orb-local unless declared `pub`:
        # resolve the synthesized `__handler_<Effect>_<op>` the same way a call
        # resolves, or a private handler is emitted mangled and never found.
        handler_g = otir_resolve(handler_name)
        handler_ret = scope_lookup_fn_ret_loc(cur_scope, handler_g, node)
        # Arity against the HANDLER's declared parameters. A mismatch is the
        # same silent-garbage class as above (the handler reads a parameter that
        # was never passed), and the registry is already there for calls.
        pf_arity_key = "otir:arity:" + handler_g
        if slot_has(pf_arity_key):
            pf_want = slot_get_int(pf_arity_key)
            if n_pa != pf_want:
                pfa_line = if has(node, "line") then get_int(node, "line") else 0
                pfa_col = if has(node, "col") then get_int(node, "col") else 0
                compile_error("orion: ERROR at {otir_where(pfa_line, pfa_col)} — `{effect_name}.{op_name}` is handled with {pf_want} parameter(s), got {n_pa}")
        use_text = handler_ret == "text"
        if use_text:
            pr_perf = ir_fn_push(cur_fn, ir_perform_text(handler_g, perf_arg_ids))
            result = ConvResult{function: pr_perf.function, scope: cur_scope, id: pr_perf.id}
        else:
            pr_perf = ir_fn_push(cur_fn, ir_perform_int(handler_g, perf_arg_ids))
            result = ConvResult{function: pr_perf.function, scope: cur_scope, id: pr_perf.id}
    any_match = is_block or is_int or is_float_lit or is_str or is_binary or is_ident or is_call or is_if or is_unary or is_list_lit or is_tuple or is_map_lit or is_match or is_struct_cons or is_field or is_method_call or is_question or is_perform or is_make_closure
    if not any_match:
        line = if has(node, "line") then get_int(node, "line") else 0
        col = if has(node, "col") then get_int(node, "col") else 0
        # A parser `Error` node means the token was not the start of anything the
        # language has. Say WHICH token: "unhandled AST node kind `Error`" named
        # a compiler internal, so `x |> f` and `|x| x + 1` (neither is Orion
        # syntax) both reported the same thing, at line 0:0.
        found = if has(node, "found") then get(node, "found") else ""
        # A parser Error may carry its own explanation (`why`); that is more
        # specific than the generic "not valid here" and wins.
        why = if has(node, "why") then get(node, "why") else ""
        if kind == "Error" and why != "":
            compile_error("orion: ERROR at {otir_where(line, col)} — {why}")
        if kind == "Error" and why == "":
            # The hint has to fit the token. Naming the pipe and the lambda for
            # every unexpected byte (a stray `:`, say) is noise that sends the
            # reader looking in the wrong place.
            hint = if found == "|" then " (Orion has one lambda form, `fn(x): body`, and no pipe operator)" else (if found == ":" then " (a match arm is `Pattern -> value`; `:` opens a block after `if`/`loop`/`fn`)" else "")
            compile_error("orion: ERROR at {otir_where(line, col)} — `{found}` is not valid here, an expression was expected{hint}")
        if kind != "Error":
            compile_error("orion: ERROR at {otir_where(line, col)} — unhandled AST node kind `{kind}` (emit iconst 0 as fallback)")
        pr_fallback = ir_fn_push(fn_value, ir_iconst(0))
        result = ConvResult{function: pr_fallback.function, scope: scope, id: pr_fallback.id}
    result


# Closure capture type-codes: 0 = i64/int, 1 = text, 2 = list, 3 = map.
# Anything else (struct etc.) falls back to 0 (read as i64).
fn cap_type_code(t: Text) -> int:
    mut code = 0
    if t == "text":
        code = 1
    if is_list_type(t):
        code = 2
    if t == "map":
        code = 3
    code

fn cap_code_type(code: int) -> Text:
    mut t = "i64"
    if code == 1:
        t = "text"
    if code == 2:
        t = "list:i64"
    if code == 3:
        t = "map"
    t


# Map a parser type-node to an IR type string ("text" / "list" / "i64").
# Given a "list:T" encoding, return T. Fallback "i64" for plain "list".
fn is_list_type(type_text: Text) -> bool:
    if type_text == "list":
        true
    else:
        bs = bytes_from_text(type_text)
        n = len(bs)
        if n >= 5:
            at(bs, 0) == 108 and at(bs, 1) == 105 and at(bs, 2) == 115 and at(bs, 3) == 116 and at(bs, 4) == 58
        else:
            false

fn extract_list_elem(type_text: Text) -> Text:
    bs = bytes_from_text(type_text)
    n = len(bs)
    mut is_param = false
    if n >= 5:
        if at(bs, 0) == 108 and at(bs, 1) == 105 and at(bs, 2) == 115 and at(bs, 3) == 116 and at(bs, 4) == 58:
            is_param = true
    if not is_param:
        "i64"
    else:
        mut result = ""
        loop ci in 5..<n:
            single = bytes_to_text([at(bs, ci)])
            result = "{result}{single}"
        result

# ---- generic call-site instantiation (types only) ---------------------
#
# Generics are ERASED: inside `fn filter<T>(xs: [T], pred: fn) -> [T]` the type
# var lowers to an i64 slot, and the declared return `[T]` lowers with it. So a
# call site got `list:i64` back and every element read out of the result was an
# int: `at(filter(words, p), 0)` produced an int where the text was, and `len`
# on it failed. Erasure is right for CODE (one body serves every T), but the
# call site knows more than the body does: it can see the actual argument types.
#
# So: bind each type var by matching the DECLARED source types against the
# ACTUAL argument IR types, then re-type the call's result. Types only, no new
# code and no new syntax - the runtime representation is unchanged (a list of
# text pointers and a list of ints are both i64 slots), this just stops the
# compiler from forgetting which one it is.
#
# Source types are recorded as text by the signature pass: "T", "[T]", "int".

# Render an AST type node the way the instantiation matcher reads it.
fn type_src_text(type_node: Map) -> Text:
    kind = get(type_node, "kind")
    if kind == "List":
        inner = type_src_text(get(type_node, "elem"))
        "[{inner}]"
    else:
        if kind == "Named":
            get(type_node, "name")
        else:
            ""

# Index of `name` in the type-var list, or -1.
fn tv_slot(gens: [Text], name: Text) -> int:
    mut found = 0 - 1
    loop i in 0..<len(gens):
        if at(gens, i) == name:
            found = i
    found

# "[X]" -> "X"; anything else -> "".
fn strip_brackets(s: Text) -> Text:
    bs = bytes_from_text(s)
    n = len(bs)
    mut wrapped = false
    if n >= 3:
        if at(bs, 0) == 91 and at(bs, n - 1) == 93:
            wrapped = true
    if not wrapped:
        ""
    else:
        mut inner = ""
        loop ci in 1..<(n - 1):
            inner = inner + bytes_to_text([at(bs, ci)])
        inner

# Match one declared source type against one actual IR type, binding type vars.
# `binds` is parallel to `gens`; "" means still unbound. First binding wins.
fn tv_unify(src: Text, actual: Text, gens: [Text], binds: [Text]) -> [Text]:
    mut out = binds
    inner_src = strip_brackets(src)
    if inner_src != "":
        # `[X]` against `list:E` - recurse on the element.
        if is_list_type(actual):
            out = tv_unify(inner_src, extract_list_elem(actual), gens, out)
    else:
        slot = tv_slot(gens, src)
        if slot >= 0:
            if at(out, slot) == "":
                out = set(out, slot, actual)
    out

# Substitute bound type vars into a declared source type, producing an IR type.
# "" means "nothing to substitute" - the caller keeps the erased type.
fn tv_subst(src: Text, gens: [Text], binds: [Text]) -> Text:
    inner_src = strip_brackets(src)
    if inner_src != "":
        inner_ir = tv_subst(inner_src, gens, binds)
        if inner_ir == "":
            ""
        else:
            "list:{inner_ir}"
    else:
        slot = tv_slot(gens, src)
        if slot < 0:
            ""
        else:
            at(binds, slot)

# Is this IR type pointer-shaped in the emitted module? (An i64 slot holding a
# refined pointer type needs an explicit re-type; a refined `int`/`f64` does not
# and must not get one.)
fn is_ptr_ir_type(t: Text) -> bool:
    if t == "text" or t == "fn":
        true
    else:
        if is_list_type(t) or is_map_type(t):
            true
        else:
            strip_struct_prefix(t) != t

# The result type of a call to a generic fn, given the actual argument types.
# Returns the erased type unchanged for a non-generic callee, for a return type
# that names no type var, or when the arguments do not pin the var down.
fn otir_call_ret_generic(fn_name: Text, arg_types: [Text], erased_ret: Text) -> Text:
    gen_key = "otir:gen:" + fn_name
    ret_key = "otir:rsrc:" + fn_name
    mut out = erased_ret
    if slot_has(gen_key) and slot_has(ret_key):
        gens = split_csv(slot_get(gen_key))
        mut binds = slice([""], 0, 0)
        loop gi in 0..<len(gens):
            binds = push(binds, "")
        loop ai in 0..<len(arg_types):
            p_key = "otir:psrc:" + fn_name + ":{ai}"
            if slot_has(p_key):
                binds = tv_unify(slot_get(p_key), at(arg_types, ai), gens, binds)
        instantiated = tv_subst(slot_get(ret_key), gens, binds)
        if instantiated != "":
            out = instantiated
    out

# The concrete pointer SHAPE for the return-type guard: "text", "list" or
# "struct", or "" for a WILDCARD kind (map, fn, int, float, generic/unknown)
# that the guard must not diff. All pointer shapes share i64 storage, so the
# old i64/ptr bucket check can't tell them apart — yet returning a Text where a
# struct is declared (or a list where a Text is) is a real, silent bug. This
# discriminates the three concrete shapes while leaving `map` as the deliberate
# dynamic escape (map <-> anything never triggers the guard), which is what
# keeps the stringly-typed self-host compiler and the boxed-Map ECS compiling.
fn concrete_ptr_kind(t: Text) -> Text:
    if t == "text":
        "text"
    else if is_list_type(t):
        "list"
    else:
        bs = bytes_from_text(t)
        n = len(bs)
        mut is_struct = false
        if n >= 7:
            if at(bs, 0) == 115 and at(bs, 1) == 116 and at(bs, 2) == 114 and at(bs, 3) == 117 and at(bs, 4) == 99 and at(bs, 5) == 116 and at(bs, 6) == 58:
                is_struct = true
        if is_struct then "struct" else ""

# True when a value's static type is UNRELIABLE because it came from a dynamic,
# untyped getter: slot_get returns "text" for what is really an untyped pointer
# (the whole slot store is dynamically typed), and map get/get_or read a dynamic
# container. Traced through phi merges so `if slot_has(k) then slot_get(k) else
# []` counts as unreliable. The subtype return guard skips these — only a value
# with a trustworthy static shape (a literal, a constructor, a typed getter like
# get_list/get_int) is worth diffing against the declared return type. Recurses
# only into strictly-earlier value ids so it always terminates.
fn is_unreliable_ptr(fn_value: IRFn, value_id: int) -> bool:
    if value_id < 0:
        false
    else:
        inst = at(fn_value.instructions, value_id)
        op = inst.op
        if op == "slot_get" or op == "map_get" or op == "map_get_or":
            true
        else if op == "phi":
            (inst.lhs < value_id and is_unreliable_ptr(fn_value, inst.lhs)) or (inst.rhs < value_id and is_unreliable_ptr(fn_value, inst.rhs))
        else:
            false

# True for `map` or a value-typed `map:<T>`.
fn is_map_type(type_text: Text) -> bool:
    # `dyn` is the element type of an UNANNOTATED `get_list(m, k)`: the map is
    # dynamic, so the compiler cannot know what its values are. It behaves like
    # `map` everywhere (so reading it back as a map still works, and the whole
    # AST-walking machinery is untouched) EXCEPT that `len` on it refuses rather
    # than silently doing a MAP length on what might be a text — the one place
    # the ambiguity produces a wrong answer. Annotating the read (`ys: [Text] =
    # get_list(m, k)`) resolves it.
    if type_text == "map" or type_text == "dyn":
        true
    else:
        bs = bytes_from_text(type_text)
        n = len(bs)
        if n >= 4:
            at(bs, 0) == 109 and at(bs, 1) == 97 and at(bs, 2) == 112 and at(bs, 3) == 58
        else:
            false

# The value type from a `map:<T>` type_text. Bare `map` (or non-map) yields
# `text` — the historic default for untyped maps.
fn extract_map_val(type_text: Text) -> Text:
    bs = bytes_from_text(type_text)
    n = len(bs)
    mut is_param = false
    if n >= 4:
        if at(bs, 0) == 109 and at(bs, 1) == 97 and at(bs, 2) == 112 and at(bs, 3) == 58:
            is_param = true
    if not is_param:
        "text"
    else:
        mut result = ""
        loop ci in 4..<n:
            single = bytes_to_text([at(bs, ci)])
            result = "{result}{single}"
        result

# Render an internal type name in the user's terms for error messages:
# i64 -> int, f64 -> float, list:T -> [T], struct:Foo -> Foo, void -> nothing.
# `prog__broken` -> `broken`. Function names are mangled with their orb so two
# orbs can each keep a private helper of the same name; that prefix is the
# compiler's business, and printing it in a diagnostic shows the reader a name
# that appears nowhere in their file.
fn friendly_fn_name(n: Text) -> Text:
    b = bytes_from_text(n)
    total = len(b)
    mut cut = 0
    loop i in 0..<total:
        if i + 1 < total:
            if at(b, i) == 95 and at(b, i + 1) == 95:
                cut = i + 2
    if cut == 0:
        n
    else:
        bytes_to_text(bytes_slice(b, cut, total))

fn friendly_type(t: Text) -> Text:
    if t == "i64":
        "int"
    else if t == "f64":
        "float"
    else if t == "void" or t == "Unit":
        "nothing"
    else if is_list_type(t):
        "[{friendly_type(extract_list_elem(t))}]"
    else if is_map_type(t):
        "map"
    else:
        # struct:Foo -> Foo; text / fn / ptr pass through unchanged.
        fb = bytes_from_text(t)
        fn2 = len(fb)
        mut is_struct = false
        if fn2 >= 7:
            if at(fb, 0) == 115 and at(fb, 1) == 116 and at(fb, 2) == 114 and at(fb, 3) == 117 and at(fb, 4) == 99 and at(fb, 5) == 116 and at(fb, 6) == 58:
                is_struct = true
        if is_struct:
            mut r = ""
            loop fi in 7..<fn2:
                # Temp var, NOT `[at(fb, fi)]` inline: a list literal inside a
                # `{...}` interpolation trips older self-host compilers during
                # bootstrap (the interpolation splitter mis-tokenizes the `[`
                # and `)`), which stalls the whole self-host chain.
                one = [at(fb, fi)]
                r = "{r}{bytes_to_text(one)}"
            r
        else:
            t


fn ast_type_to_ir(type_node: Map) -> Text:
    kind = get(type_node, "kind")
    # Range types (`0...255`) erase to i64 — refinement checking is a
    # future pass. Also guard nodes without a name field: a missing map
    # key is a null ptr natively, and strcmp(null) segfaults.
    if kind == "Range":
        return "i64"
    # `fn(T) -> R` — a spelled-out function type. Erases to the same "fn"
    # ptr as a bare `fn`; the signature lives in the AST for typeck only.
    if kind == "FnType":
        return "fn"
    # `(A, B, ...)` — a tuple type. Same synthesized anon-struct as the tuple
    # literal, so `(int, Text)` and `(1, "hi")` share a representation.
    if kind == "TupleType":
        tt_elems = get_list(type_node, "elems")
        tt_types = slice([""], 0, 0)
        mut tt_type_list = tt_types
        loop tti in 0..<len(tt_elems):
            tt_type_list = push(tt_type_list, ast_type_to_ir(at(tt_elems, tti)))
        return "struct:{otir_tuple_register(tt_type_list)}"
    if not has(type_node, "name"):
        if kind != "List":
            return "i64"
    if kind == "List":
        elem_node = get(type_node, "elem")
        elem = ast_type_to_ir(elem_node)
        "list:{elem}"
    else:
        name = get(type_node, "name")
        # Generic type variable (`T` in `type Result<T, E>: ...`) lowers to an
        # opaque pointer-sized slot (i64), same as fn generics. Registered via
        # the tvgen counter (see otir_bind_tyvars).
        tv_gen_nc = slot_int_or_zero("otir:tvgen")
        if tv_gen_nc > 0 and slot_int_or_zero(otir_k1("tv", name)) == tv_gen_nc:
            return "i64"
        if name == "Text" or name == "text":
            "text"
        else:
            if name == "Map" or name == "map":
                # `Map<T>` — the VALUE type, carried as `map:T`. A bare `Map`
                # holds anything, which is why reading out of one had to guess
                # (and guessed `map`, so a text element got a map's length). The
                # IR already understood `map:T` and `get` already read it; there
                # was just no way to SAY it in source.
                m_args = if has(type_node, "args") then get_list(type_node, "args") else []
                if len(m_args) == 1:
                    "map:{ast_type_to_ir(at(m_args, 0))}"
                else:
                    "map"
            else if name == "List" or name == "list":
                "list"
            else:
                if name == "fn" or name == "ptr":
                    # Function pointer / generic pointer — encode as "fn"
                    # so llvm_type_of returns "ptr" in the emit step.
                    "fn"
                else:
                    if name == "float" or name == "f64":
                        "f64"
                    else:
                        # Capitalised names (Inst, Item, IRFn, …) are presumed
                        # to be data-struct types. Snake-case / lowercase names
                        # (int, bool, void) get the i64 default.
                        name_bs = bytes_from_text(name)
                        mut starts_cap = false
                        if len(name_bs) > 0:
                            first = at(name_bs, 0)
                            if first >= 65 and first <= 90:
                                starts_cap = true
                        if starts_cap then "struct:{name}" else "i64"


# Same as ast_type_to_ir but knows about data structs declared in scope.
# A Named type whose name matches a struct decl becomes "struct:Name".
fn ast_type_to_ir_with_scope(type_node: Map, scope: Scope) -> Text:
    kind = get(type_node, "kind")
    # Same Range/missing-name guards as ast_type_to_ir.
    if kind == "Range":
        return "i64"
    if kind == "FnType":
        return "fn"
    if kind == "TupleType":
        tt_elems = get_list(type_node, "elems")
        tt_types = slice([""], 0, 0)
        mut tt_type_list = tt_types
        loop tti in 0..<len(tt_elems):
            tt_type_list = push(tt_type_list, ast_type_to_ir_with_scope(at(tt_elems, tti), scope))
        return "struct:{otir_tuple_register(tt_type_list)}"
    if not has(type_node, "name"):
        if kind != "List":
            return "i64"
    if kind == "List":
        # Encode element type so list_at can return the right thing.
        elem_node = get(type_node, "elem")
        elem_type = ast_type_to_ir_with_scope(elem_node, scope)
        "list:{elem_type}"
    else:
        name = get(type_node, "name")
        # A generic type variable (`T` in `fn first<T>(...)`) lowers to an
        # opaque pointer-sized slot (i64). Registered per-fn via a generation
        # counter (see ast_fn_to_ir) so a stale `T` from an earlier fn can't
        # match here. Checked before the struct fallback, which would otherwise
        # turn a capitalised `T` into `struct:T`.
        tv_generation = slot_int_or_zero("otir:tvgen")
        if tv_generation > 0 and slot_int_or_zero(otir_k1("tv", name)) == tv_generation:
            return "i64"
        # A `type Name = T` alias (registered in ast_program_to_ir's pre-pass)
        # resolves to its target's IR type string.
        alias_key = otir_k1("tyalias", name)
        if slot_has(alias_key):
            return slot_get(alias_key)
        if name == "Text" or name == "text":
            "text"
        else:
            if name == "Map" or name == "map":
                # `Map<T>` -> `map:T`, the value type. See ast_type_to_ir.
                ms_args = if has(type_node, "args") then get_list(type_node, "args") else []
                if len(ms_args) == 1:
                    "map:{ast_type_to_ir_with_scope(at(ms_args, 0), scope)}"
                else:
                    "map"
            else if name == "List" or name == "list":
                "list"
            else:
                if name == "fn" or name == "ptr":
                    "fn"
                else:
                    if name == "float" or name == "f64":
                        "f64"
                    else:
                        ds_names = scope.ds_names
                        n_structs = len(ds_names)
                        mut is_struct = false
                        loop si in 0..<n_structs:
                            if at(ds_names, si) == name:
                                is_struct = true
                        if is_struct then "struct:{name}" else "i64"


pub fn ast_fn_to_ir(ast_fn: Map, initial_scope: Scope) -> IRFn:
    name = get(ast_fn, "name")
    # Where this fn was declared, for the whole-program checks below. Without it
    # they printed a message with nothing to point at.
    fn_at_line = if has(ast_fn, "line") then get_int(ast_fn, "line") else 0
    fn_at_col = if has(ast_fn, "col") then get_int(ast_fn, "col") else 0
    # Register this fn's generic type variables so `T`/`U` in the signature
    # and body lower to opaque i64 slots (operation-passing generics) rather
    # than being mistaken for struct types. A per-fn generation stamp means a
    # previous fn's `T` never leaks into this one. See the type-var check in
    # ast_type_to_ir_with_scope.
    tv_gen = slot_int_or_zero("otir:tvgen") + 1
    slot_set("otir:tvgen", tv_gen)
    fn_generics = if has(ast_fn, "generics") then get_list(ast_fn, "generics") else []
    loop gi in 0..<len(fn_generics):
        slot_set(otir_k1("tv", at(fn_generics, gi)), tv_gen)
    ret_type_node = get(ast_fn, "ret")
    ret_type = ast_type_to_ir_with_scope(ret_type_node, initial_scope)
    mut fn_value = ir_fn_new(name, ret_type)
    params = get_list(ast_fn, "params")
    n_params = len(params)
    mut scope = initial_scope
    loop index in 0..<n_params:
        param = at(params, index)
        param_name = get(param, "name")
        param_type_node = get(param, "type")
        param_type = ast_type_to_ir_with_scope(param_type_node, initial_scope)
        fn_value = ir_fn_add_param(fn_value, param_name, param_type)
        pr = ir_fn_push(fn_value, ir_param(index, param_type))
        fn_value = pr.function
        scope = scope_bind(scope, param_name, pr.id)
    body = get(ast_fn, "body")
    # A block-form fn with zero statements means the body was empty in source
    # (a forgotten body) OR a mis-parse swallowed it (e.g. a keyword used as a
    # variable name that ended the body early). Lowering an empty block just
    # emits `ret 0` — a silently wrong program. Make it loud instead. Externs
    # are a separate ExternFn node and never reach here; short-form `= expr`
    # fns carry a one-statement block, so neither is affected.
    if get(body, "kind") == "Block" and len(get_list(body, "stmts")) == 0:
        compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} — function `{friendly_fn_name(name)}` has an empty body (add a body, or check for a keyword used as a variable name)")
    body_result = ast_expr_to_ir(fn_value, scope, body)
    # Return-type guard: the tail expression's storage shape (i64 vs pointer)
    # must match the declared return type. Catches `fn f() -> int: "hello"`
    # (returns text) instead of silently returning garbage. Only compares the
    # i64/ptr bucket, like the reassignment check — text/list/map/struct all
    # share ptr storage, so no false positive between them. `fn`, `f64` and
    # `Unit` are exempt (bit-punned fn pointers, doubles, void).
    if is_block_terminated(body_result.function) == 0:
        rt_body = get_value_type(body_result.function, body_result.id)
        # A fn with no `-> type` gets the `Unit` sentinel (a void procedure
        # called for its effect). There's no declared return to violate, so
        # exempt it — only an EXPLICIT return type is a contract to check.
        ret_undeclared = has(ret_type_node, "name") and get(ret_type_node, "name") == "Unit"
        rt_exempt = ret_undeclared or ret_type == "fn" or ret_type == "f64" or ret_type == "Unit" or rt_body == "fn" or rt_body == "f64" or rt_body == "void" or rt_body == "Unit"
        rt_decl_ll = if ret_type == "i64" then "i64" else "ptr"
        rt_body_ll = if rt_body == "i64" then "i64" else "ptr"
        if (not rt_exempt) and rt_decl_ll != rt_body_ll:
            compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} — function `{friendly_fn_name(name)}` is declared to return `{friendly_type(ret_type)}` but its body returns `{friendly_type(rt_body)}`")
        # Sharpened guard: among POINTER shapes, catch confusing two concrete
        # kinds (text/list/struct). `map`/`fn`/generic stay wildcards (kind ""),
        # the deliberate dynamic escape. And we SKIP bodies whose type is
        # unreliable (slot_get/map get, traced through phis) — so the pervasive
        # `-> [T]: if slot_has(k) then slot_get(k) else []` idiom is never
        # flagged, only a value with a trustworthy static shape. This is the
        # first real pointer-subtype typing, using info the IR already tracks.
        decl_kind = concrete_ptr_kind(ret_type)
        body_kind = concrete_ptr_kind(rt_body)
        body_unreliable = is_unreliable_ptr(body_result.function, body_result.id)
        if (not rt_exempt) and (not body_unreliable) and decl_kind != "" and body_kind != "" and decl_kind != body_kind:
            compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} — function `{friendly_fn_name(name)}` is declared to return `{friendly_type(ret_type)}` but its body returns `{friendly_type(rt_body)}` (a {body_kind} where a {decl_kind} was declared)")
        ret_result = ir_fn_push(body_result.function, ir_return(body_result.id))
        ret_result.function
    else:
        body_result.function


# ---- `defer` as an AST rewrite ---------------------------------------
#
# `defer E` runs E at the end of its block, and before ANY `return` that leaves
# it, in LIFO order. The lowering collected Defer statements inside the function
# body's statement loop and replayed them there, which covered the block end and
# a top-level return — but a `return` inside an `if` or a loop is lowered by its
# own nested statement loop, which knew nothing about the outer list. So
#
#     fn f(x: int) -> int:
#         defer cleanup()
#         if x > 0:
#             return 1        # cleanup() never ran
#
# skipped the deferred call silently. Doing it as an AST rewrite instead means
# the nested `return` is right there in the tree: every return gets the visible
# defers spliced in ahead of it, innermost first, and each block ends with its
# own. Nothing is left for the lowering to special-case.

fn defer_concat(a: [Map], b: [Map]) -> [Map]:
    mut out = slice(a, 0, len(a))
    loop i in 0..<len(b):
        out = push(out, at(b, i))
    out

# Append `items` in REVERSE as plain expression statements: last registered runs
# first, which is what LIFO means for a defer.
fn defer_append_reverse(out: [Map], items: [Map]) -> [Map]:
    mut acc = out
    n = len(items)
    loop i in 0..<n:
        acc = push(acc, {"kind": "ExprStmt", "expr": at(items, n - 1 - i)})
    acc

fn defer_rewrite_else(node: Map, visible: [Map]) -> Map:
    kind = get(node, "kind")
    if kind == "Block":
        defer_rewrite_block(node, visible)
    else:
        if kind == "IfBlock":
            defer_rewrite_stmt(node, visible)
        else:
            node

fn defer_rewrite_stmt(s: Map, visible: [Map]) -> Map:
    kind = get(s, "kind")
    mut out = s
    if kind == "IfBlock":
        out = set(out, "then", defer_rewrite_block(get(s, "then"), visible))
        out = set(out, "else", defer_rewrite_else(get(s, "else"), visible))
    if kind == "Loop" or kind == "ForRange" or kind == "ForIn":
        out = set(out, "body", defer_rewrite_block(get(s, "body"), visible))
    if kind == "Match":
        arms = get_list(s, "arms")
        mut new_arms = slice(arms, 0, 0)
        loop ai in 0..<len(arms):
            arm = at(arms, ai)
            body = get_map(arm, "body")
            new_body = if get(body, "kind") == "Block" then defer_rewrite_block(body, visible) else body
            new_arms = push(new_arms, set(arm, "body", new_body))
        out = set(out, "arms", new_arms)
    out

# A fresh name per splice site, so nesting cannot shadow.
fn defer_tmp_name() -> Text:
    n = slot_int_or_zero(otir_k1("defret", "n"))
    slot_set(otir_k1("defret", "n"), n + 1)
    "__defer_v{n}"

fn defer_rewrite_block(block: Map, inherited: [Map]) -> Map:
    stmts = get_list(block, "stmts")
    n = len(stmts)
    mut mine = slice(stmts, 0, 0)
    mut out = slice(stmts, 0, 0)
    loop i in 0..<n:
        s = at(stmts, i)
        k = get(s, "kind")
        if k == "Defer":
            mine = push(mine, get_map(s, "expr"))
        else:
            visible = defer_concat(inherited, mine)
            is_last = i == n - 1
            # The RETURN VALUE is computed first, then the defers run, then the
            # saved value is returned. `defer close(f)` before `return read(f)`
            # must not close the handle the return expression is about to read —
            # splicing the defers ahead of the return did exactly that.
            if k == "Return" and len(visible) > 0:
                tmp = defer_tmp_name()
                out = push(out, {"kind": "LetOrAssign", "name": tmp, "value": get_map(s, "expr")})
                out = defer_append_reverse(out, visible)
                out = push(out, {"kind": "Return", "expr": {"kind": "Ident", "name": tmp}})
            else:
                # The last expression of a block IS its value, so the same
                # save-then-run applies at the block end: appending the defers
                # after it would make a deferred call the block's value.
                if k == "ExprStmt" and is_last and len(mine) > 0:
                    tmp2 = defer_tmp_name()
                    out = push(out, {"kind": "LetOrAssign", "name": tmp2, "value": get_map(s, "expr")})
                    out = defer_append_reverse(out, mine)
                    out = push(out, {"kind": "ExprStmt", "expr": {"kind": "Ident", "name": tmp2}})
                else:
                    out = push(out, defer_rewrite_stmt(s, visible))
    # Only if the value-preserving path above did not already do it: a block that
    # does not end in an expression just runs its defers last.
    tail_kind = if n > 0 then get(at(stmts, n - 1), "kind") else ""
    already = tail_kind == "ExprStmt" and len(mine) > 0
    defer_out = if already then out else defer_append_reverse(out, mine)
    set(block, "stmts", defer_out)

# True if any statement anywhere under this block is a `defer` (gate the pass so
# a defer-free program's AST comes through untouched).
fn defer_block_has(block: Map) -> bool:
    stmts = get_list(block, "stmts")
    mut found = false
    loop i in 0..<len(stmts):
        s = at(stmts, i)
        k = get(s, "kind")
        if k == "Defer":
            found = true
        if k == "IfBlock":
            if defer_block_has(get(s, "then")):
                found = true
            if get(get(s, "else"), "kind") == "Block":
                if defer_block_has(get_map(s, "else")):
                    found = true
        if k == "Loop" or k == "ForRange" or k == "ForIn":
            if defer_block_has(get(s, "body")):
                found = true
    found

# ---- name substitution over an AST subtree ---------------------------
# Replace every READ of a name with a given expression node, everywhere a name
# can be read (expressions, call args, list items, map pairs, match arms, loop
# headers, nested blocks). One user today: the `const` pass, which substitutes
# each constant's defining expression at its read sites and then drops the
# declarations.
#
# Substituted subtrees are ALIASED, not deep-copied: lowering treats the AST as
# read-only, and emitting the same subtree at N read sites is intended (a
# constant's expression is folded per use).
#
# (These were the `fact_rw_*` helpers, named after the reactive `fact` binding
# they were written for. That keyword is gone; the mechanism is not.)

fn subst_find(names: [Text], target: Text) -> int:
    mut found = 0 - 1
    n = len(names)
    loop i in 0..<n:
        if at(names, i) == target:
            found = i
    found

# Rewrite a list of expression nodes (call args, list items, ...).
fn subst_list(items: [Map], names: [Text], exprs: [Map]) -> [Map]:
    mut out = slice(items, 0, 0)
    n = len(items)
    loop i in 0..<n:
        out = push(out, subst_expr(at(items, i), names, exprs))
    out

# Rewrite the `value` field of each entry (MapLit pairs, StructCons fields).
fn subst_pairs(pairs: [Map], names: [Text], exprs: [Map]) -> [Map]:
    mut out = slice(pairs, 0, 0)
    n = len(pairs)
    loop i in 0..<n:
        p = at(pairs, i)
        out = push(out, set(p, "value", subst_expr(get(p, "value"), names, exprs)))
    out

# Rewrite the `body` expression of each match arm.
fn subst_arms(arms: [Map], names: [Text], exprs: [Map]) -> [Map]:
    mut out = slice(arms, 0, 0)
    n = len(arms)
    loop i in 0..<n:
        a = at(arms, i)
        out = push(out, set(a, "body", subst_expr(get(a, "body"), names, exprs)))
    out

# Rewrite one expression node: substitute fact idents, recurse into children.
fn subst_expr(node: Map, names: [Text], exprs: [Map]) -> Map:
    kind = get(node, "kind")
    mut out = node
    if kind == "Ident":
        idx = subst_find(names, get(node, "name"))
        if idx >= 0:
            out = at(exprs, idx)
    if kind == "Binary":
        out = set(out, "left", subst_expr(get(node, "left"), names, exprs))
        out = set(out, "right", subst_expr(get(node, "right"), names, exprs))
    if kind == "Unary":
        out = set(out, "operand", subst_expr(get(node, "operand"), names, exprs))
    if kind == "Call":
        out = set(out, "args", subst_list(get_list(node, "args"), names, exprs))
    if kind == "Perform":
        out = set(out, "args", subst_list(get_list(node, "args"), names, exprs))
    if kind == "MethodCall":
        out = set(out, "receiver", subst_expr(get(node, "receiver"), names, exprs))
        out = set(out, "args", subst_list(get_list(node, "args"), names, exprs))
    if kind == "Field":
        out = set(out, "object", subst_expr(get(node, "object"), names, exprs))
    if kind == "Index":
        out = set(out, "object", subst_expr(get(node, "object"), names, exprs))
        out = set(out, "index", subst_expr(get(node, "index"), names, exprs))
    if kind == "Question":
        out = set(out, "inner", subst_expr(get(node, "inner"), names, exprs))
    if kind == "If":
        out = set(out, "cond", subst_expr(get(node, "cond"), names, exprs))
        out = set(out, "then", subst_expr(get(node, "then"), names, exprs))
        out = set(out, "else", subst_expr(get(node, "else"), names, exprs))
    if kind == "ListLit":
        out = set(out, "items", subst_list(get_list(node, "items"), names, exprs))
    if kind == "Tuple":
        out = set(out, "items", subst_list(get_list(node, "items"), names, exprs))
    if kind == "NamedArg":
        out = set(out, "value", subst_expr(get(node, "value"), names, exprs))
    if kind == "MapLit":
        out = set(out, "pairs", subst_pairs(get_list(node, "pairs"), names, exprs))
    if kind == "StructCons":
        out = set(out, "fields", subst_pairs(get_list(node, "fields"), names, exprs))
    if kind == "Match":
        out = set(out, "scrutinee", subst_expr(get(node, "scrutinee"), names, exprs))
        out = set(out, "arms", subst_arms(get_list(node, "arms"), names, exprs))
    out

# An IfBlock's else is either a Block or a chained IfBlock (else-if ladder).
fn subst_else(node: Map, names: [Text], exprs: [Map]) -> Map:
    kind = get(node, "kind")
    mut out = node
    if kind == "Block":
        out = subst_block(node, names, exprs)
    if kind == "IfBlock":
        out = subst_stmt(node, names, exprs)
    out

# Rewrite one statement: fix up its expression fields + nested blocks.
fn subst_stmt(s: Map, names: [Text], exprs: [Map]) -> Map:
    kind = get(s, "kind")
    mut out = s
    if kind == "MutLet":
        out = set(out, "value", subst_expr(get(s, "value"), names, exprs))
    if kind == "LetOrAssign":
        out = set(out, "value", subst_expr(get(s, "value"), names, exprs))
    if kind == "ExprStmt":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind == "Return":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind == "Require":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind == "Ensure":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind == "Defer":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    # (A `Destroy` branch used to sit here. The parser emits no such statement —
    # `destroy` was an ECS word that never had syntax — so it was unreachable.
    # Found by diffing the kinds this file HANDLES against the kinds the parser
    # EMITS, which is the same check that found `defer` had gone missing.)
    if kind == "Loop":
        out = set(out, "body", subst_block(get(s, "body"), names, exprs))
    if kind == "ForRange":
        out = set(out, "low", subst_expr(get(s, "low"), names, exprs))
        out = set(out, "high", subst_expr(get(s, "high"), names, exprs))
        out = set(out, "body", subst_block(get(s, "body"), names, exprs))
    if kind == "ForIn":
        out = set(out, "iter", subst_expr(get(s, "iter"), names, exprs))
        out = set(out, "body", subst_block(get(s, "body"), names, exprs))
    if kind == "IfBlock":
        out = set(out, "cond", subst_expr(get(s, "cond"), names, exprs))
        out = set(out, "then", subst_block(get(s, "then"), names, exprs))
        out = set(out, "else", subst_else(get(s, "else"), names, exprs))
    if kind == "Match":
        out = set(out, "scrutinee", subst_expr(get(s, "scrutinee"), names, exprs))
        out = set(out, "arms", subst_arms(get(s, "arms"), names, exprs))
    out

# Rewrite every statement in a Block.
fn subst_block(block: Map, names: [Text], exprs: [Map]) -> Map:
    stmts = get_list(block, "stmts")
    n = len(stmts)
    mut out = slice(stmts, 0, 0)
    loop i in 0..<n:
        out = push(out, subst_stmt(at(stmts, i), names, exprs))
    set(block, "stmts", out)



# ---- nested lambda lift (lambda in a call-arg / expression position) -----
# The main lift handles `name = fn(...)` and bare/returned lambdas. This lifts
# a lambda that sits deeper — e.g. `apply(fn(n): n+1, x)` — into the same
# closure form. It's additive (own `__nlambda` prefix + slot counter, so it
# never collides with the main lift's `__lambda`), and only walks the node
# kinds a call-arg lambda actually reaches.

fn nlam_names_has(names: [Text], name: Text) -> bool:
    mut found = false
    loop i in 0..<len(names):
        if at(names, i) == name:
            found = true
    found


# Every Ident an EXPRESSION reads that `bound` does not already cover. This
# is the whole capture set for an expression-bodied lambda, and the
# per-statement half of the block walk below. A nested Lambda is NOT
# descended into — its own lift computes its captures.
fn nlam_expr_caps(node: Map, bound: [Text], caps: [Text]) -> [Text]:
    init_work = [node]
    mut worklist = init_work
    mut out = caps
    loop:
        w_n = len(worklist)
        if w_n == 0:
            break
        cur = at(worklist, w_n - 1)
        worklist = slice(worklist, 0, w_n - 1)
        ck = get(cur, "kind")
        if ck == "Ident":
            cn = get(cur, "name")
            if not nlam_names_has(bound, cn) and not nlam_names_has(out, cn):
                out = push(out, cn)
        if ck == "Binary":
            worklist = push(worklist, get(cur, "left"))
            worklist = push(worklist, get(cur, "right"))
        if ck == "Unary":
            worklist = push(worklist, get(cur, "operand"))
        if ck == "Call":
            call_args = get_list(cur, "args")
            loop cai in 0..<len(call_args):
                worklist = push(worklist, at(call_args, cai))
        if ck == "If":
            worklist = push(worklist, get(cur, "cond"))
            worklist = push(worklist, get(cur, "then"))
            worklist = push(worklist, get(cur, "else"))
        # Without these, a capture hiding behind a field access, an index, or
        # a method call reads as a free variable and the closure breaks.
        if ck == "Field":
            worklist = push(worklist, get(cur, "object"))
        if ck == "Index":
            worklist = push(worklist, get(cur, "object"))
            worklist = push(worklist, get(cur, "index"))
        if ck == "MethodCall":
            worklist = push(worklist, get(cur, "receiver"))
            mc_args = get_list(cur, "args")
            loop mci in 0..<len(mc_args):
                worklist = push(worklist, at(mc_args, mci))
        if ck == "ListLit" or ck == "Tuple":
            l_items = get_list(cur, "items")
            loop li in 0..<len(l_items):
                worklist = push(worklist, at(l_items, li))
        if ck == "MapLit":
            m_pairs = get_list(cur, "pairs")
            loop mpi in 0..<len(m_pairs):
                worklist = push(worklist, get(at(m_pairs, mpi), "value"))
        if ck == "StructCons":
            s_fields = get_list(cur, "fields")
            loop sfi in 0..<len(s_fields):
                worklist = push(worklist, get(at(s_fields, sfi), "value"))
        if ck == "Question":
            worklist = push(worklist, get(cur, "inner"))
        if ck == "Block":
            blk_r = nlam_block_caps(cur, bound, out)
            out = get_list(blk_r, "caps")
        if ck == "Match":
            worklist = push(worklist, get(cur, "scrutinee"))
            ms_arms = get_list(cur, "arms")
            loop mai in 0..<len(ms_arms):
                m_arm = at(ms_arms, mai)
                mut arm_bound = bound
                arm_binds = if has(m_arm, "bindings") then get_list(m_arm, "bindings") else []
                loop abi in 0..<len(arm_binds):
                    arm_bound = push(arm_bound, at(arm_binds, abi))
                out = nlam_expr_caps(get(m_arm, "body"), arm_bound, out)
    out


# A BLOCK body (what `loop parallel:` hands a lambda) walked IN ORDER: a name
# is a capture when it is read before the block binds it. `xs[i] = v`
# desugars to `xs = set(xs, i, v)`, so the read on the right makes `xs` a
# capture even though the statement also binds that name — which is exactly
# what lets a parallel body write into a shared list. A name the block binds
# first (`total = 0`) is a local, so it is not captured.
fn nlam_block_caps(block: Map, bound: [Text], caps: [Text]) -> Map:
    stmts = get_list(block, "stmts")
    mut b = bound
    mut c = caps
    loop si in 0..<len(stmts):
        st = at(stmts, si)
        sk = get(st, "kind")
        if sk == "MutLet" or sk == "LetOrAssign":
            c = nlam_expr_caps(get(st, "value"), b, c)
            b = push(b, get(st, "name"))
        if sk == "ExprStmt" or sk == "Return" or sk == "Require" or sk == "Ensure" or sk == "Defer":
            c = nlam_expr_caps(get(st, "expr"), b, c)
        if sk == "If" or sk == "Match":
            c = nlam_expr_caps(st, b, c)
        if sk == "IfBlock":
            c = nlam_expr_caps(get(st, "cond"), b, c)
            then_r = nlam_block_caps(get(st, "then"), b, c)
            c = get_list(then_r, "caps")
            els = get(st, "else")
            if get(els, "kind") == "Block":
                else_r = nlam_block_caps(els, b, c)
                c = get_list(else_r, "caps")
            if get(els, "kind") == "IfBlock":
                chain_r = nlam_block_caps({"kind": "Block", "stmts": push([], els)}, b, c)
                c = get_list(chain_r, "caps")
        if sk == "ForRange":
            c = nlam_expr_caps(get(st, "low"), b, c)
            c = nlam_expr_caps(get(st, "high"), b, c)
            fr_r = nlam_block_caps(get(st, "body"), push(b, get(st, "var")), c)
            c = get_list(fr_r, "caps")
        if sk == "ForIn":
            c = nlam_expr_caps(get(st, "iter"), b, c)
            mut in_bound = push(b, get(st, "var"))
            if has(st, "index_var"):
                in_bound = push(in_bound, get(st, "index_var"))
            fi_r = nlam_block_caps(get(st, "body"), in_bound, c)
            c = get_list(fi_r, "caps")
        if sk == "Loop":
            lp_r = nlam_block_caps(get(st, "body"), b, c)
            c = get_list(lp_r, "caps")
    {"bound": b, "caps": c}


fn nlam_capture_scan(lam_body: Map, lam_params: [Text]) -> [Text]:
    mut bound = slice([""], 0, 0)
    loop bp in 0..<len(lam_params):
        bound = push(bound, at(lam_params, bp))
    empty_caps = slice([""], 0, 0)
    mut caps = empty_caps
    if get(lam_body, "kind") == "Block":
        blk_r = nlam_block_caps(lam_body, bound, empty_caps)
        caps = get_list(blk_r, "caps")
    else:
        caps = nlam_expr_caps(lam_body, bound, empty_caps)
    caps


# Synthesize a __nlambda_N fn for `lam`; return {closure: MakeClosure, decl: Fn}.
fn nlam_synth(lam: Map) -> Map:
    lam_params = get_list(lam, "params")
    n_lp = len(lam_params)
    lam_body = get(lam, "body")
    caps = nlam_capture_scan(lam_body, lam_params)
    n_caps = len(caps)
    mut typed_params = slice([lam], 0, 0)
    typed_params = push(typed_params, {"name": "__env", "type": {"kind": "List", "elem": {"kind": "Named", "name": "int"}}})
    loop pi in 0..<n_lp:
        mut p_ty = {"kind": "Named", "name": "int"}
        if has(lam, "param_types"):
            p_ty = at(get_list(lam, "param_types"), pi)
        typed_params = push(typed_params, {"name": at(lam_params, pi), "type": p_ty})
    ctr = slot_get_int("otir:nlam_ctr")
    slot_set("otir:nlam_ctr", ctr + 1)
    synth_name = "__nlambda_{ctr}"
    mut synth_stmts = slice([lam_body], 0, 0)
    loop ci in 0..<n_caps:
        cap_slot = 2 + ci
        at_call = {"kind": "Call", "callee": "at", "args": [{"kind": "Ident", "name": "__env"}, {"kind": "Int", "value": "{cap_slot}"}]}
        synth_stmts = push(synth_stmts, {"kind": "LetOrAssign", "name": at(caps, ci), "value": at_call})
    synth_stmts = push(synth_stmts, {"kind": "ExprStmt", "expr": lam_body})
    synth_body = {"kind": "Block", "stmts": synth_stmts}
    # The hoisted function inherits the LAMBDA's position: a return-type
    # complaint about `__nlambda_3` is unreadable without it, and printed
    # `at line 0:0`.
    synth_decl = {"kind": "Fn", "name": synth_name, "params": typed_params, "ret": {"kind": "Named", "name": "int"}, "body": synth_body, "line": if has(lam, "line") then get_int(lam, "line") else 0, "col": if has(lam, "col") then get_int(lam, "col") else 0}
    mut cap_nodes = slice([lam], 0, 0)
    loop cj in 0..<n_caps:
        # The capture reference at the CLOSURE-CONSTRUCTION site. Without a
        # position, an error about a free variable inside a lambda (an
        # undefined name, say) reported `line 0:0` — the lambda's own position
        # is the honest answer.
        cap_nodes = push(cap_nodes, {"kind": "Ident", "name": at(caps, cj), "line": if has(lam, "line") then get_int(lam, "line") else 0, "col": if has(lam, "col") then get_int(lam, "col") else 0})
    closure = {"kind": "MakeClosure", "fn": synth_name, "caps": cap_nodes, "is_lambda": 1}
    {"closure": closure, "decl": synth_decl}

# Lift lambdas inside an expression; return {node: rewritten, synths: [Fn]}.
fn nlam_lift(node: Map) -> Map:
    kind = get(node, "kind")
    mut synths = slice([node], 0, 0)
    if kind == "Lambda":
        s = nlam_synth(node)
        synths = push(synths, get(s, "decl"))
        return {"node": get(s, "closure"), "synths": synths}
    mut out = node
    if kind == "Call":
        args = get_list(node, "args")
        mut new_args = slice(args, 0, 0)
        loop i in 0..<len(args):
            ar = nlam_lift(at(args, i))
            new_args = push(new_args, get(ar, "node"))
            ars = get_list(ar, "synths")
            loop j in 0..<len(ars):
                synths = push(synths, at(ars, j))
        out = set(out, "args", new_args)
    if kind == "Binary":
        lr = nlam_lift(get(node, "left"))
        rr = nlam_lift(get(node, "right"))
        out = set(out, "left", get(lr, "node"))
        out = set(out, "right", get(rr, "node"))
        loop j in 0..<len(get_list(lr, "synths")):
            synths = push(synths, at(get_list(lr, "synths"), j))
        loop j in 0..<len(get_list(rr, "synths")):
            synths = push(synths, at(get_list(rr, "synths"), j))
    {"node": out, "synths": synths}

# Lift lambdas in a statement's expression field. Returns {stmt, synths}.
fn nlam_lift_stmt(stmt: Map) -> Map:
    kind = get(stmt, "kind")
    mut out = stmt
    mut synths = slice([stmt], 0, 0)
    mut fld = ""
    if kind == "MutLet" or kind == "LetOrAssign":
        fld = "value"
    if kind == "ExprStmt" or kind == "Return" or kind == "Require" or kind == "Ensure" or kind == "Defer":
        fld = "expr"
    if fld != "":
        r = nlam_lift(get(stmt, fld))
        out = set(out, fld, get(r, "node"))
        synths = get_list(r, "synths")
    # Recurse into nested block bodies so a lambda inside a for/loop/if body
    # (e.g. `for i in ...: g = fn(n): n + i`) is lifted too.
    if kind == "Loop" or kind == "ForRange" or kind == "ForIn":
        br = nlam_lift_block(get(stmt, "body"))
        out = set(out, "body", get(br, "block"))
        synths = get_list(br, "synths")
    if kind == "IfBlock":
        tr = nlam_lift_block(get(stmt, "then"))
        out = set(out, "then", get(tr, "block"))
        mut ifsyn = get_list(tr, "synths")
        els = get(stmt, "else")
        if get(els, "kind") == "Block":
            er = nlam_lift_block(els)
            out = set(out, "else", get(er, "block"))
            ersyn = get_list(er, "synths")
            loop ej in 0..<len(ersyn):
                ifsyn = push(ifsyn, at(ersyn, ej))
        if get(els, "kind") == "IfBlock":
            er2 = nlam_lift_stmt(els)
            out = set(out, "else", get(er2, "stmt"))
            ersyn2 = get_list(er2, "synths")
            loop ej2 in 0..<len(ersyn2):
                ifsyn = push(ifsyn, at(ersyn2, ej2))
        synths = ifsyn
    {"stmt": out, "synths": synths}

# Lift lambdas in every statement of a block. Returns {block, synths}.
fn nlam_lift_block(block: Map) -> Map:
    stmts = get_list(block, "stmts")
    mut out_stmts = slice(stmts, 0, 0)
    mut synths = slice([block], 0, 0)
    loop i in 0..<len(stmts):
        r = nlam_lift_stmt(at(stmts, i))
        out_stmts = push(out_stmts, get(r, "stmt"))
        rs = get_list(r, "synths")
        loop j in 0..<len(rs):
            synths = push(synths, at(rs, j))
    {"block": set(block, "stmts", out_stmts), "synths": synths}

# Does this expression contain a lambda (nested in a call arg / operand)?
fn nlam_has(node: Map) -> bool:
    kind = get(node, "kind")
    mut found = false
    if kind == "Lambda":
        found = true
    if kind == "Call":
        args = get_list(node, "args")
        loop i in 0..<len(args):
            if nlam_has(at(args, i)):
                found = true
    if kind == "Binary":
        if nlam_has(get(node, "left")):
            found = true
        if nlam_has(get(node, "right")):
            found = true
    found

# Does a statement (or a nested block it holds) contain a lambda?
fn nlam_stmt_has(stmt: Map) -> bool:
    kind = get(stmt, "kind")
    mut found = false
    if kind == "MutLet" or kind == "LetOrAssign":
        found = nlam_has(get(stmt, "value"))
    if kind == "ExprStmt" or kind == "Return" or kind == "Require" or kind == "Ensure" or kind == "Defer":
        found = nlam_has(get(stmt, "expr"))
    if kind == "Loop" or kind == "ForRange" or kind == "ForIn":
        if nlam_block_has(get(stmt, "body")):
            found = true
    if kind == "IfBlock":
        if nlam_block_has(get(stmt, "then")):
            found = true
        els = get(stmt, "else")
        if get(els, "kind") == "Block":
            if nlam_block_has(els):
                found = true
        if get(els, "kind") == "IfBlock":
            if nlam_stmt_has(els):
                found = true
    found

fn nlam_block_has(block: Map) -> bool:
    stmts = get_list(block, "stmts")
    mut found = false
    loop i in 0..<len(stmts):
        if nlam_stmt_has(at(stmts, i)):
            found = true
    found


pub fn ast_program_to_ir(program: Map) -> IRModule:
    # New EPOCH for the private-name registry. A host can compile many programs
    # in one process (the test runner does 118 in a row), and compiler slots
    # outlive a single compile - so without this, one program's private `double`
    # would still be registered when the next program used `double` as a local
    # closure binding, and the call would resolve to a symbol from a file that
    # is no longer being compiled.
    slot_set("otir:ep", slot_int_or_zero("otir:ep") + 1)

    # ---- Pass -2: the import graph + every orb's exports ----
    # Recorded BEFORE anything resolves a name, because resolution asks two
    # questions a single ordered walk cannot answer: "who exports this?" (any
    # orb, including ones parsed later) and "did I import them?".
    pre_decls = get_list(program, "decls")
    pre_n = len(pre_decls)
    mut orb_pre = ""
    loop pi in 0..<pre_n:
        pd = at(pre_decls, pi)
        pk = get(pd, "kind")
        if pk == "OrbMark":
            orb_pre = get(pd, "name")
        # `type Name = T` — pre-resolve the target to its IR type string and
        # stash it. A later `x: Name` looks this up in ast_type_to_ir_with_scope.
        if pk == "TypeAlias":
            slot_set(otir_k1("tyalias", get(pd, "name")), ast_type_to_ir(get(pd, "target")))
        if pk == "UseDecl":
            target = get(pd, "name")
            slot_set(otir_k2("uses", orb_pre, target), 1)
            # Indexed too, so re-export chains can be walked (otir_reex_reaches).
            u_n = slot_int_or_zero(otir_k1("usen", orb_pre))
            slot_set(otir_k1("useo", orb_pre) + ":{u_n}", target)
            slot_set(otir_k1("usen", orb_pre), u_n + 1)
            if (if has(pd, "reexport") then get_int(pd, "reexport") else 0) == 1:
                slot_set(otir_k2("reex", orb_pre, target), 1)
            only_list = get_list(pd, "only")
            if len(only_list) > 0:
                # A list is a LIMIT, not a hint: from this orb you see these
                # names and nothing else.
                slot_set(otir_k2("onlyn", orb_pre, target), 1)
            loop oi in 0..<len(only_list):
                slot_set(otir_k3("only", orb_pre, target, at(only_list, oi)), 1)
        if pk == "Fn":
            if (if has(pd, "pub") then get_int(pd, "pub") else 1) == 1:
                ex_name = get(pd, "name")
                if ex_name != "main":
                    slot_set(otir_k2("pub", orb_pre, ex_name), otir_mangle(orb_pre, ex_name, 1))
                    seen_n = slot_int_or_zero(otir_k1("defn", ex_name))
                    slot_set(otir_k1("defo", ex_name) + ":{seen_n}", orb_pre)
                    slot_set(otir_k1("defn", ex_name), seen_n + 1)

    # Duplicate-function guard. Two `fn name` definitions collide into one
    # LLVM symbol — most often the same helper defined in two `use`d orbs,
    # since function names are global (no orb namespaces yet). Flag it with a
    # clear message instead of a confusing "unknown function" or a link-time
    # duplicate-symbol error. Externs are declarations, not definitions, so
    # re-declaring them across orbs stays legal and is not checked here.
    dup_decls = get_list(program, "decls")
    dup_n = len(dup_decls)
    mut seen_fn_names = slice([""], 0, 0)
    mut orb_dup = ""
    loop ddi in 0..<dup_n:
        dd = at(dup_decls, ddi)
        ddk = get(dd, "kind")
        if ddk == "OrbMark":
            orb_dup = get(dd, "name")
        # (`trait` / `impl` / `system` used to be rejected here, keyed on decl
        # kinds `Trait`/`Impl`/`System`. The parser stopped emitting those kinds,
        # so the check went dead and the promised "not supported yet" error
        # silently became "function `prog__(` has an empty body". They are now
        # caught in the parser as an `Unsupported` decl, WITH a source location.)
        if ddk == "Fn":
            # Compared under the EMITTED name: two orbs may each keep a private
            # helper of the same name (they no longer share a symbol), so only a
            # genuine `pub` clash is a duplicate.
            dnm_raw = get(dd, "name")
            dnm = otir_mangle(orb_dup, dnm_raw, if has(dd, "pub") then get_int(dd, "pub") else 1)
            mut dup_already = false
            loop dsj in 0..<len(seen_fn_names):
                if at(seen_fn_names, dsj) == dnm:
                    dup_already = true
            if dup_already:
                dd_line = if has(dd, "line") then get_int(dd, "line") else 0
                dd_col = if has(dd, "col") then get_int(dd, "col") else 0
                compile_error("orion: ERROR at {otir_where(dd_line, dd_col)} — function `{dnm_raw}` is defined more than once in the same orb (two different orbs may each have one)")
            seen_fn_names = push(seen_fn_names, dnm)

    # Pass -1.7: `const NAME = expr` inlining. Collect const name->value, then
    # substitute reads across every fn/system body (reusing the fact rewriter),
    # and drop the const decls (they need no runtime storage). Runs BEFORE the
    # fact pass so a fact RHS that reads a const sees the value. A const may not
    # reference another const (the substitution is single-pass). Const-free
    # programs are untouched.
    cn_src = get_list(program, "decls")
    cn_total = len(cn_src)
    const_names = slice([""], 0, 0)
    mut const_name_list = const_names
    const_exprs = slice([{"kind": "Int", "value": "0"}], 0, 0)
    mut const_expr_list = const_exprs
    loop cni in 0..<cn_total:
        cnd = at(cn_src, cni)
        if get(cnd, "kind") == "Const":
            const_name_list = push(const_name_list, get(cnd, "name"))
            const_expr_list = push(const_expr_list, get(cnd, "value"))
    mut program_const = program
    if len(const_name_list) > 0:
        mut cn_out = slice(cn_src, 0, 0)
        loop cnj in 0..<cn_total:
            mut cnd2 = at(cn_src, cnj)
            cnk = get(cnd2, "kind")
            if cnk != "Const":
                # (`or cnk == "System"` used to be here. The parser emits no
                # System decl — the keyword is gone — so the test could only
                # ever answer false.)
                if cnk == "Fn":
                    cnd2 = set(cnd2, "body", subst_block(get(cnd2, "body"), const_name_list, const_expr_list))
                cn_out = push(cn_out, cnd2)
        program_const = set(program, "decls", cn_out)

    # (Pass -1 was `fact` inlining: reads of a reactive `fact` binding replaced
    # by its defining expression. The `fact` keyword is gone from the parser, so
    # no AST can contain a Fact statement and the pass could never rewrite
    # anything — it only walked every function body on every compile to decide
    # that. Removed; the substitution machinery it shared with the const pass
    # lives on as `subst_*`.)

    # Pass -1: `defer`. Splice each block's deferred expressions in before every
    # `return` that leaves it (LIFO) and at its end, then drop the Defer
    # statements. Gated by a prescan, so a program without `defer` is untouched.
    mut defer_decls = get_list(program_const, "decls")
    mut any_defer = false
    loop dfi in 0..<len(defer_decls):
        dfd = at(defer_decls, dfi)
        if get(dfd, "kind") == "Fn":
            if defer_block_has(get(dfd, "body")):
                any_defer = true
    if any_defer:
        mut df_out = slice(defer_decls, 0, 0)
        loop dfj in 0..<len(defer_decls):
            mut dfd2 = at(defer_decls, dfj)
            if get(dfd2, "kind") == "Fn":
                no_defers = slice([{}], 0, 0)
                dfd2 = set(dfd2, "body", defer_rewrite_block(get_map(dfd2, "body"), no_defers))
            df_out = push(df_out, dfd2)
        defer_decls = df_out
    program_const = set(program_const, "decls", defer_decls)

    # Pass 0: lambda lift. For each `name = |params| body` LetOrAssign at
    # top of a fn body, hoist as synthesized __lambda_N global fn. We
    # pre-scan for any Lambda — if none, take the early-return path that
    # leaves decls unmodified (avoids if/else type-mismatch on empty-list
    # initialization, which broke the bundle build before).
    raw_decls = get_list(program_const, "decls")
    raw_total = len(raw_decls)
    mut has_any_lambda = false
    loop sc_idx in 0..<raw_total:
        sc_decl = at(raw_decls, sc_idx)
        if get(sc_decl, "kind") == "Fn":
            sc_body = get(sc_decl, "body")
            if get(sc_body, "kind") == "Block":
                sc_stmts = get_list(sc_body, "stmts")
                sc_n = len(sc_stmts)
                loop sc_s in 0..<sc_n:
                    sc_stmt = at(sc_stmts, sc_s)
                    sc_kind = get(sc_stmt, "kind")
                    if sc_kind == "LetOrAssign" or sc_kind == "MutLet":
                        if get(get(sc_stmt, "value"), "kind") == "Lambda":
                            has_any_lambda = true
                    if sc_kind == "ExprStmt" or sc_kind == "Return":
                        if get(get(sc_stmt, "expr"), "kind") == "Lambda":
                            has_any_lambda = true
                    if nlam_stmt_has(sc_stmt):
                        has_any_lambda = true
    # Pre-scan to find Lambda bindings + their captures. Used by the next
    # phase to emit a clean error if any captures exist (real env-struct
    # closures need more wiring than this minimal lift can offer today).
    # This is best-effort: shallow walk of lambda body looking for idents.
    mut captures_warned = false
    loop cs_idx in 0..<raw_total:
        cs_decl = at(raw_decls, cs_idx)
        if get(cs_decl, "kind") == "Fn":
            cs_body = get(cs_decl, "body")
            if get(cs_body, "kind") == "Block":
                cs_stmts = get_list(cs_body, "stmts")
                cs_n = len(cs_stmts)
                loop cs_s in 0..<cs_n:
                    cs_stmt = at(cs_stmts, cs_s)
                    cs_kind = get(cs_stmt, "kind")
                    if cs_kind == "LetOrAssign" or cs_kind == "MutLet":
                        cs_val = get(cs_stmt, "value")
                        if get(cs_val, "kind") == "Lambda":
                            cs_lp = get_list(cs_val, "params")
                            cs_body_expr = get(cs_val, "body")
                            # Shallow capture scan: if body is Binary, check operand idents.
                            cs_body_kind = get(cs_body_expr, "kind")
                            if cs_body_kind == "Binary":
                                cs_left = get(cs_body_expr, "left")
                                cs_right = get(cs_body_expr, "right")
                                if get(cs_left, "kind") == "Ident":
                                    cs_l_name = get(cs_left, "name")
                                    mut found_in_params = false
                                    nlp_x = len(cs_lp)
                                    loop ix in 0..<nlp_x:
                                        if at(cs_lp, ix) == cs_l_name:
                                            found_in_params = true
                                    if not found_in_params and not captures_warned:
                                        print_line("orion: WARNING — lambda likely captures `{cs_l_name}` (env-struct closures not yet supported; capture acts as free var)")
                                        captures_warned = true
    mut decls = raw_decls
    if has_any_lambda:
        # Tree walk + rewrite. Use seed Maps to avoid empty-list type drift.
        seed = at(raw_decls, 0)
        init_decls = [seed]
        mut working_decls = init_decls
        working_decls = bytes_slice(working_decls, 0, 0)
        mut lambda_counter = 0
        init_synth = [seed]
        mut synth_decls = init_synth
        synth_decls = bytes_slice(synth_decls, 0, 0)
        # Stmts seed — we need a typed empty list of stmts. Use the seed
        # decl's body stmts if it's a Block fn; otherwise we still need
        # some Stmt-typed list. Synthesize using a dummy.
        # Lifted lambdas are appended AFTER every orb's decls, so they cannot
        # inherit their orb from decl order like the other passes do. Stamp the
        # origin on them (and on rewritten parents, whose rebuild would drop it)
        # so a lambda inside an orb still resolves that orb's private helpers.
        mut orb_lam = ""
        loop d_idx in 0..<raw_total:
            decl = at(raw_decls, d_idx)
            if get(decl, "kind") == "OrbMark":
                orb_lam = get(decl, "name")
            if get(decl, "kind") == "Fn":
                fn_body = get(decl, "body")
                body_kind = get(fn_body, "kind")
                if body_kind == "Block":
                    old_stmts = get_list(fn_body, "stmts")
                    n_stmts = len(old_stmts)
                    init_stmts = old_stmts
                    mut new_stmts = init_stmts
                    new_stmts = slice(new_stmts, 0, 0)
                    mut binding_names = slice([""], 0, 0)
                    mut binding_caps = slice([""], 0, 0)
                    loop s_idx in 0..<n_stmts:
                        stmt = at(old_stmts, s_idx)
                        stmt_kind = get(stmt, "kind")
                        mut is_let_lambda = false
                        if stmt_kind == "LetOrAssign" or stmt_kind == "MutLet":
                            if get(get(stmt, "value"), "kind") == "Lambda":
                                is_let_lambda = true
                        # A bare/returned lambda — the last expr of a fn body or
                        # an explicit `return fn(...)` — lifts the same way; we
                        # place the resulting closure back in expr position.
                        mut is_expr_lambda = false
                        if stmt_kind == "ExprStmt" or stmt_kind == "Return":
                            if get(get(stmt, "expr"), "kind") == "Lambda":
                                is_expr_lambda = true
                        is_lambda_stmt = is_let_lambda or is_expr_lambda
                        if is_lambda_stmt:
                            lam = if is_let_lambda then get(stmt, "value") else get(stmt, "expr")
                            # Position for the capture references built below.
                            lam_line = if has(lam, "line") then get_int(lam, "line") else 0
                            lam_col = if has(lam, "col") then get_int(lam, "col") else 0
                            lam_params = get_list(lam, "params")
                            n_lp = len(lam_params)
                            lam_body = get(lam, "body")
                            # Worklist-based capture scan: visit expressions
                            # iteratively, recurse into Binary/Call/Unary/If.
                            # Ident nodes not in lam_params become captures.
                            init_work = [lam_body]
                            mut worklist = init_work
                            mut caps = slice([""], 0, 0)
                            mut seen_caps = slice([""], 0, 0)
                            loop:
                                w_n = len(worklist)
                                if w_n == 0:
                                    break
                                cur = at(worklist, w_n - 1)
                                worklist = slice(worklist, 0, w_n - 1)
                                ck = get(cur, "kind")
                                if ck == "Ident":
                                    cn = get(cur, "name")
                                    mut is_param = false
                                    loop lp_w in 0..<n_lp:
                                        if at(lam_params, lp_w) == cn:
                                            is_param = true
                                    mut already = false
                                    n_seen = len(seen_caps)
                                    loop sc in 0..<n_seen:
                                        if at(seen_caps, sc) == cn:
                                            already = true
                                    # Skip global fn names (heuristic: don't
                                    # capture identifiers that look like
                                    # known fn names — they're not values).
                                    # For MVP, accept all non-param idents.
                                    if not is_param and not already:
                                        caps = push(caps, cn)
                                        seen_caps = push(seen_caps, cn)
                                if ck == "Binary":
                                    worklist = push(worklist, get(cur, "left"))
                                    worklist = push(worklist, get(cur, "right"))
                                if ck == "Unary":
                                    worklist = push(worklist, get(cur, "operand"))
                                if ck == "Call":
                                    call_args = get_list(cur, "args")
                                    n_ca = len(call_args)
                                    loop cai in 0..<n_ca:
                                        worklist = push(worklist, at(call_args, cai))
                                if ck == "If":
                                    worklist = push(worklist, get(cur, "cond"))
                                    worklist = push(worklist, get(cur, "then"))
                                    worklist = push(worklist, get(cur, "else"))
                            n_caps = len(caps)
                            # __lambda_N(__env, params): the captures live in the
                            # closure list __env; a prologue binds each by name so
                            # the body is unchanged. env is the leading param.
                            init_typed = get_list(decl, "params")
                            mut typed_params = init_typed
                            typed_params = slice(typed_params, 0, 0)
                            typed_params = push(typed_params, {"name": "__env", "type": {"kind": "List", "elem": {"kind": "Named", "name": "int"}}})
                            loop pi in 0..<n_lp:
                                p_name = at(lam_params, pi)
                                mut p_ty = {"kind": "Named", "name": "int"}
                                if has(lam, "param_types"):
                                    p_ty = at(get_list(lam, "param_types"), pi)
                                typed_params = push(typed_params, {"name": p_name, "type": p_ty})
                            synth_name = "__lambda_{lambda_counter}"
                            lambda_counter = lambda_counter + 1
                            # Prologue: cap_i = at(__env, 2 + i)  (slots 0/1 are
                            # the fn-ptr and the is_lambda flag).
                            mut synth_stmts = slice([lam_body], 0, 0)
                            loop ci in 0..<n_caps:
                                cap_name = at(caps, ci)
                                cap_slot = 2 + ci
                                at_call = {"kind": "Call", "callee": "at", "args": [{"kind": "Ident", "name": "__env"}, {"kind": "Int", "value": "{cap_slot}"}]}
                                synth_stmts = push(synth_stmts, {"kind": "LetOrAssign", "name": cap_name, "value": at_call})
                            synth_stmts = push(synth_stmts, {"kind": "ExprStmt", "expr": lam_body})
                            synth_body = {"kind": "Block", "stmts": synth_stmts}
                            synth_decl = {"kind": "Fn", "name": synth_name, "params": typed_params, "ret": {"kind": "Named", "name": "int"}, "body": synth_body, "orb": orb_lam, "line": lam_line, "col": lam_col}
                            synth_decls = push(synth_decls, synth_decl)
                            bind_name = get(stmt, "name")
                            binding_names = push(binding_names, bind_name)
                            # The binding value builds the closure: [ptr, 1, caps].
                            mut cap_nodes = slice([lam_body], 0, 0)
                            loop cj in 0..<n_caps:
                                # The capture reference at the CLOSURE-CONSTRUCTION
                                # site. Without a position, an error about a free
                                # variable inside a lambda reported `line 0:0`.
                                cap_nodes = push(cap_nodes, {"kind": "Ident", "name": at(caps, cj), "line": lam_line, "col": lam_col})
                            new_value = {"kind": "MakeClosure", "fn": synth_name, "caps": cap_nodes, "is_lambda": 1}
                            if is_let_lambda:
                                new_stmts = push(new_stmts, {"kind": stmt_kind, "name": bind_name, "value": new_value})
                            if is_expr_lambda:
                                new_stmts = push(new_stmts, {"kind": stmt_kind, "expr": new_value})
                        if not is_lambda_stmt:
                            # Non-lambda statement: lift any lambda nested in its
                            # expression (e.g. `apply(fn(n): n+1, x)`) into a
                            # closure + synth decls, then pass it through. Calls
                            # to a closure binding resolve to closure_call at
                            # lowering, so no cap rewrite / escape restriction.
                            nl = nlam_lift_stmt(stmt)
                            new_stmts = push(new_stmts, get(nl, "stmt"))
                            nl_synths = get_list(nl, "synths")
                            loop nsi in 0..<len(nl_synths):
                                synth_decls = push(synth_decls, set(at(nl_synths, nsi), "orb", orb_lam))
                    new_body = {"kind": "Block", "stmts": new_stmts}
                    # SET the changed fields on the ORIGINAL decl. Rebuilding it
                    # from a literal listed six fields and silently dropped every
                    # other one — `generics`, `generics_csv`, `modifier`,
                    # positions. This pass touches every function with a block
                    # body whenever the program contains ANY lambda, so a single
                    # closure anywhere erased the generic signatures for the
                    # WHOLE program and call-site instantiation quietly stopped
                    # working (`at(filter(words, p), 0)` went back to being an
                    # int). A rebuild that enumerates fields is a list that goes
                    # stale the next time one is added.
                    mut rewritten_decl = set(decl, "body", new_body)
                    rewritten_decl = set(rewritten_decl, "pub", if has(decl, "pub") then get_int(decl, "pub") else 1)
                    rewritten_decl = set(rewritten_decl, "orb", orb_lam)
                    working_decls = push(working_decls, rewritten_decl)
                if body_kind != "Block":
                    working_decls = push(working_decls, decl)
            if get(decl, "kind") != "Fn":
                working_decls = push(working_decls, decl)
        n_synth = len(synth_decls)
        loop sy_i in 0..<n_synth:
            working_decls = push(working_decls, at(synth_decls, sy_i))
        decls = working_decls
    total = len(decls)
    # Pass 1a: collect Data decls and Enum decls first. Pass 1b uses them so
    # fn ret types like `-> Inst` correctly become "struct:Inst" not "i64",
    # and `EnumName.Variant` expressions resolve to variant indices.
    mut sig_scope = scope_empty()
    loop index in 0..<total:
        decl = at(decls, index)
        if get(decl, "kind") == "Data":
            struct_name = get(decl, "name")
            # Bind generic type vars so `T` in a field type lowers to i64.
            otir_bind_tyvars(decl)
            data_fields = get_list(decl, "fields")
            n_df = len(data_fields)
            mut spec = ""
            loop fi in 0..<n_df:
                fld = at(data_fields, fi)
                fld_name = get(fld, "name")
                fld_type = ast_type_to_ir(get(fld, "type"))
                sep = if fi == 0 then "" else "|"
                spec = "{spec}{sep}{fld_name}:{fld_type}"
            # Two `data` decls of the same NAME but a different layout are a
            # SILENT miscompile today: a type name is not a linker symbol, just a
            # compile-time layout key, and the lookup takes the first match - so
            # the second orb's field access reads the first orb's offsets. (One
            # such pair exists latent in the tree: `Param` in astra_ast vs
            # orion_ir, never co-built, but nothing stops it.) Functions were
            # namespaced per orb; the type-string machinery is too wide to
            # follow suit for one theoretical clash, so the safety win is to turn
            # the silent miscompile into a clear error. An IDENTICAL redeclaration
            # is harmless and stays legal (a copy-pasted shared shape).
            dkey = otir_k1("dspec", struct_name)
            if slot_has(dkey) and slot_get(dkey) != spec:
                compile_error("orion: ERROR — data type `{struct_name}` is defined with two different layouts in this build (a type name is a global layout key, not per-orb — rename one)")
            slot_set(dkey, spec)
            sig_scope = scope_add_data_decl(sig_scope, struct_name, spec)
        if get(decl, "kind") == "Enum":
            enum_name = get(decl, "name")
            # Bind generic type vars so `T` in a variant payload lowers to i64.
            otir_bind_tyvars(decl)
            variants = get_list(decl, "variants")
            n_vars = len(variants)
            mut csv = ""
            mut max_payloads = 0
            loop vi in 0..<n_vars:
                v = at(variants, vi)
                v_name = get(v, "name")
                sep = if vi == 0 then "" else ","
                csv = "{csv}{sep}{v_name}"
                # Per-variant payload TYPE spec, stored as a synthetic
                # "Enum$Variant" entry in the enum tables (comma csv of
                # IR types). Match-arm bindings retype loads with these.
                v_payloads = get_list(v, "payload")
                n_pl = len(v_payloads)
                if n_pl > max_payloads:
                    max_payloads = n_pl
                mut pl_csv = ""
                loop pli in 0..<n_pl:
                    pl_sep = if pli == 0 then "" else ","
                    pl_type = ast_type_to_ir(at(v_payloads, pli))
                    pl_csv = "{pl_csv}{pl_sep}{pl_type}"
                sig_scope = scope_add_enum_decl(sig_scope, "{enum_name}${v_name}", pl_csv)
            sig_scope = scope_add_enum_decl(sig_scope, enum_name, csv)
            # Sum types with payloads — synthesize a uniform tagged-union
            # struct: tag (variant index) + positional i64 payload slots
            # p0..pN (ptr payloads live in i64 slots via ptrtoint; match
            # bindings retype per the variant's payload spec). Minimum 2
            # slots so the `?`-operator's index-1 access always exists.
            if max_payloads < 2:
                max_payloads = 2
            mut union_spec = "tag:int"
            loop si in 0..<max_payloads:
                union_spec = "{union_spec}|p{si}:int"
            sig_scope = scope_add_data_decl(sig_scope, enum_name, union_spec)
    # Pass 1b: collect fn signatures, now with struct-aware ret types.
    # ExternFn decls register too — their calls type like any fn call
    # (no more "unknown function, i64 as guess" for declared externs).
    # Duplicate fn BODIES are a hard error — orbs share one flat
    # namespace, and a silent double-emit means whichever definition
    # links last wins (bit us twice: toml/veil line_at, others).
    # Extern re-declares stay legal; that's the cross-orb convention.
    mut fn_seen = []
    mut orb_1b = ""
    loop index in 0..<total:
        decl = at(decls, index)
        decl_kind_1b = get(decl, "kind")
        if decl_kind_1b == "OrbMark":
            orb_1b = get(decl, "name")
        if decl_kind_1b == "Fn":
            # A stamped origin wins over decl order: lifted lambdas sit at the
            # end of the list but belong to the orb they were written in.
            orb_of = if has(decl, "orb") then get(decl, "orb") else orb_1b
            fn_raw = get(decl, "name")
            # Compiler-synthesized decls (lambdas) carry no `pub` key; they are
            # already uniquely named, so default them to global = today's shape.
            fn_pub = if has(decl, "pub") then get_int(decl, "pub") else 1
            fn_name = otir_mangle(orb_of, fn_raw, fn_pub)
            # How a call inside THIS orb finds it (step 1 of otir_resolve).
            slot_set(otir_priv_key(orb_of, fn_raw), fn_name)
            # `comptime`/`deterministic` modifiers, recorded by the parser
            # instead of dropped. `comptime` (compile-time evaluation) is not
            # implemented, so reject it rather than let it silently do nothing.
            # `deterministic` is a real guarantee - record the emitted name so
            # the effect pass can enforce it after the whole module is built.
            fn_mod = if has(decl, "modifier") then get(decl, "modifier") else ""
            if fn_mod == "comptime":
                ct_line = if has(decl, "mod_line") then get_int(decl, "mod_line") else 0
                ct_col = if has(decl, "mod_col") then get_int(decl, "mod_col") else 0
                compile_error("orion: ERROR at {otir_where(ct_line, ct_col)} — `comptime` was cut; it never evaluated anything at compile time. A folded constant is `const NAME = expr` (or a bare top-level `NAME = expr`)")
            if fn_mod == "deterministic":
                dn = slot_int_or_zero(otir_k1("detn", "count"))
                slot_set(otir_k1("deto", "{dn}"), fn_name)
                slot_set(otir_k1("detn", "count"), dn + 1)
            if text_list_has(fn_seen, fn_name):
                dcl_line = if has(decl, "line") then get_int(decl, "line") else 0
                dcl_col = if has(decl, "col") then get_int(decl, "col") else 0
                compile_error("orion: ERROR at {otir_where(dcl_line, dcl_col)} — duplicate function `{fn_raw}` (defined twice in the same orb — two orbs may now each have their own)")
            fn_seen = push_mut(fn_seen, fn_name)
            ret_type = ast_type_to_ir_with_scope(get(decl, "ret"), sig_scope)
            sig_scope = scope_add_fn_sig(sig_scope, fn_name, ret_type)
            # Arity registry (compiler slots): a call with the wrong
            # argument count silently shifts every parameter — caught
            # here instead of as a runtime pointer crash.
            slot_set("otir:arity:" + fn_name, len(get_list(decl, "params")))
            # Parameter-position registry: `otir:param:<fn>:<name>` -> index,
            # so a named argument `f(x = 5)` can be reordered to its slot.
            fn_params_list = get_list(decl, "params")
            loop fp_i in 0..<len(fn_params_list):
                fp = at(fn_params_list, fp_i)
                slot_set("otir:param:" + fn_name + ":" + get(fp, "name"), fp_i)
                # Parameter-TYPE registry: `otir:paramtype:<fn>:<index>` -> the
                # param's IR type. Lets a call site diff each arg's reliable
                # concrete pointer shape against the declared param type (the
                # call-arg subtype guard). Untyped params default to `int` (the
                # engine's convention), which is a wildcard for the ptr guard.
                fp_ty = if has(fp, "type") then ast_type_to_ir_with_scope(get(fp, "type"), sig_scope) else "int"
                slot_set("otir:paramtype:" + fn_name + ":{fp_i}", fp_ty)
                # SOURCE form of the same type ("[T]", "T", "int"), for generic
                # call-site instantiation: the IR form above is already erased,
                # so it cannot say WHICH type var a parameter carries.
                if has(fp, "type"):
                    slot_set("otir:psrc:" + fn_name + ":{fp_i}", type_src_text(get(fp, "type")))
            # Generic fns record their type-var names + the source form of the
            # return type. A call site binds the vars from its actual argument
            # types and re-types the result (otir_call_ret_generic).
            # The parser hands over the type-var names as one Text (see
            # psr_parse_fn): reading them out of the `generics` LIST here would
            # take the element type from a map value, which is typed
            # list-of-map whatever it holds.
            gen_csv = if has(decl, "generics_csv") then get(decl, "generics_csv") else ""
            if gen_csv != "":
                slot_set("otir:gen:" + fn_name, gen_csv)
                if has(decl, "ret"):
                    slot_set("otir:rsrc:" + fn_name, type_src_text(get(decl, "ret")))
        if decl_kind_1b == "ExternFn":
            ext_name = get(decl, "name")
            ext_ret = ast_type_to_ir_with_scope(get(decl, "ret"), sig_scope)
            sig_scope = scope_add_fn_sig(sig_scope, ext_name, ext_ret)
            slot_set("otir:arity:" + ext_name, len(get_list(decl, "params")))

    # Pass 2: build each fn's body with the signature scope available.
    # ExternFn becomes a body-less IRFn (params + ret, zero instructions);
    # emit turns those into `declare` lines with real LLVM types.
    mut module = ir_module_new()
    mut has_main = 0
    mut orb_2 = ""
    loop index in 0..<total:
        decl = at(decls, index)
        kind = get(decl, "kind")
        if kind == "OrbMark":
            orb_2 = get(decl, "name")
        if kind == "Retired":
            rt_word = get(decl, "word")
            rt_line = get_int(decl, "line")
            rt_col = get_int(decl, "col")
            compile_error("orion: ERROR at {otir_where(rt_line, rt_col)} — `{rt_word}` was retired; `type` declares every type now (`type Name: field: T` for a product, `type Name:` + indented variants for a sum)")
        if kind == "Unsupported":
            us_word = get(decl, "word")
            us_line = get_int(decl, "line")
            us_col = get_int(decl, "col")
            compile_error("orion: ERROR at {otir_where(us_line, us_col)} — `{us_word}` is reserved but not implemented; there is no lowering for it (use plain functions over `type` values, and pass behaviour as fn args)")
        if kind == "Fn":
            fn_pub_2 = if has(decl, "pub") then get_int(decl, "pub") else 1
            orb_of_2 = if has(decl, "orb") then get(decl, "orb") else orb_2
            # Set per FUNCTION, not per marker: a lifted lambda is lowered from
            # the end of the list but must still resolve names as its own orb.
            slot_set("otir:curorb", orb_of_2)
            fn_ir = ast_fn_to_ir(set(decl, "name", otir_mangle(orb_of_2, get(decl, "name"), fn_pub_2)), sig_scope)
            module = ir_module_add_fn(module, fn_ir)
            if fn_ir.name == "main":
                has_main = 1
        if kind == "ExternFn":
            ext_ret2 = ast_type_to_ir_with_scope(get(decl, "ret"), sig_scope)
            mut ext_fn = ir_fn_new(get(decl, "name"), ext_ret2)
            ext_params = get_list(decl, "params")
            n_ext_params = len(ext_params)
            loop epi in 0..<n_ext_params:
                ep = at(ext_params, epi)
                ep_type = ast_type_to_ir_with_scope(get(ep, "type"), sig_scope)
                ext_fn = ir_fn_add_param(ext_fn, get(ep, "name"), ep_type)
            module = ir_module_add_fn(module, ext_fn)
    if has_main == 0:
        mut stub = ir_fn_new("main", "i64")
        zero = ir_fn_push(stub, ir_iconst(0))
        ret = ir_fn_push(zero.function, ir_return(zero.id))
        module = ir_module_add_fn(module, ret.function)
    module
