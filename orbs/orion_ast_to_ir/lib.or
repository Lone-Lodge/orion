        bound_id = scope_lookup(scope, callee)
        is_local_callee = bound_id >= 0
        # refs-laget: varje ANROP rapporterar plats, skrivet namn och det
        # UPPLOSTA globala namnet - orb-precisionen som use-grafen saknar.
        if slot_get_number("drv:refs") is 1 and has(node, "line"):
            ref_g = if is_local_callee then "lokal" else callee_g
            ref_ln = get_int(node, "line")
            print_line("REF {otir_where(ref_ln, 1)}:{callee}:{ref_g}")
        total_args = length(args)
        edit current_fn = fn_value
        edit current_scope = scope
        edit arg_ids = []
        loop arg_index in 0 until total_args:
            arg_node = args[arg_index]
            arg_r = ast_expr_to_ir(current_fn, current_scope, arg_node)
            current_fn = arg_r.function
            current_scope = arg_r.scope
            # Call-arg pointer-subtype guard (direct calls only - a closure
            # callee has no registered param types). Same rule as the return and
            # rebind guards: a reliably-shaped arg of one concrete pointer kind
            # (text/list/struct) passed where a DIFFERENT concrete kind is
            # declared is a real type error even though both are ptr storage.
            # map/fn/generic params stay wildcards; an arg whose static type is
            # unreliable (slot_get/map get, traced through phis) is skipped so the
            # dynamic-storage idiom never false-positives.
            edit arg_id_final = arg_r.id
            if not is_local_callee:
                pt_key_ca = "otir:paramtype:" + callee_g + ":{arg_index}"
                if slot_has(pt_key_ca):
                    decl_pt_ca = slot_get(pt_key_ca)
                    arg_ty_ca = get_value_type(current_fn, arg_r.id)
                    # The `number` boundary: an integer argument where the
                    # parameter is declared f64 is PROMOTED (sitofp) - the
                    # same rule arithmetic already applies. One number
                    # surface, exact for every whole value below 2^53.
                    # Without this the callee read raw int bits as a double
                    # and answered garbage, silently.
                    if decl_pt_ca is "f64" and is_whole_ir(arg_ty_ca):
                        pr_ca = ir_fn_push(current_fn, ir_sitofp(arg_r.id))
                        current_fn = pr_ca.function
                        arg_id_final = pr_ca.id
                    # ...and the demotion twin: a number where the parameter
                    # is an integer slot truncates exactly for whole values.
                    if arg_ty_ca is "f64" and is_whole_ir(decl_pt_ca):
                        de_ca = ir_fn_push(current_fn, ir_fptosi(arg_r.id))
                        current_fn = de_ca.function
                        arg_id_final = de_ca.id
                    decl_ck_ca = concrete_ptr_kind(decl_pt_ca)
                    arg_ck_ca = concrete_ptr_kind(arg_ty_ca)
                    if decl_ck_ca is not "" and arg_ck_ca is not "" and decl_ck_ca is not arg_ck_ca and (not is_unreliable_ptr(current_fn, arg_r.id)):
                        ca_line = if has(arg_node, "line") then get_int(arg_node, "line") else (if has(node, "line") then get_int(node, "line") else 0)
                        ca_col = if has(arg_node, "col") then get_int(arg_node, "col") else 0
                        compile_error("orion: ERROR at {otir_where(ca_line, ca_col)} - argument {arg_index + 1} to `{callee}` is a `{friendly_type(arg_ty_ca)}` but the parameter is declared `{friendly_type(decl_pt_ca)}` (a {arg_ck_ca} where a {decl_ck_ca} was expected)")
                    # NB an i64-arg -> ptr-param check was TRIED here and REVERTED:
                    # erasure means a real list value can carry the type "i64" (a
                    # list that lost its element type through a dynamic getter or
                    # an untyped build), so `ints_differ(x, emptyish)` false-
                    # positived across the harness. The i64-vs-ptr bucket at call
                    # args is unreachable until dynamic getters carry honest types
                    # (the step-3 erasure work) - the concrete-kind check above is
                    # the safe ceiling for the guard pattern.
            arg_ids = append(arg_ids, arg_id_final)
