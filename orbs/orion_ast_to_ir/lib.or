        rt = get_value_type(arg_r.function, arg_r.id)
        rfn = if rt is "text" then "__orion_resume_text" else (if rt is "f64" then "__orion_resume_real" else "__orion_resume_int")
        pr = ir_fn_push(arg_r.function, ir_call(rfn, [arg_r.id], "void"))
