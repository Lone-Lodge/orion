            # If the callee is a `function(...)`-typed param of THIS fn (matched by
            # name + generation stamp), its declared arity is known - so a call
            # with the wrong argument count is a compile error, not a silently
            # ignored extra arg. Params without a spelled-out fn signature (a
            # bare closure local) have no stamp and stay unchecked.
            fnp_gen_key = "otir:fnparam_gen:" + callee
            edit hoc_ret = "i64"
            cl_key = "otir:closret:" + current_fn.name + ":" + callee
            if slot_has(cl_key):
                hoc_ret = slot_get(cl_key)
            if slot_has(fnp_gen_key) and slot_get_number(fnp_gen_key) is slot_int_or_zero("otir:tvgen"):
                want_arity = slot_get_number("otir:fnparam_arity:" + callee)
                hoc_line = if has(node, "line") then get_int(node, "line") else 0
                hoc_col = if has(node, "col") then get_int(node, "col") else 0
                if length(arg_ids) is not want_arity:
                    compile_error("orion: ERROR at {otir_where(hoc_line, hoc_col)} - `{callee}` expects {want_arity} argument(s) but got {length(arg_ids)}")
                # Propagate the declared return type, normalized to its STORAGE
                # CLASS so the closure call's ABI always matches how the value is
                # actually returned. There are exactly three classes: a pointer
                # (text/list/map/struct) rides in the same integer register as an
                # i64 but must carry its real type for downstream `.field`/len;
                # an f64 comes back in a float register (double); everything else
                # (int/bool/sized ints/type vars) is an i64. Forwarding the raw
                # type unnormalized was the bug that made `truth` become `i1` and
                # corrupt the call, so we map to the class, never the spelling.
                hoc_ret = otir_ret_storage(slot_get("otir:fnparam_ret:" + callee))
                # Argument-shape check, same conservative rule as direct calls
                # (see the is_not_local branch above): a reliably-shaped arg of
                # one concrete pointer kind passed where a DIFFERENT concrete kind
                # is declared is a real error. i64/fn/generic wildcards and
                # unreliable-typed args are skipped, so erased values never
                # false-positive.
                loop hac_i in 0 until length(arg_ids):
                    hac_key = "otir:fnparam_pt:" + callee + ":{hac_i}"
                    if slot_has(hac_key):
                        hac_decl = concrete_ptr_kind(slot_get(hac_key))
                        hac_aid = arg_ids[hac_i]
                        hac_arg = concrete_ptr_kind(get_value_type(current_fn, hac_aid))
                        if hac_decl is not "" and hac_arg is not "" and hac_decl is not hac_arg and (not is_unreliable_ptr(current_fn, hac_aid)):
                            compile_error("orion: ERROR at {otir_where(hoc_line, hoc_col)} - argument {hac_i + 1} to `{callee}` is a `{friendly_type(get_value_type(current_fn, hac_aid))}` but the parameter is declared `{friendly_type(slot_get(hac_key))}`")
            # The local holds a closure value ([fn_ptr, flag, caps...]); call
            # through it, with the declared pointer return type when known (see
            # hoc_ret above), else i64.
            pr = ir_fn_push(current_fn, ir_closure_call(bound_id, arg_ids, hoc_ret))
            result = ConvResult{function: pr.function, scope: current_scope, id: pr.id}
        else:
            erased_ret_type = scope_lookup_fn_ret_loc(scope, callee_g, node)
            # Re-type a generic result from the ACTUAL argument types. `[T]` in
            # a signature is erased to `list:i64` in the body, but at the call
            # site the argument says what T is, so the result no longer loses
            # its element type (`keep(words, p)[0]` is a text again).
            edit call_arg_types = part([""], 0, 0)
            loop cat_i in 0 until length(arg_ids):
                call_arg_types = append(call_arg_types, get_value_type(current_fn, arg_ids[cat_i]))
            call_ret_type = otir_call_ret_generic(callee_g, call_arg_types, erased_ret_type)
            # Capabilities compose UPWARD: a declared caller must cover
            # everything its callee declares.
            if slot_has("otir:curuses") and slot_has("otir:uses:" + callee_g):
                ccur = slot_get("otir:curuses")
                ccal = slot_get("otir:uses:" + callee_g)
                if ccur is not "":
                    edit cmiss = ""
                    if contains(ccal, "console") and not contains(ccur, "console"):
                        cmiss = "console"
                    if contains(ccal, "files") and not contains(ccur, "files"):
                        cmiss = "files"
                    if contains(ccal, "net") and not contains(ccur, "net"):
                        cmiss = "net"
                    if contains(ccal, "clock") and not contains(ccur, "clock"):
                        cmiss = "clock"
                    if contains(ccal, "random") and not contains(ccur, "random"):
                        cmiss = "random"
                    if cmiss is not "":
                        cml = if has(node, "line") then get_int(node, "line") else 0
                        cmc = if has(node, "col") then get_int(node, "col") else 0
                        compile_error("orion: ERROR at {otir_where(cml, cmc)} - `{callee}` declares `uses {ccal}`; the caller must cover `{cmiss}` in its own uses clause")
            arity_key = "otir:arity:" + callee_g
            if slot_has(arity_key):
                want = slot_get_number(arity_key)
                got = length(arg_ids)
                if got is not want:
                    a_line = if has(node, "line") then get_int(node, "line") else 0
                    a_col = if has(node, "col") then get_int(node, "col") else 0
                    compile_error("orion: ERROR at {otir_where(a_line, a_col)} - `{callee}` takes {want} argument(s), got {got}")
            # The CALLEE's machine signature is the erased one: `[T]` returns a
            # pointer either way (so the refined `list:text` can be stamped
            # straight on the call), but a bare `-> T` returns an i64 slot. When
            # the refinement turns that slot into a pointer type, the call must
            # keep returning i64 and the POINTER-ness is recovered right after,
            # the same way a closure capture is re-typed. Emitting the call with
            # a ptr type instead would contradict the definition and clang
            # rejects the module ("defined with type i64 but expected ptr").
            retype_needed = erased_ret_type is "i64" and is_ptr_ir_type(call_ret_type)
            call_emit_type = if retype_needed then "i64" else call_ret_type
            pr = ir_fn_push(current_fn, ir_call(callee_g, arg_ids, call_emit_type))
            if retype_needed:
                pr_rt = ir_fn_push(pr.function, ir_int_to_ptr(pr.id, call_ret_type))
                result = ConvResult{function: pr_rt.function, scope: current_scope, id: pr_rt.id}
            else:
                result = ConvResult{function: pr.function, scope: current_scope, id: pr.id}
    result

define ast_unary_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    op = get(node, "op")
    operand_r = ast_expr_to_ir(fn_value, scope, get(node, "operand"))
    if op is "not":
        pr = ir_fn_push(operand_r.function, ir_inot(operand_r.id))
        ConvResult{function: pr.function, scope: operand_r.scope, id: pr.id}
    else if op is "bnot":
        # `~x` is `x ^ -1`: flip every bit. (`not x` is the LOGICAL one and
        # coerces to 0/1 - two different operators, and they used to give the
        # same answer because `~` had no lowering at all.)
        pr_ones = ir_fn_push(operand_r.function, ir_iconst(0 - 1))
        pr_x = ir_fn_push(pr_ones.function, ir_bit_xor(operand_r.id, pr_ones.id))
        ConvResult{function: pr_x.function, scope: operand_r.scope, id: pr_x.id}
    else:
        if op is "neg":
            # -x → 0 - x. Dispatch on the operand type: an f64 operand must
            # use a float zero + fsub, else the subtract is emitted as `sub
            # i64` over a double (a negative float literal like -7.0 miscompiled).
            if get_value_type(operand_r.function, operand_r.id) is "f64":
                pr_z = ir_fn_push(operand_r.function, ir_fconst("0.0"))
                pr_s = ir_fn_push(pr_z.function, ir_fbin("fsub", pr_z.id, operand_r.id))
                ConvResult{function: pr_s.function, scope: operand_r.scope, id: pr_s.id}
            else:
                pr_z = ir_fn_push(operand_r.function, ir_iconst(0))
                pr_s = ir_fn_push(pr_z.function, ir_isub(pr_z.id, operand_r.id))
                ConvResult{function: pr_s.function, scope: operand_r.scope, id: pr_s.id}
        else:
            operand_r

# Get the result type ("i64" / "text" / "ptr" / "void") of an SSA value.
define get_value_type(fn_value: IRFn, value_id: number) -> text:
    if value_id < 0:
        "void"
    else:
        inst = fn_value.instructions[value_id]
        inst.type_text


define ast_str_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    text = get(node, "value")
    pr = ir_fn_push(fn_value, ir_const_str(text))
    ConvResult{function: pr.function, scope: scope, id: pr.id}


define ast_list_lit_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    items = get_list(node, "items")
    n_items = length(items)
    edit current_fn = fn_value
    edit current_scope = scope
    edit item_ids = []
    edit first_elem_class = ""
    loop index in 0 until n_items:
        item_node = items[index]
        item_pre = ast_expr_to_ir(current_fn, current_scope, item_node)
        # A literal's element class is set by its first item; later
        # number/whole items coerce to it ([1, 2.5] is a number list).
        edit item_r = item_pre
        if index is 0:
            first_elem_class = get_value_type(item_pre.function, item_pre.id)
            first_scan = items
            loop probe_node in first_scan:
                if get(probe_node, "kind") is "Float":
                    first_elem_class = "f64"
        else:
            item_r = coerce_to_elem(item_pre, first_elem_class)
        if index is 0 and first_elem_class is "f64":
            item_r = coerce_to_elem(item_pre, "f64")
        current_fn = item_r.function
        current_scope = item_r.scope
        item_ids = append(item_ids, item_r.id)
    # Peek first item's type to encode "list:T". Default i64 for empty lists.
    edit elem_type = "i64"
    if n_items > 0:
        first_id = item_ids[0]
        elem_type = get_value_type(current_fn, first_id)
    # Homogeneity guard (container construction, same rule as struct-field
    # construction): a list literal mixing two DIFFERENT concrete pointer kinds
    # (e.g. `[textv, Point{..}]`) is a type error - a `[T]` holds one element
    # type. Anchor on the first reliably-shaped concrete element; flag any later
    # reliable element of a different concrete kind. Unreliable items (slot_get/
    # map-get) and map/fn/generic/i64 items are wildcards (skipped), so the
    # dynamic-storage idiom and int lists never false-positive.
    edit anchor_kind = ""
    edit anchor_type = ""
    loop ck_i in 0 until n_items:
        ck_id = item_ids[ck_i]
        if not is_unreliable_ptr(current_fn, ck_id):
            ck_ty = get_value_type(current_fn, ck_id)
            ck_kind = concrete_ptr_kind(ck_ty)
            if ck_kind is not "":
                if anchor_kind is "":
                    anchor_kind = ck_kind
                    anchor_type = ck_ty
                else if ck_kind is not anchor_kind:
                    ll_line = if has(node, "line") then get_int(node, "line") else 0
                    ll_col = if has(node, "col") then get_int(node, "col") else 0
                    compile_error("orion: ERROR at {otir_where(ll_line, ll_col)} - list literal mixes `{friendly_type(anchor_type)}` and `{friendly_type(ck_ty)}` elements (a list holds one element type: a {ck_kind} where a {anchor_kind} was expected)")
    pr = ir_fn_push(current_fn, ir_list_lit(item_ids, elem_type))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}


# Lower a nested sub-pattern in a payload slot (`Some(Ok(x))`). `inner_id`
# holds that slot - itself an enum struct. Test its tag against the
# sub-variant and, on a match, bind the sub-pattern's names to ITS payload
# slots (retyped from the inner variant's spec). A failed test falls through
# to `next_lbl`, the next arm's test - the same shape a guard uses.
define otir_lower_nested_pat(fn_value: IRFn, scope: Scope, enc: text, inner_id: number, inner_type: text, next_lbl: text, cont_lbl: text) -> ConvResult:
    edit current_fn = fn_value
    edit current_scope = scope
    inner_enum = strip_struct_prefix(inner_type)
    sub_variant = nested_binding_variant(enc)
    sub_names = nested_binding_names(enc)
    v_idx = scope_lookup_enum_variant(scope, inner_enum, sub_variant)
    if v_idx < 0:
        compile_error("orion: ERROR - nested pattern `{sub_variant}(…)` - `{sub_variant}` is not a variant of `{inner_enum}`")
    sub_want = variant_payload_count(scope, inner_enum, sub_variant)
    if length(sub_names) is not sub_want:
        compile_error("orion: ERROR - nested pattern `{sub_variant}` binds {length(sub_names)} value(s) but the variant carries {sub_want}")
    pr_tag = ir_fn_push(current_fn, ir_field_load(inner_id, 0, "i64"))
    current_fn = pr_tag.function
    pr_pat = ir_fn_push(current_fn, ir_iconst(v_idx))
    current_fn = pr_pat.function
    pr_eq = ir_fn_push(current_fn, ir_icmp_eq(pr_tag.id, pr_pat.id))
    current_fn = pr_eq.function
    pr_br = ir_fn_push(current_fn, ir_br_if(pr_eq.id, cont_lbl, next_lbl))
    current_fn = pr_br.function
    pr_lbl = ir_fn_push(current_fn, ir_label(cont_lbl))
    current_fn = pr_lbl.function
    sub_types = split_csv(scope_lookup_variant_payloads(scope, inner_enum, sub_variant))
    n_sub_types = length(sub_types)
    loop si in 0 until length(sub_names):
        st = if si < n_sub_types then sub_types[si] else "i64"
        pr_slot = ir_fn_push(current_fn, ir_field_load(inner_id, 1 + si, st))
        current_fn = pr_slot.function
        current_scope = scope_bind(current_scope, sub_names[si], pr_slot.id)
    ConvResult{function: current_fn, scope: current_scope, id: inner_id}


# Does this arm carry a nested sub-pattern? Such an arm matches only PART of
# its variant, so it counts toward coverage only together with its siblings.
define arm_has_nested(arm: table) -> truth:
    binds = if has(arm, "bindings") then get_list(arm, "bindings") else []
    edit nested = false
    loop bi in 0 until length(binds):
        if is_nested_binding(binds[bi]):
            nested = true
    nested


# The sub-variant an arm's single nested slot names (`Some(Ok(x))` -> "Ok").
# An arm nesting in more than one slot is a conjunction, so it covers nothing
# on its own - report "" and let it need a sibling or a wildcard.
define otir_arm_nested_sub(arm: table) -> text:
    binds = if has(arm, "bindings") then get_list(arm, "bindings") else []
    edit sub = ""
    edit count = 0
    loop bi in 0 until length(binds):
        if is_nested_binding(binds[bi]):
            count = count + 1
            sub = nested_binding_variant(binds[bi])
    if count is 1 then sub else ""


define csv_has(csv: text, name: text) -> truth:
    parts = split_csv(csv)
    edit found = false
    loop i in 0 until length(parts):
        if parts[i] is name:
            found = true
    found


# Do these nested sub-variants together cover the payload enum of `variant`?
# `Some(Ok(x))` + `Some(Bad(m))` covers `Some` because Ok|Bad IS all of Res.
# Only a single-slot payload whose type is an enum can be covered this way.
define otir_subs_cover(scope: Scope, en: text, variant: text, subs_seen: text) -> truth:
    payloads = split_csv(scope_lookup_variant_payloads(scope, en, variant))
    edit covers = false
    if length(payloads) is 1:
        inner_enum = strip_struct_prefix(payloads[0])
        inner_csv = enum_variant_csv(scope, inner_enum)
        inner_names = split_csv(inner_csv)
        if length(inner_names) > 0:
            edit all_seen = true
            loop ii in 0 until length(inner_names):
                if not csv_has(subs_seen, inner_names[ii]):
                    all_seen = false
            covers = all_seen
    covers


# How many variants of `en` do these arms cover? A plain variant arm covers
# its variant outright; nested arms cover theirs only together (see above).
# Guarded arms cover nothing - their condition can fail at runtime.
define otir_covered_variants(scope: Scope, arms: [table], en: text) -> number:
    v_names = split_csv(enum_variant_csv(scope, en))
    edit covered = 0
    loop vi in 0 until length(v_names):
        vn = v_names[vi]
        edit full = false
        edit subs_seen = ""
        loop ai in 0 until length(arms):
            arm = arms[ai]
            arm_hits = get(arm, "pat_kind") is "ident" and get(arm, "pattern") is vn and not has(arm, "guard")
            if arm_hits and arm_has_nested(arm):
                sub_here = otir_arm_nested_sub(arm)
                subs_seen = "{subs_seen},{sub_here}"
            if arm_hits and not arm_has_nested(arm):
                full = true
        if not full:
            full = otir_subs_cover(scope, en, vn, subs_seen)
        if full:
            covered = covered + 1
    covered


# `choose scrutinee: <pattern> -> <body>, ..., _ -> <default>`
# Rewrite each arm's pattern name through `spoken_variant`. Only `ident`
# patterns name a variant; `_`, literals and tuples pass through untouched.
define spoken_arms(scope: Scope, arms: [table]) -> [table]:
    edit out = []
    loop ai in 0 until length(arms):
        arm = arms[ai]
        edit fixed = arm
        if get(arm, "pat_kind") is "ident":
            pv = get(arm, "pattern")
            if spoken_core_enum(scope, pv) is not "":
                fixed = set(set(arm, "pattern", spoken_declared(pv)), "core_variant", 1)
        out = append(out, fixed)
    out

# Lower to a chain of if-tests storing into a result slot.
define ast_match_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    scrutinee_node = get(node, "scrutinee")
    # `some(x)` / `none` / `ok(v)` / `error(m)` read as patterns too, not just
    # as constructors - an arm that builds one way and matches another would
    # be the worst of both spellings. Translated once, here, so every reader
    # below (coverage, guards, binding) sees the declared name. Same
    # last-resort rule: an enum of your own with a variant `ok` keeps it.
    arms = spoken_arms(scope, get_list(node, "arms"))
    n_arms = length(arms)
    n = length(fn_value.instructions)
    end_lbl = "match_{n}_end"

    scrut_r = ast_expr_to_ir(fn_value, scope, scrutinee_node)
    scrut_id = scrut_r.id
    scrut_type = get_value_type(scrut_r.function, scrut_id)

    # Instruction count BEFORE the result-type probe. `ir_fn_push` mutates the
    # instruction spine in place (push_mut), so lowering an arm body during the
    # probe LEAKS those instructions into the real function - they would then
    # execute for real (running a side-effecting first arm twice). After probing
    # we truncate back to this baseline, discarding every leaked emission. The
    # probe reads only the resulting TYPE, never its instructions.
    probe_base = length(scrut_r.function.instructions)

    # Result slot type: probe the WILDCARD arm's body by lowering it
    # against a scratch copy of the fn - IRFn is a value, discarding
    # the probe costs nothing, and wildcard bodies have no pattern
    # bindings so the current scope suffices. This types matches whose
    # arms return structs/enums (astra's Value) correctly instead of
    # guessing i64. Fallback: first-arm Str heuristic, then i64.
    edit result_type = "i64"
    edit probed = false
    loop pai in 0 until n_arms:
        arm_probe = arms[pai]
        if get(arm_probe, "pat_kind") is "ident" and get(arm_probe, "pattern") is "_" and not probed:
            wc_r = ast_expr_to_ir(scrut_r.function, scrut_r.scope, get(arm_probe, "body"))
            if wc_r.id >= 0:
                result_type = get_value_type(wc_r.function, wc_r.id)
                probed = true
    if not probed:
        if n_arms > 0:
            # No wildcard: probe the FIRST arm's body. Bind its pattern
            # variables with their DECLARED payload types (not an i64 scratch)
            # so a body that IS a payload - `TextV(s) -> s`, `Spawn(comps) ->
            # comps` - probes as text/map instead of i64. Binding to a generic
            # i64 dummy mis-typed the whole match, mis-storing the value and
            # tripping the return-type check (and, for map/list payloads,
            # segfaulting at runtime when the i64 was used as a pointer).
            # The probe fn is discarded; only the resulting type is read.
            first_arm = arms[0]
            first_pat = get(first_arm, "pattern")
            first_pk = get(first_arm, "pat_kind")
            edit probe_fn = scrut_r.function
            edit probe_scope = scrut_r.scope
            first_binds = if has(first_arm, "bindings") then get_list(first_arm, "bindings") else []
            # Resolve the first arm's enum (if it is a variant pattern) so we
            # can type its payload binds like Phase 2b does.
            edit fa_enum = ""
            if first_pk is "ident" and first_pat is not "_":
                fa_enum = variant_enum_of(scope, first_pat)
            # A tuple pattern binds fields 0..n from the scrutinee's tuple spec.
            # Typing them from the spec (not an i64 dummy) is what lets a body
            # like `(n, s) -> n + length(s)` probe at all: with the dummy, `length(s)`
            # saw an int and aborted the whole compile from inside the probe.
            fa_is_tuple = first_pk is "tuple" and length(first_binds) > 0
            if fa_is_tuple:
                tup_parts_p = parse_data_spec(scope_lookup_data_spec(scope, strip_struct_prefix(scrut_type)))
                loop tbi in 0 until length(first_binds):
                    tt_p = field_type_at(tup_parts_p, tbi)
                    pr_tf = ir_fn_push(probe_fn, ir_field_load(scrut_id, tbi, tt_p))
                    probe_fn = pr_tf.function
                    probe_scope = scope_bind(probe_scope, first_binds[tbi], pr_tf.id)
            if fa_enum is not "" and length(first_binds) > 0 and not fa_is_tuple:
                payload_types_p = split_csv(scope_lookup_variant_payloads(scope, fa_enum, first_pat))
                n_pt_p = length(payload_types_p)
                loop bpi in 0 until length(first_binds):
                    bt_p = if bpi < n_pt_p then payload_types_p[bpi] else "i64"
                    pr_pl = ir_fn_push(probe_fn, ir_field_load(scrut_id, 1 + bpi, bt_p))
                    probe_fn = pr_pl.function
                    # Nested slot: bind the SUB-names (typed), not the slot -
                    # a body like `Some(Ok(x)) -> x` names `x`, never the slot.
                    # The probe's emissions (branches included) are sliced away.
                    if is_nested_binding(first_binds[bpi]):
                        np_r = otir_lower_nested_pat(probe_fn, probe_scope, first_binds[bpi], pr_pl.id, bt_p, "probe_next", "probe_cont{bpi}")
                        probe_fn = np_r.function
                        probe_scope = np_r.scope
                    else:
                        probe_scope = scope_bind(probe_scope, first_binds[bpi], pr_pl.id)
            if fa_enum is "" and not fa_is_tuple:
                pr_dummy = ir_fn_push(probe_fn, ir_iconst(0))
                probe_fn = pr_dummy.function
                loop bpi in 0 until length(first_binds):
                    probe_scope = scope_bind(probe_scope, first_binds[bpi], pr_dummy.id)
            fa_r = ast_expr_to_ir(probe_fn, probe_scope, get(first_arm, "body"))
            if fa_r.id >= 0:
                result_type = get_value_type(fa_r.function, fa_r.id)
    # Drop the probe's leaked instructions: rebuild the fn with its spine sliced
    # back to the pre-probe baseline. `slice` allocates a fresh list, so the
    # subsequent in-place pushes for the real arm bodies start clean and their
    # value-ids line up exactly as if no probe had run.
    clean_fn = IRFn{name: scrut_r.function.name, return_type: scrut_r.function.return_type, params: scrut_r.function.params, instructions: part(scrut_r.function.instructions, 0, probe_base)}
    pr_alloca = ir_fn_push(clean_fn, ir_alloca(result_type))
    result_ptr_id = pr_alloca.id
    edit current_fn = pr_alloca.function
    edit current_scope = scrut_r.scope

    # Exhaustiveness check - pre-walk arms to detect wildcard + count
    # matched variants. If scrutinee is an enum and no wildcard arm is
    # present, ensure every variant is covered. Emit a compile-time error.
    edit has_wildcard = false
    edit matched_count = 0
    edit matched_enum = ""
    loop chk_idx in 0 until n_arms:
        chk_arm = arms[chk_idx]
        chk_pk = get(chk_arm, "pat_kind")
        chk_pv = get(chk_arm, "pattern")
        chk_guarded = has(chk_arm, "guard")
        if chk_pk is "ident" and chk_pv is "_" and not chk_guarded:
            has_wildcard = true
        if chk_pk is "ident" and chk_pv is not "_" and not chk_guarded:
            # Exhaustiveness counts the arms of ONE enum, so it has to agree
            # with the enum the arm actually lowers against.
            chk_enum = variant_enum_of(scope, chk_pv)
            chk_is_variant = chk_enum is not ""
            if chk_is_variant:
                matched_count = matched_count + 1
                matched_enum = chk_enum
            # A non-variant bare ident is a binding pattern - covers everything.
            if not chk_is_variant:
                has_wildcard = true
    if not has_wildcard and matched_enum is not "":
        # Look up total variants for this enum (CSV - comma count + 1).
        en_total = length(scope.en_names)
        edit total_variants = 0
        loop ei2 in 0 until en_total:
            if scope.en_names[ei2] is matched_enum:
                csv = scope.en_variants[ei2]
                csv_bytes = bytes_of(csv)
                total_variants = 1
                csv_len = length(csv_bytes)
                loop ci in 0 until csv_len:
                    if csv_bytes[ci] is 44:
                        total_variants = total_variants + 1
        # Real coverage, not an arm count: nested arms cover their variant only
        # together (`Some(Ok(x))` + `Some(Bad(m))` covers `Some`), and two arms
        # naming the SAME variant must not count twice.
        covered_variants = otir_covered_variants(scope, arms, matched_enum)
        if covered_variants < total_variants:
            mline = if has(node, "line") then get_int(node, "line") else 0
            mcol = if has(node, "col") then get_int(node, "col") else 0
            missing = total_variants - covered_variants
            compile_error("orion: ERROR at {otir_where(mline, mcol)} - non-exhaustive match on enum `{matched_enum}` ({missing} variant(s) not covered, no wildcard arm)")

    edit arm_index = 0
    loop arm_idx in 0 until n_arms:
        arm = arms[arm_idx]
        pat_kind = get(arm, "pat_kind")
        pat_value = get(arm, "pattern")
        body_node = get(arm, "body")
        is_wildcard = pat_kind is "ident" and pat_value is "_"

        body_lbl = "match_{n}_arm_{arm_index}_body"
        next_lbl = "match_{n}_arm_{arm_index}_next"
        guard_lbl = "match_{n}_arm_{arm_index}_guard"
        arm_index = arm_index + 1

        # Flat dispatch - deep nested if/else inside this for-loop
        # mis-binds (see orion_nesting_bug.md). Each phase guards on
        # is_wildcard / pat_kind via boolean flags.

        # Detect variant pattern - pat_value is a known enum variant.
        # Capture WHICH enum matched so payload bindings can retype
        # loads with the variant's declared payload types. Synthetic
        # "Enum$Variant" payload entries are skipped via the $ guard.
        bindings = if has(arm, "bindings") then get_list(arm, "bindings") else []
        edit variant_idx = 0 - 1
        edit variant_enum = ""
        if (not is_wildcard) and pat_kind is "ident":
            # Which enum declares this variant - YOURS before the core types,
            # the same order `variant_enum_of` uses. This loop had its own
            # first-hit search, so a program with its own `None` matched the
            # core `Option.None` instead and was told its arm bound one value
            # too many. One rule, or the rule holds nowhere.
            # `spoken_arms` marks an arm whose pattern was written in the
            # spoken form; that one names the core type even where a variant
            # of yours answers to the declared name too.
            arm_is_core = has(arm, "core_variant")
            variant_enum = if arm_is_core then variant_enum_where(scope, pat_value, true) else variant_enum_of(scope, pat_value)
            if variant_enum is not "":
                variant_idx = scope_lookup_enum_variant(scope, variant_enum, pat_value)
        is_variant = variant_idx >= 0
        # A non-`_`, non-variant ident pattern is a BINDING pattern: it matches
        # anything (irrefutable) and binds the whole scrutinee to that name.
        # This is what makes a guard on a scalar work: `x if x > 0 -> ...`.
        is_binding_pat = (not is_wildcard) and pat_kind is "ident" and (not is_variant)
        # A tuple pattern `(a, b) -> ...` is irrefutable and binds each field.
        is_tuple_pat_arm = pat_kind is "tuple"

        # Phase 1: emit pat (skip for wildcard).
        do_int_pat = (not is_wildcard) and pat_kind is "int"
        do_str_pat = (not is_wildcard) and pat_kind is "str"
        do_variant_pat = is_variant
        edit pat_id = 0 - 1
        if do_int_pat:
            pr_pat = ir_fn_push(current_fn, ir_iconst(parse_int(pat_value)))
            current_fn = pr_pat.function
            pat_id = pr_pat.id
        if do_str_pat:
            pr_pat = ir_fn_push(current_fn, ir_const_str(pat_value))
            current_fn = pr_pat.function
            pat_id = pr_pat.id
        if do_variant_pat:
            pr_pat = ir_fn_push(current_fn, ir_iconst(variant_idx))
            current_fn = pr_pat.function
            pat_id = pr_pat.id

        # Phase 2: emit icmp + branch (skip for wildcard, binding, and tuple
        # patterns - all irrefutable).
        do_cmp = (not is_wildcard) and (not is_binding_pat) and (not is_tuple_pat_arm)
        # A PLAIN enum (no variant carries a payload) lowers to a bare integer
        # tag - `Color.Red` IS 0, there is no struct. Reading field 0 off it
        # dereferences the tag as a pointer (tag 2 -> address 0x2), which is why
        # `choose` on such an enum segfaulted. Compare the value itself instead.
        # A TAGGED union really is a struct, so it keeps the tag load.
        do_tagged_variant = do_variant_pat and enum_has_payloads(scope, variant_enum)
        do_text_cmp = do_cmp and scrut_type is "text" and not do_variant_pat
        do_int_cmp = do_cmp and scrut_type is not "text" and not do_tagged_variant
        # Variant: load scrut.tag (field 0) then compare.
        edit eq_id = 0 - 1
        if do_tagged_variant:
            pr_load_tag = ir_fn_push(current_fn, ir_field_load(scrut_id, 0, "i64"))
            current_fn = pr_load_tag.function
            pr_eq = ir_fn_push(current_fn, ir_icmp_eq(pr_load_tag.id, pat_id))
            current_fn = pr_eq.function
            eq_id = pr_eq.id
        if do_text_cmp:
            pr_eq = ir_fn_push(current_fn, ir_text_cmp("text_eq", scrut_id, pat_id))
            current_fn = pr_eq.function
            eq_id = pr_eq.id
        if do_int_cmp:
            pr_eq = ir_fn_push(current_fn, ir_icmp_eq(scrut_id, pat_id))
            current_fn = pr_eq.function
            eq_id = pr_eq.id
        if do_cmp:
            pr_br_if = ir_fn_push(current_fn, ir_br_if(eq_id, body_lbl, next_lbl))
            current_fn = pr_br_if.function
            pr_body_lbl = ir_fn_push(current_fn, ir_label(body_lbl))
            current_fn = pr_body_lbl.function

        # Phase 2b: variant payload bindings - binding i loads slot p{i}
        # (field index 1+i) RETYPED to the variant's declared payload
        # type at that position, so `Spawn(comps) -> do_spawn(s, comps)`
        # types comps as map, `Relate(a, kind, b)` gets i64/text/i64.
        arm_start_names = length(current_scope.names)
        edit body_scope = current_scope
        n_arm_bindings = length(bindings)
        if do_variant_pat:
            arm_want = variant_payload_count(scope, variant_enum, pat_value)
            if n_arm_bindings is not arm_want:
                compile_error("orion: ERROR - match arm `{pat_value}` binds {n_arm_bindings} value(s) but the variant carries {arm_want}")
        if do_variant_pat and n_arm_bindings > 0:
            payload_csv = scope_lookup_variant_payloads(scope, variant_enum, pat_value)
            payload_types = split_csv(payload_csv)
            n_payload_types = length(payload_types)
            loop abi in 0 until n_arm_bindings:
                bind_name = bindings[abi]
                bind_type = if abi < n_payload_types then payload_types[abi] else "i64"
                pr_load_val = ir_fn_push(current_fn, ir_field_load(scrut_id, 1 + abi, bind_type))
                current_fn = pr_load_val.function
                # A nested sub-pattern tests the slot's own tag and binds its
                # names; a plain slot just binds the whole payload.
                if is_nested_binding(bind_name):
                    nest_r = otir_lower_nested_pat(current_fn, body_scope, bind_name, pr_load_val.id, bind_type, next_lbl, "{body_lbl}_nest{abi}")
                    current_fn = nest_r.function
                    body_scope = nest_r.scope
                else:
                    body_scope = scope_bind(body_scope, bind_name, pr_load_val.id)

        # A binding pattern (`x -> ...`) binds the whole scrutinee.
        if is_binding_pat:
            body_scope = scope_bind(body_scope, pat_value, scrut_id)
        # A tuple pattern (`(a, b) -> ...`) binds each field. Reuse the proven
        # field-access path: bind the scrutinee to a temp, then lower `temp._i`
        # per binding (so each field keeps its real type from the tuple spec).
        if is_tuple_pat_arm:
            body_scope = scope_bind(body_scope, "__tup_scrut", scrut_id)
            loop tpi in 0 until n_arm_bindings:
                tf_node = {"kind": "Field", "object": {"kind": "Ident", "name": "__tup_scrut"}, "field": "_{tpi}"}
                tf_r = ast_expr_to_ir(current_fn, body_scope, tf_node)
                current_fn = tf_r.function
                body_scope = scope_bind(tf_r.scope, bindings[tpi], tf_r.id)

        # Phase 2c: guard. `Pattern if COND -> body` matches only when COND is
        # also true (evaluated with the arm's bindings in scope). A failed guard
        # falls through to the next arm's test.
        if has(arm, "guard"):
            guard_r = ast_expr_to_ir(current_fn, body_scope, get(arm, "guard"))
            current_fn = guard_r.function
            body_scope = guard_r.scope
            pr_gbr = ir_fn_push(current_fn, ir_br_if(guard_r.id, guard_lbl, next_lbl))
            current_fn = pr_gbr.function
            pr_glbl = ir_fn_push(current_fn, ir_label(guard_lbl))
            current_fn = pr_glbl.function

        # Phase 3: body - emit for both wildcard and pattern arms.
        arm_before = length(body_scope.names)
        body_r = ast_expr_to_ir(current_fn, body_scope, body_node)
        check_branch_shadows(arm_before, body_r.scope, "match arm", node)
        current_fn = body_r.function
        # Arm-locals (payload binds included) die with the arm.
        current_scope = scope_truncate(body_r.scope, arm_start_names)
        # A diverging arm (break/continue/return) already branched away, so its
        # block is terminated and `body_r.id` is not a real value. Storing it or
        # branching to `end` after a terminator was the bug that crashed on
        # `_ -> break` inside a loop. Only store + branch for arms that fall off
        # the end normally.
        # An arm can also produce NO VALUE without diverging: a body block whose
        # last statement is a statement-form `if` (or a loop) yields id -1. That
        # is what `if let P(x) = e:` desugars to when its body is an `if` block,
        # and storing -1 walked the instruction list backwards:
        # "list index -1 out of range". Store a zero for the value the arm does
        # not have, so the match still has a defined result.
        if is_block_terminated(current_fn) is 0:
            edit arm_value_id = body_r.id
            if arm_value_id < 0:
                pr_void = ir_fn_push(current_fn, ir_iconst(0))
                current_fn = pr_void.function
                arm_value_id = pr_void.id
            pr_store = ir_fn_push(current_fn, ir_store(result_ptr_id, arm_value_id))
            current_fn = pr_store.function
            pr_br_end = ir_fn_push(current_fn, ir_br(end_lbl))
            current_fn = pr_br_end.function

        # Phase 4: next-arm-test label. Emitted for a compared arm, and also
        # for a guarded arm (a failed guard branches here) even if it's a
        # wildcard that otherwise skips the compare.
        if do_cmp or has(arm, "guard"):
            pr_next_lbl = ir_fn_push(current_fn, ir_label(next_lbl))
            current_fn = pr_next_lbl.function

    # If no wildcard, ensure the last "next" block has a terminator.
    # Store 0 as default and br end.
    if is_block_terminated(current_fn) is 0:
        pr_zero = ir_fn_push(current_fn, ir_iconst(0))
        pr_store0 = ir_fn_push(pr_zero.function, ir_store(result_ptr_id, pr_zero.id))
        pr_br_end = ir_fn_push(pr_store0.function, ir_br(end_lbl))
        current_fn = pr_br_end.function

    # End block: load result.
    pr_end_lbl = ir_fn_push(current_fn, ir_label(end_lbl))
    pr_load = ir_fn_push(pr_end_lbl.function, ir_load(result_ptr_id, result_type))
    ConvResult{function: pr_load.function, scope: scrut_r.scope, id: pr_load.id}


# `(a, b, ...)` - a tuple. Lower each element (once), then build an anonymous
# struct whose shape is derived from the element IR types. Because the fields
# carry their real per-slot types, a heterogeneous tuple like `(1, "hi")` keeps
# `_0` as int and `_1` as text (unlike the old homogeneous list lowering).
define ast_tuple_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    items = get_list(node, "items")
    n_items = length(items)
    edit current_fn = fn_value
    edit current_scope = scope
    edit item_ids = []
    elem_types = part([""], 0, 0)
    edit elem_type_list = elem_types
    loop ti in 0 until n_items:
        it_r = ast_expr_to_ir(current_fn, current_scope, items[ti])
        current_fn = it_r.function
        current_scope = it_r.scope
        item_ids = append(item_ids, it_r.id)
        elem_type_list = append(elem_type_list, get_value_type(current_fn, it_r.id))
    tup_name = otir_tuple_register(elem_type_list)
    pr = ir_fn_push(current_fn, ir_struct_cons(tup_name, n_items, item_ids))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}

define ast_struct_cons_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    struct_name = get(node, "name")
    fields = get_list(node, "fields")
    spec = scope_lookup_data_spec(scope, struct_name)
    if spec is "":
        line = if has(node, "line") then get_int(node, "line") else 0
        col = if has(node, "col") then get_int(node, "col") else 0
        compile_error("orion: ERROR at {otir_where(line, col)} - unknown data type `{struct_name}`")
    parts = parse_data_spec(spec)
    n_fields_decl = length(parts)
    n_provided = length(fields)
    # Build value_ids in declared field order.
    edit current_fn = fn_value
    edit current_scope = scope
    edit value_ids = []
    loop di in 0 until n_fields_decl:
        decl_part = parts[di]
        # The field's IR type (the spec stores ast_type_to_ir output, so this is
        # "struct:X"/"text"/"list:T"/"i64" - ready for concrete_ptr_kind).
        decl_field_type = field_type_at(parts, di)
        decl_bs = bytes_of(decl_part)
        edit decl_name = ""
        edit found_colon = 0
        decl_bs_n = length(decl_bs)
        loop ci in 0 until decl_bs_n:
            b = decl_bs[ci]
            if found_colon is 0:
                if b is 58:
                    found_colon = 1
                else:
                    single = text_of([b])
                    decl_name = "{decl_name}{single}"
        # Search provided fields for decl_name.
        edit matched_id = 0 - 1
        loop pi in 0 until n_provided:
            prov = fields[pi]
            if get(prov, "name") is decl_name and matched_id is (0 - 1):
                val_r = ast_expr_to_ir(current_fn, current_scope, get(prov, "value"))
                current_fn = val_r.function
                current_scope = val_r.scope
                matched_id = val_r.id
                # Struct-field construction subtype guard (same rule as return/
                # rebind/call-arg): a reliably-shaped field value of one concrete
                # pointer kind (text/list/struct) where a DIFFERENT concrete kind
                # is declared is a type error. map/fn/generic fields = wildcard;
                # an unreliable value (slot_get/map-get) is skipped.
                fld_val_ty = get_value_type(current_fn, matched_id)
                # The `number` boundary, field side: a whole-number value
                # into an f64-declared field is promoted like an argument.
                if decl_field_type is "f64" and is_whole_ir(fld_val_ty):
                    pr_fp = ir_fn_push(current_fn, ir_sitofp(matched_id))
                    current_fn = pr_fp.function
                    matched_id = pr_fp.id
                if fld_val_ty is "f64" and is_whole_ir(decl_field_type):
                    de_fp = ir_fn_push(current_fn, ir_fptosi(matched_id))
                    current_fn = de_fp.function
                    matched_id = de_fp.id
                fld_decl_k = concrete_ptr_kind(decl_field_type)
                fld_val_k = concrete_ptr_kind(fld_val_ty)
                if fld_decl_k is not "" and fld_val_k is not "" and fld_decl_k is not fld_val_k and (not is_unreliable_ptr(current_fn, matched_id)):
                    fc_line = if has(prov, "line") then get_int(prov, "line") else (if has(node, "line") then get_int(node, "line") else 0)
                    fc_col = if has(prov, "col") then get_int(prov, "col") else 0
                    compile_error("orion: ERROR at {otir_where(fc_line, fc_col)} - field `{decl_name}` of `{struct_name}` is declared `{friendly_type(decl_field_type)}` but got a `{friendly_type(fld_val_ty)}` (a {fld_val_k} where a {fld_decl_k} was expected)")
        if matched_id is (0 - 1):
            # Field not written explicitly. With `{..source, ...}` read it from
            # the spread source (`source.field`); otherwise default to 0.
            if has(node, "spread"):
                sp_field_node = {"kind": "Field", "object": get(node, "spread"), "field": decl_name}
                sp_r = ast_expr_to_ir(current_fn, current_scope, sp_field_node)
                current_fn = sp_r.function
                current_scope = sp_r.scope
                matched_id = sp_r.id
            else:
                pr_default = ir_fn_push(current_fn, ir_iconst(0))
                current_fn = pr_default.function
                matched_id = pr_default.id
        value_ids = append(value_ids, matched_id)
    pr = ir_fn_push(current_fn, ir_struct_cons(struct_name, n_fields_decl, value_ids))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}


define ast_field_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    obj_node = get(node, "object")
    field_name = get(node, "field")
    # Special-case `EnumName.Variant` - obj is an Ident matching a known enum,
    # field is the variant. Lower to iconst(variant_index).
    edit handled_enum = false
    edit enum_result = ConvResult{function: fn_value, scope: scope, id: 0 - 1}
    obj_kind = get(obj_node, "kind")
    if obj_kind is "Ident":
        obj_name = get(obj_node, "name")
        var_idx = scope_lookup_enum_variant(scope, obj_name, field_name)
        if var_idx >= 0:
            handled_enum = true
            if enum_has_payloads(scope, obj_name):
                # Tagged union: `EnumName.Variant` used as a VALUE (no `(...)`)
                # builds the full struct (tag + zeroed payload slots), typed
                # struct:Enum - exactly like the `Variant(args)` MethodCall path.
                # Emitting a bare tag int here was the bug that made `Opt.None`
                # type as `int` and clash with `Opt.Some`.
                ev_want = variant_payload_count(scope, obj_name, field_name)
                if ev_want > 0:
                    ev_line = if has(node, "line") then get_int(node, "line") else 0
                    ev_col = if has(node, "col") then get_int(node, "col") else 0
                    compile_error("orion: ERROR at {otir_where(ev_line, ev_col)} - variant `{field_name}` takes {ev_want} value(s), got 0 (add `(...)`)")
                ev_spec = scope_lookup_data_spec(scope, obj_name)
                ev_slots = count_spec_fields(ev_spec) - 1
                edit ev_fields = [{"name": "tag", "value": {"kind": "Int", "value": int_to_text_helper(var_idx)}}]
                loop evi in 0 until ev_slots:
                    ev_fields = append(ev_fields, {"name": "p{evi}", "value": {"kind": "Int", "value": "0"}})
                ev_cons = {"kind": "StructCons", "name": obj_name, "fields": ev_fields}
                enum_result = ast_struct_cons_to_ir(fn_value, scope, ev_cons)
            else:
                # Plain enumeration (all zero-payload): the variant IS its
                # integer tag, usable in arithmetic (`Color.Red + Color.Blue`).
                pr = ir_fn_push(fn_value, ir_iconst(var_idx))
                enum_result = ConvResult{function: pr.function, scope: scope, id: pr.id}
    edit result = enum_result
    if not handled_enum:
        obj_r = ast_expr_to_ir(fn_value, scope, obj_node)
        obj_type = get_value_type(obj_r.function, obj_r.id)
        edit struct_name = ""
        obj_bytes = bytes_of(obj_type)
        n = length(obj_bytes)
        edit past_colon = 0
        loop ci in 0 until n:
            b = obj_bytes[ci]
            if past_colon is 1:
                single = text_of([b])
                struct_name = "{struct_name}{single}"
            else:
                if b is 58:
                    past_colon = 1
        spec = scope_lookup_data_spec(scope, struct_name)
        parts = parse_data_spec(spec)
        field_idx = find_field_index(parts, field_name)
        field_type = field_type_at(parts, field_idx)
        if field_idx < 0:
            line = if has(node, "line") then get_int(node, "line") else 0
            col = if has(node, "col") then get_int(node, "col") else 0
            compile_error("orion: ERROR at {otir_where(line, col)} - `{struct_name}` has no field `{field_name}`")
        pr_load = ir_fn_push(obj_r.function, ir_field_load(obj_r.id, field_idx, field_type))
        result = ConvResult{function: pr_load.function, scope: obj_r.scope, id: pr_load.id}
    result


define ast_map_lit_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    pairs = get_list(node, "pairs")
    n_pairs = length(pairs)
    edit current_fn = fn_value
    edit current_scope = scope
    edit pair_ids = []
    loop index in 0 until n_pairs:
        pair = pairs[index]
        key_text = get(pair, "key")
        val_node = get(pair, "value")
        # Emit const_str for key, walk value expr.
        pr_key = ir_fn_push(current_fn, ir_const_str(key_text))
        current_fn = pr_key.function
        val_r = ast_expr_to_ir(current_fn, current_scope, val_node)
        current_fn = val_r.function
        current_scope = val_r.scope
        pair_ids = append(pair_ids, pr_key.id)
        pair_ids = append(pair_ids, val_r.id)
    # The value type comes from the pairs, so get()/[] recover it later.
    # Empty map -> i64 (no values to mistype).
    #
    # Taking it from the FIRST pair alone assumed every map is homogeneous.
    # `{"kind": "Int", "count": 7}` then claimed `map:text` and `m["count"]`
    # read the int 7 as a pointer: an access violation at run time, with
    # nothing said at compile time. The compiler's own AST tables are all
    # mixed like this - they just never index them, they call get_int /
    # get_map / get_list, which say what the word is.
    #
    # So a map whose values disagree is `dyn` - the type this compiler
    # already uses for "the values are not knowable". Reads through the
    # typed readers keep working; `m[k]` and bare `get` refuse and say so.
    # An EMPTY literal says nothing about its values, so it must not claim
    # they are numbers. It used to, and a text read back out of one printed as
    # its pointer - `get(m, 7)` on `{}` answered 140695995932688.
    # `dyn` is the word for "not knowable", and `table of T` is how you say it.
    edit map_val_type = "dyn"
    if n_pairs > 0:
        map_val_type = get_value_type(current_fn, pair_ids[1])
        loop mixed_i in 1 until n_pairs:
            if get_value_type(current_fn, pair_ids[mixed_i * 2 + 1]) is not map_val_type:
                map_val_type = "dyn"
    pr = ir_fn_push(current_fn, ir_map_lit(pair_ids, map_val_type))
    ConvResult{function: pr.function, scope: current_scope, id: pr.id}


# `x as T` - numeric cast. Native ints are i64 (sized integer widths erase to
# i64 for now, so int<->int is a value passthrough); int<->float uses sitofp /
# fptosi. Width-exact sized integers are a native refinement; the wasm backend
# is width-exact where it matters.

# The sub-64 sized integer names. i64/u64 are NOT here: they are the storage
# itself, nothing to wrap to. (u64 values past 2^63 are not representable in
# the i64 storage - the same standing limit the wasm backend has.)
define is_sized_int_name(name: text) -> truth:
    name is "i8" or name is "u8" or name is "i16" or name is "u16" or name is "i32" or name is "u32" or name is "u64"

define sized_width(t: text) -> number:
    if t is "i8" or t is "u8":
        return 8
    if t is "i16" or t is "u16":
        return 16
    if t is "i32" or t is "u32":
        return 32
    0

# The type a two-sided integer op computes IN: a sized side captures a plain
# i64 side (that is how a literal takes the sized type in arithmetic), the
# wider of two sized sides wins, anything else means "leave it alone".
define sized_peer(lt: text, rt: text) -> text:
    lw = sized_width(lt)
    rw = sized_width(rt)
    if lw > 0 and (rw > 0 or rt is "i64"):
        return if rw > lw then rt else lt
    if rw > 0 and lt is "i64":
        return rt
    ""

# Wrap `id` to `tname`'s width, and TYPE the result as `tname` so the next
# op in a chain wraps too: unsigned masks with AND, signed sign-extends via
# shl+ashr by 64-width. The one shared wrap path - the cast below and every
# sized binary result go through here.
define otir_mask_to(fn_in: IRFn, id: number, tname: text) -> PushResult:
    w = sized_width(tname)
    if w is 0:
        return PushResult{function: fn_in, id: id}
    uns = tname is "u8" or tname is "u16" or tname is "u32"
    if uns:
        mask_val = if w is 8 then 255 else if w is 16 then 65535 else 4294967295
        pc = ir_fn_push(fn_in, ir_iconst(mask_val))
        ir_fn_push(pc.function, Inst{op: "bit_and", type_text: tname, value: 0, lhs: id, rhs: pc.id, name: "", args: []})
    else:
        sh = 64 - w
        pc = ir_fn_push(fn_in, ir_iconst(sh))
        ps = ir_fn_push(pc.function, ir_shl(id, pc.id))
        pc2 = ir_fn_push(ps.function, ir_iconst(sh))
        ir_fn_push(pc2.function, Inst{op: "shr", type_text: tname, value: 0, lhs: ps.id, rhs: pc2.id, name: "", args: []})

# `x as text` has to CONVERT. It used to fall through to the sized-integer
# mask below, which left an i64 that merely PRINTED like text: `length(i as
# text)` was refused as an int, and `3.5 as text` answered "3".
define ast_cast_to_text(inner: ConvResult) -> ConvResult:
    src = get_value_type(inner.function, inner.id)
    if src is "text":
        inner
    else:
        if src is "f64":
            pt = ir_fn_push(inner.function, ir_f64_to_text(inner.id))
            ConvResult{function: pt.function, scope: inner.scope, id: pt.id}
        else:
            pt = ir_fn_push(inner.function, ir_int_to_text(inner.id))
            ConvResult{function: pt.function, scope: inner.scope, id: pt.id}

define ast_cast_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    inner = ast_expr_to_ir(fn_value, scope, get_map(node, "expr"))
    tn = get_map(node, "type")
    tname = if get(tn, "kind") is "Named" then get(tn, "name") else "i64"
    to_float = tname is "f64" or tname is "float" or tname is "f32"
    src = get_value_type(inner.function, inner.id)
    if tname is "text":
        ast_cast_to_text(inner)
    else:
        if to_float:
            if src is "f64":
                inner
            else:
                pr = ir_fn_push(inner.function, ir_sitofp(inner.id))
                ConvResult{function: pr.function, scope: inner.scope, id: pr.id}
        else:
            # First get an i64 value (fptosi if the source is a float).
            edit base = inner
            if src is "f64":
                pr = ir_fn_push(inner.function, ir_fptosi(inner.id))
                base = ConvResult{function: pr.function, scope: inner.scope, id: pr.id}
            # Then narrow to a sized target's width (native ints are i64) - the
            # shared wrap path, which also TYPES the result as the target so
            # later arithmetic keeps wrapping.
            pm = otir_mask_to(base.function, base.id, tname)
            ConvResult{function: pm.function, scope: base.scope, id: pm.id}

public define ast_expr_to_ir(fn_value: IRFn, scope: Scope, node: table) -> ConvResult:
    kind = get(node, "kind")
    # `xs[i]` / `m[k]` is sugar for `xs[i]` (lists) or `get(m, k)` (maps).
    # Lower the container ONCE, then dispatch on its type and emit the accessor
    # directly - mirroring is_at / is_get's element typing. An earlier version
    # probed the container on a throwaway lowering and then re-lowered it inside
    # a synthesized Call; but ir_fn_push mutates the spine in place, so the
    # probe LEAKED (a side-effecting base ran twice) AND the probe's ident read
    # bumped the global move counter (a `move` base tripped a false use-after-
    # move). Lowering once kills both. Nested indexing (`xss[0][1]`) still falls
    # out: the inner Index lowers as this accessor's container. (The is_at
    # __env-capture special case can't arise here - captures lower as explicit
    # `__env[n]` calls, never `[]` syntax.)
    if kind is "Index":
        idx_obj = get(node, "object")
        idx_key = get(node, "index")
        obj_r = ast_expr_to_ir(fn_value, scope, idx_obj)
        key_r = ast_expr_to_ir(obj_r.function, obj_r.scope, idx_key)
        obj_type = get_value_type(key_r.function, obj_r.id)
        # A BARE `table` joins `dyn` here. It used to guess `text`, so
        # `based["next"]` on `{"token": <table>, "next": <number>}` read a
        # number as a pointer and the program died at 0xffffffffffffffff. A
        # guess that is right for one of four types is not a read.
        if obj_type is "dyn" or obj_type is "map" or (is_map_type(obj_type) and extract_map_val(obj_type) is "dyn"):
            # A map whose values are not all one type. `m[k]` has to name a
            # type to read the word as, and any guess is a wrong pointer some
            # of the time - which is a run-time access violation, not an
            # answer. The typed readers say what the word is.
            ix_line = if has(node, "line") then get_int(node, "line") else 0
            ix_col = if has(node, "col") then get_int(node, "col") else 0
            # The `table of T` hint belongs on BOTH ways in. An empty literal
            # is `dyn` - it says nothing about its values - and that is the
            # commonest way to get here: `edit counts = {}` then `counts[w]`.
            ix_bare = " (say it at the binding: `edit m: table of number = \{\}`, or `table of text` / `table of table`)"
            compile_error("orion: ERROR at {otir_where(ix_line, ix_col)} - this table's values are not known to be one type, so `t[k]` cannot know what it reads - use `get_int` / `get_map` / `get_list` / `get` to say which{ix_bare}")
        if is_map_type(obj_type):
            get_type = extract_map_val(obj_type)
            pr = ir_fn_push(key_r.function, ir_map_get(obj_r.id, key_r.id, get_type))
            return ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
        else:
            # `xs[i]` is `at(xs, i)` and has to demote a whole `number` index
            # the same way - `length(pts) / 2` is a real, because division is,
            # and it is a perfectly ordinary way to say how many pairs a list
            # holds. Without this the two spellings mean different things and
            # the IR comes out with a double where an index belongs.
            whole_r = demote_number_index(key_r)
            elem_type = extract_list_elem(obj_type)
            at_inst = ir_list_at(obj_r.id, whole_r.id)
            at_inst_typed = Inst{op: at_inst.op, type_text: elem_type, value: at_inst.value, lhs: at_inst.lhs, rhs: at_inst.rhs, name: at_inst.name, args: at_inst.args}
            pr = ir_fn_push(whole_r.function, at_inst_typed)
            return ConvResult{function: pr.function, scope: whole_r.scope, id: pr.id}
    is_block = kind is "Block"
    is_int = kind is "Int"
    is_float_lit = kind is "Float"
    is_str = kind is "Str"
    is_binary = kind is "Binary"
    is_ident = kind is "Ident"
    is_call = kind is "Call"
    is_if = kind is "If"
    is_unary = kind is "Unary"
    is_cast = kind is "Cast"
    is_list_lit = kind is "ListLit"
    is_tuple = kind is "Tuple"
    is_map_lit = kind is "MapLit"
    is_match = kind is "Match"
    is_struct_cons = kind is "StructCons"
    is_field = kind is "Field"
    is_method_call = kind is "MethodCall"
    is_question = kind is "Question"
    is_perform = kind is "Perform"
    is_make_closure = kind is "MakeClosure"
    edit result = ConvResult{function: fn_value, scope: scope, id: 0 - 1}
    if is_make_closure:
        # Lambda closure: lower each captured expr, then pack [fn_ptr, 1, caps].
        # Record each capture's type-code (0 int / 1 text / 2 list / 3 map) so
        # __lambda_N's prologue reads it back with the right type - the env list
        # itself is i64, so a text/list/map capture must be re-typed on read.
        mc_caps = get_list(node, "caps")
        # A lifted lambda is an ordinary fn decl, so it is emitted under its
        # orb's scope like any other; the closure must take the same name or it
        # points at a symbol that does not exist.
        mc_fn_name = otir_resolve(get(node, "fn"))
        edit mc_fn = fn_value
        edit mc_scope = scope
        edit mc_cap_ids = part([0], 0, 0)
        loop mci in 0 until length(mc_caps):
            mc_cap_r = ast_expr_to_ir(mc_fn, mc_scope, mc_caps[mci])
            mc_fn = mc_cap_r.function
            mc_scope = mc_cap_r.scope
            mc_cap_ids = append(mc_cap_ids, mc_cap_r.id)
            slot_set("clos:{mc_fn_name}:capty:{mci}", cap_type_code(get_value_type(mc_fn, mc_cap_r.id)))
        pr_mc = ir_fn_push(mc_fn, ir_make_closure(mc_fn_name, mc_cap_ids, 1))
        result = ConvResult{function: pr_mc.function, scope: mc_scope, id: pr_mc.id}
    if is_block:
        result = ast_block_to_ir(fn_value, scope, node)
    if is_int:
        result = ast_int_to_ir(fn_value, scope, node)
    if is_float_lit:
        result = ast_float_to_ir(fn_value, scope, node)
    if is_str:
        result = ast_str_to_ir(fn_value, scope, node)
    if is_list_lit:
        result = ast_list_lit_to_ir(fn_value, scope, node)
    if is_tuple:
        result = ast_tuple_to_ir(fn_value, scope, node)
    if is_map_lit:
        result = ast_map_lit_to_ir(fn_value, scope, node)
    if is_match:
        result = ast_match_to_ir(fn_value, scope, node)
    if is_struct_cons:
        result = ast_struct_cons_to_ir(fn_value, scope, node)
    if is_field:
        result = ast_field_to_ir(fn_value, scope, node)
    if is_binary:
        result = ast_binop_to_ir(fn_value, scope, node)
    if is_ident:
        result = ast_ident_to_ir(fn_value, scope, node)
    if is_call:
        result = ast_call_to_ir(fn_value, scope, node)
    if is_if:
        result = ast_if_to_ir(fn_value, scope, node)
    if is_unary:
        result = ast_unary_to_ir(fn_value, scope, node)
    if is_cast:
        result = ast_cast_to_ir(fn_value, scope, node)
    if is_method_call:
        method = get(node, "method")
        receiver = get(node, "receiver")
        m_args = get_list(node, "args")
        # Sum type constructor sugar - `EnumName.Variant(arg)` becomes
        # EnumName{tag: idx, val_int: arg, val_text: ""} (or val_text: arg).
        # Detect when receiver is an Ident matching a known enum_name.
        edit is_enum_cons = false
        edit enum_name = ""
        edit variant_idx = 0 - 1
        if get(receiver, "kind") is "Ident":
            rcv_name = get(receiver, "name")
            v_idx = scope_lookup_enum_variant(scope, rcv_name, method)
            if v_idx >= 0:
                is_enum_cons = true
                enum_name = rcv_name
                variant_idx = v_idx
        if is_enum_cons:
            # Arity check - the qualified `EnumName.Variant(...)` form used to
            # silently DROP extra args (the loop below only fills declared
            # slots), so `R.Ok(5)` on `enum R: Ok, Err` dropped the 5 and only
            # a downstream match arm complained. Point at the construction.
            # (The bare-variant path in ast_call_to_ir checks the same way.)
            ec_want = variant_payload_count(scope, enum_name, method)
            ec_got = length(m_args)
            if ec_got is not ec_want:
                ec_line = if has(node, "line") then get_int(node, "line") else 0
                ec_col = if has(node, "col") then get_int(node, "col") else 0
                compile_error("orion: ERROR at {otir_where(ec_line, ec_col)} - variant `{method}` takes {ec_want} value(s), got {ec_got}")
            # A PLAIN enum (no variant carries a payload) IS its tag int - that
            # is what `Enum.Variant` lowers to in ast_field_to_ir. This path is
            # also where a BARE variant ident lands (`ORI` desugars to a
            # zero-arg `Seam.ORI` method call), and it used to build a struct
            # regardless, so the two spellings of one value had two different
            # runtime representations: a struct here, an int there. Emit the tag.
            ec_plain = not enum_has_payloads(scope, enum_name)
            if ec_plain:
                pr_tag = ir_fn_push(fn_value, ir_iconst(variant_idx))
                result = ConvResult{function: pr_tag.function, scope: scope, id: pr_tag.id}
            if not ec_plain:
                # Positional payload slots: arg i → field p{i}. Unused slots
                # up to the enum's synthesized width pad with zero (the width
                # comes from the registered ds spec's field count - 1).
                spec = scope_lookup_data_spec(scope, enum_name)
                n_slots = count_spec_fields(spec) - 1
                zero_int = {"kind": "Int", "value": "0"}
                edit cons_fields = [{"name": "tag", "value": {"kind": "Int", "value": int_to_text_helper(variant_idx)}}]
                # A payload slot holds one i64 word, and a REAL payload lives
                # there as its bit pattern. So a whole value handed to a real
                # slot has to be promoted first - `V(41)` into a `V(float)`
                # stored the integer 41 and read it back as a double's bits,
                # which is 2.02e-322 rather than 41. An ordinary call has
                # promoted its arguments all along; this path never asked what
                # the slot was declared to hold.
                pl_spec = scope_lookup_variant_payloads(scope, enum_name, method)
                pl_types = split_csv(pl_spec)
                n_cargs = length(m_args)
                loop pfi in 0 until n_slots:
                    edit pf_val = if pfi < n_cargs then m_args[pfi] else zero_int
                    wants_real = pfi < length(pl_types) and pl_types[pfi] is "f64"
                    if wants_real and pfi < n_cargs:
                        pf_val = {"kind": "Cast", "expr": pf_val, "type": {"kind": "Named", "name": "float"}}
                    # And the other way, which is the one `number` made
                    # common: a real into a slot declared whole stored the
                    # DOUBLE'S BITS. `DrawText(point, words, ink, size, src)`
                    # with a size of 20.0 came back as 4626885667169763328,
                    # and the painter tried to raster a letter that big.
                    wants_whole = pfi < length(pl_types) and pl_types[pfi] is "i64"
                    if wants_whole and pfi < n_cargs:
                        pf_val = {"kind": "Cast", "expr": pf_val, "type": {"kind": "Named", "name": "int"}}
                    cons_fields = append(cons_fields, {"name": "p{pfi}", "value": pf_val})
                cons_node = {"kind": "StructCons", "name": enum_name, "fields": cons_fields}
                result = ast_struct_cons_to_ir(fn_value, scope, cons_node)
        else:
            # Dictionary / trait call: `o.method(args)` where `method` is a
            # fn-TYPED field of the receiver struct calls THAT field's value,
            # not a global `method(o, args)`. This is what makes a struct-of-
            # functions (a trait dictionary you pass explicitly) callable like
            # methods. Only for an Ident receiver, so the field type is read
            # from scope without re-evaluating a side-effecting expression;
            # anything else falls through to the UFCS desugar below unchanged.
            edit did_field_call = false
            if get(receiver, "kind") is "Ident":
                rcv_id = scope_lookup(scope, get(receiver, "name"))
                if rcv_id >= 0:
                    rcv_ty = get_value_type(fn_value, rcv_id)
                    if concrete_ptr_kind(rcv_ty) is "struct":
                        fparts = parse_data_spec(scope_lookup_data_spec(scope, strip_struct_prefix(rcv_ty)))
                        fidx = find_field_index(fparts, method)
                        if fidx >= 0 and field_type_at(fparts, fidx) is "fn":
                            pr_fld = ir_fn_push(fn_value, ir_field_load(rcv_id, fidx, "fn"))
                            edit cf_fn = pr_fld.function
                            edit cf_scope = scope
                            edit cf_args = []
                            loop cfi in 0 until length(m_args):
                                a_r = ast_expr_to_ir(cf_fn, cf_scope, m_args[cfi])
                                cf_fn = a_r.function
                                cf_scope = a_r.scope
                                cf_args = append(cf_args, a_r.id)
                            fld_key = "otir:fldfn:{slot_int_or_zero(\"otir:ep\")}:{strip_struct_prefix(rcv_ty)}:{method}"
                            cf_ret = if slot_has(fld_key) then otir_ret_storage(slot_get(fld_key)) else "i64"
                            pr_cc = ir_fn_push(cf_fn, ir_closure_call(pr_fld.id, cf_args, cf_ret))
                            result = ConvResult{function: pr_cc.function, scope: cf_scope, id: pr_cc.id}
                            did_field_call = true
            if not did_field_call:
                edit new_args_list = [receiver]
                n_m_args = length(m_args)
                loop ami in 0 until n_m_args:
                    new_args_list = append(new_args_list, m_args[ami])
                line = if has(node, "line") then get_int(node, "line") else 0
                col = if has(node, "col") then get_int(node, "col") else 0
                call_node = {"kind": "Call", "callee": method, "args": new_args_list, "line": line, "col": col}
                result = ast_call_to_ir(fn_value, scope, call_node)
    # Catch SILENT dispatch failures: only fire if NONE of the kind checks
    # matched (handled dispatchers legitimately return id=-1 for void blocks).
    if is_question:
        # `expr?` desugars to:
        #   tmp = expr
        #   if tmp.tag is not 0: return tmp
        #   tmp.val_int   ; the resulting expression value
        inner = get(node, "inner")
        inner_r = ast_expr_to_ir(fn_value, scope, inner)
        tmp_id = inner_r.id
        edit cur_fn = inner_r.function
        # Load tag
        pr_tag = ir_fn_push(cur_fn, ir_field_load(tmp_id, 0, "i64"))
        cur_fn = pr_tag.function
        # iconst 0 for compare
        pr_zero = ir_fn_push(cur_fn, ir_iconst(0))
        cur_fn = pr_zero.function
        pr_ne = ir_fn_push(cur_fn, ir_icmp_ne(pr_tag.id, pr_zero.id))
        cur_fn = pr_ne.function
        # Branch to return-tmp block or continue
        n_q = length(cur_fn.instructions)
        ret_lbl = "q_{n_q}_ret"
        cont_lbl = "q_{n_q}_cont"
        pr_br = ir_fn_push(cur_fn, ir_br_if(pr_ne.id, ret_lbl, cont_lbl))
        cur_fn = pr_br.function
        # Return-tmp block
        pr_ret_lbl = ir_fn_push(cur_fn, ir_label(ret_lbl))
        cur_fn = pr_ret_lbl.function
        pr_ret = ir_fn_push(cur_fn, ir_return(tmp_id))
        cur_fn = pr_ret.function
        # Continue block - unwrap the success payload (field 1). Type it from
        # the enum's tag-0 variant's DECLARED payload, not a bare i64: a
        # Result[text]/[list]/[map] carries a pointer there, and reading it as
        # i64 leaked the raw pointer into downstream text/concat/field use.
        # Falls back to i64 when the operand's enum can't be resolved.
        pr_cont_lbl = ir_fn_push(cur_fn, ir_label(cont_lbl))
        cur_fn = pr_cont_lbl.function
        q_enum = strip_struct_prefix(get_value_type(cur_fn, tmp_id))
        edit q_payload_type = "i64"
        q_ok_variant = enum_first_variant(scope, q_enum)
        if q_ok_variant is not "":
            q_payloads = split_csv(scope_lookup_variant_payloads(scope, q_enum, q_ok_variant))
            if length(q_payloads) > 0:
                q_payload_type = q_payloads[0]
        pr_val = ir_fn_push(cur_fn, ir_field_load(tmp_id, 1, q_payload_type))
        result = ConvResult{function: pr_val.function, scope: inner_r.scope, id: pr_val.id}
    if is_perform:
        # `perform Effect.op(arg)` lowers to a setjmp-protected call so
        # the handler can `resume_int(value)` to come back here with that
        # value. The handler is a regular fn named __handler_Effect_op;
        # one-shot only (single resume per perform).
        effect_name = get(node, "effect")
        op_name = get(node, "op")
        handler_name = "__handler_{effect_name}_{op_name}"
        perf_args = get_list(node, "args")
        n_pa = length(perf_args)
        edit cur_fn = fn_value
        edit cur_scope = scope
        # EVERY argument is lowered and passed. This used to keep the first and
        # evaluate-then-drop the rest, so `perform Math.add(40, 2)` handed the
        # handler one argument and read register garbage for the other: it
        # returned 248 instead of 42, with no error.
        edit perf_arg_ids = part([0], 0, 0)
        loop pi in 0 until n_pa:
            arg_node = perf_args[pi]
            arg_r = ast_expr_to_ir(cur_fn, cur_scope, arg_node)
            cur_fn = arg_r.function
            cur_scope = arg_r.scope
            perf_arg_ids = append(perf_arg_ids, arg_r.id)
        # The runtime casts the handler to one of five arities (0..4).
        if n_pa > 4:
            pf_line = if has(node, "line") then get_int(node, "line") else 0
            pf_col = if has(node, "col") then get_int(node, "col") else 0
            compile_error("orion: ERROR at {otir_where(pf_line, pf_col)} - `perform {effect_name}.{op_name}` passes {n_pa} arguments; an effect operation takes at most 4")
        # Pick perform_int vs perform_text based on handler's return type.
        # Defaults to int when the handler isn't declared (compile error
        # will surface elsewhere).
        # A handler is an ordinary fn, so it is orb-local unless declared `pub`:
        # resolve the synthesized `__handler_<Effect>_<op>` the same way a call
        # resolves, or a private handler is emitted mangled and never found.
        handler_g = otir_resolve(handler_name)
        handler_ret = scope_lookup_fn_ret_loc(cur_scope, handler_g, node)
        # Arity against the HANDLER's declared parameters. A mismatch is the
        # same silent-garbage class as above (the handler reads a parameter that
        # was never passed), and the registry is already there for calls.
        pf_arity_key = "otir:arity:" + handler_g
        if slot_has(pf_arity_key):
            pf_want = slot_get_number(pf_arity_key)
            if n_pa is not pf_want:
                pfa_line = if has(node, "line") then get_int(node, "line") else 0
                pfa_col = if has(node, "col") then get_int(node, "col") else 0
                compile_error("orion: ERROR at {otir_where(pfa_line, pfa_col)} - `{effect_name}.{op_name}` is handled with {pf_want} parameter(s), got {n_pa}")
        # An effect's ARGUMENTS ride in 64-bit word slots, all four of them.
        # A real one fits exactly: it goes in as its BITS and the handler reads
        # it back (`param_bits`). Both sides are 64 bits, so nothing is lost.

        # Which carrier the effect answers over, from what the HANDLER is
        # declared to answer with. A `handle` block is an ordinary `Fn` by the
        # time this runs, so `number` there was already settled by the pass.
        use_text = handler_ret is "text"
        use_real = handler_ret is "f64"
        if use_text:
            pr_perf = ir_fn_push(cur_fn, ir_perform_text(handler_g, perf_arg_ids))
            result = ConvResult{function: pr_perf.function, scope: cur_scope, id: pr_perf.id}
        if use_real:
            pr_perf = ir_fn_push(cur_fn, ir_perform_real(handler_g, perf_arg_ids))
            result = ConvResult{function: pr_perf.function, scope: cur_scope, id: pr_perf.id}
        if (not use_text) and (not use_real):
            pr_perf = ir_fn_push(cur_fn, ir_perform_int(handler_g, perf_arg_ids))
            result = ConvResult{function: pr_perf.function, scope: cur_scope, id: pr_perf.id}
    any_match = is_block or is_int or is_float_lit or is_str or is_binary or is_ident or is_call or is_if or is_unary or is_cast or is_list_lit or is_tuple or is_map_lit or is_match or is_struct_cons or is_field or is_method_call or is_question or is_perform or is_make_closure
    if not any_match:
        line = if has(node, "line") then get_int(node, "line") else 0
        col = if has(node, "col") then get_int(node, "col") else 0
        # A parser `Error` node means the token was not the start of anything the
        # language has. Say WHICH token: "unhandled AST node kind `Error`" named
        # a compiler internal, so `x |> f` and `|x| x + 1` (neither is Orion
        # syntax) both reported the same thing, at line 0:0.
        found = if has(node, "found") then get(node, "found") else ""
        # A parser Error may carry its own explanation (`why`); that is more
        # specific than the generic "not valid here" and wins.
        why = if has(node, "why") then get(node, "why") else ""
        if kind is "Error" and why is not "":
            compile_error("orion: ERROR at {otir_where(line, col)} - {why}")
        if kind is "Error" and why is "":
            # The hint has to fit the token. Naming the pipe and the lambda for
            # every unexpected byte (a stray `:`, say) is noise that sends the
            # reader looking in the wrong place.
            hint = if found is "|" then " (Orion has one lambda form, `function(x): body`, and no pipe operator)" else (if found is ":" then " (a match arm is `Pattern -> value`; `:` opens a block after `if`/`loop`/`fn`)" else "")
            compile_error("orion: ERROR at {otir_where(line, col)} - `{found}` is not valid here, an expression was expected{hint}")
        if kind is not "Error":
            compile_error("orion: ERROR at {otir_where(line, col)} - unhandled AST node kind `{kind}` (emit iconst 0 as fallback)")
        pr_fallback = ir_fn_push(fn_value, ir_iconst(0))
        result = ConvResult{function: pr_fallback.function, scope: scope, id: pr_fallback.id}
    result


# Closure capture type-codes: 0 = i64/int, 1 = text, 2 = list, 3 = map.
# Anything else (struct etc.) falls back to 0 (read as i64).
define cap_type_code(t: text) -> number:
    edit code = 0
    if t is "text":
        code = 1
    if is_list_type(t):
        code = 2
    if t is "map":
        code = 3
    code

define cap_code_type(code: number) -> text:
    edit t = "i64"
    if code is 1:
        t = "text"
    if code is 2:
        t = "list:i64"
    if code is 3:
        t = "map"
    t


# Map a parser type-node to an IR type string ("text" / "list" / "i64").
# Given a "list:T" encoding, return T. Fallback "i64" for plain "list".
define is_list_type(type_text: text) -> truth:
    if type_text is "list":
        true
    else:
        bs = bytes_of(type_text)
        n = length(bs)
        if n >= 5:
            bs[0] is 108 and bs[1] is 105 and bs[2] is 115 and bs[3] is 116 and bs[4] is 58
        else:
            false

define extract_list_elem(type_text: text) -> text:
    bs = bytes_of(type_text)
    n = length(bs)
    edit is_param = false
    if n >= 5:
        if bs[0] is 108 and bs[1] is 105 and bs[2] is 115 and bs[3] is 116 and bs[4] is 58:
            is_param = true
    if not is_param:
        "i64"
    else:
        edit result = ""
        loop ci in 5 until n:
            single = text_of([bs[ci]])
            result = "{result}{single}"
        result

# ---- generic call-site instantiation (types only) ---------------------
#
# Generics are ERASED: inside `define filter<T>(xs: [T], pred: function) -> [T]` the type
# var lowers to an i64 slot, and the declared return `[T]` lowers with it. So a
# call site got `list:i64` back and every element read out of the result was an
# int: `keep(words, p)[0]` produced an int where the text was, and `len`
# on it failed. Erasure is right for CODE (one body serves every T), but the
# call site knows more than the body does: it can see the actual argument types.
#
# So: bind each type var by matching the DECLARED source types against the
# ACTUAL argument IR types, then re-type the call's result. Types only, no new
# code and no new syntax - the runtime representation is unchanged (a list of
# text pointers and a list of ints are both i64 slots), this just stops the
# compiler from forgetting which one it is.
#
# Source types are recorded as text by the signature pass: "T", "[T]", "int".

# Render an AST type node the way the instantiation matcher reads it.
define type_src_text(type_node: table) -> text:
    kind = get(type_node, "kind")
    if kind is "List":
        inner = type_src_text(get(type_node, "elem"))
        "[{inner}]"
    else:
        if kind is "Named":
            get(type_node, "name")
        else:
            ""

# Index of `name` in the type-var list, or -1.
define tv_slot(gens: [text], name: text) -> number:
    edit found = 0 - 1
    loop i in 0 until length(gens):
        if gens[i] is name:
            found = i
    found

# "[X]" -> "X"; anything else -> "".
define strip_brackets(s: text) -> text:
    bs = bytes_of(s)
    n = length(bs)
    edit wrapped = false
    if n >= 3:
        if bs[0] is 91 and bs[n - 1] is 93:
            wrapped = true
    if not wrapped:
        ""
    else:
        edit inner = ""
        loop ci in 1 until (n - 1):
            inner = inner + text_of([bs[ci]])
        inner

# Match one declared source type against one actual IR type, binding type vars.
# `binds` is parallel to `gens`; "" means still unbound. First binding wins.
define tv_unify(src: text, actual: text, gens: [text], binds: [text]) -> [text]:
    edit out = binds
    inner_src = strip_brackets(src)
    if inner_src is not "":
        # `[X]` against `list:E` - recurse on the element.
        if is_list_type(actual):
            out = tv_unify(inner_src, extract_list_elem(actual), gens, out)
    else:
        slot = tv_slot(gens, src)
        if slot >= 0:
            if out[slot] is "":
                out = set(out, slot, actual)
    out

# Substitute bound type vars into a declared source type, producing an IR type.
# "" means "nothing to substitute" - the caller keeps the erased type.
define tv_subst(src: text, gens: [text], binds: [text]) -> text:
    inner_src = strip_brackets(src)
    if inner_src is not "":
        inner_ir = tv_subst(inner_src, gens, binds)
        if inner_ir is "":
            ""
        else:
            "list:{inner_ir}"
    else:
        slot = tv_slot(gens, src)
        if slot < 0:
            ""
        else:
            binds[slot]

# Is this IR type pointer-shaped in the emitted module? (An i64 slot holding a
# refined pointer type needs an explicit re-type; a refined `int`/`f64` does not
# and must not get one.)
# A whole number in a machine register. `truth` is one of these: it is stored
# as an i64 and travels like one, and every place that asks this question means
# "a scalar I can widen, demote or branch on", never "the integer type".
define is_whole_ir(t: text) -> truth:
    t is "i64" or t is "truth" or is_sized_int_name(t)

# Is this the synthesized function behind a `handle` block? The name is the
# marker: `__handler_<Effect>_<op>`, made in the parser.
define otir_is_handler(n: text) -> truth:
    # CONTAINS, not starts-with: by the time a function is being lowered its
    # name carries the orb it came from - `prog____handler_drawing_line`. The
    # same stamp that made the closure ABI look broken for three rounds.
    contains(n, "__handler_")

define is_ptr_ir_type(t: text) -> truth:
    if t is "text" or t is "fn":
        true
    else:
        if is_list_type(t) or is_map_type(t):
            true
        else:
            strip_struct_prefix(t) is not t

# The result type of a call to a generic fn, given the actual argument types.
# Returns the erased type unchanged for a non-generic callee, for a return type
# that names no type var, or when the arguments do not pin the var down.
define otir_call_ret_generic(fn_name: text, arg_types: [text], erased_ret: text) -> text:
    gen_key = "otir:gen:" + fn_name
    ret_key = "otir:rsrc:" + fn_name
    edit out = erased_ret
    if slot_has(gen_key) and slot_has(ret_key):
        gens = split_csv(slot_get(gen_key))
        edit binds = part([""], 0, 0)
        loop gi in 0 until length(gens):
            binds = append(binds, "")
        loop ai in 0 until length(arg_types):
            p_key = "otir:psrc:" + fn_name + ":{ai}"
            if slot_has(p_key):
                binds = tv_unify(slot_get(p_key), arg_types[ai], gens, binds)
        instantiated = tv_subst(slot_get(ret_key), gens, binds)
        if instantiated is not "":
            out = instantiated
    out

# The concrete pointer SHAPE for the return-type guard: "text", "list" or
# "struct", or "" for a WILDCARD kind (map, fn, int, float, generic/unknown)
# that the guard must not diff. All pointer shapes share i64 storage, so the
# old i64/ptr bucket check can't tell them apart - yet returning a Text where a
# struct is declared (or a list where a Text is) is a real, silent bug. This
# discriminates the three concrete shapes while leaving `map` as the deliberate
# dynamic escape (map <-> anything never triggers the guard), which is what
# keeps the stringly-typed self-host compiler and the boxed-Map ECS compiling.
define concrete_ptr_kind(t: text) -> text:
    if t is "text":
        "text"
    else if is_list_type(t):
        "list"
    else:
        bs = bytes_of(t)
        n = length(bs)
        edit is_struct = false
        if n >= 7:
            if bs[0] is 115 and bs[1] is 116 and bs[2] is 114 and bs[3] is 117 and bs[4] is 99 and bs[5] is 116 and bs[6] is 58:
                is_struct = true
        if is_struct then "struct" else ""

# The return type to hand a closure_call so its ABI matches how the value is
# actually returned, normalized to one of three storage classes. Mirrors the
# emitter's `llvm_type_of` (which lives in another orb and cannot be called from
# here): `f64` returns in a float register, pointer types (text/list/map/dyn/
# struct/fn) in an integer register carrying a real pointer, and everything else
# (int, bool, sized ints, erased type vars) is a plain i64. Forwarding the raw
# declared type unnormalized was the bug that turned `truth` into `i1`; a pointer
# type is kept as-is so the result still knows it is a text/list for `.field`
# and `len`, while non-pointer scalars all collapse to `i64`.
define otir_ret_storage(t: text) -> text:
    if t is "f64":
        "f64"
    else:
        bs = bytes_of(t)
        edit is_struct = false
        if length(bs) >= 7:
            if bs[0] is 115 and bs[1] is 116 and bs[2] is 114 and bs[3] is 117 and bs[4] is 99 and bs[5] is 116 and bs[6] is 58:
                is_struct = true
        is_ptr = t is "text" or t is "list" or t is "map" or t is "dyn" or t is "ptr" or t is "fn" or is_struct or is_list_type(t) or is_map_type(t)
        if is_ptr then t else "i64"

# True when a value's static type is UNRELIABLE because it came from a dynamic,
# untyped getter: slot_get returns "text" for what is really an untyped pointer
# (the whole slot store is dynamically typed), and map get/get_or read a dynamic
# container. Traced through phi merges so `if slot_has(k) then slot_get(k) else
# []` counts as unreliable. The subtype return guard skips these - only a value
# with a trustworthy static shape (a literal, a constructor, a typed getter like
# get_list/get_int) is worth diffing against the declared return type. Recurses
# only into strictly-earlier value ids so it always terminates.
define is_unreliable_ptr(fn_value: IRFn, value_id: number) -> truth:
    if value_id < 0:
        false
    else:
        inst = fn_value.instructions[value_id]
        op = inst.op
        if op is "slot_get" or op is "map_get" or op is "map_get_or":
            true
        else if op is "phi":
            (inst.lhs < value_id and is_unreliable_ptr(fn_value, inst.lhs)) or (inst.rhs < value_id and is_unreliable_ptr(fn_value, inst.rhs))
        else:
            false

# True for `map` or a value-typed `map:<T>`.
define is_map_type(type_text: text) -> truth:
    # `dyn` is the element type of an UNANNOTATED `get_list(m, k)`: the map is
    # dynamic, so the compiler cannot know what its values are. It behaves like
    # `map` everywhere (so reading it back as a map still works, and the whole
    # AST-walking machinery is untouched) EXCEPT that `len` on it refuses rather
    # than silently doing a MAP length on what might be a text - the one place
    # the ambiguity produces a wrong answer. Annotating the read (`ys: [text] =
    # get_list(m, k)`) resolves it.
    if type_text is "map" or type_text is "dyn":
        true
    else:
        bs = bytes_of(type_text)
        n = length(bs)
        if n >= 4:
            bs[0] is 109 and bs[1] is 97 and bs[2] is 112 and bs[3] is 58
        else:
            false

# The value type from a `map:<T>` type_text. Bare `map` (or non-map) yields
# `text` - the historic default for untyped maps.
define extract_map_val(type_text: text) -> text:
    bs = bytes_of(type_text)
    n = length(bs)
    edit is_param = false
    if n >= 4:
        if bs[0] is 109 and bs[1] is 97 and bs[2] is 112 and bs[3] is 58:
            is_param = true
    if not is_param:
        "text"
    else:
        edit result = ""
        loop ci in 4 until n:
            single = text_of([bs[ci]])
            result = "{result}{single}"
        result

# Render an internal type name in the user's terms for error messages:
# i64 -> int, f64 -> float, list:T -> [T], struct:Foo -> Foo, void -> nothing.
# `prog__broken` -> `broken`. Function names are mangled with their orb so two
# orbs can each keep a private helper of the same name; that prefix is the
# compiler's business, and printing it in a diagnostic shows the reader a name
# that appears nowhere in their file.
define friendly_fn_name(n: text) -> text:
    b = bytes_of(n)
    total = length(b)
    edit cut = 0
    loop i in 0 until total:
        if i + 1 < total:
            if b[i] is 95 and b[i + 1] is 95:
                cut = i + 2
    if cut is 0:
        n
    else:
        text_of(bytes_part(b, cut, total))

# The word a PERSON writes, for a message a person reads. `number` is the only
# numeric word in the surface (ORION.md: "number is the word a person writes;
# i64 or f64 is what the machine gets"), so an error that says `int` answers a
# question nobody asked and names a type the language does not have.
#
# No message can ever compare i64 against f64 - the return guard buckets by
# i64-vs-pointer and exempts f64 - so collapsing both to `number` cannot make
# an error read "declared number but returns number".
# Does this body leave through `resume`? Used to tell a handler - which cannot
# answer, because control has gone back to the perform site - from a function
# that simply forgot to.
define otir_tail_resumes(node: table) -> truth:
    k = get(node, "kind")
    if k is "Call":
        return get(node, "callee") is "resume"
    if k is "ExprStmt":
        return otir_tail_resumes(get_map(node, "expr"))
    if k is "Block":
        stmts = get_list(node, "stmts")
        if length(stmts) is 0:
            return false
        return otir_tail_resumes(stmts[length(stmts) - 1])
    if k is "IfBlock":
        els = get_map(node, "else")
        if get(els, "kind") is not "Block" and get(els, "kind") is not "IfBlock":
            return false
        return otir_tail_resumes(get_map(node, "then")) and otir_tail_resumes(els)
    if k is "If":
        return otir_tail_resumes(get_map(node, "then")) and otir_tail_resumes(get_map(node, "else"))
    false

define friendly_type(t: text) -> text:
    if t is "truth":
        "truth"
    else if t is "i64":
        "number"
    else if t is "f64":
        "number"
    else if t is "void" or t is "Unit":
        "nothing"
    else if is_list_type(t):
        "[{friendly_type(extract_list_elem(t))}]"
    else if is_map_type(t):
        "map"
    else:
        # struct:Foo -> Foo; text / fn / ptr pass through unchanged.
        fb = bytes_of(t)
        fn2 = length(fb)
        edit is_struct = false
        if fn2 >= 7:
            if fb[0] is 115 and fb[1] is 116 and fb[2] is 114 and fb[3] is 117 and fb[4] is 99 and fb[5] is 116 and fb[6] is 58:
                is_struct = true
        if is_struct:
            edit r = ""
            loop fi in 7 until fn2:
                # Temp var, NOT `[fb[fi]]` inline: a list literal inside a
                # `{...}` interpolation trips older self-host compilers during
                # bootstrap (the interpolation splitter mis-tokenizes the `[`
                # and `)`), which stalls the whole self-host chain.
                one = [fb[fi]]
                r = "{r}{text_of(one)}"
            r
        else:
            t


define ast_type_to_ir(type_node: table) -> text:
    kind = get(type_node, "kind")
    # Range types (`0...255`) erase to i64 - refinement checking is a
    # future pass. Also guard nodes without a name field: a missing map
    # key is a null ptr natively, and strcmp(null) segfaults.
    if kind is "Range":
        return "i64"
    # `function(T) -> R` - a spelled-out function type. Erases to the same "fn"
    # ptr as a bare `fn`; the signature lives in the AST for typeck only.
    if kind is "FnType":
        return "fn"
    # `(A, B, ...)` - a tuple type. Same synthesized anon-struct as the tuple
    # literal, so `(int, text)` and `(1, "hi")` share a representation.
    if kind is "TupleType":
        tt_elems = get_list(type_node, "elems")
        tt_types = part([""], 0, 0)
        edit tt_type_list = tt_types
        loop tti in 0 until length(tt_elems):
            tt_type_list = append(tt_type_list, ast_type_to_ir(tt_elems[tti]))
        return "struct:{otir_tuple_register(tt_type_list)}"
    if not has(type_node, "name"):
        if kind is not "List":
            return "i64"
    if kind is "List":
        elem_node = get(type_node, "elem")
        elem = ast_type_to_ir(elem_node)
        "list:{elem}"
    else:
        name = get(type_node, "name")
        # Generic type variable (`T` in `type Result<T, E>: ...`) lowers to an
        # opaque pointer-sized slot (i64), same as fn generics. Registered via
        # the tvgen counter (see otir_bind_tyvars).
        tv_gen_nc = slot_int_or_zero("otir:tvgen")
        if tv_gen_nc > 0 and slot_int_or_zero(otir_k1("tv", name)) is tv_gen_nc:
            return "i64"
        if name is "Text":
            compile_error("orion: ERROR - the type is written `text` now (`Text` was retired)")
        if name is "bool" or name is "Bool":
            compile_error("orion: ERROR - the truth type is written `truth` now (`bool` was retired)")
        # `int` WRITTEN IN SOURCE (the parser marks those; the compiler's own
        # synthesized int nodes carry no mark, and `external define` names a C
        # type, so neither is touched).
        if has(type_node, "said_int"):
            compile_error("orion: ERROR at {otir_where(get_int(type_node, \"line\"), get_int(type_node, \"col\"))} - the whole-number type is written `number` now (`int` was retired)")
        # `truth` is its own IR type. It IS an i64 in the machine - every type
        # `llvm_type_of` does not recognise lands there - but a function that
        # answers `truth` and one that answers a number are now different, and
        # that difference is what lets the surface print `true`.
        if name is "truth":
            "truth"
        else if name is "text":
            "text"
        else:
            if name is "Map":
                compile_error("orion: ERROR - the key-value type is written `table` now (`Map` was retired)")
            if name is "map" or name is "table":
                # `table<T>` - the VALUE type, carried as `map:T`. A bare `table`
                # holds anything, which is why reading out of one had to guess
                # (and guessed `map`, so a text element got a map's length). The
                # IR already understood `map:T` and `get` already read it; there
                # was just no way to SAY it in source.
                m_args = if has(type_node, "args") then get_list(type_node, "args") else []
                if length(m_args) is 1:
                    "map:{ast_type_to_ir(m_args[0])}"
                else:
                    "map"
            else if name is "List" or name is "list":
                "list"
            else:
                if name is "fn" or name is "ptr":
                    # Function pointer / generic pointer - encode as "fn"
                    # so llvm_type_of returns "ptr" in the emit step.
                    "fn"
                else:
                    # A sized integer KEEPS its name as the IR type: storage
                    # stays i64 (llvm_type_of maps any unknown scalar there),
                    # but the width survives so arithmetic can wrap exactly
                    # (see otir_mask_to). i64/u64 erase - they ARE the storage.
                    if is_sized_int_name(name):
                        return name
                    # `f32` too. It is not narrower storage - nothing in this
                    # backend is - and falling through to the integer default
                    # made it a SILENT integer: `a / 2.0` on an `f32` answered
                    # 4 for four and a half. Wider than asked is a value kept;
                    # whole where a fraction belongs is a value lost.
                    if name is "float" or name is "f64" or name is "f32" or name is "number":
                        "f64"
                    else:
                        # Capitalised names (Inst, Item, IRFn, …) are presumed
                        # to be data-struct types. Snake-case / lowercase names
                        # (int, bool, void) get the i64 default.
                        name_bs = bytes_of(name)
                        edit starts_cap = false
                        if length(name_bs) > 0:
                            first = name_bs[0]
                            if first >= 65 and first <= 90:
                                starts_cap = true
                        if starts_cap then "struct:{name}" else "i64"


# Same as ast_type_to_ir but knows about data structs declared in scope.
# A Named type whose name matches a struct decl becomes "struct:Name".
define ast_type_to_ir_with_scope(type_node: table, scope: Scope) -> text:
    kind = get(type_node, "kind")
    # Same Range/missing-name guards as ast_type_to_ir.
    if kind is "Range":
        return "i64"
    if kind is "FnType":
        return "fn"
    if kind is "TupleType":
        tt_elems = get_list(type_node, "elems")
        tt_types = part([""], 0, 0)
        edit tt_type_list = tt_types
        loop tti in 0 until length(tt_elems):
            tt_type_list = append(tt_type_list, ast_type_to_ir_with_scope(tt_elems[tti], scope))
        return "struct:{otir_tuple_register(tt_type_list)}"
    if not has(type_node, "name"):
        if kind is not "List":
            return "i64"
    if kind is "List":
        # Encode element type so list_at can return the right thing.
        elem_node = get(type_node, "elem")
        elem_type = ast_type_to_ir_with_scope(elem_node, scope)
        "list:{elem_type}"
    else:
        name = get(type_node, "name")
        # A generic type variable (`T` in `fn first<T>(...)`) lowers to an
        # opaque pointer-sized slot (i64). Registered per-fn via a generation
        # counter (see ast_fn_to_ir) so a stale `T` from an earlier fn can't
        # match here. Checked before the struct fallback, which would otherwise
        # turn a capitalised `T` into `struct:T`.
        tv_generation = slot_int_or_zero("otir:tvgen")
        if tv_generation > 0 and slot_int_or_zero(otir_k1("tv", name)) is tv_generation:
            return "i64"
        # A `type Name = T` alias (registered in ast_program_to_ir's pre-pass)
        # resolves to its target's IR type string.
        alias_key = otir_k1("tyalias", name)
        if slot_has(alias_key):
            return slot_get(alias_key)
        if name is "Text":
            compile_error("orion: ERROR - the type is written `text` now (`Text` was retired)")
        if name is "bool" or name is "Bool":
            compile_error("orion: ERROR - the truth type is written `truth` now (`bool` was retired)")
        # `int` WRITTEN IN SOURCE (the parser marks those; the compiler's own
        # synthesized int nodes carry no mark, and `external define` names a C
        # type, so neither is touched).
        if has(type_node, "said_int"):
            compile_error("orion: ERROR at {otir_where(get_int(type_node, \"line\"), get_int(type_node, \"col\"))} - the whole-number type is written `number` now (`int` was retired)")
        # `truth` is its own IR type. It IS an i64 in the machine - every type
        # `llvm_type_of` does not recognise lands there - but a function that
        # answers `truth` and one that answers a number are now different, and
        # that difference is what lets the surface print `true`.
        if name is "truth":
            "truth"
        else if name is "text":
            "text"
        else:
            if name is "Map":
                compile_error("orion: ERROR - the key-value type is written `table` now (`Map` was retired)")
            if name is "map" or name is "table":
                # `table<T>` -> `map:T`, the value type. See ast_type_to_ir.
                ms_args = if has(type_node, "args") then get_list(type_node, "args") else []
                if length(ms_args) is 1:
                    "map:{ast_type_to_ir_with_scope(ms_args[0], scope)}"
                else:
                    "map"
            else if name is "List" or name is "list":
                "list"
            else:
                if name is "fn" or name is "ptr":
                    "fn"
                else:
                    # Sized integers keep their width (see ast_type_to_ir).
                    if is_sized_int_name(name):
                        return name
                    # `f32` too. It is not narrower storage - nothing in this
                    # backend is - and falling through to the integer default
                    # made it a SILENT integer: `a / 2.0` on an `f32` answered
                    # 4 for four and a half. Wider than asked is a value kept;
                    # whole where a fraction belongs is a value lost.
                    if name is "float" or name is "f64" or name is "f32" or name is "number":
                        "f64"
                    else:
                        ds_names = scope.ds_names
                        n_structs = length(ds_names)
                        edit is_struct = false
                        loop si in 0 until n_structs:
                            if ds_names[si] is name:
                                is_struct = true
                        if is_struct then "struct:{name}" else "i64"


public define ast_fn_to_ir(ast_fn: table, initial_scope: Scope) -> IRFn:
    name = get(ast_fn, "name")
    # Where this fn was declared, for the whole-program checks below. Without it
    # they printed a message with nothing to point at.
    fn_at_line = if has(ast_fn, "line") then get_int(ast_fn, "line") else 0
    fn_at_col = if has(ast_fn, "col") then get_int(ast_fn, "col") else 0
    # The capability contract being compiled: call sites in THIS body check
    # against it. Empty = no clause = inferred (unchecked); a DECLARED clause
    # is held to.
    slot_set("otir:curuses", if has(ast_fn, "uses") then get(ast_fn, "uses") else "")
    # Register this fn's generic type variables so `T`/`U` in the signature
    # and body lower to opaque i64 slots (operation-passing generics) rather
    # than being mistaken for struct types. A per-fn generation stamp means a
    # previous fn's `T` never leaks into this one. See the type-var check in
    # ast_type_to_ir_with_scope.
    tv_gen = slot_int_or_zero("otir:tvgen") + 1
    slot_set("otir:tvgen", tv_gen)
    fn_generics = if has(ast_fn, "generics") then get_list(ast_fn, "generics") else []
    loop gi in 0 until length(fn_generics):
        slot_set(otir_k1("tv", fn_generics[gi]), tv_gen)
    ret_type_node = get(ast_fn, "ret")
    ret_type = ast_type_to_ir_with_scope(ret_type_node, initial_scope)
    edit fn_value = ir_fn_new(name, ret_type)
    params = get_list(ast_fn, "params")
    n_params = length(params)
    edit scope = initial_scope
    loop index in 0 until n_params:
        param = params[index]
        param_name = get(param, "name")
        param_type_node = get(param, "type")
        param_type = ast_type_to_ir_with_scope(param_type_node, initial_scope)
        # types-laget: parametrar utan annotation defaultar tyst - saga den
        # antagna typen som spoke pa define-raden (samma TYPEHINT-protokoll
        # som let-bindningarna; klienten placerar vid namnet).
        if slot_get_number("drv:typehints") is 1 and get(param_type_node, "kind") is "Unknown":
            print_line("TYPEHINT {otir_where(fn_at_line, 1)}:{param_name}:{th_surface(friendly_type(param_type))}")
        # A HANDLER's real parameter arrives as a word. The runtime casts a
        # handler to an all-i64 signature - it knows the arity and nothing
        # else - so the function declares i64 there and reads the double back
        # out of the bits. Everything after this sees an ordinary f64.
        hp_bits = param_type is "f64" and otir_is_handler(fn_value.name)
        wire_type = if hp_bits then "i64" else param_type
        fn_value = ir_fn_add_param(fn_value, param_name, wire_type)
        pr = ir_fn_push(fn_value, if hp_bits then ir_param_bits(index) else ir_param(index, param_type))
        fn_value = pr.function
        scope = scope_bind(scope, param_name, pr.id)
        # A `f: function(A, B) -> R` param carries a real signature the checker can
        # hold on to. The IR type erases to "fn", so record the arity here,
        # stamped with this fn's generation (see tv_gen above) so a same-named
        # param in another fn never matches. The call site (`f(args)`, the
        # is_local_callee path) reads it to reject a wrong argument count.
        if has(param, "type") and get(param_type_node, "kind") is "FnType":
            slot_set("otir:fnparam_arity:" + param_name, length(get_list(param_type_node, "params")))
            slot_set("otir:fnparam_gen:" + param_name, tv_gen)
            # Each declared parameter type, for the call-site argument-shape
            # check (below). Stored as the erased IR type; the check only reads
            # its concrete pointer kind, so a type var stays a wildcard.
            fpt_list = get_list(param_type_node, "params")
            loop fpt_i in 0 until length(fpt_list):
                slot_set("otir:fnparam_pt:" + param_name + ":{fpt_i}", ast_type_to_ir_with_scope(fpt_list[fpt_i], initial_scope))
            # Declared return type, for the call-site return-type propagation.
            slot_set("otir:fnparam_ret:" + param_name, ast_type_to_ir_with_scope(get_map(param_type_node, "ret"), initial_scope))
    # --trace (orbit debug): prefix the body with a call-trail entry, so a
    # crash, a trap or a breakpoint can say how execution got there. Off by
    # default - one runtime call per function entry is not free.
    if slot_int_or_zero("drv:trace") is 1:
        tr_s = ir_fn_push(fn_value, ir_const_str(friendly_fn_name(name)))
        fn_value = tr_s.function
        tr_c = ir_fn_push(fn_value, ir_call("orion_trace_enter", [tr_s.id], "i64"))
        fn_value = tr_c.function
    body = get(ast_fn, "body")
    # A block-form fn with zero statements means the body was empty in source
    # (a forgotten body) OR a mis-parse swallowed it (e.g. a keyword used as a
    # variable name that ended the body early). Lowering an empty block just
    # emits `ret 0` - a silently wrong program. Make it loud instead. Externs
    # are a separate ExternFn node and never reach here; short-form `= expr`
    # fns carry a one-statement block, so neither is affected.
    if get(body, "kind") is "Block" and length(get_list(body, "stmts")) is 0:
        compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} - function `{friendly_fn_name(name)}` has an empty body (add a body, or check for a keyword used as a variable name)")
    body_result = ast_expr_to_ir(fn_value, scope, body)
    # Return-type guard: the tail expression's storage shape (i64 vs pointer)
    # must match the declared return type. Catches `define f() -> number: "hello"`
    # (returns text) instead of silently returning garbage. Only compares the
    # i64/ptr bucket, like the reassignment check - text/list/map/struct all
    # share ptr storage, so no false positive between them. `fn`, `f64` and
    # `Unit` are exempt (bit-punned fn pointers, doubles, void).
    if is_block_terminated(body_result.function) is 0:
        rt_body = get_value_type(body_result.function, body_result.id)
        # A fn with no `-> type` gets the `Unit` sentinel (a void procedure
        # called for its effect). There's no declared return to violate, so
        # exempt it - only an EXPLICIT return type is a contract to check.
        ret_undeclared = has(ret_type_node, "name") and get(ret_type_node, "name") is "Unit"
        # A body that leaves through `resume` gives no value ON PURPOSE: resume
        # is a longjmp to the perform site, so the handler's frame is gone and
        # there is nothing to answer with. Every effect handler in the language
        # ends this way, which is how the first version of the check below
        # failed five smoke tests at once.
        # A body that gives NO value where one was declared is the sibling of
        # the annotation that lies: `define f() -> number:` whose body ends in
        # a void call, a loop, or an `if` with no else fabricates a 0. Zero is
        # a legal id, a legal position and a legal health, so the mistake is
        # never found where it was made.
        if (not ret_undeclared) and (rt_body is "void" or rt_body is "Unit") and (not otir_tail_resumes(body)):
            compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} - function `{friendly_fn_name(name)}` is declared to return `{friendly_type(ret_type)}` but its body gives no value")
        rt_exempt = ret_undeclared or ret_type is "fn" or ret_type is "f64" or ret_type is "Unit" or rt_body is "fn" or rt_body is "f64" or rt_body is "void" or rt_body is "Unit"
        # Bucket by STORAGE: a sized int (u8...) and i64 are the same slot.
        rt_decl_ll = if is_ptr_ir_type(ret_type) then "ptr" else "i64"
        rt_body_ll = if is_ptr_ir_type(rt_body) then "ptr" else "i64"
        if (not rt_exempt) and rt_decl_ll is not rt_body_ll:
            compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} - function `{friendly_fn_name(name)}` is declared to return `{friendly_type(ret_type)}` but its body returns `{friendly_type(rt_body)}`")
        # Sharpened guard: among POINTER shapes, catch confusing two concrete
        # kinds (text/list/struct). `map`/`fn`/generic stay wildcards (kind ""),
        # the deliberate dynamic escape. And we SKIP bodies whose type is
        # unreliable (slot_get/map get, traced through phis) - so the pervasive
        # `-> [T]: if slot_has(k) then slot_get(k) else []` idiom is never
        # flagged, only a value with a trustworthy static shape. This is the
        # first real pointer-subtype typing, using info the IR already tracks.
        decl_kind = concrete_ptr_kind(ret_type)
        body_kind = concrete_ptr_kind(rt_body)
        body_unreliable = is_unreliable_ptr(body_result.function, body_result.id)
        if (not rt_exempt) and (not body_unreliable) and decl_kind is not "" and body_kind is not "" and decl_kind is not body_kind:
            compile_error("orion: ERROR at {otir_where(fn_at_line, fn_at_col)} - function `{friendly_fn_name(name)}` is declared to return `{friendly_type(ret_type)}` but its body returns `{friendly_type(rt_body)}` (a {body_kind} where a {decl_kind} was declared)")
        # The `number` boundary, return side: a whole-number tail in a
        # function declared f64 is promoted, mirroring the argument rule.
        edit tail_id = body_result.id
        edit tail_fn = body_result.function
        if ret_type is "f64" and is_whole_ir(rt_body):
            pr_rt = ir_fn_push(tail_fn, ir_sitofp(tail_id))
            tail_fn = pr_rt.function
            tail_id = pr_rt.id
        if rt_body is "f64" and is_whole_ir(ret_type):
            de_rt = ir_fn_push(tail_fn, ir_fptosi(tail_id))
            tail_fn = de_rt.function
            tail_id = de_rt.id
        ret_result = ir_fn_push(tail_fn, ir_return(tail_id))
        ret_result.function
    else:
        body_result.function


# ---- `defer` as an AST rewrite ---------------------------------------
#
# `defer E` runs E at the end of its block, and before ANY `return` that leaves
# it, in LIFO order. The lowering collected Defer statements inside the function
# body's statement loop and replayed them there, which covered the block end and
# a top-level return - but a `return` inside an `if` or a loop is lowered by its
# own nested statement loop, which knew nothing about the outer list. So
#
#     define f(x: number) -> number:
#         defer cleanup()
#         if x > 0:
#             return 1        # cleanup() never ran
#
# skipped the deferred call silently. Doing it as an AST rewrite instead means
# the nested `return` is right there in the tree: every return gets the visible
# defers spliced in ahead of it, innermost first, and each block ends with its
# own. Nothing is left for the lowering to special-case.

define defer_concat(a: [table], b: [table]) -> [table]:
    edit out = part(a, 0, length(a))
    loop i in 0 until length(b):
        out = append(out, b[i])
    out

# Append `items` in REVERSE as plain expression statements: last registered runs
# first, which is what LIFO means for a defer.
define defer_append_reverse(out: [table], items: [table]) -> [table]:
    edit acc = out
    n = length(items)
    loop i in 0 until n:
        acc = append(acc, {"kind": "ExprStmt", "expr": items[n - 1 - i]})
    acc

define defer_rewrite_else(node: table, visible: [table]) -> table:
    kind = get(node, "kind")
    if kind is "Block":
        defer_rewrite_block(node, visible)
    else:
        if kind is "IfBlock":
            defer_rewrite_stmt(node, visible)
        else:
            node

define defer_rewrite_stmt(s: table, visible: [table]) -> table:
    kind = get(s, "kind")
    edit out = s
    if kind is "IfBlock":
        out = set(out, "then", defer_rewrite_block(get(s, "then"), visible))
        out = set(out, "else", defer_rewrite_else(get(s, "else"), visible))
    if kind is "Loop" or kind is "ForRange" or kind is "ForIn":
        out = set(out, "body", defer_rewrite_block(get(s, "body"), visible))
    if kind is "Match":
        arms = get_list(s, "arms")
        edit new_arms = part(arms, 0, 0)
        loop ai in 0 until length(arms):
            arm = arms[ai]
            body = get_map(arm, "body")
            new_body = if get(body, "kind") is "Block" then defer_rewrite_block(body, visible) else body
            new_arms = append(new_arms, set(arm, "body", new_body))
        out = set(out, "arms", new_arms)
    out

# A fresh name per splice site, so nesting cannot shadow.
define defer_tmp_name() -> text:
    n = slot_int_or_zero(otir_k1("defret", "n"))
    slot_set(otir_k1("defret", "n"), n + 1)
    "__defer_v{n}"

# A block's value is its last statement, and that statement is not always an
# ExprStmt: a `choose` in tail position is a Match node. Only ExprStmt got the
# save-then-run treatment, so `defer f()` before a tail match appended the
# defers AFTER it and the deferred call's value became the block's value --
#
#     define main() -> number:
#         defer print_line("bye")
#         choose 1:
#             1 then 84        # returned 0
#
# which is exactly what the comment inside this function warns about, for a
# statement kind it did not list.
define defer_is_tail_value(k: text) -> truth:
    k is "ExprStmt" or k is "Match"

# A tail `if c: ... else: ...` produces the block's value too, but unlike a
# `choose` it is NOT an expression -- `y = if c: a else: b` does not parse -- so
# it cannot be hoisted into a temp the way the other two are.
#
# Push the pending defers INTO each branch instead, as ordinary Defer
# statements at the front. Each branch then ends in its own value, and the
# existing rewrite gives that branch the save-then-run treatment. An `else` that
# is itself an IfBlock is an else-if chain, so walk it. An EMPTY else still gets
# them: the defers have to run whichever way the condition went.
define defer_prepend(block: table, defers: [table]) -> table:
    stmts = get_list(block, "stmts")
    edit out = part(stmts, 0, 0)
    loop i in 0 until length(defers):
        out = append(out, {"kind": "Defer", "expr": defers[i]})
    loop j in 0 until length(stmts):
        out = append(out, stmts[j])
    set(block, "stmts", out)

define defer_tail_ifblock(s: table, defers: [table], inherited: [table]) -> table:
    edit out = set(s, "then", defer_rewrite_block(defer_prepend(get_map(s, "then"), defers), inherited))
    els = get_map(s, "else")
    if get(els, "kind") is "Block":
        out = set(out, "else", defer_rewrite_block(defer_prepend(els, defers), inherited))
    else:
        out = set(out, "else", defer_tail_ifblock(els, defers, inherited))
    out

define defer_rewrite_block(block: table, inherited: [table]) -> table:
    stmts = get_list(block, "stmts")
    n = length(stmts)
    edit mine = part(stmts, 0, 0)
    edit out = part(stmts, 0, 0)
    loop i in 0 until n:
        s = stmts[i]
        k = get(s, "kind")
        if k is "Defer":
            mine = append(mine, get_map(s, "expr"))
        else:
            visible = defer_concat(inherited, mine)
            is_last = i is n - 1
            # The RETURN VALUE is computed first, then the defers run, then the
            # saved value is returned. `defer close(f)` before `return read(f)`
            # must not close the handle the return expression is about to read -
            # splicing the defers ahead of the return did exactly that.
            if k is "Return" and length(visible) > 0:
                tmp = defer_tmp_name()
                out = append(out, {"kind": "LetOrAssign", "name": tmp, "value": get_map(s, "expr")})
                out = defer_append_reverse(out, visible)
                out = append(out, {"kind": "Return", "expr": {"kind": "Ident", "name": tmp}, "line": dfv_stmt_line(s), "col": dfv_stmt_col(s), "defer_covered": 1})
            else:
                # The last expression of a block IS its value, so the same
                # save-then-run applies at the block end: appending the defers
                # after it would make a deferred call the block's value.
                if k is "IfBlock" and is_last and length(mine) > 0:
                    out = append(out, defer_tail_ifblock(s, mine, inherited))
                else if defer_is_tail_value(k) and is_last and length(mine) > 0:
                    tmp2 = defer_tmp_name()
                    # An ExprStmt wraps its expression; a tail `choose` IS the
                    # value-producing node.
                    tail_expr = if k is "ExprStmt" then get_map(s, "expr") else s
                    out = append(out, {"kind": "LetOrAssign", "name": tmp2, "value": tail_expr})
                    out = defer_append_reverse(out, mine)
                    out = append(out, {"kind": "ExprStmt", "expr": {"kind": "Ident", "name": tmp2}, "line": dfv_stmt_line(s), "col": dfv_stmt_col(s), "defer_covered": 1})
                else:
                    out = append(out, defer_rewrite_stmt(s, visible))
    # Only if the value-preserving path above did not already do it: a block that
    # does not end in an expression just runs its defers last.
    tail_kind = if n > 0 then get(stmts[n - 1], "kind") else ""
    # `already` must also cover the IfBlock branch above, which pushed the
    # defers down into the branches. Appending them again here would run them
    # twice and make the second copy the block's value.
    already = (defer_is_tail_value(tail_kind) or tail_kind is "IfBlock") and length(mine) > 0
    defer_out = if already then out else defer_append_reverse(out, mine)
    set(block, "stmts", defer_out)

# True if any statement anywhere under this block is a `defer` (gate the pass so
# a defer-free program's AST comes through untouched).
define defer_block_has(block: table) -> truth:
    stmts = get_list(block, "stmts")
    edit found = false
    loop i in 0 until length(stmts):
        s = stmts[i]
        k = get(s, "kind")
        if k is "Defer":
            found = true
        if k is "IfBlock":
            if defer_block_has(get(s, "then")):
                found = true
            if get(get(s, "else"), "kind") is "Block":
                if defer_block_has(get_map(s, "else")):
                    found = true
        if k is "Loop" or k is "ForRange" or k is "ForIn":
            if defer_block_has(get(s, "body")):
                found = true
    found

# ---- defer coverage verifier (compile-time) --------------------------
#
# An independent postcondition on the `defer` AST rewrite above. The rewrite
# is the thing that can be wrong: every bug in this class (a `defer` before a
# tail `choose`, a `return` inside an `if`, a tail `if` whose branches return)
# was the rewrite failing to RECURSE into a construct, leaving a value-
# producing position uncovered while the value survived and answered wrong.
#
# So: the rewrite STAMPS every position it covers (`defer_covered`). This
# oracle walks the ORIGINAL body, recursing into EVERY construct, and records
# every position that NEEDS covering: a `return` or a tail value reached with
# at least one visible `defer` in scope. A position the oracle reaches but the
# rewrite did not leaves an entry in `needs` with no match in `covered`, and is
# reported at the dropped defer's source line. The oracle is the spec; the
# rewrite is the implementation; a divergence is the bug.
#
# It changes no emitted IR (a valid program compiles to exactly what it did
# before), so it is fixpoint-safe: the compiler still self-hosts unchanged.

define dfv_line(s: table) -> number:
    if has(s, "line") then get_int(s, "line") else 0

define dfv_col(s: table) -> number:
    if has(s, "col") then get_int(s, "col") else 0

# Statement wrappers (Defer, Return, ExprStmt) carry no location, but the
# EXPRESSION they wrap does, and a `choose` node carries its own. So a position's
# location is its own `line` if present, else its expression's. This must be the
# same value the rewrite stamps on what it covers, so the match key is stable and
# distinct per position (line 0 for everything would collapse the keys and let a
# real drop hide behind any covered defer).
define dfv_stmt_line(s: table) -> number:
    if has(s, "line") then get_int(s, "line")
    else if has(s, "expr") then dfv_line(get_map(s, "expr"))
    else 0

define dfv_stmt_col(s: table) -> number:
    if has(s, "col") then get_int(s, "col")
    else if has(s, "expr") then dfv_col(get_map(s, "expr"))
    else 0

# One in-scope defer's source position, carried down the walk.
define dfv_defloc(s: table) -> table:
    {"l": dfv_stmt_line(s), "c": dfv_stmt_col(s)}

# A must-cover position: `m*` is the return/tail's own location (the match key,
# also stamped by the rewrite on what it covers), `d*` is the nearest enclosing
# defer (what the error points at).
define dfv_key(s: table, vis: [table]) -> table:
    d = vis[length(vis) - 1]
    {"mline": dfv_stmt_line(s), "mcol": dfv_stmt_col(s), "dline": get_int(d, "l"), "dcol": get_int(d, "c")}

# ---- oracle: positions that must be covered, from the ORIGINAL body ----

define dfv_need(block: table) -> [table]:
    seed = get_list(block, "stmts")
    dfv_need_block(seed, part(seed, 0, 0), part(seed, 0, 0), true)

# stmts: block body. inh: defers inherited from enclosing blocks. acc0: needs so
# far. blk_tail: true when this block's last statement is the function's value.
define dfv_need_block(stmts: [table], inh: [table], acc0: [table], blk_tail: truth) -> [table]:
    edit acc = acc0
    edit vis = part(inh, 0, length(inh))
    n = length(stmts)
    loop i in 0 until n:
        s = stmts[i]
        k = get(s, "kind")
        tail_here = blk_tail and (i is n - 1)
        if k is "Defer":
            vis = append(vis, dfv_defloc(s))
        else if k is "Return":
            if length(vis) > 0:
                acc = append(acc, dfv_key(s, vis))
        else if k is "IfBlock":
            acc = dfv_need_block(get_list(get_map(s, "then"), "stmts"), vis, acc, tail_here)
            acc = dfv_need_else(get_map(s, "else"), vis, acc, tail_here)
        else if k is "Loop" or k is "ForRange" or k is "ForIn":
            acc = dfv_need_block(get_list(get_map(s, "body"), "stmts"), vis, acc, false)
        else if k is "Match":
            if tail_here and length(vis) > 0:
                acc = append(acc, dfv_key(s, vis))
            arms = get_list(s, "arms")
            loop ai in 0 until length(arms):
                b = get_map(arms[ai], "body")
                if get(b, "kind") is "Block":
                    acc = dfv_need_block(get_list(b, "stmts"), vis, acc, false)
        else if k is "ExprStmt":
            if tail_here and length(vis) > 0:
                acc = append(acc, dfv_key(s, vis))
    acc

# An `else` is a Block, an else-if chain (nested IfBlock), or empty.
define dfv_need_else(els: table, vis: [table], acc0: [table], tail_here: truth) -> [table]:
    k = get(els, "kind")
    if k is "Block":
        dfv_need_block(get_list(els, "stmts"), vis, acc0, tail_here)
    else if k is "IfBlock":
        edit acc = dfv_need_block(get_list(get_map(els, "then"), "stmts"), vis, acc0, tail_here)
        acc = dfv_need_else(get_map(els, "else"), vis, acc, tail_here)
        acc
    else:
        acc0

# ---- what the rewrite actually covered, from the REWRITTEN body ----

define dfv_covered(block: table) -> [table]:
    seed = get_list(block, "stmts")
    dfv_cov_block(seed, part(seed, 0, 0))

define dfv_cov_block(stmts: [table], acc0: [table]) -> [table]:
    edit acc = acc0
    loop i in 0 until length(stmts):
        s = stmts[i]
        if has(s, "defer_covered"):
            acc = append(acc, {"mline": dfv_line(s), "mcol": dfv_col(s)})
        acc = dfv_cov_nested(s, acc)
    acc

define dfv_cov_nested(s: table, acc0: [table]) -> [table]:
    edit acc = acc0
    k = get(s, "kind")
    if k is "IfBlock":
        acc = dfv_cov_block(get_list(get_map(s, "then"), "stmts"), acc)
        els = get_map(s, "else")
        if get(els, "kind") is "Block":
            acc = dfv_cov_block(get_list(els, "stmts"), acc)
        else if get(els, "kind") is "IfBlock":
            acc = dfv_cov_nested(els, acc)
    else if k is "Loop" or k is "ForRange" or k is "ForIn":
        acc = dfv_cov_block(get_list(get_map(s, "body"), "stmts"), acc)
    else if k is "Match":
        arms = get_list(s, "arms")
        loop ai in 0 until length(arms):
            b = get_map(arms[ai], "body")
            if get(b, "kind") is "Block":
                acc = dfv_cov_block(get_list(b, "stmts"), acc)
    acc

# ---- report: every need with no matching cover is a dropped defer ----

define dfv_has(xs: [table], ml: number, mc: number) -> truth:
    edit f = false
    loop i in 0 until length(xs):
        x = xs[i]
        if get_int(x, "mline") is ml and get_int(x, "mcol") is mc:
            f = true
    f

define dfv_report(needs: [table], covered: [table]):
    loop i in 0 until length(needs):
        nd = needs[i]
        ml = get_int(nd, "mline")
        mc = get_int(nd, "mcol")
        if not dfv_has(covered, ml, mc):
            where = otir_where(get_int(nd, "dline"), get_int(nd, "dcol"))
            compile_error("orion: ERROR at {where}: `defer` is dropped on a return path (registered here, it never runs before the block's value leaves)")

# ---- name substitution over an AST subtree ---------------------------
# Replace every READ of a name with a given expression node, everywhere a name
# can be read (expressions, call args, list items, map pairs, match arms, loop
# headers, nested blocks). One user today: the `const` pass, which substitutes
# each constant's defining expression at its read sites and then drops the
# declarations.
#
# Substituted subtrees are ALIASED, not deep-copied: lowering treats the AST as
# read-only, and emitting the same subtree at N read sites is intended (a
# constant's expression is folded per use).
#
# (These were the `fact_rw_*` helpers, named after the reactive `fact` binding
# they were written for. That keyword is gone; the mechanism is not.)

define subst_find(names: [text], target: text) -> number:
    edit found = 0 - 1
    n = length(names)
    loop i in 0 until n:
        if names[i] is target:
            found = i
    found

# Rewrite a list of expression nodes (call args, list items, ...).
define subst_list(items: [table], names: [text], exprs: [table]) -> [table]:
    edit out = part(items, 0, 0)
    n = length(items)
    loop i in 0 until n:
        out = append(out, subst_expr(items[i], names, exprs))
    out

# Rewrite the `value` field of each entry (MapLit pairs, StructCons fields).
define subst_pairs(pairs: [table], names: [text], exprs: [table]) -> [table]:
    edit out = part(pairs, 0, 0)
    n = length(pairs)
    loop i in 0 until n:
        p = pairs[i]
        out = append(out, set(p, "value", subst_expr(get(p, "value"), names, exprs)))
    out

# Rewrite the `body` expression of each match arm.
define subst_arms(arms: [table], names: [text], exprs: [table]) -> [table]:
    edit out = part(arms, 0, 0)
    n = length(arms)
    loop i in 0 until n:
        a = arms[i]
        out = append(out, set(a, "body", subst_expr(get(a, "body"), names, exprs)))
    out

# Rewrite one expression node: substitute fact idents, recurse into children.
define subst_expr(node: table, names: [text], exprs: [table]) -> table:
    kind = get(node, "kind")
    edit out = node
    if kind is "Ident":
        idx = subst_find(names, get(node, "name"))
        if idx >= 0:
            out = exprs[idx]
    if kind is "Binary":
        out = set(out, "left", subst_expr(get(node, "left"), names, exprs))
        out = set(out, "right", subst_expr(get(node, "right"), names, exprs))
    if kind is "Unary":
        out = set(out, "operand", subst_expr(get(node, "operand"), names, exprs))
    # `pi as int` - the Cast node was missing here, so a const read under a
    # cast never substituted and died as "unknown identifier". (Found the day
    # pi became a real cross-orb const.)
    if kind is "Cast":
        out = set(out, "expr", subst_expr(get(node, "expr"), names, exprs))
    if kind is "Call":
        out = set(out, "args", subst_list(get_list(node, "args"), names, exprs))
    if kind is "Perform":
        out = set(out, "args", subst_list(get_list(node, "args"), names, exprs))
    if kind is "MethodCall":
        out = set(out, "receiver", subst_expr(get(node, "receiver"), names, exprs))
        out = set(out, "args", subst_list(get_list(node, "args"), names, exprs))
    if kind is "Field":
        out = set(out, "object", subst_expr(get(node, "object"), names, exprs))
    if kind is "Index":
        out = set(out, "object", subst_expr(get(node, "object"), names, exprs))
        out = set(out, "index", subst_expr(get(node, "index"), names, exprs))
    if kind is "Question":
        out = set(out, "inner", subst_expr(get(node, "inner"), names, exprs))
    if kind is "If":
        out = set(out, "cond", subst_expr(get(node, "cond"), names, exprs))
        out = set(out, "then", subst_expr(get(node, "then"), names, exprs))
        out = set(out, "else", subst_expr(get(node, "else"), names, exprs))
    if kind is "ListLit":
        out = set(out, "items", subst_list(get_list(node, "items"), names, exprs))
    if kind is "Tuple":
        out = set(out, "items", subst_list(get_list(node, "items"), names, exprs))
    if kind is "NamedArg":
        out = set(out, "value", subst_expr(get(node, "value"), names, exprs))
    if kind is "MapLit":
        out = set(out, "pairs", subst_pairs(get_list(node, "pairs"), names, exprs))
    if kind is "StructCons":
        out = set(out, "fields", subst_pairs(get_list(node, "fields"), names, exprs))
    if kind is "Match":
        out = set(out, "scrutinee", subst_expr(get(node, "scrutinee"), names, exprs))
        out = set(out, "arms", subst_arms(get_list(node, "arms"), names, exprs))
    out

# An IfBlock's else is either a Block or a chained IfBlock (else-if ladder).
define subst_else(node: table, names: [text], exprs: [table]) -> table:
    kind = get(node, "kind")
    edit out = node
    if kind is "Block":
        out = subst_block(node, names, exprs)
    if kind is "IfBlock":
        out = subst_stmt(node, names, exprs)
    out

# Rewrite one statement: fix up its expression fields + nested blocks.
define subst_stmt(s: table, names: [text], exprs: [table]) -> table:
    kind = get(s, "kind")
    edit out = s
    if kind is "MutLet":
        out = set(out, "value", subst_expr(get(s, "value"), names, exprs))
    if kind is "LetOrAssign":
        out = set(out, "value", subst_expr(get(s, "value"), names, exprs))
    if kind is "ExprStmt":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind is "Return":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind is "Require":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind is "Ensure":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    if kind is "Defer":
        out = set(out, "expr", subst_expr(get(s, "expr"), names, exprs))
    # (A `Destroy` branch used to sit here. The parser emits no such statement -
    # `destroy` was an ECS word that never had syntax - so it was unreachable.
    # Found by diffing the kinds this file HANDLES against the kinds the parser
    # EMITS, which is the same check that found `defer` had gone missing.)
    if kind is "Loop":
        out = set(out, "body", subst_block(get(s, "body"), names, exprs))
    if kind is "ForRange":
        out = set(out, "low", subst_expr(get(s, "low"), names, exprs))
        out = set(out, "high", subst_expr(get(s, "high"), names, exprs))
        out = set(out, "body", subst_block(get(s, "body"), names, exprs))
    if kind is "ForIn":
        out = set(out, "iter", subst_expr(get(s, "iter"), names, exprs))
        out = set(out, "body", subst_block(get(s, "body"), names, exprs))
    if kind is "IfBlock":
        out = set(out, "cond", subst_expr(get(s, "cond"), names, exprs))
        out = set(out, "then", subst_block(get(s, "then"), names, exprs))
        out = set(out, "else", subst_else(get(s, "else"), names, exprs))
    if kind is "Match":
        out = set(out, "scrutinee", subst_expr(get(s, "scrutinee"), names, exprs))
        out = set(out, "arms", subst_arms(get(s, "arms"), names, exprs))
    out

# Rewrite every statement in a Block.
define subst_block(block: table, names: [text], exprs: [table]) -> table:
    stmts = get_list(block, "stmts")
    n = length(stmts)
    edit out = part(stmts, 0, 0)
    loop i in 0 until n:
        out = append(out, subst_stmt(stmts[i], names, exprs))
    set(block, "stmts", out)

# Every name a fn BINDS locally: parameters, `edit`/plain bindings and loop
# variables, at any depth. The const pass excludes these from substitution -
# a local `e` must SHADOW the num orb's `e = 2.718...`, not be overwritten by
# it (that miscompiled `e = e + 1` into `2.718... + 1`, "cannot reassign").
# A body that shadows a const and also wants its value gets a loud unknown-
# identifier error, which beats a silent wrong number. (Match-arm pattern
# binds are not collected; their names live inside the pattern encoding.)
define bound_in_block(block: table, acc: [text]) -> [text]:
    stmts = get_list(block, "stmts")
    edit out = acc
    loop i in 0 until length(stmts):
        s = stmts[i]
        kind = get(s, "kind")
        if kind is "MutLet" or kind is "LetOrAssign":
            out = append(out, get(s, "name"))
        if kind is "ForRange" or kind is "ForIn":
            out = append(out, get(s, "var"))
            out = bound_in_block(get(s, "body"), out)
        if kind is "ForIn":
            iv = get(s, "index_var")
            if iv is not "":
                out = append(out, iv)
        if kind is "Loop":
            out = bound_in_block(get(s, "body"), out)
        if kind is "IfBlock":
            out = bound_in_block(get(s, "then"), out)
            els = get(s, "else")
            if get(els, "kind") is "Block":
                out = bound_in_block(els, out)
            if get(els, "kind") is "IfBlock":
                out = bound_in_block({"kind": "Block", "stmts": [els]}, out)
        if kind is "Match":
            arms = get_list(s, "arms")
            loop ai in 0 until length(arms):
                arm_body = get_map(arms[ai], "body")
                if get(arm_body, "kind") is "Block":
                    out = bound_in_block(arm_body, out)
    out




# ---- nested lambda lift (lambda in a call-arg / expression position) -----
# The main lift handles `name = function(...)` and bare/returned lambdas. This lifts
# a lambda that sits deeper - e.g. `apply(function(n): n+1, x)` - into the same
# closure form. It's additive (own `__nlambda` prefix + slot counter, so it
# never collides with the main lift's `__lambda`), and only walks the node
# kinds a call-arg lambda actually reaches.

define nlam_names_has(names: [text], name: text) -> truth:
    edit found = false
    loop i in 0 until length(names):
        if names[i] is name:
            found = true
    found


# Every Ident an EXPRESSION reads that `bound` does not already cover. This
# is the whole capture set for an expression-bodied lambda, and the
# per-statement half of the block walk below. A nested Lambda is NOT
# descended into - its own lift computes its captures.
define nlam_expr_caps(node: table, bound: [text], caps: [text]) -> [text]:
    init_work = [node]
    edit worklist = init_work
    edit out = caps
    loop:
        w_n = length(worklist)
        if w_n is 0:
            break
        cur = worklist[w_n - 1]
        worklist = part(worklist, 0, w_n - 1)
        ck = get(cur, "kind")
        if ck is "Ident":
            cn = get(cur, "name")
            if not nlam_names_has(bound, cn) and not nlam_names_has(out, cn):
                out = append(out, cn)
        if ck is "Binary":
            worklist = append(worklist, get(cur, "left"))
            worklist = append(worklist, get(cur, "right"))
        if ck is "Unary":
            worklist = append(worklist, get(cur, "operand"))
        if ck is "Call":
            call_args = get_list(cur, "args")
            loop cai in 0 until length(call_args):
                worklist = append(worklist, call_args[cai])
        if ck is "If":
            worklist = append(worklist, get(cur, "cond"))
            worklist = append(worklist, get(cur, "then"))
            worklist = append(worklist, get(cur, "else"))
        # Without these, a capture hiding behind a field access, an index, or
        # a method call reads as a free variable and the closure breaks.
        if ck is "Field":
            worklist = append(worklist, get(cur, "object"))
        if ck is "Index":
            worklist = append(worklist, get(cur, "object"))
            worklist = append(worklist, get(cur, "index"))
        if ck is "MethodCall":
            worklist = append(worklist, get(cur, "receiver"))
            mc_args = get_list(cur, "args")
            loop mci in 0 until length(mc_args):
                worklist = append(worklist, mc_args[mci])
        if ck is "ListLit" or ck is "Tuple":
            l_items = get_list(cur, "items")
            loop li in 0 until length(l_items):
                worklist = append(worklist, l_items[li])
        if ck is "MapLit":
            m_pairs = get_list(cur, "pairs")
            loop mpi in 0 until length(m_pairs):
                worklist = append(worklist, get(m_pairs[mpi], "value"))
        if ck is "StructCons":
            s_fields = get_list(cur, "fields")
            loop sfi in 0 until length(s_fields):
                worklist = append(worklist, get(s_fields[sfi], "value"))
        if ck is "Question":
            worklist = append(worklist, get(cur, "inner"))
        if ck is "Block":
            blk_r = nlam_block_caps(cur, bound, out)
            out = get_list(blk_r, "caps")
        if ck is "Match":
            worklist = append(worklist, get(cur, "scrutinee"))
            ms_arms = get_list(cur, "arms")
            loop mai in 0 until length(ms_arms):
                m_arm = ms_arms[mai]
                edit arm_bound = bound
                arm_binds = if has(m_arm, "bindings") then get_list(m_arm, "bindings") else []
                loop abi in 0 until length(arm_binds):
                    arm_bound = append(arm_bound, arm_binds[abi])
                out = nlam_expr_caps(get(m_arm, "body"), arm_bound, out)
    out


# A BLOCK body (what `loop parallel:` hands a lambda) walked IN ORDER: a name
# is a capture when it is read before the block binds it. `xs[i] = v`
# desugars to `xs = set(xs, i, v)`, so the read on the right makes `xs` a
# capture even though the statement also binds that name - which is exactly
# what lets a parallel body write into a shared list. A name the block binds
# first (`total = 0`) is a local, so it is not captured.
define nlam_block_caps(block: table, bound: [text], caps: [text]) -> table:
    stmts = get_list(block, "stmts")
    edit b = bound
    edit c = caps
    loop si in 0 until length(stmts):
        st = stmts[si]
        sk = get(st, "kind")
        if sk is "MutLet" or sk is "LetOrAssign":
            c = nlam_expr_caps(get(st, "value"), b, c)
            b = append(b, get(st, "name"))
        if sk is "ExprStmt" or sk is "Return" or sk is "Require" or sk is "Ensure" or sk is "Defer":
            c = nlam_expr_caps(get(st, "expr"), b, c)
        if sk is "If" or sk is "Match":
            c = nlam_expr_caps(st, b, c)
        if sk is "IfBlock":
            c = nlam_expr_caps(get(st, "cond"), b, c)
            then_r = nlam_block_caps(get(st, "then"), b, c)
            c = get_list(then_r, "caps")
            els = get(st, "else")
            if get(els, "kind") is "Block":
                else_r = nlam_block_caps(els, b, c)
                c = get_list(else_r, "caps")
            if get(els, "kind") is "IfBlock":
                chain_r = nlam_block_caps({"kind": "Block", "stmts": append([], els)}, b, c)
                c = get_list(chain_r, "caps")
        if sk is "ForRange":
            c = nlam_expr_caps(get(st, "low"), b, c)
            c = nlam_expr_caps(get(st, "high"), b, c)
            fr_r = nlam_block_caps(get(st, "body"), append(b, get(st, "var")), c)
            c = get_list(fr_r, "caps")
        if sk is "ForIn":
            c = nlam_expr_caps(get(st, "iter"), b, c)
            edit in_bound = append(b, get(st, "var"))
            if has(st, "index_var"):
                in_bound = append(in_bound, get(st, "index_var"))
            fi_r = nlam_block_caps(get(st, "body"), in_bound, c)
            c = get_list(fi_r, "caps")
        if sk is "Loop":
            lp_r = nlam_block_caps(get(st, "body"), b, c)
            c = get_list(lp_r, "caps")
    {"bound": b, "caps": c}


define nlam_capture_scan(lam_body: table, lam_params: [text]) -> [text]:
    edit bound = part([""], 0, 0)
    loop bp in 0 until length(lam_params):
        bound = append(bound, lam_params[bp])
    empty_caps = part([""], 0, 0)
    edit caps = empty_caps
    if get(lam_body, "kind") is "Block":
        blk_r = nlam_block_caps(lam_body, bound, empty_caps)
        caps = get_list(blk_r, "caps")
    else:
        caps = nlam_expr_caps(lam_body, bound, empty_caps)
    caps


# What a lifted lambda answers with. A DECLARED answer wins, exactly as it
# does on a define: `(n) -> text: "row {n}"`. Without one the answer is read
# off the body, which can only tell int from real - and a text body silently
# handed its pointer out as a number, so a lambda that builds a line was not
# expressible at all.
define num_lambda_ret(lam: table) -> table:
    if has(lam, "ret"):
        declared = get_map(lam, "ret")
        # A non-Named answer (`-> [text]`) has no "name" to be empty.
        if get(declared, "kind") is not "Named" or get(declared, "name") is not "":
            return declared
    if num_expr_real(get_map(lam, "body"), slot_get("otir:lamfn")):
        return {"kind": "Named", "name": "float"}
    {"kind": "Named", "name": "int"}

# Synthesize a __nlambda_N fn for `lam`; return {closure: MakeClosure, decl: Fn}.
define nlam_synth(lam: table) -> table:
    lam_params = get_list(lam, "params")
    n_lp = length(lam_params)
    lam_body = get(lam, "body")
    caps = nlam_capture_scan(lam_body, lam_params)
    n_caps = length(caps)
    edit typed_params = part([lam], 0, 0)
    typed_params = append(typed_params, {"name": "__env", "type": {"kind": "List", "elem": {"kind": "Named", "name": "int"}}})
    loop pi in 0 until n_lp:
        edit p_ty = {"kind": "Named", "name": "int"}
        if has(lam, "param_types"):
            p_ty = get_list(lam, "param_types")[pi]
        typed_params = append(typed_params, {"name": lam_params[pi], "type": p_ty})
    ctr = slot_get_number("otir:nlam_ctr")
    slot_set("otir:nlam_ctr", ctr + 1)
    synth_name = "__nlambda_{ctr}"
    edit synth_stmts = part([lam_body], 0, 0)
    loop ci in 0 until n_caps:
        cap_slot = 2 + ci
        at_call = {"kind": "Call", "callee": "at", "args": [{"kind": "Ident", "name": "__env"}, {"kind": "Int", "value": "{cap_slot}"}]}
        synth_stmts = append(synth_stmts, {"kind": "LetOrAssign", "name": caps[ci], "value": at_call})
    synth_stmts = append(synth_stmts, {"kind": "ExprStmt", "expr": lam_body})
    synth_body = {"kind": "Block", "stmts": synth_stmts}
    # The hoisted function inherits the LAMBDA's position: a return-type
    # complaint about `__nlambda_3` is unreadable without it, and printed
    # `at line 0:0`.
    synth_decl = {"kind": "Fn", "name": synth_name, "params": typed_params, "ret": num_lambda_ret(lam), "body": synth_body, "line": if has(lam, "line") then get_int(lam, "line") else 0, "col": if has(lam, "col") then get_int(lam, "col") else 0}
    edit cap_nodes = part([lam], 0, 0)
    loop cj in 0 until n_caps:
        # The capture reference at the CLOSURE-CONSTRUCTION site. Without a
        # position, an error about a free variable inside a lambda (an
        # undefined name, say) reported `line 0:0` - the lambda's own position
        # is the honest answer.
        cap_nodes = append(cap_nodes, {"kind": "Ident", "name": caps[cj], "line": if has(lam, "line") then get_int(lam, "line") else 0, "col": if has(lam, "col") then get_int(lam, "col") else 0})
    closure = {"kind": "MakeClosure", "fn": synth_name, "caps": cap_nodes, "is_lambda": 1}
    {"closure": closure, "decl": synth_decl}

# Lift lambdas inside an expression; return {node: rewritten, synths: [Fn]}.
define nlam_lift(node: table) -> table:
    kind = get(node, "kind")
    edit synths = part([node], 0, 0)
    if kind is "Lambda":
        s = nlam_synth(node)
        synths = append(synths, get(s, "decl"))
        return {"node": get(s, "closure"), "synths": synths}
    edit out = node
    if kind is "Call":
        args = get_list(node, "args")
        edit new_args = part(args, 0, 0)
        loop i in 0 until length(args):
            ar = nlam_lift(args[i])
            new_args = append(new_args, get(ar, "node"))
            ars = get_list(ar, "synths")
            loop j in 0 until length(ars):
                synths = append(synths, ars[j])
        out = set(out, "args", new_args)
    if kind is "Binary":
        lr = nlam_lift(get(node, "left"))
        rr = nlam_lift(get(node, "right"))
        out = set(out, "left", get(lr, "node"))
        out = set(out, "right", get(rr, "node"))
        loop j in 0 until length(get_list(lr, "synths")):
            synths = append(synths, get_list(lr, "synths")[j])
        loop j in 0 until length(get_list(rr, "synths")):
            synths = append(synths, get_list(rr, "synths")[j])
    # `not any(xs, (x): ...)` - a lambda under a unary operator.
    if kind is "Unary":
        ur = nlam_lift(get(node, "operand"))
        out = set(out, "operand", get(ur, "node"))
        ursyn = get_list(ur, "synths")
        loop uj in 0 until length(ursyn):
            synths = append(synths, ursyn[uj])
    # A lambda can sit in a struct-construction FIELD (`order{less: (a, b): a > b}`)
    # or behind a named argument - both were invisible to the lift and died in
    # lowering as "unhandled AST node kind Lambda".
    if kind is "StructCons":
        scf = get_list(node, "fields")
        edit new_scf = part(scf, 0, 0)
        loop sci in 0 until length(scf):
            scp = scf[sci]
            scv = nlam_lift(get_map(scp, "value"))
            new_scf = append(new_scf, set(scp, "value", get(scv, "node")))
            scs = get_list(scv, "synths")
            loop scj in 0 until length(scs):
                synths = append(synths, scs[scj])
        out = set(out, "fields", new_scf)
    if kind is "NamedArg":
        nav = nlam_lift(get_map(node, "value"))
        out = set(out, "value", get(nav, "node"))
        navs = get_list(nav, "synths")
        loop naj in 0 until length(navs):
            synths = append(synths, navs[naj])
    # An if-EXPRESSION, in all three places. `if length(keep(xs, (x): x > 2))
    # is 2 then ...` died as "unhandled AST node kind Lambda": the lift walked
    # calls and operators but never went into an `if`, so the lambda in the
    # condition was still a lambda when the lowering met it. Every `example`
    # line the checker wraps is `if <claim> then 0 else 1`, which is how three
    # of `iter`'s own examples had been failing.
    if kind is "If":
        ifc = nlam_lift(get_map(node, "cond"))
        ift = nlam_lift(get_map(node, "then"))
        ife = nlam_lift(get_map(node, "else"))
        out = set(set(set(out, "cond", get(ifc, "node")), "then", get(ift, "node")), "else", get(ife, "node"))
        loop ifj in 0 until length(get_list(ifc, "synths")):
            synths = append(synths, get_list(ifc, "synths")[ifj])
        loop ifj2 in 0 until length(get_list(ift, "synths")):
            synths = append(synths, get_list(ift, "synths")[ifj2])
        loop ifj3 in 0 until length(get_list(ife, "synths")):
            synths = append(synths, get_list(ife, "synths")[ifj3])
    # And a lambda handed to an effect, or sitting in a list literal.
    if kind is "Index":
        ixo = nlam_lift(get_map(node, "object"))
        ixi = nlam_lift(get_map(node, "index"))
        out = set(set(out, "object", get(ixo, "node")), "index", get(ixi, "node"))
        loop ixj in 0 until length(get_list(ixo, "synths")):
            synths = append(synths, get_list(ixo, "synths")[ixj])
        loop ixj2 in 0 until length(get_list(ixi, "synths")):
            synths = append(synths, get_list(ixi, "synths")[ixj2])
    if kind is "Field" or kind is "Question":
        qk = if kind is "Field" then "object" else "inner"
        qr = nlam_lift(get_map(node, qk))
        out = set(out, qk, get(qr, "node"))
        loop qj in 0 until length(get_list(qr, "synths")):
            synths = append(synths, get_list(qr, "synths")[qj])
    if kind is "Perform" or kind is "ListLit" or kind is "Tuple":
        lk = if kind is "Perform" then "args" else "items"
        lsrc = get_list(node, lk)
        edit new_l = part(lsrc, 0, 0)
        loop li in 0 until length(lsrc):
            lr2 = nlam_lift(lsrc[li])
            new_l = append(new_l, get(lr2, "node"))
            lrs = get_list(lr2, "synths")
            loop lj in 0 until length(lrs):
                synths = append(synths, lrs[lj])
        out = set(out, lk, new_l)
    {"node": out, "synths": synths}

# Lift lambdas in a statement's expression field. Returns {stmt, synths}.
define nlam_lift_stmt(stmt: table) -> table:
    kind = get(stmt, "kind")
    edit out = stmt
    edit synths = part([stmt], 0, 0)
    edit fld = ""
    if kind is "MutLet" or kind is "LetOrAssign":
        fld = "value"
    if kind is "ExprStmt" or kind is "Return" or kind is "Require" or kind is "Ensure" or kind is "Defer":
        fld = "expr"
    if fld is not "":
        r = nlam_lift(get(stmt, fld))
        out = set(out, fld, get(r, "node"))
        synths = get_list(r, "synths")
    # A bare if-EXPRESSION as a statement - which is what a function's tail is
    # when it ends `if cond then a else b`. It has no `expr` field to reach
    # through; the statement IS the expression. Every `example` line the
    # checker wraps looks exactly like this, which is how three of `iter`'s own
    # examples had been failing.
    if kind is "If" or kind is "Match":
        ir2 = nlam_lift(stmt)
        out = get_map(ir2, "node")
        synths = get_list(ir2, "synths")
    # Recurse into nested block bodies so a lambda inside a for/loop/if body
    # (e.g. `for i in ...: g = function(n): n + i`) is lifted too.
    if kind is "Loop" or kind is "ForRange" or kind is "ForIn":
        br = nlam_lift_block(get(stmt, "body"))
        out = set(out, "body", get(br, "block"))
        edit lpsyn = get_list(br, "synths")
        # A lambda can live in the ITERABLE too: `loop x in keep(xs, (n): ...)`.
        if kind is "ForIn":
            itr = nlam_lift(get(stmt, "iter"))
            out = set(out, "iter", get(itr, "node"))
            itsyn = get_list(itr, "synths")
            loop itj in 0 until length(itsyn):
                lpsyn = append(lpsyn, itsyn[itj])
        if kind is "ForRange":
            lor = nlam_lift(get(stmt, "low"))
            hir = nlam_lift(get(stmt, "high"))
            out = set(out, "low", get(lor, "node"))
            out = set(out, "high", get(hir, "node"))
            losyn = get_list(lor, "synths")
            loop loj in 0 until length(losyn):
                lpsyn = append(lpsyn, losyn[loj])
            hisyn = get_list(hir, "synths")
            loop hij in 0 until length(hisyn):
                lpsyn = append(lpsyn, hisyn[hij])
        synths = lpsyn
    if kind is "IfBlock":
        # The CONDITION expression was never walked - a lambda inside a call
        # in `if each(xs, (x): ...)[1] is 4:` died as "unhandled Lambda".
        cnd = nlam_lift(get(stmt, "cond"))
        out = set(out, "cond", get(cnd, "node"))
        tr = nlam_lift_block(get(stmt, "then"))
        out = set(out, "then", get(tr, "block"))
        edit ifsyn = get_list(cnd, "synths")
        trsyn = get_list(tr, "synths")
        loop trj in 0 until length(trsyn):
            ifsyn = append(ifsyn, trsyn[trj])
        els = get(stmt, "else")
        if get(els, "kind") is "Block":
            er = nlam_lift_block(els)
            out = set(out, "else", get(er, "block"))
            ersyn = get_list(er, "synths")
            loop ej in 0 until length(ersyn):
                ifsyn = append(ifsyn, ersyn[ej])
        if get(els, "kind") is "IfBlock":
            er2 = nlam_lift_stmt(els)
            out = set(out, "else", get(er2, "stmt"))
            ersyn2 = get_list(er2, "synths")
            loop ej2 in 0 until length(ersyn2):
                ifsyn = append(ifsyn, ersyn2[ej2])
        synths = ifsyn
    {"stmt": out, "synths": synths}

# Lift lambdas in every statement of a block. Returns {block, synths}.
define nlam_lift_block(block: table) -> table:
    stmts = get_list(block, "stmts")
    edit out_stmts = part(stmts, 0, 0)
    edit synths = part([block], 0, 0)
    loop i in 0 until length(stmts):
        r = nlam_lift_stmt(stmts[i])
        out_stmts = append(out_stmts, get(r, "stmt"))
        rs = get_list(r, "synths")
        loop j in 0 until length(rs):
            synths = append(synths, rs[j])
    {"block": set(block, "stmts", out_stmts), "synths": synths}

# Does this expression contain a lambda (nested in a call arg / operand)?
define nlam_has(node: table) -> truth:
    kind = get(node, "kind")
    edit found = false
    if kind is "Lambda":
        found = true
    if kind is "Call":
        args = get_list(node, "args")
        loop i in 0 until length(args):
            if nlam_has(args[i]):
                found = true
    if kind is "Binary":
        if nlam_has(get(node, "left")):
            found = true
        if nlam_has(get(node, "right")):
            found = true
    if kind is "Unary":
        if nlam_has(get(node, "operand")):
            found = true
    if kind is "StructCons":
        scf = get_list(node, "fields")
        loop i in 0 until length(scf):
            if nlam_has(get_map(scf[i], "value")):
                found = true
    if kind is "NamedArg":
        if nlam_has(get_map(node, "value")):
            found = true
    # The same three shapes the LIFT walks. This is the gate in front of it:
    # the lift can know how to go into an `if` and never be asked to, which is
    # exactly what happened - `nlam_lift` grew the case and nothing changed
    # until this one did too. Two lists of node kinds that have to agree, and
    # the only sign they disagree is a lambda reaching the lowering.
    if kind is "If":
        if nlam_has(get_map(node, "cond")):
            found = true
        if nlam_has(get_map(node, "then")):
            found = true
        if nlam_has(get_map(node, "else")):
            found = true
    if kind is "Perform" or kind is "ListLit" or kind is "Tuple":
        hk = if kind is "Perform" then "args" else "items"
        loop hn in get_list(node, hk):
            if nlam_has(hn):
                found = true
    # `each(xs, (x): ...)[1]` - the lambda is under an INDEX. Same for a field
    # read and a `?`.
    if kind is "Index":
        if nlam_has(get_map(node, "object")):
            found = true
        if nlam_has(get_map(node, "index")):
            found = true
    if kind is "Field":
        if nlam_has(get_map(node, "object")):
            found = true
    if kind is "Question":
        if nlam_has(get_map(node, "inner")):
            found = true
    found

# Does a statement (or a nested block it holds) contain a lambda?
define nlam_stmt_has(stmt: table) -> truth:
    kind = get(stmt, "kind")
    edit found = false
    if kind is "MutLet" or kind is "LetOrAssign":
        found = nlam_has(get(stmt, "value"))
    if kind is "ExprStmt" or kind is "Return" or kind is "Require" or kind is "Ensure" or kind is "Defer":
        found = nlam_has(get(stmt, "expr"))
    if kind is "Loop" or kind is "ForRange" or kind is "ForIn":
        if nlam_block_has(get(stmt, "body")):
            found = true
        if kind is "ForIn":
            if nlam_has(get(stmt, "iter")):
                found = true
        if kind is "ForRange":
            if nlam_has(get(stmt, "low")):
                found = true
            if nlam_has(get(stmt, "high")):
                found = true
    if kind is "IfBlock":
        if nlam_has(get(stmt, "cond")):
            found = true
        if nlam_block_has(get(stmt, "then")):
            found = true
        els = get(stmt, "else")
        if get(els, "kind") is "Block":
            if nlam_block_has(els):
                found = true
        if get(els, "kind") is "IfBlock":
            if nlam_stmt_has(els):
                found = true
    found

define nlam_block_has(block: table) -> truth:
    stmts = get_list(block, "stmts")
    edit found = false
    loop i in 0 until length(stmts):
        if nlam_stmt_has(stmts[i]):
            found = true
    found


define upp_is_ident(node: table, name: text) -> truth:
    get(node, "kind") is "Ident" and get(node, "name") is name

define upp_is_reader(callee: text) -> truth:
    # slice belongs here: it reads its list and allocates a NEW one (value
    # semantics, no views) - the way to hand ONE cell of a promoted
    # accumulator to another function without losing the promotion.
    callee is "length" or callee is "at" or callee is "get" or callee is "get_int" or callee is "get_map" or callee is "get_list" or callee is "get_text_list" or callee is "get_int_list" or callee is "has" or callee is "contains" or callee is "byte_at" or callee is "bytes_count" or callee is "part"

define upp_fresh(val: table, name: text) -> truth:
    k = get(val, "kind")
    if k is "ListLit":
        true
    else if k is "Call":
        callee = get(val, "callee")
        if callee is "push" or callee is "append":
            true
        else if callee is "part":
            # `part(xs, a, b)` always allocates a NEW list (value semantics,
            # no views), so the result is unaliased whatever xs is. This is
            # the compiler's own dominant accumulator idiom
            # (`edit out = part(stmts, 0, 0)`) - without it, none of those
            # loops promoted and the self-compile went quadratic.
            true
        else if callee is "__push_inplace":
            args = get_list(val, "args")
            length(args) > 0 and upp_is_ident(args[0], name)
        else:
            false
    else:
        false

define upp_bad_list(items: [table], name: text) -> number:
    edit bad = 0
    loop i in 0 until length(items):
        bad = bad + upp_bad_expr(items[i], name)
    bad

define upp_bad_pairs(pairs: [table], name: text) -> number:
    edit bad = 0
    loop i in 0 until length(pairs):
        bad = bad + upp_bad_expr(get_map(pairs[i], "value"), name)
    bad

define upp_bad_arms(arms: [table], name: text) -> number:
    edit bad = 0
    loop i in 0 until length(arms):
        a = arms[i]
        if has(a, "guard"):
            bad = bad + upp_bad_expr(get_map(a, "guard"), name)
        b = get_map(a, "body")
        if get(b, "kind") is "Block":
            bad = bad + upp_bad_block(b, name)
        else:
            bad = bad + upp_bad_expr(b, name)
    bad

define upp_bad_expr(node: table, name: text) -> number:
    kind = get(node, "kind")
    if kind is "Ident":
        if get(node, "name") is name then 1 else 0
    else if kind is "Int" or kind is "Str" or kind is "Float" or kind is "Range":
        0
    else if kind is "Call":
        callee = get(node, "callee")
        args = get_list(node, "args")
        na = length(args)
        safe0 = (callee is "push" or callee is "append" or callee is "__push_inplace" or upp_is_reader(callee)) and na > 0 and upp_is_ident(args[0], name)
        start = if safe0 then 1 else 0
        edit bad = 0
        loop i in start until na:
            bad = bad + upp_bad_expr(args[i], name)
        bad
    else if kind is "Binary":
        upp_bad_expr(get_map(node, "left"), name) + upp_bad_expr(get_map(node, "right"), name)
    else if kind is "Unary":
        upp_bad_expr(get_map(node, "operand"), name)
    else if kind is "MethodCall":
        edit bad = upp_bad_expr(get_map(node, "receiver"), name)
        args = get_list(node, "args")
        loop i in 0 until length(args):
            bad = bad + upp_bad_expr(args[i], name)
        bad
    else if kind is "Perform":
        upp_bad_list(get_list(node, "args"), name)
    else if kind is "Field":
        upp_bad_expr(get_map(node, "object"), name)
    else if kind is "Index":
        # Reading `xs[i]` is a READ, exactly like `at(xs, i)` which is already
        # counted safe. It cannot alias anything: an element comes out by
        # value and the list stays where it was.
        #
        # Counting it as an ordinary use is what turned every loop that both
        # FILLS an accumulator and reads back out of it into a copy of the
        # whole list per append. Quadratic, and invisible - the same loop
        # written with at() was linear. Veil's placement spent 709 of its 746
        # milliseconds there with twenty thousand children, and three
        # reproductions of the loop outside it all came out linear because
        # they happened to use at().
        indexed = get_map(node, "object")
        upp_bad_expr(get_map(node, "index"), name) + (if upp_is_ident(indexed, name) then 0 else upp_bad_expr(indexed, name))
    else if kind is "Question":
        upp_bad_expr(get_map(node, "inner"), name)
    else if kind is "If":
        upp_bad_expr(get_map(node, "cond"), name) + upp_bad_expr(get_map(node, "then"), name) + upp_bad_expr(get_map(node, "else"), name)
    else if kind is "ListLit":
        upp_bad_list(get_list(node, "items"), name)
    else if kind is "Tuple":
        upp_bad_list(get_list(node, "items"), name)
    else if kind is "NamedArg":
        upp_bad_expr(get_map(node, "value"), name)
    else if kind is "MapLit":
        upp_bad_pairs(get_list(node, "pairs"), name)
    else if kind is "StructCons":
        upp_bad_pairs(get_list(node, "fields"), name)
    else if kind is "Match":
        upp_bad_expr(get_map(node, "scrutinee"), name) + upp_bad_arms(get_list(node, "arms"), name)
    else:
        1000000

define upp_bad_else(els: table, name: text) -> number:
    k = get(els, "kind")
    if k is "Block":
        upp_bad_block(els, name)
    else if k is "IfBlock":
        upp_bad_stmt(els, name)
    else:
        0

define upp_bad_stmt(s: table, name: text) -> number:
    kind = get(s, "kind")
    if kind is "MutLet" or kind is "LetOrAssign":
        val = get_map(s, "value")
        if get(s, "name") is name:
            fresh_bad = if upp_fresh(val, name) then 0 else 1000000
            fresh_bad + upp_bad_expr(val, name)
        else:
            upp_bad_expr(val, name)
    else if kind is "ExprStmt":
        e = get_map(s, "expr")
        if upp_is_ident(e, name) then 0 else upp_bad_expr(e, name)
    else if kind is "Return":
        e = get_map(s, "expr")
        if upp_is_ident(e, name) then 0 else upp_bad_expr(e, name)
    else if kind is "Example":
        0
    else if kind is "Require" or kind is "Ensure" or kind is "Defer":
        upp_bad_expr(get_map(s, "expr"), name)
    else if kind is "Loop":
        upp_bad_block(get_map(s, "body"), name)
    else if kind is "ForRange":
        upp_bad_expr(get_map(s, "low"), name) + upp_bad_expr(get_map(s, "high"), name) + upp_bad_block(get_map(s, "body"), name)
    else if kind is "ForIn":
        upp_bad_expr(get_map(s, "iter"), name) + upp_bad_block(get_map(s, "body"), name)
    else if kind is "IfBlock":
        upp_bad_expr(get_map(s, "cond"), name) + upp_bad_block(get_map(s, "then"), name) + upp_bad_else(get_map(s, "else"), name)
    else if kind is "Match":
        upp_bad_expr(get_map(s, "scrutinee"), name) + upp_bad_arms(get_list(s, "arms"), name)
    else if kind is "Break" or kind is "Continue":
        0
    else:
        1000000

define upp_bad_block(block: table, name: text) -> number:
    stmts = get_list(block, "stmts")
    edit bad = 0
    loop i in 0 until length(stmts):
        bad = bad + upp_bad_stmt(stmts[i], name)
    bad

define upp_mut_names(block: table, acc0: [text]) -> [text]:
    stmts = get_list(block, "stmts")
    edit acc = acc0
    loop i in 0 until length(stmts):
        s = stmts[i]
        k = get(s, "kind")
        if k is "MutLet":
            acc = append(acc, get(s, "name"))
        else if k is "Loop":
            acc = upp_mut_names(get_map(s, "body"), acc)
        else if k is "ForRange" or k is "ForIn":
            acc = upp_mut_names(get_map(s, "body"), acc)
        else if k is "IfBlock":
            acc = upp_mut_names(get_map(s, "then"), acc)
            els = get_map(s, "else")
            if get(els, "kind") is "Block":
                acc = upp_mut_names(els, acc)
            else if get(els, "kind") is "IfBlock":
                acc = upp_mut_names_stmt(els, acc)
        else if k is "Match":
            arms = get_list(s, "arms")
            loop ai in 0 until length(arms):
                b = get_map(arms[ai], "body")
                if get(b, "kind") is "Block":
                    acc = upp_mut_names(b, acc)
    acc

define upp_mut_names_stmt(s: table, acc0: [text]) -> [text]:
    edit acc = upp_mut_names(get_map(s, "then"), acc0)
    els = get_map(s, "else")
    if get(els, "kind") is "Block":
        acc = upp_mut_names(els, acc)
    else if get(els, "kind") is "IfBlock":
        acc = upp_mut_names_stmt(els, acc)
    acc

define upp_contains_name(names: [text], name: text) -> truth:
    edit f = false
    loop i in 0 until length(names):
        if names[i] is name:
            f = true
    f

define upp_is_self_push(value: table, name: text) -> truth:
    if get(value, "kind") is not "Call":
        false
    else:
        args = get_list(value, "args")
        (get(value, "callee") is "push" or get(value, "callee") is "append") and length(args) > 0 and upp_is_ident(args[0], name)

define upp_promote_stmt(s: table, uniq: [text]) -> table:
    kind = get(s, "kind")
    edit out = s
    if kind is "LetOrAssign":
        nm = get(s, "name")
        val = get_map(s, "value")
        if upp_contains_name(uniq, nm) and upp_is_self_push(val, nm):
            out = set(out, "value", set(val, "callee", "__push_inplace"))
    else if kind is "Loop":
        out = set(out, "body", upp_promote_block(get_map(s, "body"), uniq))
    else if kind is "ForRange" or kind is "ForIn":
        out = set(out, "body", upp_promote_block(get_map(s, "body"), uniq))
    else if kind is "IfBlock":
        out = set(out, "then", upp_promote_block(get_map(s, "then"), uniq))
        els = get_map(s, "else")
        if get(els, "kind") is "Block":
            out = set(out, "else", upp_promote_block(els, uniq))
        else if get(els, "kind") is "IfBlock":
            out = set(out, "else", upp_promote_stmt(els, uniq))
    else if kind is "Match":
        arms = get_list(s, "arms")
        edit new_arms = part(arms, 0, 0)
        loop ai in 0 until length(arms):
            a = arms[ai]
            b = get_map(a, "body")
            nb = if get(b, "kind") is "Block" then upp_promote_block(b, uniq) else b
            new_arms = append(new_arms, set(a, "body", nb))
        out = set(out, "arms", new_arms)
    out

define upp_promote_block(block: table, uniq: [text]) -> table:
    stmts = get_list(block, "stmts")
    edit out = part(stmts, 0, 0)
    loop i in 0 until length(stmts):
        out = append(out, upp_promote_stmt(stmts[i], uniq))
    set(block, "stmts", out)

# Does this statement's subtree contain a self-push `name = append(name, v)`?
define upp_stmt_has_self_push(s: table, name: text) -> truth:
    kind = get(s, "kind")
    if kind is "LetOrAssign":
        get(s, "name") is name and upp_is_self_push(get_map(s, "value"), name)
    else if kind is "Loop" or kind is "ForRange" or kind is "ForIn":
        upp_block_has_self_push(get_map(s, "body"), name)
    else if kind is "IfBlock":
        edit found = upp_block_has_self_push(get_map(s, "then"), name)
        els = get_map(s, "else")
        if get(els, "kind") is "Block":
            found = found or upp_block_has_self_push(els, name)
        else if get(els, "kind") is "IfBlock":
            found = found or upp_stmt_has_self_push(els, name)
        found
    else if kind is "Match":
        arms = get_list(s, "arms")
        edit found = false
        loop ai in 0 until length(arms):
            b = get_map(arms[ai], "body")
            if get(b, "kind") is "Block":
                found = found or upp_block_has_self_push(b, name)
        found
    else:
        false

define upp_block_has_self_push(block: table, name: text) -> truth:
    stmts = get_list(block, "stmts")
    edit found = false
    loop i in 0 until length(stmts):
        found = found or upp_stmt_has_self_push(stmts[i], name)
    found

# ORDER-AWARE uniqueness: every use up to and including the LAST top-level
# statement that self-pushes `name` must be safe. Statements AFTER that may
# do anything with it (pass it to a constructor, return it inside a value):
# promotion only changes what the pushes do, and they have all happened by
# then. A later `set` behaves identically with or without promotion (list
# set is in-place either way), so order is all that matters. This is what
# lets the standard accumulator shape promote:
#     edit acc = []
#     loop x in xs: acc = append(acc, f(x))
#     ListV(acc)                      <- escape AFTER the pushes: fine
define upp_safe_ordered(body: table, name: text) -> truth:
    if not upp_block_has_self_push(body, name):
        return false
    upp_ordered_block(body, name)

# The same rule inside a block that is not a loop.
#
# A function body runs once, so "everything up to the last push must be safe"
# is sound there. It is sound in an `if` too, for the same reason - but the
# rule only ever looked at the function's own top level, so the single
# commonest shape in this compiler lost its promotion:
#
#     if is_alias:
#         ""
#     else:
#         edit chunks = []
#         loop ...: chunks = append(chunks, ...)
#         orion_text_join(chunks)          <- after the pushes, and still bad
#
# The join is a use of the whole list, and being inside the same `else` as the
# pushes made it count. Now the branch is read in order like anything else.
#
# A LOOP is different and stays strict: what comes after the last push on one
# turn comes BEFORE the pushes on the next, so order says nothing there.
define upp_ordered_block(block: table, name: text) -> truth:
    stmts = get_list(block, "stmts")
    n = length(stmts)
    edit last_push = 0 - 1
    loop i in 0 until n:
        if upp_stmt_has_self_push(stmts[i], name):
            last_push = i
    if last_push < 0:
        return upp_bad_block(block, name) is 0
    edit ok = true
    loop i in 0 until n:
        if i <= last_push:
            if not upp_ordered_stmt(stmts[i], name):
                ok = false
    ok

define upp_ordered_stmt(s: table, name: text) -> truth:
    kind = get(s, "kind")
    if kind is "IfBlock":
        # Only the branches, and each in order. The condition still counts.
        if upp_bad_expr(get_map(s, "cond"), name) is not 0:
            return false
        edit fine = upp_ordered_block(get_map(s, "then"), name)
        els = get_map(s, "else")
        if get(els, "kind") is "Block":
            if not upp_ordered_block(els, name):
                fine = false
        else if get(els, "kind") is "IfBlock":
            if not upp_ordered_stmt(els, name):
                fine = false
        fine
    else:
        upp_bad_stmt(s, name) is 0

# --- a list that is copied on every append -----------------------------------
#
# A list only grows where it stands while the compiler can see that nobody
# else holds it. When it cannot, every `append` copies the whole list, and a
# loop that fills ten thousand entries does fifty million element copies
# instead of ten thousand. Nothing says so: the program is correct, the loop
# looks the same, and it is quadratic.
#
# That is exactly what happened to veil's layout - 739 milliseconds to place
# twenty thousand children, and three attempts to reproduce it in isolation
# all came out linear because they happened to be written slightly
# differently. So the compiler says it now, in one line, the way it already
# says how many slot stores have no copier.
define slowfact_get(what: text) -> number:
    if slot_has("upp:{what}") then slot_get_number("upp:{what}") else 0

define slowfact_note(fn_name: text, var_name: text):
    n = slowfact_get("copies")
    slot_set("upp:copies", n + 1)
    slot_set("upp:where:{n}", "{var_name} in {fn_name}")

# What was counted, in one line next to the timings. Anything longer is noise
# on a build that is fine, and noise is how a real warning gets missed.
public define slowfacts_report():
    n = slowfact_get("copies")
    if n is 0:
        return 0
    first = if slot_has("upp:where:0") then slot_get("upp:where:0") else ""
    if n is 1:
        print_line("  speed: 1 list is copied on every append ({first})")
    else:
        print_line("  speed: {n} lists are copied on every append, first {first} (`orion <file> slowfacts` to list)")
    0

public define slowfacts_list() -> number:
    n = slowfact_get("copies")
    print_line("")
    print_line("Lists copied on every append - each one is a loop that is")
    print_line("quadratic in how much it collects. A list grows where it stands")
    print_line("only while nothing else can be holding it, so the fix is one of:")
    print_line("  - read it with xs[i] or at(xs, i), never hand the whole list")
    print_line("    to another function while it is still being filled")
    print_line("  - if something must read all of it, sum or scan in the same")
    print_line("    loop that fills it")
    print_line("")
    loop i in 0 until n:
        where = if slot_has("upp:where:{i}") then slot_get("upp:where:{i}") else ""
        print_line("  {where}")
    n

# Per-function: keep the mut locals proven unique, rewrite their self-pushes.
define upp_promote_fn(body: table, fn_name: text) -> table:
    cands = upp_mut_names(body, part([""], 0, 0))
    edit uniq = part([""], 0, 0)
    loop i in 0 until length(cands):
        nm = cands[i]
        if (not upp_contains_name(uniq, nm)) and upp_safe_ordered(body, nm):
            uniq = append(uniq, nm)
        else:
            # It pushes to itself and could not be promoted: that is the
            # quadratic, and it is worth a word.
            if (not upp_contains_name(uniq, nm)) and upp_block_has_self_push(body, nm):
                slowfact_note(fn_name, nm)
    if length(uniq) is 0:
        body
    else:
        upp_promote_block(body, uniq)


# ---- `number` picks its representation ----
#
# `number` is the word a person writes; i64 or f64 is what the machine gets.
# Which one is decided HERE, once, for the whole program - Orion concatenates
# every orb into one text before this runs, so there is no separate-compilation
# boundary to guess across.
#
# The rule runs one direction only: a site is WHOLE until something real
# reaches it. A fractional literal, a `/` (which is real division in this
# language), or a value already known real makes it real, and that travels
# along arguments and returns until a round changes nothing. Whole is the
# floor, so the answer never depends on the order the program is walked.
#
# Over-approximating is safe and under-approximating is not: calling a site
# real when it could have been whole costs speed, calling it whole when a
# fraction reaches it would round someone's number without saying so. Every
# unsure case here answers real.
#
# WIDTHS - i32, u8, f32 - are NOT decided here. Narrowing a whole number to a
# width that fits is an optimisation that never changes an answer; choosing
# between whole and real is the semantics. One pass for the correctness
# question, a later one for the performance question.

# Every key carries the compile EPOCH. One process compiles many programs (the
# test runner does two hundred), and a decision left over from the last one
# would answer for a function this one never declared.
define num_k_var(fn_name: text, name: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:v:{fn_name}:{name}"

define num_k_ret(fn_name: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:r:{fn_name}"

define num_k_pnum(fn_name: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:pn:{fn_name}:{i}"

# A FIELD site, keyed by the field NAME alone rather than by type-and-name.
# A read `c.hi` does not say which type `c` is - the pass runs before anything
# resolves that - so the name is what both ends can agree on. Two types that
# share a field name share its answer, which over-approximates, which is the
# safe direction.
define num_k_field(field: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:f:{field}"

# The ELEMENT site of a list. `xs: [number]` is two questions - what the
# binding is, and what it holds - and only the second one has an answer here.
# Which SLOT KEY was written with a real number. A slot holds one 64-bit word
# and takes a double as its bits, so the read has to know which way to look at
# it - and the only thing that says so is the write.
#
# Keyed by the key EXPRESSION as written: the local that holds it, or the
# literal itself. Per function, because `kv` is a name half the corpus uses and
# a mark that crossed functions would answer for somebody else's slot.
define num_k_slot(fn_name: text, key_name: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:slot:{fn_name}:{key_name}"

# The key as a name to remember it by, or "" when it is neither a local nor a
# literal - an interpolation built inline, say, which nothing can match up.
define num_slot_key(node: table) -> text:
    if get(node, "kind") is "Ident":
        get(node, "name")
    else if get(node, "kind") is "Str":
        "lit:" + get(node, "value")
    else:
        ""

define num_k_elem(fn_name: text, name: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:e:{fn_name}:{name}"

# Is parameter `i` of `fn_name` a `[number]`?
define num_k_lpnum(fn_name: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:lp:{fn_name}:{i}"

# The element site of the list a function ANSWERS with.
define num_k_eret(fn_name: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:er:{fn_name}"

# A FUNCTION-TYPED FIELD's parts. Keyed by the field name, like every other
# field site - a read `d.roll(9)` does not say which type `d` is.
define num_k_ffret(field: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:ffr:{field}"

define num_k_ffpar(field: text, j: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:ffp:{field}:{j}"

# A TUPLE ELEMENT site. `-> (number, number)` is two questions, one per
# position, and they get separate answers - unlike a list, whose elements
# share one. Destructuring reads `temp[i]` with a literal `i`, so the position
# is known on both sides.
define num_k_tret(fn_name: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:tr:{fn_name}:{i}"

define num_k_tvar(fn_name: text, name: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:tv:{fn_name}:{name}:{i}"

# Does `fn_name` answer with a tuple carrying `number`?
define num_k_tnum(fn_name: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:tn:{fn_name}"

# A VARIANT PAYLOAD site: `type json: JBool(number)`. Keyed by the variant
# name, which the language already treats as globally unique - two enums
# sharing one is a hard error at the call, not a silent pick.
define num_k_vpay(variant: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:vp:{variant}:{i}"

# Is payload slot `i` of `variant` declared `number`?
define num_k_vpnum(variant: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:vpn:{variant}:{i}"

# A FUNCTION-TYPED parameter's parts: `f: function(number) -> number`. The
# site is not a value this pass can look inside - it is whatever function gets
# passed - so the two are UNIFIED at the call, the same way a list and its
# parameter are. A call `f(x)` reads its result type off this annotation, so
# an annotation that disagreed with the function answered with the wrong
# machine type and nothing said a word.
define num_k_ftret(fn_name: text, pname: text) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:ftr:{fn_name}:{pname}"

define num_k_ftpar(fn_name: text, pname: text, j: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:ftp:{fn_name}:{pname}:{j}"

# Is parameter `i` of `fn_name` a function type carrying `number`?
# A tuple-typed parameter: "this parameter is a tuple", by index.
define num_k_tpnum(fn_name: text, i: number) -> text:
    "num:tpnum:{fn_name}:{i}"

define num_k_fpnum(fn_name: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:fp:{fn_name}:{i}"

# `[number]` / `list of number` - the parser builds one node for both.
define num_is_number_list(t: table) -> truth:
    get(t, "kind") is "List" and num_is_number(get(t, "elem"))

# `table of number`. A table's VALUES are the same question a list's elements
# are - what does this thing hold - so they share the site, and `set(m, k, v)`
# was already marking it.
define num_is_number_table(t: table) -> truth:
    if get(t, "kind") is not "Named":
        return false
    if get(t, "name") is not "table" and get(t, "name") is not "map":
        return false
    ta = if has(t, "args") then get_list(t, "args") else []
    length(ta) is 1 and num_is_number(ta[0])

# Does this expression denote a list whose elements are real? A literal says
# so outright, a name and a call carry the answer their site got.
define num_elem_real(node: table, fn_name: text) -> truth:
    kind = get(node, "kind")
    edit real = false
    if kind is "ListLit":
        loop it in get_list(node, "items"):
            if num_expr_real(it, fn_name):
                real = true
    if kind is "MapLit":
        loop pr in get_list(node, "pairs"):
            if num_expr_real(get(pr, "value"), fn_name):
                real = true
    if kind is "Ident":
        real = slot_has(num_k_elem(fn_name, get(node, "name")))
    if kind is "Call":
        real = slot_has(num_k_eret(get(node, "callee")))
    real

define num_k_pname(fn_name: text, i: number) -> text:
    "num:{slot_int_or_zero(\"otir:ep\")}:pnm:{fn_name}:{i}"

# Is this type node the word `number`?
define num_is_number(t: table) -> truth:
    if get(t, "kind") is not "Named":
        false
    else:
        nm = get(t, "name")
        if nm is "number":
            true
        else:
            # `type M = number`. The alias pass runs before this one and keeps
            # the source word, so a site spelled `M` asks the same question a
            # site spelled `number` does - otherwise `edit d: M = 5` froze the
            # slot as f64 and stored a whole 5 into it as raw bits.
            src_key = otir_k1("tyaliassrc", nm)
            slot_has(src_key) and slot_get(src_key) is "number"

# Mark a site real, and note that this round changed something.
define num_mark(key: text):
    if not slot_has(key):
        slot_set(key, 1)
        slot_set("num:changed", 1)

# Does a real value flow out of this expression? Consults what is known so
# far, so the caller has to iterate until a round marks nothing new.
define num_expr_real(node: table, fn_name: text) -> truth:
    kind = get(node, "kind")
    edit real = false
    if kind is "Float":
        real = true
    if kind is "Binary":
        op = get(node, "op")
        # `/` is real division: 10 / 4 is 2.5, and that is the whole reason
        # `//` exists next to it.
        if op is "/":
            real = true
        if op is not "/":
            real = num_expr_real(get(node, "left"), fn_name) or num_expr_real(get(node, "right"), fn_name)
    if kind is "Unary":
        real = num_expr_real(get(node, "operand"), fn_name)
    if kind is "Ident":
        real = slot_has(num_k_var(fn_name, get(node, "name")))
    if kind is "Call":
        real = slot_has(num_k_ret(get(node, "callee")))
        # `f(x)` where f is this function's own function-typed parameter.
        if slot_has(num_k_ftret(fn_name, get(node, "callee"))):
            real = true
    if kind is "Field":
        real = slot_has(num_k_field(get(node, "field")))
    if kind is "Index":
        real = num_elem_real(get(node, "object"), fn_name)
        # A TUPLE read is per POSITION: destructuring lowers to `temp[i]` with
        # a literal i, so the position is known and each one keeps its own
        # answer. A list shares one answer across all its elements; a tuple
        # must not, or `(1.5, 2)` would make the 2 a double nobody asked for.
        if get(get(node, "object"), "kind") is "Ident" and get(get(node, "index"), "kind") is "Int":
            if slot_has(num_k_tvar(fn_name, get(get(node, "object"), "name"), parse_int(get(get(node, "index"), "value")))):
                real = true
    if kind is "MethodCall":
        real = slot_has(num_k_ret(get(node, "method")))
        if slot_has(num_k_ffret(get(node, "method"))):
            real = true
    if kind is "If":
        real = num_expr_real(get(node, "then"), fn_name) or num_expr_real(get(node, "else"), fn_name)
    if kind is "Cast":
        # `x as float` is real by declaration; `x as int` is not.
        real = num_is_real_name(get(get(node, "type"), "name"))
    if kind is "Block":
        blk = get_list(node, "stmts")
        if length(blk) > 0:
            real = num_expr_real(blk[length(blk) - 1], fn_name)
    # A body's tail expression arrives wrapped. Without this the answer of
    # every function looked like "not a number at all", and a return type
    # stayed whole while the body divided.
    if kind is "ExprStmt":
        real = num_expr_real(get(node, "expr"), fn_name)
    if kind is "IfBlock":
        real = num_block_real(get(node, "then"), fn_name) or num_block_real(get(node, "else"), fn_name)
    if kind is "Match":
        loop arm in get_list(node, "arms"):
            if num_expr_real(get(arm, "body"), fn_name):
                real = true
    real

# A block answers with its last statement.
define num_block_real(block: table, fn_name: text) -> truth:
    blk = get_list(block, "stmts")
    if length(blk) is 0:
        return false
    num_expr_real(blk[length(blk) - 1], fn_name)

# For a CAST. `x as number` is not a claim about the machine, so it answers
# real - over-approximating is the safe direction.
define num_is_real_name(n: text) -> truth:
    n is "float" or n is "f64" or n is "f32" or n is "number"

# For a DECLARATION. `number` is the word whose answer this pass computes, so
# it is emphatically not a seed - saying it were made every `number` parameter
# in the program real by declaring itself.
define num_is_declared_real(n: text) -> truth:
    n is "float" or n is "f64" or n is "f32"

# One round over one function body: every call argument that is real reaches
# the parameter it lands on, and every `number`-annotated binding takes the
# type of what is stored into it.
define num_scan_stmt(stmt: table, fn_name: text):
    kind = get(stmt, "kind")
    if kind is "LetOrAssign" or kind is "MutLet":
        val = get(stmt, "value")
        num_scan_expr(val, fn_name)
        if num_expr_real(val, fn_name):
            num_mark(num_k_var(fn_name, get(stmt, "name")))
        # A binding that holds a LIST carries its ELEMENTS too. An alias
        # (`ys = xs`) shares the site, which is what makes a later
        # `append(ys, 1.5)` reach the list `xs` also names.
        if num_elem_real(val, fn_name):
            num_mark(num_k_elem(fn_name, get(stmt, "name")))
        # A binding that holds a TUPLE keeps one answer per position.
        num_bind_tuple(val, fn_name, get(stmt, "name"))
    if kind is "Return":
        rex = get(stmt, "expr")
        num_scan_expr(rex, fn_name)
        if num_expr_real(rex, fn_name):
            num_mark(num_k_ret(fn_name))
    if kind is "IfBlock":
        num_scan_expr(get(stmt, "cond"), fn_name)
        num_scan_block(get(stmt, "then"), fn_name)
        num_scan_block(get(stmt, "else"), fn_name)
    if kind is "Loop":
        num_scan_block(get(stmt, "body"), fn_name)
    if kind is "ForIn":
        num_scan_expr(get(stmt, "iter"), fn_name)
        # The loop variable IS an element. Without this a body summing a real
        # list saw its own loop name as whole, and the sum refused to hold
        # what it had just been handed.
        if num_elem_real(get(stmt, "iter"), fn_name):
            num_mark(num_k_var(fn_name, get(stmt, "var")))
        num_scan_block(get(stmt, "body"), fn_name)
    if kind is "ForRange":
        num_scan_expr(get(stmt, "low"), fn_name)
        num_scan_expr(get(stmt, "high"), fn_name)
        num_scan_block(get(stmt, "body"), fn_name)
    if kind is "Block":
        num_scan_block(stmt, fn_name)
    if kind is "ExprStmt":
        num_scan_expr(get(stmt, "expr"), fn_name)
    if kind is "Call" or kind is "MethodCall" or kind is "Binary" or kind is "If" or kind is "Match":
        num_scan_expr(stmt, fn_name)

define num_scan_block(block: table, fn_name: text):
    loop s in get_list(block, "stmts"):
        num_scan_stmt(s, fn_name)

# Walk into an expression looking for calls. An argument that is real makes
# the parameter it lands on real, everywhere in the program.
define num_scan_expr(node: table, fn_name: text):
    kind = get(node, "kind")
    # `perform E.op(a, b)` is a CALL to the handler, spelled differently. It
    # was not wired here, so a real argument reached a handler whose parameter
    # had settled whole - the bits went in and came out as an integer near
    # 4.6e18. The two are one site, the same way a call and its callee are.
    if kind is "Perform":
        pf_h = "__handler_{get(node, \"effect\")}_{get(node, \"op\")}"
        pf_args = get_list(node, "args")
        loop pfi in 0 until length(pf_args):
            num_scan_expr(pf_args[pfi], fn_name)
            if slot_has(num_k_pnum(pf_h, pfi)):
                pf_pname = slot_get(num_k_pname(pf_h, pfi))
                if num_expr_real(pf_args[pfi], fn_name):
                    num_mark(num_k_var(pf_h, pf_pname))
                # and the other way: a parameter already known real widens the
                # argument written at this perform, so a whole literal is BUILT
                # real rather than handed over as a whole-number bit pattern.
                if slot_has(num_k_var(pf_h, pf_pname)) and get(pf_args[pfi], "kind") is "Ident":
                    num_mark(num_k_var(fn_name, get(pf_args[pfi], "name")))
    if kind is "Call":
        callee = get(node, "callee")
        args = get_list(node, "args")
        loop ai in 0 until length(args):
            num_scan_expr(args[ai], fn_name)
            if slot_has(num_k_pnum(callee, ai)) and num_expr_real(args[ai], fn_name):
                num_mark(num_k_var(callee, slot_get(num_k_pname(callee, ai))))
            # A LIST argument and its parameter must AGREE, not merely taint
            # one way. A scalar can be promoted where it is passed - the
            # lowering already emits sitofp - but nothing converts a list of
            # whole numbers into a list of real ones. So the two are one site:
            # real anywhere is real along the whole chain, and a literal
            # written at such a call is BUILT real (see num_rewrite_call).
            # A TUPLE argument: each field is its own site. Without this the
            # parameter's number fields never heard that a real was handed in,
            # settled whole, and read the double's bits back as an integer.
            if slot_has(num_k_tpnum(callee, ai)) and get(args[ai], "kind") is "Tuple":
                t_pname = slot_get(num_k_pname(callee, ai))
                t_items = get_list(args[ai], "items")
                loop tii in 0 until length(t_items):
                    if num_expr_real(t_items[tii], fn_name):
                        num_mark(num_k_tvar(callee, t_pname, tii))
            if slot_has(num_k_lpnum(callee, ai)):
                p_elem = num_k_elem(callee, slot_get(num_k_pname(callee, ai)))
                if num_elem_real(args[ai], fn_name):
                    num_mark(p_elem)
                if slot_has(p_elem) and get(args[ai], "kind") is "Ident":
                    num_mark(num_k_elem(fn_name, get(args[ai], "name")))
        # A FUNCTION handed to a function-typed parameter: unify the two.
        # Real on either side is real on both, because `f(x)` inside the
        # callee reads its type off the annotation while the function itself
        # was compiled from its own.
        loop fi in 0 until length(args):
            if slot_has(num_k_fpnum(callee, fi)) and get(args[fi], "kind") is "Ident":
                pn = slot_get(num_k_pname(callee, fi))
                gname = get(args[fi], "name")
                if slot_has(num_k_ret(gname)):
                    num_mark(num_k_ftret(callee, pn))
                if slot_has(num_k_ftret(callee, pn)):
                    num_mark(num_k_ret(gname))
            # An INLINE lambda has no name to look up, so its body is read
            # here. Without this `apply_it((n): n / 2, 9)` answered 4 for a
            # half - the division made a real that the annotation, still
            # whole, cut on the way out. Silent, which is the one outcome
            # this pass exists to prevent.
            if slot_has(num_k_fpnum(callee, fi)) and get(args[fi], "kind") is "Lambda":
                if num_expr_real(get(args[fi], "body"), fn_name):
                    num_mark(num_k_ftret(callee, slot_get(num_k_pname(callee, fi))))
        # Constructing a VARIANT writes its payload. `JBool(0.5)` is a Call
        # with the variant name as callee, so it lands here like any other.
        loop vi in 0 until length(args):
            if slot_has(num_k_vpnum(callee, vi)) and num_expr_real(args[vi], fn_name):
                num_mark(num_k_vpay(callee, vi))
        # `resume(v)` IS the handler's answer - the value goes back to the
        # `perform` site, not to whoever called the handler. A handler whose
        # body is only a resume looked like it answered nothing, so a resumed
        # fraction travelled over the whole-number carrier and came back as
        # the number that went in.
        if callee is "resume" and length(args) >= 1:
            if num_expr_real(args[0], fn_name):
                num_mark(num_k_ret(fn_name))
        # Storing into a list. Every way a value gets into one is a call by
        # the time this runs: `xs[i] = v` is parsed as `set(xs, i, v)` and
        # `collect e` as `append(acc, e)`. So these three are the whole set,
        # and a real stored through any of them makes the list real.
        # `slot_set(k, <real>)` - the write is what tells the read.
        if callee is "slot_set" and length(args) >= 2:
            sk = num_slot_key(args[0])
            if sk is not "" and num_expr_real(args[1], fn_name):
                num_mark(num_k_slot(fn_name, sk))
        stores_at_2 = callee is "append" or callee is "push"
        if stores_at_2 and length(args) >= 2:
            if num_expr_real(args[1], fn_name) and get(args[0], "kind") is "Ident":
                num_mark(num_k_elem(fn_name, get(args[0], "name")))
        if callee is "set" and length(args) >= 3:
            if num_expr_real(args[2], fn_name) and get(args[0], "kind") is "Ident":
                num_mark(num_k_elem(fn_name, get(args[0], "name")))
    if kind is "StructCons":
        loop fd in get_list(node, "fields"):
            num_scan_expr(get(fd, "value"), fn_name)
            if num_expr_real(get(fd, "value"), fn_name):
                num_mark(num_k_field(get(fd, "name")))
            # A FUNCTION stored in a field carries ITS answer to the field.
            fv = get(fd, "value")
            if get(fv, "kind") is "Lambda" and num_expr_real(get(fv, "body"), fn_name):
                num_mark(num_k_ffret(get(fd, "name")))
            if get(fv, "kind") is "Ident" and slot_has(num_k_ret(get(fv, "name"))):
                num_mark(num_k_ffret(get(fd, "name")))
    if kind is "MethodCall":
        num_scan_expr(get(node, "receiver"), fn_name)
        loop a in get_list(node, "args"):
            num_scan_expr(a, fn_name)
        # `ra.R(0.25)` builds a variant too - the qualified form is a
        # MethodCall, not a Call, and marking only one of them left the
        # payload looking whole. It then read a double's bit pattern through
        # sitofp and answered 4.6e18 for a quarter.
        m_args = get_list(node, "args")
        loop mi in 0 until length(m_args):
            if slot_has(num_k_vpnum(get(node, "method"), mi)) and num_expr_real(m_args[mi], fn_name):
                num_mark(num_k_vpay(get(node, "method"), mi))
    if kind is "Binary":
        num_scan_expr(get(node, "left"), fn_name)
        num_scan_expr(get(node, "right"), fn_name)
    if kind is "Unary":
        num_scan_expr(get(node, "operand"), fn_name)
    if kind is "Cast":
        num_scan_expr(get(node, "expr"), fn_name)
    if kind is "Index":
        num_scan_expr(get(node, "object"), fn_name)
        num_scan_expr(get(node, "index"), fn_name)
    if kind is "Field":
        num_scan_expr(get(node, "object"), fn_name)
    if kind is "Question":
        num_scan_expr(get(node, "inner"), fn_name)
    if kind is "If":
        num_scan_expr(get(node, "cond"), fn_name)
        num_scan_expr(get(node, "then"), fn_name)
        num_scan_expr(get(node, "else"), fn_name)
    if kind is "ListLit" or kind is "Tuple":
        loop it in get_list(node, "items"):
            num_scan_expr(it, fn_name)
    if kind is "NamedArg":
        num_scan_expr(get(node, "value"), fn_name)
    if kind is "Block":
        num_scan_block(node, fn_name)
    if kind is "Match":
        num_scan_expr(get(node, "scrutinee"), fn_name)
        loop arm in get_list(node, "arms"):
            num_scan_expr(get(arm, "body"), fn_name)
            # `JBool(v) then ...` binds v to the payload, so it answers what
            # the payload answers.
            bnds = if has(arm, "bindings") then get_list(arm, "bindings") else []
            loop bi in 0 until length(bnds):
                if slot_has(num_k_vpay(get(arm, "pattern"), bi)):
                    num_mark(num_k_var(fn_name, bnds[bi]))

# Every `number` parameter in the program, by position and by name, so a call
# site can say which one its argument reached.
define num_register(decls: [table]):
    loop d in decls:
        if get(d, "kind") is "Fn":
            fname = get(d, "name")
            params = get_list(d, "params")
            loop pi in 0 until length(params):
                p = params[pi]
                if has(p, "type") and num_is_number(get(p, "type")):
                    slot_set(num_k_pnum(fname, pi), 1)
                    slot_set(num_k_pname(fname, pi), get(p, "name"))
                # `table of number` rides the LIST parameter path: both are
                # "the site holds numbers", both have to AGREE with the
                # argument rather than promote it, and both build a literal
                # written at the call real.
                if has(p, "type") and (num_is_number_list(get(p, "type")) or num_is_number_table(get(p, "type"))):
                    slot_set(num_k_lpnum(fname, pi), 1)
                    slot_set(num_k_pname(fname, pi), get(p, "name"))
                # A TUPLE parameter is one site per field, the same way a
                # tuple return already was. Registering it here is what lets a
                # call mark the fields its argument actually fills.
                if has(p, "type") and get(get(p, "type"), "kind") is "TupleType":
                    slot_set(num_k_tpnum(fname, pi), 1)
                    slot_set(num_k_pname(fname, pi), get(p, "name"))
                    tp_els = get_list(get(p, "type"), "elems")
                    loop tpj in 0 until length(tp_els):
                        if num_is_declared_real(get(tp_els[tpj], "name")):
                            slot_set(num_k_tvar(fname, get(p, "name"), tpj), 1)
                if has(p, "type") and get(get(p, "type"), "kind") is "FnType":
                    slot_set(num_k_fpnum(fname, pi), 1)
                    slot_set(num_k_pname(fname, pi), get(p, "name"))
                    # A DECLARED real part seeds its side of the unification.
                    ft = get(p, "type")
                    if num_is_declared_real(get(get(ft, "ret"), "name")):
                        slot_set(num_k_ftret(fname, get(p, "name")), 1)
                    ftps = get_list(ft, "params")
                    loop fj in 0 until length(ftps):
                        if num_is_declared_real(get(ftps[fj], "name")):
                            slot_set(num_k_ftpar(fname, get(p, "name"), fj), 1)
                # A parameter DECLARED real seeds the analysis, so passing it
                # on reaches whatever it lands in. Without this the reasoning
                # only followed values it could see a fraction attached to,
                # and a `float` handed along one hop looked whole - which is
                # the one direction this may never be wrong in.
                if has(p, "type") and num_is_declared_real(get(get(p, "type"), "name")):
                    slot_set(num_k_var(fname, get(p, "name")), 1)
            # Same for a declared real ANSWER: calling it yields a real.
            if has(d, "ret") and num_is_declared_real(get(get(d, "ret"), "name")):
                slot_set(num_k_ret(fname), 1)
            # A TUPLE answer: note it, and seed any position declared real.
            if has(d, "ret") and get(get(d, "ret"), "kind") is "TupleType":
                slot_set(num_k_tnum(fname), 1)
                tel = get_list(get(d, "ret"), "elems")
                loop ti in 0 until length(tel):
                    if num_is_declared_real(get(tel[ti], "name")):
                        slot_set(num_k_tret(fname, ti), 1)
        # A data declaration. A field DECLARED real seeds every read of that
        # name; a field declared `number` is a site this pass answers.
        if get(d, "kind") is "Data":
            loop fd in get_list(d, "fields"):
                if num_is_declared_real(get(get(fd, "type"), "name")):
                    slot_set(num_k_field(get(fd, "name")), 1)
                if get(get(fd, "type"), "kind") is "FnType":
                    ffty = get(fd, "type")
                    if num_is_declared_real(get(get(ffty, "ret"), "name")):
                        slot_set(num_k_ffret(get(fd, "name")), 1)
                    ffps = get_list(ffty, "params")
                    loop ffj in 0 until length(ffps):
                        if num_is_declared_real(get(ffps[ffj], "name")):
                            slot_set(num_k_ffpar(get(fd, "name"), ffj), 1)
        # An enum's variant payloads, the same way.
        if get(d, "kind") is "Enum":
            loop vr in get_list(d, "variants"):
                vname = get(vr, "name")
                pl = get_list(vr, "payload")
                loop qi in 0 until length(pl):
                    if num_is_number(pl[qi]):
                        slot_set(num_k_vpnum(vname, qi), 1)
                    if num_is_declared_real(get(pl[qi], "name")):
                        slot_set(num_k_vpay(vname, qi), 1)

# The body's tail is what the function answers with. `Return` statements are
# picked up by the statement scanner; this is the value-position one.
define num_scan_fn(d: table):
    fname = get(d, "name")
    body = get(d, "body")
    num_scan_block(body, fname)
    stmts = get_list(body, "stmts")
    n = length(stmts)
    if n > 0:
        if num_expr_real(stmts[n - 1], fname):
            num_mark(num_k_ret(fname))
        if num_elem_real(num_tail_expr(stmts[n - 1]), fname):
            num_mark(num_k_eret(fname))
        num_tuple_answer(num_tail_expr(stmts[n - 1]), fname)

# `name = (a, b)` or `name = f()` where f answers with a tuple: carry each
# position's answer onto the binding.
define num_bind_tuple(val: table, fn_name: text, name: text):
    if get(val, "kind") is "Tuple":
        items = get_list(val, "items")
        loop ti in 0 until length(items):
            if num_expr_real(items[ti], fn_name):
                num_mark(num_k_tvar(fn_name, name, ti))
    if get(val, "kind") is "Call":
        callee = get(val, "callee")
        if slot_has(num_k_tnum(callee)):
            loop tj in 0 until 8:
                if slot_has(num_k_tret(callee, tj)):
                    num_mark(num_k_tvar(fn_name, name, tj))

# A tuple in answer position marks each of its positions.
define num_tuple_answer(val: table, fn_name: text):
    if get(val, "kind") is "Tuple":
        items = get_list(val, "items")
        loop ti in 0 until length(items):
            if num_expr_real(items[ti], fn_name):
                num_mark(num_k_tret(fn_name, ti))

# A tail statement is the value; unwrap the one wrapper it arrives in.
define num_tail_expr(stmt: table) -> table:
    if get(stmt, "kind") is "ExprStmt":
        return get(stmt, "expr")
    stmt

# Rewrite one type node: `number` becomes the word the analysis settled on.
# Everything downstream reads `int` or `float` and never learns there was a
# third word.
define num_resolve_type(t: table, key: text) -> table:
    if not num_is_number(t):
        return t
    if slot_has(key):
        set(t, "name", "float")
    else:
        set(t, "name", "int")

# A site is two questions when it holds a list: what the binding is, and what
# it holds. `elem_key` answers the second.
define num_resolve_site(t: table, key: text, elem_key: text) -> table:
    if num_is_number_list(t):
        return set(t, "elem", num_resolve_type(get(t, "elem"), elem_key))
    if num_is_number_table(t):
        return set(t, "args", append([], num_resolve_type(get_list(t, "args")[0], elem_key)))
    num_resolve_type(t, key)

# A function-typed parameter: each part takes the answer its own site got.
define num_resolve_fntype(t: table, fn_name: text, pname: text) -> table:
    if get(t, "kind") is not "FnType":
        return t
    edit ps = []
    fps = get_list(t, "params")
    loop fj in 0 until length(fps):
        ps = append(ps, num_resolve_type(fps[fj], num_k_ftpar(fn_name, pname, fj)))
    set(set(t, "params", ps), "ret", num_resolve_type(get(t, "ret"), num_k_ftret(fn_name, pname)))

define num_rewrite_stmt(stmt: table, fn_name: text) -> table:
    kind = get(stmt, "kind")
    edit out = stmt
    if kind is "LetOrAssign" or kind is "MutLet":
        out = set(out, "value", num_rewrite_call(get(stmt, "value"), fn_name))
        # Not inside the "this binding is already real" guard: the whole point
        # is that the binding does NOT know yet. The slot's WRITE is what says
        # so, and the read has to be turned before anyone asks its type.
        out = set(out, "value", num_real_slotread(get(out, "value"), fn_name))
        if slot_has(num_k_elem(fn_name, get(stmt, "name"))):
            out = set(out, "value", num_real_maplit(num_real_listlit(get(out, "value"))))
        # A binding whose site came out REAL, started from a whole literal:
        # `edit line_w = 0` followed by a real somewhere later. The slot was
        # made whole and the later assignment could not fit in it. The literal
        # is built real instead - the same rule a list, a table, a tuple and a
        # perform argument already followed; a plain binding was the one shape
        # left out, and it only showed when a corpus migration walked into it.
        if slot_has(num_k_var(fn_name, get(stmt, "name"))):
            # NOT a truth. `true` and `false` are Int nodes carrying a marker,
            # so without this guard `still = false` was rebuilt as `0.0` and
            # the binding was told a truth had become a real.
            if get(get(out, "value"), "kind") is "Int" and not has(get(out, "value"), "truth"):
                out = set(out, "value", {"kind": "Float", "value": "{get(get(out, \"value\"), \"value\")}.0"})
            else:
                # Not only literals. `edit width = the_game.width` followed by
                # `width = event.x` - a whole FIELD read into a slot a real
                # later lands in. The mark is only ever set because a real was
                # assigned somewhere, so the binding is a number; widening the
                # first value is what makes the slot fit the rest.
                wv = get(out, "value")
                wk = get(wv, "kind")
                if (not num_expr_real(wv, fn_name)) and (wk is "Ident" or wk is "Field" or wk is "Index" or wk is "Call" or wk is "Unary" or wk is "Binary"):
                    out = set(out, "value", {"kind": "Call", "callee": "to_real", "args": [wv]})
            # `x = slot_get_number(k)` where x came out real: the word in the
            # slot is a double's bits, so read it as one. The user writes ONE
            # name; which read it becomes is the same question `number` always
            # answers.

        if has(stmt, "decl_type"):
            out = set(out, "decl_type", num_resolve_site(get(stmt, "decl_type"), num_k_var(fn_name, get(stmt, "name")), num_k_elem(fn_name, get(stmt, "name"))))
    if kind is "IfBlock":
        out = set(out, "then", num_rewrite_block(get(stmt, "then"), fn_name))
        out = set(out, "else", num_rewrite_block(get(stmt, "else"), fn_name))
    if kind is "Loop":
        out = set(out, "body", num_rewrite_block(get(stmt, "body"), fn_name))
    if kind is "ForIn" or kind is "ForRange":
        out = set(out, "body", num_rewrite_block(get(stmt, "body"), fn_name))
    if kind is "Block":
        out = num_rewrite_block(stmt, fn_name)
    if kind is "ExprStmt":
        out = set(out, "expr", num_rewrite_call(get(stmt, "expr"), fn_name))
    if kind is "Call":
        out = num_rewrite_call(stmt, fn_name)
    out

# `[1, 2, 3]` in a slot the analysis called real has to be BUILT real - the
# elements are read as doubles, and an i64 bit pattern read that way is not a
# small number, it is nonsense (2.96e-323, measured). Int items become Float.
define num_real_listlit(node: table) -> table:
    if get(node, "kind") is not "ListLit":
        return node
    edit items = []
    loop it in get_list(node, "items"):
        edit it2 = it
        if get(it, "kind") is "Int":
            it2 = {"kind": "Float", "value": "{get(it, \"value\")}.0"}
        items = append(items, it2)
    set(node, "items", items)

# The same for a table literal: `{"a": 1}` handed to a `table of number` whose
# site came out real stores an i64 bit pattern in a slot that is read as a
# double, and the answer is 9.2e18 rather than one.
# `slot_get_number(k)` becomes the REAL read when that key was written with a
# real. One name is written; which read it becomes is the same question
# `number` answers everywhere else.
define num_real_slotread(node: table, fn_name: text) -> table:
    if get(node, "kind") is not "Call":
        return node
    if get(node, "callee") is not "slot_get_number":
        return node
    ka = get_list(node, "args")
    if length(ka) < 1:
        return node
    sk = num_slot_key(ka[0])
    if sk is not "" and slot_has(num_k_slot(fn_name, sk)):
        return set(node, "callee", "slot_get_real")
    node

define num_real_maplit(node: table) -> table:
    if get(node, "kind") is not "MapLit":
        return node
    edit pairs = []
    loop pr in get_list(node, "pairs"):
        edit pr2 = pr
        if get(get(pr, "value"), "kind") is "Int":
            pr2 = set(pr, "value", {"kind": "Float", "value": "{get(get(pr, \"value\"), \"value\")}.0"})
        pairs = append(pairs, pr2)
    set(node, "pairs", pairs)

# Every call in an expression: a list literal handed to a real-element
# parameter is built real.
# `(1.5, 2)` answered from a function whose second position is real has to
# build that 2 as a real - the slot is read as a double, and an i64 bit
# pattern read that way is 9.88e-324 rather than two.
define num_real_tuple(node: table, fn_name: text, key_fn: text) -> table:
    if get(node, "kind") is not "Tuple":
        return node
    edit items = []
    src = get_list(node, "items")
    loop ti in 0 until length(src):
        edit it2 = src[ti]
        if slot_has(num_k_tret(key_fn, ti)) and get(it2, "kind") is "Int":
            it2 = {"kind": "Float", "value": "{get(it2, \"value\")}.0"}
        items = append(items, it2)
    set(node, "items", items)

# A condition needs ONE thing from the rewriter: a `perform` whose handler
# takes a real must get its whole literals built real. Running the full
# rewriter over a condition also reached the lambdas inside `each` / `keep`,
# and a lambda that goes through the fn-typed-parameter path stops being the
# node the lifting pass recorded - the lowering then met a raw `Lambda` with
# no case for it. So: performs, and nothing else.
define num_rewrite_perform(node: table, fn_name: text) -> table:
    kind = get(node, "kind")
    if kind is "Perform":
        return num_rewrite_call(node, fn_name)
    edit out = node
    if kind is "Binary":
        out = set(set(out, "left", num_rewrite_perform(get(node, "left"), fn_name)), "right", num_rewrite_perform(get(node, "right"), fn_name))
    if kind is "Unary":
        out = set(out, "operand", num_rewrite_perform(get(node, "operand"), fn_name))
    out

define num_rewrite_call(node: table, fn_name: text) -> table:
    kind = get(node, "kind")
    edit out = node
    if kind is "StructCons":
        edit fs2 = []
        loop fd in get_list(node, "fields"):
            edit v2 = num_rewrite_call(get(fd, "value"), fn_name)
            # A lambda written into a fn-typed FIELD takes that field's
            # declared parameter types.
            v2 = num_typed_lambda(v2, "num:ffpn:{slot_int_or_zero(\"otir:ep\")}:{get(fd, \"name\")}")
            fs2 = append(fs2, set(fd, "value", v2))
        out = set(out, "fields", fs2)
    # A whole literal written at a perform whose handler takes a real is BUILT
    # real. Handed over as a whole number it would be a bit pattern read as a
    # double: `perform line(2, 3)` answered 2.5e-323.
    if kind is "Perform":
        pf_h = "__handler_{get(node, \"effect\")}_{get(node, \"op\")}"
        pf_args = get_list(node, "args")
        edit pf2 = []
        loop pfi in 0 until length(pf_args):
            edit pa2 = num_rewrite_call(pf_args[pfi], fn_name)
            if slot_has(num_k_pnum(pf_h, pfi)) and slot_has(num_k_var(pf_h, slot_get(num_k_pname(pf_h, pfi)))):
                if get(pa2, "kind") is "Int":
                    pa2 = {"kind": "Float", "value": "{get(pa2, \"value\")}.0"}
            pf2 = append(pf2, pa2)
        out = set(out, "args", pf2)
    if kind is "Call":
        callee = get(node, "callee")
        args = get_list(node, "args")
        edit as2 = []
        loop ai in 0 until length(args):
            edit a2 = num_rewrite_call(args[ai], fn_name)
            if slot_has(num_k_lpnum(callee, ai)):
                if slot_has(num_k_elem(callee, slot_get(num_k_pname(callee, ai)))):
                    a2 = num_real_maplit(num_real_listlit(a2))
            # And one handed to a fn-typed PARAMETER takes that one's.
            if slot_has(num_k_fpnum(callee, ai)):
                a2 = num_typed_lambda(a2, "num:ftpn:{slot_int_or_zero(\"otir:ep\")}:{callee}:{slot_get(num_k_pname(callee, ai))}")
            as2 = append(as2, a2)
        out = set(out, "args", as2)
    if kind is "Binary":
        out = set(set(out, "left", num_rewrite_call(get(node, "left"), fn_name)), "right", num_rewrite_call(get(node, "right"), fn_name))
    if kind is "If":
        # The CONDITION too. It was skipped, so a literal written at a real
        # site inside `if f(2) is 5.0 then ...` was never rebuilt - and the
        # branches, which were rewritten, made it look like the rule worked.
        out = set(out, "cond", num_rewrite_perform(get(node, "cond"), fn_name))
        out = set(set(out, "then", num_rewrite_call(get(node, "then"), fn_name)), "else", num_rewrite_call(get(node, "else"), fn_name))
        # One branch real and the other whole: widen the whole one HERE, in the
        # pass, before anything is emitted.
        #
        # The lowering knows how to do this and does it by re-lowering the
        # whole `if` from the state it started in - which works only if the
        # half-built attempt is dropped, and it is NOT: the compiler mutates
        # uniquely-owned values in place, so both attempts ended up in the
        # function. The first one's `br` pointed at an `else` label that was
        # never emitted, and clang refused the module. Deciding it here means
        # there is nothing to undo.
        if_t = get(out, "then")
        if_e = get(out, "else")
        t_real = num_expr_real(if_t, fn_name)
        e_real = num_expr_real(if_e, fn_name)
        if t_real and not e_real:
            out = set(out, "else", {"kind": "Call", "callee": "to_real", "args": [if_e]})
        if e_real and not t_real:
            out = set(out, "then", {"kind": "Call", "callee": "to_real", "args": [if_t]})
    out

define num_rewrite_block(block: table, fn_name: text) -> table:
    edit out = []
    loop s in get_list(block, "stmts"):
        out = append(out, num_rewrite_stmt(s, fn_name))
    set(block, "stmts", out)

define num_rewrite_fn(d: table) -> table:
    fname = get(d, "name")
    edit out = d
    edit ps = []
    loop p in get_list(d, "params"):
        edit p2 = p
        if has(p, "type"):
            if get(get(p, "type"), "kind") is "FnType":
                p2 = set(p, "type", num_resolve_fntype(get(p, "type"), fname, get(p, "name")))
            else if get(get(p, "type"), "kind") is "TupleType":
                # Each field asks its own question, the same way a tuple RETURN
                # already did. Without this a `(number, text)` parameter froze
                # every number field as the f64 default, so a whole 37 handed in
                # was read back as its own bits: 1.83e-322.
                edit ptel = []
                ptels = get_list(get(p, "type"), "elems")
                loop pti in 0 until length(ptels):
                    ptel = append(ptel, num_resolve_type(ptels[pti], num_k_tvar(fname, get(p, "name"), pti)))
                p2 = set(p, "type", set(get(p, "type"), "elems", ptel))
            else:
                p2 = set(p, "type", num_resolve_site(get(p, "type"), num_k_var(fname, get(p, "name")), num_k_elem(fname, get(p, "name"))))
        ps = append(ps, p2)
    out = set(out, "params", ps)
    if has(d, "ret"):
        if get(get(d, "ret"), "kind") is "TupleType":
            edit tel = []
            tels = get_list(get(d, "ret"), "elems")
            loop ti in 0 until length(tels):
                tel = append(tel, num_resolve_type(tels[ti], num_k_tret(fname, ti)))
            out = set(out, "ret", set(get(d, "ret"), "elems", tel))
        else:
            out = set(out, "ret", num_resolve_site(get(d, "ret"), num_k_ret(fname), num_k_eret(fname)))
    edit body2 = num_rewrite_block(get(d, "body"), fname)
    tstmts = get_list(body2, "stmts")
    tn = length(tstmts)
    if tn > 0 and slot_has(num_k_tnum(fname)):
        tlast = tstmts[tn - 1]
        if get(tlast, "kind") is "ExprStmt":
            body2 = set(body2, "stmts", num_replace_last(tstmts, set(tlast, "expr", num_real_tuple(get(tlast, "expr"), fname, fname))))
        else:
            body2 = set(body2, "stmts", num_replace_last(tstmts, num_real_tuple(tlast, fname, fname)))
    set(out, "body", body2)

# A data declaration's `number` fields take the answer the field name got.
define num_rewrite_data(d: table) -> table:
    edit fs = []
    loop fd in get_list(d, "fields"):
        edit f2 = fd
        if get(get(fd, "type"), "kind") is "FnType":
            fwt = get(fd, "type")
            edit fwps = []
            fwsrc = get_list(fwt, "params")
            loop fwj in 0 until length(fwsrc):
                fwps = append(fwps, num_resolve_type(fwsrc[fwj], num_k_ffpar(get(fd, "name"), fwj)))
            f2 = set(fd, "type", set(set(fwt, "params", fwps), "ret", num_resolve_type(get(fwt, "ret"), num_k_ffret(get(fd, "name")))))
        if num_is_number(get(fd, "type")) or num_is_number_list(get(fd, "type")):
            f2 = set(fd, "type", num_resolve_site(get(fd, "type"), num_k_field(get(fd, "name")), num_k_field(get(fd, "name"))))
        fs = append(fs, f2)
    set(d, "fields", fs)

# If any `number` payload of this enum is real, they all are.
define num_settle_enum(d: table):
    edit any_real = false
    loop vr in get_list(d, "variants"):
        pl = get_list(vr, "payload")
        loop qi in 0 until length(pl):
            if num_is_number(pl[qi]) and slot_has(num_k_vpay(get(vr, "name"), qi)):
                any_real = true
    if any_real:
        loop vr2 in get_list(d, "variants"):
            pl2 = get_list(vr2, "payload")
            loop qj in 0 until length(pl2):
                if num_is_number(pl2[qj]):
                    num_mark(num_k_vpay(get(vr2, "name"), qj))

# An enum's `number` payloads take the answer their slot got.
define num_rewrite_enum(d: table) -> table:
    edit vs = []
    loop vr in get_list(d, "variants"):
        vname = get(vr, "name")
        pl = get_list(vr, "payload")
        edit pl2 = []
        loop qi in 0 until length(pl):
            pl2 = append(pl2, num_resolve_type(pl[qi], num_k_vpay(vname, qi)))
        vs = append(vs, set(vr, "payload", pl2))
    set(d, "variants", vs)

# Replace the last statement of a list.
define num_replace_last(stmts: [table], last: table) -> [table]:
    edit out = []
    n = length(stmts)
    loop i in 0 until n:
        if i is n - 1:
            out = append(out, last)
        else:
            out = append(out, stmts[i])
    out

# After the fixpoint, before the rewrite: what each function-type's parameters
# resolved to, by NAME. A lambda handed to one of them has no annotation of its
# own - its parameters default to whole - so a `function(float) -> float` field
# given `(m): m / 2.0` received a double into an i64 slot and answered 0.5 for
# four and a half. The lambda takes the declared types instead.
define num_settle_fnsigs(decls: [table]):
    loop d in decls:
        if get(d, "kind") is "Fn":
            fname = get(d, "name")
            loop p in get_list(d, "params"):
                if has(p, "type") and get(get(p, "type"), "kind") is "FnType":
                    ps = get_list(get(p, "type"), "params")
                    loop j in 0 until length(ps):
                        slot_set("num:ftpn:{slot_int_or_zero(\"otir:ep\")}:{fname}:{get(p, \"name\")}:{j}", num_settled_name(ps[j], num_k_ftpar(fname, get(p, "name"), j)))
        if get(d, "kind") is "Data":
            loop fd in get_list(d, "fields"):
                if get(get(fd, "type"), "kind") is "FnType":
                    fps = get_list(get(fd, "type"), "params")
                    loop fj in 0 until length(fps):
                        slot_set("num:ffpn:{slot_int_or_zero(\"otir:ep\")}:{get(fd, \"name\")}:{fj}", num_settled_name(fps[fj], num_k_ffpar(get(fd, "name"), fj)))

# The word a type node settled on: `number` takes the site's answer, anything
# else keeps what it says.
define num_settled_name(t: table, key: text) -> text:
    if num_is_number(t):
        if slot_has(key):
            return "float"
        return "int"
    get(t, "name")

# Give a lambda the parameter types the slot it lands in declares. `pfx` is
# the slot-key prefix that names those types.
define num_typed_lambda(node: table, pfx: text) -> table:
    if get(node, "kind") is not "Lambda":
        return node
    ps = get_list(node, "params")
    edit tys = []
    edit any_known = false
    loop j in 0 until length(ps):
        k = "{pfx}:{j}"
        if slot_has(k):
            any_known = true
            tys = append(tys, {"kind": "Named", "name": slot_get(k)})
        else:
            tys = append(tys, {"kind": "Named", "name": "int"})
    if not any_known:
        return node
    set(node, "param_types", tys)

# The pass. Register, then run rounds until one changes nothing, then rewrite.
# A program with no `number` in it does one register walk and stops.
public define num_pass(program: table) -> table:
    decls = get_list(program, "decls")
    num_register(decls)
    edit rounds = 0
    loop:
        slot_set("num:changed", 0)
        loop d in decls:
            if get(d, "kind") is "Fn":
                num_scan_fn(d)
            # One enum, one answer for its `number` payloads. A `choose` arm
            # that hands back a bare payload gets no conversion on the way
            # out, so an enum whose payloads disagreed answered with one of
            # them read as the other. Agreeing costs a whole payload nothing
            # but width; disagreeing cost a right answer.
            if get(d, "kind") is "Enum":
                num_settle_enum(d)
        rounds = rounds + 1
        # The lattice has two points and marks only ever go one way, so this
        # settles. The bound is a guard against a shape nobody thought of, not
        # a real limit.
        if slot_get_number("num:changed") is 0 or rounds > 32:
            break
    num_settle_fnsigs(decls)
    edit out = []
    loop d in decls:
        if get(d, "kind") is "Fn":
            out = append(out, num_rewrite_fn(d))
        else:
            if get(d, "kind") is "Data":
                out = append(out, num_rewrite_data(d))
            else:
                if get(d, "kind") is "Enum":
                    out = append(out, num_rewrite_enum(d))
                else:
                    out = append(out, d)
    set(program, "decls", out)


public define ast_program_to_ir(program: table) -> IRModule:
    # New EPOCH for the private-name registry. A host can compile many programs
    # in one process (the test runner does 118 in a row), and compiler slots
    # outlive a single compile - so without this, one program's private `double`
    # would still be registered when the next program used `double` as a local
    # closure binding, and the call would resolve to a symbol from a file that
    # is no longer being compiled.
    slot_set("otir:ep", slot_int_or_zero("otir:ep") + 1)

    # Same reason, one slot the epoch bump missed: the hoisted-lambda counter.
    # It only ever went up, so `__nlambda_N` for a given lambda depended on how
    # many lambdas the PROCESS had lowered before it - which, in the test
    # runner, is decided by the order list_dir happens to return the test files
    # in. Windows and Linux hand back different orders, so the same source
    # emitted differently-named symbols on the two hosts and the committed IR
    # could not match on both. A module's symbol names must depend on that
    # module and nothing else.
    slot_set("otir:nlam_ctr", 0)

    # ---- Pass -2: the import graph + every orb's exports ----
    # Recorded BEFORE anything resolves a name, because resolution asks two
    # questions a single ordered walk cannot answer: "who exports this?" (any
    # orb, including ones parsed later) and "did I import them?".
    pre_decls = get_list(program, "decls")
    pre_n = length(pre_decls)
    edit orb_pre = ""
    loop pi in 0 until pre_n:
        pd = pre_decls[pi]
        pk = get(pd, "kind")
        if pk is "OrbMark":
            orb_pre = get(pd, "name")
        # `type Name = T` - pre-resolve the target to its IR type string and
        # stash it. A later `x: Name` looks this up in ast_type_to_ir_with_scope.
        if pk is "TypeAlias":
            slot_set(otir_k1("tyalias", get(pd, "name")), ast_type_to_ir(get(pd, "target")))
            pd_target = get_map(pd, "target")
            if get(pd_target, "kind") is "Named":
                slot_set(otir_k1("tyaliassrc", get(pd, "name")), get(pd_target, "name"))
        if pk is "UseDecl":
            target = get(pd, "name")
            slot_set(otir_k2("uses", orb_pre, target), 1)
            # Indexed too, so re-export chains can be walked (otir_reex_reaches).
            u_n = slot_int_or_zero(otir_k1("usen", orb_pre))
            slot_set(otir_k1("useo", orb_pre) + ":{u_n}", target)
            slot_set(otir_k1("usen", orb_pre), u_n + 1)
            if (if has(pd, "reexport") then get_int(pd, "reexport") else 0) is 1:
                slot_set(otir_k2("reex", orb_pre, target), 1)
            only_list = get_list(pd, "only")
            if length(only_list) > 0:
                # A list is a LIMIT, not a hint: from this orb you see these
                # names and nothing else.
                slot_set(otir_k2("onlyn", orb_pre, target), 1)
            loop oi in 0 until length(only_list):
                slot_set(otir_k3("only", orb_pre, target, only_list[oi]), 1)
        if pk is "Fn":
            if (if has(pd, "pub") then get_int(pd, "pub") else 1) is 1:
                ex_name = get(pd, "name")
                if ex_name is not "main":
                    slot_set(otir_k2("pub", orb_pre, ex_name), otir_mangle(orb_pre, ex_name, 1))
                    seen_n = slot_int_or_zero(otir_k1("defn", ex_name))
                    slot_set(otir_k1("defo", ex_name) + ":{seen_n}", orb_pre)
                    slot_set(otir_k1("defn", ex_name), seen_n + 1)

    # Duplicate-function guard. Two `fn name` definitions collide into one
    # LLVM symbol - most often the same helper defined in two `use`d orbs,
    # since function names are global (no orb namespaces yet). Flag it with a
    # clear message instead of a confusing "unknown function" or a link-time
    # duplicate-symbol error. Externs are declarations, not definitions, so
    # re-declaring them across orbs stays legal and is not checked here.
    dup_decls = get_list(program, "decls")
    dup_n = length(dup_decls)
    edit seen_fn_names = part([""], 0, 0)
    edit orb_dup = ""
    loop ddi in 0 until dup_n:
        dd = dup_decls[ddi]
        ddk = get(dd, "kind")
        if ddk is "OrbMark":
            orb_dup = get(dd, "name")
        # (`trait` / `impl` / `system` used to be rejected here, keyed on decl
        # kinds `Trait`/`Impl`/`System`. The parser stopped emitting those kinds,
        # so the check went dead and the promised "not supported yet" error
        # silently became "function `prog__(` has an empty body". They are now
        # caught in the parser as an `Unsupported` decl, WITH a source location.)
        if ddk is "Fn":
            # Compared under the EMITTED name: two orbs may each keep a private
            # helper of the same name (they no longer share a symbol), so only a
            # genuine `pub` clash is a duplicate.
            dnm_raw = get(dd, "name")
            dnm = otir_mangle(orb_dup, dnm_raw, if has(dd, "pub") then get_int(dd, "pub") else 1)
            edit dup_already = false
            loop dsj in 0 until length(seen_fn_names):
                if seen_fn_names[dsj] is dnm:
                    dup_already = true
            if dup_already:
                dd_line = if has(dd, "line") then get_int(dd, "line") else 0
                dd_col = if has(dd, "col") then get_int(dd, "col") else 0
                compile_error("orion: ERROR at {otir_where(dd_line, dd_col)} - function `{dnm_raw}` is defined more than once in the same orb (two different orbs may each have one)")
            seen_fn_names = append(seen_fn_names, dnm)

    # Pass -1.7: `const NAME = expr` inlining. Collect const name->value, then
    # substitute reads across every fn/system body (reusing the fact rewriter),
    # and drop the const decls (they need no runtime storage). Runs BEFORE the
    # fact pass so a fact RHS that reads a const sees the value. A const may not
    # reference another const (the substitution is single-pass). Const-free
    # programs are untouched.
    cn_src = get_list(program, "decls")
    cn_total = length(cn_src)
    const_names = part([""], 0, 0)
    edit const_name_list = const_names
    const_exprs = part([{"kind": "Int", "value": "0"}], 0, 0)
    edit const_expr_list = const_exprs
    loop cni in 0 until cn_total:
        cnd = cn_src[cni]
        if get(cnd, "kind") is "Const":
            const_name_list = append(const_name_list, get(cnd, "name"))
            const_expr_list = append(const_expr_list, get(cnd, "value"))
    edit program_const = program
    if length(const_name_list) > 0:
        edit cn_out = part(cn_src, 0, 0)
        loop cnj in 0 until cn_total:
            edit cnd2 = cn_src[cnj]
            cnk = get(cnd2, "kind")
            if cnk is not "Const":
                # (`or cnk is "System"` used to be here. The parser emits no
                # System decl - the keyword is gone - so the test could only
                # ever answer false.)
                if cnk is "Fn":
                    # Only substitute names the fn does NOT bind itself: a
                    # local `e` shadows the num orb's const `e`, it is not
                    # overwritten by it. See bound_in_block.
                    edit cn_bound = []
                    cn_params = get_list(cnd2, "params")
                    loop cpi in 0 until length(cn_params):
                        cn_bound = append(cn_bound, get(cn_params[cpi], "name"))
                    cn_bound = bound_in_block(get(cnd2, "body"), cn_bound)
                    edit cn_keep_names = part(const_name_list, 0, 0)
                    edit cn_keep_exprs = part(const_expr_list, 0, 0)
                    loop cn_ni in 0 until length(const_name_list):
                        if subst_find(cn_bound, const_name_list[cn_ni]) < 0:
                            cn_keep_names = append(cn_keep_names, const_name_list[cn_ni])
                            cn_keep_exprs = append(cn_keep_exprs, const_expr_list[cn_ni])
                    if length(cn_keep_names) > 0:
                        cnd2 = set(cnd2, "body", subst_block(get(cnd2, "body"), cn_keep_names, cn_keep_exprs))
                cn_out = append(cn_out, cnd2)
        program_const = set(program, "decls", cn_out)

    # Pass -1.6: `number` picks its representation. Runs AFTER const inlining
    # so a const `pi = 3.14159` read is a Float by the time the analysis looks
    # at it, and BEFORE everything else, because every later pass reads types.
    program_const = num_pass(program_const)

    # (Pass -1 was `fact` inlining: reads of a reactive `fact` binding replaced
    # by its defining expression. The `fact` keyword is gone from the parser, so
    # no AST can contain a Fact statement and the pass could never rewrite
    # anything - it only walked every function body on every compile to decide
    # that. Removed; the substitution machinery it shared with the const pass
    # lives on as `subst_*`.)

    # Pass -1: `defer`. Splice each block's deferred expressions in before every
    # `return` that leaves it (LIFO) and at its end, then drop the Defer
    # statements. Gated by a prescan, so a program without `defer` is untouched.
    edit defer_decls = get_list(program_const, "decls")
    edit any_defer = false
    loop dfi in 0 until length(defer_decls):
        dfd = defer_decls[dfi]
        if get(dfd, "kind") is "Fn":
            if defer_block_has(get(dfd, "body")):
                any_defer = true
    if any_defer:
        edit df_out = part(defer_decls, 0, 0)
        loop dfj in 0 until length(defer_decls):
            edit dfd2 = defer_decls[dfj]
            if get(dfd2, "kind") is "Fn":
                orig_body = get_map(dfd2, "body")
                # Oracle over the ORIGINAL body BEFORE the rewrite can drop a
                # defer; coverage over the rewritten body; a need with no cover
                # is a `defer` the rewrite lost on some return path.
                needs = dfv_need(orig_body)
                no_defers = part([{}], 0, 0)
                new_body = defer_rewrite_block(orig_body, no_defers)
                dfv_report(needs, dfv_covered(new_body))
                dfd2 = set(dfd2, "body", new_body)
            df_out = append(df_out, dfd2)
        defer_decls = df_out
    program_const = set(program_const, "decls", defer_decls)

    # Pass -0.5: unique-accumulator promotion. Rewrite `x = append(x, v)` to the
    # in-place push_mut wherever x is a mut local proven uniquely owned, killing
    # the quadratic copy. Runs BEFORE lambda lift so a capturing lambda is still
    # a Lambda node (which blocks promotion). See upp_promote_fn.
    upp_decls = get_list(program_const, "decls")
    edit upp_out = part(upp_decls, 0, 0)
    loop upi in 0 until length(upp_decls):
        edit upd = upp_decls[upi]
        if get(upd, "kind") is "Fn":
            upd = set(upd, "body", upp_promote_fn(get_map(upd, "body"), get(upd, "name")))
        upp_out = append(upp_out, upd)
    program_const = set(program_const, "decls", upp_out)

    # Pass 0: lambda lift. For each `name = |params| body` LetOrAssign at
    # top of a fn body, hoist as synthesized __lambda_N global fn. We
    # pre-scan for any Lambda - if none, take the early-return path that
    # leaves decls unmodified (avoids if/else type-mismatch on empty-list
    # initialization, which broke the bundle build before).
    raw_decls = get_list(program_const, "decls")
    raw_total = length(raw_decls)
    edit has_any_lambda = false
    loop sc_idx in 0 until raw_total:
        sc_decl = raw_decls[sc_idx]
        if get(sc_decl, "kind") is "Fn":
            sc_body = get(sc_decl, "body")
            if get(sc_body, "kind") is "Block":
                sc_stmts = get_list(sc_body, "stmts")
                sc_n = length(sc_stmts)
                loop sc_s in 0 until sc_n:
                    sc_stmt = sc_stmts[sc_s]
                    sc_kind = get(sc_stmt, "kind")
                    if sc_kind is "LetOrAssign" or sc_kind is "MutLet":
                        if get(get(sc_stmt, "value"), "kind") is "Lambda":
                            has_any_lambda = true
                    if sc_kind is "ExprStmt" or sc_kind is "Return":
                        if get(get(sc_stmt, "expr"), "kind") is "Lambda":
                            has_any_lambda = true
                    if nlam_stmt_has(sc_stmt):
                        has_any_lambda = true
    # Pre-scan to find Lambda bindings + their captures. Used by the next
    # phase to emit a clean error if any captures exist (real env-struct
    # closures need more wiring than this minimal lift can offer today).
    # This is best-effort: shallow walk of lambda body looking for idents.
    edit captures_warned = false
    loop cs_idx in 0 until raw_total:
        cs_decl = raw_decls[cs_idx]
        if get(cs_decl, "kind") is "Fn":
            cs_body = get(cs_decl, "body")
            if get(cs_body, "kind") is "Block":
                cs_stmts = get_list(cs_body, "stmts")
                cs_n = length(cs_stmts)
                loop cs_s in 0 until cs_n:
                    cs_stmt = cs_stmts[cs_s]
                    cs_kind = get(cs_stmt, "kind")
                    if cs_kind is "LetOrAssign" or cs_kind is "MutLet":
                        cs_val = get(cs_stmt, "value")
                        if get(cs_val, "kind") is "Lambda":
                            cs_lp = get_list(cs_val, "params")
                            cs_body_expr = get(cs_val, "body")
                            # Shallow capture scan: if body is Binary, check operand idents.
                            cs_body_kind = get(cs_body_expr, "kind")
                            if cs_body_kind is "Binary":
                                cs_left = get(cs_body_expr, "left")
                                cs_right = get(cs_body_expr, "right")
                                if get(cs_left, "kind") is "Ident":
                                    cs_l_name = get(cs_left, "name")
                                    edit found_in_params = false
                                    nlp_x = length(cs_lp)
                                    loop ix in 0 until nlp_x:
                                        if cs_lp[ix] is cs_l_name:
                                            found_in_params = true
                                    if not found_in_params and not captures_warned:
                                        print_line("orion: WARNING - lambda likely captures `{cs_l_name}` (env-struct closures not yet supported; capture acts as free var)")
                                        captures_warned = true
    edit decls = raw_decls
    if has_any_lambda:
        # Tree walk + rewrite. Use seed Maps to avoid empty-list type drift.
        seed = raw_decls[0]
        init_decls = [seed]
        edit working_decls = init_decls
        working_decls = bytes_part(working_decls, 0, 0)
        edit lambda_counter = 0
        init_synth = [seed]
        edit synth_decls = init_synth
        synth_decls = bytes_part(synth_decls, 0, 0)
        # Stmts seed - we need a typed empty list of stmts. Use the seed
        # decl's body stmts if it's a Block fn; otherwise we still need
        # some Stmt-typed list. Synthesize using a dummy.
        # Lifted lambdas are appended AFTER every orb's decls, so they cannot
        # inherit their orb from decl order like the other passes do. Stamp the
        # origin on them (and on rewritten parents, whose rebuild would drop it)
        # so a lambda inside an orb still resolves that orb's private helpers.
        edit orb_lam = ""
        loop d_idx in 0 until raw_total:
            decl = raw_decls[d_idx]
            if get(decl, "kind") is "OrbMark":
                orb_lam = get(decl, "name")
            if get(decl, "kind") is "Fn":
                slot_set("otir:lamfn", get(decl, "name"))
                fn_body = get(decl, "body")
                body_kind = get(fn_body, "kind")
                if body_kind is "Block":
                    old_stmts = get_list(fn_body, "stmts")
                    n_stmts = length(old_stmts)
                    init_stmts = old_stmts
                    edit new_stmts = init_stmts
                    new_stmts = part(new_stmts, 0, 0)
                    edit binding_names = part([""], 0, 0)
                    edit binding_caps = part([""], 0, 0)
                    loop s_idx in 0 until n_stmts:
                        stmt = old_stmts[s_idx]
                        stmt_kind = get(stmt, "kind")
                        edit is_let_lambda = false
                        if stmt_kind is "LetOrAssign" or stmt_kind is "MutLet":
                            if get(get(stmt, "value"), "kind") is "Lambda":
                                is_let_lambda = true
                        # A bare/returned lambda - the last expr of a fn body or
                        # an explicit `return function(...)` - lifts the same way; we
                        # place the resulting closure back in expr position.
                        edit is_expr_lambda = false
                        if stmt_kind is "ExprStmt" or stmt_kind is "Return":
                            if get(get(stmt, "expr"), "kind") is "Lambda":
                                is_expr_lambda = true
                        is_lambda_stmt = is_let_lambda or is_expr_lambda
                        if is_lambda_stmt:
                            lam = if is_let_lambda then get(stmt, "value") else get(stmt, "expr")
                            # Position for the capture references built below.
                            lam_line = if has(lam, "line") then get_int(lam, "line") else 0
                            lam_col = if has(lam, "col") then get_int(lam, "col") else 0
                            lam_params = get_list(lam, "params")
                            n_lp = length(lam_params)
                            lam_body = get(lam, "body")
                            # Worklist-based capture scan: visit expressions
                            # iteratively, recurse into Binary/Call/Unary/If.
                            # Ident nodes not in lam_params become captures.
                            init_work = [lam_body]
                            edit worklist = init_work
                            edit caps = part([""], 0, 0)
                            edit seen_caps = part([""], 0, 0)
                            loop:
                                w_n = length(worklist)
                                if w_n is 0:
                                    break
                                cur = worklist[w_n - 1]
                                worklist = part(worklist, 0, w_n - 1)
                                ck = get(cur, "kind")
                                if ck is "Ident":
                                    cn = get(cur, "name")
                                    edit is_param = false
                                    loop lp_w in 0 until n_lp:
                                        if lam_params[lp_w] is cn:
                                            is_param = true
                                    edit already = false
                                    n_seen = length(seen_caps)
                                    loop sc in 0 until n_seen:
                                        if seen_caps[sc] is cn:
                                            already = true
                                    # Skip global fn names (heuristic: don't
                                    # capture identifiers that look like
                                    # known fn names - they're not values).
                                    # For MVP, accept all non-param idents.
                                    if not is_param and not already:
                                        caps = append(caps, cn)
                                        seen_caps = append(seen_caps, cn)
                                if ck is "Binary":
                                    worklist = append(worklist, get(cur, "left"))
                                    worklist = append(worklist, get(cur, "right"))
                                if ck is "Unary":
                                    worklist = append(worklist, get(cur, "operand"))
                                if ck is "Call":
                                    call_args = get_list(cur, "args")
                                    n_ca = length(call_args)
                                    loop cai in 0 until n_ca:
                                        worklist = append(worklist, call_args[cai])
                                if ck is "If":
                                    worklist = append(worklist, get(cur, "cond"))
                                    worklist = append(worklist, get(cur, "then"))
                                    worklist = append(worklist, get(cur, "else"))
                            n_caps = length(caps)
                            # __lambda_N(__env, params): the captures live in the
                            # closure list __env; a prologue binds each by name so
                            # the body is unchanged. env is the leading param.
                            init_typed = get_list(decl, "params")
                            edit typed_params = init_typed
                            typed_params = part(typed_params, 0, 0)
                            typed_params = append(typed_params, {"name": "__env", "type": {"kind": "List", "elem": {"kind": "Named", "name": "int"}}})
                            loop pi in 0 until n_lp:
                                p_name = lam_params[pi]
                                edit p_ty = {"kind": "Named", "name": "int"}
                                if has(lam, "param_types"):
                                    p_ty = get_list(lam, "param_types")[pi]
                                typed_params = append(typed_params, {"name": p_name, "type": p_ty})
                            synth_name = "__lambda_{lambda_counter}"
                            lambda_counter = lambda_counter + 1
                            # Prologue: cap_i = __env[2 + i]  (slots 0/1 are
                            # the fn-ptr and the is_lambda flag).
                            edit synth_stmts = part([lam_body], 0, 0)
                            loop ci in 0 until n_caps:
                                cap_name = caps[ci]
                                cap_slot = 2 + ci
                                at_call = {"kind": "Call", "callee": "at", "args": [{"kind": "Ident", "name": "__env"}, {"kind": "Int", "value": "{cap_slot}"}]}
                                synth_stmts = append(synth_stmts, {"kind": "LetOrAssign", "name": cap_name, "value": at_call})
                            synth_stmts = append(synth_stmts, {"kind": "ExprStmt", "expr": lam_body})
                            synth_body = {"kind": "Block", "stmts": synth_stmts}
                            synth_decl = {"kind": "Fn", "name": synth_name, "params": typed_params, "ret": num_lambda_ret(lam), "body": synth_body, "orb": orb_lam, "line": lam_line, "col": lam_col}
                            synth_decls = append(synth_decls, synth_decl)
                            bind_name = get(stmt, "name")
                            binding_names = append(binding_names, bind_name)
                            # The binding value builds the closure: [ptr, 1, caps].
                            edit cap_nodes = part([lam_body], 0, 0)
                            loop cj in 0 until n_caps:
                                # The capture reference at the CLOSURE-CONSTRUCTION
                                # site. Without a position, an error about a free
                                # variable inside a lambda reported `line 0:0`.
                                cap_nodes = append(cap_nodes, {"kind": "Ident", "name": caps[cj], "line": lam_line, "col": lam_col})
                            new_value = {"kind": "MakeClosure", "fn": synth_name, "caps": cap_nodes, "is_lambda": 1}
                            if is_let_lambda:
                                new_stmts = append(new_stmts, {"kind": stmt_kind, "name": bind_name, "value": new_value})
                            if is_expr_lambda:
                                new_stmts = append(new_stmts, {"kind": stmt_kind, "expr": new_value})
                        if not is_lambda_stmt:
                            # Non-lambda statement: lift any lambda nested in its
                            # expression (e.g. `apply(function(n): n+1, x)`) into a
                            # closure + synth decls, then pass it through. Calls
                            # to a closure binding resolve to closure_call at
                            # lowering, so no cap rewrite / escape restriction.
                            nl = nlam_lift_stmt(stmt)
                            new_stmts = append(new_stmts, get(nl, "stmt"))
                            nl_synths = get_list(nl, "synths")
                            loop nsi in 0 until length(nl_synths):
                                synth_decls = append(synth_decls, set(nl_synths[nsi], "orb", orb_lam))
                    new_body = {"kind": "Block", "stmts": new_stmts}
                    # SET the changed fields on the ORIGINAL decl. Rebuilding it
                    # from a literal listed six fields and silently dropped every
                    # other one - `generics`, `generics_csv`, `modifier`,
                    # positions. This pass touches every function with a block
                    # body whenever the program contains ANY lambda, so a single
                    # closure anywhere erased the generic signatures for the
                    # WHOLE program and call-site instantiation quietly stopped
                    # working (`keep(words, p)[0]` went back to being an
                    # int). A rebuild that enumerates fields is a list that goes
                    # stale the next time one is added.
                    edit rewritten_decl = set(decl, "body", new_body)
                    rewritten_decl = set(rewritten_decl, "pub", if has(decl, "pub") then get_int(decl, "pub") else 1)
                    rewritten_decl = set(rewritten_decl, "orb", orb_lam)
                    working_decls = append(working_decls, rewritten_decl)
                if body_kind is not "Block":
                    working_decls = append(working_decls, decl)
            if get(decl, "kind") is not "Fn":
                working_decls = append(working_decls, decl)
        n_synth = length(synth_decls)
        loop sy_i in 0 until n_synth:
            working_decls = append(working_decls, synth_decls[sy_i])
        decls = working_decls
    total = length(decls)
    # Pass 1a: collect Data decls and Enum decls first. Pass 1b uses them so
    # fn ret types like `-> Inst` correctly become "struct:Inst" not "i64",
    # and `EnumName.Variant` expressions resolve to variant indices.
    edit sig_scope = scope_empty()
    loop index in 0 until total:
        decl = decls[index]
        if get(decl, "kind") is "Data":
            struct_name = get(decl, "name")
            # Bind generic type vars so `T` in a field type lowers to i64.
            otir_bind_tyvars(decl)
            data_fields = get_list(decl, "fields")
            n_df = length(data_fields)
            edit spec = ""
            loop fi in 0 until n_df:
                fld = data_fields[fi]
                fld_name = get(fld, "name")
                fld_type = ast_type_to_ir(get(fld, "type"))
                sep = if fi is 0 then "" else "|"
                spec = "{spec}{sep}{fld_name}:{fld_type}"
            # Two `data` decls of the same NAME but a different layout are a
            # SILENT miscompile today: a type name is not a linker symbol, just a
            # compile-time layout key, and the lookup takes the first match - so
            # the second orb's field access reads the first orb's offsets. (One
            # such pair exists latent in the tree: `Param` in astra_ast vs
            # orion_ir, never co-built, but nothing stops it.) Functions were
            # namespaced per orb; the type-string machinery is too wide to
            # follow suit for one theoretical clash, so the safety win is to turn
            # the silent miscompile into a clear error. An IDENTICAL redeclaration
            # is harmless and stays legal (a copy-pasted shared shape).
            dkey = otir_k1("dspec", struct_name)
            if slot_has(dkey) and slot_get(dkey) is not spec:
                compile_error("orion: ERROR - data type `{struct_name}` is defined with two different layouts in this build (a type name is a global layout key, not per-orb - rename one)")
            slot_set(dkey, spec)
            # The layout spec writes a fn-typed field as just `fn` - the
            # signature is erased. A fn-typed PARAMETER records its own answer
            # (otir:fnparam_ret); a field needs the same, or a call through it
            # goes out over an i64 ABI and cuts a real value in half. Keyed by
            # the compile epoch, because one process compiles many programs.
            loop dfd in get_list(decl, "fields"):
                if get(get(dfd, "type"), "kind") is "FnType":
                    slot_set("otir:fldfn:{slot_int_or_zero(\"otir:ep\")}:{struct_name}:{get(dfd, \"name\")}", ast_type_to_ir_with_scope(get_map(get(dfd, "type"), "ret"), sig_scope))
            sig_scope = scope_add_data_decl(sig_scope, struct_name, spec)
        if get(decl, "kind") is "Enum":
            enum_name = get(decl, "name")
            # Bind generic type vars so `T` in a variant payload lowers to i64.
            otir_bind_tyvars(decl)
            variants = get_list(decl, "variants")
            n_vars = length(variants)
            edit csv = ""
            edit max_payloads = 0
            loop vi in 0 until n_vars:
                v = variants[vi]
                v_name = get(v, "name")
                sep = if vi is 0 then "" else ","
                csv = "{csv}{sep}{v_name}"
                # Per-variant payload TYPE spec, stored as a synthetic
                # "Enum$Variant" entry in the enum tables (comma csv of
                # IR types). Match-arm bindings retype loads with these.
                v_payloads = get_list(v, "payload")
                n_pl = length(v_payloads)
                if n_pl > max_payloads:
                    max_payloads = n_pl
                edit pl_csv = ""
                loop pli in 0 until n_pl:
                    pl_sep = if pli is 0 then "" else ","
                    pl_type = ast_type_to_ir(v_payloads[pli])
                    pl_csv = "{pl_csv}{pl_sep}{pl_type}"
                sig_scope = scope_add_enum_decl(sig_scope, "{enum_name}${v_name}", pl_csv)
            sig_scope = scope_add_enum_decl(sig_scope, enum_name, csv)
            # Sum types with payloads - synthesize a uniform tagged-union
            # struct: tag (variant index) + positional i64 payload slots
            # p0..pN (ptr payloads live in i64 slots via ptrtoint; match
            # bindings retype per the variant's payload spec). Minimum 2
            # slots so the `?`-operator's index-1 access always exists.
            if max_payloads < 2:
                max_payloads = 2
            edit union_spec = "tag:number"
            loop si in 0 until max_payloads:
                union_spec = "{union_spec}|p{si}:number"
            sig_scope = scope_add_data_decl(sig_scope, enum_name, union_spec)
    # Pass 1b: collect fn signatures, now with struct-aware ret types.
    # ExternFn decls register too - their calls type like any fn call
    # (no more "unknown function, i64 as guess" for declared externs).
    # Duplicate fn BODIES are a hard error - orbs share one flat
    # namespace, and a silent double-emit means whichever definition
    # links last wins (bit us twice: toml/veil line_at, others).
    # Extern re-declares stay legal; that's the cross-orb convention.
    edit fn_seen = []
    edit orb_1b = ""
    loop index in 0 until total:
        decl = decls[index]
        decl_kind_1b = get(decl, "kind")
        if decl_kind_1b is "OrbMark":
            orb_1b = get(decl, "name")
        if decl_kind_1b is "Fn":
            # A stamped origin wins over decl order: lifted lambdas sit at the
            # end of the list but belong to the orb they were written in.
            orb_of = if has(decl, "orb") then get(decl, "orb") else orb_1b
            fn_raw = get(decl, "name")
            # Compiler-synthesized decls (lambdas) carry no `pub` key; they are
            # already uniquely named, so default them to global = today's shape.
            fn_pub = if has(decl, "pub") then get_int(decl, "pub") else 1
            fn_name = otir_mangle(orb_of, fn_raw, fn_pub)
            # How a call inside THIS orb finds it (step 1 of otir_resolve).
            slot_set(otir_priv_key(orb_of, fn_raw), fn_name)
            # `comptime`/`deterministic` modifiers, recorded by the parser
            # instead of dropped. `comptime` (compile-time evaluation) is not
            # implemented, so reject it rather than let it silently do nothing.
            # `deterministic` is a real guarantee - record the emitted name so
            # the effect pass can enforce it after the whole module is built.
            fn_mod = if has(decl, "modifier") then get(decl, "modifier") else ""
            if fn_mod is "comptime":
                ct_line = if has(decl, "mod_line") then get_int(decl, "mod_line") else 0
                ct_col = if has(decl, "mod_col") then get_int(decl, "mod_col") else 0
                compile_error("orion: ERROR at {otir_where(ct_line, ct_col)} - `comptime` was cut; it never evaluated anything at compile time. A folded constant is `const NAME = expr` (or a bare top-level `NAME = expr`)")
            if fn_mod is "deterministic":
                dn = slot_int_or_zero(otir_k1("detn", "count"))
                slot_set(otir_k1("deto", "{dn}"), fn_name)
                slot_set(otir_k1("detn", "count"), dn + 1)
            if text_list_has(fn_seen, fn_name):
                dcl_line = if has(decl, "line") then get_int(decl, "line") else 0
                dcl_col = if has(decl, "col") then get_int(decl, "col") else 0
                compile_error("orion: ERROR at {otir_where(dcl_line, dcl_col)} - duplicate function `{fn_raw}` (defined twice in the same orb - two orbs may now each have their own)")
            # A define wearing a BUILTIN's name can never be called: the call
            # site lowers builtins by name first, so `get("/x", f)` built a
            # table read out of a route call and crashed at runtime. Say it
            # here, at the define, instead.
            if is_builtin_name(fn_raw):
                bi_line = if has(decl, "line") then get_int(decl, "line") else 0
                bi_col = if has(decl, "col") then get_int(decl, "col") else 0
                compile_error("orion: ERROR at {otir_where(bi_line, bi_col)} - `{fn_raw}` is a builtin; a define cannot take its name - calls would go to the builtin, not here")
            fn_seen = append(fn_seen, fn_name)
            ret_type = ast_type_to_ir_with_scope(get(decl, "ret"), sig_scope)
            sig_scope = scope_add_fn_sig(sig_scope, fn_name, ret_type)
            # Arity registry (compiler slots): a call with the wrong
            # argument count silently shifts every parameter - caught
            # here instead of as a runtime pointer crash.
            slot_set("otir:arity:" + fn_name, length(get_list(decl, "params")))
            # Capability contract registry: `otir:uses:<fn>` -> csv. A caller
            # with its own declared clause must cover everything its callee
            # declares - capabilities compose upward through signatures.
            if has(decl, "uses"):
                if get(decl, "uses") is not "":
                    slot_set("otir:uses:" + fn_name, get(decl, "uses"))
            # Parameter-position registry: `otir:param:<fn>:<name>` -> index,
            # so a named argument `f(x = 5)` can be reordered to its slot.
            fn_params_list = get_list(decl, "params")
            loop fp_i in 0 until length(fn_params_list):
                fp = fn_params_list[fp_i]
                slot_set("otir:param:" + fn_name + ":" + get(fp, "name"), fp_i)
                # Default-value registry: the param's default EXPRESSION (an
                # AST node), spliced in at any call that leaves the slot empty.
                if has(fp, "default"):
                    slot_set("otir:pdefault:{fn_name}:{fp_i}", get_map(fp, "default"))
                # Parameter-TYPE registry: `otir:paramtype:<fn>:<index>` -> the
                # param's IR type. Lets a call site diff each arg's reliable
                # concrete pointer shape against the declared param type (the
                # call-arg subtype guard). Untyped params default to `int` (the
                # engine's convention), which is a wildcard for the ptr guard.
                fp_ty = if has(fp, "type") then ast_type_to_ir_with_scope(get(fp, "type"), sig_scope) else "int"
                slot_set("otir:paramtype:" + fn_name + ":{fp_i}", fp_ty)
                # SOURCE form of the same type ("[T]", "T", "int"), for generic
                # call-site instantiation: the IR form above is already erased,
                # so it cannot say WHICH type var a parameter carries.
                if has(fp, "type"):
                    slot_set("otir:psrc:" + fn_name + ":{fp_i}", type_src_text(get(fp, "type")))
            # Generic fns record their type-var names + the source form of the
            # return type. A call site binds the vars from its actual argument
            # types and re-types the result (otir_call_ret_generic).
            # The parser hands over the type-var names as one Text (see
            # psr_parse_fn): reading them out of the `generics` LIST here would
            # take the element type from a map value, which is typed
            # list-of-map whatever it holds.
            gen_csv = if has(decl, "generics_csv") then get(decl, "generics_csv") else ""
            if gen_csv is not "":
                slot_set("otir:gen:" + fn_name, gen_csv)
                if has(decl, "ret"):
                    slot_set("otir:rsrc:" + fn_name, type_src_text(get(decl, "ret")))
        if decl_kind_1b is "ExternFn":
            ext_name = get(decl, "name")
            ext_ret = ast_type_to_ir_with_scope(get(decl, "ret"), sig_scope)
            sig_scope = scope_add_fn_sig(sig_scope, ext_name, ext_ret)
            ext_params = get_list(decl, "params")
            slot_set("otir:arity:" + ext_name, length(ext_params))
            # The same parameter-TYPE registry an ordinary function gets, and
            # for the same reason: a call site crosses the `number` boundary
            # from what the callee DECLARES. An external got none, so a real
            # handed to a slot declared whole went across as the double's raw
            # bits - `og_round_rect(..., radius, ...)` with a radius parsed
            # out of text (which answers `number`) drew every panel as a
            # lozenge, and a C function reading it as an int64 is the same
            # class of wrong as any other.
            loop ep_i in 0 until length(ext_params):
                ep = ext_params[ep_i]
                ep_ty = if has(ep, "type") then ast_type_to_ir_with_scope(get(ep, "type"), sig_scope) else "int"
                slot_set("otir:paramtype:" + ext_name + ":{ep_i}", ep_ty)

    # Pass 2: build each fn's body with the signature scope available.
    # ExternFn becomes a body-less IRFn (params + ret, zero instructions);
    # emit turns those into `declare` lines with real LLVM types.
    edit module = ir_module_new()
    edit has_main = 0
    edit orb_2 = ""
    loop index in 0 until total:
        decl = decls[index]
        kind = get(decl, "kind")
        if kind is "OrbMark":
            orb_2 = get(decl, "name")
        if kind is "Retired":
            rt_word = get(decl, "word")
            rt_line = get_int(decl, "line")
            rt_col = get_int(decl, "col")
            rt_name = if has(decl, "name") then get(decl, "name") else "name"
            if rt_word is "fn":
                compile_error("orion: ERROR at {otir_where(rt_line, rt_col)} - `fn` no longer declares a function; write `define {rt_name}(...)`")
            else:
                compile_error("orion: ERROR at {otir_where(rt_line, rt_col)} - `{rt_word}` was retired; `type` declares every type now (`type Name: field: T` for a product, `type Name:` + indented variants for a sum)")
        if kind is "Unsupported":
            us_word = get(decl, "word")
            us_line = get_int(decl, "line")
            us_col = get_int(decl, "col")
            compile_error("orion: ERROR at {otir_where(us_line, us_col)} - `{us_word}` is reserved but not implemented; there is no lowering for it (use plain functions over `type` values, and pass behaviour as fn args)")
        if kind is "Fn":
            fn_pub_2 = if has(decl, "pub") then get_int(decl, "pub") else 1
            orb_of_2 = if has(decl, "orb") then get(decl, "orb") else orb_2
            # Set per FUNCTION, not per marker: a lifted lambda is lowered from
            # the end of the list but must still resolve names as its own orb.
            slot_set("otir:curorb", orb_of_2)
            fn_ir = ast_fn_to_ir(set(decl, "name", otir_mangle(orb_of_2, get(decl, "name"), fn_pub_2)), sig_scope)
            module = ir_module_add_fn(module, fn_ir)
            if fn_ir.name is "main":
                has_main = 1
        if kind is "ExternFn":
            ext_ret2 = ast_type_to_ir_with_scope(get(decl, "ret"), sig_scope)
            edit ext_fn = ir_fn_new(get(decl, "name"), ext_ret2)
            ext_params = get_list(decl, "params")
            n_ext_params = length(ext_params)
            loop epi in 0 until n_ext_params:
                ep = ext_params[epi]
                ep_type = ast_type_to_ir_with_scope(get(ep, "type"), sig_scope)
                ext_fn = ir_fn_add_param(ext_fn, get(ep, "name"), ep_type)
            module = ir_module_add_fn(module, ext_fn)
    if has_main is 0:
        edit stub = ir_fn_new("main", "i64")
        zero = ir_fn_push(stub, ir_iconst(0))
        ret = ir_fn_push(zero.function, ir_return(zero.id))
        module = ir_module_add_fn(module, ret.function)
    module
