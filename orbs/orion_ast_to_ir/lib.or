            pr = ir_fn_push(sub_r.function, ir_text_contains(text_r.id, sub_r.id))
            result = ConvResult{function: pr.function, scope: sub_r.scope, id: pr.id}
    if is_file_read:
        path_node = args[0]
        path_r = ast_expr_to_ir(fn_value, scope, path_node)
        pr = ir_fn_push(path_r.function, ir_file_read(path_r.id))
        result = ConvResult{function: pr.function, scope: path_r.scope, id: pr.id}
    if is_file_write:
        path_node = args[0]
        content_node = args[1]
        path_r = ast_expr_to_ir(fn_value, scope, path_node)
        content_r = ast_expr_to_ir(path_r.function, path_r.scope, content_node)
        pr = ir_fn_push(content_r.function, ir_file_write(path_r.id, content_r.id))
        result = ConvResult{function: pr.function, scope: content_r.scope, id: pr.id}
    if is_here:
        h_line = if has(node, "line") then get_int(node, "line") else 0
        h_col = if has(node, "col") then get_int(node, "col") else 0
        pr_here = ir_fn_push(fn_value, ir_const_str(otir_where(h_line, h_col)))
        result = ConvResult{function: pr_here.function, scope: scope, id: pr_here.id}
    if is_argc:
        pr = ir_fn_push(fn_value, ir_argc())
        result = ConvResult{function: pr.function, scope: scope, id: pr.id}
    if is_argv:
        idx_node = args[0]
        idx_r = ast_expr_to_ir(fn_value, scope, idx_node)
        pr = ir_fn_push(idx_r.function, ir_argv(idx_r.id))
        result = ConvResult{function: pr.function, scope: idx_r.scope, id: pr.id}
    if is_b_from_t:
        arg_node = args[0]
        arg_r = ast_expr_to_ir(fn_value, scope, arg_node)
        pr = ir_fn_push(arg_r.function, ir_bytes_from_text(arg_r.id))
        result = ConvResult{function: pr.function, scope: arg_r.scope, id: pr.id}
    if is_b_to_t:
        arg_node = args[0]
        arg_r = ast_expr_to_ir(fn_value, scope, arg_node)
        pr = ir_fn_push(arg_r.function, ir_bytes_to_text(arg_r.id))
        result = ConvResult{function: pr.function, scope: arg_r.scope, id: pr.id}
    if is_b_slice:
        list_node = args[0]
        lo_node = args[1]
        hi_node = args[2]
        list_r = ast_expr_to_ir(fn_value, scope, list_node)
        # Byte offsets are whole. `part` already demotes its two; these were
        # left out, and after `int` became `number` an ordinary subtraction
        # is a real - so every caller had to say `to_whole` or the build
        # would not link.
        lo_r = demote_number_index(ast_expr_to_ir(list_r.function, list_r.scope, lo_node))
        hi_r = demote_number_index(ast_expr_to_ir(lo_r.function, lo_r.scope, hi_node))
        pr = ir_fn_push(hi_r.function, ir_bytes_slice(list_r.id, lo_r.id, hi_r.id))
        result = ConvResult{function: pr.function, scope: hi_r.scope, id: pr.id}
    if is_b_concat:
        a_node = args[0]
        b_node = args[1]
        a_r = ast_expr_to_ir(fn_value, scope, a_node)
        b_r = ast_expr_to_ir(a_r.function, a_r.scope, b_node)
        pr = ir_fn_push(b_r.function, ir_bytes_concat(a_r.id, b_r.id))
        result = ConvResult{function: pr.function, scope: b_r.scope, id: pr.id}
    if is_b_zeros:
        n_node = args[0]
        # How many bytes is a count, and a count is whole.
        n_r = demote_number_index(ast_expr_to_ir(fn_value, scope, n_node))
        pr = ir_fn_push(n_r.function, ir_bytes_zeros(n_r.id))
        result = ConvResult{function: pr.function, scope: n_r.scope, id: pr.id}
    if is_byte_at:
        list_node = args[0]
        idx_node = args[1]
        list_r = ast_expr_to_ir(fn_value, scope, list_node)
        idx_r = demote_number_index(ast_expr_to_ir(list_r.function, list_r.scope, idx_node))
        # A TEXT is already the packed form, so read the byte where it lies.
        # Handed one, this used to read a text pointer as a list header and
        # answer 5381 for the letter A - no error, just a number from the
        # wrong place. And the way around it, `bytes_of` first, copies the
        # whole text into a list at eight bytes per byte.
        if get_value_type(idx_r.function, list_r.id) is "text":
            pr_tb = ir_fn_push(idx_r.function, ir_text_byte_at(list_r.id, idx_r.id))
            result = ConvResult{function: pr_tb.function, scope: idx_r.scope, id: pr_tb.id}
        else:
            pr = ir_fn_push(idx_r.function, ir_list_at(list_r.id, idx_r.id))
            result = ConvResult{function: pr.function, scope: idx_r.scope, id: pr.id}
    if is_b_length:
        list_node = args[0]
        list_r = ast_expr_to_ir(fn_value, scope, list_node)
        # Same for the count: a text knows its own length.
        if get_value_type(list_r.function, list_r.id) is "text":
            pr_tl = ir_fn_push(list_r.function, ir_text_len(list_r.id))
            result = ConvResult{function: pr_tl.function, scope: list_r.scope, id: pr_tl.id}
        else:
            pr = ir_fn_push(list_r.function, ir_list_len(list_r.id))
            result = ConvResult{function: pr.function, scope: list_r.scope, id: pr.id}
    if is_slot_get:
        key_node = args[0]
        key_r = ast_expr_to_ir(fn_value, scope, key_node)
        pr = ir_fn_push(key_r.function, ir_slot_get(key_r.id))
        result = ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
    if is_slot_set:
        key_node = args[0]
        val_node = args[1]
        key_r = ast_expr_to_ir(fn_value, scope, key_node)
        val_r = ast_expr_to_ir(key_r.function, key_r.scope, val_node)
        # --trace: databrytpunkt - runtimen pausar om nyckeln matchar
        # ORION_BREAK_SLOT ("vem skrev den har sloten?").
        edit sw_fn = val_r.function
        if slot_get_number("drv:trace") is 1:
            sw = ir_fn_push(sw_fn, ir_call("orion_slot_watch", [key_r.id], "i64"))
            sw_fn = sw.function
        # A REAL value goes in as its bits: the slot is one 64-bit word and so
        # is a double. `slot_get_number` reads it back the same way round.
        edit sv_id = val_r.id
        if get_value_type(sw_fn, val_r.id) is "f64":
            pr_sb = ir_fn_push(sw_fn, ir_bits_of_real(val_r.id))
            sw_fn = pr_sb.function
            sv_id = pr_sb.id
        pr = ir_fn_push(sw_fn, ir_slot_set(key_r.id, sv_id))
        result = ConvResult{function: pr.function, scope: val_r.scope, id: pr.id}
    if is_slot_has:
        sh_r = ast_expr_to_ir(fn_value, scope, args[0])
        pr_sh = ir_fn_push(sh_r.function, ir_slot_has(sh_r.id))
        result = ConvResult{function: pr_sh.function, scope: sh_r.scope, id: pr_sh.id}
    if is_text_hash:
        th_r = ast_expr_to_ir(fn_value, scope, args[0])
        pr_th = ir_fn_push(th_r.function, ir_text_hash(th_r.id))
        result = ConvResult{function: pr_th.function, scope: th_r.scope, id: pr_th.id}
    if is_slot_get_int:
        sgi_r = ast_expr_to_ir(fn_value, scope, args[0])
        pr_sgi = ir_fn_push(sgi_r.function, ir_slot_get_int(sgi_r.id))
        result = ConvResult{function: pr_sgi.function, scope: sgi_r.scope, id: pr_sgi.id}
    if is_slot_get_real:
        # The pass rewrites `slot_get_number` into this where the binding it
        # feeds came out real. Nobody writes it.
        sgr_r = ast_expr_to_ir(fn_value, scope, args[0])
        pr_sgr = ir_fn_push(sgr_r.function, ir_slot_get_real(sgr_r.id))
        result = ConvResult{function: pr_sgr.function, scope: sgr_r.scope, id: pr_sgr.id}
    if is_get_int:
        map_node = args[0]
        key_node = args[1]
        map_r = ast_expr_to_ir(fn_value, scope, map_node)
        key_r = ast_expr_to_ir(map_r.function, map_r.scope, key_node)
        pr = ir_fn_push(key_r.function, ir_map_get(map_r.id, key_r.id, "i64"))
        result = ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
    if is_get_map:
        map_node = args[0]
        key_node = args[1]
        map_r = ast_expr_to_ir(fn_value, scope, map_node)
        key_r = ast_expr_to_ir(map_r.function, map_r.scope, key_node)
        pr = ir_fn_push(key_r.function, ir_map_get(map_r.id, key_r.id, "map"))
        result = ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
    if is_get_list or is_get_text_list or is_get_int_list:
        map_node = args[0]
        key_node = args[1]
        map_r = ast_expr_to_ir(fn_value, scope, map_node)
        key_r = ast_expr_to_ir(map_r.function, map_r.scope, key_node)
