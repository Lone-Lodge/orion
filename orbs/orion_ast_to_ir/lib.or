        # which assumes `f` is a closure (an env-struct list). This is the FFI /
        # hot-reload primitive: load new native code, get its pointer, call it.
        cp_fp = ast_expr_to_ir(fn_value, scope, args[0])
        cp_a = ast_expr_to_ir(cp_fp.function, cp_fp.scope, args[1])
        cp_ptr = ir_fn_push(cp_a.function, ir_int_to_ptr(cp_fp.id, "ptr"))
        cp_call = ir_fn_push(cp_ptr.function, ir_indirect_call(cp_ptr.id, [cp_a.id], "i64"))
