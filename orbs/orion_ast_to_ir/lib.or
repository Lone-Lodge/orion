        pr = ir_fn_push(key_r.function, ir_map_get(map_r.id, key_r.id, gl_elem))
        result = ConvResult{function: pr.function, scope: key_r.scope, id: pr.id}
    is_user_fn = (is_print_line is false) and (is_print_raw is false) and (is_to_text is false) and (is_to_float is false) and (is_to_int is false) and (is_resume is false) and (is_call_ptr is false) and (is_at is false) and (is_len is false) and (is_get is false) and (is_has is false) and (is_push is false) and (is_push_inplace is false) and (is_struct_field_int is false) and (is_struct_field_text is false) and (is_map_remove is false) and (is_set_call is false) and (is_map_keys is false) and (is_map_values is false) and (is_get_or is false) and (is_slice is false) and (is_contains is false) and (is_file_read is false) and (is_file_write is false) and (is_argc is false) and (is_here is false) and (is_argv is false) and (is_b_from_t is false) and (is_b_to_t is false) and (is_b_slice is false) and (is_b_concat is false) and (is_b_zeros is false) and (is_byte_at is false) and (is_b_length is false) and (is_slot_get is false) and (is_slot_set is false) and (is_slot_has is false) and (is_slot_get_int is false) and (is_slot_get_real is false) and (is_text_hash is false) and (is_get_int is false) and (is_get_map is false) and (is_get_list is false) and (is_get_text_list is false) and (is_get_int_list is false) and (is_vec_add is false) and (is_vec_addi is false) and (is_vec_madd is false) and (is_par_madd is false) and (is_par_run is false) and (is_breakpoint is false) and (is_vec_sub is false) and (is_vec_mul is false) and (is_vec_dot is false) and (is_time_now_ms is false) and (is_monotonic_ms is false) and (is_sleep_ms is false) and (is_fmath1 is false) and (is_fmath2 is false)
    if is_resume:
        # One `resume(v)` - pick the int vs text runtime call from the value's
