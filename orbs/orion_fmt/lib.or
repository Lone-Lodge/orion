# orion_fmt - the conservative whitespace formatter, shared by `orbit fmt` and
# the language server's textDocument/formatting.
#
#   fmt_normalize(source)
#
# Tabs to 4 spaces, no trailing whitespace, one blank line at most, one final
# newline. It never touches expressions or indentation - a formatter that did
# would need the parser and could change what a program means. See README.md.

define fmt_expand_tabs(line_text: text) -> text:
    if index_of(line_text, "\t") >= 0:
        replace(line_text, "\t", "    ")
    else:
        line_text

define fmt_trim_trailing(line_text: text) -> text:
    bytes = bytes_of(line_text)
    byte_count = bytes_count(bytes)
    edit end_index = byte_count
    loop:
        if end_index <= 0:
            break
        last_byte = byte_at(bytes, end_index - 1)
        if last_byte is 32 or last_byte is 9:
            end_index -= 1
        else:
            break
    if end_index is byte_count:
        line_text
    else:
        text_of(bytes_part(bytes, 0, end_index))

# Split on "\n" (without LF), normalize each line, then rejoin.
public define fmt_normalize(source: text) -> text:
    example fmt_normalize("a \n\n\nb\n") is "a\n\nb\n"
    example fmt_normalize("\tx") is "    x\n"
    raw_lines = split(source, "\n")
    line_count = length(raw_lines)
    edit normalized_lines = []
    loop index in 0 until line_count:
        raw_line = raw_lines[index]
        without_tabs = fmt_expand_tabs(raw_line)
        stripped = fmt_trim_trailing(without_tabs)
        normalized_lines = append(normalized_lines, stripped)
    # Collapse 2+ consecutive blank lines.
    collapsed = []
    edit output_lines = collapsed
    edit last_was_blank = false
    loop index in 0 until line_count:
        current_line = normalized_lines[index]
        is_blank = current_line is ""
        keep = not (is_blank and last_was_blank)
        if keep:
            output_lines = append(output_lines, current_line)
        last_was_blank = is_blank
    # Drop the trailing blank line so join + "\n" produces one final LF.
    final_count = length(output_lines)
    if final_count > 0 and output_lines[final_count - 1] is "":
        edit trimmed = []
        loop index in 0 until (final_count - 1):
            trimmed = append(trimmed, output_lines[index])
        output_lines = trimmed
    join(output_lines, "\n") + "\n"
