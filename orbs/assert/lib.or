# assert - ONE assertion for Orion.
#
#   assert(x is 42)                       the condition IS the message
#   assert(is_some(opt), "opt was None")  a label when it is not enough
#
# Never aborts: 1 for pass, 0 for fail, because failure is data. See README.md.

public define assert(cond: truth, label = "") -> number uses console:
    example assert(true) is 1
    example assert(true, "holds") is 1
    if cond:
        1
    else:
        print_line("ASSERT FAILED: {label}")
        0
