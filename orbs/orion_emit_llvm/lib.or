    text = "{text}declare double @sin(double)\n"
    text = "{text}declare double @cos(double)\n"
    text = "{text}declare double @tan(double)\n"
    text = "{text}declare double @exp(double)\n"
    text = "{text}declare double @log(double)\n"
    text = "{text}declare double @log2(double)\n"
    text = "{text}declare double @floor(double)\n"
    text = "{text}declare double @ceil(double)\n"
    text = "{text}declare double @round(double)\n"
    text = "{text}declare double @atan2(double, double)\n"
    text = "{text}declare double @pow(double, double)\n"
    # Compile-error counter - compiler diagnostics bump this; drivers
    # read it and refuse to write output / exit non-zero when > 0.
    text = "{text}@orion_err_count = global i64 0\n"
    # Returns i64 (not void) - Orion externs without `->` type as i64
    # at call sites, and the define must match the call's type.
    text = "{text}define i64 @orion_err_bump() \{\n"
    text = "{text}entry:\n"
    text = "{text}  %n = load i64, ptr @orion_err_count\n"
    text = "{text}  %n1 = add i64 %n, 1\n"
    text = "{text}  store i64 %n1, ptr @orion_err_count\n"
    text = "{text}  ret i64 %n1\n"
    text = "{text}\}\n"
    text = "{text}define i64 @orion_err_get() \{\n"
    text = "{text}entry:\n"
    text = "{text}  %n = load i64, ptr @orion_err_count\n"
    text = "{text}  ret i64 %n\n"
    text = "{text}\}\n\n"
    # text_join(parts): sum strlens, one malloc, memcpy each part.
    text = "{text}define ptr @orion_text_join(ptr %parts) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %n = call i64 @orion_list_len(ptr %parts)\n"
    text = "{text}  br label %sum_hdr\n"
    text = "{text}sum_hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %sum_bdy ]\n"
    text = "{text}  %total = phi i64 [ 0, %entry ], [ %total_next, %sum_bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %n\n"
    text = "{text}  br i1 %done, label %alloc, label %sum_bdy\n"
    text = "{text}sum_bdy:\n"
    text = "{text}  %p_int = call i64 @orion_list_at(ptr %parts, i64 %i)\n"
    text = "{text}  %p = inttoptr i64 %p_int to ptr\n"
    text = "{text}  %l = call i64 @orion_tlen(ptr %p)\n"
    text = "{text}  %total_next = add i64 %total, %l\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %sum_hdr\n"
    text = "{text}alloc:\n"
    text = "{text}  %bufsz = add i64 %total, 1\n"
    text = "{text}  %buf = call ptr @orion_text_alloc(i64 %total)\n"
    text = "{text}  br label %cp_hdr\n"
    text = "{text}cp_hdr:\n"
    text = "{text}  %j = phi i64 [ 0, %alloc ], [ %j_next, %cp_bdy ]\n"
    text = "{text}  %off = phi i64 [ 0, %alloc ], [ %off_next, %cp_bdy ]\n"
    text = "{text}  %cp_done = icmp sge i64 %j, %n\n"
    text = "{text}  br i1 %cp_done, label %fin, label %cp_bdy\n"
    text = "{text}cp_bdy:\n"
    text = "{text}  %q_int = call i64 @orion_list_at(ptr %parts, i64 %j)\n"
    text = "{text}  %q = inttoptr i64 %q_int to ptr\n"
    text = "{text}  %ql = call i64 @orion_tlen(ptr %q)\n"
    text = "{text}  %dst = getelementptr i8, ptr %buf, i64 %off\n"
    text = "{text}  %_c = call ptr @memcpy(ptr %dst, ptr %q, i64 %ql)\n"
    text = "{text}  %off_next = add i64 %off, %ql\n"
    text = "{text}  %j_next = add i64 %j, 1\n"
    text = "{text}  br label %cp_hdr\n"
    text = "{text}fin:\n"
    text = "{text}  %term = getelementptr i8, ptr %buf, i64 %total\n"
    text = "{text}  store i8 0, ptr %term\n"
    text = "{text}  ret ptr %buf\n"
    text = "{text}\}\n\n"
    text = "{text}declare i64 @strlen(ptr)\n"
    # H1: texts carry [hash][len] before the byte pointer. tlen is
    # the O(1) length read; alloc/seal/from_c live in orion_rt.c.
    text = "{text}declare ptr @orion_text_alloc(i64)\n"
    text = "{text}declare ptr @orion_text_seal(ptr)\n"
    text = "{text}declare ptr @orion_text_from_c(ptr)\n"
    text = "{text}declare i64 @orion_text_hash(ptr)\n"
    # How many CHARACTERS. A byte that is not a UTF-8 continuation
    # (10xxxxxx, mask 0xC0 value 0x80) starts one, so counting them
    # counts characters. `bytes_count` still answers the other question.
    # The byte offset of character `k`. The loop only ever stands at the
    # START of a character, so the lead byte says how far to step: under
    # 0xC0 is one byte, then 0xE0, 0xF0 for two, three and four.
    text = "{text}define i64 @orion_cpoff(ptr %s, i64 %k) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %on = call i64 @orion_tlen(ptr %s)\n"
    text = "{text}  br label %oloop\n"
    text = "{text}oloop:\n"
    text = "{text}  %oi = phi i64 [ 0, %entry ], [ %oi2, %obody ]\n"
    text = "{text}  %oc = phi i64 [ 0, %entry ], [ %oc2, %obody ]\n"
    text = "{text}  %oend = icmp sge i64 %oi, %on\n"
    text = "{text}  %ohit = icmp sge i64 %oc, %k\n"
    text = "{text}  %ostop = or i1 %oend, %ohit\n"
    text = "{text}  br i1 %ostop, label %oout, label %obody\n"
    text = "{text}obody:\n"
    text = "{text}  %obp = getelementptr i8, ptr %s, i64 %oi\n"
    text = "{text}  %ob = load i8, ptr %obp\n"
    text = "{text}  %obz = zext i8 %ob to i64\n"
    text = "{text}  %ow2 = icmp uge i64 %obz, 192\n"
    text = "{text}  %ow3 = icmp uge i64 %obz, 224\n"
    text = "{text}  %ow4 = icmp uge i64 %obz, 240\n"
    text = "{text}  %oa1 = select i1 %ow2, i64 2, i64 1\n"
    text = "{text}  %oa2 = select i1 %ow3, i64 3, i64 %oa1\n"
    text = "{text}  %oa3 = select i1 %ow4, i64 4, i64 %oa2\n"
    text = "{text}  %oi2 = add i64 %oi, %oa3\n"
    text = "{text}  %oc2 = add i64 %oc, 1\n"
    text = "{text}  br label %oloop\n"
    text = "{text}oout:\n"
    text = "{text}  ret i64 %oi\n"
    text = "{text}\}\n"
    text = "{text}\n"
    text = "{text}define i64 @orion_tchars(ptr %p) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %chp = getelementptr i8, ptr %p, i64 -8\n"
    text = "{text}  %cn = load i64, ptr %chp\n"
    text = "{text}  br label %cloop\n"
    text = "{text}cloop:\n"
    text = "{text}  %ci = phi i64 [ 0, %entry ], [ %ci2, %cbody ]\n"
    text = "{text}  %cc = phi i64 [ 0, %entry ], [ %cc2, %cbody ]\n"
    text = "{text}  %cdone = icmp sge i64 %ci, %cn\n"
    text = "{text}  br i1 %cdone, label %cout, label %cbody\n"
    text = "{text}cbody:\n"
    text = "{text}  %cbp = getelementptr i8, ptr %p, i64 %ci\n"
    text = "{text}  %cb = load i8, ptr %cbp\n"
    text = "{text}  %cm = and i8 %cb, -64\n"
    text = "{text}  %ccont = icmp eq i8 %cm, -128\n"
    text = "{text}  %cadd = select i1 %ccont, i64 0, i64 1\n"
    text = "{text}  %cc2 = add i64 %cc, %cadd\n"
    text = "{text}  %ci2 = add i64 %ci, 1\n"
    text = "{text}  br label %cloop\n"
    text = "{text}cout:\n"
    text = "{text}  ret i64 %cc\n"
    text = "{text}\}\n"
    text = "{text}\n"
    text = "{text}define i64 @orion_tlen(ptr %p) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %hp = getelementptr i8, ptr %p, i64 -8\n"
    text = "{text}  %l = load i64, ptr %hp\n"
    text = "{text}  ret i64 %l\n"
    text = "{text}\}\n\n"
    # H3 harvest: header-aware text equality. Rejects run cheapest
    # first - same pointer, then length (one load each), then the
    # poly hash (cached in the header; a miss calls the runtime to
    # compute-and-cache, so long-lived texts pay once). Only equal
    # hashes fall through to memcmp. Constants carry baked hashes,
    # never 0, so the cache write never touches .rdata.
    text = "{text}declare i32 @memcmp(ptr, ptr, i64)\n"
    text = "{text}define i64 @orion_text_eq(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %same = icmp eq ptr %a, %b\n"
    text = "{text}  br i1 %same, label %yes, label %len_chk\n"
    text = "{text}len_chk:\n"
    text = "{text}  %la_p = getelementptr i8, ptr %a, i64 -8\n"
    text = "{text}  %lb_p = getelementptr i8, ptr %b, i64 -8\n"
    text = "{text}  %la = load i64, ptr %la_p\n"
    text = "{text}  %lb = load i64, ptr %lb_p\n"
    text = "{text}  %len_ne = icmp ne i64 %la, %lb\n"
    text = "{text}  br i1 %len_ne, label %no, label %ha_chk\n"
    text = "{text}ha_chk:\n"
    text = "{text}  %ha_p = getelementptr i8, ptr %a, i64 -16\n"
    text = "{text}  %ha0 = load i64, ptr %ha_p\n"
    text = "{text}  %ha_miss = icmp eq i64 %ha0, 0\n"
    text = "{text}  br i1 %ha_miss, label %ha_fill, label %hb_chk\n"
    text = "{text}ha_fill:\n"
    text = "{text}  %ha1 = call i64 @orion_text_hash(ptr %a)\n"
    text = "{text}  br label %hb_chk\n"
    text = "{text}hb_chk:\n"
    text = "{text}  %ha = phi i64 [ %ha0, %ha_chk ], [ %ha1, %ha_fill ]\n"
    text = "{text}  %hb_p = getelementptr i8, ptr %b, i64 -16\n"
    text = "{text}  %hb0 = load i64, ptr %hb_p\n"
    text = "{text}  %hb_miss = icmp eq i64 %hb0, 0\n"
    text = "{text}  br i1 %hb_miss, label %hb_fill, label %h_cmp\n"
    text = "{text}hb_fill:\n"
    text = "{text}  %hb1 = call i64 @orion_text_hash(ptr %b)\n"
    text = "{text}  br label %h_cmp\n"
    text = "{text}h_cmp:\n"
    text = "{text}  %hb = phi i64 [ %hb0, %hb_chk ], [ %hb1, %hb_fill ]\n"
    text = "{text}  %h_ne = icmp ne i64 %ha, %hb\n"
    text = "{text}  br i1 %h_ne, label %no, label %bytes\n"
    text = "{text}bytes:\n"
    text = "{text}  %mc = call i32 @memcmp(ptr %a, ptr %b, i64 %la)\n"
    text = "{text}  %beq = icmp eq i32 %mc, 0\n"
    text = "{text}  %r = zext i1 %beq to i64\n"
    text = "{text}  ret i64 %r\n"
    text = "{text}yes:\n"
    text = "{text}  ret i64 1\n"
    text = "{text}no:\n"
    text = "{text}  ret i64 0\n"
    text = "{text}\}\n\n"
    text = "{text}declare ptr @strcpy(ptr, ptr)\n"
    text = "{text}declare ptr @strcat(ptr, ptr)\n"
    text = "{text}declare i32 @strcmp(ptr, ptr)\n"
    text = "{text}declare i32 @snprintf(ptr, i64, ptr, ...)\n"
    # Effects runtime: continuations via setjmp/longjmp. Declared as
    # externs - the actual implementations come from orion_rt.c which
    # the test runner / driver compiles alongside our .ll.
    text = "{text}declare i64 @__orion_perform_int(ptr, i64)\n"
    text = "{text}declare void @__orion_resume_int(i64)\n"
    text = "{text}declare void @__orion_resume_real(double)\n"
    text = "{text}declare double @__orion_perform_real_n(ptr, i64, i64, i64, i64, i64)\n"
    text = "{text}declare ptr @__orion_perform_text(ptr, ptr)\n"
    text = "{text}declare void @__orion_resume_text(ptr)\n"
    # N-argument perform (0..4). Every Orion value is a 64-bit word, so the
    # arguments ride as i64 slots whatever their source type and the runtime
    # casts the handler to the matching arity before calling it.
    text = "{text}declare i64 @__orion_perform_int_n(ptr, i64, i64, i64, i64, i64)\n"
    text = "{text}declare ptr @__orion_perform_text_n(ptr, i64, i64, i64, i64, i64)\n"
    text = "{text}declare i64 @__orion_time_now_ms()\n"
    text = "{text}declare i64 @__orion_monotonic_ms()\n"
    text = "{text}declare void @__orion_sleep_ms(i64)\n"
    text = "{text}@.fmt_int = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"\n"
    text = "{text}@.fmt_float = private unnamed_addr constant [4 x i8] c\"%g\\0A\\00\"\n"
    text = "{text}@.fmt_g = private unnamed_addr constant [3 x i8] c\"%g\\00\"\n"
    text = "{text}@.fmt_gp = private unnamed_addr constant [5 x i8] c\"%.*g\\00\"\n"
    text = "{text}declare double @strtod(ptr, ptr)\n"
    text = "{text}@.fmt_int_raw = private unnamed_addr constant [5 x i8] c\"%lld\\00\"\n"
    text = "{text}@.msg_oob = private unnamed_addr constant [48 x i8] c\"orion: list index %lld out of range (len %lld)\\0A\\00\"\n"
    text = "{text}@.msg_divz = private unnamed_addr constant [25 x i8] c\"orion: division by zero\\0A\\00\"\n"
    text = "{text}@.msg_modz = private unnamed_addr constant [23 x i8] c\"orion: modulo by zero\\0A\\00\"\n"
    text = "{text}@.msg_require = private unnamed_addr constant [27 x i8] c\"orion: requirement failed\\0A\\00\"\n"
    text = "{text}@.msg_ensure = private unnamed_addr constant [29 x i8] c\"orion: postcondition failed\\0A\\00\"\n"
    text = "{text}declare void @exit(i32)\n"
    text = "{text}\n"
    # Both lengths are O(1) header reads, so the copy is two memcpys.
    # strcpy+strcat re-scanned for the terminator twice (once to find a's
    # end, once more inside strcat) - work we already knew the answer to,
    # and a truncation risk: the buffer is sized from tlen, so a text with
    # an embedded NUL made strcat write past what tlen paid for.
    text = "{text}define ptr @orion_text_concat(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %la = call i64 @orion_tlen(ptr %a)\n"
    text = "{text}  %lb = call i64 @orion_tlen(ptr %b)\n"
    text = "{text}  %sum = add i64 %la, %lb\n"
    text = "{text}  %buf = call ptr @orion_text_alloc(i64 %sum)\n"
    text = "{text}  %_1 = call ptr @memcpy(ptr %buf, ptr %a, i64 %la)\n"
    text = "{text}  %tail = getelementptr i8, ptr %buf, i64 %la\n"
    text = "{text}  %_2 = call ptr @memcpy(ptr %tail, ptr %b, i64 %lb)\n"
    text = "{text}  ret ptr %buf\n"
    text = "{text}\}\n\n"
    # Digits by hand instead of snprintf. Every `{i}` interpolation lands
    # here, and snprintf costs a format-string parse plus a locale-aware
    # formatter - ~100ns for what is a handful of divides. Writes the
    # digits backwards into a 24-byte stack scratch (20 digits + sign is
    # the i64 worst case), then allocates the EXACT length: no 31-byte
    # over-allocation and no seal pass (text_alloc already set len and
    # zeroed the hash). Magnitude is taken unsigned, so i64 MIN - whose
    # negation overflows - formats correctly too.
    text = "{text}define ptr @orion_int_to_text(i64 %n) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %scratch = alloca [24 x i8]\n"
    text = "{text}  %neg = icmp slt i64 %n, 0\n"
    text = "{text}  %flip = sub i64 0, %n\n"
    text = "{text}  %mag = select i1 %neg, i64 %flip, i64 %n\n"
    text = "{text}  br label %dig\n"
    text = "{text}dig:\n"
    text = "{text}  %w = phi i64 [ %mag, %entry ], [ %q, %dig ]\n"
    text = "{text}  %pos = phi i64 [ 24, %entry ], [ %pos1, %dig ]\n"
    text = "{text}  %pos1 = add i64 %pos, -1\n"
    text = "{text}  %q = udiv i64 %w, 10\n"
    text = "{text}  %q10 = mul i64 %q, 10\n"
    text = "{text}  %rem = sub i64 %w, %q10\n"
    text = "{text}  %chr = add i64 %rem, 48\n"
    text = "{text}  %byte = trunc i64 %chr to i8\n"
    text = "{text}  %slot = getelementptr i8, ptr %scratch, i64 %pos1\n"
    text = "{text}  store i8 %byte, ptr %slot\n"
    text = "{text}  %more = icmp ne i64 %q, 0\n"
    text = "{text}  br i1 %more, label %dig, label %done\n"
    text = "{text}done:\n"
    text = "{text}  %ndig = sub i64 24, %pos1\n"
    text = "{text}  %sign = zext i1 %neg to i64\n"
    text = "{text}  %len = add i64 %ndig, %sign\n"
    text = "{text}  %buf = call ptr @orion_text_alloc(i64 %len)\n"
    text = "{text}  %src = getelementptr i8, ptr %scratch, i64 %pos1\n"
    text = "{text}  %dst = getelementptr i8, ptr %buf, i64 %sign\n"
    text = "{text}  %_c = call ptr @memcpy(ptr %dst, ptr %src, i64 %ndig)\n"
    text = "{text}  br i1 %neg, label %minus, label %fin\n"
    text = "{text}minus:\n"
    text = "{text}  store i8 45, ptr %buf\n"
    text = "{text}  br label %fin\n"
    text = "{text}fin:\n"
    text = "{text}  ret ptr %buf\n"
    text = "{text}\}\n\n"
    # part(text, lo, hi): copy bytes [lo, hi) into a new null-terminated buffer.
    # Clamps lo/hi to [0, strlen] for safety.
    text = "{text}declare ptr @memcpy(ptr, ptr, i64)\n\n"
    text = "{text}define ptr @orion_text_slice(ptr %src, i64 %lo, i64 %hi) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %src_len = call i64 @orion_tlen(ptr %src)\n"
    text = "{text}  %lo_neg = icmp slt i64 %lo, 0\n"
    text = "{text}  %lo_safe = select i1 %lo_neg, i64 0, i64 %lo\n"
    text = "{text}  %hi_big = icmp sgt i64 %hi, %src_len\n"
    text = "{text}  %hi_safe = select i1 %hi_big, i64 %src_len, i64 %hi\n"
    text = "{text}  %hi_lt_lo = icmp slt i64 %hi_safe, %lo_safe\n"
    text = "{text}  %hi_final = select i1 %hi_lt_lo, i64 %lo_safe, i64 %hi_safe\n"
    text = "{text}  %slice_len = sub i64 %hi_final, %lo_safe\n"
    text = "{text}  %buf = call ptr @orion_text_alloc(i64 %slice_len)\n"
    text = "{text}  %src_off = getelementptr i8, ptr %src, i64 %lo_safe\n"
    text = "{text}  %_ = call ptr @memcpy(ptr %buf, ptr %src_off, i64 %slice_len)\n"
    text = "{text}  %term = getelementptr i8, ptr %buf, i64 %slice_len\n"
    text = "{text}  store i8 0, ptr %term\n"
    text = "{text}  ret ptr %buf\n"
    text = "{text}\}\n\n"
    # contains(text, sub): returns i64 1 if sub is a substring of text, else 0.
    text = "{text}declare ptr @strstr(ptr, ptr)\n\n"
    text = "{text}define i64 @orion_text_contains(ptr %hay, ptr %needle) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %hit = call ptr @strstr(ptr %hay, ptr %needle)\n"
    text = "{text}  %is_null = icmp eq ptr %hit, null\n"
    text = "{text}  %result = select i1 %is_null, i64 0, i64 1\n"
    text = "{text}  ret i64 %result\n"
    text = "{text}\}\n\n"
    # bytes_from_text: text → [int] (list of byte values).
    text = "{text}define ptr @orion_bytes_from_text(ptr %src) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %src_len = call i64 @orion_tlen(ptr %src)\n"
    text = "{text}  %list = call ptr @orion_list_new(i64 %src_len)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %src_len\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %byte_ptr = getelementptr i8, ptr %src, i64 %i\n"
    text = "{text}  %byte = load i8, ptr %byte_ptr\n"
    text = "{text}  %byte64 = zext i8 %byte to i64\n"
    text = "{text}  call void @orion_list_set(ptr %list, i64 %i, i64 %byte64)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %list\n"
    text = "{text}\}\n\n"
    # bytes_to_text: [int] of bytes → Text (null-terminated).
    text = "{text}define ptr @orion_bytes_to_text(ptr %list) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %list_len = call i64 @orion_list_len(ptr %list)\n"
    text = "{text}  %buf = call ptr @orion_text_alloc(i64 %list_len)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %list_len\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %v64 = call i64 @orion_list_at(ptr %list, i64 %i)\n"
    text = "{text}  %v8 = trunc i64 %v64 to i8\n"
    text = "{text}  %dst = getelementptr i8, ptr %buf, i64 %i\n"
    text = "{text}  store i8 %v8, ptr %dst\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  %term = getelementptr i8, ptr %buf, i64 %list_len\n"
    text = "{text}  store i8 0, ptr %term\n"
    text = "{text}  ret ptr %buf\n"
    text = "{text}\}\n\n"
    # bytes_zeros(n): list of n zeros (already-zeroed via calloc-ish).
    text = "{text}define ptr @orion_bytes_zeros(i64 %n) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %list = call ptr @orion_list_new(i64 %n)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %n\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  call void @orion_list_set(ptr %list, i64 %i, i64 0)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %list\n"
    text = "{text}\}\n\n"
    # bytes_part(list, lo, hi) → new list with items [lo, hi).
    text = "{text}define ptr @orion_bytes_slice(ptr %src, i64 %lo, i64 %hi) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %src_len = call i64 @orion_list_len(ptr %src)\n"
    text = "{text}  %lo_neg = icmp slt i64 %lo, 0\n"
    text = "{text}  %lo_safe = select i1 %lo_neg, i64 0, i64 %lo\n"
    text = "{text}  %hi_big = icmp sgt i64 %hi, %src_len\n"
    text = "{text}  %hi_safe = select i1 %hi_big, i64 %src_len, i64 %hi\n"
    text = "{text}  %hi_lt = icmp slt i64 %hi_safe, %lo_safe\n"
    text = "{text}  %hi_final = select i1 %hi_lt, i64 %lo_safe, i64 %hi_safe\n"
    text = "{text}  %new_len = sub i64 %hi_final, %lo_safe\n"
    text = "{text}  %dst = call ptr @orion_list_new(i64 %new_len)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %new_len\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %src_idx = add i64 %lo_safe, %i\n"
    text = "{text}  %item = call i64 @orion_list_at(ptr %src, i64 %src_idx)\n"
    text = "{text}  call void @orion_list_set(ptr %dst, i64 %i, i64 %item)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %dst\n"
    text = "{text}\}\n\n"
    # bytes_concat(a, b) → new list with a's items followed by b's.
    # Single-loop over total: branch on i < a_len to pick source.
    text = "{text}define ptr @orion_bytes_concat(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %a_len = call i64 @orion_list_len(ptr %a)\n"
    text = "{text}  %b_len = call i64 @orion_list_len(ptr %b)\n"
    text = "{text}  %total = add i64 %a_len, %b_len\n"
    text = "{text}  %dst = call ptr @orion_list_new(i64 %total)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %store ]\n"
    text = "{text}  %done = icmp sge i64 %i, %total\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %from_a = icmp slt i64 %i, %a_len\n"
    text = "{text}  br i1 %from_a, label %ba, label %bb\n"
    text = "{text}ba:\n"
    text = "{text}  %item_a = call i64 @orion_list_at(ptr %a, i64 %i)\n"
    text = "{text}  br label %store\n"
    text = "{text}bb:\n"
    text = "{text}  %b_idx = sub i64 %i, %a_len\n"
    text = "{text}  %item_b = call i64 @orion_list_at(ptr %b, i64 %b_idx)\n"
    text = "{text}  br label %store\n"
    text = "{text}store:\n"
    text = "{text}  %item = phi i64 [ %item_a, %ba ], [ %item_b, %bb ]\n"
    text = "{text}  call void @orion_list_set(ptr %dst, i64 %i, i64 %item)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %dst\n"
    text = "{text}\}\n\n"
    # Global slot store - single Map keyed by text. Init on first access.
    # The store outlives every frame, so its spine, its keys and its init
    # must NEVER touch the arena: growth/init go straight to malloc and
    # keys are copied on insert (callers routinely pass arena-built keys).
    text = "{text}@orion_slots = global ptr null\n\n"
    # The interned empty list: [cap=0, len=0]. `constant` so any write
    # that slips past the guards faults immediately instead of
    # corrupting every empty list in the program.
    text = "{text}@orion_empty_list = constant [2 x i64] zeroinitializer\n\n"
    # An empty TEXT with the same 16-byte header shape a real one has (hash,
    # length, then the bytes). A missing map key typed `text` selects this
    # instead of a null pointer, so `len` on it answers 0.
    text = "{text}@.str_empty_h = constant [3 x i64] [i64 5381, i64 0, i64 0]\n\n"
    # `true` and `false` as texts, laid out like any other: hash, length,
    # bytes. The hash is BAKED IN and must be - a text with a zero hash gets
    # one computed and CACHED INTO ITS HEADER on the first comparison, and
    # these two live in read-only memory, so the program died writing to them.
    # (`@.str_empty_h` above carries 5381 for exactly this reason.)
    text = "{text}@.str_true_h = constant \{ i64, i64, [5 x i8] \} \{ i64 966814151, i64 4, [5 x i8] c\"true\\00\" \}\n"
    text = "{text}@.str_false_h = constant \{ i64, i64, [6 x i8] \} \{ i64 491283972, i64 5, [6 x i8] c\"false\\00\" \}\n\n"
    # NULL in = "" out: a missing text (unknown fn result, absent map
    # field) evacuates to empty instead of strlen(NULL) crashing.
    text = "{text}define ptr @orion_persist_text(ptr %s) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %is_null = icmp eq ptr %s, null\n"
    text = "{text}  br i1 %is_null, label %ret_empty, label %copy_it\n"
    text = "{text}ret_empty:\n"
    text = "{text}  %eo = getelementptr i8, ptr @.empty_str, i64 16\n"
    text = "{text}  ret ptr %eo\n"
    text = "{text}copy_it:\n"
    text = "{text}  %n = call i64 @orion_tlen(ptr %s)\n"
    text = "{text}  %tot = add i64 %n, 17\n"
    text = "{text}  %src_base = getelementptr i8, ptr %s, i64 -16\n"
    text = "{text}  %copy = call ptr @malloc(i64 %tot)\n"
    text = "{text}  %_ = call ptr @memcpy(ptr %copy, ptr %src_base, i64 %tot)\n"
    text = "{text}  %out = getelementptr i8, ptr %copy, i64 16\n"
    text = "{text}  ret ptr %out\n"
    text = "{text}\}\n\n"
    # ---- Hash index over the packed [key,val] entries (O(1) text lookup) ----
    # The map handle is [entries, cap, len, index, imask]. `index` (0 = none) is
    # a malloc'd i64[imask+1] storing (entry_position + 1); 0 = empty slot. It is
    # an ACCELERATOR: the packed entries array stays the source of truth (keys,
    # values, grow, swap-remove, keys()/values() are unchanged and linear), so a
    # stale/absent index is always safe - lookups fall back to a linear scan.
    # Built lazily by set/set_persist once a map crosses 8 entries; the int-keyed
    # (_ik) family and remove stay linear (remove just drops the index).
    # idx_find(map,key) -> entry position, or -1 on miss.
    text = "{text}define i64 @orion_map_idx_find(ptr %map, ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %ixs = getelementptr i64, ptr %map, i64 3\n"
    text = "{text}  %ixv = load i64, ptr %ixs\n"
    text = "{text}  %noix = icmp eq i64 %ixv, 0\n"
    text = "{text}  br i1 %noix, label %lin, label %hsh\n"
    text = "{text}lin:\n"
    text = "{text}  %le = load ptr, ptr %map\n"
    text = "{text}  %lls = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %ll = load i64, ptr %lls\n"
    text = "{text}  br label %lh\n"
    text = "{text}lh:\n"
    text = "{text}  %li = phi i64 [ 0, %lin ], [ %lin2, %ls ]\n"
    text = "{text}  %ld = icmp sge i64 %li, %ll\n"
    text = "{text}  br i1 %ld, label %lm, label %lb\n"
    text = "{text}lb:\n"
    text = "{text}  %lki = mul i64 %li, 2\n"
    text = "{text}  %lks = getelementptr i64, ptr %le, i64 %lki\n"
    text = "{text}  %lkiv = load i64, ptr %lks\n"
    text = "{text}  %lkp = inttoptr i64 %lkiv to ptr\n"
    text = "{text}  %lc = call i64 @orion_text_eq(ptr %lkp, ptr %key)\n"
    text = "{text}  %lce = icmp ne i64 %lc, 0\n"
    text = "{text}  br i1 %lce, label %lhit, label %ls\n"
    text = "{text}lhit:\n"
    text = "{text}  ret i64 %li\n"
    text = "{text}ls:\n"
    text = "{text}  %lin2 = add i64 %li, 1\n"
    text = "{text}  br label %lh\n"
    text = "{text}lm:\n"
    text = "{text}  ret i64 -1\n"
    text = "{text}hsh:\n"
    text = "{text}  %ix = inttoptr i64 %ixv to ptr\n"
    text = "{text}  %mks = getelementptr i64, ptr %map, i64 4\n"
    text = "{text}  %mk = load i64, ptr %mks\n"
    text = "{text}  %he = load ptr, ptr %map\n"
    text = "{text}  %h0 = call i64 @orion_text_hash(ptr %key)\n"
    text = "{text}  %hh = and i64 %h0, %mk\n"
    text = "{text}  br label %ph\n"
    text = "{text}ph:\n"
    text = "{text}  %ps = phi i64 [ %hh, %hsh ], [ %psw, %pst ]\n"
    text = "{text}  %pisl = getelementptr i64, ptr %ix, i64 %ps\n"
    text = "{text}  %pv = load i64, ptr %pisl\n"
    text = "{text}  %pe = icmp eq i64 %pv, 0\n"
    text = "{text}  br i1 %pe, label %pm, label %pc\n"
    text = "{text}pc:\n"
    text = "{text}  %pos = add i64 %pv, -1\n"
    text = "{text}  %pki = mul i64 %pos, 2\n"
    text = "{text}  %pks = getelementptr i64, ptr %he, i64 %pki\n"
    text = "{text}  %pkiv = load i64, ptr %pks\n"
    text = "{text}  %pkp = inttoptr i64 %pkiv to ptr\n"
    text = "{text}  %pcx = call i64 @orion_text_eq(ptr %pkp, ptr %key)\n"
    text = "{text}  %pce = icmp ne i64 %pcx, 0\n"
    text = "{text}  br i1 %pce, label %phit, label %pst\n"
    text = "{text}phit:\n"
    text = "{text}  ret i64 %pos\n"
    text = "{text}pst:\n"
    text = "{text}  %ps1 = add i64 %ps, 1\n"
    text = "{text}  %psw = and i64 %ps1, %mk\n"
    text = "{text}  br label %ph\n"
    text = "{text}pm:\n"
    text = "{text}  ret i64 -1\n"
    text = "{text}\}\n\n"
    # idx_build(map): (re)build the index from the packed entries. malloc'd so it
    # never dangles regardless of the map's own lifetime (arena/pool/persist).
    text = "{text}define void @orion_map_idx_build(ptr %map) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %bls = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %bl = load i64, ptr %bls\n"
    text = "{text}  %need = mul i64 %bl, 2\n"
    text = "{text}  br label %sz\n"
    text = "{text}sz:\n"
    text = "{text}  %isz = phi i64 [ 16, %entry ], [ %isz2, %szs ]\n"
    text = "{text}  %szok = icmp sge i64 %isz, %need\n"
    text = "{text}  br i1 %szok, label %al, label %szs\n"
    text = "{text}szs:\n"
    text = "{text}  %isz2 = mul i64 %isz, 2\n"
    text = "{text}  br label %sz\n"
    text = "{text}al:\n"
    text = "{text}  %ib = mul i64 %isz, 8\n"
    text = "{text}  %ix = call ptr @malloc(i64 %ib)\n"
    text = "{text}  br label %zh\n"
    text = "{text}zh:\n"
    text = "{text}  %zi = phi i64 [ 0, %al ], [ %zi2, %zb ]\n"
    text = "{text}  %zd = icmp sge i64 %zi, %isz\n"
    text = "{text}  br i1 %zd, label %fl, label %zb\n"
    text = "{text}zb:\n"
    text = "{text}  %zs = getelementptr i64, ptr %ix, i64 %zi\n"
    text = "{text}  store i64 0, ptr %zs\n"
    text = "{text}  %zi2 = add i64 %zi, 1\n"
    text = "{text}  br label %zh\n"
    text = "{text}fl:\n"
    text = "{text}  %mk = add i64 %isz, -1\n"
    text = "{text}  %fe = load ptr, ptr %map\n"
    text = "{text}  br label %fh\n"
    text = "{text}fh:\n"
    text = "{text}  %fi = phi i64 [ 0, %fl ], [ %fi2, %fd2 ]\n"
    text = "{text}  %fdn = icmp sge i64 %fi, %bl\n"
    text = "{text}  br i1 %fdn, label %si, label %fb\n"
    text = "{text}fb:\n"
    text = "{text}  %fki = mul i64 %fi, 2\n"
    text = "{text}  %fks = getelementptr i64, ptr %fe, i64 %fki\n"
    text = "{text}  %fkiv = load i64, ptr %fks\n"
    text = "{text}  %fkp = inttoptr i64 %fkiv to ptr\n"
    text = "{text}  %fh0 = call i64 @orion_text_hash(ptr %fkp)\n"
    text = "{text}  %fhh = and i64 %fh0, %mk\n"
    text = "{text}  br label %pr\n"
    text = "{text}pr:\n"
    text = "{text}  %prs = phi i64 [ %fhh, %fb ], [ %prw, %prc ]\n"
    text = "{text}  %pri = getelementptr i64, ptr %ix, i64 %prs\n"
    text = "{text}  %prv = load i64, ptr %pri\n"
    text = "{text}  %pre = icmp eq i64 %prv, 0\n"
    text = "{text}  br i1 %pre, label %pp, label %prc\n"
    text = "{text}prc:\n"
    text = "{text}  %prs1 = add i64 %prs, 1\n"
    text = "{text}  %prw = and i64 %prs1, %mk\n"
    text = "{text}  br label %pr\n"
    text = "{text}pp:\n"
    text = "{text}  %fp1 = add i64 %fi, 1\n"
    text = "{text}  store i64 %fp1, ptr %pri\n"
    text = "{text}  br label %fd2\n"
    text = "{text}fd2:\n"
    text = "{text}  %fi2 = add i64 %fi, 1\n"
    text = "{text}  br label %fh\n"
    text = "{text}si:\n"
    text = "{text}  %ixi = ptrtoint ptr %ix to i64\n"
    text = "{text}  %sixs = getelementptr i64, ptr %map, i64 3\n"
    text = "{text}  store i64 %ixi, ptr %sixs\n"
    text = "{text}  %smks = getelementptr i64, ptr %map, i64 4\n"
    text = "{text}  store i64 %mk, ptr %smks\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    # idx_add(map, key, posp1): after an append, insert (position+1) into the
    # index, or rebuild it if the load factor got too high. No-op if no index.
    text = "{text}define void @orion_map_idx_add(ptr %map, ptr %key, i64 %posp1) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %ixs = getelementptr i64, ptr %map, i64 3\n"
    text = "{text}  %ixv = load i64, ptr %ixs\n"
    text = "{text}  %noix = icmp eq i64 %ixv, 0\n"
    text = "{text}  br i1 %noix, label %ret, label %chk\n"
    text = "{text}chk:\n"
    text = "{text}  %mks = getelementptr i64, ptr %map, i64 4\n"
    text = "{text}  %mk = load i64, ptr %mks\n"
    text = "{text}  %isz = add i64 %mk, 1\n"
    text = "{text}  %need = mul i64 %posp1, 2\n"
    text = "{text}  %big = icmp sgt i64 %need, %isz\n"
    text = "{text}  br i1 %big, label %rebuild, label %ins\n"
    text = "{text}rebuild:\n"
    text = "{text}  call void @orion_map_idx_build(ptr %map)\n"
    text = "{text}  br label %ret\n"
    text = "{text}ins:\n"
    text = "{text}  %ix = inttoptr i64 %ixv to ptr\n"
    text = "{text}  %h0 = call i64 @orion_text_hash(ptr %key)\n"
    text = "{text}  %hh = and i64 %h0, %mk\n"
    text = "{text}  br label %ph\n"
    text = "{text}ph:\n"
    text = "{text}  %ps = phi i64 [ %hh, %ins ], [ %psw, %pst ]\n"
    text = "{text}  %pisl = getelementptr i64, ptr %ix, i64 %ps\n"
    text = "{text}  %pv = load i64, ptr %pisl\n"
    text = "{text}  %pe = icmp eq i64 %pv, 0\n"
    text = "{text}  br i1 %pe, label %put, label %pst\n"
    text = "{text}pst:\n"
    text = "{text}  %ps1 = add i64 %ps, 1\n"
    text = "{text}  %psw = and i64 %ps1, %mk\n"
    text = "{text}  br label %ph\n"
    text = "{text}put:\n"
    text = "{text}  store i64 %posp1, ptr %pisl\n"
    text = "{text}  br label %ret\n"
    text = "{text}ret:\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    text = "{text}define ptr @orion_map_new_persist() \{\n"
    text = "{text}entry:\n"
    text = "{text}  %handle = call ptr @malloc(i64 40)\n"
    text = "{text}  %entries = call ptr @malloc(i64 256)\n"
    text = "{text}  store ptr %entries, ptr %handle\n"
    text = "{text}  %cap_slot = getelementptr i64, ptr %handle, i64 1\n"
    text = "{text}  store i64 16, ptr %cap_slot\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %handle, i64 2\n"
    text = "{text}  store i64 0, ptr %len_slot\n"
    text = "{text}  %ix_slot = getelementptr i64, ptr %handle, i64 3\n"
    text = "{text}  store i64 0, ptr %ix_slot\n"
    text = "{text}  %mk_slot = getelementptr i64, ptr %handle, i64 4\n"
    text = "{text}  store i64 0, ptr %mk_slot\n"
    text = "{text}  ret ptr %handle\n"
    text = "{text}\}\n\n"
    text = "{text}define void @orion_map_set_persist(ptr %map, ptr %key, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %big = icmp sge i64 %len, 8\n"
    text = "{text}  br i1 %big, label %ens, label %findit\n"
    text = "{text}ens:\n"
    text = "{text}  %ixs = getelementptr i64, ptr %map, i64 3\n"
    text = "{text}  %ixv = load i64, ptr %ixs\n"
    text = "{text}  %noix = icmp eq i64 %ixv, 0\n"
    text = "{text}  br i1 %noix, label %bld, label %findit\n"
    text = "{text}bld:\n"
    text = "{text}  call void @orion_map_idx_build(ptr %map)\n"
    text = "{text}  br label %findit\n"
    text = "{text}findit:\n"
    text = "{text}  %pos = call i64 @orion_map_idx_find(ptr %map, ptr %key)\n"
    text = "{text}  %found = icmp sge i64 %pos, 0\n"
    text = "{text}  br i1 %found, label %update, label %maybe_grow\n"
    text = "{text}update:\n"
    text = "{text}  %ue = load ptr, ptr %map\n"
    text = "{text}  %uki = mul i64 %pos, 2\n"
    text = "{text}  %uvi = add i64 %uki, 1\n"
    text = "{text}  %uvs = getelementptr i64, ptr %ue, i64 %uvi\n"
    text = "{text}  store i64 %val, ptr %uvs\n"
    text = "{text}  ret void\n"
    text = "{text}maybe_grow:\n"
    text = "{text}  %cap_slot = getelementptr i64, ptr %map, i64 1\n"
    text = "{text}  %cap = load i64, ptr %cap_slot\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %full = icmp sge i64 %len, %cap\n"
    text = "{text}  br i1 %full, label %grow, label %append\n"
    text = "{text}grow:\n"
    text = "{text}  %new_cap = mul i64 %cap, 2\n"
    text = "{text}  %new_bytes = mul i64 %new_cap, 16\n"
    text = "{text}  %new_entries = call ptr @malloc(i64 %new_bytes)\n"
    text = "{text}  %old_bytes = mul i64 %len, 16\n"
    text = "{text}  %_cp = call ptr @memcpy(ptr %new_entries, ptr %entries, i64 %old_bytes)\n"
    text = "{text}  store ptr %new_entries, ptr %map\n"
    text = "{text}  store i64 %new_cap, ptr %cap_slot\n"
    text = "{text}  br label %append\n"
    text = "{text}append:\n"
    text = "{text}  %entries2 = load ptr, ptr %map\n"
    text = "{text}  %key_copy = call ptr @orion_persist_text(ptr %key)\n"
    text = "{text}  %app_idx2 = mul i64 %len, 2\n"
    text = "{text}  %app_k_slot = getelementptr i64, ptr %entries2, i64 %app_idx2\n"
    text = "{text}  %app_vi = add i64 %app_idx2, 1\n"
    text = "{text}  %app_v_slot = getelementptr i64, ptr %entries2, i64 %app_vi\n"
    text = "{text}  %key_int = ptrtoint ptr %key_copy to i64\n"
    text = "{text}  store i64 %key_int, ptr %app_k_slot\n"
    text = "{text}  store i64 %val, ptr %app_v_slot\n"
    text = "{text}  %new_len = add i64 %len, 1\n"
    text = "{text}  store i64 %new_len, ptr %len_slot\n"
    text = "{text}  call void @orion_map_idx_add(ptr %map, ptr %key_copy, i64 %new_len)\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    text = "{text}define ptr @orion_slot_get(ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %m = load ptr, ptr @orion_slots\n"
    text = "{text}  %is_null = icmp eq ptr %m, null\n"
    text = "{text}  br i1 %is_null, label %init, label %get\n"
    text = "{text}init:\n"
    text = "{text}  %new = call ptr @orion_map_new_persist()\n"
    text = "{text}  store ptr %new, ptr @orion_slots\n"
    text = "{text}  br label %get\n"
    text = "{text}get:\n"
    text = "{text}  %m2 = load ptr, ptr @orion_slots\n"
    text = "{text}  %has = call i64 @orion_map_has(ptr %m2, ptr %key)\n"
    text = "{text}  %miss = icmp eq i64 %has, 0\n"
    text = "{text}  br i1 %miss, label %empty, label %fetch\n"
    text = "{text}empty:\n"
    text = "{text}  %eo = getelementptr i8, ptr @.empty_str, i64 16\n"
    text = "{text}  ret ptr %eo\n"
    text = "{text}fetch:\n"
    text = "{text}  %raw = call i64 @orion_map_get(ptr %m2, ptr %key)\n"
    text = "{text}  %p = inttoptr i64 %raw to ptr\n"
    text = "{text}  ret ptr %p\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_slot_set(ptr %key, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %m = load ptr, ptr @orion_slots\n"
    text = "{text}  %is_null = icmp eq ptr %m, null\n"
    text = "{text}  br i1 %is_null, label %init, label %store\n"
    text = "{text}init:\n"
    text = "{text}  %new = call ptr @orion_map_new_persist()\n"
    text = "{text}  store ptr %new, ptr @orion_slots\n"
    text = "{text}  br label %store\n"
    text = "{text}store:\n"
    text = "{text}  %m2 = load ptr, ptr @orion_slots\n"
    text = "{text}  call void @orion_map_set_persist(ptr %m2, ptr %key, i64 %val)\n"
    text = "{text}  ret i64 0\n"
    text = "{text}\}\n\n"
    # slot_has / slot_get_int: typed slot probes (no ptr round-trip).
    text = "{text}define i64 @orion_slot_has(ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %m = load ptr, ptr @orion_slots\n"
    text = "{text}  %is_null = icmp eq ptr %m, null\n"
    text = "{text}  br i1 %is_null, label %no, label %chk\n"
    text = "{text}no:\n"
    text = "{text}  ret i64 0\n"
    text = "{text}chk:\n"
    text = "{text}  %has = call i64 @orion_map_has(ptr %m, ptr %key)\n"
    text = "{text}  ret i64 %has\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_slot_get_int(ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %m = load ptr, ptr @orion_slots\n"
    text = "{text}  %is_null = icmp eq ptr %m, null\n"
    text = "{text}  br i1 %is_null, label %zero, label %get\n"
    text = "{text}zero:\n"
    text = "{text}  ret i64 0\n"
    text = "{text}get:\n"
    text = "{text}  %v = call i64 @orion_map_get(ptr %m, ptr %key)\n"
    text = "{text}  ret i64 %v\n"
    text = "{text}\}\n\n"
    # File I/O via libc stdio.
    text = "{text}declare ptr @fopen(ptr, ptr)\n"
    text = "{text}declare i32 @fclose(ptr)\n"
    text = "{text}declare i64 @fread(ptr, i64, i64, ptr)\n"
    text = "{text}declare i64 @fwrite(ptr, i64, i64, ptr)\n"
    text = "{text}declare i32 @fseek(ptr, i64, i32)\n"
    text = "{text}declare i64 @ftell(ptr)\n"
    text = "{text}@.fmode_r = private unnamed_addr constant [3 x i8] c\"rb\\00\"\n"
    text = "{text}@.fmode_w = private unnamed_addr constant [3 x i8] c\"wb\\00\"\n"
    # Headered empty text: hash 5381 (0x1505 LE) + len 0 + NUL, the
    # pointer everyone returns is blob+16.
    text = "{text}@.empty_str = private unnamed_addr constant [17 x i8] c\"\\05\\15\\00\\00\\00\\00\\00\\00\\00\\00\\00\\00\\00\\00\\00\\00\\00\", align 8\n\n"
    # file_read/file_write bor i C-runtimen (orion_rt.c) - flyttade fran
    # handskriven IR sa effektinspelningen (ORION_RECORD/REPLAY) kan
    # fanga dem. Beteendet ar identiskt: "" vid oppningsfel, 1/0 write.
    text = "{text}declare ptr @orion_file_read(ptr)\n"
    text = "{text}declare i64 @orion_file_write(ptr, ptr)\n\n"
    # Lists: heap buffer [i64 cap, i64 len, i64 item0, ...].
    # push is amortized O(1): in-place while len < cap, doubling grow
    # otherwise. Callers MUST rebind (`x = append(x, v)`) - on grow a new
    # buffer is returned; in-place returns the same pointer, so a stale
    # alias may observe the append. The whole codebase uses the rebind
    # convention. list_new(n) is PRE-SIZED (len = n) - list literals
    # and bytes builders fill slots 0..n-1 via list_set.
    text = "{text}define ptr @orion_list_new(i64 %cap) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %bytes = mul i64 %cap, 8\n"
    text = "{text}  %total = add i64 %bytes, 16\n"
    text = "{text}  %buf = call ptr @orion_alloc(i64 %total)\n"
    text = "{text}  store i64 %cap, ptr %buf\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %buf, i64 1\n"
    text = "{text}  store i64 %cap, ptr %len_slot\n"
    text = "{text}  ret ptr %buf\n"
    text = "{text}\}\n\n"
    # Struct field by declaration index - structs are raw i64 slots in
    # decl order. The text variant re-attaches the pointer type.
    text = "{text}define i64 @orion_struct_field_int(ptr %s, i64 %i) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %slot = getelementptr i64, ptr %s, i64 %i\n"
    text = "{text}  %v = load i64, ptr %slot\n"
    text = "{text}  ret i64 %v\n"
    text = "{text}\}\n\n"
    text = "{text}define ptr @orion_struct_field_text(ptr %s, i64 %i) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %slot = getelementptr i64, ptr %s, i64 %i\n"
    text = "{text}  %v = load i64, ptr %slot\n"
    text = "{text}  %p = inttoptr i64 %v to ptr\n"
    text = "{text}  ret ptr %p\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_list_len(ptr %list) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %list, i64 1\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  ret i64 %len\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_list_at(ptr %list, i64 %idx) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %at_len_slot = getelementptr i64, ptr %list, i64 1\n"
    text = "{text}  %at_len = load i64, ptr %at_len_slot\n"
    # Unsigned compare catches idx < 0 (wraps to a huge value) and idx >= len
    # in one test. Out-of-range indexing used to load adjacent memory and
    # return garbage with exit 0 - silent wrong answer. Fail loudly instead.
    text = "{text}  %at_oob = icmp uge i64 %idx, %at_len\n"
    text = "{text}  br i1 %at_oob, label %at_fail, label %at_ok\n"
    text = "{text}at_fail:\n"
    text = "{text}  %_atp = call i32 (ptr, ...) @printf(ptr @.msg_oob, i64 %idx, i64 %at_len)\n"
    text = "{text}  %_att = call i64 @orion_trail_note_trap()\n"
    text = "{text}  call void @exit(i32 70)\n"
    text = "{text}  unreachable\n"
    text = "{text}at_ok:\n"
    text = "{text}  %offset = add i64 %idx, 2\n"
    text = "{text}  %slot = getelementptr i64, ptr %list, i64 %offset\n"
    text = "{text}  %val = load i64, ptr %slot\n"
    text = "{text}  ret i64 %val\n"
    text = "{text}\}\n\n"
    # Checked integer division / modulo. Raw sdiv/srem by zero raises SIGFPE
    # (an ugly crash with no message); route through these so a runtime `x / 0`
    # prints a clear line and exits. The literal `/ 0` is still caught earlier
    # at compile time.
    text = "{text}define i64 @orion_idiv(i64 %a, i64 %b) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %dz = icmp eq i64 %b, 0\n"
    text = "{text}  br i1 %dz, label %dfail, label %dok\n"
    text = "{text}dfail:\n"
    text = "{text}  %_dp = call i32 (ptr, ...) @printf(ptr @.msg_divz)\n"
    text = "{text}  call void @exit(i32 70)\n"
    text = "{text}  unreachable\n"
    text = "{text}dok:\n"
    text = "{text}  %dq = sdiv i64 %a, %b\n"
    text = "{text}  ret i64 %dq\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_imod(i64 %a, i64 %b) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %mz = icmp eq i64 %b, 0\n"
    text = "{text}  br i1 %mz, label %mfail, label %mok\n"
    text = "{text}mfail:\n"
    text = "{text}  %_mp = call i32 (ptr, ...) @printf(ptr @.msg_modz)\n"
    text = "{text}  call void @exit(i32 70)\n"
    text = "{text}  unreachable\n"
    text = "{text}mok:\n"
    text = "{text}  %mr = srem i64 %a, %b\n"
    text = "{text}  ret i64 %mr\n"
    text = "{text}\}\n\n"
    # Contract checks bor i C-runtimen: trappen sager VAR kravet foll
    # ("require failed at fil:rad") och skriver lokalerna i tracade
    # byggen - felet forklarar sig sjalvt i stallet for en enrads-suck.
    text = "{text}declare i64 @orion_require_at(i64, ptr)\n"
    text = "{text}declare i64 @orion_ensure_at(i64, ptr)\n\n"
    # part(list, lo, hi) - half-open [lo, hi), bounds clamped like the interp.
    text = "{text}define ptr @orion_list_slice(ptr %list, i64 %lo, i64 %hi) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %n = call i64 @orion_list_len(ptr %list)\n"
    text = "{text}  %hi_neg = icmp slt i64 %hi, 0\n"
    text = "{text}  %hi0 = select i1 %hi_neg, i64 0, i64 %hi\n"
    text = "{text}  %hi_big = icmp sgt i64 %hi0, %n\n"
    text = "{text}  %hi1 = select i1 %hi_big, i64 %n, i64 %hi0\n"
    text = "{text}  %lo_neg = icmp slt i64 %lo, 0\n"
    text = "{text}  %lo0 = select i1 %lo_neg, i64 0, i64 %lo\n"
    text = "{text}  %lo_big = icmp sgt i64 %lo0, %hi1\n"
    text = "{text}  %lo1 = select i1 %lo_big, i64 %hi1, i64 %lo0\n"
    text = "{text}  %cnt = sub i64 %hi1, %lo1\n"
    text = "{text}  %out = call ptr @orion_list_new(i64 %cnt)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %inext, %body ]\n"
    text = "{text}  %done = icmp sge i64 %i, %cnt\n"
    text = "{text}  br i1 %done, label %exit, label %body\n"
    text = "{text}body:\n"
    text = "{text}  %src_i = add i64 %lo1, %i\n"
    text = "{text}  %v = call i64 @orion_list_at(ptr %list, i64 %src_i)\n"
    text = "{text}  call void @orion_list_set(ptr %out, i64 %i, i64 %v)\n"
    text = "{text}  %inext = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}exit:\n"
    text = "{text}  ret ptr %out\n"
    text = "{text}\}\n\n"
    # Bounds-checked: an OOB set is a silent no-op. Guards the interned
    # empty list (len 0 → every index rejected) and turns stray writes
    # into non-corruption.
    text = "{text}define void @orion_list_set(ptr %list, i64 %idx, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %list, i64 1\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %neg = icmp slt i64 %idx, 0\n"
    text = "{text}  %oob = icmp sge i64 %idx, %len\n"
    text = "{text}  %bad = or i1 %neg, %oob\n"
    text = "{text}  br i1 %bad, label %skip, label %write\n"
    text = "{text}write:\n"
    text = "{text}  %offset = add i64 %idx, 2\n"
    text = "{text}  %slot = getelementptr i64, ptr %list, i64 %offset\n"
    text = "{text}  store i64 %val, ptr %slot\n"
    text = "{text}  ret void\n"
    text = "{text}skip:\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    # Copying push - persistent value semantics (the result is a FRESH
    # buffer; the input list is untouched). Used for every push except
    # the `x = append(x, v)` self-rebind statement. Result gets 2x spare
    # capacity so a chain of subsequent self-rebind pushes runs in-place.
    text = "{text}define ptr @orion_list_push(ptr %list, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %list, i64 1\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %need = add i64 %len, 1\n"
    text = "{text}  %cap2 = mul i64 %need, 2\n"
    text = "{text}  %too_small = icmp slt i64 %cap2, 4\n"
    text = "{text}  %new_cap = select i1 %too_small, i64 4, i64 %cap2\n"
    text = "{text}  %bytes = mul i64 %new_cap, 8\n"
    text = "{text}  %total = add i64 %bytes, 16\n"
    text = "{text}  %new_list = call ptr @orion_alloc(i64 %total)\n"
    text = "{text}  store i64 %new_cap, ptr %new_list\n"
    text = "{text}  %new_len_slot = getelementptr i64, ptr %new_list, i64 1\n"
    text = "{text}  store i64 %need, ptr %new_len_slot\n"
    text = "{text}  %dst_items = getelementptr i64, ptr %new_list, i64 2\n"
    text = "{text}  %src_items = getelementptr i64, ptr %list, i64 2\n"
    text = "{text}  %copy_bytes = mul i64 %len, 8\n"
    text = "{text}  %_cp = call ptr @memcpy(ptr %dst_items, ptr %src_items, i64 %copy_bytes)\n"
    text = "{text}  %app_idx = add i64 %len, 2\n"
    text = "{text}  %app_slot = getelementptr i64, ptr %new_list, i64 %app_idx\n"
    text = "{text}  store i64 %val, ptr %app_slot\n"
    text = "{text}  ret ptr %new_list\n"
    text = "{text}\}\n\n"
    # In-place push (amortized O(1)) - the self-rebind fast path.
    text = "{text}define ptr @orion_list_push_mut(ptr %list, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %cap = load i64, ptr %list\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %list, i64 1\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %has_room = icmp slt i64 %len, %cap\n"
    text = "{text}  br i1 %has_room, label %inplace, label %grow\n"
    text = "{text}inplace:\n"
    text = "{text}  %slot_idx = add i64 %len, 2\n"
    text = "{text}  %slot = getelementptr i64, ptr %list, i64 %slot_idx\n"
    text = "{text}  store i64 %val, ptr %slot\n"
    text = "{text}  %new_len = add i64 %len, 1\n"
    text = "{text}  store i64 %new_len, ptr %len_slot\n"
    text = "{text}  ret ptr %list\n"
    text = "{text}grow:\n"
    text = "{text}  %fallback = call ptr @orion_list_push(ptr %list, i64 %val)\n"
    text = "{text}  ret ptr %fallback\n"
    text = "{text}\}\n\n"
    # Maps: INDIRECT layout. Handle = [ptr entries, i64 cap, i64 len];
    # entries buffer = [k0_ptr, v0, k1_ptr, v1, ...]. Growth swaps the
    # inner buffer only, so every held map handle stays valid - the old
    # flat layout had NO capacity check and the 17th append into the
    # cap-16 slot store wrote past its allocation (heap corruption).
    text = "{text}define ptr @orion_map_new(i64 %cap) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %too_small = icmp slt i64 %cap, 4\n"
    text = "{text}  %cap2 = select i1 %too_small, i64 4, i64 %cap\n"
    text = "{text}  %handle = call ptr @orion_alloc(i64 40)\n"
    text = "{text}  %entry_bytes = mul i64 %cap2, 16\n"
    text = "{text}  %entries = call ptr @orion_alloc(i64 %entry_bytes)\n"
    text = "{text}  store ptr %entries, ptr %handle\n"
    text = "{text}  %cap_slot = getelementptr i64, ptr %handle, i64 1\n"
    text = "{text}  store i64 %cap2, ptr %cap_slot\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %handle, i64 2\n"
    text = "{text}  store i64 0, ptr %len_slot\n"
    text = "{text}  %ixn_slot = getelementptr i64, ptr %handle, i64 3\n"
    text = "{text}  store i64 0, ptr %ixn_slot\n"
    text = "{text}  %mkn_slot = getelementptr i64, ptr %handle, i64 4\n"
    text = "{text}  store i64 0, ptr %mkn_slot\n"
    text = "{text}  ret ptr %handle\n"
    text = "{text}\}\n\n"
    text = "{text}define void @orion_map_set(ptr %map, ptr %key, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %big = icmp sge i64 %len, 8\n"
    text = "{text}  br i1 %big, label %ens, label %findit\n"
    text = "{text}ens:\n"
    text = "{text}  %ixs = getelementptr i64, ptr %map, i64 3\n"
    text = "{text}  %ixv = load i64, ptr %ixs\n"
    text = "{text}  %noix = icmp eq i64 %ixv, 0\n"
    text = "{text}  br i1 %noix, label %bld, label %findit\n"
    text = "{text}bld:\n"
    text = "{text}  call void @orion_map_idx_build(ptr %map)\n"
    text = "{text}  br label %findit\n"
    text = "{text}findit:\n"
    text = "{text}  %pos = call i64 @orion_map_idx_find(ptr %map, ptr %key)\n"
    text = "{text}  %found = icmp sge i64 %pos, 0\n"
    text = "{text}  br i1 %found, label %update, label %maybe_grow\n"
    text = "{text}update:\n"
    text = "{text}  %ue = load ptr, ptr %map\n"
    text = "{text}  %uki = mul i64 %pos, 2\n"
    text = "{text}  %uvi = add i64 %uki, 1\n"
    text = "{text}  %uvs = getelementptr i64, ptr %ue, i64 %uvi\n"
    text = "{text}  store i64 %val, ptr %uvs\n"
    text = "{text}  ret void\n"
    text = "{text}maybe_grow:\n"
    text = "{text}  %cap_slot = getelementptr i64, ptr %map, i64 1\n"
    text = "{text}  %cap = load i64, ptr %cap_slot\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %full = icmp sge i64 %len, %cap\n"
    text = "{text}  br i1 %full, label %grow, label %append\n"
    text = "{text}grow:\n"
    text = "{text}  %new_cap = mul i64 %cap, 2\n"
    text = "{text}  %new_bytes = mul i64 %new_cap, 16\n"
    text = "{text}  %new_entries = call ptr @orion_alloc(i64 %new_bytes)\n"
    text = "{text}  %old_bytes = mul i64 %len, 16\n"
    text = "{text}  %_cp = call ptr @memcpy(ptr %new_entries, ptr %entries, i64 %old_bytes)\n"
    text = "{text}  store ptr %new_entries, ptr %map\n"
    text = "{text}  store i64 %new_cap, ptr %cap_slot\n"
    text = "{text}  br label %append\n"
    text = "{text}append:\n"
    text = "{text}  %entries2 = load ptr, ptr %map\n"
    text = "{text}  %app_idx2 = mul i64 %len, 2\n"
    text = "{text}  %app_k_slot = getelementptr i64, ptr %entries2, i64 %app_idx2\n"
    text = "{text}  %app_vi = add i64 %app_idx2, 1\n"
    text = "{text}  %app_v_slot = getelementptr i64, ptr %entries2, i64 %app_vi\n"
    text = "{text}  %key_owned = call ptr @orion_key_copy(ptr %key)\n"
    text = "{text}  %key_int = ptrtoint ptr %key_owned to i64\n"
    text = "{text}  store i64 %key_int, ptr %app_k_slot\n"
    text = "{text}  store i64 %val, ptr %app_v_slot\n"
    text = "{text}  %new_len = add i64 %len, 1\n"
    text = "{text}  store i64 %new_len, ptr %len_slot\n"
    text = "{text}  call void @orion_map_idx_add(ptr %map, ptr %key_owned, i64 %new_len)\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_map_get(ptr %map, ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %pos = call i64 @orion_map_idx_find(ptr %map, ptr %key)\n"
    text = "{text}  %ok = icmp sge i64 %pos, 0\n"
    text = "{text}  br i1 %ok, label %hit, label %miss\n"
    text = "{text}hit:\n"
    text = "{text}  %e = load ptr, ptr %map\n"
    text = "{text}  %ki = mul i64 %pos, 2\n"
    text = "{text}  %vi = add i64 %ki, 1\n"
    text = "{text}  %vs = getelementptr i64, ptr %e, i64 %vi\n"
    text = "{text}  %v = load i64, ptr %vs\n"
    text = "{text}  ret i64 %v\n"
    text = "{text}miss:\n"
    text = "{text}  ret i64 0\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_map_has(ptr %map, ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %pos = call i64 @orion_map_idx_find(ptr %map, ptr %key)\n"
    text = "{text}  %ok = icmp sge i64 %pos, 0\n"
    text = "{text}  %r = zext i1 %ok to i64\n"
    text = "{text}  ret i64 %r\n"
    text = "{text}\}\n\n"
    # Int-keyed map family (_ik): same indirect layout, keys compared
    # by i64 VALUE instead of strcmp. Emit picks the family per call
    # site from the key operand's LLVM shape. One map must stick to
    # one key kind (atlas: buckets keyed by eid, config by text).
    text = "{text}define void @orion_map_set_ik(ptr %map, i64 %key, i64 %val) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %cap_slot = getelementptr i64, ptr %map, i64 1\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %cap = load i64, ptr %cap_slot\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %step ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %maybe_grow, label %check\n"
    text = "{text}check:\n"
    text = "{text}  %idx2 = mul i64 %i, 2\n"
    text = "{text}  %k_slot = getelementptr i64, ptr %entries, i64 %idx2\n"
    text = "{text}  %k_int = load i64, ptr %k_slot\n"
    text = "{text}  %eq = icmp eq i64 %k_int, %key\n"
    text = "{text}  br i1 %eq, label %update, label %step\n"
    text = "{text}step:\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}update:\n"
    text = "{text}  %vi = add i64 %idx2, 1\n"
    text = "{text}  %v_slot = getelementptr i64, ptr %entries, i64 %vi\n"
    text = "{text}  store i64 %val, ptr %v_slot\n"
    text = "{text}  ret void\n"
    text = "{text}maybe_grow:\n"
    text = "{text}  %full = icmp sge i64 %len, %cap\n"
    text = "{text}  br i1 %full, label %grow, label %append\n"
    text = "{text}grow:\n"
    text = "{text}  %new_cap = mul i64 %cap, 2\n"
    text = "{text}  %new_bytes = mul i64 %new_cap, 16\n"
    text = "{text}  %new_entries = call ptr @orion_alloc(i64 %new_bytes)\n"
    text = "{text}  %old_bytes = mul i64 %len, 16\n"
    text = "{text}  %_cp = call ptr @memcpy(ptr %new_entries, ptr %entries, i64 %old_bytes)\n"
    text = "{text}  store ptr %new_entries, ptr %map\n"
    text = "{text}  store i64 %new_cap, ptr %cap_slot\n"
    text = "{text}  br label %append\n"
    text = "{text}append:\n"
    text = "{text}  %entries2 = load ptr, ptr %map\n"
    text = "{text}  %app_idx2 = mul i64 %len, 2\n"
    text = "{text}  %app_k_slot = getelementptr i64, ptr %entries2, i64 %app_idx2\n"
    text = "{text}  %app_vi = add i64 %app_idx2, 1\n"
    text = "{text}  %app_v_slot = getelementptr i64, ptr %entries2, i64 %app_vi\n"
    text = "{text}  store i64 %key, ptr %app_k_slot\n"
    text = "{text}  store i64 %val, ptr %app_v_slot\n"
    text = "{text}  %new_len = add i64 %len, 1\n"
    text = "{text}  store i64 %new_len, ptr %len_slot\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    # In-place swap-remove: found entry gets the LAST entry's key/val,
    # len shrinks by one. Zero allocation; order is not part of the
    # map contract (lookups are linear scans).
    text = "{text}define void @orion_map_remove(ptr %map, ptr %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %rixs = getelementptr i64, ptr %map, i64 3\n"
    text = "{text}  store i64 0, ptr %rixs\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %step ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %miss, label %check\n"
    text = "{text}check:\n"
    text = "{text}  %idx2 = mul i64 %i, 2\n"
    text = "{text}  %k_slot = getelementptr i64, ptr %entries, i64 %idx2\n"
    text = "{text}  %k_int = load i64, ptr %k_slot\n"
    text = "{text}  %k_ptr = inttoptr i64 %k_int to ptr\n"
    text = "{text}  %cmp = call i64 @orion_text_eq(ptr %k_ptr, ptr %key)\n"
    text = "{text}  %eq = icmp ne i64 %cmp, 0\n"
    text = "{text}  br i1 %eq, label %found, label %step\n"
    text = "{text}step:\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}found:\n"
    text = "{text}  %last = add i64 %len, -1\n"
    text = "{text}  %last2 = mul i64 %last, 2\n"
    text = "{text}  %lk_slot = getelementptr i64, ptr %entries, i64 %last2\n"
    text = "{text}  %lv_i = add i64 %last2, 1\n"
    text = "{text}  %lv_slot = getelementptr i64, ptr %entries, i64 %lv_i\n"
    text = "{text}  %lk = load i64, ptr %lk_slot\n"
    text = "{text}  %lv = load i64, ptr %lv_slot\n"
    text = "{text}  %vi = add i64 %idx2, 1\n"
    text = "{text}  %v_slot = getelementptr i64, ptr %entries, i64 %vi\n"
    text = "{text}  store i64 %lk, ptr %k_slot\n"
    text = "{text}  store i64 %lv, ptr %v_slot\n"
    text = "{text}  store i64 %last, ptr %len_slot\n"
    text = "{text}  ret void\n"
    text = "{text}miss:\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    text = "{text}define void @orion_map_remove_ik(ptr %map, i64 %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %step ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %miss, label %check\n"
    text = "{text}check:\n"
    text = "{text}  %idx2 = mul i64 %i, 2\n"
    text = "{text}  %k_slot = getelementptr i64, ptr %entries, i64 %idx2\n"
    text = "{text}  %k_int = load i64, ptr %k_slot\n"
    text = "{text}  %eq = icmp eq i64 %k_int, %key\n"
    text = "{text}  br i1 %eq, label %found, label %step\n"
    text = "{text}step:\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}found:\n"
    text = "{text}  %last = add i64 %len, -1\n"
    text = "{text}  %last2 = mul i64 %last, 2\n"
    text = "{text}  %lk_slot = getelementptr i64, ptr %entries, i64 %last2\n"
    text = "{text}  %lv_i = add i64 %last2, 1\n"
    text = "{text}  %lv_slot = getelementptr i64, ptr %entries, i64 %lv_i\n"
    text = "{text}  %lk = load i64, ptr %lk_slot\n"
    text = "{text}  %lv = load i64, ptr %lv_slot\n"
    text = "{text}  %vi = add i64 %idx2, 1\n"
    text = "{text}  %v_slot = getelementptr i64, ptr %entries, i64 %vi\n"
    text = "{text}  store i64 %lk, ptr %k_slot\n"
    text = "{text}  store i64 %lv, ptr %v_slot\n"
    text = "{text}  store i64 %last, ptr %len_slot\n"
    text = "{text}  ret void\n"
    text = "{text}miss:\n"
    text = "{text}  ret void\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_map_get_ik(ptr %map, i64 %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %step ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %miss, label %body\n"
    text = "{text}body:\n"
    text = "{text}  %ki = mul i64 %i, 2\n"
    text = "{text}  %vi = add i64 %ki, 1\n"
    text = "{text}  %k_slot = getelementptr i64, ptr %entries, i64 %ki\n"
    text = "{text}  %k_int = load i64, ptr %k_slot\n"
    text = "{text}  %eq = icmp eq i64 %k_int, %key\n"
    text = "{text}  br i1 %eq, label %hit, label %step\n"
    text = "{text}hit:\n"
    text = "{text}  %v_slot = getelementptr i64, ptr %entries, i64 %vi\n"
    text = "{text}  %v = load i64, ptr %v_slot\n"
    text = "{text}  ret i64 %v\n"
    text = "{text}step:\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}miss:\n"
    text = "{text}  ret i64 0\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_map_has_ik(ptr %map, i64 %key) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %step ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %miss, label %body\n"
    text = "{text}body:\n"
    text = "{text}  %ki = mul i64 %i, 2\n"
    text = "{text}  %k_slot = getelementptr i64, ptr %entries, i64 %ki\n"
    text = "{text}  %k_int = load i64, ptr %k_slot\n"
    text = "{text}  %eq = icmp eq i64 %k_int, %key\n"
    text = "{text}  br i1 %eq, label %hit, label %step\n"
    text = "{text}hit:\n"
    text = "{text}  ret i64 1\n"
    text = "{text}step:\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}miss:\n"
    text = "{text}  ret i64 0\n"
    text = "{text}\}\n\n"
    text = "{text}define i64 @orion_map_get_or_ik(ptr %map, i64 %key, i64 %dflt) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %has = call i64 @orion_map_has_ik(ptr %map, i64 %key)\n"
    text = "{text}  %miss = icmp eq i64 %has, 0\n"
    text = "{text}  br i1 %miss, label %use_dflt, label %fetch\n"
    text = "{text}use_dflt:\n"
    text = "{text}  ret i64 %dflt\n"
    text = "{text}fetch:\n"
    text = "{text}  %v = call i64 @orion_map_get_ik(ptr %map, i64 %key)\n"
    text = "{text}  ret i64 %v\n"
    text = "{text}\}\n\n"
    # map_len: length lives at handle slot 2 (indirect layout).
    text = "{text}define i64 @orion_map_len(ptr %map) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  ret i64 %len\n"
    text = "{text}\}\n\n"
    # map_keys / map_values: snapshot into a fresh pre-sized list.
    # arguments - the program argv as a `list of text`. argc/argv are the C
    # names for the same thing; this is the one a reader should ever meet.
    text = "{text}define ptr @orion_arguments() \{\n"
    text = "{text}entry:\n"
    text = "{text}  %n = load i64, ptr @orion_argc\n"
    text = "{text}  %out = call ptr @orion_list_new(i64 %n)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %n\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %arr = load ptr, ptr @orion_argv\n"
    text = "{text}  %slot = getelementptr ptr, ptr %arr, i64 %i\n"
    text = "{text}  %raw = load ptr, ptr %slot\n"
    text = "{text}  %t = call ptr @orion_text_from_c(ptr %raw)\n"
    text = "{text}  %ti = ptrtoint ptr %t to i64\n"
    text = "{text}  call void @orion_list_set(ptr %out, i64 %i, i64 %ti)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %out\n"
    text = "{text}\}\n\n"
    text = "{text}define ptr @orion_map_keys(ptr %map) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %out = call ptr @orion_list_new(i64 %len)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %ki = mul i64 %i, 2\n"
    text = "{text}  %k_slot = getelementptr i64, ptr %entries, i64 %ki\n"
    text = "{text}  %k_int = load i64, ptr %k_slot\n"
    text = "{text}  call void @orion_list_set(ptr %out, i64 %i, i64 %k_int)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %out\n"
    text = "{text}\}\n\n"
    text = "{text}define ptr @orion_map_values(ptr %map) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %entries = load ptr, ptr %map\n"
    text = "{text}  %len_slot = getelementptr i64, ptr %map, i64 2\n"
    text = "{text}  %len = load i64, ptr %len_slot\n"
    text = "{text}  %out = call ptr @orion_list_new(i64 %len)\n"
    text = "{text}  br label %hdr\n"
    text = "{text}hdr:\n"
    text = "{text}  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n"
    text = "{text}  %done = icmp sge i64 %i, %len\n"
    text = "{text}  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n"
    text = "{text}  %ki = mul i64 %i, 2\n"
    text = "{text}  %vi = add i64 %ki, 1\n"
    text = "{text}  %v_slot = getelementptr i64, ptr %entries, i64 %vi\n"
    text = "{text}  %v_int = load i64, ptr %v_slot\n"
    text = "{text}  call void @orion_list_set(ptr %out, i64 %i, i64 %v_int)\n"
    text = "{text}  %i_next = add i64 %i, 1\n"
    text = "{text}  br label %hdr\n"
    text = "{text}after:\n"
    text = "{text}  ret ptr %out\n"
    text = "{text}\}\n\n"
    # get_or(map, key, default) - default when the key is absent.
    text = "{text}define i64 @orion_map_get_or(ptr %map, ptr %key, i64 %dflt) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %has = call i64 @orion_map_has(ptr %map, ptr %key)\n"
    text = "{text}  %miss = icmp eq i64 %has, 0\n"
    text = "{text}  br i1 %miss, label %use_dflt, label %fetch\n"
    text = "{text}use_dflt:\n"
    text = "{text}  ret i64 %dflt\n"
    text = "{text}fetch:\n"
    text = "{text}  %v = call i64 @orion_map_get(ptr %map, ptr %key)\n"
    text = "{text}  ret i64 %v\n"
    text = "{text}\}\n\n"
    # f64 -> text: the SHORTEST decimal that reads back as the same double.
    # `%g` alone is six significant digits, so 123456789.5 came out
    # 1.23457e+08 and 1/3 came out 0.333333 - a number the program never
    # held. Try one digit, then two, until strtod gives the bits back.
    # f64 -> text: the shortest decimal that reads back as the same double.
    # The loop lives in the C runtime (orion_f64_text_into) - it has to
    # compare STRING lengths across every precision that round-trips, and
    # ten printed as `1e+01` until it did.
    text = "{text}declare void @orion_f64_text_into(ptr, double)\n"
    text = "{text}\n"
    text = "{text}define ptr @orion_f64_to_text(double %v) \{\n"
    text = "{text}entry:\n"
    text = "{text}  %buf = call ptr @orion_text_alloc(i64 39)\n"
    text = "{text}  call void @orion_f64_text_into(ptr %buf, double %v)\n"
    text = "{text}  %sealed = call ptr @orion_text_seal(ptr %buf)\n"
    text = "{text}  ret ptr %sealed\n"
    text = "{text}\}\n"
    text = "{text}\n"
    # SIMD-style elementwise vector ops over int lists. Scalar fallback;
    # autovectorizer may lift to <N x i64> via -Os.
    text = "{text}define ptr @orion_vec_add(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n  %la = call i64 @orion_list_len(ptr %a)\n  %out = call ptr @orion_list_new(i64 %la)\n  br label %hdr\n"
    text = "{text}hdr:\n  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n  %done = icmp sge i64 %i, %la\n  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n  %xa = call i64 @orion_list_at(ptr %a, i64 %i)\n  %xb = call i64 @orion_list_at(ptr %b, i64 %i)\n  %s = add i64 %xa, %xb\n  call void @orion_list_set(ptr %out, i64 %i, i64 %s)\n  %i_next = add i64 %i, 1\n  br label %hdr\n"
    text = "{text}after:\n  ret ptr %out\n\}\n\n"
    text = "{text}define ptr @orion_vec_sub(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n  %la = call i64 @orion_list_len(ptr %a)\n  %out = call ptr @orion_list_new(i64 %la)\n  br label %hdr\n"
    text = "{text}hdr:\n  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n  %done = icmp sge i64 %i, %la\n  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n  %xa = call i64 @orion_list_at(ptr %a, i64 %i)\n  %xb = call i64 @orion_list_at(ptr %b, i64 %i)\n  %s = sub i64 %xa, %xb\n  call void @orion_list_set(ptr %out, i64 %i, i64 %s)\n  %i_next = add i64 %i, 1\n  br label %hdr\n"
    text = "{text}after:\n  ret ptr %out\n\}\n\n"
    text = "{text}define ptr @orion_vec_mul(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n  %la = call i64 @orion_list_len(ptr %a)\n  %out = call ptr @orion_list_new(i64 %la)\n  br label %hdr\n"
    text = "{text}hdr:\n  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n  %done = icmp sge i64 %i, %la\n  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n  %xa = call i64 @orion_list_at(ptr %a, i64 %i)\n  %xb = call i64 @orion_list_at(ptr %b, i64 %i)\n  %s = mul i64 %xa, %xb\n  call void @orion_list_set(ptr %out, i64 %i, i64 %s)\n  %i_next = add i64 %i, 1\n  br label %hdr\n"
    text = "{text}after:\n  ret ptr %out\n\}\n\n"
    text = "{text}define i64 @orion_vec_dot(ptr %a, ptr %b) \{\n"
    text = "{text}entry:\n  %la = call i64 @orion_list_len(ptr %a)\n  br label %hdr\n"
    text = "{text}hdr:\n  %i = phi i64 [ 0, %entry ], [ %i_next, %bdy ]\n  %acc = phi i64 [ 0, %entry ], [ %acc_next, %bdy ]\n  %done = icmp sge i64 %i, %la\n  br i1 %done, label %after, label %bdy\n"
    text = "{text}bdy:\n  %xa = call i64 @orion_list_at(ptr %a, i64 %i)\n  %xb = call i64 @orion_list_at(ptr %b, i64 %i)\n  %m = mul i64 %xa, %xb\n  %acc_next = add i64 %acc, %m\n  %i_next = add i64 %i, 1\n  br label %hdr\n"
    text = "{text}after:\n  ret i64 %acc\n\}\n\n"
    # In-place SIMD add: dst[i] += src[i], real <4 x i64> vector loop + scalar
    # tail. No allocation, no per-element call - the ECS system-loop fast path.
    # List layout is [i64 cap, i64 len, data...]: the COUNT is at index 1 (len)
    # and data begins at index 2. Reading index 0 (cap) as the count and index 1
    # (len) as the first datum overruns the buffer AND clobbers the length field
    # (corruption that only surfaced when a later reader trusted len - e.g. a
    # snapshot/compaction deep-copy - walked past the real elements and crashed).
    text = "{text}define ptr @orion_vec_addi(ptr %dst, ptr %src) \{\n"
    text = "{text}entry:\n  %nslot = getelementptr i64, ptr %dst, i64 1\n  %n = load i64, ptr %nslot\n  %db = getelementptr i64, ptr %dst, i64 2\n  %sb = getelementptr i64, ptr %src, i64 2\n  %vend = and i64 %n, -4\n  br label %vhdr\n"
    text = "{text}vhdr:\n  %vi = phi i64 [ 0, %entry ], [ %vin, %vbody ]\n  %vdone = icmp sge i64 %vi, %vend\n  br i1 %vdone, label %shdr, label %vbody\n"
    text = "{text}vbody:\n  %dp = getelementptr i64, ptr %db, i64 %vi\n  %sp = getelementptr i64, ptr %sb, i64 %vi\n  %dv = load <4 x i64>, ptr %dp, align 8\n  %sv = load <4 x i64>, ptr %sp, align 8\n  %vsum = add <4 x i64> %dv, %sv\n  store <4 x i64> %vsum, ptr %dp, align 8\n  %vin = add i64 %vi, 4\n  br label %vhdr\n"
    text = "{text}shdr:\n  %si = phi i64 [ %vend, %vhdr ], [ %sin, %sbody ]\n  %sdone = icmp sge i64 %si, %n\n  br i1 %sdone, label %retb, label %sbody\n"
    text = "{text}sbody:\n  %sdp = getelementptr i64, ptr %db, i64 %si\n  %ssp = getelementptr i64, ptr %sb, i64 %si\n  %sa = load i64, ptr %sdp, align 8\n  %sbv = load i64, ptr %ssp, align 8\n  %sr = add i64 %sa, %sbv\n  store i64 %sr, ptr %sdp, align 8\n  %sin = add i64 %si, 1\n  br label %shdr\n"
    text = "{text}retb:\n  ret ptr %dst\n\}\n\n"
    # In-place SIMD multiply-add: dst[i] += src[i] * k, real <4 x i64> loop with
    # a splatted scalar + scalar tail. The physics integrate (pos += vel*dt).
    text = "{text}define ptr @orion_vec_madd(ptr %dst, ptr %src, i64 %k) \{\n"
    text = "{text}entry:\n  %nslot = getelementptr i64, ptr %dst, i64 1\n  %n = load i64, ptr %nslot\n  %db = getelementptr i64, ptr %dst, i64 2\n  %sb = getelementptr i64, ptr %src, i64 2\n  %vend = and i64 %n, -4\n  %kv0 = insertelement <4 x i64> undef, i64 %k, i32 0\n  %kv = shufflevector <4 x i64> %kv0, <4 x i64> undef, <4 x i32> zeroinitializer\n  br label %vhdr\n"
    text = "{text}vhdr:\n  %vi = phi i64 [ 0, %entry ], [ %vin, %vbody ]\n  %vdone = icmp sge i64 %vi, %vend\n  br i1 %vdone, label %shdr, label %vbody\n"
    text = "{text}vbody:\n  %dp = getelementptr i64, ptr %db, i64 %vi\n  %sp = getelementptr i64, ptr %sb, i64 %vi\n  %dv = load <4 x i64>, ptr %dp, align 8\n  %sv = load <4 x i64>, ptr %sp, align 8\n  %prod = mul <4 x i64> %sv, %kv\n  %msum = add <4 x i64> %dv, %prod\n  store <4 x i64> %msum, ptr %dp, align 8\n  %vin = add i64 %vi, 4\n  br label %vhdr\n"
    text = "{text}shdr:\n  %si = phi i64 [ %vend, %vhdr ], [ %sin, %sbody ]\n  %sdone = icmp sge i64 %si, %n\n  br i1 %sdone, label %retb, label %sbody\n"
    text = "{text}sbody:\n  %sdp = getelementptr i64, ptr %db, i64 %si\n  %ssp = getelementptr i64, ptr %sb, i64 %si\n  %ma = load i64, ptr %sdp, align 8\n  %mb = load i64, ptr %ssp, align 8\n  %mm = mul i64 %mb, %k\n  %mr = add i64 %ma, %mm\n  store i64 %mr, ptr %sdp, align 8\n  %sin = add i64 %si, 1\n  br label %shdr\n"
    text = "{text}retb:\n  ret ptr %dst\n\}\n\n"
    text


# True if any instruction is a print_raw, so its declare rides only in the
# programs that use it (a plain program's IR is byte-identical to before).
define emit_uses_print_raw(module: IRModule) -> truth:
    edit found = false
    fns = module.functions
    loop fi in 0 until length(fns):
        insts = fns[fi].instructions
        loop ii in 0 until length(insts):
            if insts[ii].op is "print_raw":
                found = true
    found

public define emit_module(module: IRModule) -> text:
    # Chunk list + one join at the end - repeated concat would re-copy
    # the growing megabyte module text once per appended piece.
    edit chunks = []
    chunks = append(chunks, "; orion_emit_llvm output\n")
    chunks = append(chunks, emit_runtime())
    if emit_uses_print_raw(module):
        chunks = append(chunks, "declare void @orion_print_raw(ptr)\n")
    # Emit declares for every user extern call - any `call @name` where
    # `name` isn't a user fn and isn't a runtime helper already declared
    # above. Without these declares clang rejects the .ll before linking.
    externs = collect_extern_calls(module)
    n_ext = length(externs)
    loop xi in 0 until n_ext:
        chunks = append(chunks, externs[xi])
        chunks = append(chunks, "\n")
    chunks = append(chunks, "\n")
    # Emit one global per distinct string literal in the module.
    strings = collect_strings(module)
    n_strings = length(strings)
    loop index in 0 until n_strings:
        chunks = append(chunks, emit_string_global(strings[index], index))
        chunks = append(chunks, "\n")
    chunks = append(chunks, "\n")
    total = length(module.functions)
    loop index in 0 until total:
        fn_value = module.functions[index]
        # Body-less fn = extern declaration → typed declare; the symbol
        # resolves at link time (C shim / libc). Runtime symbols skip
        # even the declare: emit_runtime DEFINES those and LLVM rejects
        # declare+define of one name in a module. Guard-if style, not
        # if/else, because a dangling else binds to the inner if.
        is_extern_decl = length(fn_value.instructions) is 0
        if is_extern_decl:
            if not is_runtime_symbol(fn_value.name):
                ret_ll = llvm_type_of(fn_value.return_type)
                chunks = append(chunks, "declare {ret_ll} @{fn_value.name}({emit_param_types(fn_value.params)})\n\n")
        if not is_extern_decl:
            chunks = append(chunks, emit_fn(fn_value, strings, module))
            chunks = append(chunks, "\n")
    # Wrapper @main: stash argc/argv to globals so argc()/argv(i) can read
    # them, then delegate to user's orion_main. We always emit this - if
    # the user didn't define a main, clang will complain about undefined
    # orion_main, which is the correct error.
    chunks = append(chunks, "@orion_argc = global i64 0\n")
    chunks = append(chunks, "@orion_argv = global ptr null\n\n")
    chunks = append(chunks, "define i32 @main(i32 %argc, ptr %argv) \{\n")
    chunks = append(chunks, "entry:\n")
    chunks = append(chunks, "  %argc64 = sext i32 %argc to i64\n")
    chunks = append(chunks, "  store i64 %argc64, ptr @orion_argc\n")
    chunks = append(chunks, "  store ptr %argv, ptr @orion_argv\n")
    chunks = append(chunks, "  %ret = call i64 @orion_main()\n")
    chunks = append(chunks, "  %ret32 = trunc i64 %ret to i32\n")
    chunks = append(chunks, "  ret i32 %ret32\n")
    chunks = append(chunks, "\}\n")
    orion_text_join(chunks)
