    # declared as ptr, like par_run's closure list.
    text = "{text}declare i64 @orion_task_spawn(ptr, i64)\n"
    text = "{text}declare i64 @orion_task_await(i64)\n"
    text = "{text}declare i64 @orion_task_yield()\n"
    text = "{text}declare i64 @orion_task_run_all()\n"
    text = "{text}declare i64 @orion_task_pump()\n"
    text = "{text}declare i64 @orion_task_state(i64)\n"
    text = "{text}declare i64 @orion_task_live_count()\n"
    text = "{text}declare i64 @orion_task_sleep(i64)\n"
    # Multi-shot continuations delimited by the task: the handler runs on its
