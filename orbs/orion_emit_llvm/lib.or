    text = "{text}declare i64 @orion_ms_perform(ptr, i64)\n"
    text = "{text}declare i64 @orion_ms_resume(i64)\n"
    text = "{text}declare i64 @orion_ms_supported()\n"
    text = "{text}declare ptr @orion_stdin_line()\n"
    text = "{text}declare ptr @orion_stdin_read(i64)\n"
    text = "{text}declare i64 @orion_stdout_write(ptr)\n"
    text = "{text}declare i64 @orion_stderr_line(ptr)\n"
    text = "{text}declare ptr @orion_key_copy(ptr)\n"
    text = "{text}declare i64 @orion_file_stamp(ptr)\n"
    text = "{text}declare i64 @orion_audio_init()\n"
    text = "{text}declare i64 @orion_audio_load(ptr)\n"
    text = "{text}declare i64 @orion_audio_play(i64, i64, i64, i64, i64)\n"
    text = "{text}declare i64 @orion_audio_loop(i64, i64, i64, i64, i64, i64)\n"
    text = "{text}declare i64 @orion_audio_voice_gain(i64, i64, i64)\n"
    text = "{text}declare i64 @orion_audio_stop_voice(i64, i64)\n"
    text = "{text}declare i64 @orion_audio_music(i64, i64, i64)\n"
    text = "{text}declare i64 @orion_audio_layer(i64, i64, i64)\n"
    text = "{text}declare i64 @orion_audio_stop_music(i64)\n"
    text = "{text}declare i64 @orion_audio_bus_gain(i64, i64, i64)\n"
    text = "{text}declare i64 @orion_audio_playing()\n"
    text = "{text}declare i64 @orion_audio_debug_plays()\n"
    text = "{text}declare void @orion_audio_shutdown()\n"
    text = "{text}declare i64 @orion_mic_open(i64)\n"
    text = "{text}declare i64 @orion_mic_level()\n"
    text = "{text}declare i64 @orion_mic_buffered()\n"
    text = "{text}declare i64 @orion_mic_rate()\n"
    text = "{text}declare i64 @orion_mic_take_wav(ptr)\n"
