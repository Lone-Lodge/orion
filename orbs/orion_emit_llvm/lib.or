
# orion_emit_llvm - the backend: typed IR (orion_ir) in, LLVM IR text out.
#
# Pipeline: orion_ir -> orion_emit_llvm -> .ll -> clang -> .exe. It always emits
# a Windows target triple; POSIX hosts retarget the module header before clang
# links. The last stage, so an IR op it has no lowering for is a compile error,
# not a silently wrong module.


# --- Helpers ---

define value_ref(value_id: number) -> text:
    "%v{value_id}"


# Escape a string for use in LLVM IR `c"..."` constant.
# Printable ASCII passes through; quote/backslash/non-printable use \NN hex.
# ASCII code of hex digit `value` (0-15): '0'-'9' then 'A'-'F'.
define hex_code(value: number) -> number:
    if value < 10 then 48 + value else 55 + value

define llvm_escape(text: text) -> text:
    # Built as a byte list, one text at the end: per-byte text concat is
    # quadratic, and `embed` runs whole asset files through here.
    bs = bytes_of(text)
    total = length(bs)
    edit out = []
    loop index in 0 until total:
        b = bs[index]
        needs_escape = b is 34 or b is 92 or b < 32 or b > 126
        if needs_escape:
            out = append(out, 92)
            out = append(out, hex_code(b // 16))
            out = append(out, hex_code(b % 16))
        else:
            out = append(out, b)
    text_of(out)


# Find the index of `target` in a list of strings. -1 if not found.
define string_list_index(strings: [text], target: text) -> number:
    total = length(strings)
    edit found = 0 - 1
    loop index in 0 until total:
        if strings[index] is target and found is (0 - 1):
            found = index
    found


# True if `name` is a runtime symbol already declared/defined by the
# emitted runtime prelude (orion_* helpers, __orion_* effect shims,
# libc functions clang links against). Used to skip re-declaring these
# as user externs.
define is_runtime_symbol(name: text) -> truth:
    bs = bytes_of(name)
    n = length(bs)
    # orion_* prefix
    starts_orion = n >= 6 and bs[0] is 111 and bs[1] is 114 and bs[2] is 105 and bs[3] is 111 and bs[4] is 110 and bs[5] is 95
    # __orion_* prefix
    starts_uu_orion = n >= 8 and bs[0] is 95 and bs[1] is 95 and bs[2] is 111 and bs[3] is 114 and bs[4] is 105 and bs[5] is 111 and bs[6] is 110 and bs[7] is 95
    is_libc = name is "puts" or name is "printf" or name is "malloc" or name is "strlen" or name is "strcpy" or name is "strcat" or name is "strcmp" or name is "snprintf" or name is "memcpy" or name is "strstr" or name is "fopen" or name is "fclose" or name is "fread" or name is "fwrite" or name is "ftell" or name is "fseek"
    starts_orion or starts_uu_orion or is_libc

# True if `name` is defined by a user-level fn in the module.
define is_module_defined(module: IRModule, name: text) -> truth:
    n_fns = length(module.functions)
    edit found = false
    loop fi in 0 until n_fns:
        f = module.functions[fi]
        if f.name is name:
            found = true
    found

# Walk the module for `call @name(...)` ops where `name` is neither a
# module-defined fn nor a runtime symbol → emit `declare i64 @name(...)`
# with the caller's arg types. Signatures default to i64 return since
# ast_to_ir already types unknown-fn returns as i64.
define collect_extern_calls(module: IRModule) -> [text]:
    n_fns = length(module.functions)
    edit names = []
    edit declares = []
    loop fi in 0 until n_fns:
        fn_value = module.functions[fi]
        n_insts = length(fn_value.instructions)
        loop ii in 0 until n_insts:
            inst = fn_value.instructions[ii]
            if inst.op is "call":
                name = inst.name
                if not is_runtime_symbol(name):
                    if not is_module_defined(module, name):
                        if string_list_index(names, name) < 0:
                            names = append(names, name)
                            n_args = length(inst.args)
                            edit sig = ""
                            loop ai in 0 until n_args:
                                arg_id = inst.args[ai]
                                arg_ty = llvm_type_of(ssa_value_type(arg_id, fn_value, module))
                                sep = if ai is 0 then "" else ", "
                                sig = "{sig}{sep}{arg_ty}"
                            declares = append(declares, "declare i64 @{name}({sig})")
    declares


# Walk the module to collect every distinct string literal used by
# print_str or const_str instructions. Returned list is in first-seen order.
define collect_strings(module: IRModule) -> [text]:
    n_fns = length(module.functions)
    edit result = []
    loop fi in 0 until n_fns:
        fn_value = module.functions[fi]
        n_insts = length(fn_value.instructions)
        loop ii in 0 until n_insts:
            inst = fn_value.instructions[ii]
            is_str_op = inst.op is "print_str" or inst.op is "const_str"
            if is_str_op:
                existing = string_list_index(result, inst.name)
                if existing < 0:
                    result = append(result, inst.name)
    result


# Split a pipe-separated label list "a|b" into ["a", "b"].
define split_pipe(text: text) -> [text]:
    bs = bytes_of(text)
    total = length(bs)
    edit parts = []
    edit current = ""
    loop index in 0 until total:
        ch = bs[index]
        if ch is 124:  # '|'
            parts = append(parts, current)
            current = ""
        else:
            single = text_of([ch])
            current = "{current}{single}"
    parts = append(parts, current)
    parts


define icmp_cc(op: text) -> text:
    edit cc = "eq"
    if op is "icmp_ne":
        cc = "ne"
    if op is "icmp_lt":
        cc = "slt"
    if op is "icmp_le":
        cc = "sle"
    if op is "icmp_gt":
        cc = "sgt"
    if op is "icmp_ge":
        cc = "sge"
    cc


# --- Per-instruction emit ---

# Look up a fn's return type in the module; defaults to "i64".
define find_fn_return_type(module: IRModule, fn_name: text) -> text:
    n = length(module.functions)
    edit result = "i64"
    # Built-in runtime fns we provide in emit_runtime - return types are
    # known statically, no AST entry exists for them.
    if fn_name is "__orion_resume_int":
        result = "void"
    if fn_name is "__orion_resume_real":
        result = "void"
    if fn_name is "__orion_perform_int":
        result = "i64"
    if fn_name is "orion_struct_field_int":
        result = "i64"
    if fn_name is "orion_struct_field_text":
        result = "text"
    if fn_name is "orion_text_to_f64":
        result = "f64"
    if fn_name is "orion_persist_text":
        result = "text"
    loop index in 0 until n:
        f = module.functions[index]
        if f.name is fn_name:
            result = f.return_type
    result


# Actual produced type of an SSA value. For call ops, look up the called
# fn's return type (the call inst itself has a placeholder type).
define ssa_value_type(value_id: number, fn_value: IRFn, module: IRModule) -> text:
    if value_id < 0:
        "i64"
    else:
        inst = fn_value.instructions[value_id]
        if inst.op is "call":
            find_fn_return_type(module, inst.name)
        else:
            inst.type_text


public define emit_instruction(inst: Inst, my_id: number, strings: [text], fn_value: IRFn, module: IRModule) -> text:
    op = inst.op
    is_icmp = op is "icmp_eq" or op is "icmp_ne" or op is "icmp_lt" or op is "icmp_le" or op is "icmp_gt" or op is "icmp_ge"
    is_logical = op is "iand" or op is "ior"
    # Default for unknown ops: emit a defined SSA slot (= 0) plus a
    # marker comment. Without the slot, downstream phi nodes or
    # consumers would reference undefined `%vN` and clang would reject
    # the whole module with a confusing error.
    edit result = "    {value_ref(my_id)} = add i64 0, 0    ; UNSUPPORTED op={op}"

    if op is "iconst":
        result = "    {value_ref(my_id)} = add i64 0, {inst.value}"

    if op is "param":
        # Rebind the parameter to its function-arg name "%pN".
        ty = llvm_type_of(inst.type_text)
        if ty is "ptr":
            result = "    {value_ref(my_id)} = getelementptr i8, ptr %p{inst.value}, i64 0"
        else:
            if ty is "double":
                result = "    {value_ref(my_id)} = fadd double %p{inst.value}, 0x0000000000000000"
            else:
                result = "    {value_ref(my_id)} = add i64 0, %p{inst.value}"

    if op is "bits_of_real":
        result = "    {value_ref(my_id)} = bitcast double {value_ref(inst.value)} to i64"

    if op is "slot_get_real":
        sgr_w = "%v{my_id}.w"
        result = "    {sgr_w} = call i64 @orion_slot_get_int(ptr {value_ref(inst.value)})\n    {value_ref(my_id)} = bitcast i64 {sgr_w} to double"

    if op is "param_bits":
        # A handler's real parameter. It arrives as a WORD (the runtime casts
        # the handler to an all-i64 signature and only knows the arity), and
        # this reads the double back out of it.
        result = "    {value_ref(my_id)} = bitcast i64 %p{inst.value} to double"

    if op is "call":
        n_args = length(inst.args)
        edit arg_text = ""
        loop ai in 0 until n_args:
            arg_id = inst.args[ai]
            arg_ty = llvm_type_of(ssa_value_type(arg_id, fn_value, module))
            sep = if ai is 0 then "" else ", "
            arg_text = "{arg_text}{sep}{arg_ty} {value_ref(arg_id)}"
        # __orion_resume_int / __orion_resume_text return void - emit
        # `call void` + dummy SSA. Other fns go through the normal path;
        # their return-type lookup is in find_fn_return_type which
        # defaults non-matches to i64.
        is_void_resume = inst.name is "__orion_resume_int" or inst.name is "__orion_resume_text" or inst.name is "__orion_resume_real"
        if is_void_resume:
            # `resume` never comes back, but the block still needs a value
            # to fall out with and the function still needs a `ret`. That
            # placeholder has to be the function's OWN return type - a
            # handler answering with a real got `ret double` on an i64 zero,
            # which clang refused by name.
            vr_ty = llvm_type_of(fn_value.return_type)
            vr_zero = if vr_ty is "double" then "fadd double 0.0, 0.0" else "add i64 0, 0"
            result = "    call void @{inst.name}({arg_text})\n    {value_ref(my_id)} = {vr_zero}"
        else:
            ret_ty = llvm_type_of(find_fn_return_type(module, inst.name))
            result = "    {value_ref(my_id)} = call {ret_ty} @{inst.name}({arg_text})"

    if op is "perform_int" or op is "perform_text" or op is "perform_real":
        # The handler fn goes in as a ptr constant (inst.name), then the arg
        # COUNT, then four i64 slots - every Orion value is a 64-bit word, so a
        # pointer argument is passed as its bits (ptrtoint) and unused slots are
        # zero. The runtime casts the handler to the matching arity. The
        # resulting SSA value holds the handler's return, or the resumed value
        # if it called `resume`.
        pf_n = length(inst.args)
        edit pf_pre = ""
        edit pf_slots = ""
        loop pfi in 0 until 4:
            pf_sep = if pfi is 0 then "" else ", "
            if pfi < pf_n:
                pf_id = inst.args[pfi]
                pf_ty = llvm_type_of(ssa_value_type(pf_id, fn_value, module))
                if pf_ty is "ptr":
                    pf_tmp = "%v{my_id}.a{pfi}"
                    pf_pre = "{pf_pre}    {pf_tmp} = ptrtoint ptr {value_ref(pf_id)} to i64\n"
                    pf_slots = "{pf_slots}{pf_sep}i64 {pf_tmp}"
                else if pf_ty is "double":
                    # A real one rides as its BITS. The slot is 64 bits and so
                    # is the double, so nothing is lost; the handler bitcasts
                    # it back (see `param_bits`). Passing it as a double would
                    # need the runtime to cast the handler per argument SHAPE
                    # and not just per arity - sixteen casts for four slots.
                    pf_dtmp = "%v{my_id}.d{pfi}"
                    pf_pre = "{pf_pre}    {pf_dtmp} = bitcast double {value_ref(pf_id)} to i64\n"
                    pf_slots = "{pf_slots}{pf_sep}i64 {pf_dtmp}"
                else:
                    pf_slots = "{pf_slots}{pf_sep}i64 {value_ref(pf_id)}"
            else:
                pf_slots = "{pf_slots}{pf_sep}i64 0"
        # Three carriers, one shape. The ARGUMENTS are 64-bit words in every
        # case; only the answer differs.
        edit pf_fam = "__orion_perform_int_n"
        edit pf_ret = "i64"
        if op is "perform_text":
            pf_fam = "__orion_perform_text_n"
            pf_ret = "ptr"
        if op is "perform_real":
            pf_fam = "__orion_perform_real_n"
            pf_ret = "double"
        result = "{pf_pre}    {value_ref(my_id)} = call {pf_ret} @{pf_fam}(ptr @{inst.name}, i64 {pf_n}, {pf_slots})"

    if op is "fn_ref":
        # Function pointer constant - `@<name>` evaluates to a ptr in LLVM.
        # Use getelementptr with 0 offset to force it into an SSA slot.
        result = "    {value_ref(my_id)} = getelementptr i8, ptr @{inst.name}, i64 0"

    if op is "indirect_call":
        # Indirect call: callee SSA value is in inst.value; args same as call.
        n_args = length(inst.args)
        edit arg_text = ""
        loop ai in 0 until n_args:
            arg_id = inst.args[ai]
            arg_ty = llvm_type_of(ssa_value_type(arg_id, fn_value, module))
            sep = if ai is 0 then "" else ", "
            arg_text = "{arg_text}{sep}{arg_ty} {value_ref(arg_id)}"
        ret_ty = llvm_type_of(inst.type_text)
        callee_ref = value_ref(inst.value)
        result = "    {value_ref(my_id)} = call {ret_ty} {callee_ref}({arg_text})"

    if op is "int_to_ptr":
        result = "    {value_ref(my_id)} = inttoptr i64 {value_ref(inst.value)} to ptr"

    if op is "make_closure":
        # Build [fn_ptr_as_int, is_lambda_flag, cap0, cap1, ...] as a list.
        n_caps = length(inst.args)
        total = 2 + n_caps
        edit mc = "    {value_ref(my_id)} = call ptr @orion_list_new(i64 {total})"
        mc = "{mc}\n    %v{my_id}.fp = ptrtoint ptr @{inst.name} to i64"
        mc = "{mc}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 0, i64 %v{my_id}.fp)"
        mc = "{mc}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 1, i64 {inst.lhs})"
        loop ci in 0 until n_caps:
            cap_id = inst.args[ci]
            cap_slot = 2 + ci
            cap_ty = llvm_type_of(ssa_value_type(cap_id, fn_value, module))
            if cap_ty is "ptr":
                mc = "{mc}\n    %v{my_id}.c{ci} = ptrtoint ptr {value_ref(cap_id)} to i64"
                mc = "{mc}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 {cap_slot}, i64 %v{my_id}.c{ci})"
            else:
                mc = "{mc}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 {cap_slot}, i64 {value_ref(cap_id)})"
        result = mc

    if op is "closure_call":
        # Load fn-ptr + flag; a lambda is called function(env, args), a plain fn-ref
        # function(args). env is the closure list itself.
        # The closure operand must be a ptr to the closure list. It usually is
        # (a lambda local, a struct field), but a fn-ref reaching us as an i64 -
        # a `Fn`-typed parameter, or an element read from a list of fn-refs -
        # holds the pointer BITS as an integer, so recover the ptr first.
        clos_raw = value_ref(inst.value)
        clos_lty = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        edit clos = clos_raw
        edit clos_pre = ""
        if clos_lty is not "ptr":
            clos_pre = "    %v{my_id}.clp = inttoptr i64 {clos_raw} to ptr\n"
            clos = "%v{my_id}.clp"
        cc_ret = llvm_type_of(inst.type_text)
        n_ca = length(inst.args)
        edit cc_args = ""
        loop cai in 0 until n_ca:
            ca_id = inst.args[cai]
            ca_ty = llvm_type_of(ssa_value_type(ca_id, fn_value, module))
            csep = if cai is 0 then "" else ", "
            cc_args = "{cc_args}{csep}{ca_ty} {value_ref(ca_id)}"
        lam_args = if n_ca is 0 then "ptr {clos}" else "ptr {clos}, {cc_args}"
        edit cc = "{clos_pre}    %v{my_id}.fpi = call i64 @orion_list_at(ptr {clos}, i64 0)"
        cc = "{cc}\n    %v{my_id}.flg = call i64 @orion_list_at(ptr {clos}, i64 1)"
        cc = "{cc}\n    %v{my_id}.p = inttoptr i64 %v{my_id}.fpi to ptr"
        cc = "{cc}\n    %v{my_id}.isl = icmp eq i64 %v{my_id}.flg, 1"
        cc = "{cc}\n    br i1 %v{my_id}.isl, label %clam{my_id}, label %cpln{my_id}"
        cc = "{cc}\nclam{my_id}:"
        cc = "{cc}\n    %v{my_id}.r1 = call {cc_ret} %v{my_id}.p({lam_args})"
        cc = "{cc}\n    br label %cmrg{my_id}"
        cc = "{cc}\ncpln{my_id}:"
        cc = "{cc}\n    %v{my_id}.r2 = call {cc_ret} %v{my_id}.p({cc_args})"
        cc = "{cc}\n    br label %cmrg{my_id}"
        cc = "{cc}\ncmrg{my_id}:"
        cc = "{cc}\n    {value_ref(my_id)} = phi {cc_ret} [ %v{my_id}.r1, %clam{my_id} ], [ %v{my_id}.r2, %cpln{my_id} ]"
        result = cc

    if op is "label":
        # Emit basic-block label (no leading 4-space indent).
        result = "{inst.name}:"

    if op is "br":
        result = "    br label %{inst.name}"

    if op is "br_if":
        # name = "then_lbl|else_lbl" - split on '|'.
        # Coerce cond from i64 to i1 first.
        labels = split_pipe(inst.name)
        then_lbl = labels[0]
        else_lbl = labels[1]
        cond_bool = "%v{my_id}.cb"
        l1 = "    {cond_bool} = icmp ne i64 {value_ref(inst.value)}, 0"
        l2 = "    br i1 {cond_bool}, label %{then_lbl}, label %{else_lbl}"
        result = "{l1}\n{l2}"

    if op is "phi":
        labels = split_pipe(inst.name)
        then_lbl = labels[0]
        else_lbl = labels[1]
        # phi's type matches its operands' type (both should agree).
        then_inst = fn_value.instructions[inst.lhs]
        phi_ty = llvm_type_of(then_inst.type_text)
        result = "    {value_ref(my_id)} = phi {phi_ty} [ {value_ref(inst.lhs)}, %{then_lbl} ], [ {value_ref(inst.rhs)}, %{else_lbl} ]"

    if op is "fconst":
        # Exact IEEE-754 bits via strtod at compile time - LLVM rejects
        # inexact decimal FP literals (0.1), hex form is always exact.
        hex_bits = orion_f64_literal_hex(inst.name)
        result = "    {value_ref(my_id)} = fadd double {hex_bits}, 0x0000000000000000"

    if op is "fadd" or op is "fsub" or op is "fmul" or op is "fdiv" or op is "frem":
        result = "    {value_ref(my_id)} = {op} double {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"

    if op is "fcmp":
        fb = "%v{my_id}.b"
        l1 = "    {fb} = fcmp {inst.name} double {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
        l2 = "    {value_ref(my_id)} = zext i1 {fb} to i64"
        result = "{l1}\n{l2}"

    if op is "sitofp":
        result = "    {value_ref(my_id)} = sitofp i64 {value_ref(inst.value)} to double"

    if op is "fptosi":
        result = "    {value_ref(my_id)} = fptosi double {value_ref(inst.value)} to i64"

    if op is "iadd":
        result = "    {value_ref(my_id)} = add i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "isub":
        result = "    {value_ref(my_id)} = sub i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "imul":
        result = "    {value_ref(my_id)} = mul i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "idiv":
        result = "    {value_ref(my_id)} = call i64 @orion_idiv(i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
    if op is "imod":
        result = "    {value_ref(my_id)} = call i64 @orion_imod(i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
    # Bitwise + shifts map straight onto LLVM. `shr` is ARITHMETIC (ashr): an
    # Orion int is signed, so shifting a negative right must keep its sign.
    if op is "bit_and":
        result = "    {value_ref(my_id)} = and i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "bit_or":
        result = "    {value_ref(my_id)} = or i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "bit_xor":
        result = "    {value_ref(my_id)} = xor i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "shl":
        result = "    {value_ref(my_id)} = shl i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"
    if op is "shr":
        result = "    {value_ref(my_id)} = ashr i64 {value_ref(inst.lhs)}, {value_ref(inst.rhs)}"

    if is_icmp:
        cc = icmp_cc(op)
        bool_name = "%v{my_id}.b"
        lhs_ll = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        rhs_ll = llvm_type_of(ssa_value_type(inst.rhs, fn_value, module))
        both_i64 = lhs_ll is "i64" and rhs_ll is "i64"
        both_ptr = lhs_ll is "ptr" and rhs_ll is "ptr"
        # ptrtoint any ptr operand so we can always do icmp i64. Both-ptr
        # keeps identity semantics; mixed casts the ptr side to i64.
        edit prelude = ""
        edit lhs_ref = value_ref(inst.lhs)
        edit rhs_ref = value_ref(inst.rhs)
        icmp_ty = if both_ptr then "ptr" else "i64"
        if both_ptr is false:
            if lhs_ll is "ptr":
                lhs_ref = "%v{my_id}.pl"
                prelude = "    {lhs_ref} = ptrtoint ptr {value_ref(inst.lhs)} to i64\n"
            if rhs_ll is "ptr":
                rhs_ref = "%v{my_id}.pr"
                prelude = "{prelude}    {rhs_ref} = ptrtoint ptr {value_ref(inst.rhs)} to i64\n"
        l1 = "{prelude}    {bool_name} = icmp {cc} {icmp_ty} {lhs_ref}, {rhs_ref}"
        l2 = "    {value_ref(my_id)} = zext i1 {bool_name} to i64"
        result = "{l1}\n{l2}"

    if op is "select":
        cond_name = "%v{my_id}.c"
        l1 = "    {cond_name} = icmp ne i64 {value_ref(inst.value)}, 0"
        l2 = "    {value_ref(my_id)} = select i1 {cond_name}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)}"
        result = "{l1}\n{l2}"

    if is_logical:
        bool_op = if op is "iand" then "and" else "or"
        ab = "%v{my_id}.la"
        bb = "%v{my_id}.lb"
        rb = "%v{my_id}.lr"
        l1 = "    {ab} = icmp ne i64 {value_ref(inst.lhs)}, 0"
        l2 = "    {bb} = icmp ne i64 {value_ref(inst.rhs)}, 0"
        l3 = "    {rb} = {bool_op} i1 {ab}, {bb}"
        l4 = "    {value_ref(my_id)} = zext i1 {rb} to i64"
        result = "{l1}\n{l2}\n{l3}\n{l4}"

    if op is "inot":
        eq0 = "%v{my_id}.n"
        l1 = "    {eq0} = icmp eq i64 {value_ref(inst.value)}, 0"
        l2 = "    {value_ref(my_id)} = zext i1 {eq0} to i64"
        result = "{l1}\n{l2}"

    if op is "print_int":
        # Side-effect call. Emit a sentinel %vN = 0 after so the SSA slot
        # is defined (in case a phi or downstream consumer references it).
        l1 = "    call i32 (ptr, ...) @printf(ptr @.fmt_int, i64 {value_ref(inst.value)})"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l1}\n{l2}"

    if op is "print_float":
        l1 = "    call i32 (ptr, ...) @printf(ptr @.fmt_float, double {value_ref(inst.value)})"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l1}\n{l2}"

    if op is "print_str":
        # Look up the global name for this string and call puts -
        # the bytes start 16 past the H1 header.
        idx = string_list_index(strings, inst.name)
        ps_name = "%v{my_id}.ps"
        l0 = "    {ps_name} = getelementptr i8, ptr @.str_{idx}, i64 16"
        l1 = "    call i32 @puts(ptr {ps_name})"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l0}\n{l1}\n{l2}"

    if op is "const_str":
        idx = string_list_index(strings, inst.name)
        # Pointer to the first byte of the global string.
        result = "    {value_ref(my_id)} = getelementptr i8, ptr @.str_{idx}, i64 16"

    if op is "text_concat":
        result = "    {value_ref(my_id)} = call ptr @orion_text_concat(ptr {value_ref(inst.lhs)}, ptr {value_ref(inst.rhs)})"

    if op is "text_join":
        result = "    {value_ref(my_id)} = call ptr @orion_text_join(ptr {value_ref(inst.value)})"

    if op is "int_to_text":
        result = "    {value_ref(my_id)} = call ptr @orion_int_to_text(i64 {value_ref(inst.value)})"

    if op is "text_byte_at":
        # A text VALUE points at its first byte (the 16-byte header sits
        # behind it), so the i-th byte is one getelementptr and one load.
        tba_p = "%v{my_id}.p"
        tba_b = "%v{my_id}.b"
        result = "    {tba_p} = getelementptr i8, ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}\n    {tba_b} = load i8, ptr {tba_p}\n    {value_ref(my_id)} = zext i8 {tba_b} to i64"

    if op is "text_len":
        result = "    {value_ref(my_id)} = call i64 @orion_tlen(ptr {value_ref(inst.value)})"

    if op is "text_chars":
        result = "    {value_ref(my_id)} = call i64 @orion_tchars(ptr {value_ref(inst.value)})"

    if op is "truth_text":
        tt_c = "%v{my_id}.tc"
        result = "    {tt_c} = icmp ne i64 {value_ref(inst.value)}, 0\n    {value_ref(my_id)} = select i1 {tt_c}, ptr getelementptr(i8, ptr @.str_true_h, i64 16), ptr getelementptr(i8, ptr @.str_false_h, i64 16)"

    if op is "text_cpoff":
        result = "    {value_ref(my_id)} = call i64 @orion_cpoff(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)})"

    if op is "text_slice":
        result = "    {value_ref(my_id)} = call ptr @orion_text_slice(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"

    if op is "text_contains":
        result = "    {value_ref(my_id)} = call i64 @orion_text_contains(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"

    if op is "file_read":
        result = "    {value_ref(my_id)} = call ptr @orion_file_read(ptr {value_ref(inst.value)})"

    if op is "file_write":
        result = "    {value_ref(my_id)} = call i64 @orion_file_write(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"

    if op is "arguments":
        result = "    {value_ref(my_id)} = call ptr @orion_arguments()"

    if op is "argc":
        result = "    {value_ref(my_id)} = load i64, ptr @orion_argc"

    if op is "argv":
        slot_name = "%v{my_id}.slot"
        arr_name = "%v{my_id}.arr"
        l1 = "    {arr_name} = load ptr, ptr @orion_argv"
        l2 = "    {slot_name} = getelementptr ptr, ptr {arr_name}, i64 {value_ref(inst.value)}"
        raw_name = "%v{my_id}.raw"
        l3 = "    {raw_name} = load ptr, ptr {slot_name}"
        # argv strings are foreign C strings - wrap into headered
        # texts at the boundary.
        l4 = "    {value_ref(my_id)} = call ptr @orion_text_from_c(ptr {raw_name})"
        result = "{l1}\n{l2}\n{l3}\n{l4}"

    if op is "bytes_from_text":
        v_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if v_ll is "ptr":
            result = "    {value_ref(my_id)} = call ptr @orion_bytes_from_text(ptr {value_ref(inst.value)})"
        else:
            cst = "%v{my_id}.arg"
            l1 = "    {cst} = inttoptr i64 {value_ref(inst.value)} to ptr"
            l2 = "    {value_ref(my_id)} = call ptr @orion_bytes_from_text(ptr {cst})"
            result = "{l1}\n{l2}"

    if op is "bytes_to_text":
        v_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if v_ll is "ptr":
            result = "    {value_ref(my_id)} = call ptr @orion_bytes_to_text(ptr {value_ref(inst.value)})"
        else:
            cst = "%v{my_id}.arg"
            l1 = "    {cst} = inttoptr i64 {value_ref(inst.value)} to ptr"
            l2 = "    {value_ref(my_id)} = call ptr @orion_bytes_to_text(ptr {cst})"
            result = "{l1}\n{l2}"

    if op is "bytes_slice":
        v_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if v_ll is "ptr":
            result = "    {value_ref(my_id)} = call ptr @orion_bytes_slice(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
        else:
            cst = "%v{my_id}.arg"
            l1 = "    {cst} = inttoptr i64 {value_ref(inst.value)} to ptr"
            l2 = "    {value_ref(my_id)} = call ptr @orion_bytes_slice(ptr {cst}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
            result = "{l1}\n{l2}"

    if op is "bytes_concat":
        v_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        l_ll = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        a_ref = if v_ll is "ptr" then value_ref(inst.value) else "%v{my_id}.a"
        b_ref = if l_ll is "ptr" then value_ref(inst.lhs) else "%v{my_id}.b"
        edit prelude = ""
        if v_ll is not "ptr":
            prelude = "    {a_ref} = inttoptr i64 {value_ref(inst.value)} to ptr\n"
        if l_ll is not "ptr":
            prelude = "{prelude}    {b_ref} = inttoptr i64 {value_ref(inst.lhs)} to ptr\n"
        result = "{prelude}    {value_ref(my_id)} = call ptr @orion_bytes_concat(ptr {a_ref}, ptr {b_ref})"

    if op is "bytes_zeros":
        result = "    {value_ref(my_id)} = call ptr @orion_bytes_zeros(i64 {value_ref(inst.value)})"

    if op is "slot_get":
        # Always returns ptr; type_text on inst tells caller what to do.
        result = "    {value_ref(my_id)} = call ptr @orion_slot_get(ptr {value_ref(inst.value)})"

    if op is "slot_has":
        result = "    {value_ref(my_id)} = call i64 @orion_slot_has(ptr {value_ref(inst.value)})"

    if op is "text_hash":
        result = "    {value_ref(my_id)} = call i64 @orion_text_hash(ptr {value_ref(inst.value)})"

    if op is "slot_get_int":
        result = "    {value_ref(my_id)} = call i64 @orion_slot_get_int(ptr {value_ref(inst.value)})"

    if op is "slot_set":
        # val_id may be i64 or ptr. Pointer values pass the evacuation
        # boundary: a region-born value deep-copies to the malloc heap
        # (typed by the static code below) instead of dangling - the
        # old guard's abort survives only for types with no copier.
        val_inst = fn_value.instructions[inst.lhs]
        val_ty = llvm_type_of(val_inst.type_text)
        if val_ty is "ptr":
            code = evac_code(val_inst.type_text)
            # STATISTIC, recorded where the fact is known. Code 0 means the
            # boundary has no copier for this shape, so a region-born value
            # stored here cannot be evacuated and the runtime aborts instead.
            # Every such site is a place that CAN abort, and they are all known
            # at compile time - so count them and be able to name them, rather
            # than discovering one from a crash report. See memfacts_report.
            memfact_count("stores")
            if code is 0:
                memfact_note(fn_value.name, val_inst.type_text)
            evp = "%v{my_id}.ev"
            tmp = "%v{my_id}.sp"
            l0 = "    {evp} = call ptr @orion_slot_evac(ptr {value_ref(inst.lhs)}, ptr {value_ref(inst.value)}, i64 {code})"
            l1 = "    {tmp} = ptrtoint ptr {evp} to i64"
            l2 = "    {value_ref(my_id)} = call i64 @orion_slot_set(ptr {value_ref(inst.value)}, i64 {tmp})"
            result = "{l0}\n{l1}\n{l2}"
        else:
            result = "    {value_ref(my_id)} = call i64 @orion_slot_set(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)})"

    is_text_cmp = op is "text_eq" or op is "text_ne" or op is "text_lt" or op is "text_le" or op is "text_gt" or op is "text_ge"
    if is_text_cmp:
        if op is "text_eq" or op is "text_ne":
            # H3 harvest of the H1 headers: equality via orion_text_eq -
            # same-ptr, length and cached-hash rejects run before any
            # byte is touched. Ordering below still walks bytes.
            eq_id = "%v{my_id}.e"
            l1 = "    {eq_id} = call i64 @orion_text_eq(ptr {value_ref(inst.lhs)}, ptr {value_ref(inst.rhs)})"
            l2 = if op is "text_eq" then "    {value_ref(my_id)} = add i64 {eq_id}, 0" else "    {value_ref(my_id)} = xor i64 {eq_id}, 1"
            result = "{l1}\n{l2}"
        else:
            edit cc = "slt"
            if op is "text_le":
                cc = "sle"
            if op is "text_gt":
                cc = "sgt"
            if op is "text_ge":
                cc = "sge"
            cmp_id = "%v{my_id}.s"
            bool_id = "%v{my_id}.b"
            l1 = "    {cmp_id} = call i32 @strcmp(ptr {value_ref(inst.lhs)}, ptr {value_ref(inst.rhs)})"
            l2 = "    {bool_id} = icmp {cc} i32 {cmp_id}, 0"
            l3 = "    {value_ref(my_id)} = zext i1 {bool_id} to i64"
            result = "{l1}\n{l2}\n{l3}"

    if op is "print_text":
        l1 = "    call i32 @puts(ptr {value_ref(inst.value)})"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l1}\n{l2}"

    if op is "print_raw":
        l1 = "    call void @orion_print_raw(ptr {value_ref(inst.value)})"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l1}\n{l2}"

    if op is "list_lit":
        n = length(inst.args)
        # `[]` interns to one shared constant: cap 0 forces every push -
        # plain, push_mut, and the retired implicit rewrite is gone -
        # down the grow/copy path, and bounds-checked list_set rejects
        # all writes. Empty literals in per-frame code otherwise malloc
        # 16 bytes each, forever (~32 B per idle frame in cubsy).
        if n is 0:
            return "    {value_ref(my_id)} = getelementptr i64, ptr @orion_empty_list, i64 0"
        edit text = "    {value_ref(my_id)} = call ptr @orion_list_new(i64 {n})"
        # Box each element by the LIST's element type - the SAME source
        # list_at reads back through. Keying off the individual element's
        # SSA type instead desynced store from load (list_lit bitcast a
        # double element that list_at, going by the list type, did NOT
        # un-bitcast) and corrupted every read - a map value stored that
        # way came back as garbage bits. list slots are i64: a ptr element
        # is ptrtoint'd, a double stores its bits (list_at bitcasts back),
        # everything else stores as-is.
        elem_ll = llvm_type_of(list_elem_type(inst.type_text))
        loop ai in 0 until n:
            item_id = inst.args[ai]
            if elem_ll is "ptr":
                tmp = "%v{my_id}.lp{ai}"
                text = "{text}\n    {tmp} = ptrtoint ptr {value_ref(item_id)} to i64"
                text = "{text}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 {ai}, i64 {tmp})"
            else:
                if elem_ll is "double":
                    ftmp = "%v{my_id}.lf{ai}"
                    text = "{text}\n    {ftmp} = bitcast double {value_ref(item_id)} to i64"
                    text = "{text}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 {ai}, i64 {ftmp})"
                else:
                    text = "{text}\n    call void @orion_list_set(ptr {value_ref(my_id)}, i64 {ai}, i64 {value_ref(item_id)})"
        result = text

    if op is "list_at":
        # If the source list has a known element type (e.g. "list:text"),
        # cast the i64 result back to ptr after loading.
        src_inst = fn_value.instructions[inst.value]
        elem = list_elem_type(src_inst.type_text)
        elem_ll = llvm_type_of(elem)
        la_i64 = llvm_type_of(ssa_value_type(inst.value, fn_value, module)) is "i64"
        la_src = if la_i64 then "%v{my_id}.m" else value_ref(inst.value)
        la_pre = if la_i64 then "    {la_src} = inttoptr i64 {value_ref(inst.value)} to ptr\n" else ""
        if elem_ll is "ptr":
            int_name = "%v{my_id}.i"
            l1 = "    {int_name} = call i64 @orion_list_at(ptr {la_src}, i64 {value_ref(inst.lhs)})"
            l2 = "    {value_ref(my_id)} = inttoptr i64 {int_name} to ptr"
            result = "{la_pre}{l1}\n{l2}"
        else:
            if elem_ll is "double":
                di_name = "%v{my_id}.di"
                l1 = "    {di_name} = call i64 @orion_list_at(ptr {la_src}, i64 {value_ref(inst.lhs)})"
                l2 = "    {value_ref(my_id)} = bitcast i64 {di_name} to double"
                result = "{la_pre}{l1}\n{l2}"
            else:
                result = "{la_pre}    {value_ref(my_id)} = call i64 @orion_list_at(ptr {la_src}, i64 {value_ref(inst.lhs)})"

    if op is "list_len":
        ll_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if ll_ll is "i64":
            llp = "%v{my_id}.m"
            result = "    {llp} = inttoptr i64 {value_ref(inst.value)} to ptr\n    {value_ref(my_id)} = call i64 @orion_list_len(ptr {llp})"
        else:
            result = "    {value_ref(my_id)} = call i64 @orion_list_len(ptr {value_ref(inst.value)})"

    if op is "fmath1":
        result = "    {value_ref(my_id)} = call double @{inst.name}(double {value_ref(inst.value)})"

    if op is "fmath2":
        result = "    {value_ref(my_id)} = call double @{inst.name}(double {value_ref(inst.value)}, double {value_ref(inst.lhs)})"

    if op is "list_slice":
        ls_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if ls_ll is "i64":
            lsp = "%v{my_id}.m"
            result = "    {lsp} = inttoptr i64 {value_ref(inst.value)} to ptr\n    {value_ref(my_id)} = call ptr @orion_list_slice(ptr {lsp}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
        else:
            result = "    {value_ref(my_id)} = call ptr @orion_list_slice(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"

    if op is "list_push":
        val_inst = fn_value.instructions[inst.lhs]
        val_ty = llvm_type_of(val_inst.type_text)
        if val_ty is "ptr":
            tmp = "%v{my_id}.p"
            l1 = "    {tmp} = ptrtoint ptr {value_ref(inst.lhs)} to i64"
            l2 = "    {value_ref(my_id)} = call ptr @orion_list_push(ptr {value_ref(inst.value)}, i64 {tmp})"
            result = "{l1}\n{l2}"
        else:
            if val_ty is "double":
                tmp = "%v{my_id}.pf"
                l1 = "    {tmp} = bitcast double {value_ref(inst.lhs)} to i64"
                l2 = "    {value_ref(my_id)} = call ptr @orion_list_push(ptr {value_ref(inst.value)}, i64 {tmp})"
                result = "{l1}\n{l2}"
            else:
                result = "    {value_ref(my_id)} = call ptr @orion_list_push(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)})"

    if op is "list_push_mut":
        val_inst = fn_value.instructions[inst.lhs]
        val_ty = llvm_type_of(val_inst.type_text)
        if val_ty is "ptr":
            tmp = "%v{my_id}.p"
            l1 = "    {tmp} = ptrtoint ptr {value_ref(inst.lhs)} to i64"
            l2 = "    {value_ref(my_id)} = call ptr @orion_list_push_mut(ptr {value_ref(inst.value)}, i64 {tmp})"
            result = "{l1}\n{l2}"
        else:
            if val_ty is "double":
                tmp = "%v{my_id}.pf"
                l1 = "    {tmp} = bitcast double {value_ref(inst.lhs)} to i64"
                l2 = "    {value_ref(my_id)} = call ptr @orion_list_push_mut(ptr {value_ref(inst.value)}, i64 {tmp})"
                result = "{l1}\n{l2}"
            else:
                result = "    {value_ref(my_id)} = call ptr @orion_list_push_mut(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)})"

    # SIMD-style vector ops over int lists. Lowered to elementwise runtime
    # fns (orion_vec_add/sub/mul return ptr; orion_vec_dot returns i64).
    if op is "vec_add":
        result = "    {value_ref(my_id)} = call ptr @orion_vec_add(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"
    if op is "vec_addi":
        result = "    {value_ref(my_id)} = call ptr @orion_vec_addi(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"
    if op is "vec_madd":
        result = "    {value_ref(my_id)} = call ptr @orion_vec_madd(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
    if op is "par_madd":
        result = "    {value_ref(my_id)} = call ptr @orion_par_madd(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
    if op is "vec_sub":
        result = "    {value_ref(my_id)} = call ptr @orion_vec_sub(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"
    if op is "vec_mul":
        result = "    {value_ref(my_id)} = call ptr @orion_vec_mul(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"
    if op is "vec_dot":
        result = "    {value_ref(my_id)} = call i64 @orion_vec_dot(ptr {value_ref(inst.value)}, ptr {value_ref(inst.lhs)})"
    if op is "time_now_ms":
        result = "    {value_ref(my_id)} = call i64 @__orion_time_now_ms()"
    if op is "monotonic_ms":
        result = "    {value_ref(my_id)} = call i64 @__orion_monotonic_ms()"
    if op is "sleep_ms":
        l1 = "    call void @__orion_sleep_ms(i64 {value_ref(inst.value)})"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l1}\n{l2}"

    if op is "map_lit":
        # args alternates key/val: [k0, v0, k1, v1, ...]
        n_total = length(inst.args)
        n_pairs = n_total // 2
        edit text = "    {value_ref(my_id)} = call ptr @orion_map_new(i64 {n_pairs})"
        loop pi in 0 until n_pairs:
            key_id = inst.args[pi * 2]
            val_id = inst.args[pi * 2 + 1]
            val_inst = fn_value.instructions[val_id]
            val_ty = llvm_type_of(val_inst.type_text)
            # Map slots are i64. A pointer is ptrtoint'd, a double stores
            # its BITS - the same deal a list slot makes, and `map_get` bitcasts
            # back. Without it `{"a": 1.5}` handed clang an f64 where the call
            # wanted an i64, and the error was clang's, about a line nobody wrote.
            if val_ty is "ptr":
                tmp = "%v{my_id}.p{pi}"
                text = "{text}\n    {tmp} = ptrtoint ptr {value_ref(val_id)} to i64"
                text = "{text}\n    call void @orion_map_set(ptr {value_ref(my_id)}, ptr {value_ref(key_id)}, i64 {tmp})"
            else if val_ty is "double":
                dtmp = "%v{my_id}.d{pi}"
                text = "{text}\n    {dtmp} = bitcast double {value_ref(val_id)} to i64"
                text = "{text}\n    call void @orion_map_set(ptr {value_ref(my_id)}, ptr {value_ref(key_id)}, i64 {dtmp})"
            else:
                text = "{text}\n    call void @orion_map_set(ptr {value_ref(my_id)}, ptr {value_ref(key_id)}, i64 {value_ref(val_id)})"
        result = text

    if op is "map_set_val":
        # value is map_id, lhs is key_id, rhs is val_id. Mutate, then
        # re-yield the map pointer as this inst's SSA value. Key shape
        # picks the runtime family (i64 → _ik value compare).
        msv_key = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        msv_fam = if msv_key is "i64" then "orion_map_set_ik" else "orion_map_set"
        msv_kty = if msv_key is "i64" then "i64" else "ptr"
        msv_val_inst = fn_value.instructions[inst.rhs]
        msv_val_ty = llvm_type_of(msv_val_inst.type_text)
        if msv_val_ty is "ptr":
            tmp = "%v{my_id}.p"
            l1 = "    {tmp} = ptrtoint ptr {value_ref(inst.rhs)} to i64"
            l2 = "    call void @{msv_fam}(ptr {value_ref(inst.value)}, {msv_kty} {value_ref(inst.lhs)}, i64 {tmp})"
            l3 = "    {value_ref(my_id)} = getelementptr i8, ptr {value_ref(inst.value)}, i64 0"
            result = "{l1}\n{l2}\n{l3}"
        else:
            l1 = "    call void @{msv_fam}(ptr {value_ref(inst.value)}, {msv_kty} {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
            l2 = "    {value_ref(my_id)} = getelementptr i8, ptr {value_ref(inst.value)}, i64 0"
            result = "{l1}\n{l2}"

    if op is "map_remove":
        # value is map_id, lhs is key_id. In-place swap-remove; the map
        # pointer re-yields as this inst's SSA value.
        mr_key = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        mr_fam = if mr_key is "i64" then "orion_map_remove_ik" else "orion_map_remove"
        mr_kty = if mr_key is "i64" then "i64" else "ptr"
        l1 = "    call void @{mr_fam}(ptr {value_ref(inst.value)}, {mr_kty} {value_ref(inst.lhs)})"
        l2 = "    {value_ref(my_id)} = getelementptr i8, ptr {value_ref(inst.value)}, i64 0"
        result = "{l1}\n{l2}"

    if op is "list_set_val":
        lsv_val_inst = fn_value.instructions[inst.rhs]
        lsv_val_ty = llvm_type_of(lsv_val_inst.type_text)
        if lsv_val_ty is "ptr":
            tmp = "%v{my_id}.p"
            l1 = "    {tmp} = ptrtoint ptr {value_ref(inst.rhs)} to i64"
            l2 = "    call void @orion_list_set(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}, i64 {tmp})"
            l3 = "    {value_ref(my_id)} = getelementptr i8, ptr {value_ref(inst.value)}, i64 0"
            result = "{l1}\n{l2}\n{l3}"
        else:
            if lsv_val_ty is "double":
                tmp = "%v{my_id}.sf"
                l1 = "    {tmp} = bitcast double {value_ref(inst.rhs)} to i64"
                l2 = "    call void @orion_list_set(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}, i64 {tmp})"
                l3 = "    {value_ref(my_id)} = getelementptr i8, ptr {value_ref(inst.value)}, i64 0"
                result = "{l1}\n{l2}\n{l3}"
            else:
                l1 = "    call void @orion_list_set(ptr {value_ref(inst.value)}, i64 {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"
                l2 = "    {value_ref(my_id)} = getelementptr i8, ptr {value_ref(inst.value)}, i64 0"
                result = "{l1}\n{l2}"

    if op is "map_len":
        ml_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if ml_ll is "i64":
            mlp = "%v{my_id}.m"
            result = "    {mlp} = inttoptr i64 {value_ref(inst.value)} to ptr\n    {value_ref(my_id)} = call i64 @orion_map_len(ptr {mlp})"
        else:
            result = "    {value_ref(my_id)} = call i64 @orion_map_len(ptr {value_ref(inst.value)})"

    if op is "map_keys":
        mk_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if mk_ll is "i64":
            mkp = "%v{my_id}.m"
            result = "    {mkp} = inttoptr i64 {value_ref(inst.value)} to ptr\n    {value_ref(my_id)} = call ptr @orion_map_keys(ptr {mkp})"
        else:
            result = "    {value_ref(my_id)} = call ptr @orion_map_keys(ptr {value_ref(inst.value)})"

    if op is "map_values":
        mv_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
        if mv_ll is "i64":
            mvp = "%v{my_id}.m"
            result = "    {mvp} = inttoptr i64 {value_ref(inst.value)} to ptr\n    {value_ref(my_id)} = call ptr @orion_map_values(ptr {mvp})"
        else:
            result = "    {value_ref(my_id)} = call ptr @orion_map_values(ptr {value_ref(inst.value)})"

    if op is "map_get_or":
        # Key's LLVM shape picks the runtime family: i64 keys → _ik
        # (value compare), ptr keys → strcmp. Default's shape decides
        # the result cast.
        mgo_key = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        mgo_fam = if mgo_key is "i64" then "orion_map_get_or_ik" else "orion_map_get_or"
        mgo_kty = if mgo_key is "i64" then "i64" else "ptr"
        mgo_ty = llvm_type_of(inst.type_text)
        if mgo_ty is "ptr":
            dtmp = "%v{my_id}.d"
            rtmp = "%v{my_id}.r"
            l1 = "    {dtmp} = ptrtoint ptr {value_ref(inst.rhs)} to i64"
            l2 = "    {rtmp} = call i64 @{mgo_fam}(ptr {value_ref(inst.value)}, {mgo_kty} {value_ref(inst.lhs)}, i64 {dtmp})"
            l3 = "    {value_ref(my_id)} = inttoptr i64 {rtmp} to ptr"
            result = "{l1}\n{l2}\n{l3}"
        else:
            result = "    {value_ref(my_id)} = call i64 @{mgo_fam}(ptr {value_ref(inst.value)}, {mgo_kty} {value_ref(inst.lhs)}, i64 {value_ref(inst.rhs)})"

    if op is "f64_to_text":
        result = "    {value_ref(my_id)} = call ptr @orion_f64_to_text(double {value_ref(inst.value)})"

    if op is "map_get":
        # map_get returns i64. The caller decides via type_text whether to
        # cast back to ptr (for text/list/map) or keep as i64. Key shape
        # picks the runtime family (i64 → _ik value compare).
        mg_key = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        mg_fam = if mg_key is "i64" then "orion_map_get_ik" else "orion_map_get"
        mg_kty = if mg_key is "i64" then "i64" else "ptr"
        ty = llvm_type_of(inst.type_text)
        if ty is "ptr":
            # A MISSING key reads back as 0, and turning that into a pointer
            # handed the program a null: `length(get_list(m, "nope"))` crashed with
            # an access violation at address 0x8 instead of answering 0. Both
            # empty singletons already exist in the module, so substitute the one
            # this read's type calls for. Two instructions, no runtime change.
            int_name = "%v{my_id}.i"
            null_name = "%v{my_id}.isnull"
            raw_name = "%v{my_id}.raw"
            mg_empty = if inst.type_text is "text" then "getelementptr(i8, ptr @.str_empty_h, i64 16)" else "@orion_empty_list"
            l1 = "    {int_name} = call i64 @{mg_fam}(ptr {value_ref(inst.value)}, {mg_kty} {value_ref(inst.lhs)})"
            l2 = "    {raw_name} = inttoptr i64 {int_name} to ptr"
            l3 = "    {null_name} = icmp eq i64 {int_name}, 0"
            l4 = "    {value_ref(my_id)} = select i1 {null_name}, ptr {mg_empty}, ptr {raw_name}"
            result = "{l1}\n{l2}\n{l3}\n{l4}"
        else if ty is "double":
            mgd = "%v{my_id}.di"
            m1 = "    {mgd} = call i64 @{mg_fam}(ptr {value_ref(inst.value)}, {mg_kty} {value_ref(inst.lhs)})"
            result = "{m1}\n    {value_ref(my_id)} = bitcast i64 {mgd} to double"
        else:
            result = "    {value_ref(my_id)} = call i64 @{mg_fam}(ptr {value_ref(inst.value)}, {mg_kty} {value_ref(inst.lhs)})"

    if op is "map_has":
        mh_key = llvm_type_of(ssa_value_type(inst.lhs, fn_value, module))
        mh_fam = if mh_key is "i64" then "orion_map_has_ik" else "orion_map_has"
        mh_kty = if mh_key is "i64" then "i64" else "ptr"
        result = "    {value_ref(my_id)} = call i64 @{mh_fam}(ptr {value_ref(inst.value)}, {mh_kty} {value_ref(inst.lhs)})"

    if op is "struct_cons":
        n_fields = inst.value
        bytes_needed = n_fields * 8
        edit text2 = "    {value_ref(my_id)} = call ptr @orion_alloc(i64 {bytes_needed})"
        loop fi in 0 until n_fields:
            val_id = inst.args[fi]
            val_inst = fn_value.instructions[val_id]
            val_ty = llvm_type_of(val_inst.type_text)
            slot_name = "%v{my_id}.f{fi}"
            text2 = "{text2}\n    {slot_name} = getelementptr i64, ptr {value_ref(my_id)}, i64 {fi}"
            if val_ty is "ptr":
                int_name = "%v{my_id}.f{fi}.i"
                text2 = "{text2}\n    {int_name} = ptrtoint ptr {value_ref(val_id)} to i64"
                text2 = "{text2}\n    store i64 {int_name}, ptr {slot_name}"
            else:
                if val_ty is "double":
                    bits_name = "%v{my_id}.f{fi}.b"
                    text2 = "{text2}\n    {bits_name} = bitcast double {value_ref(val_id)} to i64"
                    text2 = "{text2}\n    store i64 {bits_name}, ptr {slot_name}"
                else:
                    text2 = "{text2}\n    store i64 {value_ref(val_id)}, ptr {slot_name}"
        result = text2

    if op is "field_load":
        ty = llvm_type_of(inst.type_text)
        slot_name = "%v{my_id}.slot"
        l1 = "    {slot_name} = getelementptr i64, ptr {value_ref(inst.value)}, i64 {inst.lhs}"
        if ty is "double":
            fl_bits = "%v{my_id}.b"
            l2d = "    {fl_bits} = load i64, ptr {slot_name}"
            l3d = "    {value_ref(my_id)} = bitcast i64 {fl_bits} to double"
            result = "{l1}\n{l2d}\n{l3d}"
        if ty is "ptr":
            int_name = "%v{my_id}.i"
            l2 = "    {int_name} = load i64, ptr {slot_name}"
            l3 = "    {value_ref(my_id)} = inttoptr i64 {int_name} to ptr"
            result = "{l1}\n{l2}\n{l3}"
        if ty is "i64":
            l2 = "    {value_ref(my_id)} = load i64, ptr {slot_name}"
            result = "{l1}\n{l2}"

    if op is "alloca":
        ty = llvm_type_of(inst.type_text)
        result = "    {value_ref(my_id)} = alloca {ty}, align 8"

    if op is "load":
        ty = llvm_type_of(inst.type_text)
        result = "    {value_ref(my_id)} = load {ty}, ptr {value_ref(inst.value)}"

    if op is "store":
        # Stored value's type comes from its defining inst.
        val_inst = fn_value.instructions[inst.lhs]
        ty = llvm_type_of(val_inst.type_text)
        l1 = "    store {ty} {value_ref(inst.lhs)}, ptr {value_ref(inst.value)}"
        l2 = "    {value_ref(my_id)} = add i64 0, 0"
        result = "{l1}\n{l2}"

    if op is "return":
        ret_ty = llvm_type_of(fn_value.return_type)
        if inst.value < 0:
            if ret_ty is "ptr":
                result = "    ret ptr null"
            else:
                result = "    ret i64 0"
        else:
            # Bit-preserving coercion when the value's shape disagrees
            # with the declared return type (untyped map reads flowing
            # out of int-returning fns and vice versa).
            val_ll = llvm_type_of(ssa_value_type(inst.value, fn_value, module))
            if ret_ty is "i64" and val_ll is "ptr":
                rc = "%v{my_id}.rc"
                l1 = "    {rc} = ptrtoint ptr {value_ref(inst.value)} to i64"
                l2 = "    ret i64 {rc}"
                result = "{l1}\n{l2}"
            else:
                if ret_ty is "ptr" and val_ll is "i64":
                    rc = "%v{my_id}.rc"
                    l1 = "    {rc} = inttoptr i64 {value_ref(inst.value)} to ptr"
                    l2 = "    ret ptr {rc}"
                    result = "{l1}\n{l2}"
                else:
                    result = "    ret {ret_ty} {value_ref(inst.value)}"

    # --trace: exit-hook fore VARJE ret - djupraknaren bakom stega
    # over/ut. Speglar trace_enter som ast_to_ir lagger i prologen.
    if op is "return" and slot_get_number("drv:trace") is 1:
        result = "    call i64 @orion_trace_exit()\n{result}"

    # An op no branch above handled would silently emit a placeholder
    # `add i64 0, 0` - valid LLVM, wrong program. If `result` still
    # equals the default sentinel, no branch matched: count it as a
    # compile error so drivers refuse to ship the module.
    if result is "    {value_ref(my_id)} = add i64 0, 0    ; UNSUPPORTED op={op}":
        compile_error("orion: ERROR - IR op `{op}` has no LLVM lowering (fn `{fn_value.name}`)")

    result


# --- Function and module ---

# ---- memfacts: what the compiler already knows about memory safety ----
#
# The slot-store boundary is where a region-born pointer either gets evacuated
# to the heap or aborts the program, and WHICH of the two is decided by a type
# code the emitter derives right here, statically. That makes the set of
# possible aborts a compile-time fact, not a runtime surprise - so record it.
#
# Kept in compiler slots rather than threaded through emit_module's signature:
# the recording site is deep inside per-instruction emission, and this is
# diagnostics, not semantics.
define memfact_count(kind: text):
    slot_set("emit:mf:" + kind, memfact_get(kind) + 1)

define memfact_get(kind: text) -> number:
    if slot_has("emit:mf:" + kind) then slot_get_number("emit:mf:" + kind) else 0

define memfact_note(fn_name: text, type_text: text):
    n = memfact_get("opaque")
    slot_set("emit:mf:opaque", n + 1)
    slot_set("emit:mfo:{n}", fn_name + "  (" + type_text + ")")

# ONE line, next to the timings, on every build. Anything longer would be
# noise on a compile that is fine, and noise is how a real warning gets missed.
public define memfacts_report():
    stores = memfact_get("stores")
    opaque = memfact_get("opaque")
    if stores is 0:
        return 0
    if opaque is 0:
        print_line("  memory: {stores} slot store(s), all evacuable")
    else:
        print_line("  memory: {stores} slot store(s), {opaque} with no copier (`orion <file> memfacts` to list)")
    0

# The sites themselves, on request: `orion <file> memfacts`.
public define memfacts_list() -> number:
    stores = memfact_get("stores")
    opaque = memfact_get("opaque")
    print_line("")
    print_line("  slot-store boundary: {stores} pointer store(s), {opaque} with no copier")
    print_line("")
    if opaque is 0:
        print_line("  Every pointer stored in a slot has a deep copier, so a region-born")
        print_line("  value is evacuated to the heap rather than left to dangle.")
    else:
        print_line("  These shapes have no copier at the boundary. If the value is born in")
        print_line("  the arena, frame or a pool region, the store cannot be evacuated and")
        print_line("  the runtime aborts. Each one is therefore either wrapped in a persist")
        print_line("  scope by hand, or a latent abort - and the compiler cannot tell which.")
        print_line("")
        loop i in 0 until opaque:
            print_line("    " + slot_get("emit:mfo:{i}"))
    print_line("")
    0

# Evacuation type code for the slot-store boundary - what
# orion_slot_evac needs to deep-copy a region-born value. 0 = no
# copier (opaque struct/fn/ptr): in-region still fails fast.
define evac_code(orion_type: text) -> number:
    if orion_type is "text":
        1
    else if orion_type is "list" or orion_type is "list:i64" or orion_type is "list:f64":
        2
    else if orion_type is "list:text":
        3
    else if orion_type is "map" or orion_type is "map:i64" or orion_type is "map:text" or orion_type is "map:map":
        4
    else if orion_type is "list:map":
        5
    else:
        0

define llvm_type_of(orion_type: text) -> text:
    edit is_struct = false
    edit is_list_elem = false
    bs = bytes_of(orion_type)
    if length(bs) >= 7:
        if bs[0] is 115 and bs[1] is 116 and bs[2] is 114 and bs[3] is 117 and bs[4] is 99 and bs[5] is 116 and bs[6] is 58:
            is_struct = true
    # `list:T` (parameterised list) - also a ptr at LLVM level.
    if length(bs) >= 5:
        if bs[0] is 108 and bs[1] is 105 and bs[2] is 115 and bs[3] is 116 and bs[4] is 58:
            is_list_elem = true
    # `map:T` (value-typed map) - a map handle, also a ptr.
    edit is_map_elem = false
    if length(bs) >= 4:
        if bs[0] is 109 and bs[1] is 97 and bs[2] is 112 and bs[3] is 58:
            is_map_elem = true
    if orion_type is "f64":
        "double"
    else:
        if orion_type is "text" or orion_type is "list" or orion_type is "map" or orion_type is "dyn" or orion_type is "ptr" or orion_type is "fn" or is_struct or is_list_elem or is_map_elem then "ptr" else "i64"


# Given a "list:T" encoding, return T (or "i64" as fallback).
define list_elem_type(list_type: text) -> text:
    bs = bytes_of(list_type)
    n = length(bs)
    edit is_listed = false
    if n >= 5:
        if bs[0] is 108 and bs[1] is 105 and bs[2] is 115 and bs[3] is 116 and bs[4] is 58:
            is_listed = true
    if not is_listed:
        "i64"
    else:
        # Extract bytes 5..n
        edit result = ""
        loop index in 5 until n:
            single = text_of([bs[index]])
            result = "{result}{single}"
        result


define emit_param_list(params: [Param]) -> text:
    n = length(params)
    edit result = ""
    loop index in 0 until n:
        sep = if index is 0 then "" else ", "
        ty = llvm_type_of(params[index].type_text)
        result = "{result}{sep}{ty} %p{index}"
    result

# Types only (no %pN names) - for `declare` lines.
define emit_param_types(params: [Param]) -> text:
    n = length(params)
    edit result = ""
    loop index in 0 until n:
        sep = if index is 0 then "" else ", "
        ty = llvm_type_of(params[index].type_text)
        result = "{result}{sep}{ty}"
    result


public define emit_fn(fn_value: IRFn, strings: [text], module: IRModule) -> text:
    name = fn_value.name
    # Skip compile-time aliases: their callers are dispatched straight to the
    # typed runtime helpers.
    is_alias = name is "get_int" or name is "get_map" or name is "get_list"
    if is_alias:
        ""
    else:
        ret_type = llvm_type_of(fn_value.return_type)
        param_list = emit_param_list(fn_value.params)
        is_user_main = name is "main"
        emit_name = if is_user_main then "orion_main" else name
        # Chunk list + single join, NOT repeated `"{text}{line}"` concat -
        # concat re-copies the whole accumulated text per line, O(n²)
        # over a multi-thousand-instruction function body.
        edit chunks = []
        chunks = append(chunks, "define {ret_type} @{emit_name}({param_list}) \{\nentry:\n")
        total = length(fn_value.instructions)
        # HOIST allocas to the entry block. `alloca` reserves a stack slot for
        # the whole function ONLY when it sits in the entry block - LLVM reuses
        # that slot across the function. An alloca left inside a loop body
        # (which is where a `mut` declared in the loop lands) executes every
        # iteration and reserves a FRESH slot each time, so a loop over a few
        # million items overran the stack and crashed with no diagnostic. The
        # SSA name is the instruction index, unchanged by emit order, so moving
        # the emission is sound: emit every alloca first (entry block), then the
        # rest in order.
        loop hi in 0 until total:
            h_inst = fn_value.instructions[hi]
            if h_inst.op is "alloca":
                chunks = append(chunks, emit_instruction(h_inst, hi, strings, fn_value, module))
                chunks = append(chunks, "\n")
        loop index in 0 until total:
            inst = fn_value.instructions[index]
            if inst.op is not "alloca":
                line = emit_instruction(inst, index, strings, fn_value, module)
                chunks = append(chunks, line)
                chunks = append(chunks, "\n")
        chunks = append(chunks, "\}\n")
        orion_text_join(chunks)


# Emit the global for a single string literal, H1-headered:
# [hash:i64 LE][len:i64 LE][bytes][NUL], align 8 - references GEP
# +16 to the bytes. Hash is BAKED (rodata cannot lazy-write):
# polynomial base 131 seed 5381 mod 1e9+7, identical to the
# runtime's orion_text_hash, remapped 0 -> 1.
define emit_string_global(text_value: text, idx: number) -> text:
    bs = bytes_of(text_value)
    blen = length(bs)
    n = blen + 17
    escaped = llvm_escape(text_value)
    h = bake_hash(bs)
    header = i64_le_escapes(h) + i64_le_escapes(blen)
    "@.str_{idx} = private unnamed_addr constant [{n} x i8] c\"{header}{escaped}\\00\", align 8"

define bake_hash(bs: [number]) -> number:
    n = length(bs)
    edit h = 5381
    loop i in 0 until n:
        h = (h * 131 + bs[i]) - ((h * 131 + bs[i]) // 1000000007) * 1000000007
    if h is 0 then 1 else h

define i64_le_escapes(v: number) -> text:
    edit out = ""
    edit x = v
    loop i in 0 until 8:
        b = x - (x // 256) * 256
        out = out + "\\" + hex2(b)
        x = x // 256
    out

define hex2(b: number) -> text:
    hi = b // 16
    lo = b - hi * 16
    hex1(hi) + hex1(lo)

define hex1(d: number) -> text:
    if d is 0 then "0" else if d is 1 then "1" else if d is 2 then "2" else if d is 3 then "3" else if d is 4 then "4" else if d is 5 then "5" else if d is 6 then "6" else if d is 7 then "7" else if d is 8 then "8" else if d is 9 then "9" else if d is 10 then "A" else if d is 11 then "B" else if d is 12 then "C" else if d is 13 then "D" else if d is 14 then "E" else "F"


# Runtime helpers in LLVM IR. Defined alongside user code so we can
# stay clang-only without a separate runtime .c file.
define emit_runtime() -> text:
    edit text = ""
    # Target Windows x64 MSVC explicitly - needed for setjmp/longjmp ABI
    # to match the linker's MSVCRT. Without this the IR is target-agnostic
    # and _setjmp expands incorrectly.
    text = "{text}target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n"
    text = "{text}target triple = \"x86_64-pc-windows-msvc19.44.35209\"\n"
    text = "{text}declare i32 @printf(ptr, ...)\n"
    text = "{text}declare i32 @puts(ptr)\n"
    text = "{text}declare ptr @malloc(i64)\n"
    # Float-literal hex conversion lives in orion_rt.c (strtod) - declare
    # here since the orion_ prefix skips the auto-extern-declare path.
    text = "{text}declare ptr @orion_f64_literal_hex(ptr)\n"
    # to_whole/to_real on a text route to these C parsers (orion_ prefix
    # skips the auto-extern path, so declare here).
    text = "{text}declare i64 @orion_text_to_int(ptr)\n"
    text = "{text}declare double @orion_text_to_f64(ptr)\n"
    # Parallel closure runner (orion_rt.c): run each closure(arg) on a worker,
    # sum the results. orion_ prefix skips the auto-extern path, so declare here.
    text = "{text}declare i64 @orion_par_run(ptr, i64)\n"
    # Debugger v1 (orion_ prefix skips the auto-extern path, so declare here):
    # --trace fn-entry hook, the trap-time trail dump, and breakpoint().
    text = "{text}declare i64 @orion_trace_enter(ptr)\n"
    text = "{text}declare i64 @orion_line(ptr)\n"
    text = "{text}declare i64 @orion_dbg_i(ptr, i64)\n"
    text = "{text}declare i64 @orion_trace_exit()\n"
    text = "{text}declare i64 @orion_slot_watch(ptr)\n"
    text = "{text}declare i64 @orion_dbg_t(ptr, ptr)\n"
    text = "{text}declare i64 @orion_trail_note_trap()\n"
    text = "{text}declare i64 @orion_breakpoint(ptr)\n"
