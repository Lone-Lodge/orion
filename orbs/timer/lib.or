# timer - deterministic tick-based timers.
#
# The systems-level counterpart to astra's `every`. You feed dt_ms per frame
# (the tick delta) and the timer advances - no wall clock, no sleep, no RNG.
# Same inputs replay to the same outputs, so it is safe inside the deterministic
# engine core (unlike the `scheduler` orb, which is real-time and blocking).
#
# Two shapes:
#   - countdown  : timer_start -> timer_tick -> completes once (timer_done)
#   - cadence    : timer_every fires N times per period, forever (astra `every`)
#
# State lives in global slots under "timer:{id}:..." so a timer is just a name.

fn ts_int(key: Text) -> int:
    if slot_has(key) then slot_get_int(key) else 0

# --- countdown -------------------------------------------------------------

# Start (or restart) a timer running toward dur_ms.
pub fn timer_start(id: Text, dur_ms: int):
    slot_set("timer:{id}:dur", dur_ms)
    slot_set("timer:{id}:el", 0)
    slot_set("timer:{id}:on", 1)
    slot_set("timer:{id}:acc", 0)

# Cancel a running timer (elapsed is kept for inspection).
pub fn timer_stop(id: Text):
    slot_set("timer:{id}:on", 0)

# Rewind to 0 and keep running toward the same duration.
pub fn timer_reset(id: Text):
    slot_set("timer:{id}:el", 0)
    slot_set("timer:{id}:on", 1)

# Advance by dt_ms. Returns 1 on the single tick it completes, else 0.
# A completed or stopped timer is inert (returns 0).
pub fn timer_tick(id: Text, dt_ms: int) -> int:
    onkey = "timer:{id}:on"
    if ts_int(onkey) == 0:
        return 0
    elkey = "timer:{id}:el"
    dur = ts_int("timer:{id}:dur")
    el = ts_int(elkey) + dt_ms
    slot_set(elkey, el)
    if dur > 0 and el >= dur:
        slot_set(onkey, 0)
        return 1
    0

pub fn timer_elapsed(id: Text) -> int:
    ts_int("timer:{id}:el")

pub fn timer_remaining(id: Text) -> int:
    r = ts_int("timer:{id}:dur") - ts_int("timer:{id}:el")
    if r > 0 then r else 0

# Progress as permille (0..1000), clamped. A zero-duration timer reads 1000.
pub fn timer_progress(id: Text) -> int:
    dur = ts_int("timer:{id}:dur")
    if dur <= 0:
        return 1000
    p = ts_int("timer:{id}:el") * 1000 / dur
    if p > 1000 then 1000 else p

# 1 once elapsed has reached the duration.
pub fn timer_done(id: Text) -> int:
    dur = ts_int("timer:{id}:dur")
    if dur > 0 and ts_int("timer:{id}:el") >= dur then 1 else 0

# 1 while the timer is running (started, not yet completed or stopped).
pub fn timer_active(id: Text) -> int:
    ts_int("timer:{id}:on")

# --- cadence (astra `every`) ----------------------------------------------

# Accumulate dt_ms and report how many whole periods elapsed this tick.
# Usually 0 or 1; larger dt (or a long period) can fire several. The leftover
# is carried, so cadence never drifts. Independent of timer_start/tick above.
pub fn timer_every(id: Text, period_ms: int, dt_ms: int) -> int:
    if period_ms <= 0:
        return 0
    acckey = "timer:{id}:acc"
    mut acc = ts_int(acckey) + dt_ms
    mut count = 0
    for:
        if acc < period_ms:
            break
        acc = acc - period_ms
        count = count + 1
    slot_set(acckey, acc)
    count
