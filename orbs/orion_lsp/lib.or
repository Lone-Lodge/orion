# orion_lsp - a Language Server for Orion, written in Orion.
#
# Diagnostics come from THE COMPILER, never from a second model of the grammar:
# a server with its own idea of the language drifts, and an editor confidently
# underlining correct code is worse than none. It also serves symbols,
# go-to-definition, hover and declaration-based completion.
#
# TRAP: framing is Content-Length over stdin/stdout, so stdout is RESERVED for
# protocol traffic - logging goes to stderr. See README.md.

external define orion_stdin_line() -> text
external define orion_stdin_read(n: int) -> text
external define orion_stdout_write(s: text) -> int
external define orion_stderr_line(s: text) -> int
external define orion_persist_text(s: text) -> text
external define orion_dir_subdirs(dir: text) -> text

# ---- transport ----

# One message, or "" at EOF. `orion_stdin_line` returns "\n" for a blank line
# and "" only at end of stream, which is what lets the header block end.
define lsp_read_message() -> text:
    edit content_len = 0
    edit eof = false
    loop:
        line = orion_stdin_line()
        if line is "":
            eof = true
            break
        if line is "\n":
            break
        if starts_with(line, "Content-Length:"):
            rest = trim(slice_from(line, 15))
            content_len = parse(rest)
    if eof or content_len <= 0:
        ""
    else:
        orion_stdin_read(content_len)

# Byteplatsen for kodpunkt nr cp i t. index_of/length raknar KODPUNKTER;
# bytes_part skar BYTES - den har ar bron, sa de aldrig blandas rakt av.
define cp_byte(t: text, cp: number) -> number:
    b = bytes_of(t)
    n = bytes_count(b)
    edit i = 0
    edit left = cp
    loop:
        if left <= 0 or i >= n:
            break
        i = i + (if b[i] >= 240 then 4 else if b[i] >= 224 then 3 else if b[i] >= 192 then 2 else 1)
        left = left - 1
    i

# from ar ett KODPUNKTS-tal (fran index_of/length) - skarningen sker i bytes.
define slice_from(t: text, from: number) -> text:
    b = bytes_of(t)
    n = bytes_count(b)
    i = cp_byte(t, from)
    if i >= n:
        ""
    else:
        text_of(bytes_part(b, i, n))

define lsp_send(body: text) -> number:
    n = length(body)
    orion_stdout_write("Content-Length: {n}\r\n\r\n{body}")

define lsp_respond(id: number, result_json: text) -> number:
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":{result_json}\}")

define lsp_notify(method: text, params_json: text) -> number:
    lsp_send("\{\"jsonrpc\":\"2.0\",\"method\":\"{method}\",\"params\":{params_json}\}")

# ---- uri <-> path ----

define hexv(c: number) -> number:
    if c >= 48 and c <= 57:
        c - 48
    else:
        if c >= 97 and c <= 102:
            c - 87
        else:
            if c >= 65 and c <= 70:
                c - 55
            else:
                0

# `file:///c%3A/x/y.or` -> `c:/x/y.or`. Percent-decoding matters on Windows:
# the drive colon always arrives as %3A.
public define uri_to_path(uri: text) -> text:
    # Strip the scheme only. The leading `/` STAYS unless what follows is a
    # Windows drive (`/c:/…`): dropping it unconditionally turned every POSIX
    # absolute path into a relative one, and the server then wrote its check
    # file somewhere that did not exist and reported no diagnostics at all.
    after_scheme = if starts_with(uri, "file://") then slice_from(uri, 7) else uri
    ab = bytes_of(after_scheme)
    drive_form = length(ab) >= 3 and ab[0] is 47 and (ab[2] is 58 or (length(ab) >= 5 and ab[2] is 37))
    stripped = if drive_form then slice_from(after_scheme, 1) else after_scheme
    b = bytes_of(stripped)
    n = length(b)
    edit out = part([0], 0, 0)
    edit i = 0
    loop:
        if i >= n:
            break
        c = b[i]
        if c is 37 and i + 2 < n:
            out = append(out, hexv(b[i + 1]) * 16 + hexv(b[i + 2]))
            i = i + 3
        else:
            out = append(out, c)
            i = i + 1
    text_of(out)

define dirname_of(path: text) -> text:
    b = bytes_of(path)
    n = length(b)
    edit cut = 0 - 1
    loop i in 0 until n:
        c = b[i]
        if c is 47 or c is 92:
            cut = i
    if cut < 0:
        "."
    else:
        text_of(bytes_part(b, 0, cut))

# ---- document store ----
# Slots are the process-global store the compiler itself uses. Text handed to
# one has to outlive the message it arrived in, hence orion_persist_text.

define doc_set(uri: text, body: text):
    slot_set("lsp:doc:" + uri, orion_persist_text(body))

define doc_get(uri: text) -> text:
    if slot_has("lsp:doc:" + uri) then slot_get("lsp:doc:" + uri) else ""

# ---- diagnostics ----
#
# The compiler is the authority. Write the in-editor buffer to a sibling file
# (so relative `use` roots still resolve), compile it, and translate its own
# `path:line:col - message` output. Nothing here re-implements a grammar.

define lsp_compiler() -> text:
    if slot_has("lsp:orion") then slot_get("lsp:orion") else "orion.exe"

define lsp_orbs() -> text:
    if slot_has("lsp:orbs") then slot_get("lsp:orbs") else ""

# The configured orb roots - ";"-separated so paths may hold spaces.
# Every lookup (diagnostics, definitions, completion) walks them all:
# one root sees only the stdlib and calls the project's own orbs
# unknown, which painted false errors over green builds.
define lsp_orb_roots() -> list of text:
    edit roots = []
    loop root in split(lsp_orbs(), ";"):
        if root is not "":
            roots = push(roots, root)
    roots

define diag_json_of(line_no: number, col: number, msg: text) -> text:
    zero_line = if line_no > 0 then line_no - 1 else 0
    "\{\"range\":\{\"start\":\{\"line\":{zero_line},\"character\":{col}\},\"end\":\{\"line\":{zero_line},\"character\":{col + 1}\}\},\"severity\":1,\"source\":\"orion\",\"message\":\"{json_escape(msg)}\"\}"

# `orion: ERROR at C:/x/y.or:12:8 - message` -> the pieces. Returns line 0 when
# the diagnostic is not for `want_file` (an error inside an orb belongs to that
# orb's file, not to the document being edited).
define diag_parse(raw: text, want_file: text) -> table:
    marker = " ERROR at "
    mi = index_of(raw, marker)
    if mi < 0:
        {"line": 0, "col": 0, "msg": ""}
    else:
        after = slice_from(raw, mi + 10)
        sep = index_of(after, " - ")
        if sep < 0:
            {"line": 0, "col": 0, "msg": ""}
        else:
            loc = text_of(bytes_part(bytes_of(after), 0, cp_byte(after, sep)))
            msg = slice_from(after, sep + 3)
            parts = split(loc, ":")
            np = length(parts)
            if np < 2:
                {"line": 0, "col": 0, "msg": ""}
            else:
                # A Windows path carries its own colon (`C:/…`), so the LINE and
                # COLUMN are always the last two fields, never fields 1 and 2.
                col_txt = parts[np - 1]
                line_txt = parts[np - 2]
                file_txt = join(part(parts, 0, np - 2), ":")
                same = ends_with(file_txt, want_file)
                if same:
                    {"line": parse(line_txt), "col": parse(col_txt), "msg": msg}
                else:
                    {"line": 0, "col": 0, "msg": ""}

define lsp_publish(uri: text, diags: text):
    lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":\"{json_escape(uri)}\",\"diagnostics\":[{diags}]\}")

public define lsp_diagnose(uri: text):
    # A sketch is checked by the astra compiler, not this one - handing
    # it to orion would paint a screen of errors about a language the
    # file is not written in. Until the sketch checker is wired in here,
    # a sketch simply gets no diagnostics (the build still refuses).
    if is_astra(uri):
        lsp_publish(uri, "")
        return
    path = uri_to_path(uri)
    body = doc_get(uri)
    dir = dirname_of(path)
    check_name = ".orion-lsp-check.or"
    tmp = "{dir}/{check_name}"
    out_ll = "{dir}/.orion-lsp-check.ll"
    write_file(tmp, body)
    edit args = [tmp, out_ll]
    loop root in lsp_orb_roots():
        args = push(args, root)
    out = capture_stdout(lsp_compiler(), args)
    remove_file(tmp)
    remove_file(out_ll)
    rows = lines(out)
    edit diags = ""
    edit count = 0
    loop ri in 0 until length(rows):
        row = rows[ri]
        if index_of(row, " ERROR at ") >= 0:
            d = diag_parse(row, check_name)
            if get_int(d, "line") > 0:
                sep2 = if count is 0 then "" else ","
                diags = diags + sep2 + diag_json_of(get_int(d, "line"), get_int(d, "col"), get(d, "msg"))
                count = count + 1
    lsp_publish(uri, diags)

# ---- symbols ----
# LSP SymbolKind: Function 12, Struct 23, Enum 10, Constant 14, Interface 11.

define sym_of_line(row: text) -> table:
    t = trim(row)
    stripped = if starts_with(t, "pub ") then slice_from(t, 4) else t
    body = if starts_with(stripped, "public ") then slice_from(stripped, 7) else stripped
    edit kind = 0
    edit skip = 0
    if starts_with(body, "fn "):
        kind = 12
        skip = 3
    if starts_with(body, "define "):
        kind = 12
        skip = 7
    if starts_with(body, "type "):
        kind = 23
        skip = 5
    if starts_with(body, "effect "):
        kind = 11
        skip = 7
    if starts_with(body, "const "):
        kind = 14
        skip = 6
    if starts_with(body, "handle "):
        kind = 12
        skip = 7
    if kind is 0:
        {"name": "", "kind": 0}
    else:
        rest = slice_from(body, skip)
        edit name = ""
        rb = bytes_of(rest)
        edit i = 0
        loop:
            if i >= length(rb):
                break
            c = rb[i]
            ok = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c is 95 or c is 46
            if not ok:
                break
            i = i + 1
        name = text_of(bytes_part(rb, 0, i))
        {"name": name, "kind": kind}

# ---- astra ----
#
# A sketch declares things too, in its own words, and the words a
# designer reaches for are exactly the ones worth jumping to: a stat, a
# companion, an entity. Without this, `hunger` in `bar hunger` is just a
# word and you have to scroll to find out what it means.
#
# A sketch is ONE file, so there is nothing to search but the document.

public define is_astra(uri: text) -> truth:
    ends_with(uri, ".astra")

define first_word_after(row: text, skip: number) -> text:
    rest = slice_from(trim(row), skip)
    b = bytes_of(rest)
    edit i = 0
    loop:
        if i >= length(b):
            break
        c = b[i]
        if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c is 95:
            i = i + 1
        else:
            break
    text_of(bytes_part(b, 0, i))

define astra_sym_of_line(row: text) -> table:
    t = trim(row)
    if starts_with(t, "stat "):
        # `stat hunger 3 of 10` - LSP Field.
        {"name": first_word_after(t, 5), "kind": 8}
    else if starts_with(t, "companion "):
        {"name": first_word_after(t, 10), "kind": 23}
    else if starts_with(t, "game "):
        {"name": first_word_after(t, 5), "kind": 2}
    else if t is "view:":
        # A section header, not a name.
        {"name": "", "kind": 0}
    else if ends_with(t, ":") and not contains(t, " ") and not starts_with(t, "#"):
        # `room:` - an entity block. `paddle left:` names the instance.
        {"name": first_word_after(t, 0), "kind": 23}
    else if ends_with(t, ":") and starts_with(t, "action ") is false and starts_with(t, "rule ") is false and count_spaces(t) is 1:
        {"name": first_word_after(t, len_of_first_word(t) + 1), "kind": 23}
    else:
        {"name": "", "kind": 0}

define count_spaces(t: text) -> number:
    b = bytes_of(t)
    edit n = 0
    loop i in 0 until length(b):
        if b[i] is 32:
            n = n + 1
    n

define len_of_first_word(t: text) -> number:
    b = bytes_of(t)
    edit i = 0
    loop:
        if i >= length(b) or b[i] is 32:
            break
        i = i + 1
    i

define sym_of_row(row: text, astra: truth) -> table:
    if astra then astra_sym_of_line(row) else sym_of_line(row)

public define lsp_symbols_json(uri: text) -> text:
    rows = lines(doc_get(uri))
    edit out = ""
    edit count = 0
    loop ri in 0 until length(rows):
        s = sym_of_row(rows[ri], is_astra(uri))
        nm = get(s, "name")
        if nm is not "":
            k = get_int(s, "kind")
            sep = if count is 0 then "" else ","
            out = out + sep + "\{\"name\":\"{json_escape(nm)}\",\"kind\":{k},\"range\":\{\"start\":\{\"line\":{ri},\"character\":0\},\"end\":\{\"line\":{ri},\"character\":1\}\},\"selectionRange\":\{\"start\":\{\"line\":{ri},\"character\":0\},\"end\":\{\"line\":{ri},\"character\":1\}\}\}"
            count = count + 1
    "[{out}]"

# ---- word under cursor, definition, hover ----

define is_word_byte(c: number) -> truth:
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c is 95

public define word_at(uri: text, line_no: number, character: number) -> text:
    rows = lines(doc_get(uri))
    if line_no >= length(rows):
        ""
    else:
        row = rows[line_no]
        b = bytes_of(row)
        n = bytes_count(b)
        chb = cp_byte(row, character)
        if n is 0 or chb > n:
            ""
        else:
            edit lo = if chb >= n then n - 1 else chb
            loop:
                if lo <= 0:
                    break
                if is_word_byte(b[lo - 1]):
                    lo = lo - 1
                else:
                    break
            edit hi = lo
            loop:
                if hi >= n:
                    break
                if is_word_byte(b[hi]):
                    hi = hi + 1
                else:
                    break
            text_of(bytes_part(b, lo, hi))

# Line index of `NAME`'s declaration in `body`, or -1.
define decl_line_in(body: text, name: text, astra: truth) -> number:
    rows = lines(body)
    edit found = 0 - 1
    loop ri in 0 until length(rows):
        if found < 0:
            s = sym_of_row(rows[ri], astra)
            if get(s, "name") is name:
                found = ri
    found

# Search the open document, then every other open document, then each orb's
# lib.or under the configured orbs root. A sketch is one file: there is
# nowhere else for its own words to live.
define find_decl(uri: text, name: text) -> table:
    here = decl_line_in(doc_get(uri), name, is_astra(uri))
    if here >= 0:
        {"uri": uri, "line": here}
    else if is_astra(uri):
        {"uri": "", "line": 0 - 1}
    else:
        edit r_uri = ""
        edit r_line = 0 - 1
        loop root in lsp_orb_roots():
            names = split(orion_dir_subdirs(root), "\n")
            loop orb in names:
                if r_line < 0 and orb is not "":
                    cand = "{root}/{orb}/lib.or"
                    src = file_read(cand)
                    if src is not "":
                        ln = decl_line_in(src, name, false)
                        if ln >= 0:
                            r_line = ln
                            r_uri = "file:///{cand}"
        {"uri": r_uri, "line": r_line}

public define lsp_definition_json(uri: text, line_no: number, character: number) -> text:
    name = word_at(uri, line_no, character)
    if name is "":
        "null"
    else:
        d = find_decl(uri, name)
        if get_int(d, "line") < 0:
            "null"
        else:
            du = get(d, "uri")
            dl = get_int(d, "line")
            "\{\"uri\":\"{json_escape(du)}\",\"range\":\{\"start\":\{\"line\":{dl},\"character\":0\},\"end\":\{\"line\":{dl},\"character\":1\}\}\}"

public define lsp_hover_json(uri: text, line_no: number, character: number) -> text:
    name = word_at(uri, line_no, character)
    if name is "":
        "null"
    else:
        d = find_decl(uri, name)
        dl = get_int(d, "line")
        if dl < 0:
            "null"
        else:
            src = if get(d, "uri") is uri then doc_get(uri) else file_read(uri_to_path(get(d, "uri")))
            rows = lines(src)
            decl = if dl < length(rows) then trim(rows[dl]) else name
            fence = if is_astra(uri) then "astra" else "orion"
            "\{\"contents\":\{\"kind\":\"markdown\",\"value\":\"```{fence}\\n{json_escape(decl)}\\n```\"\}\}"

# ---- formatting ----
#
# The editor's format key. Same normalization as `orbit fmt` (the orion_fmt
# orb shared by both): the answer is ONE whole-document edit, or no edits at
# all when the text is already clean - the client applies it atomically, so
# cursor and undo behave.
define lsp_formatting_json(uri: text) -> text:
    src = doc_get(uri)
    formatted = fmt_normalize(src)
    if formatted is src:
        return "[]"
    end_line = length(lines(src))
    "[\{\"range\":\{\"start\":\{\"line\":0,\"character\":0\},\"end\":\{\"line\":{end_line},\"character\":0\}\},\"newText\":\"{json_escape(formatted)}\"\}]"

# ---- capabilities + dispatch ----

define caps_json() -> text:
    "\{\"capabilities\":\{\"textDocumentSync\":1,\"documentSymbolProvider\":true,\"definitionProvider\":true,\"hoverProvider\":true,\"completionProvider\":\{\},\"documentFormattingProvider\":true\},\"serverInfo\":\{\"name\":\"orion-lsp\",\"version\":\"1.0.0\"\}\}"

# ---- completion ----
#
# DECLARATION-BASED, not type-aware: every `fn` / `type` / `effect` / `const` in
# the open document and in the orbs it can see, plus the language's keywords and
# builtins. It does not know which of those would type-check at the cursor,
# because the compiler does not hand out scope-aware type information - and that
# is stated here rather than implied by a confident-looking list. Names you can
# actually write beat a shorter list that pretends to be smarter.
#
# CompletionItemKind: 3 Function, 22 Struct, 8 Interface, 21 Constant, 14 Keyword.
define compl_item(name: text, kind: number, detail: text) -> text:
    "\{\"label\":\"{json_escape(name)}\",\"kind\":{kind},\"detail\":\"{json_escape(detail)}\"\}"

define compl_kind_of(sym_kind: number) -> number:
    if sym_kind is 12:
        3
    else:
        if sym_kind is 23:
            22
        else:
            if sym_kind is 11:
                8
            else:
                21

define compl_from_source(src: text, origin: text, seen: text, out: text) -> table:
    rows = lines(src)
    edit acc = out
    edit mark = seen
    loop ri in 0 until length(rows):
        s = sym_of_row(rows[ri], origin is "this sketch")
        nm = get(s, "name")
        if nm is not "":
            key = "|{nm}|"
            if index_of(mark, key) < 0:
                mark = mark + key
                sep = if acc is "" then "" else ","
                acc = acc + sep + compl_item(nm, compl_kind_of(get_int(s, "kind")), origin)
    {"out": acc, "seen": mark}

# ---- type-aware completion after `x.` ----
#
# `x.f(a)` IS `f(x, a)` in this language, so "what can I write after the dot"
# has an exact answer: the FIELDS of x's type, plus every function whose first
# parameter is that type. Both come from the compiler (`orion <file> symbols`),
# not from a pattern matcher over the source - a second model of the grammar is
# what made the previous language server describe a language that no longer
# existed.
#
# What is still not known: the type of an arbitrary expression. `x` is resolved
# when it is a parameter of the enclosing function, or a `name: Type =` binding,
# or a `Type{…}` construction. Otherwise this falls back to the full list rather
# than guessing.

define sym_rows(uri: text) -> [text]:
    path = uri_to_path(uri)
    dir = dirname_of(path)
    tmp = "{dir}/.orion-lsp-syms.or"
    write_file(tmp, doc_get(uri))
    edit args = [tmp, "symbols"]
    loop root in lsp_orb_roots():
        args = push(args, root)
    out = capture_stdout(lsp_compiler(), args)
    remove_file(tmp)
    lines(out)

# The word immediately before a trailing `.` on this line, or "".
public define receiver_before_dot(uri: text, line_no: number, character: number) -> text:
    rows = lines(doc_get(uri))
    if line_no >= length(rows):
        ""
    else:
        row = rows[line_no]
        b = bytes_of(row)
        n = bytes_count(b)
        chb = cp_byte(row, character)
        cut = if chb > n then n else chb
        if cut < 1:
            ""
        else:
            if b[cut - 1] is not 46:
                ""
            else:
                edit lo = cut - 1
                loop:
                    if lo <= 0:
                        break
                    if is_word_byte(b[lo - 1]):
                        lo = lo - 1
                    else:
                        break
                text_of(bytes_part(b, lo, cut - 1))

# Declared type of `name` as seen from `line_no`: a parameter of the enclosing
# function, a `name: Type =` binding, or `name = Type{…}`.
public define type_of_local(uri: text, name: text, line_no: number) -> text:
    rows = lines(doc_get(uri))
    edit found = ""
    # Walk UP from the cursor: the nearest binding wins, and the enclosing `fn`
    # line ends the search (its parameter list is the last place to look).
    edit i = if line_no >= length(rows) then length(rows) - 1 else line_no
    loop:
        if i < 0 or found is not "":
            break
        row = rows[i]
        t = trim(row)
        # `name: Type = …`
        pat_ann = "{name}: "
        if starts_with(t, pat_ann) and index_of(t, " = ") > 0:
            rest = slice_from(t, length(pat_ann))
            eq = index_of(rest, " = ")
            found = trim(text_of(bytes_part(bytes_of(rest), 0, eq)))
        # `name = Type{…}`
        pat_cons = "{name} = "
        if found is "" and starts_with(t, pat_cons):
            rhs = slice_from(t, length(pat_cons))
            brace = index_of(rhs, "\{")
            if brace > 0:
                found = trim(text_of(bytes_part(bytes_of(rhs), 0, brace)))
        # A parameter of the enclosing fn: `define f(name: Type, …)` (v1 `fn` too)
        if found is "" and starts_with(t, "fn ") or starts_with(t, "pub fn ") or starts_with(t, "define ") or starts_with(t, "public define "):
            marker = "{name}: "
            at_p = index_of(t, marker)
            if at_p > 0:
                after = slice_from(t, at_p + length(marker))
                ab = bytes_of(after)
                edit e = 0
                loop:
                    if e >= length(ab):
                        break
                    c = ab[e]
                    stop = c is 44 or c is 41 or c is 32
                    if stop:
                        break
                    e = e + 1
                found = text_of(bytes_part(ab, 0, e))
            break
        i = i - 1
    found

# Fields of `type_name` + every fn whose FIRST parameter is that type.
define members_of(rows: [text], type_name: text) -> text:
    edit acc = ""
    loop ri in 0 until length(rows):
        row = rows[ri]
        parts = split(row, "|")
        if length(parts) >= 3:
            head = parts[0]
            if starts_with(head, "TYPE "):
                if slice_from(head, 5) is type_name:
                    fields = split(parts[1], ",")
                    loop fi in 0 until length(fields):
                        f = fields[fi]
                        colon = index_of(f, ":")
                        if colon > 0:
                            fname = text_of(bytes_part(bytes_of(f), 0, colon))
                            fty = slice_from(f, colon + 1)
                            sep = if acc is "" then "" else ","
                            acc = acc + sep + compl_item(fname, 5, "field: {fty}")
            if starts_with(head, "FN "):
                ps = parts[1]
                first_colon = index_of(ps, ":")
                if first_colon > 0:
                    rest = slice_from(ps, first_colon + 1)
                    comma = index_of(rest, ",")
                    p1ty = if comma > 0 then text_of(bytes_part(bytes_of(rest), 0, comma)) else rest
                    if p1ty is type_name:
                        fname2 = slice_from(head, 3)
                        sep2 = if acc is "" then "" else ","
                        acc = acc + sep2 + compl_item(fname2, 2, "{type_name}.{fname2}() -> {parts[2]}")
    acc

public define lsp_completion_json(uri: text, line_no: number, character: number) -> text:
    # A sketch is not orion: its own declared names plus the words the
    # astra compiler actually holds. Offering `define` and `handle` here
    # would describe a language the file is not written in.
    if is_astra(uri):
        ra = compl_from_source(doc_get(uri), "this sketch", "", "")
        edit sacc = get(ra, "out")
        awords = ["game", "field", "view", "companion", "starts", "unlocked", "stat", "of", "rule", "every", "seconds", "ticks", "action", "click", "position", "size", "center", "input", "speed", "velocity", "clamp", "free", "mirror", "along", "hits", "leaves", "bounce", "destroy", "reset", "score", "background", "draw", "asset", "color", "bar", "label", "at", "when", "is", "less", "more", "than", "up", "down"]
        loop ai in 0 until length(awords):
            sep3 = if sacc is "" then "" else ","
            sacc = sacc + sep3 + compl_item(awords[ai], 14, "astra")
        return "\{\"isIncomplete\":false,\"items\":[{sacc}]\}"
    # After `x.` the answer is exact, so give THAT and nothing else: the fields
    # of x's type plus the functions that take it first. Returning the whole
    # program's names here would bury the four that apply.
    recv = receiver_before_dot(uri, line_no, character)
    if recv is not "":
        rty = type_of_local(uri, recv, line_no)
        if rty is not "":
            members = members_of(sym_rows(uri), rty)
            if members is not "":
                return "\{\"isIncomplete\":false,\"items\":[{members}]\}"
    # The document first (its own names are the likeliest), then the orbs.
    r1 = compl_from_source(doc_get(uri), "this file", "", "")
    edit acc = get(r1, "out")
    edit seen = get(r1, "seen")
    loop root in lsp_orb_roots():
        names = split(orion_dir_subdirs(root), "\n")
        loop orb in names:
            if orb is not "":
                src = file_read("{root}/{orb}/lib.or")
                if src is not "":
                    r2 = compl_from_source(src, "orb {orb}", seen, acc)
                    acc = get(r2, "out")
                    seen = get(r2, "seen")
    # Keywords last: short, always valid, and they should not push declarations
    # out of the top of the list.
    # The TYPES belong here too. They are what a person reaches for most and
    # the list had none of them, so typing `num` offered nothing - while the
    # language's whole point is that `number` is the only number word.
    # `of` comes with them: `list of number`, `table of text`.
    kws = ["define", "public", "type", "edit", "if", "then", "else", "choose", "loop", "parallel", "break", "continue", "return", "require", "ensure", "defer", "collect", "effect", "handle", "perform", "resume", "use", "external", "deterministic", "and", "or", "not", "in", "where", "is", "to", "until", "try", "given", "requires", "uses", "example", "of", "true", "false", "some", "none", "ok", "error", "number", "text", "truth", "table", "list", "maybe", "result"]
    loop ki in 0 until length(kws):
        kw = kws[ki]
        sep2 = if acc is "" then "" else ","
        acc = acc + sep2 + compl_item(kw, 14, "keyword")
    "\{\"isIncomplete\":false,\"items\":[{acc}]\}"

define handle(msg: text) -> number:
    root = json_parse(msg)
    method = json_text(root, "method")
    id = json_whole(root, "id")
    params = json_obj(root, "params")
    td = json_obj(params, "textDocument")
    uri = json_text(td, "uri")
    edit done = 0
    if method is "initialize":
        # The client may pass the compiler + orbs root through initializationOptions.
        opts = json_obj(params, "initializationOptions")
        if json_text(opts, "compiler") is not "":
            slot_set("lsp:orion", orion_persist_text(json_text(opts, "compiler")))
        if json_text(opts, "orbs") is not "":
            slot_set("lsp:orbs", orion_persist_text(json_text(opts, "orbs")))
        lsp_respond(id, caps_json())
    if method is "shutdown":
        lsp_respond(id, "null")
    if method is "exit":
        done = 1
    if method is "textDocument/didOpen":
        doc_set(uri, json_text(td, "text"))
        lsp_diagnose(uri)
    if method is "textDocument/didChange":
        changes = json_list(params, "contentChanges")
        if length(changes) > 0:
            last = changes[length(changes) - 1]
            doc_set(uri, json_text(last, "text"))
            lsp_diagnose(uri)
    if method is "textDocument/didSave":
        if json_text(params, "text") is not "":
            doc_set(uri, json_text(params, "text"))
        lsp_diagnose(uri)
    if method is "textDocument/didClose":
        lsp_publish(uri, "")
    if method is "textDocument/documentSymbol":
        lsp_respond(id, lsp_symbols_json(uri))
    if method is "textDocument/definition":
        pos = json_obj(params, "position")
        lsp_respond(id, lsp_definition_json(uri, json_whole(pos, "line"), json_whole(pos, "character")))
    if method is "textDocument/hover":
        pos2 = json_obj(params, "position")
        lsp_respond(id, lsp_hover_json(uri, json_whole(pos2, "line"), json_whole(pos2, "character")))
    if method is "textDocument/completion":
        pos3 = json_obj(params, "position")
        lsp_respond(id, lsp_completion_json(uri, json_whole(pos3, "line"), json_whole(pos3, "character")))
    if method is "textDocument/formatting":
        lsp_respond(id, lsp_formatting_json(uri))
    done

public define lsp_serve() -> number:
    # argv: [exe, orion-compiler-path, orbs-root]. Both are optional; the client
    # can also send them in initializationOptions.
    if argc() >= 2:
        slot_set("lsp:orion", orion_persist_text(argv(1)))
    if argc() >= 3:
        slot_set("lsp:orbs", orion_persist_text(argv(2)))
    orion_stderr_line("orion-lsp: ready")
    loop:
        msg = lsp_read_message()
        if msg is "":
            break
        if handle(msg) is 1:
            break
    0
