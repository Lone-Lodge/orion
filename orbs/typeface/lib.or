# typeface - real font rendering from TrueType (.ttf) files.
#
# The parser (sfnt tables, cmap, glyf outlines, scanline fill) is the proven
# atlas_text code. What this orb adds is the LABEL SPRITE: a whole line
# rasterized into one keyed Texture inside a field-space Sprite, so the
# renderer's bilinear minification scales it like any other sprite.
#
# Fonts arrive as EMBEDDED blobs, so a game binary carries its letters the way
# it carries its art. See README.md.

use num
use list

define be_u16(b: [number], off: number) -> number:
    byte_at(b, off) * 256 + byte_at(b, off + 1)

define be_u32(b: [number], off: number) -> number:
    byte_at(b, off) * 16777216 + byte_at(b, off + 1) * 65536 + byte_at(b, off + 2) * 256 + byte_at(b, off + 3)

define be_i16(b: [number], off: number) -> number:
    v = be_u16(b, off)
    if v >= 32768 then v - 65536 else v

define tag_is(b: [number], off: number, c0: number, c1: number, c2: number, c3: number) -> truth:
    byte_at(b, off) is c0 and byte_at(b, off + 1) is c1 and byte_at(b, off + 2) is c2 and byte_at(b, off + 3) is c3

# A parsed font: the raw bytes plus resolved table offsets and header fields.
# loc_fmt: 0 = short loca (u16 offsets, doubled), 1 = long loca (u32).
# cache: a per-font (gid,size)->pixel-spans memo. Rasterizing a glyph from
# its outline every frame churned ~800 KB/frame and burned CPU; the spans
# for a given glyph+size never change, so glyph_spans_cached computes them
# once (into persist) and replays. The map is a mutable handle, so it is
# shared across the by-value Font copies that flow through a renderer.
public type Font: bytes: [number], upm: number, nglyphs: number, loc_fmt: number, off_head: number, off_maxp: number, off_cmap: number, off_loca: number, off_glyf: number, off_hhea: number, off_hmtx: number, off_gpos: number, ok: truth, cache: table

# Parse the sfnt table directory and the head/maxp headers from an
# embedded blob. Returns a Font with ok=false when the blob isn't a
# recognizable TrueType sfnt.
public define load_font_blob(blob: text) -> Font:
    b = bytes_of(blob)
    n = bytes_count(b)
    if n < 12:
        return Font{bytes: b, upm: 0, nglyphs: 0, loc_fmt: 0, off_head: 0, off_maxp: 0, off_cmap: 0, off_loca: 0, off_glyf: 0, off_hhea: 0, off_hmtx: 0, off_gpos: 0, ok: false, cache: {}}
    ntables = be_u16(b, 4)
    edit head = 0
    edit maxp = 0
    edit cmap = 0
    edit loca = 0
    edit glyf = 0
    edit hhea = 0
    edit hmtx = 0
    edit gpos = 0
    loop i in 0 until ntables:
        rec = 12 + i * 16
        off = be_u32(b, rec + 8)
        if tag_is(b, rec, 104, 101, 97, 100):
            head = off
        if tag_is(b, rec, 109, 97, 120, 112):
            maxp = off
        if tag_is(b, rec, 99, 109, 97, 112):
            cmap = off
        if tag_is(b, rec, 108, 111, 99, 97):
            loca = off
        if tag_is(b, rec, 103, 108, 121, 102):
            glyf = off
        if tag_is(b, rec, 104, 104, 101, 97):
            hhea = off
        if tag_is(b, rec, 104, 109, 116, 120):
            hmtx = off
        # GPOS: where kerning lives in a modern font. Inter has no `kern`
        # table at all, only this.
        if tag_is(b, rec, 71, 80, 79, 83):
            gpos = off
    upm = if head > 0 then be_u16(b, head + 18) else 0
    loc_fmt = if head > 0 then be_i16(b, head + 50) else 0
    nglyphs = if maxp > 0 then be_u16(b, maxp + 4) else 0
    Font{bytes: b, upm: upm, nglyphs: nglyphs, loc_fmt: loc_fmt, off_head: head, off_maxp: maxp, off_cmap: cmap, off_loca: loca, off_glyf: glyf, off_hhea: hhea, off_hmtx: hmtx, off_gpos: gpos, ok: head > 0 and maxp > 0 and glyf > 0 and loca > 0, cache: {}}

# ---- cmap: codepoint -> glyph id (format 4, Unicode BMP) ----

# Locate a format-4 Unicode subtable within the cmap table; return its
# absolute byte offset, or 0 if none. Prefers a Windows-Unicode (3,1) or
# Unicode (0,*) record, but accepts any subtable that is format 4.
# Which subtable, remembered. The scan below walks every record in the
# cmap - four of them in Inter - and it has no reason to run twice.
define cmap_sub_cached(f: Font) -> number:
    key = 3298534883327
    if has(f.cache, key):
        return get_list(f.cache, key)[0]
    sub = cmap_format4_sub(f)
    was_on = orion_arena_active()
    if was_on is 1:
        orion_arena_off()
    orion_persist_on()
    edit one = []
    one = append(one, sub)
    set(f.cache, key, one)
    orion_persist_off()
    if was_on is 1:
        orion_arena_on()
    sub

define cmap_format4_sub(f: Font) -> number:
    b = f.bytes
    base = f.off_cmap
    if base is 0:
        return 0
    ntab = be_u16(b, base + 2)
    edit chosen = 0
    loop i in 0 until ntab:
        rec = base + 4 + i * 8
        plat = be_u16(b, rec)
        enc = be_u16(b, rec + 2)
        sub = base + be_u32(b, rec + 4)
        if be_u16(b, sub) is 4:
            unicode_pref = (plat is 3 and enc is 1) or plat is 0
            if chosen is 0 or unicode_pref:
                chosen = sub
    chosen

# Map a Unicode codepoint to a glyph id via the format-4 segment tables.
# 0 (.notdef) when unmapped or no usable cmap.
# Every character of every string, every time it is measured or drawn, was
# re-scanning the cmap subtable list and then binary-searching its segments.
# A layout that measures a few hundred runs of text does that tens of
# thousands of times a frame, and it was most of the frame.
#
# The answer for a codepoint never changes. Remember it.
# --- reading UTF-8 ---------------------------------------------------------
# glyph_id wants a CODEPOINT. Handing it raw bytes turns every non-ASCII
# character into two glyphs, so "ändå" measures as "Ã¤ndÃ¥" - wider than it
# draws, and with the caret landing between the two halves of one letter.
# The renderer and the measurer each had their own copy of this; disagreeing
# about where a character ends is not a thing two of them should be able to
# do.

# How many bytes the character starting at `i` takes up.
public define cp_step(b: [number], i: number) -> number:
    example cp_step(bytes_of("a"), 0) is 1
    example cp_step(bytes_of("ä"), 0) is 2
    lead = byte_at(b, i)
    if lead < 128 then 1 else if lead < 224 then 2 else if lead < 240 then 3 else 4

# The codepoint starting at `i`. Both arms of an `if` are evaluated before
# one is picked, so the continuation bytes are read defensively - a trailing
# ASCII character would otherwise index past the end.
public define cp_at(b: [number], i: number) -> number:
    example cp_at(bytes_of("a"), 0) is 97
    example cp_at(bytes_of("ä"), 0) is 228
    n = bytes_count(b)
    lead = byte_at(b, i)
    step = cp_step(b, i)
    b1 = if i + 1 < n then byte_at(b, i + 1) else 128
    b2 = if i + 2 < n then byte_at(b, i + 2) else 128
    two = (lead - 192) * 64 + (b1 - 128)
    three = (lead - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)
    if step is 1 then lead else if step is 2 then two else three

public define glyph_id(f: Font, cp: number) -> number:
    key = 3298534883328 + cp
    if has(f.cache, key):
        return get_list(f.cache, key)[0]
    g = glyph_id_slow(f, cp)
    was_on = orion_arena_active()
    if was_on is 1:
        orion_arena_off()
    orion_persist_on()
    edit one = []
    one = append(one, g)
    set(f.cache, key, one)
    orion_persist_off()
    if was_on is 1:
        orion_arena_on()
    g

define glyph_id_slow(f: Font, cp: number) -> number:
    b = f.bytes
    sub = cmap_sub_cached(f)
    if sub is 0:
        return 0
    seg2 = be_u16(b, sub + 6)
    segc = seg2 // 2
    end_base = sub + 14
    start_base = sub + 16 + seg2
    delta_base = sub + 16 + seg2 * 2
    range_base = sub + 16 + seg2 * 3
    edit result = 0
    edit found = 0 - 1
    loop i in 0 until segc:
        if found < 0 and cp <= be_u16(b, end_base + i * 2):
            found = i
    if found >= 0:
        start = be_u16(b, start_base + found * 2)
        if cp >= start:
            ro_pos = range_base + found * 2
            ro = be_u16(b, ro_pos)
            delta = be_i16(b, delta_base + found * 2)
            if ro is 0:
                result = md16(cp + delta)
            else:
                gpos = ro_pos + ro + (cp - start) * 2
                g = be_u16(b, gpos)
                result = if g is 0 then 0 else md16(g + delta)
    result

# Wrap into u16 range (idDelta arithmetic is modulo 65536).
define md16(x: number) -> number:
    m = x - (x // 65536) * 65536
    if m < 0 then m + 65536 else m

# ---- glyph outlines (glyf/loca) + metrics (hmtx) ----

define pow2(k: number) -> number:
    edit p = 1
    loop _i in 0 until k:
        p = p * 2
    p

# Bit k of v (0 or 1).
define bit(v: number, k: number) -> number:
    q = v // pow2(k)
    q - (q // 2) * 2

# Number of advance-width entries in hmtx (rest of glyphs reuse the last).
define num_hmetrics(f: Font) -> number:
    if f.off_hhea is 0 then 0 else be_u16(f.bytes, f.off_hhea + 34)

# Advance width of a glyph in font units.
public define advance_width(f: Font, gid: number) -> number:
    nh = num_hmetrics(f)
    if nh is 0 or f.off_hmtx is 0:
        0
    else:
        g = if gid < nh then gid else nh - 1
        be_u16(f.bytes, f.off_hmtx + g * 4)

# Typographic ascent in font units (hhea.ascender). The baseline sits this
# far below the top of the em box, so a renderer places text x[y] by
# putting the baseline at y + ascent*scale and drawing glyphs upward from it.
public define font_ascent(f: Font) -> number:
    if f.off_hhea is 0 then 0 else be_i16(f.bytes, f.off_hhea + 4)

# Typographic descent in font units (hhea.descender, negative below the
# baseline). ascent - descent spans the whole line.
public define font_descent(f: Font) -> number:
    if f.off_hhea is 0 then 0 else be_i16(f.bytes, f.off_hhea + 6)

# Byte offset of glyph `g`'s outline data within the glyf table region.
define loca_off(f: Font, g: number) -> number:
    b = f.bytes
    if f.loc_fmt is 1 then be_u32(b, f.off_loca + g * 4) else be_u16(b, f.off_loca + g * 2) * 2

# One glyph outline as flat parallel point arrays plus contour-end indices.
# Contour i spans points (ends[i-1]+1 .. ends[i]). on_curve[j] = 1 for an
# on-curve point, 0 for a quadratic off-curve control point. Empty (space)
# glyphs return empty arrays with ok=true; composite glyphs are assembled
# from their components. `adv` is the advance width in font units.
public type Glyph: xs: [number], ys: [number], on_curve: [number], ends: [number], adv: number, ok: truth

# Signed 8-bit and F2Dot14 (2.14 fixed-point) readers for composite args.
define sbyte(b: [number], i: number) -> number:
    v = byte_at(b, i)
    if v >= 128 then v - 256 else v

define f2dot14(b: [number], i: number) -> f64:
    to_real(be_i16(b, i)) / 16384.0

# A composite glyph references other glyphs (e.g. `i` = dotless-i + dot),
# each placed with an x/y offset and an optional 2x2 transform. Walk the
# components, pull each referenced glyph's outline (recursively), apply the
# transform, and concatenate - so accented and dotted letters render instead
# of silently vanishing. Assumes ARGS_ARE_XY_VALUES (the ubiquitous case;
# point-matching composites are not used by UI fonts).
define composite_outline(f: Font, gp: number, adv: number) -> Glyph:
    b = f.bytes
    edit xs = []
    edit ys = []
    edit on = []
    edit ends = []
    edit base = 0
    edit pos = gp + 10
    edit more = 1
    loop:
        if more is 0:
            break
        flags = be_u16(b, pos)
        cgid = be_u16(b, pos + 2)
        pos = pos + 4
        edit dx = 0
        edit dy = 0
        if bit(flags, 0) is 1:
            dx = be_i16(b, pos)
            dy = be_i16(b, pos + 2)
            pos = pos + 4
        else:
            dx = sbyte(b, pos)
            dy = sbyte(b, pos + 1)
            pos = pos + 2
        edit a = 1.0
        edit bb = 0.0
        edit c = 0.0
        edit d = 1.0
        if bit(flags, 3) is 1:
            a = f2dot14(b, pos)
            d = a
            pos = pos + 2
        else:
            if bit(flags, 6) is 1:
                a = f2dot14(b, pos)
                d = f2dot14(b, pos + 2)
                pos = pos + 4
            else:
                if bit(flags, 7) is 1:
                    a = f2dot14(b, pos)
                    bb = f2dot14(b, pos + 2)
                    c = f2dot14(b, pos + 4)
                    d = f2dot14(b, pos + 6)
                    pos = pos + 8
        cg = glyph_outline(f, cgid)
        np = length(cg.xs)
        loop i in 0 until np:
            px = to_real(cg.xs[i])
            py = to_real(cg.ys[i])
            xs = append(xs, to_whole(a * px + c * py) + dx)
            ys = append(ys, to_whole(bb * px + d * py) + dy)
            on = append(on, cg.on_curve[i])
        ne = length(cg.ends)
        loop i in 0 until ne:
            ends = append(ends, cg.ends[i] + base)
        base = base + np
        more = bit(flags, 5)
    Glyph{xs: xs, ys: ys, on_curve: on, ends: ends, adv: adv, ok: true}

public define glyph_outline(f: Font, gid: number) -> Glyph:
    b = f.bytes
    adv = advance_width(f, gid)
    o0 = loca_off(f, gid)
    o1 = loca_off(f, gid + 1)
    if o1 <= o0:
        return Glyph{xs: [], ys: [], on_curve: [], ends: [], adv: adv, ok: true}
    gp = f.off_glyf + o0
    ncont = be_i16(b, gp)
    if ncont < 0:
        return composite_outline(f, gp, adv)
    edit ends = []
    loop i in 0 until ncont:
        ends = append(ends, be_u16(b, gp + 10 + i * 2))
    npts = if ncont > 0 then ends[ncont - 1] + 1 else 0
    instr_len_pos = gp + 10 + ncont * 2
    instr_len = be_u16(b, instr_len_pos)
    edit pos = instr_len_pos + 2 + instr_len
    # Flags, expanding the repeat (bit 3) runs.
    edit flags = []
    loop:
        if length(flags) >= npts:
            break
        flag = byte_at(b, pos)
        pos = pos + 1
        flags = append(flags, flag)
        if bit(flag, 3) is 1:
            rep = byte_at(b, pos)
            pos = pos + 1
            loop _r in 0 until rep:
                if length(flags) < npts:
                    flags = append(flags, flag)
    # X coords: bit1 = short(1 byte, bit4=sign); else bit4 = same(delta 0), else i16.
    edit xs = []
    edit xacc = 0
    loop i in 0 until npts:
        fl = flags[i]
        if bit(fl, 1) is 1:
            d = byte_at(b, pos)
            pos = pos + 1
            xacc = xacc + (if bit(fl, 4) is 1 then d else 0 - d)
        else:
            if bit(fl, 4) is 0:
                xacc = xacc + be_i16(b, pos)
                pos = pos + 2
        xs = append(xs, xacc)
    # Y coords: bit2 = short, bit5 = sign/same.
    edit ys = []
    edit yacc = 0
    loop i in 0 until npts:
        fl = flags[i]
        if bit(fl, 2) is 1:
            d = byte_at(b, pos)
            pos = pos + 1
            yacc = yacc + (if bit(fl, 5) is 1 then d else 0 - d)
        else:
            if bit(fl, 5) is 0:
                yacc = yacc + be_i16(b, pos)
                pos = pos + 2
        ys = append(ys, yacc)
    edit on = []
    loop i in 0 until npts:
        on = append(on, bit(flags[i], 0))
    Glyph{xs: xs, ys: ys, on_curve: on, ends: ends, adv: adv, ok: true}

# ---- flattening (quadratic beziers -> polylines) + scanline fill ----

# Flattened glyph: closed polygons in FONT UNITS as f64 parallel arrays,
# with per-contour end indices. `adv` carried through.
public type FlatGlyph: px: [f64], py: [f64], ends: [number], adv: number

define wrap(i: number, n: number) -> number:
    if i < n then i else i - n

# Flatten every contour: insert implied on-curve midpoints between adjacent
# off-curve points, start at an on-curve vertex, then walk emitting line
# points and 8-step subdivisions of each quadratic. Result is a set of
# closed polygons ready for trapezoidal fill.
public define flatten_glyph(f: Font, gid: number) -> FlatGlyph:
    g = glyph_outline(f, gid)
    edit px = part([0.0], 0, 0)
    edit py = part([0.0], 0, 0)
    edit fends = []
    nc = length(g.ends)
    edit cstart = 0
    loop c in 0 until nc:
        cend = g.ends[c]
        m = cend - cstart + 1
        if m >= 2:
            # Normalized cyclic point list with implied midpoints inserted.
            edit nx = part([0.0], 0, 0)
            edit ny = part([0.0], 0, 0)
            edit non = []
            loop j in 0 until m:
                ax = to_real(g.xs[cstart + j])
                ay = to_real(g.ys[cstart + j])
                ac = g.on_curve[cstart + j]
                nx = append(nx, ax)
                ny = append(ny, ay)
                non = append(non, ac)
                nj = wrap(j + 1, m)
                if ac is 0 and g.on_curve[cstart + nj] is 0:
                    bx = to_real(g.xs[cstart + nj])
                    by = to_real(g.ys[cstart + nj])
                    nx = append(nx, (ax + bx) / 2.0)
                    ny = append(ny, (ay + by) / 2.0)
                    non = append(non, 1)
            mm = length(nx)
            edit start = 0 - 1
            loop j in 0 until mm:
                if start < 0 and non[j] is 1:
                    start = j
            if start < 0:
                start = 0
            px = append(px, nx[start])
            py = append(py, ny[start])
            edit ci = start
            edit guard = 0
            loop:
                guard = guard + 1
                if guard > mm + 4:
                    break
                ni = wrap(ci + 1, mm)
                if non[ni] is 1:
                    px = append(px, nx[ni])
                    py = append(py, ny[ni])
                    ci = ni
                else:
                    nni = wrap(ci + 2, mm)
                    x0 = nx[ci]
                    y0 = ny[ci]
                    cxx = nx[ni]
                    cyy = ny[ni]
                    x1 = nx[nni]
                    y1 = ny[nni]
                    loop s in 1 until 9:
                        t = to_real(s) / 8.0
                        u = 1.0 - t
                        px = append(px, u * u * x0 + 2.0 * u * t * cxx + t * t * x1)
                        py = append(py, u * u * y0 + 2.0 * u * t * cyy + t * t * y1)
                    ci = nni
                if ci is start:
                    break
            fends = append(fends, length(px) - 1)
        cstart = cend + 1
    FlatGlyph{px: px, py: py, ends: fends, adv: g.adv}

# x on the edge (x0,y0)-(x1,y1) at height y.
define edge_x_at(x0: f64, y0: f64, x1: f64, y1: f64, y: f64) -> f64:
    if y1 is y0 then x0 else x0 + (x1 - x0) * (y - y0) / (y1 - y0)

# Round to nearest int, correct for both signs (glyphs can have a negative
# left side-bearing, so x may be slightly < 0).
define round_i(x: f64) -> number:
    if x >= 0.0 then to_whole(x + 0.5) else 0 - to_whole(0.5 - x)

# Overwrite element i (index must exist). Separate f64/int helpers since
# Orion function names are global (no overloading).
define fset(xs: [f64], i: number, v: f64) -> [f64]:
    edit o = part([0.0], 0, 0)
    loop k in 0 until length(xs):
        o = append(o, if k is i then v else xs[k])
    o

define iset(xs: [number], i: number, v: number) -> [number]:
    edit o = []
    loop k in 0 until length(xs):
        o = append(o, if k is i then v else xs[k])
    o

# Scanline-fill closed polygons into horizontal pixel spans. Input is
# design-unit outlines: parallel px/py with Y pointing UP (the font
# convention) and `ends` giving each contour's last index; `scale` is
# pixels-per-design-unit. Output is a flat [int] of (x0, x1, y) triples
# in local pixels, origin 0[0] with Y growing DOWNWARD (screen
# convention) - the caller adds the pen/baseline offset. Non-zero
# winding, so counters and holes fall out for free.
public define polygon_fill_spans(px: [f64], py: [f64], ends: [number], scale: f64) -> [number]:
    np = length(px)
    edit spans = []
    if np < 3:
        return spans
    # Edges in local pixel space (design units are Y-up, so flip: y_px = -y*scale).
    edit ex0 = part([0.0], 0, 0)
    edit ey0 = part([0.0], 0, 0)
    edit ex1 = part([0.0], 0, 0)
    edit ey1 = part([0.0], 0, 0)
    edit edir = []
    edit ymin = 0.0
    edit ymax = 0.0
    edit seen = 0
    edit cstart = 0
    loop c in 0 until length(ends):
        cend = ends[c]
        loop i in cstart until (cend + 1):
            j = if i < cend then i + 1 else cstart
            ax = px[i] * scale
            ay = 0.0 - py[i] * scale
            bx = px[j] * scale
            by = 0.0 - py[j] * scale
            if seen is 0:
                ymin = ay
                ymax = ay
                seen = 1
            ymin = min(ymin, ay)
            ymax = max(ymax, ay)
            if ay is not by:
                ex0 = append(ex0, ax)
                ey0 = append(ey0, ay)
                ex1 = append(ex1, bx)
                ey1 = append(ey1, by)
                edir = append(edir, if by > ay then 1 else 0 - 1)
        cstart = cend + 1
    ne = length(edir)
    row0 = round_i(ymin)
    row1 = round_i(ymax)
    loop row in row0 until (row1 + 1):
        yc = to_real(row) + 0.5
        # Crossings at this scanline, then insertion-sort by x.
        edit cx = part([0.0], 0, 0)
        edit cd = []
        loop e in 0 until ne:
            elo = min(ey0[e], ey1[e])
            ehi = max(ey0[e], ey1[e])
            if elo <= yc and ehi > yc:
                cx = append(cx, edge_x_at(ex0[e], ey0[e], ex1[e], ey1[e], yc))
                cd = append(cd, edir[e])
        nc = length(cd)
        loop a in 1 until nc:
            ka = cx[a]
            kd = cd[a]
            edit bb = a - 1
            loop:
                if bb < 0:
                    break
                if cx[bb] <= ka:
                    break
                cx = fset(cx, bb + 1, cx[bb])
                cd = iset(cd, bb + 1, cd[bb])
                bb = bb - 1
            cx = fset(cx, bb + 1, ka)
            cd = iset(cd, bb + 1, kd)
        edit w = 0
        loop i in 0 until (nc - 1):
            w = w + cd[i]
            if w is not 0:
                x0i = round_i(cx[i])
                x1i = round_i(cx[i + 1])
                if x1i > x0i:
                    spans = append(spans, x0i)
                    spans = append(spans, x1i)
                    spans = append(spans, row)
    spans

# Scanline-fill one glyph into pixel spans (see polygon_fill_spans). `scale`
# is pixels-per-font-unit (size/unitsPerEm); the baseline sits at y=0.
public define glyph_fill_spans(f: Font, gid: number, scale: f64) -> [number]:
    fg = flatten_glyph(f, gid)
    polygon_fill_spans(fg.px, fg.py, fg.ends, scale)

# ---- crisp screen-space words ----
#
# Text is not a sprite: a Word is field-space DATA (a line, its place,
# its em height, its face), and the shell rasterizes it into the frame
# AT THE WINDOW'S OWN RESOLUTION - so letters are pixel-exact on every
# shell, antialiased by 4x supersampled coverage blended over whatever
# was rendered beneath. Glyph masks are cached per (face, letter, px):
# the runner warms the cache once from the game's word book (OUTSIDE
# the frame pools, so the masks live on the persistent heap) and every
# frame after that is pure replay. A miss (say, after a window resize)
# still draws - rasterized fresh into that frame's pool - it just pays
# each frame until warmed again.

# centered: x is the line's CENTER instead of its left edge - the
# shell measures the line and splits it, so a sketch never counts
# letter widths.
public type Word: content: text, titled: truth, centered: truth, x: number, y: number, em: number, color: number

# The engine's two faces, embedded with the engine itself. The .subset
# files are the ASCII the sketches can say (orion tools/subset_font.js, run
# against the full .ttf beside them) - the wasm backend pays per
# embedded byte, and a full family ships thousands of unsayable glyphs.
public define font_body() -> Font:
    load_font_blob(embed "assets/Inter-Regular.subset.ttf")

public define font_title() -> Font:
    load_font_blob(embed "assets/Cinzel-Regular.subset.ttf")

# The fixed-width face. Code, and anything that has to line up in columns:
# what makes it code is not the colour, it is that every letter is the same
# width. Cascadia Mono, under the Open Font License.
public define font_mono() -> Font:
    load_font_blob(embed "assets/CascadiaMono-Regular.subset.ttf")

# A warmed set: both faces plus the glyph-mask cache. Plain lists, no
# tables - the wasm backend can carry them too. `sizes` holds each
# warmed pixel size; `slots` holds, per size, 512 entries (face*256 +
# letter) of stash-index-plus-one (0 = not warmed); `stash` holds the
# masks themselves.
public type Typeset: body: Font, heading: Font, sizes: [number], slots: [number], stash: list of [number]

# The unwarmed set: fonts parsed, every glyph rasterized on demand.
# What the web shell uses - it re-instantiates per frame anyway.
public define cold_typeset() -> Typeset:
    Typeset{body: font_body(), heading: font_title(), sizes: [], slots: [], stash: []}

define floor_div(a: number, b: number) -> number:
    if a >= 0 then a // b else 0 - ((0 - a + b - 1) // b)

# One glyph as an antialiased alpha mask, flat for the cache:
# [w, h, ox, oy, alpha...] with ox/oy the offset from the pen origin
# (baseline at y=0) and alpha 0..255. Fill at 4x with the proven 1-bit
# scanline fill, then box-downsample - 17 coverage levels, no new
# rasterizer to get wrong. Empty glyph -> [0, 0, 0, 0].
define glyph_mask(f: Font, cp: number, em_px: number) -> [number]:
    ss = 4
    gid = glyph_id(f, cp)
    scale = to_real(em_px) / to_real(f.upm)
    spans = glyph_fill_spans(f, gid, scale * to_real(ss))
    ns = length(spans) // 3
    if ns is 0:
        return [0, 0, 0, 0]
    edit minx = spans[0]
    edit maxx = spans[1]
    edit miny = spans[2]
    edit maxy = spans[2]
    loop i in 0 until ns:
        x0 = spans[i * 3]
        x1 = spans[i * 3 + 1]
        y = spans[i * 3 + 2]
        if x0 < minx: minx = x0
        if x1 > maxx: maxx = x1
        if y < miny: miny = y
        if y > maxy: maxy = y
    ox = floor_div(minx, ss)
    oy = floor_div(miny, ss)
    ow = floor_div(maxx + ss - 1, ss) - ox
    oh = floor_div(maxy, ss) - oy + 1
    if ow <= 0 or oh <= 0:
        return [0, 0, 0, 0]
    edit cov = filled(ow * oh, 0)
    loop i in 0 until ns:
        x0 = spans[i * 3]
        x1 = spans[i * 3 + 1]
        y = spans[i * 3 + 2]
        oyy = floor_div(y, ss) - oy
        loop hx in x0 until x1:
            idx = oyy * ow + (floor_div(hx, ss) - ox)
            cov = set(cov, idx, cov[idx] + 1)
    denom = ss * ss
    edit mask = [ow, oh, ox, oy]
    loop p in 0 until (ow * oh):
        a = cov[p] * 255 // denom
        mask = append(mask, if a > 255 then 255 else a)
    mask

# A size's slot block in `slots`, or -1 while that size is unwarmed.
define size_block(types: Typeset, em_px: number) -> number:
    edit found = 0 - 1
    loop i in 0 until length(types.sizes):
        if types.sizes[i] is em_px:
            found = i * 512
    found

# The cached mask, or a fresh one on a miss. Reads never insert - an
# insert mid-frame would land in the frame pool and dangle after reset;
# only warm_typeset (outside the pools) fills the cache.
define mask_of(types: Typeset, titled: truth, cp: number, em_px: number) -> [number]:
    block = size_block(types, em_px)
    slot = if block < 0 or cp >= 256 then 0 else types.slots[block + (if titled then 256 else 0) + cp]
    if block >= 0 and slot > 0:
        return types.stash[slot - 1]
    glyph_mask(if titled then types.heading else types.body, cp, em_px)

# Parse both faces and rasterize every letter the game's word book can
# show, at the size this window will draw it. Call ONCE at startup,
# before any frame pool is active.
public define warm_typeset(book: list of Word, ppu: number) -> Typeset:
    body = font_body()
    heading = font_title()
    edit sizes = []
    edit slots = []
    edit stash = []
    loop word in book:
        em_px = to_whole(word.em * ppu + 0.5)
        edit block = 0 - 1
        loop i in 0 until length(sizes):
            if sizes[i] is em_px:
                block = i * 512
        if block < 0:
            block = length(sizes) * 512
            sizes = append(sizes, em_px)
            loop _s in 0 until 512:
                slots = append(slots, 0)
        letters = bytes_of(word.content)
        edit i = 0
        loop:
            if i >= bytes_count(letters):
                break
            cp = cp_at(letters, i)
            i = i + cp_step(letters, i)
            # cachen ar 256 platser per block - kodpunkter over Latin-1
            # gar direktvagen i mask_of i stallet
            slot = block + (if word.titled then 256 else 0) + cp
            if cp < 256 and slots[slot] is 0:
                stash = push(stash, glyph_mask(if word.titled then heading else body, cp, em_px))
                slots = set(slots, slot, length(stash))
    Typeset{body: body, heading: heading, sizes: sizes, slots: slots, stash: stash}

define blend_channel(bg: number, ink: number, alpha: number) -> number:
    bg + (ink - bg) * alpha // 255

define blend_px(bg: number, ink: number, alpha: number) -> number:
    red = blend_channel((bg // 65536) % 256, (ink // 65536) % 256, alpha)
    green = blend_channel((bg // 256) % 256, (ink // 256) % 256, alpha)
    blue = blend_channel(bg % 256, ink % 256, alpha)
    red * 65536 + green * 256 + blue

# One line blitted at PIXEL coordinates: left_px is the pen start,
# top_px the line's top (baseline = top + ascent). The lowest rung of
# the ladder - draw_words and the DisplayList compositor both end here,
# so every letter on screen comes through one blitter.
public define blit_line(pixels: [number], width: number, height: number, left_px: number, top_px: number, content: text, titled: truth, em_px: number, color: number, types: Typeset) -> [number]:
    f = if titled then types.heading else types.body
    scale = to_real(em_px) / to_real(f.upm)
    base_row = round_i(top_px + to_real(font_ascent(f)) * scale)
    edit out = pixels
    edit penx = left_px
    letters = bytes_of(content)
    edit i = 0
    loop:
        if i >= bytes_count(letters):
            break
        cp = cp_at(letters, i)
        i = i + cp_step(letters, i)
        mask = mask_of(types, titled, cp, em_px)
        mask_w = mask[0]
        mask_h = mask[1]
        glyph_left = round_i(penx) + mask[2]
        glyph_top = base_row + mask[3]
        loop row in 0 until mask_h:
            py = glyph_top + row
            if py >= 0 and py < height:
                loop col in 0 until mask_w:
                    alpha = mask[4 + row * mask_w + col]
                    px = glyph_left + col
                    if alpha > 0 and px >= 0 and px < width:
                        out = set(out, py * width + px, blend_px(out[py * width + px], color, alpha))
        penx = penx + to_real(advance_width(f, glyph_id(f, cp))) * scale
    out

# The width of a line in pixels at em size em_px - the blitter's own
# advance sum, for centering without drawing.
public define line_width_px(content: text, titled: truth, em_px: number, types: Typeset) -> number:
    f = if titled then types.heading else types.body
    scale = to_real(em_px) / to_real(f.upm)
    edit wide = 0.0
    letters = bytes_of(content)
    edit i = 0
    loop:
        if i >= bytes_count(letters):
            break
        wide = wide + to_real(advance_width(f, glyph_id(f, cp_at(letters, i)))) * scale
        i = i + cp_step(letters, i)
    wide

# Draw every word over the rendered frame, letters placed on the pen
# line exactly as the font's metrics say. Words sit ABOVE everything -
# they are the HUD's voice, same as the old always-on-top labels.
public define draw_words(pixels: [number], width: number, height: number, field_w: number, field_h: number, spoken: list of Word, types: Typeset, ppu: number) -> [number]:
    edit out = pixels
    loop word in spoken:
        f = if word.titled then types.heading else types.body
        em_px = to_whole(word.em * ppu + 0.5)
        top_px = to_real(height) / 2.0 + (word.y - field_h / 2.0) * ppu
        edit penx = to_real(width) / 2.0 + (word.x - field_w / 2.0) * ppu
        if word.centered:
            penx = penx - line_width_px(word.content, word.titled, em_px, types) / 2.0
        out = blit_line(out, width, height, penx, top_px, word.content, word.titled, em_px, word.color, types)
    out

# ---- tests (`orbit test` runs these) ----

define test_polygon_fill_spans_fills_a_square():
    # A 10x10 design-unit square at scale 1 fills ~10 rows of one span each.
    px = part([0.0], 0, 0)
    sq_x = append(append(append(append(px, 0.0), 10.0), 10.0), 0.0)
    py = part([0.0], 0, 0)
    sq_y = append(append(append(append(py, 0.0), 0.0), 10.0), 10.0)
    spans = polygon_fill_spans(sq_x, sq_y, [3], 1.0)
    require length(spans) // 3 >= 9
    require spans[0] is 0
    require spans[1] is 10

# ---- loading from a file, and the rasterization memo ----------------------
# These moved here from atlas_text: a Font is not a game-engine concept, and
# a UI (veil) has to be able to measure text without linking a game engine.
# atlas_text keeps what is genuinely a renderer's job - coverage bitmaps and
# tessellated triangles.

public external define orion_persist_on() -> int
public external define orion_persist_off() -> int
public external define orion_arena_off() -> int
public external define orion_arena_on() -> int
public external define orion_arena_active() -> int

# Parse the sfnt table directory and the head/maxp headers. Returns a Font
# with ok=false when the file isn't a recognizable TrueType sfnt.
public define load_font(path: text) -> Font:
    b = bytes_of(file_read(path))
    n = bytes_count(b)
    if n < 12:
        return Font{bytes: b, upm: 0, nglyphs: 0, loc_fmt: 0, off_head: 0, off_maxp: 0, off_cmap: 0, off_loca: 0, off_glyf: 0, off_hhea: 0, off_hmtx: 0, off_gpos: 0, ok: false, cache: {}}
    ntables = be_u16(b, 4)
    edit head = 0
    edit maxp = 0
    edit cmap = 0
    edit loca = 0
    edit glyf = 0
    edit hhea = 0
    edit hmtx = 0
    edit gpos = 0
    loop i in 0 until ntables:
        rec = 12 + i * 16
        off = be_u32(b, rec + 8)
        if tag_is(b, rec, 104, 101, 97, 100):
            head = off
        if tag_is(b, rec, 109, 97, 120, 112):
            maxp = off
        if tag_is(b, rec, 99, 109, 97, 112):
            cmap = off
        if tag_is(b, rec, 108, 111, 99, 97):
            loca = off
        if tag_is(b, rec, 103, 108, 121, 102):
            glyf = off
        if tag_is(b, rec, 104, 104, 101, 97):
            hhea = off
        if tag_is(b, rec, 104, 109, 116, 120):
            hmtx = off
        # GPOS: where kerning lives in a modern font. Inter has no `kern`
        # table at all, only this.
        if tag_is(b, rec, 71, 80, 79, 83):
            gpos = off
    upm = if head > 0 then be_u16(b, head + 18) else 0
    loc_fmt = if head > 0 then be_i16(b, head + 50) else 0
    nglyphs = if maxp > 0 then be_u16(b, maxp + 4) else 0
    Font{bytes: b, upm: upm, nglyphs: nglyphs, loc_fmt: loc_fmt, off_head: head, off_maxp: maxp, off_cmap: cmap, off_loca: loca, off_glyf: glyf, off_hhea: hhea, off_hmtx: hmtx, off_gpos: gpos, ok: head > 0 and maxp > 0 and glyf > 0 and loca > 0, cache: {}}

# Cached scanline spans for glyph `gid` at integer pixel size `size`. The
# spans are identical every frame, so rasterize once (arena-scoped, cheap
# and thrown away) and keep a persist-scoped COPY in the font's cache; every
# later frame replays the copy — zero re-rasterization, no per-frame churn.
# Key packs (gid, size) into one int; size is assumed < 4096 (UI text).
# A private copy of a span list, so the cached entry does not alias frame
# memory that is about to be reclaimed.
define ints_copy(xs: [number]) -> [number]:
    n = length(xs)
    edit o = []
    loop i in 0 until n:
        o = append(o, xs[i])
    o

public define glyph_spans_cached(f: Font, gid: number, size: number) -> [number]:
    key = gid * 4096 + size
    if has(f.cache, key):
        return get_list(f.cache, key)
    scale = to_real(size) / to_real(f.upm)
    raw = glyph_fill_spans(f, gid, scale)
    # Copy + insert must outlive this frame, so they go to persist (malloc).
    # orion_alloc gives the arena PRIORITY over the persist scope, so a bare
    # persist_on is ignored while rendering — the copy would land in the
    # arena and be clobbered at the next reset. Suspend the arena for just
    # the copy+insert (raw stays valid; the arena is only paused, not reset),
    # then restore it. Only misses pay this — warm frames are pure replay.
    was_on = orion_arena_active()
    if was_on is 1:
        orion_arena_off()
    orion_persist_on()
    cached = ints_copy(raw)
    set(f.cache, key, cached)
    orion_persist_off()
    if was_on is 1:
        orion_arena_on()
    cached


# ---- GPOS kerning ---------------------------------------------------------
# A modern font puts kerning in GPOS, not in the old `kern` table - Inter has
# no `kern` table at all. So the pair adjustment has to be dug out of the
# feature machinery: find the `kern` feature, follow it to its lookups, and
# read the PairPos subtables those point at.
#
# Only what kerning needs is implemented. LookupType 2 (PairPos) in both
# formats - explicit pairs, and the class matrix a font uses for the bulk of
# them - plus LookupType 9 (Extension), which is just a 32-bit redirection
# to one of those. Everything else in GPOS is for marks and cursive joining
# and is not our business here.

# One value record is as many int16s as its format has bits set.
define value_size(fmt: number) -> number:
    edit n = 0
    edit bit = 1
    loop _i in 0 until 8:
        if fmt / bit % 2 is 1:
            n = n + 1
        bit = bit * 2
    n * 2

# X_ADVANCE is bit 2 (0x0004). Without it a pair record says nothing about
# how far the pen should move, which is the only thing we want.
define has_xadvance(fmt: number) -> truth = fmt / 4 % 2 is 1

# Where a glyph sits in a coverage table, or -1 for absent.
define coverage_index(b: [number], cov: number, gid: number) -> number:
    fmt = be_u16(b, cov)
    count = be_u16(b, cov + 2)
    if fmt is 1:
        edit found = 0 - 1
        loop i in 0 until count:
            if be_u16(b, cov + 4 + i * 2) is gid:
                found = i
        found
    else:
        edit found = 0 - 1
        loop i in 0 until count:
            rec = cov + 4 + i * 6
            start = be_u16(b, rec)
            end = be_u16(b, rec + 2)
            if gid >= start and gid <= end:
                found = be_u16(b, rec + 4) + (gid - start)
        found

# A glyph's class in a ClassDef. Class 0 is "everything not listed".
define class_of(b: [number], cd: number, gid: number) -> number:
    fmt = be_u16(b, cd)
    if fmt is 1:
        start = be_u16(b, cd + 2)
        count = be_u16(b, cd + 4)
        if gid >= start and gid < start + count then be_u16(b, cd + 6 + (gid - start) * 2) else 0
    else:
        count = be_u16(b, cd + 2)
        edit found = 0
        loop i in 0 until count:
            rec = cd + 4 + i * 6
            if gid >= be_u16(b, rec) and gid <= be_u16(b, rec + 2):
                found = be_u16(b, rec + 4)
        found

# The x-advance one PairPos subtable gives this pair, or 0.
define pair_adjust(b: [number], sub: number, left: number, right: number) -> number:
    fmt = be_u16(b, sub)
    cov = sub + be_u16(b, sub + 2)
    vf1 = be_u16(b, sub + 4)
    vf2 = be_u16(b, sub + 6)
    ci = coverage_index(b, cov, left)
    if ci < 0 or not has_xadvance(vf1):
        0
    else if fmt is 1:
        pair_adjust_1(b, sub, ci, right, value_size(vf1) + value_size(vf2))
    else if fmt is 2:
        pair_adjust_2(b, sub, left, right, value_size(vf1) + value_size(vf2))
    else:
        0

# Format 1: the left glyph owns a list of (right glyph, adjustment).
define pair_adjust_1(b: [number], sub: number, ci: number, right: number, rec_size: number) -> number:
    count = be_u16(b, sub + 8)
    if ci >= count:
        0
    else:
        set_at = sub + be_u16(b, sub + 10 + ci * 2)
        pairs = be_u16(b, set_at)
        edit found = 0
        loop i in 0 until pairs:
            rec = set_at + 2 + i * (2 + rec_size)
            if be_u16(b, rec) is right:
                found = be_i16(b, rec + 2)
        found

# Format 2: both glyphs are put in classes and the answer is a cell in the
# matrix. This is how a font expresses the thousands of pairs it would be
# absurd to list one at a time.
define pair_adjust_2(b: [number], sub: number, left: number, right: number, rec_size: number) -> number:
    cd1 = sub + be_u16(b, sub + 8)
    cd2 = sub + be_u16(b, sub + 10)
    n1 = be_u16(b, sub + 12)
    n2 = be_u16(b, sub + 14)
    c1 = class_of(b, cd1, left)
    c2 = class_of(b, cd2, right)
    if c1 >= n1 or c2 >= n2 or n2 is 0:
        0
    else:
        be_i16(b, sub + 16 + (c1 * n2 + c2) * rec_size)

# Walk one lookup's subtables. Type 9 is a redirection: read the real type
# and a 32-bit offset, then treat it as that type.
define lookup_adjust(b: [number], lookup: number, left: number, right: number) -> number:
    kind = be_u16(b, lookup)
    subs = be_u16(b, lookup + 4)
    edit found = 0
    loop i in 0 until subs:
        sub = lookup + be_u16(b, lookup + 6 + i * 2)
        got = sub_adjust(b, kind, sub, left, right)
        if found is 0:
            found = got
    found

# One subtable. Early returns rather than an if-expression: both arms of an
# `if` are evaluated before one is chosen, and following an extension offset
# that does not exist would read past the font.
define sub_adjust(b: [number], kind: number, sub: number, left: number, right: number) -> number:
    if kind is 2:
        return pair_adjust(b, sub, left, right)
    if kind is 9 and be_u16(b, sub) is 1 and be_u16(b, sub + 2) is 2:
        return pair_adjust(b, sub + be_u32(b, sub + 4), left, right)
    0

# How much closer (or further) the pen should sit for this pair, in font
# units. 0 when the font says nothing, which is the common case.
public define kern_pair(f: Font, left: number, right: number) -> number:
    b = f.bytes
    g = f.off_gpos
    if g is 0 or left is 0 or right is 0:
        return 0
    feature_list = g + be_u16(b, g + 6)
    lookup_list = g + be_u16(b, g + 8)
    nfeat = be_u16(b, feature_list)
    edit total = 0
    loop i in 0 until nfeat:
        rec = feature_list + 2 + i * 6
        # 'kern'
        if tag_is(b, rec, 107, 101, 114, 110) and total is 0:
            feat = feature_list + be_u16(b, rec + 4)
            nlook = be_u16(b, feat + 2)
            loop j in 0 until nlook:
                if total is 0:
                    idx = be_u16(b, feat + 4 + j * 2)
                    lookup = lookup_list + be_u16(b, lookup_list + 2 + idx * 2)
                    total = lookup_adjust(b, lookup, left, right)
    total

# kern_pair walks the feature list and scans coverage tables, which is far
# too much to redo for every pair of every string every frame. The answer
# for a pair never changes, so remember it. The key is disjoint from the
# glyph-span keys above.
public define kern_cached(f: Font, left: number, right: number) -> number:
    key = 2199023255552 + left * 65536 + right
    if has(f.cache, key):
        return get_list(f.cache, key)[0]
    v = kern_pair(f, left, right)
    was_on = orion_arena_active()
    if was_on is 1:
        orion_arena_off()
    orion_persist_on()
    edit one = []
    one = append(one, v)
    set(f.cache, key, one)
    orion_persist_off()
    if was_on is 1:
        orion_arena_on()
    v
