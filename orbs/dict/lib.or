# dict - friendly names for the map built-ins a newcomer reaches for.
#
#   keys(m)  length(m)  has_key(m, "a")  values(m)
#
# `has` and `get_or` are already built in. See README.md.

public define keys(m: table) -> [text]:
    example length(keys({"a": 1, "b": 2})) is 2
    map_keys(m)


# 1 if `k` is present, else 0.
public define has_key(m: table, k: text) -> truth:
    example has_key({"a": 1}, "a")
    example not has_key({"a": 1}, "z")
    has(m, k)

# The values of an int-valued map, in key order.
public define values(m: table) -> [number]:
    example values({"a": 7})[0] is 7
    map_values(m)
