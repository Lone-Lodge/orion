# result — Result<T>: a value, or an error message.
#
# A native generic sum type. The point is that you cannot look at the value
# without saying what happens in the error case: `match` is exhaustive, so the
# compiler makes you follow up.
#
#   use result
#
#   fn safe_div(a: int, b: int) -> Result<int>:
#       if b == 0 then Result.Err("divide by zero") else Result.Ok(a / b)
#
#   match safe_div(10, 0):
#       Ok(v)  -> print_line("got {v}")
#       Err(m) -> print_line("error: {m}")
#
# Softer forms when you do not want to branch by hand:
#   n = unwrap_or(safe_div(10, 0), 0 - 1)   # fallback value
#   if let Ok(v) = safe_div(10, 2):         # only the happy path
#       print_line("{v}")
#
# `?` propagates: `v = safe_div(a, b)?` returns the Err out of the enclosing
# function and binds `v` to the Ok payload otherwise.
#
# There is deliberately no `unwrap`. Orion has no panic, so an `unwrap` here
# could only lie and hand back a zero. Use `match`, `if let`, `?` or
# `unwrap_or`.

pub type Result<T>:
    Ok(T)
    Err(Text)

# The payload, or `default` if this is an Err.
pub fn unwrap_or<T>(r: Result<T>, default: T) -> T:
    match r:
        Ok(v) -> v
        Err(m) -> default

# 1 if this is an Ok, else 0.
pub fn is_ok<T>(r: Result<T>) -> int:
    match r:
        Ok(v) -> 1
        Err(m) -> 0

# 1 if this is an Err, else 0.
pub fn is_err<T>(r: Result<T>) -> int:
    match r:
        Ok(v) -> 0
        Err(m) -> 1

# The error message, or "" if this is an Ok.
pub fn err_msg<T>(r: Result<T>) -> Text:
    match r:
        Ok(v) -> ""
        Err(m) -> m
