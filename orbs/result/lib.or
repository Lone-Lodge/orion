# result - Result<T>: a value, or an error message. A native generic sum type.
#
#   choose safe_div(10, 0):
#       Ok(v) then print_line("got {v}")
#       Err(m) then print_line("error: {m}")
#
# `choose` is exhaustive, so the error case cannot be skipped. Softer:
# `unwrap_or`, `if let Ok(v) = ...`, and `?` to propagate. No `unwrap`: with no
# panic it could only lie and hand back a zero. See README.md.

# The payload, or `default` if this is an Err.
public define unwrap_or<T>(r: Result<T>, default: T) -> T:
    example unwrap_or(Result.Ok(7), 0) is 7
    example unwrap_or(Result.Err("x"), 9) is 9
    choose r:
        Ok(v) then v
        Err(m) then default

# 1 if this is an Ok, else 0.
public define is_ok<T>(r: Result<T>) -> truth:
    example is_ok(Result.Ok(5))
    example not is_ok(Result.Err("no"))
    choose r:
        Ok(v) then true
        Err(m) then false

# true if this is an Err.
public define is_err<T>(r: Result<T>) -> truth:
    example is_err(Result.Err("boom"))
    choose r:
        Ok(v) then false
        Err(m) then true

# The error message, or "" if this is an Ok.
public define err_msg<T>(r: Result<T>) -> text:
    example err_msg(Result.Err("boom")) is "boom"
    choose r:
        Ok(v) then ""
        Err(m) then m
