# ori_geometry - the ORI (Orion Rendering Interface) 2D primitives.
#
# The neutral render-contract geometry: Point, Size, Rect. Lives in orion (the
# shared base both atlas and veil already depend on) so the render contract is
# not owned by any one UI block. `DrawCmd` (ori_display) is built on these.

public type Point: x: int, y: int
public type Size: width: int, height: int
public type Rect: x: int, y: int, width: int, height: int

public define rect_contains(rect: Rect, point: Point) -> truth:
    example rect_contains(Rect{x: 0, y: 0, width: 4, height: 4}, Point{x: 1, y: 1})
    example not rect_contains(Rect{x: 0, y: 0, width: 4, height: 4}, Point{x: 9, y: 1})
    point.x >= rect.x and point.x < rect.x + rect.width and point.y >= rect.y and point.y < rect.y + rect.height
