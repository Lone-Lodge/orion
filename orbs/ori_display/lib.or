# ori_display - the ORI (Orion Rendering Interface) display list.
#
# The universal 2D render seam every backend (native gpu via `ori`, web via
# `veil_web`, …) consumes. One enum: each variant is one drawing primitive.
# Neutral home in orion so the render contract is not owned by any one UI block.
#
# Colours are CSS-style strings ("#1d1433", "rgba(46,125,224,0.35)") - each
# backend parses its own. Text/icon carry a pixel size.
# EVERY variant ends in a trailing PROVENANCE tag (its final i64): the entity
# (or rule) id that produced the command, 0 = untagged. This is what makes the
# display list ADDRESSABLE - an edit-mode hit-tests a pixel, reads the tag, and
# knows which spawn line in which script to rewrite.


public type DrawCmd:
    # These payloads are `i64`, not `number`. A `choose` arm hands back a bare
    # payload with no conversion on the way out, so one enum gets ONE answer:
    # a single fraction anywhere would widen every coordinate in the draw list
    # to f64. They are pixel counts and entity ids, and a sized type says that
    # without saying whole-or-real.
    DrawRect(Rect, text, i64)
    # Filled rounded rectangle: rect, colour, corner radius (px), src eid.
    # Backends fill it as horizontal og_rect spans with circular corner
    # insets - the chrome primitive for hover cells, chips, and cards.
    # rect, colour, corner radii "8" or "8 8 0 0" (top-left, top-right,
    # bottom-right, bottom-left), src eid. Four, because a tab is round on
    # top and square on the bottom and so is every joined button group.
    DrawRoundRect(Rect, text, text, i64)
    # A soft drop shadow: rect, colour, corner radius, blur in px, src eid.
    # Same shape as a DrawRoundRect, drawn with the distance ramp spread
    # over `blur` pixels instead of one. Backends that cannot soften an
    # edge skip it - a hard block where a shadow belongs is worse than
    # nothing.
    # Clip everything after this to `rect`, until the next SetClip. A rect
    # with no area clears it. A UI needs this the moment anything can be
    # longer than the box it sits in - a list, a line of typing - because
    # the alternative is content shoving its neighbours out of the way.
    # rect, corner radius, src eid. The radius matters: a scissor is a
    # rectangle and always will be, so a list inside a rounded panel would
    # square off at the corners without it - which is the one place every
    # card and every avatar shows it.
    SetClip(Rect, i64, i64)
    DrawShadow(Rect, text, i64, i64, i64)
    DrawText(Point, text, text, i64, i64)
    # The same, in the fixed-width face. A run of code, a column of
    # numbers: the difference is not styling, it is WHICH FACE the run was
    # measured in - and measure and paint have to agree or the caret sits
    # a letter from the letter. Backends without a mono face draw it as
    # DrawText, which looks wrong but never lies about position.
    DrawMono(Point, text, text, i64, i64)
    # point, icon name, pixel size, src eid.
    # point, icon name, size, colour, src eid. An icon that cannot take a
    # colour is an icon that can only ever mean one thing: a file tree
    # tells you what a file IS by the colour of its mark, and every editor
    # in the world does it that way.
    DrawIcon(Point, text, i64, text, i64)
    # path data, colour, src eid.
    DrawPath(text, text, i64)
    # A ring, or a slice of one: centre, outer radius, how thick, and the
    # span in degrees measured from the top going clockwise. The one shape
    # a rectangle cannot approximate, and the one every cooldown sweep and
    # radial meter is made of.
    DrawArc(Point, i64, i64, i64, i64, text, i64)
    # A pixel-art sprite: top-left Point, image path, integer scale, src
    # eid. The rect-only backends blit it as og_rect runs (see
    # atlas_sprite); no GPU texture needed.
    # A panel skinned from a picture: box, picture, corner size in the
    # PICTURE's own pixels, tint, blend, src eid. The corners keep their
    # size, the edges stretch along their run, the middle stretches both
    # ways. Every game frame that is not flat colour is one of these.
    DrawNine(Rect, text, i64, text, text, i64)
    DrawSprite(Point, text, i64, i64)
    # A textured image quad (the modern path): top-left Point, image path,
    # dest width, dest height, tint ("#rrggbb"/"#rrggbbaa" or a named colour;
    # ""=none), blend ("alpha" default, "add" for glow), src eid. Drawn as
    # ONE GPU-sampled quad - any size, scaled, blended. The renderer resolves
    # the tint/blend strings (same palette as DrawText/DrawRect colours).
    DrawImage(Point, text, i64, i64, text, text, i64)

public type DisplayList: commands: [DrawCmd]

public define empty_list() -> DisplayList:
    example length(empty_list().commands) is 0
    DisplayList{commands: []}

public define push_cmd(list: DisplayList, cmd: DrawCmd) -> DisplayList:
    # no example: needs a DrawCmd value - proven by atlas display tests
    DisplayList{commands: append(list.commands, cmd)}
