# compress - LZ77 over a 64 KB window.
#
# Not zlib, and not compatible with it. A store that writes and reads its
# own bytes needs no interchange format, and the whole of DEFLATE - Huffman
# tables, dynamic blocks, the lot - is most of the code for the last third
# of the ratio.
#
# THE FORMAT, whole:
#
#   token < 128     a run of (token + 1) literal bytes follows
#   token >= 128    a match: length = (token - 128) + 4, then two bytes of
#                   distance, high byte first
#
# So a match costs three bytes and reaches 4..131 bytes back up to 65535.
# A literal run costs one byte per 128.
#
# The matcher keeps ONE position per three-byte hash - the most recent -
# and no chain. That is the trade: a chain finds longer matches and costs a
# search per byte. Greedy and shallow is what a store wants, because it
# compresses once and reads many times.

use text

define win() -> number = 65535
define min_match() -> number = 4
define max_match() -> number = 131
define tab_bits() -> number = 65536

define hash3(b: [number], i: number) -> number:
    ((byte_at(b, i) * 506832829) + (byte_at(b, i + 1) * 16777619) + byte_at(b, i + 2)) % tab_bits()

# How many bytes match, from `a` and `c`, at most `cap`.
define run_len(b: [number], a: number, c: number, n: number, cap: number) -> number:
    edit k = 0
    loop:
        if k >= cap or c + k >= n:
            break
        if byte_at(b, a + k) is not byte_at(b, c + k):
            break
        k = k + 1
    k

public define squeeze(t: text) -> text:
    example unsqueeze(squeeze("abcabcabcabcabcabc")) is "abcabcabcabcabcabc"
    example unsqueeze(squeeze("")) is ""
    b = bytes_of(t)
    n = bytes_count(b)
    # For kort for att kunna innehalla en match: da byggs ingen tabell och
    # allt gar ut som literaler.
    stor = n >= min_match() + 2
    edit tab = []
    if stor:
        loop x in 0 until tab_bits():
            tab = append(tab, 0 - 1)
    # ALLT skrivs i den har slingan, och utlistan skickas aldrig till en
    # hjalpare. En parameter hade gjort listan levande under tva namn, och
    # da kopierar varje append hela den: forsta versionen la ut literaler
    # genom en hjalpare och tog 1218 ms pa 47 KB.
    edit ut = []
    edit i = 0
    edit lit = 0
    loop:
        edit langd = 0
        edit cand = 0 - 1
        if stor and i + 2 < n:
            h = hash3(b, i)
            cand = tab[h]
            tab = set(tab, h, i)
            if cand >= 0 and i - cand <= win():
                langd = run_len(b, cand, i, n, max_match())
        # Ingen traff, eller slut pa indata: bara ga vidare. Literalerna
        # laggs ut nar en match kommer eller nar allt ar slut.
        if langd < min_match():
            if i >= n:
                break
            i = i + 1
        else:
            edit at = lit
            loop:
                if at >= i:
                    break
                k = if i - at > 128 then 128 else i - at
                ut = append(ut, k - 1)
                loop j in 0 until k:
                    ut = append(ut, byte_at(b, at + j))
                at = at + k
            avst = i - cand
            ut = append(ut, 128 + (langd - min_match()))
            ut = append(ut, avst // 256)
            ut = append(ut, avst % 256)
            # Positionerna INNE i matchen laggs ocksa in i tabellen. Utan
            # det ar allt som tacks av en match osynligt for senare
            # matchningar, och langa upprepningar goms bakom varandra.
            edit q = i + 1
            loop:
                if q >= i + langd or q + 2 >= n:
                    break
                tab = set(tab, hash3(b, q), q)
                q = q + 1
            i = i + langd
            lit = i
    edit at2 = lit
    loop:
        if at2 >= n:
            break
        k = if n - at2 > 128 then 128 else n - at2
        ut = append(ut, k - 1)
        loop j in 0 until k:
            ut = append(ut, byte_at(b, at2 + j))
        at2 = at2 + k
    text_of(ut)

# `unsqueeze` och inte `expand`: raster exporterar redan ett `expand`, och
# tva orbar med samma namn ar ett fel som forst dyker upp den dag nagon
# importerar bada.
public define unsqueeze(t: text) -> text:
    example unsqueeze(squeeze("hej hej hej hej hej")) is "hej hej hej hej hej"
    b = bytes_of(t)
    n = bytes_count(b)
    edit ut = []
    edit i = 0
    loop:
        if i >= n:
            break
        tok = byte_at(b, i)
        if tok < 128:
            k = tok + 1
            loop j in 0 until k:
                ut = append(ut, byte_at(b, i + 1 + j))
            i = i + 1 + k
        else:
            langd = tok - 128 + min_match()
            avst = byte_at(b, i + 1) * 256 + byte_at(b, i + 2)
            start = bytes_count(ut) - avst
            # Kopieras ETT tecken i taget med flit: en match far peka in i
            # det den sjalv skriver, och det ar sa en upprepning kodas.
            loop j in 0 until langd:
                ut = append(ut, ut[start + j])
            i = i + 3
    text_of(ut)
