# store - program state shaped like a database: flat records, stable ids.
#
#   w1, id = insert(w0, {"hp": 10})
#   hurt = loop e in items(w) where get_int(e, "hp") < 10: collect e
#
# The `loop ... where` IS the query; the storage layout is the compiler's
# business, never the code's. See README.md.

type sstore: seq: number, cells: table<table>

public define store_new() -> sstore:
    example length(items(store_new())) is 0
    example store_new().seq is 0
    sstore{seq: 0, cells: {}}

# Add a record; returns (new store, its id). Ids are never reused.
public define insert(s: sstore, cell: table) -> (sstore, number):
    example length(items(store_new())) is 0
    id = s.seq
    (sstore{seq: id + 1, cells: set(s.cells, "{id}", cell)}, id)

public define remove(s: sstore, id: number) -> sstore:
    example length(items(remove(store_new(), 0))) is 0
    sstore{seq: s.seq, cells: map_remove(s.cells, "{id}")}

# The record for `id`, or {} when it was never inserted / was removed.
public define entity(s: sstore, id: number) -> table:
    example not has_id(store_new(), 9)
    get(s.cells, "{id}")

public define has_id(s: sstore, id: number) -> truth:
    example not has_id(store_new(), 0)
    has(s.cells, "{id}")

# Every live record - the iteration/query source.
public define items(s: sstore) -> [table]:
    example length(items(store_new())) is 0
    ks = map_keys(s.cells)
    edit out = []
    loop i in 0 until length(ks):
        out = append(out, get(s.cells, ks[i]))
    out
