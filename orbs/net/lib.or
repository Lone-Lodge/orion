# net - blocking TCP, client and server. `uses net` in a signature tells you
# what a function may reach without opening its body.
#
#   c = connect("127.0.0.1", 8080)   send(c, ...)   recv(c, 4096)   close(c)
#   s = listen(8080)                 accept(s)      recv is "" at end of stream
#
# Handles are plain numbers: >= 0 is a socket, -1 is every failure.
# LIFETIME: pair `close` with `defer` so an early return cannot leak it.
# See README.md.

external define tcp_listen(port: int) -> int
external define tcp_accept(listener: int) -> int
external define tcp_connect(host: text, port: int) -> int
external define tcp_send(conn: int, data: text) -> int
external define tcp_recv(conn: int, maxlen: int) -> text
external define tcp_close(handle: int) -> int
external define tcp_set_timeout(sock: int, ms: int) -> int
external define tcp_accept_wait(listener: int, ms: int) -> int
external define tcp_connect_wait(host: text, port: int, ms: int) -> int
external define sock_wait_ready(sock: int, ms: int, want_write: int) -> int

# --- client ---
public define connect(host: text, port: number) -> number uses net:
    example not ok(connect("127.0.0.1", 1))
    tcp_connect(host, port)
# no example: needs a live peer - proven by test_42_net_loopback.or
public define send(sock: number, data: text) -> number uses net = tcp_send(sock, data)
# no example: needs a live peer - proven by test_42_net_timeout.or
public define recv(sock: number, maxlen: number) -> text uses net = tcp_recv(sock, maxlen)
public define close(sock: number) -> number uses net:
    example close(0 - 1) is 0
    tcp_close(sock)

# --- server ---
# Open a listening socket on `port` (loopback). -1 if the port is taken.
public define listen(port: number) -> number uses net:
    example close(listen(58499)) is 0
    tcp_listen(port)
# no example: blocks for a client - proven by test_42_net_loopback.or
public define accept(server: number) -> number uses net = tcp_accept(server)

# --- lifetime-safe forms ---
# The socket you cannot forget to close: the ORB owns the handle, runs your
# body with it, and closes on the way out (including when the body returns
# early - the close is a `defer`). This is the library-level shape of the
# scope-owned resource model (Tema 10); when the language gains handler-owned
# resources these become that, with the same call sites.
#
#   answer = with_connection("127.0.0.1", 8080, (c): send(c, "hi"))
# The body gets the socket and returns a number; -1 means the connect failed.
# no example: needs a live peer - proven by examples/demos/httpd.or
public define with_connection(host: text, port: number, body: function) -> number uses net:
    c = connect(host, port)
    if not ok(c):
        return 0 - 1
    defer close(c)
    body(c)

# The same for a listening socket: serve, hand the listener to the body, and
# close it however the body leaves.
# no example: binds a port - proven by test_42_net_scoped.or
public define with_listener(port: number, body: function) -> number uses net:
    s = listen(port)
    if not ok(s):
        return 0 - 1
    defer close(s)
    body(s)

# Give up after `ms` milliseconds instead of blocking forever: `accept`
# then returns -1 and `recv` returns "" when the deadline passes. 0 restores
# blocking. Set it on a LISTENER before accept, or on a connection before
# recv - a server that cannot time out cannot do anything else.
# no example: needs a live socket - proven by test_42_net_timeout.or
public define set_timeout(sock: number, ms: number) -> number uses net = tcp_set_timeout(sock, ms)

# Wait up to `ms` for a client; -1 when nobody came. This is the one a
# server loop wants: it can time out, do other work, and come back.
# no example: needs a listener + timing - proven by test_42_net_timeout.or
public define accept_within(listener: number, ms: number) -> number uses net = tcp_accept_wait(listener, ms)

# Connect, but give up after `ms` instead of blocking. Plain `connect` is the
# one socket call that cannot time out, and a blocked connect parks the whole
# PROCESS - so inside a task it freezes every other task too. That is not
# theoretical: ten clients against a server whose listen backlog was full
# deadlocked, because the connect that had to wait was holding the scheduler
# the acceptor needed. Inside a task, use this and `sleep_task` between tries.
public define connect_within(host: text, port: number, ms: number) -> number uses net:
    example not ok(connect_within("127.0.0.1", 1, 50))
    tcp_connect_wait(host, port, ms)

# Has `sock` got anything to read? Waits up to `ms` for it.
#
# This is the call that makes a task-per-connection server scale. Without it
# the only way to wait is `recv` with a short timeout, retried - and every
# attempt parks the whole PROCESS, so a round costs (waiting tasks x timeout).
# Here the task parks and the SCHEDULER waits for every parked socket in one
# select, so a round costs one wait however many tasks are in it. Outside a
# task it is an ordinary wait, so the same call is right in both places.
# no example: needs a live socket - proven by test_42_net_concurrent.or
public define readable_within(sock: number, ms: number) -> truth uses net:
    sock_wait_ready(sock, ms, 0) is 1

# Did a read time out (or the peer close)? Both surface as "".
public define timed_out(chunk: text) -> truth:
    example timed_out("")
    example not timed_out("data")
    length(chunk) is 0

# Did the call succeed? Reads better than comparing to -1 at every site.
public define ok(handle: number) -> truth:
    example ok(0 - 1) is false
    example ok(3)
    handle >= 0

# ---- UDP: the datagram floor a game's netcode stands on ----
# Connectionless: one socket per side, no accept. A UDP socket is a socket -
# `readable_within` parks a task on it exactly like TCP, and `local_port`
# reads the ephemeral port `udp_open(0)` picked.
external define udp_open(port: int) -> int
external define udp_send_to(sock: int, host: text, port: int, data: text) -> int
external define udp_recv_from(sock: int, maxlen: int) -> text
external define udp_last_sender() -> text

# A bound UDP socket, or -1. Port 0 picks an ephemeral one.
# no example: opens a socket - proven by test_42_udp_loopback.or
public define udp(port: number) -> number uses net = udp_open(port)

# Send one datagram to host:port. Bytes sent, or -1.
# no example: sends on the network - proven by test_42_udp_loopback.or
public define udp_send(sock: number, host: text, port: number, data: text) -> number uses net = udp_send_to(sock, host, port, data)

# One datagram as text ("" when nothing). Pair with readable_within for a
# deadline; ask udp_sender() right after for who sent it.
# no example: reads the network - proven by test_42_udp_loopback.or
public define udp_receive(sock: number, maxlen: number) -> text uses net = udp_recv_from(sock, maxlen)

# "ip:port" of the last datagram udp_receive returned, "" before any.
# no example: network state - proven by test_42_udp_loopback.or
public define udp_sender() -> text uses net = udp_last_sender()

external define sock_local_port(sock: int) -> int

# The port a socket actually bound to - what `listen(0)`/`udp(0)` picked.
# no example: opens a socket - proven by test_42_udp_loopback.or
public define local_port(sock: number) -> number uses net = sock_local_port(sock)

external define tcp_send_len(sock: int, data: text) -> int

# Binary-safe send: the byte count comes from the text's length header, not
# a null scan - a JPEG survives intact. What a file server answers with.
# no example: sends on a socket - proven by folio (the image viewer)
public define send_raw(sock: number, data: text) -> number uses net = tcp_send_len(sock, data)
