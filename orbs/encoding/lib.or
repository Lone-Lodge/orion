# encoding - hex and base64, both directions.
#
#   hex_encode([255, 16])  ->  "ff10"        hex_decode("ff10")
#   base64_encode(bytes)                     base64_decode("...")
#
# "bytes" is just a [int] of 0..255 - what bytes_from_text gives and
# bytes_to_text takes. No separate byte type. See README.md.

define hex_val(c: number) -> number:
    if c >= 48 and c <= 57 then c - 48                    # '0'..'9'
    else if c >= 97 and c <= 102 then c - 97 + 10         # 'a'..'f'
    else if c >= 65 and c <= 70 then c - 65 + 10          # 'A'..'F'
    else 0 - 1

# bytes -> lowercase hex text.
public define hex_encode(data: [number]) -> text:
    example hex_encode([255, 16]) is "ff10"
    example hex_encode([]) is ""
    hex = bytes_of("0123456789abcdef")
    edit out = []
    loop i in 0 until length(data):
        b = data[i]
        out = append(out, hex[(b >> 4) & 15])
        out = append(out, hex[b & 15])
    text_of(out)

# hex text -> bytes. Non-hex characters are skipped; a trailing half-byte is
# dropped.
public define hex_decode(s: text) -> [number]:
    example hex_decode("ff10")[0] is 255
    b = bytes_of(s)
    n = bytes_count(b)
    edit out = []
    edit hi = 0 - 1
    loop i in 0 until n:
        v = hex_val(byte_at(b, i))
        if v >= 0:
            if hi < 0:
                hi = v
            else:
                out = append(out, (hi << 4) | v)
                hi = 0 - 1
    out

# The base64 value of a byte, or -1 for padding / anything else (so newlines
# and '=' are skipped on decode).
define b64_val(c: number) -> number:
    if c >= 65 and c <= 90 then c - 65                    # 'A'..'Z' -> 0..25
    else if c >= 97 and c <= 122 then c - 97 + 26         # 'a'..'z' -> 26..51
    else if c >= 48 and c <= 57 then c - 48 + 52          # '0'..'9' -> 52..61
    else if c is 43 then 62                               # '+'
    else if c is 47 then 63                               # '/'
    else 0 - 1

# bytes -> base64 text (standard alphabet, '=' padded).
public define base64_encode(data: [number]) -> text:
    example base64_encode([77, 97, 110]) is "TWFu"
    example base64_encode([]) is ""
    alpha = bytes_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    n = length(data)
    edit out = []
    edit i = 0
    loop:
        if i >= n: break
        has1 = i + 1 < n
        has2 = i + 2 < n
        b0 = data[i]
        b1 = if has1 then data[i + 1] else 0
        b2 = if has2 then data[i + 2] else 0
        out = append(out, alpha[(b0 >> 2) & 63])
        out = append(out, alpha[((b0 << 4) | (b1 >> 4)) & 63])
        out = append(out, if has1 then alpha[((b1 << 2) | (b2 >> 6)) & 63] else 61)   # '='
        out = append(out, if has2 then alpha[b2 & 63] else 61)
        i = i + 3
    text_of(out)

# base64 text -> bytes. Padding, newlines and stray characters are ignored.
public define base64_decode(s: text) -> [number]:
    example base64_decode("TWFu")[0] is 77
    b = bytes_of(s)
    n = bytes_count(b)
    edit out = []
    edit acc = 0
    edit bits = 0
    loop i in 0 until n:
        v = b64_val(byte_at(b, i))
        if v >= 0:
            acc = (acc << 6) | v
            bits = bits + 6
            if bits >= 8:
                bits = bits - 8
                out = append(out, (acc >> bits) & 255)
    out

external define sha256_hex(t: text) -> text

# SHA-256 of `t`, as 64 hex characters. The stdlib's content hash:
# checksums, cache keys, integrity. The first two examples are FIPS 180-4
# vectors. The third is BINARY: text carries its own length, so a NUL byte
# is data like any other and must not end the hash (it did once - sha256_hex
# read strlen instead of the text's length, so every PNG hashed as its first
# eight bytes).
public define sha256(t: text) -> text:
    example sha256("") is "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    example sha256("abc") is "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    example sha256(text_of([65, 0, 66])) is "76fe3925c7167317f2df68454339f5ec3650e4062178b4f2be219b105a507907"
    sha256_hex(t)
