# orion_emit_wasm - emit a WebAssembly module (.wasm binary). Pure Orion writes
# the bytes: no external linker, no wasm-bindgen, no wasm-pack.
#
#   "\0asm" + version, then sections Type(1) Func(3) Memory(5) Export(7)
#   Code(10). Spec: https://webassembly.github.io/spec/core/binary/index.html
#
# Scope today: int-to-int functions with arithmetic, locals, calls, return.
# See README.md.

# --- LEB128 encoders ---

# Unsigned LEB128 - the variable-length integer wasm uses for sizes
# and indices. Encodes one 7-bit chunk per byte, MSB = continuation.
public define leb_u(value: number) -> [number]:
    edit remaining = value
    edit output = []
    edit keep = true
    loop:
        if not keep:
            break
        byte_chunk = remaining - (remaining // 128) * 128
        remaining = remaining // 128
        if remaining is 0:
            output = append(output, byte_chunk)
            keep = false
        else:
            output = append(output, byte_chunk + 128)
    output

# Signed LEB128 - i32.const operand and friends.
public define leb_s(value: number) -> [number]:
    edit remaining = value
    edit output = []
    edit keep = true
    loop:
        if not keep:
            break
        # The low 7 bits, and an ARITHMETIC right shift for the rest. Plain
        # `remaining - (remaining/128)*128` broke for negatives: integer division
        # truncates toward zero, so -1/128 is 0 and the chunk came out -1 (a 0xff
        # byte) instead of 0x7f, which set a stray continuation bit and swallowed
        # the following opcode.
        byte_chunk = remaining & 127
        remaining = remaining >> 7
        # bit 6 of byte_chunk = `byte_chunk >= 64`. That bit is the
        # signed-LEB sign indicator: when the last byte's bit-6 set
        # state matches the value's sign, encoding stops; otherwise
        # we emit one more byte (0x00 for positive, 0x7F for negative)
        # so the reader gets the sign right.
        sign_bit_set = byte_chunk >= 64
        done_positive = remaining is 0 and not sign_bit_set
        done_negative = remaining is -1 and sign_bit_set
        if done_positive or done_negative:
            output = append(output, byte_chunk)
            keep = false
        else:
            output = append(output, byte_chunk + 128)
    output

# --- low-level byte helpers ---

# Concatenate a list of byte lists into one. The WASM encoder needs
# this because sections are built piecewise then prefixed with their
# total byte length.
public define concat_all(parts: [number]) -> [number]:
    edit output = []
    loop part_byte in parts:
        output = append(output, part_byte)
    output

# Encode a UTF-8 string with a LEB128 length prefix - the WASM "name"
# vector format for imports/exports.
public define encode_name(name: text) -> [number]:
    name_bytes = bytes_of(name)
    name_length = bytes_count(name_bytes)
    length_prefix = leb_u(name_length)
    edit output = []
    loop byte_value in length_prefix:
        output = append(output, byte_value)
    loop byte_value in name_bytes:
        output = append(output, byte_value)
    output

# A section is: id (1 byte) + size (LEB128) + contents. The encoder
# pre-builds the contents to know the size.
public define wrap_section(section_id: number, contents: [number]) -> [number]:
    content_length = list_length(contents)
    size_bytes = leb_u(content_length)
    edit output = append([], section_id)
    loop size_byte in size_bytes:
        output = append(output, size_byte)
    loop content_byte in contents:
        output = append(output, content_byte)
    output

define list_length(items: [number]) -> number:
    edit count = 0
    loop _item in items:
        count = count + 1
    count

# --- WASM opcodes (subset we emit today) ---

public define op_end() -> number: 11          # 0x0B end
public define op_return() -> number: 15       # 0x0F return
public define op_drop() -> number: 26         # 0x1A drop (discard the top stack value)
public define op_unreachable() -> number: 0   # 0x00 unreachable (trap)
public define op_call() -> number: 16         # 0x10 call funcidx
public define op_call_indirect() -> number: 17 # 0x11 call_indirect (typeidx, tableidx)
public define op_local_get() -> number: 32    # 0x20 local.get
public define op_local_set() -> number: 33    # 0x21 local.set
public define op_local_tee() -> number: 34    # 0x22 local.tee (set + leave on stack)
public define op_i32_const() -> number: 65    # 0x41 i32.const
public define op_i32_eqz() -> number: 69      # 0x45 i32.eqz
public define op_i32_eq() -> number: 70       # 0x46 i32.eq
public define op_i32_ne() -> number: 71       # 0x47 i32.ne
public define op_i32_lt_s() -> number: 72     # 0x48 i32.lt_s
public define op_i32_gt_s() -> number: 74     # 0x4A i32.gt_s
public define op_i32_le_s() -> number: 76     # 0x4C i32.le_s
public define op_i32_ge_s() -> number: 78     # 0x4E i32.ge_s
public define op_i32_ge_u() -> number: 79     # 0x4F i32.ge_u (unsigned: catches idx<0 too)
public define op_i32_add() -> number: 106     # 0x6A i32.add
public define op_i32_sub() -> number: 107     # 0x6B i32.sub
public define op_i32_mul() -> number: 108     # 0x6C i32.mul
public define op_i32_div_s() -> number: 109   # 0x6D i32.div_s
public define op_i32_rem_s() -> number: 111    # 0x6F i32.rem_s
public define op_i32_and() -> number: 113      # 0x71 i32.and
public define op_i32_or() -> number: 114       # 0x72 i32.or
public define op_i32_xor() -> number: 115      # 0x73 i32.xor
public define op_i32_shl() -> number: 116      # 0x74 i32.shl
public define op_i32_shr_s() -> number: 117    # 0x75 i32.shr_s
public define op_i32_shr_u() -> number: 118    # 0x76 i32.shr_u
# Unsigned i32 ops + narrow sign-extension, for u8/u16/u32 and i8/i16.
public define op_i32_div_u() -> number: 110    # 0x6E i32.div_u
public define op_i32_rem_u() -> number: 112    # 0x70 i32.rem_u
public define op_i32_lt_u() -> number: 73      # 0x49 i32.lt_u
public define op_i32_gt_u() -> number: 75      # 0x4B i32.gt_u
public define op_i32_le_u() -> number: 77      # 0x4D i32.le_u
public define op_i32_extend8_s() -> number: 192   # 0xC0 i32.extend8_s
public define op_i32_extend16_s() -> number: 193  # 0xC1 i32.extend16_s

# Control flow.
public define op_block() -> number: 2         # 0x02 block (then blocktype)
public define op_loop() -> number: 3          # 0x03 loop
public define op_if() -> number: 4            # 0x04 if (then blocktype)
public define op_else() -> number: 5          # 0x05 else
public define op_br() -> number: 12           # 0x0C br
public define op_br_if() -> number: 13        # 0x0D br_if (branch when top of stack is not 0)

# Blocktype sentinel - "no result". Used after `if`/`block`/`loop`
# when the body doesn't push anything to the stack.
public define blocktype_void() -> number: 64  # 0x40

# Linear memory ops - the byte-level loads/stores wasm uses to read
# and write the module's heap. Used to pass strings (and any other
# composite data) between the wasm code and the JS host.
public define op_i32_load() -> number: 40     # 0x28 i32.load
public define op_i32_load8_u() -> number: 45  # 0x2D i32.load8_u
public define op_i32_store() -> number: 54    # 0x36 i32.store
public define op_i32_store8() -> number: 58   # 0x3A i32.store8

# f64 ops. Values are real wasm f64 (not boxed): f64 locals/params/results,
# and conversions to/from i32. A decimal literal compiles to num/denom via
# convert (see compile_expr), so no IEEE754 constant encoding is needed.
public define op_f64_load() -> number: 43     # 0x2B f64.load
public define op_f64_store() -> number: 57    # 0x39 f64.store
public define op_f64_eq() -> number: 97       # 0x61 f64.eq
public define op_f64_ne() -> number: 98       # 0x62 f64.ne
public define op_f64_lt() -> number: 99       # 0x63 f64.lt
public define op_f64_gt() -> number: 100      # 0x64 f64.gt
public define op_f64_le() -> number: 101      # 0x65 f64.le
public define op_f64_ge() -> number: 102      # 0x66 f64.ge
public define op_f64_add() -> number: 160     # 0xA0 f64.add
public define op_f64_sub() -> number: 161     # 0xA1 f64.sub
public define op_f64_mul() -> number: 162     # 0xA2 f64.mul
public define op_f64_div() -> number: 163     # 0xA3 f64.div
public define op_f64_floor() -> number: 156    # 0x9C f64.floor
public define op_f64_trunc() -> number: 157    # 0x9D f64.trunc
public define op_f64_neg() -> number: 154      # 0x9A f64.neg
public define op_i32_trunc_f64_s() -> number: 170   # 0xAA i32.trunc_f64_s
public define op_f64_convert_i32_s() -> number: 183 # 0xB7 f64.convert_i32_s

# f32 ops (a distinct 32-bit float type). A literal is built as f64 (num/denom)
# then demoted, so no f32.const encoding is needed.
public define op_f32_load() -> number: 42     # 0x2A f32.load
public define op_f32_store() -> number: 56    # 0x38 f32.store
public define op_f32_eq() -> number: 91       # 0x5B
public define op_f32_ne() -> number: 92       # 0x5C
public define op_f32_lt() -> number: 93       # 0x5D
public define op_f32_gt() -> number: 94       # 0x5E
public define op_f32_le() -> number: 95       # 0x5F
public define op_f32_ge() -> number: 96       # 0x60
public define op_f32_add() -> number: 146     # 0x92
public define op_f32_sub() -> number: 147     # 0x93
public define op_f32_mul() -> number: 148     # 0x94
public define op_f32_div() -> number: 149     # 0x95
public define op_i32_trunc_f32_s() -> number: 168   # 0xA8 i32.trunc_f32_s
public define op_f32_convert_i32_s() -> number: 178 # 0xB2 f32.convert_i32_s
public define op_f32_demote_f64() -> number: 182    # 0xB6 f32.demote_f64
public define op_f64_promote_f32() -> number: 187   # 0xBB f64.promote_f32

public define emit_f32_load(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_f32_load())
    grown = append(grown, 2)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_f32_store(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_f32_store())
    grown = append(grown, 2)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# i64 ops - for the 64-bit `int` and the i64 sized type. Pointers stay i32
# (wasm32 addresses); a value typed i64/u64 uses these, with wrap/extend at the
# i32<->i64 boundaries.
public define op_i64_const() -> number: 66    # 0x42 i64.const
public define op_i64_load() -> number: 41     # 0x29 i64.load
public define op_i64_store() -> number: 55    # 0x37 i64.store
public define op_i64_eqz() -> number: 80      # 0x50 i64.eqz
public define op_i64_eq() -> number: 81       # 0x51 i64.eq
public define op_i64_ne() -> number: 82       # 0x52 i64.ne
public define op_i64_lt_s() -> number: 83     # 0x53 i64.lt_s
public define op_i64_lt_u() -> number: 84     # 0x54 i64.lt_u
public define op_i64_gt_s() -> number: 85     # 0x55 i64.gt_s
public define op_i64_gt_u() -> number: 86     # 0x56 i64.gt_u
public define op_i64_le_s() -> number: 87     # 0x57 i64.le_s
public define op_i64_ge_s() -> number: 89     # 0x59 i64.ge_s
public define op_i64_ge_u() -> number: 90     # 0x5A i64.ge_u
public define op_i64_add() -> number: 124     # 0x7C i64.add
public define op_i64_sub() -> number: 125     # 0x7D i64.sub
public define op_i64_mul() -> number: 126     # 0x7E i64.mul
public define op_i64_div_s() -> number: 127   # 0x7F i64.div_s
public define op_i64_div_u() -> number: 128   # 0x80 i64.div_u
public define op_i64_rem_s() -> number: 129   # 0x81 i64.rem_s
public define op_i64_and() -> number: 131     # 0x83 i64.and
public define op_i64_or() -> number: 132      # 0x84 i64.or
public define op_i64_xor() -> number: 133     # 0x85 i64.xor
public define op_i64_shl() -> number: 134     # 0x86 i64.shl
public define op_i64_shr_s() -> number: 135   # 0x87 i64.shr_s
public define op_i64_shr_u() -> number: 136   # 0x88 i64.shr_u
public define op_i32_wrap_i64() -> number: 167       # 0xA7 i32.wrap_i64 (i64 -> i32)
public define op_i64_extend_i32_s() -> number: 172   # 0xAC i64.extend_i32_s
public define op_i64_extend_i32_u() -> number: 173   # 0xAD i64.extend_i32_u
public define op_i64_trunc_f64_s() -> number: 176    # 0xB0 i64.trunc_f64_s
public define op_f64_convert_i64_s() -> number: 185  # 0xB9 f64.convert_i64_s

# i64 const/load/store emit helpers (memarg alignment 3 for the 8-byte access).
public define emit_i64_const(fn_value: WFn, value: number) -> WFn:
    immediate = leb_s(value)
    edit grown = append(fn_value.body, op_i64_const())
    loop byte_value in immediate:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_i64_load(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_i64_load())
    grown = append(grown, 3)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_i64_store(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_i64_store())
    grown = append(grown, 3)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Type markers in function signatures / local decls.
public define ty_i32() -> number: 127         # 0x7F
public define ty_i64() -> number: 126         # 0x7E
public define ty_f32() -> number: 125         # 0x7D
public define ty_f64() -> number: 124         # 0x7C

# --- module assembly ---

# Build a minimal WASM module that exports one function `main`
# returning a constant i32. Useful for sanity-testing the encoder
# end-to-end without an AST in the loop.
public define build_const_module(return_value: number) -> [number]:
    # Type section: one type - () -> i32
    type_section = build_type_section()
    # Function section: one function, type index 0
    func_section = wrap_section(3, [1, 0])
    # Memory section: one memory, 1 page minimum, no max
    memory_section = wrap_section(5, [1, 0, 1])
    # Export section: export "main" as func index 0
    export_section = build_export_section("main")
    # Code section: one function body
    code_section = build_code_section_const(return_value)

    edit output = []
    # Magic: 0x00 'a' 's' 'm' + version 1
    output = append(output, 0)
    output = append(output, 97)
    output = append(output, 115)
    output = append(output, 109)
    output = append(output, 1)
    output = append(output, 0)
    output = append(output, 0)
    output = append(output, 0)

    loop section_byte in type_section:
        output = append(output, section_byte)
    loop section_byte in func_section:
        output = append(output, section_byte)
    loop section_byte in memory_section:
        output = append(output, section_byte)
    loop section_byte in export_section:
        output = append(output, section_byte)
    loop section_byte in code_section:
        output = append(output, section_byte)
    output

define build_type_section() -> [number]:
    # 1 type, form 0x60, 0 params, 1 result (i32)
    contents = [1, 96, 0, 1, ty_i32()]
    wrap_section(1, contents)

define build_export_section(name: text) -> [number]:
    name_bytes = encode_name(name)
    # 1 export, then the name vec, then kind=0 (func) + index=0
    edit contents = [1]
    loop byte_value in name_bytes:
        contents = append(contents, byte_value)
    contents = append(contents, 0)
    contents = append(contents, 0)
    wrap_section(7, contents)

define build_code_section_const(return_value: number) -> [number]:
    # 1 code entry. Function body = local count (0), then
    # i32.const + leb_s(value), then end.
    const_bytes = leb_s(return_value)
    edit fn_body = [0]
    fn_body = append(fn_body, op_i32_const())
    loop byte_value in const_bytes:
        fn_body = append(fn_body, byte_value)
    fn_body = append(fn_body, op_end())

    body_size = list_length(fn_body)
    size_prefix = leb_u(body_size)
    edit wrapped = [1]
    loop size_byte in size_prefix:
        wrapped = append(wrapped, size_byte)
    loop body_byte in fn_body:
        wrapped = append(wrapped, body_byte)
    wrap_section(10, wrapped)

# is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is 
#  Higher-level builder API - assemble a module from data types
# is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is 
#
# Instead of poking bytes by hand the user describes the module as
# data: a list of functions, each with a name + param count + body
# bytes (already-encoded instructions). The encoder walks the
# description, lays out each section, and returns the full .wasm.

# One function within a module.
public type WFn: name: text, param_count: number, body: [number], local_count: number

# One import from the JS host: `module.name`, taking N i32 args,
# returning either i32 or nothing. The result_count flag is 0 for
# void, 1 for i32 - same shape as fn types.
public type WImport: module_name: text, fn_name: text, param_count: number, result_count: number

# One static byte block placed in linear memory at startup. The data
# section seeds the wasm heap with literal bytes - strings, tables,
# baked vertex data - without the runtime having to compute them.
public type WDataSegment: offset: number, bytes: [number]

# Whole module - imports + locally-defined functions + data segments.
# Imports get function indices 0..N before locally-defined fns start;
# data segments populate linear memory at instantiate time.
public type WModule: imports: [WImport], functions: [WFn], data_segments: [WDataSegment]

public define new_module() -> WModule:
    WModule{imports: [], functions: [], data_segments: []}

# Register a host import. JS will satisfy it via
# `{ env: { canvas_fill_rect: (x,y,w,h,c) => ... } }` at instantiate
# time.
public define add_import(module: WModule, import_value: WImport) -> WModule:
    WModule{imports: append(module.imports, import_value), functions: module.functions, data_segments: module.data_segments}

public define new_import(module_name: text, fn_name: text, param_count: number, result_count: number) -> WImport:
    WImport{module_name: module_name, fn_name: fn_name, param_count: param_count, result_count: result_count}

public define add_fn(module: WModule, fn_value: WFn) -> WModule:
    WModule{imports: module.imports, functions: append(module.functions, fn_value), data_segments: module.data_segments}

# Bake a string (or any byte sequence) into linear memory. Returns
# the new module + the offset the bytes were placed at - callers can
# use that offset as the pointer in `i32.load8_u` or hand it to a
# host import expecting (ptr, len).
public define add_data(module: WModule, offset: number, bytes_data: [number]) -> WModule:
    new_seg = WDataSegment{offset: offset, bytes: bytes_data}
    WModule{imports: module.imports, functions: module.functions, data_segments: append(module.data_segments, new_seg)}

public define add_string(module: WModule, offset: number, text: text) -> WModule:
    add_data(module, offset, bytes_of(text))

public define new_fn(name: text, param_count: number) -> WFn:
    WFn{name: name, param_count: param_count, body: [], local_count: 0}

# Register one more local (beyond params); emitted as an i32 in the code
# section local declarations.
public define add_local(fn_value: WFn) -> WFn:
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: fn_value.body, local_count: fn_value.local_count + 1}

# Emit one opcode-with-no-immediate into the function body. Returns a
# fresh WFn so the builder stays pure (no mutation).
public define emit_op(fn_value: WFn, opcode: number) -> WFn:
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: append(fn_value.body, opcode), local_count: fn_value.local_count}

# Append several bytes (used for opcode + immediate combos).
public define emit_bytes(fn_value: WFn, more: [number]) -> WFn:
    edit grown = fn_value.body
    loop byte_value in more:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Push an i32 constant.
public define emit_const(fn_value: WFn, value: number) -> WFn:
    immediate = leb_s(value)
    edit grown = append(fn_value.body, op_i32_const())
    loop byte_value in immediate:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# local.get / local.set with LEB128 index.
public define emit_local_get(fn_value: WFn, index: number) -> WFn:
    idx_bytes = leb_u(index)
    edit grown = append(fn_value.body, op_local_get())
    loop byte_value in idx_bytes:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_local_set(fn_value: WFn, index: number) -> WFn:
    idx_bytes = leb_u(index)
    edit grown = append(fn_value.body, op_local_set())
    loop byte_value in idx_bytes:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# local.tee - like set but leaves the value on the stack (so an
# allocation pointer can be stashed and reused in one instruction).
public define emit_local_tee(fn_value: WFn, index: number) -> WFn:
    idx_bytes = leb_u(index)
    edit grown = append(fn_value.body, op_local_tee())
    loop byte_value in idx_bytes:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# i32.load / i32.store with a memarg (alignment exponent + byte offset).
# Alignment 2 is natural for a 4-byte i32; baking the offset in lets a
# field access (ptr + 4 + i*4) fold the constant `+ 4` into the load.
public define emit_load(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_i32_load())
    grown = append(grown, 2)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_store(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_i32_store())
    grown = append(grown, 2)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# i32.load8_u / i32.store8 - single byte, for text (UTF-8 byte payloads).
public define emit_load8u(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_i32_load8_u())
    grown = append(grown, 0)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_store8(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_i32_store8())
    grown = append(grown, 0)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# f64.load / f64.store (8-byte). Alignment hint 3; wasm still permits the
# access when a field lands unaligned (e.g. an f64 after an i32).
public define emit_f64_load(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_f64_load())
    grown = append(grown, 3)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

public define emit_f64_store(fn_value: WFn, offset: number) -> WFn:
    edit grown = append(fn_value.body, op_f64_store())
    grown = append(grown, 3)
    loop byte_value in leb_u(offset):
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Direct call to another function by index. The caller already
# arranged the arguments on the stack.
public define emit_call(fn_value: WFn, function_index: number) -> WFn:
    idx_bytes = leb_u(function_index)
    edit grown = append(fn_value.body, op_call())
    loop byte_value in idx_bytes:
        grown = append(grown, byte_value)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Indirect call through table 0: the callee's table index is on top of the
# stack, below it the arguments. type_index names the signature to check.
public define emit_call_indirect(fn_value: WFn, type_index: number) -> WFn:
    edit grown = append(fn_value.body, op_call_indirect())
    loop byte_value in leb_u(type_index):
        grown = append(grown, byte_value)
    grown = append(grown, 0)
    WFn{name: fn_value.name, param_count: fn_value.param_count, body: grown, local_count: fn_value.local_count}

# Close out a function body with the `end` opcode (required by the
# WASM grammar at function/block end).
public define emit_end(fn_value: WFn) -> WFn:
    emit_op(fn_value, op_end())

# is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is 
#  Encode a WModule to bytes
# is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is  is 

public define encode_module(module: WModule) -> [number]:
    # Layout: types ← imports ← funcs ← memory ← exports ← code ← data.
    # Memory is exported as "memory" so JS can read strings the wasm
    # writes (or that we bake in via data segments).
    type_section = encode_type_section(module)
    import_section = encode_import_section(module)
    func_section = encode_function_section(module)
    table_section = encode_table_section(module)
    # 256 pages = 16 MiB. The allocator is a bump pointer that never
    # frees and never grows memory, so one 64 KiB page starved any
    # program that builds real amounts of text (memory access out of
    # bounds). 16 MiB matches the native heap's generosity until the
    # allocator learns memory.grow.
    edit memory_body = [1, 0]
    loop mb in leb_u(256):
        memory_body = append(memory_body, mb)
    memory_section = wrap_section(5, memory_body)
    export_section = encode_export_section(module)
    element_section = encode_element_section(module)
    code_section = encode_code_section(module)
    data_section = encode_data_section(module)
    name_section = encode_name_section(module)

    # Section order per the wasm spec: type, import, func, table, memory,
    # export, element, code, data.
    edit output = [0, 97, 115, 109, 1, 0, 0, 0]
    loop byte_value in type_section: output = append(output, byte_value)
    loop byte_value in import_section: output = append(output, byte_value)
    loop byte_value in func_section: output = append(output, byte_value)
    loop byte_value in table_section: output = append(output, byte_value)
    loop byte_value in memory_section: output = append(output, byte_value)
    loop byte_value in export_section: output = append(output, byte_value)
    loop byte_value in element_section: output = append(output, byte_value)
    loop byte_value in code_section: output = append(output, byte_value)
    loop byte_value in data_section: output = append(output, byte_value)
    loop byte_value in name_section: output = append(output, byte_value)
    output

# The name section (id 0, "name") - what every other wasm toolchain emits
# and this one did not. Without it a browser can only say "function #355
# failed", and finding out WHICH function that is means decoding the module
# by hand. With it the message names the function, which is the difference
# between a minute and an hour.
#
# Subsection 1 is the function names: a count, then (index, name) pairs.
# Imports come first in the index space, so a defined function's index is
# the import count plus where it sits in the code section.
define encode_name_section(module: WModule) -> [number]:
    fn_count = function_count(module)
    if fn_count is 0:
        return []
    base = import_list_length(module)
    edit names = []
    edit written = 0
    loop i in 0 until fn_count:
        f = module.functions[i]
        if length(f.name) > 0:
            loop b in leb_u(base + i):
                names = append(names, b)
            loop b in encode_name(f.name):
                names = append(names, b)
            written = written + 1
    if written is 0:
        return []
    edit sub = []
    loop b in leb_u(written):
        sub = append(sub, b)
    loop b in names:
        sub = append(sub, b)
    edit body = []
    loop b in encode_name("name"):
        body = append(body, b)
    body = append(body, 1)
    loop b in leb_u(list_length(sub)):
        body = append(body, b)
    loop b in sub:
        body = append(body, b)
    wrap_section(0, body)

# Data section (id 11) - initialises linear memory with literal bytes
# at instantiate time. Each segment: memidx (0, the only memory), an
# i32.const offset expression, then the byte vector.
define encode_data_section(module: WModule) -> [number]:
    seg_count = data_count(module)
    if seg_count is 0:
        []
    else:
        edit contents = []
        count_bytes = leb_u(seg_count)
        loop byte_value in count_bytes:
            contents = append(contents, byte_value)
        loop segment in module.data_segments:
            # Active segment for memidx 0
            contents = append(contents, 0)
            # Offset expression: i32.const <offset>, end
            offset_bytes = leb_s(segment.offset)
            contents = append(contents, op_i32_const())
            loop byte_value in offset_bytes:
                contents = append(contents, byte_value)
            contents = append(contents, op_end())
            # The byte payload
            payload_size = list_length(segment.bytes)
            size_bytes = leb_u(payload_size)
            loop byte_value in size_bytes:
                contents = append(contents, byte_value)
            loop byte_value in segment.bytes:
                contents = append(contents, byte_value)
        wrap_section(11, contents)

define data_count(module: WModule) -> number:
    edit count = 0
    loop _segment in module.data_segments:
        count = count + 1
    count

# Import section - id 2. Each entry is module name + fn name + kind
# (0x00 = func) + type index. The type vector already includes the
# import signatures alongside the local function ones.
define encode_import_section(module: WModule) -> [number]:
    import_count = import_list_length(module)
    if import_count is 0:
        []
    else:
        edit contents = []
        count_bytes = leb_u(import_count)
        loop byte_value in count_bytes:
            contents = append(contents, byte_value)
        loop import_value in module.imports:
            mod_bytes = encode_name(import_value.module_name)
            loop byte_value in mod_bytes:
                contents = append(contents, byte_value)
            name_bytes = encode_name(import_value.fn_name)
            loop byte_value in name_bytes:
                contents = append(contents, byte_value)
            contents = append(contents, 0)
            type_index = type_index_for_import(module, import_value)
            idx_bytes = leb_u(type_index)
            loop byte_value in idx_bytes:
                contents = append(contents, byte_value)
        wrap_section(2, contents)

define import_list_length(module: WModule) -> number:
    edit count = 0
    loop _value in module.imports:
        count = count + 1
    count

# A signature is text "<params>#<result>", one char per type ('i' i32,
# 'f' f64). Imports are all i32 (host fns). A defined fn's real signature
# is recorded by the codegen in slots wsig:<name> (params) and wret:<name>
# (result); absent slots fall back to all-i32, so pure-i32 modules encode
# byte-for-byte as before.
define irep(n: number) -> text:
    edit s = ""
    edit k = 0
    loop:
        if k >= n:
            break
        s = "{s}i"
        k = k + 1
    s

define sig_text_for_import(import_value: WImport) -> text:
    edit params = irep(import_value.param_count)
    if slot_has("wsig:{import_value.fn_name}"):
        params = slot_get("wsig:{import_value.fn_name}")
    edit result = ""
    if import_value.result_count is 1:
        result = "i"
        if slot_has("wret:{import_value.fn_name}"):
            result = slot_get("wret:{import_value.fn_name}")
    "{params}#{result}"

define sig_text_for_fn(fn_value: WFn) -> text:
    edit params = irep(fn_value.param_count)
    if slot_has("wsig:{fn_value.name}"):
        params = slot_get("wsig:{fn_value.name}")
    edit result = "i"
    if slot_has("wret:{fn_value.name}"):
        result = slot_get("wret:{fn_value.name}")
    "{params}#{result}"

define contains_text(items: [text], value: text) -> truth:
    edit found = false
    loop item in items:
        if item is value:
            found = true
    found

define index_of_text(items: [text], value: text) -> number:
    edit at_index = 0
    edit found = 0
    loop item in items:
        if item is value:
            found = at_index
        at_index = at_index + 1
    found

define collect_signatures(module: WModule) -> [text]:
    # Indices 0..5 are reserved for the all-i32 indirect-call signatures
    # of arity 1..6 (a function VALUE is called by arity: type index =
    # argument count - 1), and index 6 for the zero-arg one. Everything
    # a fn value carries is an i32 (pointers and whole numbers alike).
    edit sigs = append([], "i#i")
    sigs = append(sigs, "ii#i")
    sigs = append(sigs, "iii#i")
    sigs = append(sigs, "iiii#i")
    sigs = append(sigs, "iiiii#i")
    sigs = append(sigs, "iiiiii#i")
    sigs = append(sigs, "#i")
    loop import_value in module.imports:
        s = sig_text_for_import(import_value)
        if not contains_text(sigs, s):
            sigs = append(sigs, s)
    loop fn_value in module.functions:
        s = sig_text_for_fn(fn_value)
        if not contains_text(sigs, s):
            sigs = append(sigs, s)
    sigs

define type_index_for_import(module: WModule, import_value: WImport) -> number:
    index_of_text(collect_signatures(module), sig_text_for_import(import_value))

# 'f' (102) -> f64, everything else -> i32.
define wtype_char_to_byte(c: number) -> number:
    if c is 102:
        ty_f64()
    else if c is 103:
        ty_f32()
    else if c is 108 or c is 76:
        ty_i64()
    else:
        ty_i32()

# Type section - one entry per distinct signature across imports + fns.
define encode_type_section(module: WModule) -> [number]:
    signatures = collect_signatures(module)
    edit contents = []
    loop byte_value in leb_u(list_length(signatures)):
        contents = append(contents, byte_value)
    loop sig in signatures:
        bs = bytes_of(sig)
        n = length(bs)
        edit hash_pos = 0
        loop hi in 0 until n:
            if bs[hi] is 35:
                hash_pos = hi
        contents = append(contents, 96)
        loop byte_value in leb_u(hash_pos):
            contents = append(contents, byte_value)
        loop pi in 0 until hash_pos:
            contents = append(contents, wtype_char_to_byte(bs[pi]))
        loop byte_value in leb_u(n - hash_pos - 1):
            contents = append(contents, byte_value)
        loop ri in (hash_pos + 1) until n:
            contents = append(contents, wtype_char_to_byte(bs[ri]))
    wrap_section(1, contents)

# Function section - each fn's index into the type vector.
define encode_function_section(module: WModule) -> [number]:
    signatures = collect_signatures(module)
    edit contents = []
    loop byte_value in leb_u(function_count(module)):
        contents = append(contents, byte_value)
    loop fn_value in module.functions:
        loop byte_value in leb_u(index_of_text(signatures, sig_text_for_fn(fn_value))):
            contents = append(contents, byte_value)
    wrap_section(3, contents)

define function_count(module: WModule) -> number:
    edit count = 0
    loop _fn_value in module.functions:
        count = count + 1
    count

define total_function_count(module: WModule) -> number:
    import_list_length(module) + function_count(module)

# Table section (id 4) - one funcref table holding every function at its own
# index (an identity table), so a function value is just its index and
# call_indirect through it lands on the right function.
define encode_table_section(module: WModule) -> [number]:
    n = total_function_count(module)
    if n is 0:
        []
    else:
        edit contents = [1, 112, 0]
        loop b in leb_u(n):
            contents = append(contents, b)
        wrap_section(4, contents)

# Element section (id 9) - one active segment filling the table with funcidx i
# at slot i, at offset 0.
define encode_element_section(module: WModule) -> [number]:
    n = total_function_count(module)
    if n is 0:
        []
    else:
        edit contents = [1, 0, 65, 0, 11]
        loop b in leb_u(n):
            contents = append(contents, b)
        edit i = 0
        loop:
            if i >= n:
                break
            loop b in leb_u(i):
                contents = append(contents, b)
            i = i + 1
        wrap_section(9, contents)

# Export section - local fns indexed AFTER imports. We also export
# the single memory under the name "memory" so JS can `new Uint8Array(
# instance.exports.memory.buffer)` and read strings the wasm placed.
define encode_export_section(module: WModule) -> [number]:
    fn_count = function_count(module)
    import_offset = import_list_length(module)
    total_count = fn_count + 1
    edit contents = []
    count_bytes = leb_u(total_count)
    loop byte_value in count_bytes:
        contents = append(contents, byte_value)
    edit index = 0
    loop fn_value in module.functions:
        name_bytes = encode_name(fn_value.name)
        loop byte_value in name_bytes:
            contents = append(contents, byte_value)
        contents = append(contents, 0)
        idx_bytes = leb_u(index + import_offset)
        loop byte_value in idx_bytes:
            contents = append(contents, byte_value)
        index = index + 1
    # Memory export - kind = 2 (memory), index 0 (only memory).
    mem_name = encode_name("memory")
    loop byte_value in mem_name:
        contents = append(contents, byte_value)
    contents = append(contents, 2)
    contents = append(contents, 0)
    wrap_section(7, contents)

# Code section - bundled function bodies.
# Local declaration bytes for a function body. `types` is one char per
# declared local ('i'/'f') in index order, set by the codegen in wloc:<name>.
# Consecutive same-type locals are run-length grouped, as wasm requires. When
# the type string is missing or its length disagrees with local_count, fall
# back to all-i32 so index validity is preserved.
define encode_locals_decl(types: text, fallback_count: number) -> [number]:
    tb = bytes_of(types)
    tn = length(tb)
    if tn is not fallback_count:
        if fallback_count is 0:
            [0]
        else:
            edit out = [1]
            loop b in leb_u(fallback_count):
                out = append(out, b)
            out = append(out, ty_i32())
            out
    else:
        edit counts = []
        edit chars = []
        edit i = 0
        loop:
            if i >= tn:
                break
            c = tb[i]
            edit run = 1
            loop:
                if i + run >= tn:
                    break
                if tb[i + run] is c:
                    run = run + 1
                else:
                    break
            counts = append(counts, run)
            chars = append(chars, c)
            i = i + run
        ngroups = list_length(counts)
        edit out = []
        loop b in leb_u(ngroups):
            out = append(out, b)
        loop gi in 0 until ngroups:
            loop b in leb_u(counts[gi]):
                out = append(out, b)
            out = append(out, wtype_char_to_byte(chars[gi]))
        out

define encode_code_section(module: WModule) -> [number]:
    fn_count = function_count(module)
    edit contents = []
    count_bytes = leb_u(fn_count)
    loop byte_value in count_bytes:
        contents = append(contents, byte_value)
    loop fn_value in module.functions:
        # Function body framing: local declarations, then body bytes.
        edit local_types = ""
        if slot_has("wloc:{fn_value.name}"):
            local_types = slot_get("wloc:{fn_value.name}")
        edit body_with_locals = encode_locals_decl(local_types, fn_value.local_count)
        loop byte_value in fn_value.body:
            body_with_locals = append(body_with_locals, byte_value)
        body_size = list_length(body_with_locals)
        size_bytes = leb_u(body_size)
        loop byte_value in size_bytes:
            contents = append(contents, byte_value)
        loop byte_value in body_with_locals:
            contents = append(contents, byte_value)
    wrap_section(10, contents)
