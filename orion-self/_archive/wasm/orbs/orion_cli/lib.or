# orion_cli — pure-Orion compiler entry point.
#
# This is what `orion build foo.or` becomes once stdlib FFI ports are
# in place. Today it's invoked from an orbit script (also Orion). The
# pipeline:
#
#   source_path → read_file → self_lex → self_parse → ast_to_wasm
#                                                        ↓
#                                                  encode_module
#                                                        ↓
#                                              write_file dist/.wasm
#
# Plus index.html + main.js for browser deploy.

use orion_lex
use orion_parse
use orion_emit_wasm
use orion_ast_to_wasm
use orion_build_wasm
use io
use fs

# Compile one Orion source file to a wasm module + browser shell.
# `output_name` is used for the .wasm filename and the page title.
pub fn compile_to_wasm(source_path: Text, output_name: Text):
    print_line("[orion] compiling " + source_path)
    source = read_file(source_path)

    tokens = self_lex(source)
    print_line("[orion] lexed " + show_count(tokens) + " tokens")

    ast = self_parse(tokens)
    decls = get(ast, "decls")
    print_line("[orion] parsed " + show_decl_count(decls) + " declarations")

    mut module = new_module()
    mut fn_count = 0
    for decl in decls:
        if get(decl, "kind") == "Fn":
            wfn = compile_fn_ast(decl)
            module = add_fn(module, wfn)
            fn_count = fn_count + 1
    print_line("[orion] codegen produced " + show_int(fn_count) + " wasm fns")

    build(output_name, module, default_runtime(output_name + ".wasm"))

fn show_count(items) -> Text:
    mut count = 0
    for _item in items:
        count = count + 1
    show_int(count)

fn show_decl_count(items) -> Text:
    show_count(items)

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits_loop(value)

fn digits_loop(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits_loop(value / 10) + glyph_for(value % 10)

fn glyph_for(d: int) -> Text:
    if d == 0:
        "0"
    else:
        if d == 1:
            "1"
        else:
            if d == 2:
                "2"
            else:
                if d == 3:
                    "3"
                else:
                    if d == 4:
                        "4"
                    else:
                        if d == 5:
                            "5"
                        else:
                            if d == 6:
                                "6"
                            else:
                                if d == 7:
                                    "7"
                                else:
                                    if d == 8:
                                        "8"
                                    else:
                                        "9"
