use bytes
use io
data Inst: op: Text, type_text: Text, value: int, lhs: int, rhs: int, name: Text, args: [int]
data Param: name: Text, type_text: Text
data IRFn: name: Text, return_type: Text, params: [Param], instructions: [Inst]
data IRModule: functions: [IRFn]
data PushResult: function: IRFn, id: int
pub fn ir_type_i64() -> Text: "i64"
pub fn ir_type_ptr() -> Text: "ptr"
pub fn ir_type_bool() -> Text: "bool"
pub fn ir_type_void() -> Text: "void"
pub fn ir_iconst(value: int) -> Inst:
    Inst{op: "iconst", type_text: "i64", value: value, lhs: 0, rhs: 0, name: "", args: []}
pub fn ir_iadd(lhs: int, rhs: int) -> Inst:
    Inst{op: "iadd", type_text: "i64", value: 0, lhs: lhs, rhs: rhs, name: "", args: []}
