# THE STACK TEST: a cubsy-shaped main loop through atlas_app +
# atlas_render + veil DisplayList — compiled natively, zero
# lodge-orion. Orb shadowing supplies native window/gpu.
#
#   orion test_files/atlas_native_demo.or out.ll \
#       ../../atlas/orbs_native ../../atlas/orbs ../../veil/orbs
#   clang out.ll runtime/orion_rt.c runtime/win32_min.c \
#       runtime/d3d12_min.c -Os -o demo.exe -luser32 -lgdi32 \
#       -ld3d12 -ldxgi -ld3dcompiler

use atlas_app
use atlas_render
use veil_display
use veil_geometry

fn main() -> int:
    app = app_init("Atlas NATIVE - click to paint, Esc quits", 800, 600)
    if app.running == 0:
        print_line("app_init failed")
        return 1
    renderer = build_renderer(app.device, 800, 600)
    if renderer.ok == 0:
        print_line("renderer failed")
        return 1
    print_line("atlas native stack up")

    mut running = 1
    mut blocks_x = []
    mut blocks_y = []
    loop:
        if running == 0:
            break
        if app_should_quit(app):
            break
        events = app_pump(app)
        n_ev = len(events)
        for i in 0..<n_ev:
            ev = at(events, i)
            if ev.kind == "mouse_down":
                blocks_x = push(blocks_x, to_int(ev.x))
                blocks_y = push(blocks_y, to_int(ev.y))
            if ev.kind == "key_down":
                if ev.key == 27:
                    running = 0

        mut display = empty_list()
        display = push_cmd(display, DrawRect(Rect{x: 40, y: 40, width: 720, height: 520}, "panel"))
        n_b = len(blocks_x)
        for bi in 0..<n_b:
            bx = (at(blocks_x, bi) / 40) * 40
            by = (at(blocks_y, bi) / 40) * 40
            display = push_cmd(display, DrawRect(Rect{x: bx, y: by, width: 36, height: 36}, "magenta"))
        render_display(renderer, display)
        app_frame_sleep()

    app_shutdown(app)
    print_line("bye")
    0
