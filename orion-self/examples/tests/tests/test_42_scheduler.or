fn deadline_from_now(offset_ms: int) -> int:
    monotonic_ms() + offset_ms

fn sleep_until(deadline_ms: int):
    now = monotonic_ms()
    remaining = deadline_ms - now
    if remaining > 0:
        sleep_ms(remaining)

fn count_due(timers: [int]) -> int:
    n = len(timers)
    now = monotonic_ms()
    mut count = 0
    for i in 0..<n:
        if at(timers, i) <= now:
            count = count + 1
    count

fn main() -> int:
    start = monotonic_ms()
    # Three timers: 10ms, 25ms, 50ms from now.
    mut timers = bytes_zeros(0)
    timers = push(timers, deadline_from_now(10))
    timers = push(timers, deadline_from_now(25))
    timers = push(timers, deadline_from_now(50))
    # Sleep past all three.
    sleep_ms(60)
    # All three should be due.
    due = count_due(timers)
    after = monotonic_ms()
    elapsed = after - start
    ok_due = if due == 3 then 1 else 0
    ok_time = if elapsed >= 50 then 1 else 0
    if ok_due == 1 and ok_time == 1 then 42 else 0
