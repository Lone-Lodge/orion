effect AskUser:
    ask: fn(prompt: Text) -> Text

# Handler — perform AskUser.ask(prompt) dispatches to this by mangled name.
fn __handler_AskUser_ask(prompt: Text) -> Text:
    "default answer"

fn main() -> int:
    answer = perform AskUser.ask("hello")
    if answer == "default answer":
        42
    else:
        0
