{
  "fn": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:int}) -> ${4:int}:",
      "\t${0:body}"
    ],
    "description": "A function with one argument and a body block."
  },
  "fn-expr": {
    "prefix": "fne",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:int}) -> ${4:int} = ${0:expr}"
    ],
    "description": "A single-expression function (tail-expression form)."
  },
  "pub-fn": {
    "prefix": "pfn",
    "body": [
      "pub fn ${1:name}(${2:arg}: ${3:int}) -> ${4:int}:",
      "\t${0:body}"
    ],
    "description": "A public function."
  },
  "extern-fn": {
    "prefix": "efn",
    "body": [
      "pub extern fn ${1:name}(${2:arg}: ${3:Text}) -> ${4:Text}$0"
    ],
    "description": "An extern function declaration (impl is registered from Rust)."
  },
  "data": {
    "prefix": "data",
    "body": [
      "data ${1:Name}:",
      "\t${2:field}: ${3:int}$0"
    ],
    "description": "A data declaration (a typed record)."
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}:",
      "\t${2:Variant1}",
      "\t${3:Variant2}$0"
    ],
    "description": "An enum with two variants."
  },
  "trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name}:",
      "\tfn ${2:method}(self) -> ${3:int}$0"
    ],
    "description": "A trait declaration with one method."
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type}:",
      "\tfn ${3:method}(self) -> ${4:int}:",
      "\t\t${0:body}"
    ],
    "description": "An impl block."
  },
  "system": {
    "prefix": "system",
    "body": [
      "system ${1:name}(${2:dt}: f32):",
      "\tfor ${3:e} with ${4:Position}:",
      "\t\t${0:body}"
    ],
    "description": "A system that iterates entities with a component."
  },
  "for-in": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..<${3:n}:",
      "\t${0:body}"
    ],
    "description": "A for-loop over an exclusive range."
  },
  "for-with": {
    "prefix": "forw",
    "body": [
      "for ${1:e} with ${2:Position}:",
      "\t${0:body}"
    ],
    "description": "A for-loop over entities carrying components."
  },
  "if-then-else": {
    "prefix": "if",
    "body": [
      "if ${1:cond} then ${2:a} else ${3:b}$0"
    ],
    "description": "A conditional expression."
  },
  "if-block": {
    "prefix": "ifb",
    "body": [
      "if ${1:cond}:",
      "\t${2:body}",
      "else:",
      "\t${0:body}"
    ],
    "description": "A conditional statement with then/else blocks."
  },
  "loop": {
    "prefix": "loop",
    "body": [
      "loop:",
      "\tif ${1:stop_cond}:",
      "\t\tbreak",
      "\t${0:body}"
    ],
    "description": "An unbounded loop with an explicit break condition."
  },
  "mut": {
    "prefix": "mut",
    "body": [
      "mut ${1:name} = ${0:value}"
    ],
    "description": "A mutable binding."
  },
  "use": {
    "prefix": "use",
    "body": [
      "use ${0:module}"
    ],
    "description": "Import another orb or local module."
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "\t${2:Variant1} -> ${3:expr}",
      "\t${4:Variant2} -> ${0:expr}"
    ],
    "description": "A match expression."
  },
  "spawn": {
    "prefix": "spawn",
    "body": [
      "spawn ${1:Position}{${2:x: 0.0, y: 0.0}}$0"
    ],
    "description": "Spawn an entity with one component."
  },
  "require": {
    "prefix": "require",
    "body": [
      "require ${1:cond}$0"
    ],
    "description": "Precondition assertion."
  },
  "ensure": {
    "prefix": "ensure",
    "body": [
      "ensure ${1:cond}$0"
    ],
    "description": "Postcondition assertion."
  }
}
