# self_emit_pe_imports — emit a Windows x64 PE that imports
# kernel32.ExitProcess and calls it with exit code 7. No external
# linker. Demonstrates Orion can interface with the OS through real
# import tables — foundation for WriteFile/stdin/stdout/everything else.
#
# Layout (file offsets):
#   0x000  DOS header
#   0x040  PE\0\0 + COFF header + optional header (240 B)
#   0x148  2 section headers (.text, .rdata) — 80 B
#   0x200  .text content (code, RVA 0x1000)
#   0x400  .rdata content (import table, RVA 0x2000)
#
# Import structure within .rdata (offsets from RVA 0x2000):
#   +0x00  Import Directory Table (1 entry + null terminator = 40 B)
#   +0x28  Import Lookup Table for kernel32 (1 entry + null term = 16 B)
#   +0x38  Import Address Table for kernel32 (1 entry + null term = 16 B)
#   +0x48  Hint/Name for "ExitProcess" (16 B)
#   +0x58  DLL name "kernel32.dll\0" (16 B)
#   +0x68  end

# --- buffer slot ---

fn pei_buf_get():
    slot_get("pei:buf")

fn pei_buf_init(size: int):
    slot_set("pei:buf", bytes_zeros(size))

fn pei_buf_take():
    slot_get("pei:buf")

# --- byte writers (read-modify-write the slot) ---

fn pei_u8(offset: int, value: int):
    masked = value - (value / 256) * 256
    slot_set("pei:buf", set(pei_buf_get(), offset, masked))

fn pei_u16(offset: int, value: int):
    pei_u8(offset, value)
    pei_u8(offset + 1, value / 256)

fn pei_u32(offset: int, value: int):
    pei_u8(offset, value)
    pei_u8(offset + 1, value / 256)
    pei_u8(offset + 2, value / 65536)
    pei_u8(offset + 3, value / 16777216)

fn pei_u64(offset: int, low_u32: int, high_u32: int):
    pei_u32(offset, low_u32)
    pei_u32(offset + 4, high_u32)

# Write an ASCII string at `offset`. Null-terminated by leaving the
# zero-initialized buffer untouched past the last byte.
# (`raw` is a reserved keyword in Orion — use `payload`.)
fn pei_string(offset: int, text: Text):
    payload = bytes_from_text(text)
    count = bytes_length(payload)
    for index in 0..<count:
        pei_u8(offset + index, byte_at(payload, index))

pub fn pei_build():
    pei_buf_init(1536)             # 0x600

    # ---- DOS header ----
    pei_u8(0, 77)                  # 'M'
    pei_u8(1, 90)                  # 'Z'
    pei_u32(60, 64)                # e_lfanew = 0x40

    # ---- PE signature ----
    pei_u8(64, 80)                 # 'P'
    pei_u8(65, 69)                 # 'E'

    # ---- COFF header @ 0x44 ----
    pei_u16(68, 34404)             # Machine: 0x8664 (AMD64)
    pei_u16(70, 2)                 # NumberOfSections = 2
    pei_u16(84, 240)               # SizeOfOptionalHeader
    pei_u16(86, 34)                # EXECUTABLE | LARGE_ADDR_AWARE

    # ---- Optional header @ 0x58 ----
    pei_u16(88, 523)               # PE32+ magic = 0x20b
    pei_u8(90, 14)                 # MajorLinkerVersion
    pei_u32(92, 512)               # SizeOfCode
    pei_u32(96, 512)               # SizeOfInitializedData
    pei_u32(104, 4096)             # AddressOfEntryPoint (RVA = 0x1000)
    pei_u32(108, 4096)             # BaseOfCode

    # ImageBase = 0x140000000 → low=0x40000000, high=1
    pei_u64(112, 1073741824, 1)

    pei_u32(120, 4096)             # SectionAlignment (0x1000)
    pei_u32(124, 512)              # FileAlignment   (0x200)
    pei_u16(128, 6)                # MajorOSVersion
    pei_u16(136, 6)                # MajorSubsystemVersion
    pei_u32(144, 12288)            # SizeOfImage = 0x3000 (3 pages)
    pei_u32(148, 512)              # SizeOfHeaders   (0x200)
    pei_u16(156, 3)                # Subsystem: CONSOLE

    pei_u64(160, 1048576, 0)       # SizeOfStackReserve
    pei_u64(168, 4096, 0)          # SizeOfStackCommit
    pei_u64(176, 1048576, 0)       # SizeOfHeapReserve
    pei_u64(184, 4096, 0)          # SizeOfHeapCommit
    pei_u32(196, 16)               # NumberOfRvaAndSizes

    # Data Directory[1] = Import Table → RVA 0x2000, Size 40
    pei_u32(208, 8192)             # 0x2000
    pei_u32(212, 40)               # entry + null terminator

    # Data Directory[12] = Import Address Table (IAT)
    # offset = 0xc8 + 12*8 = 0x128 = 296
    pei_u32(296, 8248)             # 0x2038
    pei_u32(300, 16)

    # ---- Section header for .text @ 0x148 ----
    pei_string(328, ".text")
    pei_u32(336, 16)               # VirtualSize
    pei_u32(340, 4096)             # VirtualAddress (RVA 0x1000)
    pei_u32(344, 512)              # SizeOfRawData
    pei_u32(348, 512)              # PointerToRawData
    pei_u32(364, 1610612768)       # 0x60000020: CODE | EXECUTE | READ

    # ---- Section header for .rdata @ 0x170 (368) ----
    pei_string(368, ".rdata")
    pei_u32(376, 104)              # VirtualSize (0x68)
    pei_u32(380, 8192)             # VirtualAddress (RVA 0x2000)
    pei_u32(384, 512)              # SizeOfRawData
    pei_u32(388, 1024)             # PointerToRawData (0x400)
    pei_u32(404, 1073741888)       # 0x40000040: INITIALIZED_DATA | READ

    # ---- .text section @ 0x200 (RVA 0x1000) ----
    # Machine code:
    #   sub rsp, 0x28           48 83 EC 28
    #   mov ecx, 7              B9 07 00 00 00
    #   call [rel ExitProcess]  FF 15 disp32
    #
    # disp32 = IAT_RVA - next_instr_RVA = 0x2038 - 0x100F = 0x1029
    pei_u8(512, 72)                # 0x48
    pei_u8(513, 131)               # 0x83
    pei_u8(514, 236)               # 0xEC
    pei_u8(515, 40)                # 0x28
    pei_u8(516, 185)               # 0xB9
    pei_u8(517, 7)                 # exit code = 7
    pei_u8(521, 255)               # 0xFF
    pei_u8(522, 21)                # 0x15
    pei_u32(523, 4137)             # disp32 = 0x1029

    # ---- .rdata @ 0x400 (RVA 0x2000) ----
    rdata_off = 1024               # 0x400
    rdata_rva = 8192               # 0x2000

    # Import Directory Table @ +0x00
    pei_u32(rdata_off + 0, rdata_rva + 40)     # OriginalFirstThunk → ILT @ +0x28
    pei_u32(rdata_off + 12, rdata_rva + 88)    # Name → DLL name @ +0x58
    pei_u32(rdata_off + 16, rdata_rva + 56)    # FirstThunk → IAT @ +0x38
    # +20..+40: zero-initialized null terminator

    # ILT @ +0x28: RVA to hint/name (import by name, high bit = 0)
    pei_u32(rdata_off + 40, rdata_rva + 72)    # → hint/name @ +0x48
    # +44..+48: high u32 of the 8-byte entry, zero
    # +48..+56: null terminator

    # IAT @ +0x38: identical to ILT initially; loader rewrites to actual addr
    pei_u32(rdata_off + 56, rdata_rva + 72)
    # +64..+72: null terminator

    # Hint/Name @ +0x48: 2-byte hint (0) + "ExitProcess\0"
    pei_string(rdata_off + 74, "ExitProcess")

    # DLL name @ +0x58: "kernel32.dll\0"
    pei_string(rdata_off + 88, "kernel32.dll")

    pei_buf_take()

pub fn pei_run():
    pe_bytes = pei_build()
    print("PE size:")
    print(len(pe_bytes))
    mkdir_all("build")
    write_file_bytes("build/hello.exe", pe_bytes)
    print("wrote build/hello.exe")
