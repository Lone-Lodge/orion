# M3: data comes alive — entities, spawn, queries, systems.
# Try:
#   cargo run -- run examples/m3.or demo
#   cargo run -- run examples/m3.or low_hps

data Health: hp: 0...1000, max: 0...1000
data Position: x: f32, y: f32

# spawn entities, then count the wounded with a `for ... with ... where` query
fn demo() -> int:
    spawn Health{hp: 10, max: 10}, Position{x: 0, y: 0}
    spawn Health{hp: 3, max: 10}, Position{x: 1, y: 1}
    spawn Health{hp: 1, max: 10}
    mut wounded = 0
    for e with Health where e.Health.hp < 5:
        wounded += 1
    wounded

# a comprehension returns a list of values
fn low_hps() -> [int]:
    spawn Health{hp: 8, max: 10}
    spawn Health{hp: 2, max: 10}
    [e.Health.hp for e with Health where e.Health.hp < 5]

# --- pieces used by the system test (store persists across calls on one run) ---

fn seed():
    spawn Health{hp: 1, max: 10}

# a system mutates the world in place
system regen(amount: int):
    for e with Health:
        e.Health.hp += amount

fn healthy() -> int:
    mut n = 0
    for e with Health where e.Health.hp >= 5:
        n += 1
    n
