# Functions that actually RUN under the M2 interpreter. Try:
#   cargo run -- run examples/m2.or double 21
#   cargo run -- run examples/m2.or fib 10
#   cargo run -- run examples/m2.or clamp 50 0 10
#   cargo run -- run examples/m2.or hyp 3 4
#   cargo run -- check examples/m2.or

fn double(x: int) -> int = x * 2

fn clamp(v: int, lo: int, hi: int) -> int =
    if v < lo then lo else if v > hi then hi else v

# a function calling itself — recursion just works
fn fib(n: int) -> int =
    if n < 2 then n else fib(n - 1) + fib(n - 2)

# calls a builtin; mixes int and float arithmetic
fn hyp(a: f32, b: f32) -> f32 = sqrt(a * a + b * b)
