# M5: the compiler infers each system's footprint (reads/writes) and works out
# which systems can run in parallel. Try:
#   cargo run -- footprint examples/m5.or

data Position: x: f32, y: f32
data Velocity: dx: f32, dy: f32
data Health: hp: 0...1000, max: 0...1000
data Label: id: int          # never iterated by a system -> stays AoS

# (try also:  cargo run -- layout examples/m5.or)

# reads Velocity, reads+writes Position
system move(dt: f32):
    for e with Position, Velocity:
        e.Position.x += e.Velocity.dx * dt
        e.Position.y += e.Velocity.dy * dt

# reads+writes Health — disjoint from `move`, so it can run alongside it
system regen(amount: int):
    for e with Health:
        e.Health.hp += amount

# reads Health — conflicts with `regen` (which writes Health), so it waits
system clear_dead():
    for e with Health where e.Health.hp <= 0:
        destroy e
