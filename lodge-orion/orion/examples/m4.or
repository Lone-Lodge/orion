# M4: these integer functions compile to NATIVE machine code via Cranelift.
# Try:
#   cargo run -- jit examples/m4.or fib 30
#   cargo run -- jit examples/m4.or clamp 50 0 10
#   cargo run -- run examples/m4.or fib 30     # same answer, interpreted

fn double(x: int) -> int = x * 2

fn clamp(v: int, lo: int, hi: int) -> int =
    if v < lo then lo else if v > hi then hi else v

fn fib(n: int) -> int =
    if n < 2 then n else fib(n - 1) + fib(n - 2)

# floats compile too (fadd/fmul/fsqrt). Try: cargo run -- jit examples/m4.or hyp 3 4
fn hyp(a: f64, b: f64) -> f64 = sqrt(a * a + b * b)
