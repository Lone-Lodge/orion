# self_pe_wrap — wrap x86-64 machine code in a complete PE that
# imports kernel32 functions (ExitProcess, GetStdHandle, WriteFile),
# stores string literals in .rdata, patches RIP-relative fixups from
# code → IAT and code → strings, and exits with `rax` as the process
# exit code.
#
# Section layout (RVAs):
#   .text  RVA 0x1000   VirtualSize 128 KB (SizeOfRawData 0x20000)
#   .rdata RVA 0x21000  VirtualSize  32 KB (next page-aligned after .text)
#   .data  RVA 0x29000  VirtualSize 256 KB (bump-allocator heap)
#
# .rdata internal layout (offsets from RVA 0x21000):
#   +0x00   Import Directory Table (1 entry + null term = 40 B)
#   +0x28   ILT for kernel32 (8 entries + null = 72 B)
#   +0x70   IAT for kernel32 (8 entries + null = 72 B)
#         [0] (RVA 0x21070) → ExitProcess
#         [1] (RVA 0x21078) → GetStdHandle
#         [2] (RVA 0x21080) → WriteFile
#         [3] (RVA 0x21088) → CreateFileA
#         [4] (RVA 0x21090) → ReadFile
#         [5] (RVA 0x21098) → GetFileSizeEx
#         [6] (RVA 0x210A0) → CloseHandle
#         [7] (RVA 0x210A8) → GetFileAttributesA
#   +0xB8   Hint/Name slots (8 × 24 B = 192 B)
#   +0x178  DLL name "kernel32.dll"      (16 B)
#   +0x188  String pool — each literal stored sequentially, no padding

fn pw_buf_get():
    slot_get("pw:buf")

fn pw_buf_init(size: int):
    # Use a plain list of zeros — slot_set_at requires the slot to hold a
    # List (not the Bytes flavour returned by bytes_zeros).
    # `slot_push` mutates the slot in place (O(1) amortised); the prior
    # `buf = push(buf, 0)` cloned the entire list each iteration which
    # made init quadratic — 164 KB buffer took 100+ minutes.
    slot_set("pw:buf", [])
    for _index in 0..<size:
        slot_push("pw:buf", 0)

fn pw_buf_take():
    slot_get("pw:buf")

fn pw_u8(offset: int, value: int):
    shifted = value + 4294967296
    masked = shifted - (shifted / 256) * 256
    # O(1) write — was `slot_set(name, set(slot_get(name), offset, masked))`
    # which cloned the entire 37 KB buffer on every byte.
    slot_set_at("pw:buf", offset, masked)

fn pw_u16(offset: int, value: int):
    u = if value >= 0 then value else value + 65536
    pw_u8(offset, u)
    pw_u8(offset + 1, u / 256)

fn pw_u32(offset: int, value: int):
    u = if value >= 0 then value else value + 4294967296
    pw_u8(offset, u)
    pw_u8(offset + 1, u / 256)
    pw_u8(offset + 2, u / 65536)
    pw_u8(offset + 3, u / 16777216)

fn pw_string_at(offset: int, text: Text):
    payload = bytes_from_text(text)
    count = bytes_length(payload)
    for index in 0..<count:
        pw_u8(offset + index, byte_at(payload, index))

fn pw_bytes_at(offset: int, byte_list):
    count = len(byte_list)
    for index in 0..<count:
        pw_u8(offset + index, at(byte_list, index))

fn pw_emit_headers(entry_rva: int, text_size: int):
    pw_u8(0, 77)                   # 'M'
    pw_u8(1, 90)                   # 'Z'
    pw_u32(60, 64)
    pw_u8(64, 80)                  # 'P'
    pw_u8(65, 69)                  # 'E'

    pw_u16(68, 34404)              # Machine 0x8664
    pw_u16(70, 3)                  # 3 sections (.text + .rdata + .data)
    pw_u16(84, 240)
    pw_u16(86, 34)

    pw_u16(88, 523)                # PE32+ magic
    pw_u8(90, 14)
    pw_u32(92, 131072)             # SizeOfCode (matches .text SizeOfRawData = 128 KB)
    pw_u32(96, 33280)              # SizeOfInitializedData (.rdata 32 KB + .data raw 512)
    pw_u32(104, entry_rva)
    pw_u32(108, 4096)
    pw_u32(112, 0)
    pw_u32(116, 0)
    # ImageBase = 0x140000000
    pw_u32(112, 1073741824)
    pw_u32(116, 1)
    pw_u32(120, 4096)
    pw_u32(124, 512)
    pw_u16(128, 6)
    pw_u16(136, 6)
    # SizeOfImage must cover .data RVA + .data VirtualSize.
    # .data @ RVA 0x29000 + 0x40000 VirtualSize = end 0x69000.
    pw_u32(144, 430080)            # 0x69000
    pw_u32(148, 512)
    pw_u16(156, 3)
    pw_u32(160, 1048576)
    pw_u32(168, 4096)
    pw_u32(176, 1048576)
    pw_u32(184, 4096)
    pw_u32(196, 16)

    # Data Dir[1] Import Table — RVA 0x21000, size 40
    pw_u32(208, 135168)
    pw_u32(212, 40)
    # Data Dir[12] IAT — RVA 0x21070, size 72
    pw_u32(296, 135280)
    pw_u32(300, 72)

    pw_string_at(328, ".text")
    # VirtualSize set to SizeOfRawData so the section's virtual footprint
    # equals the file-padded footprint — keeps .rdata contiguous at RVA
    # 0x21000 regardless of how much code we actually emit (text_size is
    # ignored here, but kept in the call signature for documentation).
    pw_u32(336, 131072)            # VirtualSize 128 KB
    pw_u32(340, 4096)              # VirtualAddress (RVA 0x1000)
    pw_u32(344, 131072)            # SizeOfRawData = 128 KB
    pw_u32(348, 512)               # PointerToRawData (file 0x200)
    pw_u32(364, 1610612768)

    pw_string_at(368, ".rdata")
    pw_u32(376, 32768)             # VirtualSize 32 KB
    pw_u32(380, 135168)            # VirtualAddress (RVA 0x21000 = .text RVA + 0x20000)
    pw_u32(384, 32768)             # SizeOfRawData 32 KB
    pw_u32(388, 131584)            # PointerToRawData (file 0x20200)
    pw_u32(404, 1073741888)

    # .data — writable heap for the bump allocator. First 8 bytes hold
    # the bump offset (zero-initialized). Remaining VirtualSize is OS
    # zero-filled when SizeOfRawData < VirtualSize.
    pw_string_at(408, ".data")
    pw_u32(416, 262144)            # VirtualSize (256 KB heap)
    pw_u32(420, 167936)            # VirtualAddress (RVA 0x29000 = .rdata RVA + 0x8000)
    pw_u32(424, 512)               # SizeOfRawData (just the bump slot in file)
    pw_u32(428, 164352)            # PointerToRawData (file 0x28200)
    pw_u32(444, 3221225536)        # 0xC0000040: INITIALIZED_DATA | READ | WRITE

fn pw_emit_imports():
    rd = 131584                    # file offset of .rdata (0x20200)
    rva = 135168                   # RVA of .rdata (0x21000)

    # Import Directory Table
    pw_u32(rd + 0, rva + 40)       # IDT.OriginalFirstThunk → ILT @ +0x28
    pw_u32(rd + 12, rva + 376)     # IDT.Name → DLL name @ +0x178
    pw_u32(rd + 16, rva + 112)     # IDT.FirstThunk → IAT @ +0x70

    # Hint/Name slots — 8 entries × 24 bytes each, base @ +0xB8 = 184
    # Names: "ExitProcess", "GetStdHandle", "WriteFile", "CreateFileA",
    #        "ReadFile", "GetFileSizeEx", "CloseHandle", "GetFileAttributesA"
    name_base = 184

    # ILT entries (8 funcs + null terminator at +0x68)
    pw_u32(rd + 40, rva + name_base + 0)     # → ExitProcess
    pw_u32(rd + 48, rva + name_base + 24)    # → GetStdHandle
    pw_u32(rd + 56, rva + name_base + 48)    # → WriteFile
    pw_u32(rd + 64, rva + name_base + 72)    # → CreateFileA
    pw_u32(rd + 72, rva + name_base + 96)    # → ReadFile
    pw_u32(rd + 80, rva + name_base + 120)   # → GetFileSizeEx
    pw_u32(rd + 88, rva + name_base + 144)   # → CloseHandle
    pw_u32(rd + 96, rva + name_base + 168)   # → GetFileAttributesA

    # IAT (same content as ILT initially — loader patches to real VAs)
    pw_u32(rd + 112, rva + name_base + 0)
    pw_u32(rd + 120, rva + name_base + 24)
    pw_u32(rd + 128, rva + name_base + 48)
    pw_u32(rd + 136, rva + name_base + 72)
    pw_u32(rd + 144, rva + name_base + 96)
    pw_u32(rd + 152, rva + name_base + 120)
    pw_u32(rd + 160, rva + name_base + 144)
    pw_u32(rd + 168, rva + name_base + 168)

    # Hint/Name table — each entry: 2-byte hint (zero) + null-terminated
    # function name, padded to 24-byte slots.
    pw_string_at(rd + name_base + 0 + 2,   "ExitProcess")
    pw_string_at(rd + name_base + 24 + 2,  "GetStdHandle")
    pw_string_at(rd + name_base + 48 + 2,  "WriteFile")
    pw_string_at(rd + name_base + 72 + 2,  "CreateFileA")
    pw_string_at(rd + name_base + 96 + 2,  "ReadFile")
    pw_string_at(rd + name_base + 120 + 2, "GetFileSizeEx")
    pw_string_at(rd + name_base + 144 + 2, "CloseHandle")
    pw_string_at(rd + name_base + 168 + 2, "GetFileAttributesA")
    pw_string_at(rd + 376, "kernel32.dll")

# Place each string literal sequentially starting at .rdata + 0xA8.
# Returns a list of {"offset_in_rdata": int, "length": int} per string.
fn pw_emit_strings(strings):
    rd = 131584                    # .rdata file offset (0x20200)
    pool_base = 392                # 0x188 — past hint/name table + DLL name
    total = len(strings)
    mut current = pool_base
    mut entries = []
    for index in 0..<total:
        str_bytes = at(strings, index)
        str_len = bytes_length(str_bytes)
        for byte_index in 0..<str_len:
            pw_u8(rd + current + byte_index, byte_at(str_bytes, byte_index))
        # Null-terminator so strlen-style scans (str_to_int,
        # bytes_from_text, etc.) stop at the actual string end. The
        # zero is already there since pw_buf_init zeroes the buffer,
        # but advancing `current` past it keeps the next string clean.
        entries = push(entries, {"offset_in_rdata": current, "length": str_len})
        current = current + str_len + 1
    entries

# Patch a 4-byte disp32 placeholder inside .text at file offset
# (512 + code_offset).
fn pw_patch_disp32_in_text(code_offset: int, disp_value: int):
    u = if disp_value >= 0 then disp_value else disp_value + 4294967296
    pw_u32(512 + code_offset, u)

# Build a PE with code + string pool + imports. Patches every string
# and IAT placeholder so the loader-fixed-up IAT and our string pool
# are reachable via RIP-relative addressing.
pub fn pw_build_with_main(user_code, main_offset: int, strings, string_fixups, iat_fixups):
    # Buffer: 0x200 headers + 0x20000 .text + 0x8000 .rdata + 0x200 .data = 0x28400 file end
    # Total buffer = .data PointerToRawData + .data SizeOfRawData = 164352 + 512 = 164864
    pw_buf_init(164864)
    user_len = len(user_code)
    trampoline_len = 18
    code_len = user_len + trampoline_len
    entry_rva = 4096 + user_len
    pw_emit_headers(entry_rva, code_len)
    pw_bytes_at(512, user_code)

    # Trampoline: sub rsp 0x28; call main; mov rcx,rax; call [ExitProcess]
    tramp_off = 512 + user_len
    pw_u8(tramp_off, 72)
    pw_u8(tramp_off + 1, 131)
    pw_u8(tramp_off + 2, 236)
    pw_u8(tramp_off + 3, 40)
    pw_u8(tramp_off + 4, 232)      # E8 (call rel32)
    call_main_disp = main_offset - (user_len + 9)
    pw_u32(tramp_off + 5, call_main_disp)
    pw_u8(tramp_off + 9, 72)
    pw_u8(tramp_off + 10, 137)
    pw_u8(tramp_off + 11, 193)
    pw_u8(tramp_off + 12, 255)
    pw_u8(tramp_off + 13, 21)
    next_instr_rva = 4096 + user_len + 18
    iat_disp = 135280 - next_instr_rva  # IAT slot 0 = ExitProcess @ RVA 0x21070
    pw_u32(tramp_off + 14, iat_disp)

    pw_emit_imports()
    pool_entries = pw_emit_strings(strings)

    # Pre-initialize the bump-allocator pointer so the first heap alloc
    # lands at .data + 4096 — leaves 4080 bytes (.data+16 .. .data+4095)
    # reserved for the global slot map used by slot_get/slot_set.
    pw_u32(164352, 4088)           # .data file offset = 0x28200

    # Patch string fixups in .text. Each fixup: { offset, str_index }.
    rdata_rva = 135168             # 0x21000
    sf_count = len(string_fixups)
    for index in 0..<sf_count:
        fixup = at(string_fixups, index)
        placeholder_offset = get(fixup, "offset")
        str_index = get(fixup, "str_index")
        entry = at(pool_entries, str_index)
        str_rva = rdata_rva + get(entry, "offset_in_rdata")
        next_instr_rva_for_fixup = 4096 + placeholder_offset + 4
        disp = str_rva - next_instr_rva_for_fixup
        pw_patch_disp32_in_text(placeholder_offset, disp)

    # Patch IAT fixups. iat_index: 0=ExitProcess, 1=GetStdHandle, 2=WriteFile.
    iat_count = len(iat_fixups)
    for index in 0..<iat_count:
        fixup = at(iat_fixups, index)
        placeholder_offset = get(fixup, "offset")
        iat_index = get(fixup, "iat_index")
        iat_slot_rva = 135280 + iat_index * 8   # RVA 0x21070 + 8 * slot
        next_instr_rva_for_fixup = 4096 + placeholder_offset + 4
        disp = iat_slot_rva - next_instr_rva_for_fixup
        pw_patch_disp32_in_text(placeholder_offset, disp)

    pw_buf_take()
