# self_compile — Orion CLI program that compiles an Orion source file to
# a native binary. STEP 8 PROOF.
#
# Pipeline (all in Orion code):
#   read_file(input.or)
#     → self_lex (Orion)
#     → self_parse (Orion)
#     → self_codegen (Orion)
#     → write_file(out.c)
#     → capture_stdout("gcc", ["out.c", "-o", "out.exe"])
#     → out.exe is a native Windows binary built entirely via Orion-implemented
#       transforms. The only Rust running was the bootstrap orbit binary; the
#       compiler itself is pure Orion.
#
# This is the moment the language hosts itself — modulo grammar coverage.
# Expanding to the full Orion grammar is purely "more cases of the same
# pattern" in self_lex / self_parse / self_codegen.

pub fn self_compile_run():
    input_path = "input.or"
    output_c = "build/out.c"
    output_exe = "build/out.exe"

    if not file_exists(input_path):
        eprint("self_compile: missing " + input_path)
        exit_with(1)
    mkdir_all("build")

    source = read_file(input_path)
    print("--- compiling " + input_path + " ---")

    tokens = self_lex(source)
    print("lexed:    " + fmt_int(len(tokens), 0) + " tokens")

    ast = self_parse(tokens)
    decls = get(ast, "decls")
    print("parsed:   " + fmt_int(len(decls), 0) + " declarations")

    c_code = self_codegen(ast)
    write_file(output_c, c_code)
    print("emitted:  " + output_c)

    # Invoke the system C compiler. `gcc` works on every dev box; the
    # arg shape is portable enough that swapping in `cc` or `clang` is
    # a one-line change.
    gcc_args = [output_c, "-o", output_exe]
    gcc_out = capture_stdout("gcc", gcc_args)
    if file_exists(output_exe):
        print("compiled: " + output_exe)
    else:
        eprint("self_compile: gcc failed")
        eprint(gcc_out)
        exit_with(1)
