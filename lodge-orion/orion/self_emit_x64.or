# self_emit_x64 — Orion AST → x86-64 machine code bytes.
#
# Strategy: rax is the "result register" for every expression. Binary
# ops save lhs on the stack while evaluating rhs, then pop and combine.
# This is the simplest possible scheme — no register allocator, no
# liveness analysis. It generates correct (if verbose) code for the
# integer subset.
#
# Emits machine code into the slot `x64:buf`. Caller takes the bytes
# and embeds them in the PE's .text section.
#
# Supported AST kinds (proof scope):
#   Int      — mov eax, imm32
#   Binary   — `+`, `-`, `*`
#   Block    — sequential statements; last ExprStmt is the result
#   ExprStmt — evaluate (result in rax)

fn x64_buf_get():
    slot_get("x64:buf")

fn x64_reset():
    # Reset to an empty *List* — slot_push expects a list and bytes_zeros(0)
    # returns the bytes flavour which slot_push refuses.
    slot_set("x64:buf", [])

fn x64_take():
    slot_get("x64:buf")

fn x64_emit_u8(value: int):
    # Reduce to unsigned byte. The `+ 2^32` shifts even very negative
    # input into the positive range so integer division for the mask
    # (which Orion truncates toward zero) does the right thing.
    shifted = value + 4294967296
    masked = shifted - (shifted / 256) * 256
    # O(1) amortized in-place push — was `slot_set(..., push(get(), ...))`
    # which was O(n) per call, quadratic over the full code stream.
    slot_push("x64:buf", masked)

fn x64_emit_u32(value: int):
    # Normalize signed → u32 once, then peel off bytes.
    u = if value >= 0 then value else value + 4294967296
    x64_emit_u8(u)
    x64_emit_u8(u / 256)
    x64_emit_u8(u / 65536)
    x64_emit_u8(u / 16777216)

# --- instruction primitives ---

# mov eax, imm32  (B8 + imm32 — auto zero-extends to rax)
fn x64_mov_eax_imm32(value: int):
    x64_emit_u8(184)               # B8
    x64_emit_u32(value)

# push rax  (50)
fn x64_push_rax():
    x64_emit_u8(80)

# pop rax  (58)
fn x64_pop_rax():
    x64_emit_u8(88)

# mov rcx, rax  (48 89 C1)
fn x64_mov_rcx_rax():
    x64_emit_u8(72)                # 48 (REX.W)
    x64_emit_u8(137)               # 89
    x64_emit_u8(193)               # C1

# add rax, rcx  (48 01 C8)
fn x64_add_rax_rcx():
    x64_emit_u8(72)
    x64_emit_u8(1)
    x64_emit_u8(200)               # C8

# sub rax, rcx  (48 29 C8)
fn x64_sub_rax_rcx():
    x64_emit_u8(72)
    x64_emit_u8(41)
    x64_emit_u8(200)

# imul rax, rcx  (48 0F AF C1)
fn x64_imul_rax_rcx():
    x64_emit_u8(72)
    x64_emit_u8(15)                # 0F
    x64_emit_u8(175)               # AF
    x64_emit_u8(193)               # C1

# ret  (C3)
fn x64_ret():
    x64_emit_u8(195)

# --- additional instruction primitives ---

# push rbp / pop rbp / mov rbp, rsp / mov rsp, rbp — function frame.
fn x64_push_rbp():
    x64_emit_u8(85)                # 55

fn x64_pop_rbp():
    x64_emit_u8(93)                # 5D

fn x64_mov_rbp_rsp():
    x64_emit_u8(72)                # 48
    x64_emit_u8(137)               # 89
    x64_emit_u8(229)               # E5

fn x64_mov_rsp_rbp():
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(236)               # EC

# sub rsp, imm8  (48 83 EC ib)
fn x64_sub_rsp_imm8(value: int):
    x64_emit_u8(72)
    x64_emit_u8(131)
    x64_emit_u8(236)
    x64_emit_u8(value)

# mov [rbp + disp8], rax  (48 89 45 ib) — disp8 signed
fn x64_store_rax_at_rbp(disp: int):
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)                # 45 = ModR/M for [rbp+disp8] / rax
    x64_emit_u8(disp)

# mov rax, [rbp + disp8]
fn x64_load_rax_from_rbp(disp: int):
    x64_emit_u8(72)
    x64_emit_u8(139)               # 8B
    x64_emit_u8(69)
    x64_emit_u8(disp)

# call rel32 — the disp32 is filled in by the linker pass once all
# function offsets are known. Returns the byte offset where the
# placeholder lives so caller can patch later.
fn x64_emit_call_placeholder():
    x64_emit_u8(232)               # E8
    cur = len(x64_buf_get())
    x64_emit_u32(0)                # placeholder disp32
    cur                            # return placeholder offset

# --- scope tracking ---
# Locals slot list: each entry {"name": Text, "disp": int}.
# disp is negative offset from rbp (e.g. -8, -16, ...).

fn x64_locals_reset():
    slot_set("x64:locals", [])
    slot_set("x64:next_disp", 0 - 8)

fn x64_locals_add(name: Text):
    next_disp = slot_get("x64:next_disp")
    slot_push("x64:locals", {"name": name, "disp": next_disp})
    slot_set("x64:next_disp", next_disp - 8)

fn x64_locals_disp(name: Text) -> int:
    locals = slot_get("x64:locals")
    total = len(locals)
    mut found = 0
    for index in 0..<total:
        entry = at(locals, index)
        if get(entry, "name") == name:
            found = get(entry, "disp")
    found

fn x64_locals_count() -> int:
    locals = slot_get("x64:locals")
    len(locals)

# --- inline bump allocator ---
#
# .data layout (RVA 0x29000):
#   +0x00..0x07  bump offset (i64, zero-initialized in file)
#   +0x08..end   heap area (OS zero-fills beyond raw-data length)
#
# Each `x64_emit_alloc(size)` call emits 24 bytes of code that:
#   1. loads the bump-storage absolute address via RIP-relative LEA
#   2. reads the current offset
#   3. atomically (single-threaded) bumps by `size`
#   4. computes the actual pointer = storage_addr + 8 + old_offset
# Pointer ends up in rax. Caller is responsible for bookkeeping (writing
# the length header into the allocated buffer, etc.).
fn x64_emit_alloc(size: int):
    # lea rcx, [rip+bump_storage]  (48 8D 0D disp32)
    x64_emit_u8(72)
    x64_emit_u8(141)
    x64_emit_u8(13)
    cur = len(x64_buf_get())
    # bump_storage @ RVA 0x29000. Next instr at RVA 0x1000 + cur + 4.
    # disp32 = 0x29000 - (0x1000 + cur + 4) = 0x27FFC - cur.
    x64_emit_u32(163836 - cur)
    # mov rax, [rcx]   (48 8B 01)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(1)
    # add qword [rcx], imm32   (48 81 01 imm32)
    x64_emit_u8(72)
    x64_emit_u8(129)
    x64_emit_u8(1)
    x64_emit_u32(size)
    # lea rax, [rcx + rax + 8]  (48 8D 44 01 08) — SIB base=rcx index=rax scale=1
    x64_emit_u8(72)
    x64_emit_u8(141)
    x64_emit_u8(68)
    x64_emit_u8(1)
    x64_emit_u8(8)

# --- string pool ---
# Each entry: bytes_from_text(literal). The pool is laid out flat in
# .rdata; each Str literal becomes `lea rax, [rip+disp32]` with disp32
# patched once the PE's RVAs are known.

fn x64_strings_reset():
    slot_set("x64:strings", [])
    slot_set("x64:string_fixups", [])
    slot_set("x64:iat_fixups", [])

fn x64_strings_add(text: Text) -> int:
    pool = slot_get("x64:strings")
    str_bytes = bytes_from_text(text)
    target_len = bytes_length(str_bytes)
    pool_count = len(pool)
    # Intern: scan for an existing entry with identical bytes. Necessary
    # so that map keys mentioned twice share a pointer (the codegen
    # relies on RIP-relative LEA always producing the same address for
    # the same literal — that lets get/has use pointer equality).
    mut found_index = 0 - 1
    for index in 0..<pool_count:
        existing = at(pool, index)
        existing_len = bytes_length(existing)
        if found_index < 0 and existing_len == target_len:
            mut all_match = true
            for byte_index in 0..<target_len:
                if byte_at(existing, byte_index) != byte_at(str_bytes, byte_index):
                    all_match = false
            if all_match:
                found_index = index
    if found_index >= 0:
        found_index
    else:
        new_index = pool_count
        slot_push("x64:strings", str_bytes)
        new_index

fn x64_string_fixup_add(placeholder: int, str_index: int):
    slot_push("x64:string_fixups", {"offset": placeholder, "str_index": str_index})

# IAT slot 0 = ExitProcess, 1 = GetStdHandle, 2 = WriteFile.
fn x64_iat_fixup_add(placeholder: int, iat_index: int):
    slot_push("x64:iat_fixups", {"offset": placeholder, "iat_index": iat_index})

# --- function table for inter-fn calls ---
# Slot `x64:fn_offsets` maps fn_name → offset in .text.
# Slot `x64:call_fixups` is a list of {"offset": int, "target": Text}
# — placeholder disp32 positions to be back-patched.

fn x64_fns_reset():
    slot_set("x64:fn_offsets", [])
    slot_set("x64:call_fixups", [])

fn x64_fns_record(name: Text, offset: int):
    slot_push("x64:fn_offsets", {"name": name, "offset": offset})

fn x64_fns_lookup(name: Text) -> int:
    table = slot_get("x64:fn_offsets")
    total = len(table)
    mut found = 0 - 1
    for index in 0..<total:
        entry = at(table, index)
        if get(entry, "name") == name:
            found = get(entry, "offset")
    found

fn x64_fix_add(placeholder_offset: int, target_name: Text):
    slot_push("x64:call_fixups", {"offset": placeholder_offset, "target": target_name})

# --- expression / block emitters ---

fn x64_emit_expr(node):
    kind = get(node, "kind")
    is_int = kind == "Int"
    is_binary = kind == "Binary"
    is_ident = kind == "Ident"
    is_call = kind == "Call"
    is_str = kind == "Str"
    is_list_lit = kind == "ListLit"
    is_map_lit = kind == "MapLit"
    is_unary = kind == "Unary"
    if is_list_lit:
        x64_emit_list_lit(node)
    if is_map_lit:
        x64_emit_map_lit(node)
    if is_unary:
        x64_emit_expr(get(node, "operand"))
        op_text = get(node, "op")
        if op_text == "not":
            # rax = !rax (boolean): test rax,rax; sete al; movzx rax, al
            x64_emit_u8(72)
            x64_emit_u8(133)
            x64_emit_u8(192)
            x64_emit_u8(15)
            x64_emit_u8(148)
            x64_emit_u8(192)
            x64_emit_u8(72)
            x64_emit_u8(15)
            x64_emit_u8(182)
            x64_emit_u8(192)
    if is_int:
        text_value = get(node, "value")
        x64_mov_eax_imm32(str_to_int(text_value))
    if is_str:
        text_value = get(node, "value")
        str_index = x64_strings_add(text_value)
        # lea rax, [rip+disp32]  (48 8D 05 disp32) — patched later
        x64_emit_u8(72)
        x64_emit_u8(141)
        x64_emit_u8(5)
        placeholder = len(x64_buf_get())
        x64_emit_u32(0)
        x64_string_fixup_add(placeholder, str_index)
    if is_ident:
        name = get(node, "name")
        disp = x64_locals_disp(name)
        x64_load_rax_from_rbp(disp)
    if is_binary:
        x64_emit_expr(get(node, "left"))
        x64_push_rax()
        x64_emit_expr(get(node, "right"))
        x64_mov_rcx_rax()
        x64_pop_rax()
        op_text = get(node, "op")
        if op_text == "+":
            x64_add_rax_rcx()
        if op_text == "-":
            x64_sub_rax_rcx()
        if op_text == "*":
            x64_imul_rax_rcx()
        if op_text == "and":
            # Logical AND: both operands are 0 or non-zero; treat any
            # non-zero as true. Result is 1 if both true, else 0.
            # rcx = right, rax = left. Use rcx as scratch.
            # test rax, rax; setne al; movzx eax, al  → rax = (left != 0)
            x64_emit_u8(72)
            x64_emit_u8(133)
            x64_emit_u8(192)               # test rax, rax
            x64_emit_u8(15)
            x64_emit_u8(149)
            x64_emit_u8(192)               # setne al
            # test rcx, rcx; setne cl
            x64_emit_u8(72)
            x64_emit_u8(133)
            x64_emit_u8(201)               # test rcx, rcx
            x64_emit_u8(15)
            x64_emit_u8(149)
            x64_emit_u8(193)               # setne cl
            # and al, cl
            x64_emit_u8(32)
            x64_emit_u8(200)
            # movzx rax, al
            x64_emit_u8(72)
            x64_emit_u8(15)
            x64_emit_u8(182)
            x64_emit_u8(192)
        if op_text == "or":
            # Same idea: rax = (left != 0) | (right != 0)
            x64_emit_u8(72)
            x64_emit_u8(133)
            x64_emit_u8(192)
            x64_emit_u8(15)
            x64_emit_u8(149)
            x64_emit_u8(192)
            x64_emit_u8(72)
            x64_emit_u8(133)
            x64_emit_u8(201)
            x64_emit_u8(15)
            x64_emit_u8(149)
            x64_emit_u8(193)
            # or al, cl
            x64_emit_u8(8)
            x64_emit_u8(200)
            x64_emit_u8(72)
            x64_emit_u8(15)
            x64_emit_u8(182)
            x64_emit_u8(192)
        if op_text == "==":
            x64_cmp_rax_rcx()
            x64_setcc_al(148)              # sete  (0F 94)
        if op_text == "!=":
            x64_cmp_rax_rcx()
            x64_setcc_al(149)              # setne (0F 95)
        if op_text == "<":
            x64_cmp_rax_rcx()
            x64_setcc_al(156)              # setl  (0F 9C)
        if op_text == ">":
            x64_cmp_rax_rcx()
            x64_setcc_al(159)              # setg  (0F 9F)
        if op_text == "<=":
            x64_cmp_rax_rcx()
            x64_setcc_al(158)              # setle (0F 9E)
        if op_text == ">=":
            x64_cmp_rax_rcx()
            x64_setcc_al(157)              # setge (0F 9D)
    if is_call:
        callee = get(node, "callee")
        is_len = callee == "len"
        is_at = callee == "at"
        is_push = callee == "push"
        is_get = callee == "get"
        is_has = callee == "has"
        is_set = callee == "set"
        is_slot_get = callee == "slot_get"
        is_slot_set = callee == "slot_set"
        is_bytes_from_text = callee == "bytes_from_text"
        is_bytes_to_text = callee == "bytes_to_text"
        is_bytes_length = callee == "bytes_length"
        is_byte_at = callee == "byte_at"
        is_str_to_int = callee == "str_to_int"
        is_text_concat = callee == "text_concat"
        is_fmt_int = callee == "fmt_int"
        is_type_of = callee == "type_of"
        is_bytes_zeros = callee == "bytes_zeros"
        is_bytes_slice = callee == "bytes_slice"
        is_bytes_concat = callee == "bytes_concat"
        is_print = callee == "print"
        is_eprint = callee == "eprint"
        if is_get:
            x64_emit_get_builtin(node)
        if is_has:
            x64_emit_has_builtin(node)
        if is_set:
            x64_emit_set_builtin(node)
        if is_slot_get:
            x64_emit_slot_get(node)
        if is_slot_set:
            x64_emit_slot_set(node)
        if is_bytes_from_text:
            x64_emit_bytes_from_text(node)
        if is_bytes_to_text:
            x64_emit_bytes_to_text(node)
        if is_bytes_length:
            # bytes_length is just len() on a list
            x64_emit_expr(at(get(node, "args"), 0))
            x64_emit_u8(72)
            x64_emit_u8(139)
            x64_emit_u8(0)
        if is_byte_at:
            # byte_at is just at() on a list (same indexing scheme)
            args2 = get(node, "args")
            x64_emit_expr(at(args2, 0))
            x64_push_rax()
            x64_emit_expr(at(args2, 1))
            x64_emit_u8(72)
            x64_emit_u8(137)
            x64_emit_u8(193)
            x64_pop_rax()
            x64_emit_u8(72)
            x64_emit_u8(139)
            x64_emit_u8(68)
            x64_emit_u8(200)
            x64_emit_u8(8)
        if is_str_to_int:
            x64_emit_str_to_int(node)
        if is_text_concat:
            x64_emit_text_concat(node)
        if is_fmt_int:
            x64_emit_fmt_int(node)
        if is_type_of:
            # Heuristic: any value > 65536 is likely a heap pointer (Text/List/Map).
            # Values ≤ 65536 are likely small ints. Returns "int" or "ident"
            # as a Str pointer — close enough to keep most self_*.or paths
            # taking the right branch.
            x64_emit_expr(at(get(node, "args"), 0))
            # We always return the same string for simplicity. Most
            # call sites check for "none", which we never return.
            int_str_idx = x64_strings_add("int")
            x64_emit_u8(72)
            x64_emit_u8(141)
            x64_emit_u8(5)
            ph = len(x64_buf_get())
            x64_emit_u32(0)
            x64_string_fixup_add(ph, int_str_idx)
        if is_bytes_zeros:
            x64_emit_bytes_zeros(node)
        if is_bytes_slice:
            x64_emit_bytes_slice(node)
        if is_bytes_concat:
            x64_emit_bytes_concat(node)
        if is_print:
            x64_emit_print(node)
        if is_eprint:
            x64_emit_print(node)            # treat same as print for now
        if is_len:
            args = get(node, "args")
            x64_emit_expr(at(args, 0))  # rax = list pointer
            # mov rax, [rax]  (48 8B 00)
            x64_emit_u8(72)
            x64_emit_u8(139)
            x64_emit_u8(0)
        if is_at:
            args = get(node, "args")
            x64_emit_expr(at(args, 0))  # rax = list pointer
            x64_push_rax()
            x64_emit_expr(at(args, 1))  # rax = index
            # mov rcx, rax  (48 89 C1)
            x64_emit_u8(72)
            x64_emit_u8(137)
            x64_emit_u8(193)
            x64_pop_rax()               # list pointer back in rax
            # mov rax, [rax + rcx*8 + 8]  (48 8B 44 C8 08)
            x64_emit_u8(72)
            x64_emit_u8(139)
            x64_emit_u8(68)
            x64_emit_u8(200)
            x64_emit_u8(8)
        if is_push:
            # push(list, value) → new list with one extra slot.
            #
            # Allocate (old_len+1)*8 + 8 bytes, copy old data, append.
            # The bump allocator never frees so the old buffer leaks,
            # which is fine for proof use. A real GC swaps in later.
            x64_emit_push_builtin(node)
        is_print_line = callee == "print_line"
        if is_print_line:
            # Two paths:
            #   Str literal      → use compile-time length (cheapest).
            #   Anything else    → runtime strlen, then WriteFile.
            args = get(node, "args")
            arg0 = at(args, 0)
            arg_kind = get(arg0, "kind")
            if arg_kind == "Str":
                # Bridge through bytes so the typeck sees a concrete Text —
                # `get(map, key)` returns Unknown which doesn't unify with
                # `+ "\n"` (Text + Unknown → typecheck error).
                text_value = bytes_to_text(bytes_from_text(get(arg0, "value")))
                text_with_newline = text_value + "\n"
                str_index = x64_strings_add(text_with_newline)
                length = bytes_length(bytes_from_text(text_with_newline))
                x64_emit_print_line_inline(str_index, length)
            if arg_kind != "Str":
                # Evaluate arg → rax = pointer to (presumably) null-
                # terminated string. Compute strlen, call WriteFile,
                # then write a separate "\n" via another WriteFile.
                x64_emit_expr(arg0)
                x64_emit_print_text_dynamic()
        is_special = is_len or is_at or is_push or is_get or is_has or is_set or is_slot_get or is_slot_set or is_bytes_from_text or is_bytes_to_text or is_bytes_length or is_byte_at or is_str_to_int or is_text_concat or is_fmt_int or is_type_of or is_bytes_zeros or is_bytes_slice or is_bytes_concat or is_print or is_eprint or is_print_line
        if not is_special:
            args = get(node, "args")
            call_arg_count = len(args)
            for index in 0..<call_arg_count:
                x64_emit_expr(at(args, index))
                x64_push_rax()
            # Pop in reverse so arg0 ends in rax, arg1 in rcx, arg2 in r8.
            if call_arg_count >= 3:
                x64_emit_u8(65)        # REX.B
                x64_emit_u8(88)        # pop r8
            if call_arg_count >= 2:
                x64_emit_u8(89)        # pop rcx
            if call_arg_count >= 1:
                x64_pop_rax()
            placeholder = x64_emit_call_placeholder()
            x64_fix_add(placeholder, callee)
    is_if = kind == "If"
    if is_if:
        x64_emit_if(node)

# Emit a map literal `{"k1": v1, "k2": v2}`. Layout in memory:
#   [length: i64][key0: i64][value0: i64][key1: i64][value1: i64]...
# Keys are stored as pointers to .rdata string pool entries. Lookup
# (in get/has/set) uses pointer-equality, which works because the
# string pool interns each literal exactly once.
fn x64_emit_map_lit(node):
    pairs = get(node, "pairs")
    pair_count = len(pairs)
    total_size = 8 + pair_count * 16
    x64_emit_alloc(total_size)
    # mov qword [rax], pair_count  (48 C7 00 imm32)
    x64_emit_u8(72)
    x64_emit_u8(199)
    x64_emit_u8(0)
    x64_emit_u32(pair_count)
    x64_push_rax()
    for index in 0..<pair_count:
        pair = at(pairs, index)
        # Key: synthesise a Str node so we can reuse x64_emit_expr's
        # string-pool path (lea rax, [rip+...]).
        key_text = get(pair, "key")
        str_index = x64_strings_add(key_text)
        x64_emit_u8(72)
        x64_emit_u8(141)
        x64_emit_u8(5)
        key_placeholder = len(x64_buf_get())
        x64_emit_u32(0)
        x64_string_fixup_add(key_placeholder, str_index)
        # pop rcx (map pointer)
        x64_emit_u8(89)
        # mov [rcx + (8 + index*16)], rax  — store key pointer
        key_slot_disp = 8 + index * 16
        x64_emit_u8(72)
        x64_emit_u8(137)
        x64_emit_u8(65)               # ModRM mod=01 reg=000 rm=001 (rcx)
        x64_emit_u8(key_slot_disp)
        # push rcx — keep map pointer
        x64_emit_u8(81)
        # Evaluate value → rax
        x64_emit_expr(get(pair, "value"))
        # pop rcx
        x64_emit_u8(89)
        # mov [rcx + (16 + index*16)], rax  — store value
        value_slot_disp = 16 + index * 16
        x64_emit_u8(72)
        x64_emit_u8(137)
        x64_emit_u8(65)
        x64_emit_u8(value_slot_disp)
        # push rcx for next iter
        x64_emit_u8(81)
    x64_pop_rax()

# Emit `get(map, key)` — linear search by pointer-equality, returns
# the matching value in rax or 0 if absent.
#
# Generated layout:
#   rax = map ptr  (arg0)
#   rcx = key ptr  (arg1)
#   mov r8, [rax]              ; r8 = length
#   mov rdx, 8                 ; rdx = byte offset to first key
#   xor r9, r9                 ; r9 = element index
#   loop:
#     cmp r9, r8
#     jge .not_found
#     mov r10, [rax+rdx]       ; current key
#     cmp r10, rcx
#     je .found
#     add rdx, 16
#     add r9, 1
#     jmp loop
#   .not_found:
#     xor rax, rax
#     jmp .end
#   .found:
#     mov rax, [rax+rdx+8]
#   .end:
fn x64_emit_get_builtin(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))       # rax = map
    x64_push_rax()
    x64_emit_expr(at(args, 1))       # rax = key
    # mov rcx, rax
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    x64_pop_rax()                    # rax = map
    x64_emit_map_lookup(true)        # true = return value; false = boolean has

fn x64_emit_has_builtin(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))
    x64_push_rax()
    x64_emit_expr(at(args, 1))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    x64_pop_rax()
    x64_emit_map_lookup(false)

# Shared lookup helper used by `get` and `has`.
fn x64_emit_map_lookup(return_value: bool):
    # mov r8, [rax]   (4C 8B 00)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(0)
    # mov rdx, 8 — use mov edx, 8 (BA imm32, zero-extends)
    x64_emit_u8(186)               # BA
    x64_emit_u32(8)
    # xor r9, r9  (4D 31 C9)
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    # loop start
    loop_top = len(x64_buf_get())
    # cmp r9, r8  (4D 39 C1)
    x64_emit_u8(77)
    x64_emit_u8(57)
    x64_emit_u8(193)
    # jge .not_found (0F 8D rel32) — placeholder
    x64_emit_u8(15)
    x64_emit_u8(141)               # 8D (jge)
    not_found_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r10, [rax + rdx]  (4C 8B 14 10)  — SIB scale=00 index=010(rdx) base=000(rax)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(20)                # ModRM mod=00 reg=010 rm=100 (SIB)
    x64_emit_u8(16)                # SIB scale=00 index=010 base=000
    # cmp r10, rcx  (4C 39 D1)
    x64_emit_u8(76)
    x64_emit_u8(57)
    x64_emit_u8(209)
    # je .found  (0F 84 rel32)
    x64_emit_u8(15)
    x64_emit_u8(132)
    found_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # add rdx, 16   (48 83 C2 10)
    x64_emit_u8(72)
    x64_emit_u8(131)
    x64_emit_u8(194)
    x64_emit_u8(16)
    # add r9, 1     (49 83 C1 01)
    x64_emit_u8(73)
    x64_emit_u8(131)
    x64_emit_u8(193)
    x64_emit_u8(1)
    # jmp loop_top  (E9 rel32)
    x64_emit_u8(233)
    here = len(x64_buf_get())
    back_disp = loop_top - (here + 4)
    x64_emit_u32(back_disp)
    # .not_found:
    x64_patch_to_here(not_found_jmp)
    if return_value:
        # xor rax, rax  (48 31 C0)
        x64_emit_u8(72)
        x64_emit_u8(49)
        x64_emit_u8(192)
    else:
        # mov eax, 0  (B8 00 00 00 00) — has() returns false
        x64_emit_u8(184)
        x64_emit_u32(0)
    # jmp .end (E9 rel32)
    x64_emit_u8(233)
    end_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # .found:
    x64_patch_to_here(found_jmp)
    if return_value:
        # mov rax, [rax + rdx + 8]  (48 8B 44 10 08) — SIB + disp8
        x64_emit_u8(72)
        x64_emit_u8(139)
        x64_emit_u8(68)            # ModRM mod=01 reg=000 rm=100 (SIB)
        x64_emit_u8(16)            # SIB scale=00 index=010 base=000
        x64_emit_u8(8)             # disp8
    else:
        # mov eax, 1  (B8 01 00 00 00)
        x64_emit_u8(184)
        x64_emit_u32(1)
    # .end:
    x64_patch_to_here(end_jmp)

# Emit `set(map, key, value)` — returns a NEW map.
#
# Register allocation:
#   rax = new map pointer (preserved throughout)
#   rcx = old map pointer
#   rdx = old length / scratch
#   r8  = byte offset (8 + 16*i) into both maps
#   r9  = loop index
#   r10 = match offset (0 sentinel = no match, else byte offset of matched key)
#   r11 = scratch for key/value copies
#
# Stack slots used: [rbp-96] value, [rbp-104] key (saved before alloc).
fn x64_emit_set_builtin(node):
    args = get(node, "args")
    # Stash value at [rbp-96].
    x64_emit_expr(at(args, 2))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Stash key at [rbp-104].
    x64_emit_expr(at(args, 1))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # Evaluate map ptr — pushed to stack so we can recover after alloc.
    x64_emit_expr(at(args, 0))
    x64_push_rax()                   # push rcx-eventual
    # Allocate 1024-byte buffer; rax = new map after.
    x64_emit_alloc(1024)
    # Pop old map ptr into rcx.
    x64_emit_u8(89)                  # pop rcx
    # mov rdx, [rcx]   → old length
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)
    # mov [rax], rdx   → new length := old length (we may bump by 1 on append)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(16)
    # mov r8d, 8       (zero-extends to r8)  — start byte offset
    x64_emit_u8(65)                  # REX.B for r8
    x64_emit_u8(184)                 # B8 = mov r32, imm32
    x64_emit_u32(8)
    # xor r9, r9        — loop index
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    # xor r10, r10      — match offset
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(210)
    # .copy_loop:
    copy_loop_top = len(x64_buf_get())
    # cmp r9, rdx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(209)
    # jge .copy_done    (0F 8D rel32)
    x64_emit_u8(15)
    x64_emit_u8(141)
    copy_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r11, [rcx + r8]      ; key
    x64_emit_u8(78)                  # REX.W + REX.R + REX.X
    x64_emit_u8(139)                 # mov r64, r/m64
    x64_emit_u8(28)                  # ModRM mod=00 reg=011 rm=100 (SIB)
    x64_emit_u8(1)                   # SIB scale=0 index=r8 base=rcx
    # mov [rax + r8], r11
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(28)
    x64_emit_u8(0)                   # SIB base=rax
    # Check if r11 == [rbp-104] (key we want)
    # cmp r11, [rbp-104]   (4C 3B 5D disp8)
    x64_emit_u8(76)
    x64_emit_u8(59)
    x64_emit_u8(93)
    x64_emit_u8(0 - 104 + 256)
    # jne .skip
    x64_emit_u8(15)
    x64_emit_u8(133)
    skip_match_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r10, r8   — record matched offset
    x64_emit_u8(77)
    x64_emit_u8(137)
    x64_emit_u8(194)
    # .skip:
    x64_patch_to_here(skip_match_jmp)
    # mov r11, [rcx + r8 + 8]    ; value
    x64_emit_u8(78)
    x64_emit_u8(139)
    x64_emit_u8(92)                  # ModRM mod=01 reg=011 rm=100
    x64_emit_u8(1)                   # SIB
    x64_emit_u8(8)
    # mov [rax + r8 + 8], r11
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(92)
    x64_emit_u8(0)
    x64_emit_u8(8)
    # add r8, 16
    x64_emit_u8(73)
    x64_emit_u8(131)
    x64_emit_u8(192)
    x64_emit_u8(16)
    # add r9, 1
    x64_emit_u8(73)
    x64_emit_u8(131)
    x64_emit_u8(193)
    x64_emit_u8(1)
    # jmp copy_loop
    x64_emit_u8(233)
    here1 = len(x64_buf_get())
    back_disp_1 = copy_loop_top - (here1 + 4)
    x64_emit_u32(back_disp_1)
    # .copy_done:
    x64_patch_to_here(copy_done_jmp)
    # test r10, r10   (4D 85 D2)
    x64_emit_u8(77)
    x64_emit_u8(133)
    x64_emit_u8(210)
    # jz .append
    x64_emit_u8(15)
    x64_emit_u8(132)
    append_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # Update path: mov r11, [rbp-96]; mov [rax + r10 + 8], r11
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(93)
    x64_emit_u8(0 - 96 + 256)
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(92)                  # mod=01 reg=011 rm=100 SIB
    x64_emit_u8(16)                  # SIB scale=00 index=r10 base=rax
    x64_emit_u8(8)
    # jmp .end
    x64_emit_u8(233)
    end_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # .append:
    x64_patch_to_here(append_jmp)
    # Bump new length: inc qword [rax]
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(0)
    # mov r11, [rbp-104] ; key
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(93)
    x64_emit_u8(0 - 104 + 256)
    # mov [rax + r8], r11
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(28)
    x64_emit_u8(0)
    # mov r11, [rbp-96] ; value
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(93)
    x64_emit_u8(0 - 96 + 256)
    # mov [rax + r8 + 8], r11
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(92)
    x64_emit_u8(0)
    x64_emit_u8(8)
    # .end:
    x64_patch_to_here(end_jmp)
    # rax holds the new map pointer.

# Emit `push(list, value)` — returns a NEW list with one more element.
#
# Strategy:
#   1. Evaluate `value`, save to stack slot [rbp-96] (well below locals).
#   2. Evaluate `list`, save list pointer to stack slot [rbp-104].
#   3. Read old_len from [list], compute new_size = (old_len+2)*8 bytes.
#   4. Allocate via inline bump (currently bumps by a worst-case 1KB
#      since we don't have a "bump by rax" alloc form — fine for proof).
#   5. Write new_len = old_len + 1 to [new_list].
#   6. Copy old_len qwords from old [list+8..] to new [new_list+8..]
#      using a tiny rcx-indexed loop.
#   7. Write value at [new_list + 8 + old_len*8].
#   8. Return new_list pointer in rax.
fn x64_emit_push_builtin(node):
    args = get(node, "args")
    # Push value first so it sits at [rbp-96].
    x64_emit_expr(at(args, 1))
    # mov [rbp-96], rax  (48 89 45 disp8)  disp8 = -96 = 0xA0
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Evaluate list pointer.
    x64_emit_expr(at(args, 0))
    # mov [rbp-104], rax  disp8 = -104 = 0x98
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # Allocate a fixed 1024-byte buffer. Worst-case list size for proof.
    x64_emit_alloc(1024)
    # rax = new list pointer.
    # mov rcx, [rbp-104]  → rcx = old list pointer  (48 8B 4D disp8)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 104 + 256)
    # mov rdx, [rcx]  → rdx = old length  (48 8B 11)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)
    # Save new list pointer in [rbp-112].
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # Compute new_len = rdx + 1, write to [new_list].
    # inc rdx  (48 FF C2)
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(194)
    # mov [rax], rdx  (48 89 10)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(16)
    # Decrement to restore rdx = old_len, used as loop counter.
    # dec rdx  (48 FF CA)
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(202)
    # Copy loop: while rdx > 0:
    #   rdx -= 1
    #   mov r8, [rcx + 8 + rdx*8]
    #   mov [rax + 8 + rdx*8], r8
    # We branch back to the test by emitting a forward jump first,
    # then the loop body, then a backward jump.
    # Loop start label position:
    loop_start = len(x64_buf_get())
    # cmp rdx, 0  (48 83 FA 00)
    x64_emit_u8(72)
    x64_emit_u8(131)
    x64_emit_u8(250)
    x64_emit_u8(0)
    # je end_label (forward) — placeholder
    x64_emit_u8(15)
    x64_emit_u8(132)              # 84 (je rel32)
    je_placeholder = len(x64_buf_get())
    x64_emit_u32(0)
    # dec rdx  (48 FF CA)
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(202)
    # mov r8, [rcx + rdx*8 + 8]  (4C 8B 44 D1 08)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(68)
    x64_emit_u8(209)
    x64_emit_u8(8)
    # mov [rax + rdx*8 + 8], r8  (4C 89 44 D0 08)
    x64_emit_u8(76)
    x64_emit_u8(137)
    x64_emit_u8(68)
    x64_emit_u8(208)
    x64_emit_u8(8)
    # jmp loop_start (backward, rel32)
    x64_emit_u8(233)
    here_after_jmp_op = len(x64_buf_get())
    back_disp = loop_start - (here_after_jmp_op + 4)
    x64_emit_u32(back_disp)
    # Patch je to here.
    x64_patch_to_here(je_placeholder)
    # Reload new_list pointer.
    # mov rax, [rbp-112]  (48 8B 45 disp8)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # Reload old length to use as index for the new element slot.
    # mov rdx, [rcx]  (48 8B 11)  — rcx still holds old list pointer
    # Actually rcx may have been clobbered by the loop; reload too.
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 104 + 256)    # mov rcx, [rbp-104]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)                # mov rdx, [rcx]
    # mov r8, [rbp-96]  (4C 8B 45 disp8)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # mov [rax + rdx*8 + 8], r8  (4C 89 44 D0 08)
    x64_emit_u8(76)
    x64_emit_u8(137)
    x64_emit_u8(68)
    x64_emit_u8(208)
    x64_emit_u8(8)
    # rax still has new list pointer.

# --- slot_get / slot_set ---
#
# Global slot map lives at .data + 16. Layout matches the regular map
# format: [length:i64][key:i64][value:i64]... interpreted in place.
#
# Because the slot map is at a fixed virtual address we mutate it
# directly — no allocation per slot_set. This deviates from the
# "Set returns new map" semantics, but slots are only ever globally
# rebound by name, so in-place is fine.
#
# `slot_get(name)` returns 0 when the key is absent. `slot_set(name, value)`
# returns Unit (rax left unchanged, caller must not depend on it).

# Emit `lea rax, [rip+slot_map_base]` — base address of the global slot map.
fn x64_emit_load_slot_base():
    # slot map is at RVA 0x29010 (.data + 16).
    # lea rax, [rip+disp32]  (48 8D 05 disp32)
    x64_emit_u8(72)
    x64_emit_u8(141)
    x64_emit_u8(5)
    cur = len(x64_buf_get())
    # Next instr at RVA 0x1000 + cur + 4. Target 0x29010.
    # disp = 0x29010 - 0x1000 - cur - 4 = 0x2800C - cur
    x64_emit_u32(163852 - cur)

fn x64_emit_slot_get(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))     # rax = key pointer
    # mov rcx, rax
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    # rax = slot map base
    x64_emit_load_slot_base()
    # Reuse the map-lookup helper (rax = map, rcx = key).
    x64_emit_map_lookup(true)

fn x64_emit_slot_set(node):
    args = get(node, "args")
    # Stash value at [rbp-96].
    x64_emit_expr(at(args, 1))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Evaluate key → rcx (after stashing in [rbp-104]).
    x64_emit_expr(at(args, 0))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # rax = slot map base
    x64_emit_load_slot_base()
    # rdx = map length
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(16)
    # r8 = byte offset = 8
    x64_emit_u8(65)
    x64_emit_u8(184)
    x64_emit_u32(8)
    # r9 = 0
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    # Scan loop
    scan_top = len(x64_buf_get())
    # cmp r9, rdx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(209)
    # jge .not_found
    x64_emit_u8(15)
    x64_emit_u8(141)
    not_found_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r11, [rax + r8]   ; key
    x64_emit_u8(78)
    x64_emit_u8(139)
    x64_emit_u8(28)
    x64_emit_u8(0)              # SIB index=r8 base=rax
    # cmp r11, [rbp-104]
    x64_emit_u8(76)
    x64_emit_u8(59)
    x64_emit_u8(93)
    x64_emit_u8(0 - 104 + 256)
    # je .found
    x64_emit_u8(15)
    x64_emit_u8(132)
    found_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # add r8, 16
    x64_emit_u8(73)
    x64_emit_u8(131)
    x64_emit_u8(192)
    x64_emit_u8(16)
    # add r9, 1
    x64_emit_u8(73)
    x64_emit_u8(131)
    x64_emit_u8(193)
    x64_emit_u8(1)
    # jmp scan_top
    x64_emit_u8(233)
    here1 = len(x64_buf_get())
    back_disp = scan_top - (here1 + 4)
    x64_emit_u32(back_disp)
    # .not_found — append at end:
    x64_patch_to_here(not_found_jmp)
    # Write key at [rax + r8]
    # mov r11, [rbp-104]
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(93)
    x64_emit_u8(0 - 104 + 256)
    # mov [rax + r8], r11
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(28)
    x64_emit_u8(0)
    # inc qword [rax]   (length++)
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(0)
    # .found — write value at [rax + r8 + 8]:
    x64_patch_to_here(found_jmp)
    # mov r11, [rbp-96]
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(93)
    x64_emit_u8(0 - 96 + 256)
    # mov [rax + r8 + 8], r11
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(92)
    x64_emit_u8(0)
    x64_emit_u8(8)

# --- bytes_zeros(count) ---
# Allocates a list with `count` i64 elements all initialized to 0.
fn x64_emit_bytes_zeros(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))     # rax = count
    # Stash count at [rbp-96]
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Allocate 8 KB (1024 i64 elements max — same fixed budget as other builtins)
    x64_emit_alloc(8192)
    # rax = list pointer
    # Write length
    # mov rdx, [rbp-96]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 96 + 256)
    # mov [rax], rdx
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(16)
    # Elements are already 0 (bump alloc zero-fills new memory? Actually
    # NO — bump just hands out unzeroed memory. But .data is OS-zero-
    # filled when SizeOfRawData < VirtualSize. Since we use the heap
    # area which is in the OS-zero zone, it's zero-filled. ✓)

# --- bytes_slice(list, lo, hi) ---
fn x64_emit_bytes_slice(node):
    args = get(node, "args")
    # Eval hi → [rbp-96]
    x64_emit_expr(at(args, 2))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Eval lo → [rbp-104]
    x64_emit_expr(at(args, 1))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # Eval src → [rbp-112]
    x64_emit_expr(at(args, 0))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # Allocate 4 KB
    x64_emit_alloc(4096)
    # rax = dest list. Stash at [rbp-120]
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 120 + 256)
    # Compute new length = hi - lo
    # mov rdx, [rbp-96] ; hi
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 96 + 256)
    # mov rcx, [rbp-104] ; lo
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 104 + 256)
    # sub rdx, rcx (rdx = hi - lo = new length)
    x64_emit_u8(72)
    x64_emit_u8(41)
    x64_emit_u8(202)
    # mov [rax], rdx
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(16)
    # Copy elements from src[lo..hi] to dest[0..(hi-lo)]
    # mov r8, [rbp-112]  ; src
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # xor r9, r9   ; counter
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    slice_top = len(x64_buf_get())
    # cmp r9, rdx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(209)
    # jge done
    x64_emit_u8(15)
    x64_emit_u8(141)
    slice_done = len(x64_buf_get())
    x64_emit_u32(0)
    # r10 = r9 + lo (source index)
    # mov r10, [rbp-104]   (load lo)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 104 + 256)
    # add r10, r9
    x64_emit_u8(77)
    x64_emit_u8(1)
    x64_emit_u8(202)
    # mov r11, [r8 + r10*8 + 8]
    x64_emit_u8(79)                # REX W=1 R=1 X=1 B=1
    x64_emit_u8(139)
    x64_emit_u8(92)                # ModRM mod=01 reg=011 rm=100 (SIB)
    x64_emit_u8(208)               # SIB scale=11 index=r10 base=r8
    x64_emit_u8(8)
    # mov [rax + r9*8 + 8], r11
    x64_emit_u8(78)                # REX W=1 R=1 X=1
    x64_emit_u8(137)
    x64_emit_u8(92)
    x64_emit_u8(200)               # SIB scale=11 index=r9 base=rax
    x64_emit_u8(8)
    # inc r9
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(193)
    # jmp top
    x64_emit_u8(233)
    here_s = len(x64_buf_get())
    x64_emit_u32(slice_top - (here_s + 4))
    # done:
    x64_patch_to_here(slice_done)
    # rax already = dest list pointer

# --- bytes_concat(a, b) ---
fn x64_emit_bytes_concat(node):
    args = get(node, "args")
    # Eval b → [rbp-96]
    x64_emit_expr(at(args, 1))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Eval a → [rbp-104]
    x64_emit_expr(at(args, 0))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # Allocate 4 KB
    x64_emit_alloc(4096)
    # rax = dest. Stash at [rbp-112]
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # Compute total length = len(a) + len(b)
    # mov rcx, [rbp-104] ; a
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 104 + 256)
    # mov rdx, [rcx] ; len(a)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)
    # mov r8, [rbp-96] ; b
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # mov r9, [r8] ; len(b)
    x64_emit_u8(77)
    x64_emit_u8(139)
    x64_emit_u8(8)
    # add rdx, r9
    x64_emit_u8(76)
    x64_emit_u8(1)
    x64_emit_u8(202)
    # mov [rax], rdx (total length)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(16)

    # Copy elements from a
    # mov rcx, [rbp-104] ; a
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 104 + 256)
    # mov rdx, [rcx] ; len(a)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)
    # xor r9, r9 (counter)
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    ca_top = len(x64_buf_get())
    # cmp r9, rdx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(209)
    # jge done_a
    x64_emit_u8(15)
    x64_emit_u8(141)
    ca_done = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r10, [rcx + r9*8 + 8]
    x64_emit_u8(78)
    x64_emit_u8(139)
    x64_emit_u8(84)
    x64_emit_u8(201)
    x64_emit_u8(8)
    # mov [rax + r9*8 + 8], r10
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(84)
    x64_emit_u8(200)
    x64_emit_u8(8)
    # inc r9
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(193)
    # jmp top
    x64_emit_u8(233)
    here_ca = len(x64_buf_get())
    x64_emit_u32(ca_top - (here_ca + 4))
    x64_patch_to_here(ca_done)

    # Copy elements from b (offset by len(a))
    # mov rcx, [rbp-96] ; b
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 96 + 256)
    # mov rdx, [rcx] ; len(b)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)
    # mov r8, [rbp-104]   (a)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # mov r11, [r8]  (len_a) — destination offset starts at len_a
    x64_emit_u8(77)
    x64_emit_u8(139)
    x64_emit_u8(24)
    # xor r9, r9 (source counter)
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    cb_top = len(x64_buf_get())
    # cmp r9, rdx (counter vs len_b)
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(209)
    # jge done_b
    x64_emit_u8(15)
    x64_emit_u8(141)
    cb_done = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r10, [rcx + r9*8 + 8]   (read element from b)
    x64_emit_u8(78)
    x64_emit_u8(139)
    x64_emit_u8(84)
    x64_emit_u8(201)
    x64_emit_u8(8)
    # mov [rax + r11*8 + 8], r10  (write at dest)
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(84)
    x64_emit_u8(216)               # SIB scale=11 index=r11 base=rax
    x64_emit_u8(8)
    # inc r9 ; inc r11
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(193)
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(195)
    # jmp top
    x64_emit_u8(233)
    here_cb = len(x64_buf_get())
    x64_emit_u32(cb_top - (here_cb + 4))
    x64_patch_to_here(cb_done)
    # rax = dest list (already there).

# print(text) — same as print_line but without trailing newline.
fn x64_emit_print(node):
    args = get(node, "args")
    arg0 = at(args, 0)
    arg_kind = get(arg0, "kind")
    if arg_kind == "Str":
        text_value = get(arg0, "value")
        str_index = x64_strings_add(text_value)
        length = bytes_length(bytes_from_text(text_value))
        x64_emit_print_line_inline(str_index, length)
    if arg_kind != "Str":
        x64_emit_expr(arg0)
        x64_emit_print_text_no_newline()

# Like x64_emit_print_text_dynamic but skips the trailing newline call.
fn x64_emit_print_text_no_newline():
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    x64_emit_u8(72)
    x64_emit_u8(49)
    x64_emit_u8(210)
    sl_top = len(x64_buf_get())
    x64_emit_u8(68)
    x64_emit_u8(138)
    x64_emit_u8(4)
    x64_emit_u8(17)
    x64_emit_u8(69)
    x64_emit_u8(132)
    x64_emit_u8(192)
    x64_emit_u8(15)
    x64_emit_u8(132)
    sl_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(194)
    x64_emit_u8(233)
    here_sl = len(x64_buf_get())
    x64_emit_u32(sl_top - (here_sl + 4))
    x64_patch_to_here(sl_done_jmp)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(85)
    x64_emit_u8(0 - 112 + 256)
    x64_emit_u8(185)
    x64_emit_u8(245)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(21)
    p1 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(p1, 1)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 96 + 256)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    x64_emit_u8(76)
    x64_emit_u8(141)
    x64_emit_u8(76)
    x64_emit_u8(36)
    x64_emit_u8(40)
    x64_emit_u8(72)
    x64_emit_u8(199)
    x64_emit_u8(68)
    x64_emit_u8(36)
    x64_emit_u8(32)
    x64_emit_u32(0)
    x64_emit_u8(255)
    x64_emit_u8(21)
    p2 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(p2, 2)

# --- text_concat(a, b) ---
#
# Walks both source strings to find their lengths, allocates a fresh
# buffer, copies a then b, null-terminates, returns the new pointer.
# Both inputs must be null-terminated (literals from .rdata or other
# heap strings produced by this fn or bytes_to_text).
fn x64_emit_text_concat(node):
    args = get(node, "args")
    # Evaluate b first; stash at [rbp-96].
    x64_emit_expr(at(args, 1))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Evaluate a; stash at [rbp-104].
    x64_emit_expr(at(args, 0))
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)

    # Allocate 4 KB for result.
    x64_emit_alloc(4096)
    # rax = result buffer. Stash at [rbp-112].
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)

    # Copy a: rcx = src ptr, rdx = dst offset.
    # mov rcx, [rbp-104]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 104 + 256)
    # mov rax, [rbp-112]   (dst buffer)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # xor rdx, rdx  (dst offset)
    x64_emit_u8(72)
    x64_emit_u8(49)
    x64_emit_u8(210)
    copy_a_top = len(x64_buf_get())
    # mov r8b, [rcx + rdx]    (44 8A 04 11)
    x64_emit_u8(68)
    x64_emit_u8(138)
    x64_emit_u8(4)
    x64_emit_u8(17)
    # test r8b, r8b           (45 84 C0)
    x64_emit_u8(69)
    x64_emit_u8(132)
    x64_emit_u8(192)
    # jz copy_a_done
    x64_emit_u8(15)
    x64_emit_u8(132)
    copy_a_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov [rax + rdx], r8b   (44 88 04 10)
    x64_emit_u8(68)
    x64_emit_u8(136)
    x64_emit_u8(4)
    x64_emit_u8(16)
    # inc rdx
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(194)
    # jmp copy_a_top
    x64_emit_u8(233)
    here1 = len(x64_buf_get())
    x64_emit_u32(copy_a_top - (here1 + 4))
    # copy_a_done:
    x64_patch_to_here(copy_a_done_jmp)

    # Copy b at offset rdx (continues where a left off).
    # mov rcx, [rbp-96]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 96 + 256)
    # xor r9, r9   (src offset for b)
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(201)
    copy_b_top = len(x64_buf_get())
    # mov r8b, [rcx + r9]   (46 8A 04 09)
    x64_emit_u8(70)
    x64_emit_u8(138)
    x64_emit_u8(4)
    x64_emit_u8(9)
    # test r8b, r8b
    x64_emit_u8(69)
    x64_emit_u8(132)
    x64_emit_u8(192)
    # jz copy_b_done
    x64_emit_u8(15)
    x64_emit_u8(132)
    copy_b_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov [rax + rdx], r8b
    x64_emit_u8(68)
    x64_emit_u8(136)
    x64_emit_u8(4)
    x64_emit_u8(16)
    # inc rdx
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(194)
    # inc r9
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(193)
    # jmp copy_b_top
    x64_emit_u8(233)
    here2 = len(x64_buf_get())
    x64_emit_u32(copy_b_top - (here2 + 4))
    # copy_b_done:
    x64_patch_to_here(copy_b_done_jmp)
    # Null-terminate: mov byte [rax + rdx], 0   (C6 04 10 00)
    x64_emit_u8(198)
    x64_emit_u8(4)
    x64_emit_u8(16)
    x64_emit_u8(0)
    # rax already has buffer pointer.

# --- fmt_int(n) ---
#
# Allocates a heap string and writes the decimal representation of `n`.
# Handles 0 and negative numbers.
fn x64_emit_fmt_int(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))     # rax = number

    # Stash original at [rbp-96]
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Allocate 64-byte buffer
    x64_emit_alloc(64)
    # Stash buffer at [rbp-104]
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)

    # Special case: number is 0 → write "0\0"
    # mov rax, [rbp-96]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # test rax, rax
    x64_emit_u8(72)
    x64_emit_u8(133)
    x64_emit_u8(192)
    # jnz nonzero
    x64_emit_u8(15)
    x64_emit_u8(133)
    nonzero_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # Zero path
    x64_emit_u8(72)                # mov rax, [rbp-104]
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # mov byte [rax], '0' (48)   (C6 00 30)
    x64_emit_u8(198)
    x64_emit_u8(0)
    x64_emit_u8(48)
    # mov byte [rax+1], 0  (C6 40 01 00)
    x64_emit_u8(198)
    x64_emit_u8(64)
    x64_emit_u8(1)
    x64_emit_u8(0)
    # jmp end
    x64_emit_u8(233)
    end_jmp = len(x64_buf_get())
    x64_emit_u32(0)

    # nonzero:
    x64_patch_to_here(nonzero_jmp)
    # Take absolute value (and track sign on rsp via push)
    # mov rax, [rbp-96]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # test rax, rax
    x64_emit_u8(72)
    x64_emit_u8(133)
    x64_emit_u8(192)
    # jns pos  (jump if positive — SF clear)
    x64_emit_u8(15)
    x64_emit_u8(137)
    pos_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # neg rax
    x64_emit_u8(72)
    x64_emit_u8(247)
    x64_emit_u8(216)
    # pos:
    x64_patch_to_here(pos_jmp)

    # Now rax = |n|. Extract digits via repeated /10.
    # rcx will count digits as we push them.
    # xor rcx, rcx
    x64_emit_u8(72)
    x64_emit_u8(49)
    x64_emit_u8(201)
    digit_top = len(x64_buf_get())
    # xor rdx, rdx
    x64_emit_u8(72)
    x64_emit_u8(49)
    x64_emit_u8(210)
    # mov r9, 10
    x64_emit_u8(73)
    x64_emit_u8(199)
    x64_emit_u8(193)
    x64_emit_u32(10)
    # div r9   (rdx:rax / r9 → rax = quotient, rdx = remainder)
    x64_emit_u8(73)
    x64_emit_u8(247)
    x64_emit_u8(241)
    # push rdx — save digit
    x64_emit_u8(82)
    # inc rcx — digit count
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(193)
    # test rax, rax
    x64_emit_u8(72)
    x64_emit_u8(133)
    x64_emit_u8(192)
    # jnz digit_top
    x64_emit_u8(15)
    x64_emit_u8(133)
    here_a = len(x64_buf_get())
    x64_emit_u32(digit_top - (here_a + 4))

    # rcx = digit count, digits on stack (top has least sig).
    # Reload buffer.
    # mov rax, [rbp-104]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)
    # Add minus sign if original was negative.
    # mov r8, [rbp-96]
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # test r8, r8
    x64_emit_u8(77)
    x64_emit_u8(133)
    x64_emit_u8(192)
    # jns no_minus
    x64_emit_u8(15)
    x64_emit_u8(137)
    no_minus_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov byte [rax], '-' (45)
    x64_emit_u8(198)
    x64_emit_u8(0)
    x64_emit_u8(45)
    # inc rax
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(192)
    # no_minus:
    x64_patch_to_here(no_minus_jmp)

    # Pop digits in order, writing forward.
    # xor r8, r8 (index into buffer)
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(192)
    write_top = len(x64_buf_get())
    # cmp r8, rcx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(200)                # ModRM 11 reg=001 (rcx) rm=000 (r8)
    # jge write_done
    x64_emit_u8(15)
    x64_emit_u8(141)
    write_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # pop rdx
    x64_emit_u8(90)
    # add dl, '0'  (80 C2 30)
    x64_emit_u8(128)
    x64_emit_u8(194)
    x64_emit_u8(48)
    # mov [rax + r8], dl
    x64_emit_u8(66)                # REX.X
    x64_emit_u8(136)
    x64_emit_u8(20)                # ModRM mod=00 reg=010 (rdx low) rm=100 (SIB)
    x64_emit_u8(0)                 # SIB index=r8 base=rax
    # inc r8
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(192)
    # jmp write_top
    x64_emit_u8(233)
    here_b = len(x64_buf_get())
    x64_emit_u32(write_top - (here_b + 4))
    # write_done:
    x64_patch_to_here(write_done_jmp)
    # Null-terminate: mov byte [rax + r8], 0
    x64_emit_u8(66)
    x64_emit_u8(198)
    x64_emit_u8(4)
    x64_emit_u8(0)
    x64_emit_u8(0)
    # rax = buffer start (after minus if any). Return buffer start.
    # If we incremented rax for the minus, rax no longer points to start.
    # Reload from stash for safety.
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 104 + 256)

    # end:
    x64_patch_to_here(end_jmp)

# --- text ↔ bytes bridge ---
#
# Text values are pointers to null-terminated byte sequences (either in
# the .rdata string pool or on the bump-allocated heap from
# bytes_to_text). bytes_from_text scans for the null terminator to find
# the length, then allocates a regular Orion list with the byte values.

fn x64_emit_bytes_from_text(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))     # rax = text pointer

    # Save text ptr in rcx; we'll need it for the copy.
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)               # mov rcx, rax

    # Compute length via strlen-like loop. rdx = 0; rdx is the result.
    x64_emit_u8(72)                # xor rdx, rdx
    x64_emit_u8(49)
    x64_emit_u8(210)
    len_top = len(x64_buf_get())
    # mov r8b, [rcx + rdx]  (44 8A 04 11 — REX.R + SIB)
    # Actually: mov r8b, byte [rcx + rdx*1]  →  44 8A 04 11
    x64_emit_u8(68)                # 44 REX.R
    x64_emit_u8(138)               # 8A mov r8, r/m8
    x64_emit_u8(4)                 # 04 ModRM mod=00 reg=000 (r8) rm=100 (SIB)
    x64_emit_u8(17)                # 11 SIB scale=00 index=010(rdx) base=001(rcx)
    # test r8b, r8b  (45 84 C0)
    x64_emit_u8(69)
    x64_emit_u8(132)
    x64_emit_u8(192)
    # jz len_done — placeholder
    x64_emit_u8(15)
    x64_emit_u8(132)
    len_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # inc rdx
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(194)
    # jmp len_top
    x64_emit_u8(233)
    here1 = len(x64_buf_get())
    back = len_top - (here1 + 4)
    x64_emit_u32(back)
    # len_done:
    x64_patch_to_here(len_done_jmp)

    # rdx = length, rcx = text ptr. Stash both before alloc clobbers them.
    # mov [rbp-96], rcx (text ptr)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(77)
    x64_emit_u8(0 - 96 + 256)
    # mov [rbp-104], rdx (length)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(85)
    x64_emit_u8(0 - 104 + 256)

    # Allocate fixed 4 KB — handles strings up to ~510 bytes.
    x64_emit_alloc(4096)
    # rax = list pointer

    # Reload length and write at [rax]
    # mov rdx, [rbp-104]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 104 + 256)
    # mov [rax], rdx
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(16)
    # mov rcx, [rbp-96]  (text ptr)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 96 + 256)
    # Copy loop: r8 = i = 0; while r8 < rdx: list[i+1] = (i64) text[i]
    x64_emit_u8(65)                # mov r8d, 0
    x64_emit_u8(184)
    x64_emit_u32(0)
    copy_top = len(x64_buf_get())
    # cmp r8, rdx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(208)
    # jge copy_done
    x64_emit_u8(15)
    x64_emit_u8(141)
    copy_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # movzx r9, byte [rcx + r8]  (4D 0F B6 0C 01 — wait that's wrong)
    # movzx r9, byte [rcx + r8] → REX.W=1, R=1 (r9), X=1 (r8), B=0 (rcx)
    # = 0x4E. opcode 0F B6. ModRM mod=00 reg=001 (r9 low) rm=100 (SIB) = 0x0C.
    # SIB scale=00 index=000 (r8 low) base=001 (rcx) = 0x01.
    x64_emit_u8(78)                # 4E
    x64_emit_u8(15)                # 0F
    x64_emit_u8(182)               # B6
    x64_emit_u8(12)                # 0C
    x64_emit_u8(1)                 # 01
    # mov [rax + r8*8 + 8], r9
    # REX W=1, R=1 (r9), X=1 (r8 in index), B=0 (rax)
    # = 0x4E. opcode 89. ModRM mod=01 reg=001 (r9 low) rm=100 (SIB) = 0x4C.
    # SIB scale=11 (×8) index=000 (r8 low) base=000 (rax) = 0xC0.
    x64_emit_u8(78)
    x64_emit_u8(137)
    x64_emit_u8(76)                # 4C
    x64_emit_u8(192)               # C0
    x64_emit_u8(8)                 # disp8
    # inc r8
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(192)
    # jmp copy_top
    x64_emit_u8(233)
    here2 = len(x64_buf_get())
    back2 = copy_top - (here2 + 4)
    x64_emit_u32(back2)
    # copy_done:
    x64_patch_to_here(copy_done_jmp)
    # rax already has list pointer.

# bytes_to_text: list of i64 → null-terminated byte string in heap.
fn x64_emit_bytes_to_text(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))     # rax = list pointer

    # mov rcx, rax (save list ptr)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    # mov rdx, [rcx] (length)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(17)
    # Stash list & length
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(77)
    x64_emit_u8(0 - 96 + 256)       # mov [rbp-96], rcx (list)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(85)
    x64_emit_u8(0 - 104 + 256)      # mov [rbp-104], rdx (length)

    # Allocate 4 KB
    x64_emit_alloc(4096)
    # rax = string pointer

    # Reload length & list
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 104 + 256)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(0 - 96 + 256)

    # r8 = i = 0
    x64_emit_u8(65)
    x64_emit_u8(184)
    x64_emit_u32(0)
    btxt_top = len(x64_buf_get())
    # cmp r8, rdx
    x64_emit_u8(73)
    x64_emit_u8(57)
    x64_emit_u8(208)
    # jge done
    x64_emit_u8(15)
    x64_emit_u8(141)
    btxt_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # mov r9, [rcx + r8*8 + 8]  (4E 8B 4C C1 08)
    # REX: W=1, R=1, X=1, B=0 → 0x4E
    # opcode 8B (mov r64, r/m64)
    # ModRM mod=01, reg=001 (r9), rm=100 (SIB) = 0x4C
    # SIB scale=11 (×8), index=000 (r8), base=001 (rcx) = 0xC1
    x64_emit_u8(78)
    x64_emit_u8(139)
    x64_emit_u8(76)
    x64_emit_u8(193)
    x64_emit_u8(8)
    # mov [rax + r8], r9b  (low byte only)
    # mov r/m8, r8.  opcode 88. REX: R=1, X=1, B=0 → 0x46. ModRM mod=00, reg=001 (r9), rm=100 (SIB) = 0x0C. SIB index=r8 base=rax = 0x00.
    x64_emit_u8(70)                # 46
    x64_emit_u8(136)               # 88
    x64_emit_u8(12)                # 0C
    x64_emit_u8(0)                 # SIB
    # inc r8
    x64_emit_u8(73)
    x64_emit_u8(255)
    x64_emit_u8(192)
    # jmp btxt_top
    x64_emit_u8(233)
    here3 = len(x64_buf_get())
    back3 = btxt_top - (here3 + 4)
    x64_emit_u32(back3)
    # done:
    x64_patch_to_here(btxt_done_jmp)
    # Null-terminate: mov byte [rax + r8], 0   (C6 04 00 00)
    x64_emit_u8(66)                # 42 REX.X for r8 index
    x64_emit_u8(198)               # C6 mov r/m8, imm8
    x64_emit_u8(4)                 # 04 ModRM rm=100 (SIB)
    x64_emit_u8(0)                 # SIB index=r8 base=rax
    x64_emit_u8(0)                 # imm8 = 0
    # rax already has string pointer.

# str_to_int: parse a decimal integer (optional leading `-`) from a
# null-terminated string. Stops at the first non-digit.
fn x64_emit_str_to_int(node):
    args = get(node, "args")
    x64_emit_expr(at(args, 0))     # rax = text pointer
    # mov rcx, rax
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    # xor rdx, rdx  (accumulator)
    x64_emit_u8(72)
    x64_emit_u8(49)
    x64_emit_u8(210)
    # xor r8, r8  (negative flag)
    x64_emit_u8(77)
    x64_emit_u8(49)
    x64_emit_u8(192)
    # Check first char for '-' (45)
    x64_emit_u8(138)               # mov al, [rcx]  (8A 01)
    x64_emit_u8(1)
    # cmp al, '-'
    x64_emit_u8(60)
    x64_emit_u8(45)
    # jne skip_neg
    x64_emit_u8(15)
    x64_emit_u8(133)
    skip_neg_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # inc rcx
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(193)
    # mov r8, 1
    x64_emit_u8(73)
    x64_emit_u8(199)
    x64_emit_u8(192)
    x64_emit_u32(1)
    # skip_neg:
    x64_patch_to_here(skip_neg_jmp)
    # Digit loop
    digit_top = len(x64_buf_get())
    # mov al, [rcx]   (8A 01)
    x64_emit_u8(138)
    x64_emit_u8(1)
    # sub al, '0' (48)
    x64_emit_u8(44)
    x64_emit_u8(48)
    # cmp al, 9   (3C 09)
    x64_emit_u8(60)
    x64_emit_u8(9)
    # ja digit_done (unsigned > 9, also handles negative via wrap-around)
    x64_emit_u8(15)
    x64_emit_u8(135)
    digit_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # movzx r9, al   (4C 0F B6 C8) — REX.R for r9
    x64_emit_u8(76)
    x64_emit_u8(15)
    x64_emit_u8(182)
    x64_emit_u8(200)
    # imul rdx, rdx, 10   (48 6B D2 0A)
    x64_emit_u8(72)
    x64_emit_u8(107)
    x64_emit_u8(210)
    x64_emit_u8(10)
    # add rdx, r9  (4C 01 CA)
    x64_emit_u8(76)
    x64_emit_u8(1)
    x64_emit_u8(202)
    # inc rcx
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(193)
    # jmp digit_top
    x64_emit_u8(233)
    here4 = len(x64_buf_get())
    back4 = digit_top - (here4 + 4)
    x64_emit_u32(back4)
    # digit_done:
    x64_patch_to_here(digit_done_jmp)
    # mov rax, rdx
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(208)
    # test r8, r8
    x64_emit_u8(77)
    x64_emit_u8(133)
    x64_emit_u8(192)
    # jz done
    x64_emit_u8(15)
    x64_emit_u8(132)
    done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # neg rax (48 F7 D8)
    x64_emit_u8(72)
    x64_emit_u8(247)
    x64_emit_u8(216)
    # done:
    x64_patch_to_here(done_jmp)

# Loop bookkeeping — a stack of "break placeholder" lists so nested
# `loop:` blocks each know which jumps belong to them.
fn x64_loop_stack_get():
    existing = slot_get("x64:loop_stack")
    if type_of(existing) == "none":
        []
    else:
        existing

fn x64_loop_stack_push(new_list):
    s = x64_loop_stack_get()
    slot_set("x64:loop_stack", push(s, new_list))

fn x64_loop_stack_pop():
    s = x64_loop_stack_get()
    total = len(s)
    if total == 0:
        []
    else:
        top = at(s, total - 1)
        mut shrunk = []
        for index in 0..<(total - 1):
            shrunk = push(shrunk, at(s, index))
        slot_set("x64:loop_stack", shrunk)
        top

# Append `placeholder` to the top frame's break list.
fn x64_loop_stack_add_break(placeholder: int):
    s = x64_loop_stack_get()
    total = len(s)
    if total > 0:
        top = at(s, total - 1)
        new_top = push(top, placeholder)
        mut shrunk = []
        for index in 0..<(total - 1):
            shrunk = push(shrunk, at(s, index))
        slot_set("x64:loop_stack", push(shrunk, new_top))

fn x64_emit_loop(stmt):
    loop_top = len(x64_buf_get())
    x64_loop_stack_push([])
    x64_emit_block(get(stmt, "body"))
    # jmp loop_top (E9 disp32)
    x64_emit_u8(233)
    here = len(x64_buf_get())
    x64_emit_u32(loop_top - (here + 4))
    # All `break`s in this loop point here.
    breaks = x64_loop_stack_pop()
    break_count = len(breaks)
    for index in 0..<break_count:
        x64_patch_to_here(at(breaks, index))

# Block-form `if cond: ... else: ...`. Unlike the expression form, this
# doesn't yield a value — both branches are statement bodies.
fn x64_emit_if_block(stmt):
    x64_emit_expr(get(stmt, "cond"))
    # cmp rax, 0
    x64_emit_u8(72)
    x64_emit_u8(131)
    x64_emit_u8(248)
    x64_emit_u8(0)
    # je else_label
    else_jump = x64_je_placeholder()
    x64_emit_block(get(stmt, "then"))
    # jmp end
    end_jump = x64_jmp_placeholder()
    x64_patch_to_here(else_jump)
    x64_emit_block(get(stmt, "else"))
    x64_patch_to_here(end_jump)

fn x64_emit_break():
    # Forward jmp rel32 placeholder; recorded in the current loop frame.
    x64_emit_u8(233)
    placeholder = len(x64_buf_get())
    x64_emit_u32(0)
    x64_loop_stack_add_break(placeholder)

# Emit `for VAR in LOW..<HIGH: body`. The loop var gets a fresh stack
# slot; we keep `high` in another slot so the body can call functions
# without us losing it.
fn x64_emit_for_range(stmt):
    var_name = get(stmt, "var")
    # Evaluate high → store in temp slot, allocate AFTER var.
    x64_emit_expr(get(stmt, "high"))
    # Allocate var first.
    x64_locals_add(var_name)
    var_disp = x64_locals_disp(var_name)
    # Allocate hidden temp for high.
    x64_locals_add("__for_high")
    high_disp = x64_locals_disp("__for_high")
    x64_store_rax_at_rbp(high_disp)
    # Now evaluate low and store in var.
    x64_emit_expr(get(stmt, "low"))
    x64_store_rax_at_rbp(var_disp)
    # Loop top
    loop_top = len(x64_buf_get())
    # Load var into rax
    x64_load_rax_from_rbp(var_disp)
    # mov rcx, [rbp+high_disp]
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(77)
    x64_emit_u8(high_disp)
    # cmp rax, rcx
    x64_emit_u8(72)
    x64_emit_u8(57)
    x64_emit_u8(200)
    # jge end (forward placeholder)
    x64_emit_u8(15)
    x64_emit_u8(141)
    end_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    # Body
    x64_emit_block(get(stmt, "body"))
    # Increment var: mov rax, [rbp+var_disp]; inc rax; mov [rbp+var_disp], rax
    x64_load_rax_from_rbp(var_disp)
    # inc rax  (48 FF C0)
    x64_emit_u8(72)
    x64_emit_u8(255)
    x64_emit_u8(192)
    x64_store_rax_at_rbp(var_disp)
    # jmp loop_top
    x64_emit_u8(233)
    here = len(x64_buf_get())
    back_disp = loop_top - (here + 4)
    x64_emit_u32(back_disp)
    # end:
    x64_patch_to_here(end_jmp)

# Emit a list literal `[a, b, c]`. Allocates `(n+1) * 8` bytes,
# writes the length at offset 0, then each element at offset 8 + i*8.
# Pointer to the list ends up in rax.
fn x64_emit_list_lit(node):
    items = get(node, "items")
    item_count = len(items)
    total_size = 8 + item_count * 8
    x64_emit_alloc(total_size)
    # mov qword [rax], item_count   (48 C7 00 imm32)  — for length up to 2^31
    x64_emit_u8(72)
    x64_emit_u8(199)
    x64_emit_u8(0)
    x64_emit_u32(item_count)
    # Stash list pointer on stack, evaluate each element, write it,
    # restore pointer for the next iteration.
    x64_push_rax()
    for index in 0..<item_count:
        x64_emit_expr(at(items, index))
        # pop rcx (list pointer)
        x64_emit_u8(89)
        # mov [rcx + disp8], rax   (48 89 41 disp8)
        slot_disp = 8 + index * 8
        x64_emit_u8(72)
        x64_emit_u8(137)
        x64_emit_u8(65)
        x64_emit_u8(slot_disp)
        # push rcx — keep pointer for the next element or the final pop
        x64_emit_u8(81)
    x64_pop_rax()

# Dynamic print: text pointer in rax. Calls strlen + WriteFile + adds
# trailing newline via a second WriteFile.
fn x64_emit_print_text_dynamic():
    # Stash text ptr at [rbp-96].
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(69)
    x64_emit_u8(0 - 96 + 256)
    # Compute strlen: rcx = ptr, rdx = length counter
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)               # mov rcx, rax
    x64_emit_u8(72)
    x64_emit_u8(49)
    x64_emit_u8(210)               # xor rdx, rdx
    sl_top = len(x64_buf_get())
    x64_emit_u8(68)                # mov r8b, [rcx + rdx]
    x64_emit_u8(138)
    x64_emit_u8(4)
    x64_emit_u8(17)
    x64_emit_u8(69)                # test r8b, r8b
    x64_emit_u8(132)
    x64_emit_u8(192)
    x64_emit_u8(15)                # jz sl_done
    x64_emit_u8(132)
    sl_done_jmp = len(x64_buf_get())
    x64_emit_u32(0)
    x64_emit_u8(72)                # inc rdx
    x64_emit_u8(255)
    x64_emit_u8(194)
    x64_emit_u8(233)               # jmp sl_top
    here_sl = len(x64_buf_get())
    x64_emit_u32(sl_top - (here_sl + 4))
    x64_patch_to_here(sl_done_jmp)
    # rdx = length. Stash at [rbp-112].
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(85)
    x64_emit_u8(0 - 112 + 256)

    # GetStdHandle(-11)
    x64_emit_u8(185)
    x64_emit_u8(245)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(21)
    p1 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(p1, 1)
    # mov rcx, rax (handle)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    # mov rdx, [rbp-96] (text ptr)
    x64_emit_u8(72)
    x64_emit_u8(139)
    x64_emit_u8(85)
    x64_emit_u8(0 - 96 + 256)
    # mov r8, [rbp-112] (length, but WriteFile wants u32 in r8d)
    x64_emit_u8(76)
    x64_emit_u8(139)
    x64_emit_u8(69)
    x64_emit_u8(0 - 112 + 256)
    # lea r9, [rsp+0x28]
    x64_emit_u8(76)
    x64_emit_u8(141)
    x64_emit_u8(76)
    x64_emit_u8(36)
    x64_emit_u8(40)
    # mov qword [rsp+0x20], 0
    x64_emit_u8(72)
    x64_emit_u8(199)
    x64_emit_u8(68)
    x64_emit_u8(36)
    x64_emit_u8(32)
    x64_emit_u32(0)
    # call [WriteFile]
    x64_emit_u8(255)
    x64_emit_u8(21)
    p2 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(p2, 2)

    # Second WriteFile for the newline. Use a 1-char string interned
    # at index — append "\n" to pool.
    nl_index = x64_strings_add("\n")
    # GetStdHandle again (handle cached in rcx after prior call, but
    # safer to re-fetch since WriteFile is permitted to clobber rcx).
    x64_emit_u8(185)
    x64_emit_u8(245)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(21)
    p3 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(p3, 1)
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    # lea rdx, [rip+nl_str]
    x64_emit_u8(72)
    x64_emit_u8(141)
    x64_emit_u8(21)
    nl_ph = len(x64_buf_get())
    x64_emit_u32(0)
    x64_string_fixup_add(nl_ph, nl_index)
    # mov r8d, 1
    x64_emit_u8(65)
    x64_emit_u8(184)
    x64_emit_u32(1)
    # lea r9, [rsp+0x28]
    x64_emit_u8(76)
    x64_emit_u8(141)
    x64_emit_u8(76)
    x64_emit_u8(36)
    x64_emit_u8(40)
    # mov qword [rsp+0x20], 0
    x64_emit_u8(72)
    x64_emit_u8(199)
    x64_emit_u8(68)
    x64_emit_u8(36)
    x64_emit_u8(32)
    x64_emit_u32(0)
    # call [WriteFile]
    x64_emit_u8(255)
    x64_emit_u8(21)
    p4 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(p4, 2)

# Emit the inline machine code for `print_line("...")`:
#   mov ecx, -11                B9 F5 FF FF FF
#   call [GetStdHandle_IAT]     FF 15 disp32   (IAT slot 1)
#   mov rcx, rax                48 89 C1
#   lea rdx, [rip+str]          48 8D 15 disp32  (string fixup)
#   mov r8d, length             41 B8 imm32
#   lea r9, [rsp+0x28]          4C 8D 4C 24 28
#   mov qword [rsp+0x20], 0     48 C7 44 24 20 00 00 00 00
#   call [WriteFile_IAT]        FF 15 disp32   (IAT slot 2)
#
# Total: 5+6+3+7+6+5+9+6 = 47 bytes.
#
# Assumes the calling function has at least `sub rsp, 0x40` so
# [rsp+0x20] and [rsp+0x28] live in our frame, AND that we're 16-byte
# aligned at the call (true after a normal prologue).
fn x64_emit_print_line_inline(str_index: int, length: int):
    # mov ecx, -11 (STD_OUTPUT_HANDLE)
    x64_emit_u8(185)               # B9
    x64_emit_u8(245)               # F5
    x64_emit_u8(255)
    x64_emit_u8(255)
    x64_emit_u8(255)
    # call [GetStdHandle_IAT]
    x64_emit_u8(255)               # FF
    x64_emit_u8(21)                # 15
    iat_placeholder_1 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(iat_placeholder_1, 1)
    # mov rcx, rax
    x64_emit_u8(72)
    x64_emit_u8(137)
    x64_emit_u8(193)
    # lea rdx, [rip+str_disp]
    x64_emit_u8(72)
    x64_emit_u8(141)               # 8D
    x64_emit_u8(21)                # 15 = ModRM for [rip+disp32]/rdx
    str_placeholder = len(x64_buf_get())
    x64_emit_u32(0)
    x64_string_fixup_add(str_placeholder, str_index)
    # mov r8d, length
    x64_emit_u8(65)                # 41 (REX.B)
    x64_emit_u8(184)               # B8 (mov r32, imm32 → r8d w/ REX.B)
    x64_emit_u32(length)
    # lea r9, [rsp+0x28]
    x64_emit_u8(76)                # 4C
    x64_emit_u8(141)
    x64_emit_u8(76)                # 4C = ModRM
    x64_emit_u8(36)                # 24 = SIB (base=rsp)
    x64_emit_u8(40)                # disp8 = 0x28
    # mov qword [rsp+0x20], 0
    x64_emit_u8(72)                # 48 REX.W
    x64_emit_u8(199)               # C7
    x64_emit_u8(68)                # 44 = ModRM mod=01 rm=100
    x64_emit_u8(36)                # 24 SIB
    x64_emit_u8(32)                # disp8 = 0x20
    x64_emit_u32(0)                # imm32 = 0
    # call [WriteFile_IAT]
    x64_emit_u8(255)
    x64_emit_u8(21)
    iat_placeholder_2 = len(x64_buf_get())
    x64_emit_u32(0)
    x64_iat_fixup_add(iat_placeholder_2, 2)

# cmp rax, rcx → flags
fn x64_cmp_rax_rcx():
    x64_emit_u8(72)
    x64_emit_u8(57)                # 39
    x64_emit_u8(200)               # C8

# setX al; movzx eax, al — boolean materialization into rax (0 or 1).
fn x64_setcc_al(opcode_byte: int):
    x64_emit_u8(15)                # 0F
    x64_emit_u8(opcode_byte)
    x64_emit_u8(192)               # C0
    # movzx eax, al  (0F B6 C0)
    x64_emit_u8(15)
    x64_emit_u8(182)
    x64_emit_u8(192)

# je rel32 — emit `0F 84 00 00 00 00`, return placeholder offset.
fn x64_je_placeholder():
    x64_emit_u8(15)
    x64_emit_u8(132)               # 84
    cur = len(x64_buf_get())
    x64_emit_u32(0)
    cur

# jmp rel32 — `E9 00 00 00 00`.
fn x64_jmp_placeholder():
    x64_emit_u8(233)               # E9
    cur = len(x64_buf_get())
    x64_emit_u32(0)
    cur

# Patch a 4-byte disp32 at `placeholder` so it points from (placeholder+4)
# to the current emit position.
fn x64_patch_to_here(placeholder: int):
    here = len(x64_buf_get())
    disp = here - (placeholder + 4)
    u = if disp >= 0 then disp else disp + 4294967296
    b0 = u - (u / 256) * 256
    b1_src = u / 256
    b1 = b1_src - (b1_src / 256) * 256
    b2_src = u / 65536
    b2 = b2_src - (b2_src / 256) * 256
    b3 = u / 16777216
    mut code = x64_buf_get()
    code = set(code, placeholder + 0, b0)
    code = set(code, placeholder + 1, b1)
    code = set(code, placeholder + 2, b2)
    code = set(code, placeholder + 3, b3)
    slot_set("x64:buf", code)

# Emit `if cond then THEN else ELSE`. Uses cmp rax, 0 + je-to-else,
# then jmp-to-end after the then branch. Both branches leave the
# result in rax.
fn x64_emit_if(node):
    # Condition → rax (0 = false, non-zero = true).
    x64_emit_expr(get(node, "cond"))
    # cmp rax, 0  (48 83 F8 00)
    x64_emit_u8(72)
    x64_emit_u8(131)
    x64_emit_u8(248)
    x64_emit_u8(0)
    # je <else_label>
    else_jump = x64_je_placeholder()
    # then branch
    x64_emit_expr(get(node, "then"))
    # jmp <end_label>
    end_jump = x64_jmp_placeholder()
    # else branch starts here
    x64_patch_to_here(else_jump)
    x64_emit_expr(get(node, "else"))
    # end
    x64_patch_to_here(end_jump)

fn x64_emit_block(block_node):
    stmts = get(block_node, "stmts")
    count = len(stmts)
    for index in 0..<count:
        stmt = at(stmts, index)
        stmt_kind = get(stmt, "kind")
        if stmt_kind == "ExprStmt":
            x64_emit_expr(get(stmt, "expr"))
        if stmt_kind == "LetOrAssign":
            let_name = get(stmt, "name")
            let_value = get(stmt, "value")
            x64_emit_expr(let_value)
            existing_disp = x64_locals_disp(let_name)
            if existing_disp == 0:
                x64_locals_add(let_name)
            x64_store_rax_at_rbp(x64_locals_disp(let_name))
        if stmt_kind == "MutLet":
            let_name = get(stmt, "name")
            let_value = get(stmt, "value")
            x64_emit_expr(let_value)
            x64_locals_add(let_name)
            x64_store_rax_at_rbp(x64_locals_disp(let_name))
        if stmt_kind == "ForRange":
            x64_emit_for_range(stmt)
        if stmt_kind == "Loop":
            x64_emit_loop(stmt)
        if stmt_kind == "Break":
            x64_emit_break()
        if stmt_kind == "IfBlock":
            x64_emit_if_block(stmt)

# Emit a complete function (prologue, body, epilogue). Args are spilled
# to stack slots so the body can `Ident`-load them like any local.
fn x64_emit_fn(fn_node):
    name = get(fn_node, "name")
    offset = len(x64_buf_get())
    x64_fns_record(name, offset)
    x64_locals_reset()

    # Prologue.
    x64_push_rbp()
    x64_mov_rbp_rsp()
    # Reserve 112 bytes: 0x30 for shadow + 5th-arg + bytes_written
    # (used by `print_line`'s WriteFile call), then locals at [rbp-8]
    # down. Fits 8 locals before bumping into the temps area.
    x64_sub_rsp_imm8(112)

    # Spill params. arg0 came in rax, arg1 in rcx (our calling convention).
    params = get(fn_node, "params")
    param_count = len(params)
    if param_count >= 1:
        param0_name = get(at(params, 0), "name")
        x64_locals_add(param0_name)
        x64_store_rax_at_rbp(x64_locals_disp(param0_name))
    if param_count >= 2:
        param1_name = get(at(params, 1), "name")
        x64_locals_add(param1_name)
        # mov [rbp+disp], rcx  (48 89 4D ib)
        x64_emit_u8(72)
        x64_emit_u8(137)
        x64_emit_u8(77)                # 4D = [rbp+disp8] / rcx
        disp = x64_locals_disp(param1_name)
        x64_emit_u8(disp)
    if param_count >= 3:
        param2_name = get(at(params, 2), "name")
        x64_locals_add(param2_name)
        # mov [rbp+disp], r8  (4C 89 45 ib)
        x64_emit_u8(76)
        x64_emit_u8(137)
        x64_emit_u8(69)                # 45 = [rbp+disp8] / r8 (with REX.R)
        disp = x64_locals_disp(param2_name)
        x64_emit_u8(disp)

    x64_emit_block(get(fn_node, "body"))

    # Epilogue: mov rsp, rbp; pop rbp; ret.
    x64_mov_rsp_rbp()
    x64_pop_rbp()
    x64_ret()

# Compile every top-level fn declaration. Returns the byte list plus
# the offset of `main` (where the PE wrapper should jump to first).
pub fn x64_compile_program(source: Text):
    tokens = self_lex(source)
    ast = self_parse(tokens)
    decls = get(ast, "decls")
    x64_reset()
    x64_fns_reset()
    x64_strings_reset()
    decl_count = len(decls)
    for index in 0..<decl_count:
        x64_emit_fn(at(decls, index))

    # Patch all call placeholders — O(1) per byte via slot_set_at, was
    # O(n) clone-per-set which made a 1000-fn program quadratic.
    fixups = slot_get("x64:call_fixups")
    fixup_count = len(fixups)
    for index in 0..<fixup_count:
        fixup = at(fixups, index)
        placeholder_offset = get(fixup, "offset")
        target_name = get(fixup, "target")
        target_offset = x64_fns_lookup(target_name)
        disp = target_offset - (placeholder_offset + 4)
        u = if disp >= 0 then disp else disp + 4294967296
        b0 = u - (u / 256) * 256
        b1_src = u / 256
        b1 = b1_src - (b1_src / 256) * 256
        b2_src = u / 65536
        b2 = b2_src - (b2_src / 256) * 256
        b3 = u / 16777216
        slot_set_at("x64:buf", placeholder_offset + 0, b0)
        slot_set_at("x64:buf", placeholder_offset + 1, b1)
        slot_set_at("x64:buf", placeholder_offset + 2, b2)
        slot_set_at("x64:buf", placeholder_offset + 3, b3)

    main_offset = x64_fns_lookup("main")
    {"code": x64_buf_get(), "main_offset": main_offset, "strings": slot_get("x64:strings"), "string_fixups": slot_get("x64:string_fixups"), "iat_fixups": slot_get("x64:iat_fixups")}

# Legacy single-fn entry — kept so older demos still work.
pub fn x64_compile_main(source: Text):
    result = x64_compile_program(source)
    get(result, "code")
