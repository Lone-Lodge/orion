# orion_self_parse — Orion parser written in Orion. STEP 4 PROOF.
#
# Consumes the token list produced by `self_lex` and produces an AST as
# a Map tree. This is a *proof of concept* — it parses fn declarations
# with typed params, return types, and tail-expression bodies. The full
# Orion grammar (data decls, if/else, for/loop, mut, multi-statement
# bodies, generics, ownership annotations) is another ~800 lines of
# similar machinery.
#
# AST shape this proof emits:
#   { "kind": "Program", "decls": [<Fn>...] }
#   Fn:    { "kind": "Fn", "name": Text, "params": [Param], "ret": Type, "body": Expr }
#   Param: { "name": Text, "type": Type }
#   Type:  { "kind": "Named", "name": Text }
#         | { "kind": "List", "elem": Type }
#   Expr:  { "kind": "Ident",  "name": Text }
#         | { "kind": "Int",    "value": Text }
#         | { "kind": "Binary", "op": Text, "left": Expr, "right": Expr }
#         | { "kind": "Call",   "callee": Text, "args": [Expr] }
#
# Cursor positions are passed through every helper as a plain int — Orion
# doesn't have references so we return a new cursor in a {"node": …,
# "next": …} pair (same pattern as the lexer's scanners).

# --- token helpers ---

fn psr_peek_kind(tokens, position) -> Text:
    if position >= len(tokens):
        "eof"
    else:
        # Round-trip through bytes so the typeck sees a concrete Text —
        # `get(map, key)` returns Unknown which doesn't unify with the
        # declared return type without a bridge.
        get(at(tokens, position), "kind")

fn psr_peek_value(tokens, position) -> Text:
    if position >= len(tokens):
        ""
    else:
        get(at(tokens, position), "value")

fn psr_skip_newlines(tokens, position) -> int:
    mut cursor = position
    loop:
        if psr_peek_kind(tokens, cursor) != "newline":
            break
        cursor += 1
    cursor

# --- type parser ---

fn psr_parse_type(tokens, position):
    # `[ inner ]` → list type, `name` → named type.
    if psr_peek_kind(tokens, position) == "symbol" and psr_peek_value(tokens, position) == "[":
        inner_result = psr_parse_type(tokens, position + 1)
        next_position = get(inner_result, "next")
        # Expect closing `]`.
        if psr_peek_kind(tokens, next_position) == "symbol" and psr_peek_value(tokens, next_position) == "]":
            {"node": {"kind": "List", "elem": get(inner_result, "node")}, "next": next_position + 1}
        else:
            {"node": {"kind": "Error", "msg": "expected `]` to close list type"}, "next": next_position}
    else:
        name_text = psr_peek_value(tokens, position)
        {"node": {"kind": "Named", "name": name_text}, "next": position + 1}

# --- expression parser ---
#
# Pratt-lite: handles literals, identifiers, calls, and left-associative
# `+`/`-` for the proof. The real parser uses full operator precedence
# and unary ops; same pattern, more cases.

fn psr_parse_primary(tokens, position):
    # Flat dispatch — Orion's deeply-nested if/else mis-binds, so each
    # case sets a `result` Map and the tail expression returns it.
    kind = psr_peek_kind(tokens, position)
    value = psr_peek_value(tokens, position)
    # `not` is a unary prefix operator — recurse to parse the operand
    # and wrap the result.
    is_not = kind == "ident" and value == "not"
    mut not_node = {"node": {"kind": "Error", "msg": ""}, "next": position}
    if is_not:
        operand_result = psr_parse_primary(tokens, position + 1)
        not_node = {"node": {"kind": "Unary", "op": "not", "operand": get(operand_result, "node")}, "next": get(operand_result, "next")}
    is_ident = kind == "ident"
    is_int = kind == "int"
    is_str = kind == "str"
    is_lbracket = kind == "symbol" and value == "["
    is_lbrace = kind == "symbol" and value == "\{"
    # Parenthesised expression — just parse the inner expr and consume `)`.
    is_lparen = kind == "symbol" and value == "("
    # `if` is an ident at the lex layer — we recognise it here as a keyword.
    is_if = is_ident and value == "if"
    is_call = is_ident and not is_if and not is_not and psr_peek_kind(tokens, position + 1) == "symbol" and psr_peek_value(tokens, position + 1) == "("
    mut result = {"node": {"kind": "Error", "msg": "expected an expression"}, "next": position}
    if is_if:
        result = psr_parse_if(tokens, position)
    if is_call:
        result = psr_parse_call(tokens, position, value)
    if is_ident and not is_call and not is_if:
        result = {"node": {"kind": "Ident", "name": value}, "next": position + 1}
    if is_int:
        result = {"node": {"kind": "Int", "value": value}, "next": position + 1}
    if is_str:
        result = {"node": {"kind": "Str", "value": value}, "next": position + 1}
    if is_lbracket:
        result = psr_parse_list_literal(tokens, position)
    if is_lbrace:
        result = psr_parse_map_literal(tokens, position)
    if is_not:
        result = not_node
    if is_lparen:
        inner = psr_parse_expr(tokens, position + 1)
        mut inner_next = get(inner, "next")
        if psr_peek_kind(tokens, inner_next) == "symbol" and psr_peek_value(tokens, inner_next) == ")":
            inner_next = inner_next + 1
        result = {"node": get(inner, "node"), "next": inner_next}
    result

# `{ "key1": expr1, "key2": expr2 }` — map literal. Keys must be Str
# literals so the codegen can intern them in the string pool and rely
# on pointer-equality at lookup time.
fn psr_parse_map_literal(tokens, position):
    mut cursor = position + 1
    mut pairs = []
    loop:
        kind_here = psr_peek_kind(tokens, cursor)
        value_here = psr_peek_value(tokens, cursor)
        is_close = kind_here == "symbol" and value_here == "\}"
        is_eof = kind_here == "eof"
        if is_close:
            cursor += 1
            break
        if is_eof:
            break
        # Key must be a string literal.
        if kind_here == "str":
            key_text = value_here
            cursor += 1
            if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ":":
                cursor += 1
            value_result = psr_parse_expr(tokens, cursor)
            pairs = push(pairs, {"key": key_text, "value": get(value_result, "node")})
            cursor = get(value_result, "next")
            if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ",":
                cursor += 1
    {"node": {"kind": "MapLit", "pairs": pairs}, "next": cursor}

# `[ expr, expr, ... ]` — list literal. Trailing comma optional.
fn psr_parse_list_literal(tokens, position):
    mut cursor = position + 1
    mut items = []
    loop:
        kind_here = psr_peek_kind(tokens, cursor)
        value_here = psr_peek_value(tokens, cursor)
        is_close = kind_here == "symbol" and value_here == "]"
        is_eof = kind_here == "eof"
        if is_close:
            cursor += 1
            break
        if is_eof:
            break
        item_result = psr_parse_expr(tokens, cursor)
        items = push(items, get(item_result, "node"))
        cursor = get(item_result, "next")
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ",":
            cursor += 1
    {"node": {"kind": "ListLit", "items": items}, "next": cursor}

# `if COND then THEN else ELSE` — single-line expression form (the
# block form `if cond:\n    body\nelse:\n    body` needs the offside
# layout rules, which a future pass tackles).
fn psr_parse_if(tokens, position):
    # We're on `if`.
    cond_result = psr_parse_expr(tokens, position + 1)
    cursor_after_cond = get(cond_result, "next")
    # Expect `then`.
    has_then = psr_peek_kind(tokens, cursor_after_cond) == "ident" and psr_peek_value(tokens, cursor_after_cond) == "then"
    mut cursor = cursor_after_cond
    if has_then:
        cursor = cursor_after_cond + 1
    then_result = psr_parse_expr(tokens, cursor)
    cursor = get(then_result, "next")
    has_else = psr_peek_kind(tokens, cursor) == "ident" and psr_peek_value(tokens, cursor) == "else"
    mut else_node = {"kind": "Int", "value": "0"}
    if has_else:
        else_result = psr_parse_expr(tokens, cursor + 1)
        else_node = get(else_result, "node")
        cursor = get(else_result, "next")
    {"node": {"kind": "If", "cond": get(cond_result, "node"), "then": get(then_result, "node"), "else": else_node}, "next": cursor}

fn psr_parse_call(tokens, position, callee_name: Text):
    # We're at the ident; `position+1` is `(`.
    mut cursor = position + 2
    mut args = []
    loop:
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ")":
            cursor += 1
            break
        if psr_peek_kind(tokens, cursor) == "eof":
            break
        arg_result = psr_parse_expr(tokens, cursor)
        args = push(args, get(arg_result, "node"))
        cursor = get(arg_result, "next")
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ",":
            cursor += 1
    {"node": {"kind": "Call", "callee": callee_name, "args": args}, "next": cursor}

# Precedence table — higher binds tighter. Returns 0 for non-operator.
# `and` and `or` are keywords (idents at the lex layer), everything
# else is a symbol token.
fn psr_op_prec(op_kind: Text, op_value: Text) -> int:
    # Logical `or` binds loosest.
    if op_kind == "ident" and op_value == "or":
        5
    else:
        if op_kind == "ident" and op_value == "and":
            7
        else:
            if op_kind != "symbol":
                0
            else:
                # Comparison operators bind looser than arithmetic.
                is_cmp = op_value == "==" or op_value == "!=" or op_value == "<" or op_value == ">" or op_value == "<=" or op_value == ">="
                is_add = op_value == "+" or op_value == "-"
                is_mul = op_value == "*" or op_value == "/"
                if is_cmp then 10 else if is_add then 20 else if is_mul then 30 else 0

# Precedence-climbing (Pratt-lite). Parses primary then while the next
# token is an op with precedence >= min_prec, consumes it and recurses
# at higher precedence to gather the right-hand side.
fn psr_parse_expr_at(tokens, position, min_prec: int):
    primary_result = psr_parse_primary(tokens, position)
    mut current_node = get(primary_result, "node")
    mut cursor = get(primary_result, "next")
    loop:
        op_kind = psr_peek_kind(tokens, cursor)
        op_value = psr_peek_value(tokens, cursor)
        prec = psr_op_prec(op_kind, op_value)
        if prec == 0 or prec < min_prec:
            break
        # Left-associative — RHS uses prec+1 so we don't gather more at
        # the same level (e.g. `a-b-c` parses as `(a-b)-c`, not `a-(b-c)`).
        rhs_result = psr_parse_expr_at(tokens, cursor + 1, prec + 1)
        current_node = {"kind": "Binary", "op": op_value, "left": current_node, "right": get(rhs_result, "node")}
        cursor = get(rhs_result, "next")
    {"node": current_node, "next": cursor}

fn psr_parse_expr(tokens, position):
    psr_parse_expr_at(tokens, position, 1)

# --- fn declaration parser ---

fn psr_parse_params(tokens, position):
    mut cursor = position
    mut params = []
    loop:
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ")":
            cursor += 1
            break
        # Identifier (param name).
        param_name = psr_peek_value(tokens, cursor)
        cursor += 1
        # Expect `:`.
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ":":
            cursor += 1
        # Parse type.
        type_result = psr_parse_type(tokens, cursor)
        params = push(params, {"name": param_name, "type": get(type_result, "node")})
        cursor = get(type_result, "next")
        # Optional comma.
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ",":
            cursor += 1
    {"node": params, "next": cursor}

# Peek the column of the next non-newline token. Used to find the
# indent level of an indented block.
fn psr_peek_col(tokens, position) -> int:
    cursor = psr_skip_newlines(tokens, position)
    if cursor >= len(tokens):
        0
    else:
        get(at(tokens, cursor), "col")

# Parse a body of one-or-more statements. A statement is either:
#   `mut name = expr`   (MutLet — declare mutable)
#   `name = expr`       (LetOrAssign — decide in codegen)
#   `break`             (Break)
#   `loop:` then block  (Loop)
#   `expr`              (ExprStmt — evaluate)
#
# Termination: eof OR a top-level decl (`fn`/`pub`) OR a token whose
# col is strictly less than `min_col` (offside rule).
fn psr_parse_body_at(tokens, position, min_col: int):
    mut cursor = psr_skip_newlines(tokens, position)
    mut statements = []
    loop:
        cursor = psr_skip_newlines(tokens, cursor)
        kind_here = psr_peek_kind(tokens, cursor)
        value_here = psr_peek_value(tokens, cursor)
        col_here = if cursor >= len(tokens) then 0 else get(at(tokens, cursor), "col")
        is_eof = kind_here == "eof"
        starts_new_decl = kind_here == "ident" and (value_here == "fn" or value_here == "pub")
        dedented = col_here < min_col
        if is_eof or starts_new_decl or dedented:
            break
        # `mut name = expr` — declare-and-mark-mutable.
        is_mut_decl = kind_here == "ident" and value_here == "mut" and psr_peek_kind(tokens, cursor + 1) == "ident" and psr_peek_kind(tokens, cursor + 2) == "symbol" and psr_peek_value(tokens, cursor + 2) == "="
        # `name = expr` — either immutable let OR reassignment, decided
        # by the codegen scope tracker.
        is_let_or_assign = (not is_mut_decl) and kind_here == "ident" and psr_peek_kind(tokens, cursor + 1) == "symbol" and psr_peek_value(tokens, cursor + 1) == "="
        # `break` — single-token statement, only meaningful inside a loop.
        is_break = kind_here == "ident" and value_here == "break"
        # `loop:` — start an unconditional loop block.
        is_loop = kind_here == "ident" and value_here == "loop" and psr_peek_kind(tokens, cursor + 1) == "symbol" and psr_peek_value(tokens, cursor + 1) == ":"
        # Block-form `if cond:` — followed by indented body (and
        # optional else: block). Distinguished from inline `if cond
        # then ...` by looking for `:` after the condition.
        is_if_block = kind_here == "ident" and value_here == "if"
        # `for VAR in LOW..<HIGH:` — counted range loop.
        is_for = kind_here == "ident" and value_here == "for" and psr_peek_kind(tokens, cursor + 1) == "ident"
        if is_mut_decl:
            mut_name = psr_peek_value(tokens, cursor + 1)
            mut_expr_result = psr_parse_expr(tokens, cursor + 3)
            statements = push(statements, {"kind": "MutLet", "name": mut_name, "value": get(mut_expr_result, "node")})
            cursor = get(mut_expr_result, "next")
        if is_let_or_assign:
            assign_name = value_here
            assign_expr_result = psr_parse_expr(tokens, cursor + 2)
            statements = push(statements, {"kind": "LetOrAssign", "name": assign_name, "value": get(assign_expr_result, "node")})
            cursor = get(assign_expr_result, "next")
        if is_break:
            statements = push(statements, {"kind": "Break"})
            cursor = cursor + 1
        if is_loop:
            inner_col = psr_peek_col(tokens, cursor + 2)
            inner_result = psr_parse_body_at(tokens, cursor + 2, inner_col)
            statements = push(statements, {"kind": "Loop", "body": get(inner_result, "node")})
            cursor = get(inner_result, "next")
        if is_for:
            # for VAR in LOW..<HIGH:
            for_var_name = psr_peek_value(tokens, cursor + 1)
            # Skip `for VAR in`.
            mut for_cursor = cursor + 2
            if psr_peek_kind(tokens, for_cursor) == "ident" and psr_peek_value(tokens, for_cursor) == "in":
                for_cursor = for_cursor + 1
            low_result = psr_parse_expr(tokens, for_cursor)
            for_cursor = get(low_result, "next")
            if psr_peek_kind(tokens, for_cursor) == "symbol" and psr_peek_value(tokens, for_cursor) == "..<":
                for_cursor = for_cursor + 1
            high_result = psr_parse_expr(tokens, for_cursor)
            for_cursor = get(high_result, "next")
            if psr_peek_kind(tokens, for_cursor) == "symbol" and psr_peek_value(tokens, for_cursor) == ":":
                for_cursor = for_cursor + 1
            for_body_col = psr_peek_col(tokens, for_cursor)
            for_body_result = psr_parse_body_at(tokens, for_cursor, for_body_col)
            statements = push(statements, {"kind": "ForRange", "var": for_var_name, "low": get(low_result, "node"), "high": get(high_result, "node"), "body": get(for_body_result, "node")})
            cursor = get(for_body_result, "next")
        # Detect the block-form `if cond:` by looking for `:` AFTER
        # the condition expression. Inline `if cond then ...` is still
        # an expression, handled by psr_parse_if.
        mut actually_if_block = false
        if is_if_block:
            cond_probe = psr_parse_expr(tokens, cursor + 1)
            probe_next = get(cond_probe, "next")
            looks_like_block = psr_peek_kind(tokens, probe_next) == "symbol" and psr_peek_value(tokens, probe_next) == ":"
            if looks_like_block:
                actually_if_block = true
                # Parse the block-form if.
                mut if_cursor = probe_next + 1   # skip `:`
                then_body_col = psr_peek_col(tokens, if_cursor)
                then_body_result = psr_parse_body_at(tokens, if_cursor, then_body_col)
                if_cursor = get(then_body_result, "next")
                # Optional `else:` (must be at the same col as `if`).
                if_cursor = psr_skip_newlines(tokens, if_cursor)
                mut else_node = {"kind": "Block", "stmts": []}
                if psr_peek_kind(tokens, if_cursor) == "ident" and psr_peek_value(tokens, if_cursor) == "else":
                    if_cursor = if_cursor + 1
                    if psr_peek_kind(tokens, if_cursor) == "symbol" and psr_peek_value(tokens, if_cursor) == ":":
                        if_cursor = if_cursor + 1
                    else_body_col = psr_peek_col(tokens, if_cursor)
                    else_body_result = psr_parse_body_at(tokens, if_cursor, else_body_col)
                    else_node = get(else_body_result, "node")
                    if_cursor = get(else_body_result, "next")
                statements = push(statements, {"kind": "IfBlock", "cond": get(cond_probe, "node"), "then": get(then_body_result, "node"), "else": else_node})
                cursor = if_cursor
        is_plain_expr = not (is_mut_decl or is_let_or_assign or is_break or is_loop or is_for or actually_if_block)
        if is_plain_expr:
            expr_result = psr_parse_expr(tokens, cursor)
            expr_next = get(expr_result, "next")
            # Infinite-loop guard: if parse_expr can't make progress
            # (e.g. unexpected token at cursor), advance by one to
            # keep the body loop terminating. The malformed statement
            # is lost but the file still finishes parsing.
            if expr_next == cursor:
                cursor = cursor + 1
            else:
                statements = push(statements, {"kind": "ExprStmt", "expr": get(expr_result, "node")})
                cursor = expr_next
        cursor = psr_skip_newlines(tokens, cursor)
    {"node": {"kind": "Block", "stmts": statements}, "next": cursor}

fn psr_parse_body(tokens, position):
    body_col = psr_peek_col(tokens, position)
    psr_parse_body_at(tokens, position, body_col)

fn psr_parse_fn(tokens, position):
    # We're sitting on `fn`. Advance past it.
    mut cursor = position + 1
    name = psr_peek_value(tokens, cursor)
    cursor += 1
    # Skip `(`.
    if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == "(":
        cursor += 1
    params_result = psr_parse_params(tokens, cursor)
    cursor = get(params_result, "next")
    # Optional `-> type`.
    mut return_node = {"kind": "Named", "name": "Unit"}
    has_arrow = psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == "->"
    if has_arrow:
        cursor += 1
        ret_result = psr_parse_type(tokens, cursor)
        return_node = get(ret_result, "node")
        cursor = get(ret_result, "next")
    # `fn name(...) -> int = EXPR` short form.
    has_equals = psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == "="
    if has_equals:
        cursor += 1
        expr_result = psr_parse_expr(tokens, cursor)
        body_node = {"kind": "Block", "stmts": push([], {"kind": "ExprStmt", "expr": get(expr_result, "node")})}
        cursor = get(expr_result, "next")
        cursor = psr_skip_newlines(tokens, cursor)
        {"node": {"kind": "Fn", "name": name, "params": get(params_result, "node"), "ret": return_node, "body": body_node}, "next": cursor}
    if not has_equals:
        # Expect `:` and a newline.
        if psr_peek_kind(tokens, cursor) == "symbol" and psr_peek_value(tokens, cursor) == ":":
            cursor += 1
        cursor = psr_skip_newlines(tokens, cursor)
        body_result = psr_parse_body(tokens, cursor)
        cursor = get(body_result, "next")
        {"node": {"kind": "Fn", "name": name, "params": get(params_result, "node"), "ret": return_node, "body": get(body_result, "node")}, "next": cursor}

# --- top-level ---

# Skip whatever comes after `extern fn name(params) -> type` — there's
# no body, just the declaration. Returns the next cursor position.
fn psr_skip_extern_fn(tokens, position):
    # Already past `extern fn`; consume name + params + optional `-> ret`.
    mut cursor = position
    # Skip name
    if psr_peek_kind(tokens, cursor) == "ident":
        cursor = cursor + 1
    # Skip everything until the next newline (declaration is one line).
    loop:
        if psr_peek_kind(tokens, cursor) == "newline" or psr_peek_kind(tokens, cursor) == "eof":
            break
        cursor = cursor + 1
    cursor

# Skip `use NAME` — one line.
fn psr_skip_use(tokens, position):
    mut cursor = position + 1
    loop:
        if psr_peek_kind(tokens, cursor) == "newline" or psr_peek_kind(tokens, cursor) == "eof":
            break
        cursor = cursor + 1
    cursor

pub fn self_parse(tokens):
    mut cursor = psr_skip_newlines(tokens, 0)
    mut decls = []
    loop:
        mut kind_here = psr_peek_kind(tokens, cursor)
        mut value_here = psr_peek_value(tokens, cursor)
        if kind_here == "eof":
            break
        is_pub = kind_here == "ident" and value_here == "pub"
        # `pub` is purely a visibility marker — we don't enforce it. Skip
        # the keyword and re-read the next token as the actual decl.
        if is_pub:
            cursor = cursor + 1
            kind_here = psr_peek_kind(tokens, cursor)
            value_here = psr_peek_value(tokens, cursor)
        is_fn = kind_here == "ident" and value_here == "fn"
        is_extern = kind_here == "ident" and value_here == "extern"
        is_use = kind_here == "ident" and value_here == "use"
        if is_fn:
            decl_result = psr_parse_fn(tokens, cursor)
            decls = push(decls, get(decl_result, "node"))
            cursor = get(decl_result, "next")
        if is_extern:
            # Skip `extern fn ...` declaration entirely — only the body
            # of real functions needs codegen.
            cursor = cursor + 1
            if psr_peek_kind(tokens, cursor) == "ident" and psr_peek_value(tokens, cursor) == "fn":
                cursor = cursor + 1
            cursor = psr_skip_extern_fn(tokens, cursor)
        if is_use:
            cursor = psr_skip_use(tokens, cursor)
        not_recognized = not (is_fn or is_extern or is_use)
        if not_recognized:
            cursor = cursor + 1
        cursor = psr_skip_newlines(tokens, cursor)
    {"kind": "Program", "decls": decls}
