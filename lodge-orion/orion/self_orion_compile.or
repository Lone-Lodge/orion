# self_orion_compile — end-to-end Orion native compiler.
#
# Reads an Orion source string, runs lex → parse → x86-64 codegen → PE
# wrap, writes a runnable Windows .exe. The exit code IS the result of
# the program's `main` expression.

pub fn orion_compile_to_exe(source: Text, output_path: Text):
    compiled = x64_compile_program(source)
    user_code = get(compiled, "code")
    main_offset = get(compiled, "main_offset")
    strings = get(compiled, "strings")
    string_fixups = get(compiled, "string_fixups")
    iat_fixups = get(compiled, "iat_fixups")
    pe_bytes = pw_build_with_main(user_code, main_offset, strings, string_fixups, iat_fixups)
    mkdir_all("build")
    write_file_bytes(output_path, pe_bytes)
    print("compiled " + output_path)
    print("user code bytes:")
    print(len(user_code))
    print("strings emitted:")
    print(len(strings))
    print("total PE bytes:")
    print(len(pe_bytes))
