# time_format — ISO 8601 date/time formatting and parsing.
#
# Pure Orion using Howard Hinnant's `days_from_civil` algorithm — exact
# for years 1970..=2262 (the only range any game's log timestamps care
# about). Built on `format` (for zero-padded fields) and `string` (for
# parsing). Returns 0.0 on malformed input.

# ---- date math ----

# Hinnant's unix-seconds → (year, month, day, hour, minute, second).
# Returned as a 6-element [int] so we don't need tuples or a Map.
fn unix_to_ymd(seconds: int) -> [int]:
    days = seconds / 86400
    seconds_of_day = seconds % 86400
    hour = seconds_of_day / 3600
    minute = (seconds_of_day % 3600) / 60
    second = seconds_of_day % 60

    z = days + 719468
    era = z / 146097
    doe = z % 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    year_proleptic = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    day_of_month = doy - (153 * mp + 2) / 5 + 1
    month_proleptic = if mp < 10 then mp + 3 else mp - 9
    year_offset = if month_proleptic <= 2 then 1 else 0
    year = year_proleptic + year_offset
    [year, month_proleptic, day_of_month, hour, minute, second]

# Inverse: (Y, M, D, h, m, s) → unix seconds.
fn ymd_to_unix(year: int, month: int, day: int, hour: int, minute: int, second: int) -> int:
    year_adjusted = year - if month <= 2 then 1 else 0
    era = year_adjusted / 400
    yoe = year_adjusted % 400
    month_shifted = if month > 2 then month - 3 else month + 9
    doy = (153 * month_shifted + 2) / 5 + day - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    days = era * 146097 + doe - 719468
    days * 86400 + hour * 3600 + minute * 60 + second

# ---- formatters ----

fn format_ymd_separator(seconds: int, time_separator: Text) -> Text:
    parts = unix_to_ymd(seconds)
    year = at(parts, 0)
    month = at(parts, 1)
    day = at(parts, 2)
    hour = at(parts, 3)
    minute = at(parts, 4)
    second = at(parts, 5)
    fmt_int_pad(year, 4, "0") + "-" + fmt_int_pad(month, 2, "0") + "-" + fmt_int_pad(day, 2, "0") + time_separator + fmt_int_pad(hour, 2, "0") + ":" + fmt_int_pad(minute, 2, "0") + ":" + fmt_int_pad(second, 2, "0")

pub fn format_iso8601(seconds: f64) -> Text:
    format_ymd_separator(to_int(seconds), "T") + "Z"

pub fn format_datetime(seconds: f64) -> Text:
    format_ymd_separator(to_int(seconds), " ")

pub fn format_date(seconds: f64) -> Text:
    parts = unix_to_ymd(to_int(seconds))
    year = at(parts, 0)
    month = at(parts, 1)
    day = at(parts, 2)
    fmt_int_pad(year, 4, "0") + "-" + fmt_int_pad(month, 2, "0") + "-" + fmt_int_pad(day, 2, "0")

# ---- parser ----

# Strip an optional trailing 'Z' from an ISO 8601 string.
fn strip_trailing_z(text: Text) -> Text:
    trimmed = str_trim(text)
    if str_ends_with(trimmed, "Z"):
        bytes = bytes_from_text(trimmed)
        bytes_to_text(bytes_slice(bytes, 0, bytes_length(bytes) - 1))
    else:
        trimmed

# Split a "h:mm:ss" or "h:mm:ss.fff" time string into 3 ints. Truncates any
# fractional-second tail.
fn parse_time_part(time_text: Text) -> [int]:
    pieces = str_split(time_text, ":")
    hour = if len(pieces) >= 1 then str_to_int(at(pieces, 0)) else 0
    minute = if len(pieces) >= 2 then str_to_int(at(pieces, 1)) else 0
    raw_second = if len(pieces) >= 3 then at(pieces, 2) else "0"
    # Drop fractional seconds — split on '.' and keep the whole-second part.
    whole_pieces = str_split(raw_second, ".")
    second = str_to_int(at(whole_pieces, 0))
    [hour, minute, second]

# Best-effort ISO 8601 parser. Accepts `YYYY-MM-DDTHH:MM:SS[Z]` and
# `YYYY-MM-DD`. Returns 0.0 on malformed input.
pub fn parse_iso8601(text: Text) -> f64:
    cleaned = strip_trailing_z(text)
    date_and_time = str_split(cleaned, "T")
    date_text = at(date_and_time, 0)
    time_text = if len(date_and_time) >= 2 then at(date_and_time, 1) else "00:00:00"

    date_parts = str_split(date_text, "-")
    if len(date_parts) < 3:
        0.0
    else:
        year = str_to_int(at(date_parts, 0))
        month = str_to_int(at(date_parts, 1))
        day = str_to_int(at(date_parts, 2))
        time_parts = parse_time_part(time_text)
        hour = at(time_parts, 0)
        minute = at(time_parts, 1)
        second = at(time_parts, 2)
        if month == 0 or day == 0:
            0.0
        else:
            to_float(ymd_to_unix(year, month, day, hour, minute, second))
