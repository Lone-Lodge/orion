# format — typed format helpers (width, padding, radix conversion).
# Fully pure Orion. `fmt_float` uses round-then-split-int-and-frac; this
# isn't Ryu-shortest-roundtrip, but it's correct for the typical 0..15
# precision range we use for game/save/UI text.

pub fn fmt_float(value: f64, precision: int) -> Text:
    # Negative zero rounds to zero — handled by the abs trick.
    is_negative = value < 0.0
    absolute = if is_negative then 0.0 - value else value
    # Build 10^precision by repeated multiplication; pow is float-only.
    mut multiplier = 1.0
    mut precision_index = 0
    loop:
        if precision_index >= precision:
            break
        multiplier = multiplier * 10.0
        precision_index += 1
    # Round to (10^precision) units, then split.
    rounded_units = round(absolute * multiplier)
    integer_part = to_int(rounded_units / multiplier)
    frac_units = to_int(rounded_units - to_float(integer_part) * multiplier)
    # Format pieces.
    integer_text = fmt_int(integer_part, 0)
    sign_prefix = if is_negative and (integer_part != 0 or frac_units != 0) then "-" else ""
    if precision == 0:
        sign_prefix + integer_text
    else:
        fraction_text = fmt_int_pad(frac_units, precision, "0")
        sign_prefix + integer_text + "." + fraction_text

# Lowercase ASCII byte code for a digit 0..=15.
fn hex_digit(nibble: int) -> int:
    if nibble < 10 then nibble + 48      # '0' = 48
    else nibble + 87                     # 'a' = 97 → 97 - 10 = 87

# Reverse a byte array. Digit builders below produce least-significant
# digit first; this flips them so we can hand the result to bytes_to_text.
fn reverse_bytes(bytes: [int]) -> [int]:
    byte_count = bytes_length(bytes)
    mut output = bytes_zeros(0)
    mut byte_index = byte_count - 1
    loop:
        if byte_index < 0:
            break
        output = push(output, byte_at(bytes, byte_index))
        byte_index -= 1
    output

# Build hex digits of `value` (treated as u64) in reverse. Zero emits a single
# '0'. We iterate at most 16 nibbles — handles negative i64 correctly because
# the `& 15` mask discards sign bits each step.
fn hex_digits_rev(value: int) -> [int]:
    if value == 0:
        push(bytes_zeros(0), 48)
    else:
        mut remaining = value
        mut digits = bytes_zeros(0)
        mut nibble_index = 0
        loop:
            if nibble_index >= 16:
                break
            if remaining == 0:
                break
            digits = push(digits, hex_digit(remaining & 15))
            remaining = remaining >> 4
            nibble_index += 1
        digits

fn oct_digits_rev(value: int) -> [int]:
    if value == 0:
        push(bytes_zeros(0), 48)
    else:
        mut remaining = value
        mut digits = bytes_zeros(0)
        mut digit_index = 0
        loop:
            if digit_index >= 22:
                break
            if remaining == 0:
                break
            digits = push(digits, 48 + (remaining & 7))
            remaining = remaining >> 3
            digit_index += 1
        digits

fn bin_digits_rev(value: int) -> [int]:
    if value == 0:
        push(bytes_zeros(0), 48)
    else:
        mut remaining = value
        mut digits = bytes_zeros(0)
        mut bit_index = 0
        loop:
            if bit_index >= 64:
                break
            if remaining == 0:
                break
            digits = push(digits, 48 + (remaining & 1))
            remaining = remaining >> 1
            bit_index += 1
        digits

# Decimal digits of `value` in reverse. Negative numbers get a leading '-'
# (which, after reversing, ends up at the front of the output).
# Note: i64::MIN is not handled cleanly — extreme edge case.
fn dec_digits_rev(value: int) -> [int]:
    if value == 0:
        push(bytes_zeros(0), 48)
    else:
        is_negative = value < 0
        mut remaining = if value < 0 then 0 - value else value
        mut digits = bytes_zeros(0)
        mut digit_index = 0
        loop:
            if remaining == 0:
                break
            if digit_index >= 20:
                break
            digits = push(digits, 48 + (remaining % 10))
            remaining = remaining / 10
            digit_index += 1
        if is_negative:
            digits = push(digits, 45)
        digits

pub fn fmt_hex(value: int) -> Text:
    bytes_to_text(reverse_bytes(hex_digits_rev(value)))

pub fn fmt_hex_pad(value: int, width: int) -> Text:
    pad_left(fmt_hex(value), width, "0")

pub fn fmt_oct(value: int) -> Text:
    bytes_to_text(reverse_bytes(oct_digits_rev(value)))

pub fn fmt_bin(value: int) -> Text:
    bytes_to_text(reverse_bytes(bin_digits_rev(value)))

pub fn fmt_int(value: int, width: int) -> Text:
    pad_left(bytes_to_text(reverse_bytes(dec_digits_rev(value))), width, " ")

pub fn fmt_int_pad(value: int, width: int, pad: Text) -> Text:
    pad_left(bytes_to_text(reverse_bytes(dec_digits_rev(value))), width, pad)

pub fn pad_left(text: Text, width: int, pad: Text) -> Text:
    current_length = len(text)
    if current_length >= width then text
    else str_repeat(pad, width - current_length) + text

pub fn pad_right(text: Text, width: int, pad: Text) -> Text:
    current_length = len(text)
    if current_length >= width then text
    else text + str_repeat(pad, width - current_length)
