# process — spawn external commands. Pure Orion on top of OS primitives.

extern fn __os_run_command(cmd: Text, args: [Text]) -> int
extern fn __os_capture_stdout(cmd: Text, args: [Text]) -> Text
extern fn __os_capture_stderr(cmd: Text, args: [Text]) -> Text

# Run a command synchronously, returning its exit code (-1 on spawn failure).
pub fn run_command(cmd: Text, args: [Text]) -> int:
    __os_run_command(cmd, args)

# Run a command and capture stdout. Returns the text (empty on failure).
pub fn capture_stdout(cmd: Text, args: [Text]) -> Text:
    __os_capture_stdout(cmd, args)

# Run a command and capture stderr. Returns the text (empty on failure).
pub fn capture_stderr(cmd: Text, args: [Text]) -> Text:
    __os_capture_stderr(cmd, args)
