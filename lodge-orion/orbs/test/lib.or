
pub fn assert_true(cond: bool): require cond
pub fn assert_false(cond: bool): require not cond
pub fn assert_eq_int(actual: int, expected: int): require actual == expected
pub fn assert_eq_float(actual: f64, expected: f64): require actual == expected
pub fn assert_eq_text(actual: Text, expected: Text): require actual == expected
pub fn assert_eq_bool(actual: bool, expected: bool): require actual == expected
pub fn assert_near(actual: f64, expected: f64, tol: f64): require abs(actual - expected) <= tol
pub fn assert_lt(a: f64, b: f64): require a < b
pub fn assert_le(a: f64, b: f64): require a <= b
pub fn assert_gt(a: f64, b: f64): require a > b
pub fn assert_ge(a: f64, b: f64): require a >= b
pub fn assert_in_range(x: f64, lo: f64, hi: f64): require x >= lo and x <= hi
