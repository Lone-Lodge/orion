# env — process args, env vars, exit. Pure Orion on top of OS primitives.

extern fn __os_arg(index: int) -> Text
extern fn __os_arg_count() -> int
extern fn __os_env_var(name: Text) -> Text
extern fn __os_exit(code: int)

pub fn arg(index: int) -> Text:
    __os_arg(index)

pub fn arg_count() -> int:
    __os_arg_count()

pub fn env_var(name: Text) -> Text:
    __os_env_var(name)

# Read `name` from the environment, or fall back to `default` when unset
# (the OS primitive returns "" for missing vars, which we treat as unset).
pub fn env_var_or(name: Text, default: Text) -> Text:
    found = __os_env_var(name)
    if found == "":
        default
    else:
        found

pub fn exit_with(code: int):
    __os_exit(code)
