# random — PCG-32 RNG, fully pure Orion.
#
# State is held in a thread-local slot via `slot_get`/`slot_set`. The
# original Rust impl used Arc<Mutex<Pcg32>>; the Orion version uses the
# same algorithm with the state wrapped in a 2-element [state, inc] list
# and stored under the key "random:pcg".

fn default_state() -> [int]:
    # Re-seed of the original Rust default (0xCAFE_F00D_DEAD_BEEF).
    initialise_state(0xCAFE_F00D_DEAD_BEEF)

# Build a fresh (state, inc) pair from `seed_value`.
fn initialise_state(seed_value: int) -> [int]:
    increment = (seed_value << 1) | 1
    # Mix once with state=0 + inc — same pre-seed shuffle Pcg32::new does.
    pre_state = 0 * 6364136223846793005 + increment
    [pre_state + seed_value, increment]

fn current_state() -> [int]:
    stored = slot_get("random:pcg")
    if type_of(stored) == "none" then default_state()
    else stored

fn store_state(new_state: [int]):
    slot_set("random:pcg", new_state)

# Advance the PCG state, return a 32-bit unsigned-as-int value.
fn next_u32() -> int:
    state_pair = current_state()
    previous_state = at(state_pair, 0)
    increment = at(state_pair, 1)
    new_state = previous_state * 6364136223846793005 + increment
    store_state([new_state, increment])
    # XSH-RR output function (PCG O'Neill 2014).
    xorshifted = ((previous_state >> 18) ^ previous_state) >> 27
    rotation = (previous_state >> 59) & 31
    rotated = ((xorshifted >> rotation) | (xorshifted << (32 - rotation))) & 0xFFFFFFFF
    rotated

# 53-bit-precision float in [0, 1).
fn next_f64() -> f64:
    high = next_u32()
    low = next_u32()
    # Top 53 bits of the combined 64-bit value.
    bits = ((high << 32) | low) >> 11
    to_float(bits & 0x001F_FFFF_FFFF_FFFF) / 9007199254740992.0

pub fn seed(seed_value: int):
    store_state(initialise_state(seed_value))

pub fn random_int(lower: int, upper: int) -> int:
    if upper <= lower:
        lower
    else:
        span = upper - lower
        lower + (next_u32() % span)

pub fn random_float() -> f64:
    next_f64()

pub fn random_range(lower: f64, upper: f64) -> f64:
    lower + (upper - lower) * next_f64()

pub fn random_bool() -> bool:
    (next_u32() & 1) == 1

pub fn random_unit() -> f64:
    next_f64()
