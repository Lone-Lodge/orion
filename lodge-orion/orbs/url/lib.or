# url — percent-encoding (RFC 3986 unreserved set) and minimal URL parsing.
# Full pure Orion since v0.0.13.

use bytes
# True if `byte` is in the RFC 3986 unreserved set: ALPHA / DIGIT / "-" / "_" / "." / "~"
fn is_url_safe(byte: int) -> bool:
    if byte >= 65 and byte <= 90 then true         # 'A'..'Z'
    else if byte >= 97 and byte <= 122 then true   # 'a'..'z'
    else if byte >= 48 and byte <= 57 then true    # '0'..'9'
    else if byte == 45 then true                   # '-'
    else if byte == 95 then true                   # '_'
    else if byte == 46 then true                   # '.'
    else if byte == 126 then true                  # '~'
    else false

# 0..15 → uppercase hex ASCII byte code.
fn upper_hex_digit(nibble: int) -> int:
    if nibble < 10 then nibble + 48
    else nibble + 55

# ASCII hex digit ('0'-'9'/'a'-'f'/'A'-'F') → 0..15. Returns -1 for anything else.
fn decode_hex_digit(character: int) -> int:
    if character >= 48 and character <= 57 then character - 48
    else if character >= 65 and character <= 70 then character - 55
    else if character >= 97 and character <= 102 then character - 87
    else -1

pub fn url_encode(text: Text) -> Text:
    bytes = bytes_from_text(text)
    byte_count = bytes_length(bytes)
    mut output = bytes_zeros(0)
    for byte_index in 0..<byte_count:
        byte = byte_at(bytes, byte_index)
        if is_url_safe(byte):
            output = push(output, byte)
        else:
            output = push(output, 37)                              # '%'
            output = push(output, upper_hex_digit((byte >> 4) & 15))
            output = push(output, upper_hex_digit(byte & 15))
    bytes_to_text(output)

pub fn url_decode(text: Text) -> Text:
    bytes = bytes_from_text(text)
    byte_count = bytes_length(bytes)
    mut output = bytes_zeros(0)
    mut byte_index = 0
    loop:
        if byte_index >= byte_count:
            break
        byte = byte_at(bytes, byte_index)
        if byte == 37 and byte_index + 2 < byte_count:             # '%XX'
            high_nibble = decode_hex_digit(byte_at(bytes, byte_index + 1))
            low_nibble = decode_hex_digit(byte_at(bytes, byte_index + 2))
            if high_nibble >= 0 and low_nibble >= 0:
                output = push(output, (high_nibble << 4) | low_nibble)
                byte_index += 3
            else:
                output = push(output, 37)
                byte_index += 1
        else:
            if byte == 43:                                         # '+' → space
                output = push(output, 32)
            else:
                output = push(output, byte)
            byte_index += 1
    bytes_to_text(output)

# ---- parser helpers ----

# Extract bytes[start..end] as Text. `end` is exclusive; negative bounds
# clamp to 0; over-large bounds clamp to len.
fn substring(text: Text, start: int, end: int) -> Text:
    bytes = bytes_from_text(text)
    bytes_to_text(bytes_slice(bytes, start, end))

# First occurrence of `needle` in `haystack`, or -1.
fn find_substring(haystack: Text, needle: Text) -> int:
    haystack_bytes = bytes_from_text(haystack)
    needle_bytes = bytes_from_text(needle)
    haystack_length = bytes_length(haystack_bytes)
    needle_length = bytes_length(needle_bytes)
    if needle_length == 0:
        0
    else:
        if haystack_length < needle_length:
            0 - 1
        else:
            mut found_index = 0 - 1
            mut search_index = 0
            mut last_search = haystack_length - needle_length
            loop:
                if found_index >= 0 or search_index > last_search:
                    break
                mut all_match = true
                for offset in 0..<needle_length:
                    if byte_at(haystack_bytes, search_index + offset) != byte_at(needle_bytes, offset):
                        all_match = false
                if all_match:
                    found_index = search_index
                search_index += 1
            found_index

# First occurrence of `byte` in `text`, or -1.
fn find_byte(text: Text, byte: int) -> int:
    bytes = bytes_from_text(text)
    byte_count = bytes_length(bytes)
    mut found_index = 0 - 1
    for byte_index in 0..<byte_count:
        if found_index < 0 and byte_at(bytes, byte_index) == byte:
            found_index = byte_index
    found_index

# Last occurrence of `byte` in `text`, or -1.
fn rfind_byte(text: Text, byte: int) -> int:
    bytes = bytes_from_text(text)
    byte_count = bytes_length(bytes)
    mut found_index = 0 - 1
    for byte_index in 0..<byte_count:
        if byte_at(bytes, byte_index) == byte:
            found_index = byte_index
    found_index

# Split URI into { scheme, host, port, path, query }. Missing pieces are
# returned as empty Text. Best-effort — doesn't validate RFC 3986 strictly.
pub fn url_parse(text: Text):
    text_length = bytes_length(bytes_from_text(text))
    # 1. Split on "://" → scheme + rest
    scheme_end = find_substring(text, "://")
    scheme = if scheme_end < 0 then "" else substring(text, 0, scheme_end)
    rest_start = if scheme_end < 0 then 0 else scheme_end + 3
    rest = substring(text, rest_start, text_length)
    rest_length = bytes_length(bytes_from_text(rest))

    # 2. Split rest on first "/" → authority + path_and_query
    slash_index = find_byte(rest, 47)
    authority = if slash_index < 0 then rest else substring(rest, 0, slash_index)
    path_and_query = if slash_index < 0 then "" else substring(rest, slash_index, rest_length)
    authority_length = bytes_length(bytes_from_text(authority))
    path_and_query_length = bytes_length(bytes_from_text(path_and_query))

    # 3. Split authority on LAST ":" → host + port
    colon_index = rfind_byte(authority, 58)
    host = if colon_index < 0 then authority else substring(authority, 0, colon_index)
    port = if colon_index < 0 then "" else substring(authority, colon_index + 1, authority_length)

    # 4. Split path_and_query on first "?" → path + query string
    question_index = find_byte(path_and_query, 63)
    path = if question_index < 0 then path_and_query else substring(path_and_query, 0, question_index)
    # Avoid `query` as the local name — it collides with the ECS `query` keyword.
    query_string = if question_index < 0 then "" else substring(path_and_query, question_index + 1, path_and_query_length)

    {"scheme": scheme, "host": host, "port": port, "path": path, "query": query_string}
