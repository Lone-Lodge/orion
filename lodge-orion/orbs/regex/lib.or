# regex — glob + a tiny regex subset, fully pure Orion since v0.0.15.
#
# Engine supports: literals, `.` (any char), `*`/`+`/`?` quantifiers,
# `^` / `$` anchors, `\\X` escapes, `[abc]` and `[a-z]` character classes.
# No alternation, groups, backreferences, lookaround, or `\d`/`\w`-style
# shorthand — match the original native impl exactly.

# --- glob (recursive byte-compare) ---

fn glob_match_at(subject: [int], subject_length: int, pattern: [int], pattern_length: int, subject_index: int, pattern_index: int) -> bool:
    if pattern_index >= pattern_length:
        subject_index >= subject_length
    else:
        pattern_byte = byte_at(pattern, pattern_index)
        if pattern_byte == 42:        # '*'
            mut found = false
            mut skip_count = 0
            loop:
                if found:
                    break
                if subject_index + skip_count > subject_length:
                    break
                if glob_match_at(subject, subject_length, pattern, pattern_length, subject_index + skip_count, pattern_index + 1):
                    found = true
                else:
                    skip_count += 1
            found
        else:
            if pattern_byte == 63:    # '?'
                subject_index < subject_length and glob_match_at(subject, subject_length, pattern, pattern_length, subject_index + 1, pattern_index + 1)
            else:
                subject_index < subject_length and byte_at(subject, subject_index) == pattern_byte and glob_match_at(subject, subject_length, pattern, pattern_length, subject_index + 1, pattern_index + 1)

pub fn match_glob(subject: Text, pattern: Text) -> bool:
    subject_bytes = bytes_from_text(subject)
    pattern_bytes = bytes_from_text(pattern)
    glob_match_at(subject_bytes, bytes_length(subject_bytes), pattern_bytes, bytes_length(pattern_bytes), 0, 0)

# --- regex helpers ---

# How many bytes does the atom starting at `pattern_index` cover?
# Literal/dot: 1. `\X` escape: 2. `[…]` class: up to and including `]`.
fn atom_length(pattern: [int], total_pattern: int, pattern_index: int) -> int:
    if pattern_index >= total_pattern:
        0
    else:
        first_byte = byte_at(pattern, pattern_index)
        if first_byte == 92:                 # '\'
            2
        else:
            if first_byte == 91:             # '['
                mut closing_index = pattern_index + 1
                loop:
                    if closing_index >= total_pattern:
                        break
                    if byte_at(pattern, closing_index) == 93:    # ']'
                        break
                    closing_index += 1
                closing_index - pattern_index + 1
            else:
                1

# True if `character` matches the class body in `pattern[class_start..class_end_exclusive]`.
# Handles `a-z` ranges and literal characters.
fn class_matches(pattern: [int], class_start: int, class_end: int, character: int) -> bool:
    mut found = false
    mut walk = class_start
    loop:
        if found:
            break
        if walk >= class_end:
            break
        if walk + 2 < class_end and byte_at(pattern, walk + 1) == 45:    # 'X-Y'
            if character >= byte_at(pattern, walk) and character <= byte_at(pattern, walk + 2):
                found = true
            walk += 3
        else:
            if character == byte_at(pattern, walk):
                found = true
            walk += 1
    found

# Does `character` match the atom starting at `pattern_index`?
fn atom_matches(pattern: [int], pattern_index: int, atom_len: int, character: int) -> bool:
    first_byte = byte_at(pattern, pattern_index)
    if first_byte == 46:                     # '.'
        true
    else:
        if first_byte == 92:                 # '\X'
            character == byte_at(pattern, pattern_index + 1)
        else:
            if first_byte == 91:             # '[…]'
                class_matches(pattern, pattern_index + 1, pattern_index + atom_len - 1, character)
            else:
                character == first_byte

# Match `pattern` starting exactly at `subject_index`. Returns end index
# on success, -1 on failure.
fn match_here(subject: [int], total_subject: int, pattern: [int], total_pattern: int, subject_index: int, pattern_index: int) -> int:
    if pattern_index >= total_pattern:
        subject_index
    else:
        if pattern_index == total_pattern - 1 and byte_at(pattern, pattern_index) == 36:    # '$'
            if subject_index == total_subject then subject_index else 0 - 1
        else:
            current_atom_length = atom_length(pattern, total_pattern, pattern_index)
            rest_position = pattern_index + current_atom_length
            quantifier = if rest_position < total_pattern then byte_at(pattern, rest_position) else 0
            if quantifier == 42:                                                            # atom *
                match_star(subject, total_subject, pattern, total_pattern, subject_index, pattern_index, current_atom_length, rest_position + 1)
            else:
                if quantifier == 43:                                                        # atom +
                    if subject_index < total_subject and atom_matches(pattern, pattern_index, current_atom_length, byte_at(subject, subject_index)):
                        match_star(subject, total_subject, pattern, total_pattern, subject_index + 1, pattern_index, current_atom_length, rest_position + 1)
                    else:
                        0 - 1
                else:
                    if quantifier == 63:                                                    # atom ?
                        if subject_index < total_subject and atom_matches(pattern, pattern_index, current_atom_length, byte_at(subject, subject_index)):
                            consumed = match_here(subject, total_subject, pattern, total_pattern, subject_index + 1, rest_position + 1)
                            if consumed >= 0 then consumed
                            else match_here(subject, total_subject, pattern, total_pattern, subject_index, rest_position + 1)
                        else:
                            match_here(subject, total_subject, pattern, total_pattern, subject_index, rest_position + 1)
                    else:
                        # Plain atom — must match exactly.
                        if subject_index < total_subject and atom_matches(pattern, pattern_index, current_atom_length, byte_at(subject, subject_index)):
                            match_here(subject, total_subject, pattern, total_pattern, subject_index + 1, rest_position)
                        else:
                            0 - 1

# Greedy `atom*` followed by `rest`. Consume as many atom-matches as
# possible, then walk back one at a time until `rest` matches too.
fn match_star(subject: [int], total_subject: int, pattern: [int], total_pattern: int, start_index: int, atom_pattern_index: int, atom_len: int, rest_pattern_index: int) -> int:
    mut subject_index = start_index
    loop:
        if subject_index >= total_subject:
            break
        if not atom_matches(pattern, atom_pattern_index, atom_len, byte_at(subject, subject_index)):
            break
        subject_index += 1
    # Backtrack.
    mut result = 0 - 1
    mut walk = subject_index
    loop:
        if result >= 0:
            break
        attempt = match_here(subject, total_subject, pattern, total_pattern, walk, rest_pattern_index)
        if attempt >= 0:
            result = attempt
        else:
            if walk == start_index:
                break
            walk -= 1
    result

# Search for the first occurrence. `^` anchors. Returns [start, end] or [-1, -1].
fn regex_search(subject: Text, pattern: Text) -> [int]:
    subject_bytes = bytes_from_text(subject)
    pattern_bytes = bytes_from_text(pattern)
    total_subject = bytes_length(subject_bytes)
    total_pattern = bytes_length(pattern_bytes)
    # Strip leading '^' if present — that signals anchored match.
    is_anchored = total_pattern > 0 and byte_at(pattern_bytes, 0) == 94
    effective_start = if is_anchored then 1 else 0
    mut start_index = 0
    mut found_start = 0 - 1
    mut found_end = 0 - 1
    loop:
        if found_start >= 0:
            break
        if start_index > total_subject:
            break
        attempt_end = match_here(subject_bytes, total_subject, pattern_bytes, total_pattern, start_index, effective_start)
        if attempt_end >= 0:
            found_start = start_index
            found_end = attempt_end
        else:
            if is_anchored:
                break
            start_index += 1
    [found_start, found_end]

pub fn match_regex(subject: Text, pattern: Text) -> bool:
    span = regex_search(subject, pattern)
    at(span, 0) >= 0

pub fn regex_find(subject: Text, pattern: Text) -> Text:
    span = regex_search(subject, pattern)
    start = at(span, 0)
    end = at(span, 1)
    if start < 0:
        ""
    else:
        bytes_to_text(bytes_slice(bytes_from_text(subject), start, end))
