# log — leveled logger, fully pure Orion.
#
# Levels: 0 = error only, 1 = +warn, 2 = +info (default), 3 = +debug.
# Output goes to stderr via `eprint`. Timestamp is unix seconds since
# epoch from the `time` orb (kept native — that's a syscall).

# `now` comes from the `time` orb — declared there as a pure-Orion wrapper
# over `__os_unix_time`. No extern declaration needed here.

fn current_level() -> int:
    stored = slot_get("log:level")
    if type_of(stored) == "none" then 2
    else stored

pub fn set_log_level(level: int):
    slot_set("log:level", clamp(level, 0, 3))

fn emit(tag: Text, threshold: int, message: Text):
    if current_level() >= threshold:
        timestamp = to_int(now())
        eprint("[" + fmt_int(timestamp, 0) + "] " + tag + " " + message)

pub fn log_error(message: Text):
    emit("ERROR", 0, message)

pub fn log_warn(message: Text):
    emit("WARN ", 1, message)

pub fn log_info(message: Text):
    emit("INFO ", 2, message)

pub fn log_debug(message: Text):
    emit("DEBUG", 3, message)
