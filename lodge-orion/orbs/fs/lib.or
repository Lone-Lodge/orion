# fs — directory ops and file metadata. Pure Orion on top of OS primitives.

extern fn __os_list_dir(path: Text) -> [Text]
extern fn __os_mkdir(path: Text) -> bool
extern fn __os_mkdir_all(path: Text) -> bool
extern fn __os_rmdir(path: Text) -> bool
extern fn __os_remove_file(path: Text) -> bool
extern fn __os_copy_file(from: Text, to: Text) -> bool
extern fn __os_rename(from: Text, to: Text) -> bool
extern fn __os_file_size(path: Text) -> int
extern fn __os_is_dir(path: Text) -> bool
extern fn __os_is_file(path: Text) -> bool

pub fn list_dir(path: Text) -> [Text]:
    __os_list_dir(path)

pub fn mkdir(path: Text) -> bool:
    __os_mkdir(path)

pub fn mkdir_all(path: Text) -> bool:
    __os_mkdir_all(path)

pub fn rmdir(path: Text) -> bool:
    __os_rmdir(path)

pub fn remove_file(path: Text) -> bool:
    __os_remove_file(path)

pub fn copy_file(from: Text, to: Text) -> bool:
    __os_copy_file(from, to)

pub fn rename(from: Text, to: Text) -> bool:
    __os_rename(from, to)

pub fn file_size(path: Text) -> int:
    __os_file_size(path)

pub fn is_dir(path: Text) -> bool:
    __os_is_dir(path)

pub fn is_file(path: Text) -> bool:
    __os_is_file(path)
