# sysinfo — basic host info. Pure Orion on top of OS primitives.

extern fn __os_cpu_count() -> int
extern fn __os_name() -> Text
extern fn __os_family() -> Text
extern fn __os_arch() -> Text

# Logical CPU count (or 1 if the runtime can't query the kernel).
pub fn cpu_count() -> int:
    __os_cpu_count()

# Compile-time target OS: `windows`, `linux`, `macos`, etc.
pub fn os_name() -> Text:
    __os_name()

# OS family: `unix` or `windows`.
pub fn os_family() -> Text:
    __os_family()

# CPU architecture: `x86_64`, `aarch64`, etc.
pub fn arch() -> Text:
    __os_arch()
