# stats — summary statistics over [f64].
#
# Pure Orion. Empty-list behaviour: count/sum/mean/min/max/variance/stddev
# all return 0.0 (or 0 for count) to match the Rust impl this replaced.

pub fn stats_count(values: [f64]) -> int = len(values)

pub fn stats_sum(values: [f64]) -> f64:
    mut total = 0.0
    for value in values:
        total += value
    total

pub fn stats_mean(values: [f64]) -> f64:
    count = len(values)
    if count == 0:
        0.0
    else:
        stats_sum(values) / to_float(count)

pub fn stats_min(values: [f64]) -> f64:
    count = len(values)
    if count == 0:
        0.0
    else:
        mut lowest = at(values, 0)
        for value in values:
            if value < lowest:
                lowest = value
        lowest

pub fn stats_max(values: [f64]) -> f64:
    count = len(values)
    if count == 0:
        0.0
    else:
        mut highest = at(values, 0)
        for value in values:
            if value > highest:
                highest = value
        highest

pub fn stats_variance(values: [f64]) -> f64:
    count = len(values)
    if count < 2:
        0.0
    else:
        mean = stats_mean(values)
        mut sum_of_squares = 0.0
        for value in values:
            deviation = value - mean
            sum_of_squares += deviation * deviation
        sum_of_squares / to_float(count)

pub fn stats_stddev(values: [f64]) -> f64:
    sqrt(stats_variance(values))

pub fn stats_median(values: [f64]) -> f64:
    count = len(values)
    if count == 0:
        0.0
    else:
        sorted = list_sort_asc(values)
        middle = count / 2
        if count % 2 == 1:
            at(sorted, middle)
        else:
            (at(sorted, middle - 1) + at(sorted, middle)) * 0.5

# Linear-interpolation percentile (numpy 'linear' / Python statistics 'linear').
# `percent` is clamped to [0, 100]; out-of-range values do not panic.
pub fn stats_percentile(values: [f64], percent: f64) -> f64:
    count = len(values)
    if count == 0:
        0.0
    else:
        if count == 1:
            at(values, 0)
        else:
            sorted = list_sort_asc(values)
            percentage = clamp(percent, 0.0, 100.0)
            rank = (percentage / 100.0) * to_float(count - 1)
            low_index = to_int(floor(rank))
            high_index = to_int(ceil(rank))
            if low_index == high_index:
                at(sorted, low_index)
            else:
                fraction = rank - to_float(low_index)
                at(sorted, low_index) * (1.0 - fraction) + at(sorted, high_index) * fraction
