# time — clock and sleep, pure Orion on top of two OS primitives.

# Seconds since UNIX epoch (or monotonic fallback if the system clock
# predates 1970, which never happens in practice but the runtime handles it).
extern fn __os_unix_time() -> f64

# Block the current thread for `seconds` (clamped at 0).
extern fn __os_sleep_seconds(seconds: f64)

pub fn now() -> f64:
    __os_unix_time()

pub fn elapsed(start: f64) -> f64:
    delta = now() - start
    if delta < 0.0 then 0.0 else delta

pub fn sleep(seconds: f64):
    if seconds > 0.0:
        __os_sleep_seconds(seconds)
