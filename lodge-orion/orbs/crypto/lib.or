# crypto — SHA-256 (FIPS 180-4) in pure Orion.
#
# Built on `bytes` orb. All arithmetic is i64 with explicit `& 0xFFFFFFFF`
# masks after each wrapping op to mirror u32 behavior.
#
# Variable naming: spec-letters (a..h, w, k, s0/s1, t1/t2, x/y/z) are kept
# verbatim so the code lines up with FIPS 180-4 — see CONVENTIONS.md §8 for
# the algorithm-letter exception. All non-spec locals use descriptive names.

fn sha256_k_table() -> [int]:
    # Orion list literals don't support newlines between elements yet,
    # so the K-table is a single long line. FIPS 180-4 §4.2.2.
    [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

fn sha256_h0() -> [int]:
    [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]

# Spec sigma functions — x/y/z and the rotation count are FIPS notation.
fn rotr32(x: int, n: int) -> int:
    ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF

fn ch32(x: int, y: int, z: int) -> int:
    ((x & y) ^ (~x & z)) & 0xFFFFFFFF

fn maj32(x: int, y: int, z: int) -> int:
    ((x & y) ^ (x & z) ^ (y & z)) & 0xFFFFFFFF

fn big_sigma0(x: int) -> int:
    (rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22)) & 0xFFFFFFFF

fn big_sigma1(x: int) -> int:
    (rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25)) & 0xFFFFFFFF

fn small_sigma0(x: int) -> int:
    (rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3)) & 0xFFFFFFFF

fn small_sigma1(x: int) -> int:
    (rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10)) & 0xFFFFFFFF

fn sha256_pad(message: [int]) -> [int]:
    message_length = bytes_length(message)
    bit_length = message_length * 8
    mut padded = bytes_concat(message, push(bytes_zeros(0), 0x80))
    loop:
        remainder = bytes_length(padded) % 64
        if remainder == 56:
            break
        padded = push(padded, 0)
    padded = push(padded, (bit_length >> 56) & 0xFF)
    padded = push(padded, (bit_length >> 48) & 0xFF)
    padded = push(padded, (bit_length >> 40) & 0xFF)
    padded = push(padded, (bit_length >> 32) & 0xFF)
    padded = push(padded, (bit_length >> 24) & 0xFF)
    padded = push(padded, (bit_length >> 16) & 0xFF)
    padded = push(padded, (bit_length >> 8) & 0xFF)
    padded = push(padded, bit_length & 0xFF)
    padded

fn read_be_u32(bytes: [int], offset: int) -> int:
    ((byte_at(bytes, offset) << 24) | (byte_at(bytes, offset + 1) << 16) | (byte_at(bytes, offset + 2) << 8) | byte_at(bytes, offset + 3)) & 0xFFFFFFFF

fn push_be_u32(buffer: [int], value: int) -> [int]:
    push(push(push(push(buffer, (value >> 24) & 0xFF), (value >> 16) & 0xFF), (value >> 8) & 0xFF), value & 0xFF)

fn sha256_bytes(message: [int]) -> [int]:
    padded = sha256_pad(message)
    padded_length = bytes_length(padded)
    k = sha256_k_table()
    mut h = sha256_h0()
    mut chunk_offset = 0
    loop:
        if chunk_offset >= padded_length:
            break
        # ---- build message schedule w[0..64] ----
        mut w = bytes_zeros(0)
        for schedule_index in 0..<16:
            w = push(w, read_be_u32(padded, chunk_offset + schedule_index * 4))
        for schedule_index in 16..<64:
            s0 = small_sigma0(at(w, schedule_index - 15))
            s1 = small_sigma1(at(w, schedule_index - 2))
            extended = (at(w, schedule_index - 16) + s0 + at(w, schedule_index - 7) + s1) & 0xFFFFFFFF
            w = push(w, extended)
        # ---- compression loop ----
        mut a = at(h, 0)
        mut b = at(h, 1)
        mut c = at(h, 2)
        mut d = at(h, 3)
        mut e = at(h, 4)
        mut f = at(h, 5)
        mut g = at(h, 6)
        mut hh = at(h, 7)
        for round in 0..<64:
            t1 = (hh + big_sigma1(e) + ch32(e, f, g) + at(k, round) + at(w, round)) & 0xFFFFFFFF
            t2 = (big_sigma0(a) + maj32(a, b, c)) & 0xFFFFFFFF
            hh = g
            g = f
            f = e
            e = (d + t1) & 0xFFFFFFFF
            d = c
            c = b
            b = a
            a = (t1 + t2) & 0xFFFFFFFF
        # ---- fold back into h ----
        h = [(at(h, 0) + a) & 0xFFFFFFFF, (at(h, 1) + b) & 0xFFFFFFFF, (at(h, 2) + c) & 0xFFFFFFFF, (at(h, 3) + d) & 0xFFFFFFFF, (at(h, 4) + e) & 0xFFFFFFFF, (at(h, 5) + f) & 0xFFFFFFFF, (at(h, 6) + g) & 0xFFFFFFFF, (at(h, 7) + hh) & 0xFFFFFFFF]
        chunk_offset += 64
    # Emit 32 raw bytes (8 u32 in BE order).
    mut digest_bytes = bytes_zeros(0)
    for hash_index in 0..<8:
        digest_bytes = push_be_u32(digest_bytes, at(h, hash_index))
    digest_bytes

fn hex_nibble(nibble: int) -> int:
    if nibble < 10 then nibble + 48 else nibble + 87

fn hex_encode_bytes(bytes: [int]) -> Text:
    byte_count = bytes_length(bytes)
    mut output = bytes_zeros(0)
    for byte_index in 0..<byte_count:
        byte_value = byte_at(bytes, byte_index)
        output = push(output, hex_nibble((byte_value >> 4) & 15))
        output = push(output, hex_nibble(byte_value & 15))
    bytes_to_text(output)

pub fn sha256(text: Text) -> Text:
    hex_encode_bytes(sha256_bytes(bytes_from_text(text)))

pub fn sha256_short(text: Text) -> Text:
    bytes_to_text(bytes_slice(bytes_from_text(sha256(text)), 0, 8))
