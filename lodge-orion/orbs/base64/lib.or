# base64 — standard RFC 4648 alphabet with '=' padding.
# Pure Orion, built on bytes_from_text / bytes_to_text / byte_at / bit-ops.

# Map a 6-bit value (0..=63) to the ASCII byte code of its base64 character.
# Encoded as a conditional chain — no lookup table needed.
fn b64_char(value: int) -> int:
    if value < 26 then value + 65        # 'A'..'Z'  (65 = 'A')
    else if value < 52 then value + 71   # 'a'..'z'  (97 - 26 = 71)
    else if value < 62 then value - 4    # '0'..'9'  (48 - 52 = -4)
    else if value == 62 then 43          # '+'
    else 47                              # '/'

# Reverse map: ASCII byte → 6-bit value (0..=63),
# returns -2 for '=' padding, -1 for any other character (whitespace, junk).
fn b64_val(character: int) -> int:
    if character >= 65 and character <= 90 then character - 65         # 'A'..'Z'
    else if character >= 97 and character <= 122 then character - 71   # 'a'..'z'
    else if character >= 48 and character <= 57 then character + 4     # '0'..'9'
    else if character == 43 then 62                                    # '+'
    else if character == 47 then 63                                    # '/'
    else if character == 61 then -2                                    # '='
    else -1

pub fn base64_encode(text: Text) -> Text:
    base64_encode_bytes(bytes_from_text(text))

# Binary-safe entry — sha1_raw digests etc. must NOT roundtrip through
# Text (bytes_to_text mangles non-UTF-8 bytes into U+FFFD).
pub fn base64_encode_bytes(bytes: [int]) -> Text:
    byte_count = bytes_length(bytes)
    full_triplets = byte_count / 3
    remainder = byte_count - full_triplets * 3
    mut output = bytes_zeros(0)
    mut input_index = 0
    for _triplet in 0..<full_triplets:
        first = byte_at(bytes, input_index)
        second = byte_at(bytes, input_index + 1)
        third = byte_at(bytes, input_index + 2)
        output = push(output, b64_char(first >> 2))
        output = push(output, b64_char(((first & 3) << 4) | (second >> 4)))
        output = push(output, b64_char(((second & 15) << 2) | (third >> 6)))
        output = push(output, b64_char(third & 63))
        input_index += 3
    if remainder == 1:
        first = byte_at(bytes, input_index)
        output = push(output, b64_char(first >> 2))
        output = push(output, b64_char((first & 3) << 4))
        output = push(output, 61)
        output = push(output, 61)
    else:
        if remainder == 2:
            first = byte_at(bytes, input_index)
            second = byte_at(bytes, input_index + 1)
            output = push(output, b64_char(first >> 2))
            output = push(output, b64_char(((first & 3) << 4) | (second >> 4)))
            output = push(output, b64_char((second & 15) << 2))
            output = push(output, 61)
    bytes_to_text(output)

pub fn base64_decode(text: Text) -> Text:
    input_bytes = bytes_from_text(text)
    input_length = bytes_length(input_bytes)
    mut output = bytes_zeros(0)
    # State machine: accumulate up to 4 six-bit values, then emit 3 bytes.
    mut sextet_0 = 0
    mut sextet_1 = 0
    mut sextet_2 = 0
    mut sextet_3 = 0
    mut filled = 0
    mut stop = false
    for input_index in 0..<input_length:
        if not stop:
            character = byte_at(input_bytes, input_index)
            value = b64_val(character)
            if value == -2:
                stop = true
            else:
                if value >= 0:
                    if filled == 0:
                        sextet_0 = value
                    else:
                        if filled == 1:
                            sextet_1 = value
                        else:
                            if filled == 2:
                                sextet_2 = value
                            else:
                                sextet_3 = value
                    filled += 1
                    if filled == 4:
                        output = push(output, (sextet_0 << 2) | (sextet_1 >> 4))
                        output = push(output, ((sextet_1 & 15) << 4) | (sextet_2 >> 2))
                        output = push(output, ((sextet_2 & 3) << 6) | sextet_3)
                        filled = 0
    # Trailing partial quartet (when input had '=' padding).
    if filled == 2:
        output = push(output, (sextet_0 << 2) | (sextet_1 >> 4))
    else:
        if filled == 3:
            output = push(output, (sextet_0 << 2) | (sextet_1 >> 4))
            output = push(output, ((sextet_1 & 15) << 4) | (sextet_2 >> 2))
    bytes_to_text(output)
