# audio — cpal output stream + WAV decoder. Pure Orion API surface on top
# of OS primitives.

extern fn __os_audio_init() -> bool
extern fn __os_audio_sample_rate() -> int
extern fn __os_audio_play(samples: [f64])
extern fn __os_audio_stop()
extern fn __os_audio_load_wav(path: Text)

# Open the default output device and start the playback stream. Returns true
# if audio is now live; false on platforms with no output device.
pub fn audio_init() -> bool:
    __os_audio_init()

# Reports the playback stream's sample rate (or 0 if `audio_init` hasn't run).
pub fn audio_sample_rate() -> int:
    __os_audio_sample_rate()

# Queue raw float samples [-1.0, 1.0] for immediate playback. The orb resamples
# nothing — caller must already match `audio_sample_rate`.
pub fn audio_play(samples: [f64]):
    __os_audio_play(samples)

# Drop everything currently queued for playback.
pub fn audio_stop():
    __os_audio_stop()

# Decode a RIFF/WAV file. Returns a Map with `sample_rate`, `channels`,
# `samples` (Float, interleaved), or `none` on failure.
pub fn audio_load_wav(path: Text):
    __os_audio_load_wav(path)
