# image — PNG decode/encode. Pure Orion on top of OS primitives.
# `image_blank` doesn't need to cross the boundary — it's just zero-filled bytes.

extern fn __os_image_load_png(path: Text)
extern fn __os_image_save_png(path: Text, width: int, height: int, pixels: [int]) -> bool

# Load a PNG. Returns a Map with `width`, `height`, `channels`, `pixels` —
# or `none` if the file is missing or malformed.
pub fn image_load_png(path: Text):
    __os_image_load_png(path)

# Save an RGBA8 buffer to disk. Returns true on success.
pub fn image_save_png(path: Text, width: int, height: int, pixels: [int]) -> bool:
    __os_image_save_png(path, width, height, pixels)

# Build a blank RGBA8 image filled with zeros. Pure Orion — no codec needed,
# just a zero-filled byte buffer of the right size.
pub fn image_blank(width: int, height: int):
    pixel_count = width * height * 4
    pixels = bytes_zeros(pixel_count)
    {"width": width, "height": height, "channels": 4, "pixels": pixels}
