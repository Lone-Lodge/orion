# string — text manipulation, pure Orion on top of `bytes`.
# `str_upper` / `str_lower` are ASCII-only (A-Z ↔ a-z, delta = 32).
# Full Unicode case folding would need multi-megabyte tables — out of scope.
use bytes


pub fn str_upper(text: Text) -> Text:
    src = bytes_from_text(text)
    n = bytes_length(src)
    mut out = bytes_zeros(0)
    for i in 0..<n:
        b = byte_at(src, i)
        out = push(out, if b >= 97 and b <= 122 then b - 32 else b)
    bytes_to_text(out)

pub fn str_lower(text: Text) -> Text:
    src = bytes_from_text(text)
    n = bytes_length(src)
    mut out = bytes_zeros(0)
    for i in 0..<n:
        b = byte_at(src, i)
        out = push(out, if b >= 65 and b <= 90 then b + 32 else b)
    bytes_to_text(out)

fn is_whitespace_byte(byte: int) -> bool:
    byte == 32 or byte == 9 or byte == 10 or byte == 13

fn is_digit_byte(byte: int) -> bool:
    byte >= 48 and byte <= 57

fn starts_with_at(subject: [int], subject_length: int, needle: [int], needle_length: int, subject_index: int) -> bool:
    if subject_index + needle_length > subject_length:
        false
    else:
        mut all_match = true
        for offset in 0..<needle_length:
            if byte_at(subject, subject_index + offset) != byte_at(needle, offset):
                all_match = false
        all_match

fn find_at(subject: [int], subject_length: int, needle: [int], needle_length: int, from_index: int) -> int:
    if needle_length == 0:
        from_index
    else:
        mut found_index = 0 - 1
        mut search_index = from_index
        last_search = subject_length - needle_length
        loop:
            if found_index >= 0 or search_index > last_search:
                break
            if starts_with_at(subject, subject_length, needle, needle_length, search_index):
                found_index = search_index
            else:
                search_index += 1
        found_index

pub fn str_starts_with(text: Text, prefix: Text) -> bool:
    text_bytes = bytes_from_text(text)
    prefix_bytes = bytes_from_text(prefix)
    starts_with_at(text_bytes, bytes_length(text_bytes), prefix_bytes, bytes_length(prefix_bytes), 0)

pub fn str_ends_with(text: Text, suffix: Text) -> bool:
    text_bytes = bytes_from_text(text)
    suffix_bytes = bytes_from_text(suffix)
    text_length = bytes_length(text_bytes)
    suffix_length = bytes_length(suffix_bytes)
    if suffix_length > text_length:
        false
    else:
        starts_with_at(text_bytes, text_length, suffix_bytes, suffix_length, text_length - suffix_length)

pub fn str_contains(text: Text, needle: Text) -> bool:
    text_bytes = bytes_from_text(text)
    needle_bytes = bytes_from_text(needle)
    find_at(text_bytes, bytes_length(text_bytes), needle_bytes, bytes_length(needle_bytes), 0) >= 0

pub fn str_trim(text: Text) -> Text:
    bytes = bytes_from_text(text)
    byte_count = bytes_length(bytes)
    mut start_index = 0
    loop:
        if start_index >= byte_count:
            break
        if not is_whitespace_byte(byte_at(bytes, start_index)):
            break
        start_index += 1
    mut end_index = byte_count
    loop:
        if end_index <= start_index:
            break
        if not is_whitespace_byte(byte_at(bytes, end_index - 1)):
            break
        end_index -= 1
    bytes_to_text(bytes_slice(bytes, start_index, end_index))

pub fn str_repeat(text: Text, count: int) -> Text:
    if count <= 0:
        ""
    else:
        bytes = bytes_from_text(text)
        mut output = bytes_zeros(0)
        mut iteration = 0
        loop:
            if iteration >= count:
                break
            output = bytes_concat(output, bytes)
            iteration += 1
        bytes_to_text(output)

pub fn str_split(text: Text, separator: Text) -> [Text]:
    text_bytes = bytes_from_text(text)
    separator_bytes = bytes_from_text(separator)
    text_length = bytes_length(text_bytes)
    separator_length = bytes_length(separator_bytes)
    if separator_length == 0:
        [text]
    else:
        mut pieces = []
        mut segment_start = 0
        mut cursor = 0
        loop:
            if cursor > text_length - separator_length:
                break
            if starts_with_at(text_bytes, text_length, separator_bytes, separator_length, cursor):
                pieces = push(pieces, bytes_to_text(bytes_slice(text_bytes, segment_start, cursor)))
                cursor += separator_length
                segment_start = cursor
            else:
                cursor += 1
        pieces = push(pieces, bytes_to_text(bytes_slice(text_bytes, segment_start, text_length)))
        pieces

pub fn str_replace(text: Text, from: Text, to: Text) -> Text:
    text_bytes = bytes_from_text(text)
    from_bytes = bytes_from_text(from)
    to_bytes = bytes_from_text(to)
    text_length = bytes_length(text_bytes)
    from_length = bytes_length(from_bytes)
    if from_length == 0:
        text
    else:
        mut output = bytes_zeros(0)
        mut cursor = 0
        loop:
            if cursor > text_length - from_length:
                break
            if starts_with_at(text_bytes, text_length, from_bytes, from_length, cursor):
                output = bytes_concat(output, to_bytes)
                cursor += from_length
            else:
                output = push(output, byte_at(text_bytes, cursor))
                cursor += 1
        loop:
            if cursor >= text_length:
                break
            output = push(output, byte_at(text_bytes, cursor))
            cursor += 1
        bytes_to_text(output)

pub fn str_join(pieces: [Text], separator: Text) -> Text:
    # Stay in byte-land to dodge the typeck — `at(pieces, i)` infers as
    # Unknown, and `Unknown + Text` doesn't unify in the operator check.
    count = len(pieces)
    if count == 0:
        ""
    else:
        separator_bytes = bytes_from_text(separator)
        mut output = bytes_zeros(0)
        for index in 0..<count:
            if index > 0:
                output = bytes_concat(output, separator_bytes)
            output = bytes_concat(output, bytes_from_text(at(pieces, index)))
        bytes_to_text(output)

pub fn str_to_int(text: Text) -> int:
    trimmed = str_trim(text)
    bytes = bytes_from_text(trimmed)
    byte_count = bytes_length(bytes)
    if byte_count == 0:
        0
    else:
        is_negative = byte_at(bytes, 0) == 45
        mut cursor = if is_negative then 1 else 0
        mut accumulator = 0
        mut saw_digit = false
        loop:
            if cursor >= byte_count:
                break
            character = byte_at(bytes, cursor)
            if not is_digit_byte(character):
                break
            accumulator = accumulator * 10 + (character - 48)
            saw_digit = true
            cursor += 1
        if not saw_digit then 0
        else if is_negative then 0 - accumulator
        else accumulator

pub fn str_to_float(text: Text) -> f64:
    trimmed = str_trim(text)
    bytes = bytes_from_text(trimmed)
    byte_count = bytes_length(bytes)
    if byte_count == 0:
        0.0
    else:
        is_negative = byte_at(bytes, 0) == 45
        mut cursor = if is_negative then 1 else 0
        mut integer_part = 0
        mut saw_digit = false
        loop:
            if cursor >= byte_count:
                break
            character = byte_at(bytes, cursor)
            if not is_digit_byte(character):
                break
            integer_part = integer_part * 10 + (character - 48)
            saw_digit = true
            cursor += 1
        mut fractional_part = 0.0
        mut fractional_divisor = 1.0
        if cursor < byte_count and byte_at(bytes, cursor) == 46:
            cursor += 1
            loop:
                if cursor >= byte_count:
                    break
                character = byte_at(bytes, cursor)
                if not is_digit_byte(character):
                    break
                fractional_part = fractional_part * 10.0 + to_float(character - 48)
                fractional_divisor = fractional_divisor * 10.0
                saw_digit = true
                cursor += 1
        if not saw_digit:
            0.0
        else:
            magnitude = to_float(integer_part) + fractional_part / fractional_divisor
            if is_negative then 0.0 - magnitude else magnitude

# Byte-length (not chars) — matches str_slice/str_index_of offsets so the
# three compose for header/protocol parsing over ASCII wire formats.
pub fn str_length(text: Text) -> int:
    bytes_length(bytes_from_text(text))

pub fn str_slice(text: Text, low: int, high: int) -> Text:
    bytes_to_text(bytes_slice(bytes_from_text(text), low, high))

# Byte offset of first occurrence, -1 when absent.
pub fn str_index_of(text: Text, needle: Text) -> int:
    subject = bytes_from_text(text)
    needle_bytes = bytes_from_text(needle)
    find_at(subject, bytes_length(subject), needle_bytes, bytes_length(needle_bytes), 0)
