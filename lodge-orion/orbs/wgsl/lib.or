# wgsl — pure-Orion WGSL → HLSL/MSL/GLSL translator. Bridges WebGPU
# shaders to the active `gpu` backend.
#
# Today's MVP: API surface in place, body is a passthrough. The gpu
# orb's built-in HLSL takes over for the demo shaders. The real
# string-based translation lands once Orion's stdlib `string` orb
# settles its API (the `byte_at` primitive it needs is still in flux).
#
# When the real translator lands it will cover:
#   * @vertex / @fragment fn declarations
#   * @location(N), @builtin(...), @group/@binding annotations
#   * vec2/3/4<f32>, mat4x4<f32>, primitive numeric types
#   * if/else/return, struct, var<uniform>, var<storage>
#
# Out of scope for v1: compute shaders, atomics, generic functions.

# Translate WGSL source into HLSL for D3D12. Returns the (currently
# passthrough) translation suitable for D3DCompile.
pub fn to_hlsl(wgsl_source: Text) -> Text:
    wgsl_source

# Translate WGSL into MSL for Apple Metal. Stub for the macOS backend.
pub fn to_msl(wgsl_source: Text) -> Text:
    wgsl_source

# Translate WGSL into GLSL 4.50 for Vulkan SPIRV pipelines.
pub fn to_glsl(wgsl_source: Text) -> Text:
    wgsl_source

# True if the backend supports the API surface used by `wgsl_source`.
# Today every input returns true — the typed-AST check lands when the
# full parser arrives.
pub fn validates(wgsl_source: Text) -> bool:
    true
