# collections — list helpers, fully pure Orion.
#
# Sort uses insertion sort (O(n²)) — simple, no recursion needed and fine
# for the small lists this orb is typically used with. Bump to merge sort
# if a workload ever needs it.

pub fn list_reverse(items: [f64]) -> [f64]:
    count = len(items)
    mut output = []
    mut index = count - 1
    loop:
        if index < 0:
            break
        output = push(output, at(items, index))
        index -= 1
    output

pub fn list_concat(first: [f64], second: [f64]) -> [f64]:
    mut output = []
    first_count = len(first)
    for index in 0..<first_count:
        output = push(output, at(first, index))
    second_count = len(second)
    for index in 0..<second_count:
        output = push(output, at(second, index))
    output

pub fn list_take(items: [f64], count: int) -> [f64]:
    total = len(items)
    capped = if count < 0 then 0 else if count > total then total else count
    mut output = []
    for index in 0..<capped:
        output = push(output, at(items, index))
    output

pub fn list_skip(items: [f64], count: int) -> [f64]:
    total = len(items)
    start = if count < 0 then 0 else if count > total then total else count
    mut output = []
    for index in start..<total:
        output = push(output, at(items, index))
    output

pub fn list_index_of(items: [f64], needle: f64) -> int:
    total = len(items)
    mut found_index = 0 - 1
    for index in 0..<total:
        candidate = at(items, index)
        if found_index < 0 and candidate == needle:
            found_index = index
    found_index

pub fn list_min(items: [f64]) -> f64:
    total = len(items)
    if total == 0:
        0.0
    else:
        mut smallest = at(items, 0)
        for index in 1..<total:
            value = at(items, index)
            if value < smallest:
                smallest = value
        smallest

pub fn list_max(items: [f64]) -> f64:
    total = len(items)
    if total == 0:
        0.0
    else:
        mut largest = at(items, 0)
        for index in 1..<total:
            value = at(items, index)
            if value > largest:
                largest = value
        largest

pub fn list_sum(items: [f64]) -> f64:
    total = len(items)
    mut accumulator = 0.0
    for index in 0..<total:
        accumulator = accumulator + at(items, index)
    accumulator

pub fn list_avg(items: [f64]) -> f64:
    total = len(items)
    if total == 0:
        0.0
    else:
        list_sum(items) / to_float(total)

pub fn list_count_in(items: [f64], lower: f64, upper: f64) -> int:
    total = len(items)
    mut counter = 0
    for index in 0..<total:
        value = at(items, index)
        if value >= lower and value <= upper:
            counter += 1
    counter

# --- insertion sort, ascending ---
#
# Build the output one element at a time, finding the insertion index in
# the already-sorted prefix by scanning from the back. O(n²) but no
# recursion and no extra fns.
pub fn list_sort_asc(items: [f64]) -> [f64]:
    total = len(items)
    if total <= 1:
        items
    else:
        mut sorted_items = []
        sorted_items = push(sorted_items, at(items, 0))
        for source_index in 1..<total:
            new_value = at(items, source_index)
            sorted_length = len(sorted_items)
            mut insert_index = sorted_length
            mut scan_back = sorted_length - 1
            mut still_scanning = true
            loop:
                if scan_back < 0 or not still_scanning:
                    break
                if at(sorted_items, scan_back) > new_value:
                    insert_index = scan_back
                    scan_back -= 1
                else:
                    still_scanning = false
            mut rebuilt = []
            for copy_index in 0..<insert_index:
                rebuilt = push(rebuilt, at(sorted_items, copy_index))
            rebuilt = push(rebuilt, new_value)
            for copy_index in insert_index..<sorted_length:
                rebuilt = push(rebuilt, at(sorted_items, copy_index))
            sorted_items = rebuilt
        sorted_items

pub fn list_sort_desc(items: [f64]) -> [f64]:
    list_reverse(list_sort_asc(items))
