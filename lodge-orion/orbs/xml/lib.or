# xml — minimal DOM-style XML parser, pure Orion.
#
# Returns a Map per element: `{ tag, attrs, text, children }`.
# Skips the XML prolog (`<?xml ?>`) and comments (`<!-- -->`). No DTD,
# CDATA, or namespace handling — that's outside the engine's needs.
#
# Position-threading convention: parse_* fns return `{ "v": value, "p": new_position }`,
# same trick as `orbs/json/lib.or` (Map types unify as Unknown in typeck).

fn is_whitespace_byte(character: int) -> bool:
    character == 32 or character == 9 or character == 10 or character == 13

fn skip_whitespace(bytes: [int], total: int, start: int) -> int:
    mut position = start
    loop:
        if position >= total:
            break
        if not is_whitespace_byte(byte_at(bytes, position)):
            break
        position += 1
    position

# Does the slice starting at `position` match the byte sequence `needle`?
fn starts_with_bytes(bytes: [int], total: int, position: int, needle: [int]) -> bool:
    needle_length = bytes_length(needle)
    if position + needle_length > total:
        false
    else:
        mut all_match = true
        for offset in 0..<needle_length:
            if byte_at(bytes, position + offset) != byte_at(needle, offset):
                all_match = false
        all_match

# Find first occurrence of `needle` starting from `start`. Returns -1 if not found.
fn find_bytes_from(bytes: [int], total: int, start: int, needle: [int]) -> int:
    needle_length = bytes_length(needle)
    if needle_length == 0 or start + needle_length > total:
        0 - 1
    else:
        mut found_index = 0 - 1
        mut position = start
        last_position = total - needle_length
        loop:
            if found_index >= 0 or position > last_position:
                break
            mut all_match = true
            for offset in 0..<needle_length:
                if byte_at(bytes, position + offset) != byte_at(needle, offset):
                    all_match = false
            if all_match:
                found_index = position
            position += 1
        found_index

# Skip <?xml ?> prolog, <!-- --> comments, and surrounding whitespace.
fn skip_prolog_and_comments(bytes: [int], total: int, start: int) -> int:
    mut position = start
    mut done = false
    prolog_start = bytes_from_text("<?")
    prolog_end = bytes_from_text("?>")
    comment_start = bytes_from_text("<!--")
    comment_end = bytes_from_text("-->")
    loop:
        if done:
            break
        position = skip_whitespace(bytes, total, position)
        if starts_with_bytes(bytes, total, position, prolog_start):
            end_index = find_bytes_from(bytes, total, position, prolog_end)
            if end_index < 0:
                done = true
            else:
                position = end_index + 2
        else:
            if starts_with_bytes(bytes, total, position, comment_start):
                end_index = find_bytes_from(bytes, total, position, comment_end)
                if end_index < 0:
                    done = true
                else:
                    position = end_index + 3
            else:
                done = true
    position

# True if `character` can appear inside an XML name (tag or attribute).
fn is_name_byte(character: int) -> bool:
    if character >= 65 and character <= 90 then true       # A-Z
    else if character >= 97 and character <= 122 then true # a-z
    else if character >= 48 and character <= 57 then true  # 0-9
    else if character == 95 then true                       # _
    else if character == 45 then true                       # -
    else if character == 58 then true                       # :
    else false

# Read an XML name (tag or attribute key). Returns "" if no name at position.
fn read_name(bytes: [int], total: int, start: int):
    mut position = start
    mut buffer = bytes_zeros(0)
    loop:
        if position >= total:
            break
        character = byte_at(bytes, position)
        if not is_name_byte(character):
            break
        buffer = push(buffer, character)
        position += 1
    if position == start:
        {"v": "", "p": position}
    else:
        {"v": bytes_to_text(buffer), "p": position}

# Read a single-quoted or double-quoted value. Returns "" if no quote at position.
fn read_quoted_value(bytes: [int], total: int, start: int):
    if start >= total:
        {"v": "", "p": start}
    else:
        quote = byte_at(bytes, start)
        if quote != 34 and quote != 39:        # " or '
            {"v": "", "p": start}
        else:
            mut position = start + 1
            mut buffer = bytes_zeros(0)
            loop:
                if position >= total:
                    break
                if byte_at(bytes, position) == quote:
                    break
                buffer = push(buffer, byte_at(bytes, position))
                position += 1
            # Consume the closing quote if present.
            if position < total:
                position += 1
            {"v": bytes_to_text(buffer), "p": position}

# Parse the attribute list inside `<tag attrs...>` or `<tag attrs.../>`.
# Returns a Map of name → value.
fn read_attrs(bytes: [int], total: int, start: int):
    mut position = start
    mut attrs = {}
    mut done = false
    loop:
        if done:
            break
        position = skip_whitespace(bytes, total, position)
        if position >= total:
            done = true
        else:
            next_byte = byte_at(bytes, position)
            if next_byte == 62 or next_byte == 47:    # '>' or '/'
                done = true
            else:
                name_result = read_name(bytes, total, position)
                key = get(name_result, "v")
                position = get(name_result, "p")
                if key == "":
                    done = true
                else:
                    position = skip_whitespace(bytes, total, position)
                    if position < total and byte_at(bytes, position) == 61:    # '='
                        position += 1
                        position = skip_whitespace(bytes, total, position)
                        value_result = read_quoted_value(bytes, total, position)
                        attrs = set(attrs, key, get(value_result, "v"))
                        position = get(value_result, "p")
                    else:
                        attrs = set(attrs, key, "")
    {"v": attrs, "p": position}

# Forward declaration is implicit in Orion — `parse_element` is called
# from `read_body` below. Both are recursive together.

# Build a closing-tag byte buffer like `</tag>` for a given tag.
fn closing_tag_bytes(tag: Text) -> [int]:
    mut buffer = push(bytes_zeros(0), 60)    # '<'
    buffer = push(buffer, 47)                # '/'
    name_bytes = bytes_from_text(tag)
    name_count = bytes_length(name_bytes)
    for offset in 0..<name_count:
        buffer = push(buffer, byte_at(name_bytes, offset))
    push(buffer, 62)                          # '>'

# Trim trailing whitespace from a byte buffer.
fn trim_buffer(buffer: [int]) -> [int]:
    count = bytes_length(buffer)
    mut end_index = count
    loop:
        if end_index <= 0:
            break
        if not is_whitespace_byte(byte_at(buffer, end_index - 1)):
            break
        end_index -= 1
    mut start_index = 0
    loop:
        if start_index >= end_index:
            break
        if not is_whitespace_byte(byte_at(buffer, start_index)):
            break
        start_index += 1
    bytes_slice(buffer, start_index, end_index)

# Read element body (text + child elements) until the matching closing tag.
fn read_body(bytes: [int], total: int, start: int, tag: Text):
    mut position = start
    mut text_buffer = bytes_zeros(0)
    mut children = []
    mut done = false
    close_bytes = closing_tag_bytes(tag)
    close_length = bytes_length(close_bytes)
    comment_start = bytes_from_text("<!--")
    comment_end = bytes_from_text("-->")
    loop:
        if done:
            break
        if position >= total:
            done = true
        else:
            if starts_with_bytes(bytes, total, position, close_bytes):
                position += close_length
                done = true
            else:
                if starts_with_bytes(bytes, total, position, comment_start):
                    end_index = find_bytes_from(bytes, total, position, comment_end)
                    if end_index < 0:
                        done = true
                    else:
                        position = end_index + 3
                else:
                    if byte_at(bytes, position) == 60:    # '<' — child element
                        child_result = parse_element(bytes, total, position)
                        child_value = get(child_result, "v")
                        next_position = get(child_result, "p")
                        if type_of(child_value) == "none" or next_position == position:
                            done = true
                        else:
                            children = push(children, child_value)
                            position = next_position
                    else:
                        text_buffer = push(text_buffer, byte_at(bytes, position))
                        position += 1
    trimmed_text = bytes_to_text(trim_buffer(text_buffer))
    {"text": trimmed_text, "children": children, "p": position}

fn parse_element(bytes: [int], total: int, start: int):
    if start >= total or byte_at(bytes, start) != 60:    # '<'
        {"v": none, "p": start}
    else:
        mut position = start + 1
        name_result = read_name(bytes, total, position)
        tag = get(name_result, "v")
        position = get(name_result, "p")
        if tag == "":
            {"v": none, "p": position}
        else:
            attrs_result = read_attrs(bytes, total, position)
            attrs = get(attrs_result, "v")
            position = skip_whitespace(bytes, total, get(attrs_result, "p"))
            # Self-closing?
            if position + 1 < total and byte_at(bytes, position) == 47 and byte_at(bytes, position + 1) == 62:
                position += 2
                {"v": {"tag": tag, "attrs": attrs, "text": "", "children": []}, "p": position}
            else:
                if position < total and byte_at(bytes, position) == 62:    # '>'
                    position += 1
                    body_result = read_body(bytes, total, position, tag)
                    body_text = get(body_result, "text")
                    body_children = get(body_result, "children")
                    new_position = get(body_result, "p")
                    {"v": {"tag": tag, "attrs": attrs, "text": body_text, "children": body_children}, "p": new_position}
                else:
                    {"v": none, "p": position}

pub fn xml_parse(text: Text):
    bytes = bytes_from_text(text)
    total = bytes_length(bytes)
    start = skip_prolog_and_comments(bytes, total, 0)
    result = parse_element(bytes, total, start)
    get(result, "v")
