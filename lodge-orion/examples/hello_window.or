use window
use io

fn main() -> int:
    if not window_ready():
        print_line("window: no backend on this platform")
        0
    else:
        print_line("opening window...")
        win_id = window_open(800, 600, "Orion — Hello Window")
        print_line("ESC to quit (or close button)")
        run_loop(win_id)
        print_line("window closed")
        0

fn run_loop(win_id: int):
    mut keep_going = true
    loop:
        if not keep_going:
            break
        if window_should_close():
            keep_going = false
        else:
            events = window_pump()
            for ev in events:
                if ev.kind == "key_down" and ev.key == 27:
                    window_close(win_id)
                    keep_going = false
