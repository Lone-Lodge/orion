use window
use gpu
use io

# A real, on-screen triangle. The window stays open until ESC.

fn main() -> int:
    print_line("orion gpu — backend: " + gpu_backend())

    if not window_ready():
        print_line("no window backend")
        0
    else:
        win_id = window_open(800, 600, "Orion — Hello Triangle")
        device = gpu_init(win_id)

        verts = create_buffer(device, 36, "vertex")
        # Counter-clockwise triangle, NDC coordinates (-1..1)
        write_buffer(device, verts, [-0.6, -0.5, 0.0, 0.6, -0.5, 0.0, 0.0, 0.6, 0.0])

        pipeline = create_pipeline(device, create_shader(device, "ignored"), "f32x3")
        print_line("press ESC to quit")
        render_loop(win_id, device, verts, pipeline)
        gpu_destroy(device)
        window_close(win_id)
        print_line("bye")
        0

fn render_loop(win_id: int, device: Device, verts: Buffer, pipeline: Pipeline):
    mut keep_going = true
    loop:
        if not keep_going:
            break
        if window_should_close():
            keep_going = false
        else:
            events = window_pump()
            for ev in events:
                if ev.kind == "key_down" and ev.key == 27:
                    keep_going = false

            cmd = begin_frame(device)
            set_pipeline(cmd, pipeline)
            set_vertex_buffer(cmd, verts)
            draw(cmd, 1)
            submit(device, cmd)
            present(device)
