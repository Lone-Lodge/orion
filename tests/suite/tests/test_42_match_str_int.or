define day_value(day: text) -> number:
    choose day:
        "mon" then 10
        "fri" then 32
        _ then 0

define level_value(level: number) -> number:
    choose level:
        0 then 0
        1 then 100
        _ then 200

define main() -> number:
    day_value("fri") + level_value(1) - level_value(1) + 10
