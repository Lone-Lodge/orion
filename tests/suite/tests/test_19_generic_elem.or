# A generic result keeps its element type at the CALL SITE.
#
# Inside `fn take<T>(xs: [T], n: number) -> [T]` the type var erases to an i64 slot,
# which is right (one body serves every T). It used to leak out though: the CALL
# got `list:i64` back, so an element read out of the result was an int and
# `length(kept[0])` was a compile error ("`first` is `int`, not text or a
# list"). The call site knows what the body cannot - the argument says T = Text.
#
# The runtime representation never changed: a list of text pointers and a list
# of ints are both i64 slots. This is only the compiler no longer forgetting
# which one it holds.

define take<T>(xs: [T], n: number) -> [T]:
    edit out = part(xs, 0, 0)
    loop i in 0 until n:
        out = append(out, xs[i])
    out

define first_of<T>(xs: [T]) -> T:
    xs[0]

define sum_two(xs: [number]) -> number:
    xs[0] + xs[1]

define main() -> number:
    words = ["hi", "hello", "howdy"]
    kept = take(words, 2)
    a = length(kept[0])     # 2   ("hi")     needs T = Text
    b = length(first_of(words)) # 2   bare `-> T` instantiates too
    # A concrete [number] argument still yields an int list.
    nums = [7, 8, 9]
    c = sum_two(take(nums, 2))   # 15
    a + b + c                    # 2 + 2 + 15 is 19
