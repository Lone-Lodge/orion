# Smoke test covering EVERY interp category we found in orbs/.
#
# Categories tested:
#   - Simple ident:           {name}
#   - Field access:           {obj.field}
#   - Fn call w/ ident arg:   {function(arg)}
#   - Fn call w/ field arg:   {function(obj.field)}  ← was a bug
#   - Multiple in one string

type Obj: field: number, name: text

define double_int(x: number) -> number:
    x + x

define label_for(name: text) -> text:
    "label:{name}"

define main() -> number:
    obj = Obj{field: 21, name: "alpha"}
    val = 21

    # Each line exercises a category.
    m1 = "ident={val}"
    m2 = "field={obj.field}"
    m3 = "call_ident={double_int(val)}"
    m4 = "call_field={double_int(obj.field)}"
    m5 = "call_text={label_for(obj.name)}"
    m6 = "mix v={val} f={obj.field} c={double_int(val)}"

    if not contains(m1, "ident=21"):
        0
    else:
        if not contains(m2, "field=21"):
            0
        else:
            if not contains(m3, "call_ident=42"):
                0
            else:
                if not contains(m4, "call_field=42"):
                    0
                else:
                    if not contains(m5, "call_text=label:alpha"):
                        0
                    else:
                        if not contains(m6, "v=21 f=21 c=42"):
                            0
                        else:
                            42
