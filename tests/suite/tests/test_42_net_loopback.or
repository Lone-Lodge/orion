# net: real sockets. A listener + a client on loopback, in-process.

define main() -> number:
    s = listen(58421)
    if not ok(s):
        return 1
    c = connect("127.0.0.1", 58421)
    if not ok(c):
        close(s)
        return 2
    srv = accept(s)
    if not ok(srv):
        close(c)
        close(s)
        return 3
    send(c, "hej")
    got = recv(srv, 64)
    close(srv)
    close(c)
    close(s)
    if got is "hej" then 42 else 4
