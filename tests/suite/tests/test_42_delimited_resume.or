# A handler that SURVIVES its own resume.
#
# `resume(v)` in a `handle` block is a longjmp: control leaves for the perform
# site and the handler's frame is gone, so a handler can never do anything after
# the continuation runs - not inspect the result, not clean up, not decide
# anything based on how it went.
#
# `ask`/`resume_with` run the handler on its OWN stack (a fiber), so it lives
# through the switch and `resume_with` RETURNS what the rest of the task
# produced. The continuation is delimited by the task; the handler's own value
# is the value of the whole handled computation, which is what makes it an outer
# expression rather than a callback.
#
# ONE resume per `ask`, and that limit is enforced, not hoped for: a second call
# is refused with a message instead of faulting. Replaying would mean restoring
# the task's stack to the perform point, which invalidates the context the OS
# parked that fiber at.

define decide(seed: number) -> number:
    answer = resume_with(seed + 3)   # rest of the task runs with x = 4
    answer + 2                       # gets 40 back -> the whole thing is 42

define body(seed: number) -> number:
    x = ask(decide, seed)
    x * 10                           # the continuation

# A handler that never resumes: its value is what the perform site yields, and
# the rest of the task still runs from there.
define refuse(seed: number) -> number:
    7

define quiet(seed: number) -> number:
    x = ask(refuse, seed)
    x + 1                            # 8

# The fiber switch behind `ask` is Windows-only for now, and the runtime says so
# rather than pretending: `resumable_ok()` is 0 elsewhere and `ask` yields -1.
# So this pins BOTH contracts. The refusal is a promise too - before this, the
# test simply demanded the Windows numbers everywhere and went red on Linux
# while the runtime was behaving exactly as documented.
define main() -> number:
    a = await(spawn(body, 1))
    b = await(spawn(quiet, 0))
    print_line("resumed={a} not_resumed={b} supported={resumable_ok()}")
    # Supported: resume_with hands 40 back, the handler adds 2 -> 42; the
    # non-resuming handler yields 7 and the task adds 1 -> 8.
    # Refused: ask is -1, so body gives -1 * 10 and quiet gives -1 + 1.
    want_a = if resumable_ok() is 1 then 42 else 0 - 10
    want_b = if resumable_ok() is 1 then 8 else 0
    ok = if a is want_a and b is want_b then 1 else 0
    ok * 42
