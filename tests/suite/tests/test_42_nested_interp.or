# Interpolation holes may contain STRINGS, and those strings may themselves
# interpolate: the hole scanner is brace- and quote-aware.

define main() -> number:
    n = 7
    sp = " "
    boxed = "[{pad_left("{n}", 3, sp)}]"
    twice = "{pad_right("{n}{n}", 4, "-")}"
    inner = "{upper("{sp}hej")}"
    ok1 = if boxed is "[  7]" then 20 else 0
    ok2 = if twice is "77--" then 12 else 0
    ok3 = if inner is " HEJ" then 10 else 0
    ok1 + ok2 + ok3
