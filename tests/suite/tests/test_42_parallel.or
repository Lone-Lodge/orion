# `par_run(closures, arg)` is a first-class builtin: run each closure(arg) on a
# worker thread and sum the results. Real OS-thread parallelism (Windows pool),
# deterministic (each worker writes only its own slot; sum is order-independent).
define dbl(x: number) -> number:
    x * 2

define main() -> number:
    fs = [dbl, dbl, dbl]
    par_run(fs, 7)    # 3 workers, each dbl(7) is 14, sum is 42
