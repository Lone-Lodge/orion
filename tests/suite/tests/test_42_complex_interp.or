type Item: name: text, value: number

define describe(item: Item) -> text:
    "{item.name}: {item.value}"

define main() -> number:
    a = Item{name: "x", value: 21}
    msg = describe(a)
    # describe should produce "x: 21"
    if contains(msg, "x: 21"):
        a.value + a.value
    else:
        0
