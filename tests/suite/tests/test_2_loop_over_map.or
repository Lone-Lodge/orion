# A map is not a list. Looping one used to lower exactly like a list - read
# the header as [cap, len, data...] and index it - so a two-entry map walked
# its flat key/value storage and counted FOUR. This pins the count at two.
define main() -> number:
    m = {"a": 1, "b": 2}
    edit n = 0
    loop k in m:
        n += 1
    n
