# The compiler already knew which orb exports a name - the old error said
# "`trim` needs a `use`; it is exported by `text`". A tool that can write the
# answer should not make you copy it. So a name exactly one orb exports pulls
# that orb in. Not one `use` line here.
define main() -> number:
    a = length(trim("   hi   "))              # text.trim       -> 2
    b = length(split("a,b,c,d", ","))         # text.split      -> 4
    c = length(upper("orion"))                # text.upper      -> 5

    # a LOCAL named like an export imports nothing: only a name in call
    # position counts, and this one is a value
    first = 6
    reverse = 7

    # the core words never reach for an orb either, or `error` would come
    # from `log` and `ok` from `file` in every program that writes them
    d = choose (if true then ok(9) else error("x")):
        ok(v) then v                          # 9
        error(m) then 0

    a + b + c + first + reverse + d + 14      # 2+4+5+6+7+9+14
