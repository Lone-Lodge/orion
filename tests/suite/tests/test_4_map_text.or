define main() -> number:
    m = {"kind": "Block", "name": "main"}
    edit score = 0
    if get(m, "kind") is "Block":
        score = score + 1
    if get(m, "name") is "main":
        score = score + 1
    if has(m, "kind"):
        score = score + 1
    if not has(m, "missing"):
        score = score + 1
    score
