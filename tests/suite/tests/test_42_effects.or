# Algebraic effects end to end: `effect` declares the operations, `handle`
# defines one (an ordinary fn under a synthesized name), `perform` invokes it
# as an expression, and `resume(v)` comes back to the perform site with v.
# Both the int and the text continuation are exercised.
effect Random:
    roll: function(max: number) -> number

effect Log:
    msg: function(text: text) -> text

handle Random.roll(max: number) -> number:
    resume(max // 5)

handle Log.msg(message: text) -> text:
    resume("ok")

define main() -> number:
    r = perform Random.roll(100)     # 20
    s = perform Log.msg("hello")     # "ok"
    r + length(s) * 11                  # 20 + 2*11 is 42
