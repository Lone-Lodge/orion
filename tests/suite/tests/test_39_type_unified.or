# `type` is the one type-declaration keyword now: inline fields = product,
# indented variants = sum, `= T` = alias. And a bare top-level `NAME = expr`
# is a constant, no keyword. (`data`/`enum`/`const` still work as aliases.)
type Point: x: number, y: number

type Shape:
    Circle(number)
    Rect(number, number)

type Meters = number

BASE = 30

define area(s: Shape) -> number:
    choose s:
        Circle(r) then r * r
        Rect(w, h) then w * h

define main() -> number:
    p = Point{x: 2, y: 3}
    edit d: Meters = 5
    a = area(Shape.Rect(4, 3))   # 12
    a + p.x + BASE - d           # 12 + 2 + 30 - 5 is 39
