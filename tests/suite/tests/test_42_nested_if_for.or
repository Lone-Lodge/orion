define category(n: number) -> number:
    edit result = 0
    loop i in 0 until 3:
        if n < 0:
            result = 1
        else:
            if n is 0:
                result = 2
            else:
                if n < 10:
                    result = 42
                else:
                    result = 4
    result

define main() -> number:
    category(7)
