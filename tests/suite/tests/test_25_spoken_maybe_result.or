# The spoken surface for the two core types, with no `use` line at all.
# `maybe T` / `result T` in type position, `some` / `none` / `ok` / `error`
# as constructors AND as patterns - an arm that builds one way and matches
# another would be the worst of both spellings.
define find(k: number) -> maybe number:
    if k > 0 then some(k * 10) else none

define div(a: number, b: number) -> result number:
    if b is 0 then error("div by zero") else ok(a // b)

define main() -> number:
    a = choose find(2):
        some(v) then v          # 20
        none then 0
    b = choose find(0 - 1):
        some(v) then v
        none then 3             # 3
    c = choose div(16, 2):
        ok(v) then v            # 8
        error(m) then 0
    d = choose div(1, 0):
        ok(v) then v
        error(m) then length(m) # 11

    # the declared spellings still work, and mean the same thing
    e = choose Option.Some(5):
        Some(v) then v          # 5
        None then 0

    a + b + c - d + e           # 20+3+8-11+5 is 25
