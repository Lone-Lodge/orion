type Result: ok: number, value: number, err: text

define Ok(v: number) -> Result:
    Result{ok: 1, value: v, err: ""}

define Err(msg: text) -> Result:
    Result{ok: 0, value: 0, err: msg}

define safe_div(a: number, b: number) -> Result:
    if b is 0:
        Err("div by zero")
    else:
        Ok(a // b)

define unwrap_or(r: Result, default: number) -> number:
    if r.ok is 1 then r.value else default

define main() -> number:
    good = safe_div(84, 2)
    bad = safe_div(100, 0)
    a = unwrap_or(good, 0)
    b = unwrap_or(bad, 0)
    # 42 + 0 = 42
    a + b
