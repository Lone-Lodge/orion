# A closure created inside a loop, capturing the loop variable - the lift
# now descends into nested block bodies. g captures i; ap(g, 10) for
# i = 0,1,2 gives 10 + 11 + 12 = 33.
define ap(f: function, x: number) -> number:
    f(x)
define main() -> number:
    edit s = 0
    loop i in 0 until 3:
        g = function(n): n + i
        s = s + ap(g, 10)
    s
