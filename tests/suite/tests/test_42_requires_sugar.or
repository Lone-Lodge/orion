# Trait sugar over operation-passing: `requires order` makes the capability
# record an implicit trailing parameter. The caller hands it as a named arg,
# the body reads operations off it. Dictionary-passing made visible.
type order: less: function

define largest given item requires order (items: list of item) -> item:
    cmp = order.less
    edit best = items[0]
    loop i in 1 until length(items):
        if cmp(items[i], best):
            best = items[i]
    best

define main() -> number:
    int_desc = order{less: (a, b): a > b}
    int_asc = order{less: (a, b): a < b}
    hi = largest([3, 42, 7], order: int_desc)
    lo = largest([9, 3, 8], order: int_asc)
    hi - lo + 3
