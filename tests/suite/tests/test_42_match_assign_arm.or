# An inline match arm body can be an assignment (a side-effecting arm),
# not only an expression: `Num(v) -> total += v`. The enum payload (`v`,
# `o`) binds in the arm. Used as a statement inside a loop.
type Token: Num(number), Op(number)
define main() -> number:
    toks = [Token.Num(10), Token.Op(2), Token.Num(30)]
    edit total = 0
    loop t in toks:
        choose t:
            Num(v) then total = total + v      # inline assignment arm
            Op(o) then total = total + o
    total                                    # 10 + 2 + 30 = 42
