# A real number reads back as the number the program held.
#
# `%g` alone is six significant digits, so `123456789.5` came out
# `1.23457e+08` and `1 / 3` came out `0.333333` - a value nothing ever
# computed. The rule now is the one Rust, Go and JS use: the SHORTEST decimal
# that reads back as the same double. Try one digit, then two, until strtod
# gives the bits back.
#
# `0.1 + 0.2` is `0.30000000000000004` and saying so is the point. A formatter
# that rounds it to `0.3` is hiding the one fact about floating point every
# programmer has to learn once.
#
# KNOWN GAP: the wasm backend has its own formatter and does not agree yet.
# Listed in tools/wasm_conformance.js.

define main() -> number:
    a = if "{1 / 3}" is "0.3333333333333333" then 20 else 0
    b = if "{1.0e20}" is "1e+20" then 15 else 0
    c = if "{123456789.5}" is "123456789.5" then 5 else 0
    d = if "{0.1 + 0.2}" is "0.30000000000000004" then 3 else 0
    a + b + c + d   # 20 + 15 + 5 + 3
