# `deterministic define` is a real guarantee, not a decoration.
#
# The word used to parse and then be dropped, so the declaration compiled as a
# plain one that promised nothing. The compiler proves it now: a deterministic
# function may not transitively reach a source of non-determinism (io,
# wall-clock time, platform, audio). That is the compile-time certificate a
# deterministic simulation - and rollback netcode - rests on.
#
# Only the POSITIVE case lives here: a deterministic call graph over pure
# arithmetic must compile and give the right answer. The negative cases are in
# the negative suite, because a compile error produces no binary to run.

deterministic define step(x: number, vx: number, dt: number) -> number:
    x + vx * dt

deterministic define integrate(x: number, vx: number, ticks: number) -> number:
    edit pos = x
    loop i in 0 until ticks:
        pos = step(pos, vx, 1)
    pos

define main() -> number:
    print_line("")
    print_line("  gate: deterministic keyword (compile-time certificate)")
    print_line("")
    # If this binary exists at all, the two declarations above passed the
    # certificate: the whole call graph is free of io / time / platform / audio.
    a = integrate(0, 3, 10)
    ok = if a == 30 then 1 else 0
    if ok == 1:
        print_line("    ok    a deterministic call graph compiles and runs (30)")
        print_line("")
        print_line("  1/1 checks passed")
        0
    else:
        print_line("    FAIL  expected 30, got {a}")
        print_line("")
        print_line("  1 of 1 checks FAILED")
        1
