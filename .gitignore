# Build artifacts — everything here is generated, never committed.
/dist/
out.ll
*.o
*.exe
# stray emitted IR (the committed bootstrap seed lives at tools/seed/orion.ll)
/*.ll

# Debug/crash artifacts (never source). Existing tracked build outputs like
# examples/tests/dist/*.ll are left as-is — this only stops genuine junk.
*.pdb
*.dmp
build/crash.*

# scratch a test writes into the runner dir
*.tmp

# host-retargeted scratch copies (the tracked .ll is the compiler output)
*.host.ll

# test scratch written into the tracked dist dir
examples/tests/.*.txt
examples/tests/dist/.*.txt
examples/tests/.*.bat
examples/tests/dist/.*.bat
examples/tests/dist/.watch/
build/autosave.txt
build/*.map
__pycache__/
